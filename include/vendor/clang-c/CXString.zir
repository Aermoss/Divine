struct CXString {
    pub data: *void,
    pub private_flags: u32
}

struct CXStringSet {
    pub Strings: *mut CXString,
    pub Count: u32
}

extern "C" {
    fn clang_getCString(string: CXString) -> *i8;
    fn clang_disposeString(string: CXString);
    fn clang_disposeStringSet(set: *mut CXStringSet);
}
