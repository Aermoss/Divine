#[include "std/mem", "std/vec" : *]

extern "C" {
    fn strlen(str: *i8) -> usize {
        let mut i: usize = 0;

        loop {
            if str[i] == 0 {
                return i;
            } else {
                i += 1;
            }
        } return 0;
    }

    fn strcmp(s1: *i8, s2: *i8) -> i32 {
        let mut i: usize = 0;

        while s1[i] == s2[i] {
            if s1[i] == 0 {
                return 0;
            } i += 1;
        }

        return (s1[i] as i32) - (s2[i] as i32);
    }

    fn strncmp(s1: *i8, s2: *i8, n: usize) -> i32 {
        for i in 0..n {
            if s1[i] != s2[i] {
                return (s1[i] as i32) - (s2[i] as i32);
            }

            if s1[i] == 0 {
                break;
            }
        } return 0;
    }
}

class String {
    data: *mut i8 = null,
    length: usize = 0;

    String(&mut this) {
        this.Allocate(0);
    }

    String(&mut this, character: i8) {
        this.Allocate(1);
        this.data[0] = character;
    }

    String(&mut this, string: *i8) {
        let other_length = strlen(string);

        if string == null {
            this.Allocate(0);
            return;
        }

        this.Allocate(other_length);
        memcpy(this.data, string, other_length);
    }

    String(&mut this, other: &String) {
        if other.data == null {
            this.Allocate(0);
            return;
        }

        this.Allocate(other.length);
        memcpy(this.data, other.data, other.length);
    }

    String(&mut this, string: *i8, mut length: usize) {
        let other_length = strlen(string);

        if string == null || length == 0 {
            this.Allocate(0);
            return;
        }

        if length > other_length {
            length = other_length;
        }

        this.Allocate(length);
        memcpy(this.data, string, length);
    }

    String(&mut this, other: &String, mut length: usize) {
        if other.data == null || length == 0 {
            this.Allocate(0);
            return;
        }

        if length > other.length {
            length = other.length;
        }

        this.Allocate(length);
        memcpy(this.data, other.data, length);
    }

    String(&mut this, string: *i8, start: usize, mut length: usize) {
        let other_length = strlen(string);

        if string == null || start >= other_length || length == 0 {
            this.Allocate(0);
            return;
        }

        if start + length > other_length {
            length = other_length - start;
        }

        this.Allocate(length);
        memcpy(this.data, (string + start), length);
    }

    String(&mut this, other: &String, start: usize, mut length: usize) {
        if other.data == null || start >= other.length || length == 0 {
            this.Allocate(0);
            return;
        }

        if start + length > other.length {
            length = other.length - start;
        }

        this.Allocate(length);
        memcpy(this.data, (other.data + start), length);
    }

    ~String(&mut this) {
        this.Release();
    }

    pub fn Data(&this) -> *i8 { return this.data; }
    pub fn Empty(&this) -> bool { return this.length == 0; }
    pub fn Size(&this) -> usize { return this.length + 1; }
    pub fn Length(&this) -> usize { return this.length; }

    fn Allocate(&mut this, length: usize) {
        (this.data, this.length) = (new i8[length + 1], length);
        this.data[length] = '\0';
    }

    fn Release(&mut this) {
        if this.data != null { delete[] this.data; }
        (this.data, this.length) = (null, 0);
    }

    pub fn Clear(&mut this) {
        this.Release();
        this.Allocate(0);
    }

    pub fn FromInteger(mut value: u64, base: u64) -> String {
        if base < 2 || base > 36 { return String(); }
        else if value == 0 { return String("0"); }
        else {
            let mut result = String();

            while value > 0 {
                result += "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"[(value % base) as usize];
                value /= base;
            }

            return result.Reverse();
        }
    }

    pub fn FromInteger(value: u64) -> String {
        return String::FromInteger(value, 10);
    }

    pub fn FromInteger(value: i64, base: i64) -> String {
        if base < 2 || base > 36 {
            return String();
        } else if value >= 0 {
            return String::FromInteger(value as u64, base as u64);
        } else if base != 10 {
            return String::FromInteger((!value + 1) as u64, base as u64);
        } else {
            return '-' + String::FromInteger((!value + 1) as u64, base as u64);
        }
    }

    pub fn FromInteger(value: i64) -> String {
        return String::FromInteger(value, 10);
    }

    pub fn FromFloat(mut value: f64, precision: usize) -> String {
        if value != value { return "nan".ToString(); }
        else if value == (1.0 / 0.0) { return "inf".ToString(); }
        else if value == (-1.0 / 0.0) { return "-inf".ToString(); }
        else if value == 0.0 { return "0.0".ToString(); }
        else if value < 0.0 {
            return '-' + String::FromFloat(-value, precision);
        } else {
            let mut exponent: i64 = 0;

            if value >= 1e9 {
                while value >= 10.0 {
                    value /= 10.0;
                    exponent += 1;
                }
            } else if value < 1e-4 {
                while value < 1.0 {
                    value *= 10.0;
                    exponent -= 1;
                }
            }

            let mut integer = value as u64;
            let mut fraction = value - (integer as f64);
            let mut round = 0.5;

            for _ in 0..precision {
                round /= 10.0;
            }

            fraction += round;

            if fraction >= 1.0 {
                fraction -= 1.0;
                integer += 1;
            }

            let result = String::FromInteger(integer);

            if precision != 0 {
                result += '.';
            }

            for i in 0..precision {
                fraction *= 10.0;
                let digit = fraction as i8;
                fraction -= digit as f64;
                result += '0' + digit;
            }

            if exponent != 0 {
                result += 'e';

                if exponent < 0 {
                    result += '-' + String::FromInteger(-exponent);
                } else {
                    result += '+' + String::FromInteger(exponent);
                }
            } return result;
        }
    }

    pub fn FromFloat(mut value: f64) -> String {
        return String::FromFloat(value, 6);
    }

    fn ParseUnsigned(&this, base: u64, negative: &mut bool) -> u64 {
        if this.length == 0 { return 0; }
        if base < 2 || base > 36 { return 0; }
        let mut result: u64 = 0;
        let mut i: usize = 0;

        if this.data[0] == '-' {
            negative = true;
            i = 1;
        } else if this.data[0] == '+' {
            negative = false;
            i = 1;
        }

        while i < this.length {
            let c: i8 = this.data[i];
            let mut value: u64 = 0;

            if c >= '0' && c <= '9' {
                value = (c - '0') as u64;
            } else if c >= 'A' && c <= 'Z' {
                value = (c - 'A' + 10) as u64;
            } else if c >= 'a' && c <= 'z' {
                value = (c - 'a' + 10) as u64;
            } else {
                break;
            }

            if value >= base { break; }
            result = result * base + value;
            i += 1;
        } return result;
    }

    pub fn ToUnsignedInteger(&this, base: u64) -> u64 {
        let mut negative = false;
        let value = this.ParseUnsigned(base, negative);

        if negative {
            return !value + 1;
        } return value;
    }

    pub fn ToUnsignedInteger(&this) -> u64 {
        return this.ToUnsignedInteger(10);
    }

    pub fn ToInteger(&this, base: i64) -> i64 {
        let mut negative = false;
        let value = this.ParseUnsigned(base as u64, negative);

        if negative {
            return -(value as i64);
        } return value as i64;
    }

    pub fn ToInteger(&this) -> i64 {
        return this.ToInteger(10);
    }

    pub fn ToFloat(&this) -> f64 {
        if this.length == 0 { return 0.0; }
        if this == "nan" { return 0.0 / 0.0; }
        if this == "inf" || this == "+inf" { return 1.0 / 0.0; }
        if this == "-inf" { return -1.0 / 0.0; }
        let (mut value, mut negative) = (0.0, false);
        let mut i: usize = 0;

        if this.data[0] == '-' {
            negative = true;
            i = 1;
        } else if this.data[0] == '+' {
            i = 1;
        }

        while i < this.length {
            let c: i8 = this.data[i];
            if c < '0' || c > '9' { break; }
            value *= 10.0;
            value += (c - '0') as f64;
            i += 1;
        }

        if i < this.length && this.data[i] == '.' {
            i += 1;
            let mut divisor = 10.0;

            while i < this.length {
                let c: i8 = this.data[i];
                if c < '0' || c > '9' { break; }
                value += (c - '0') as f64 / divisor;
                divisor *= 10.0;
                i += 1;
            }
        }

        if i < this.length && (this.data[i] == 'e' || this.data[i] == 'E') {
            i += 1;
            let mut negative = false;

            if i < this.length {
                if this.data[i] == '-' {
                    negative = true;
                    i += 1;
                } else if this.data[i] == '+' {
                    i += 1;
                }
            }

            let mut exponent: i64 = 0;

            while i < this.length {
                let c: i8 = this.data[i];
                if c < '0' || c > '9' { break; }
                exponent *= 10;
                exponent += (c - '0') as i64;
                i += 1;
            }

            while exponent > 0 {
                if negative {
                    value /= 10.0;
                } else {
                    value *= 10.0;
                } exponent -= 1;
            }
        }

        if negative {
            return -value;
        } return value;
    }

    pub fn ToLower(&this) -> String {
        let mut result = String();
        result.Allocate(this.length);

        for i in 0..this.length {
            let mut c: i8 = this.data[i];
            if c >= 'A' && c <= 'Z' { c += 32; }
            result.data[i] = c;
        } return result;
    }

    pub fn ToUpper(&this) -> String {
        let mut result = String();
        result.Allocate(this.length);

        for i in 0..this.length {
            let mut c: i8 = this.data[i];
            if c >= 'a' && c <= 'z' { c -= 32; }
            result.data[i] = c;
        } return result;
    }

    pub fn Reverse(&this) -> String {
        let mut result = String();
        result.Allocate(this.length);

        for i in 0..this.length {
            result.data[i] = this.data[this.length - 1 - i];
        } return result;
    }

    pub fn Escape(&this) -> String {
        let mut result = String();

        for i in 0..this.length {
            if this.data[i] == '\a' {
                result += "\\a";
            } else if this.data[i] == '\b' {
                result += "\\b";
            } else if this.data[i] == '\f' {
                result += "\\f";
            } else if this.data[i] == '\n' {
                result += "\\n";
            } else if this.data[i] == '\r' {
                result += "\\r";
            } else if this.data[i] == '\t' {
                result += "\\t";
            } else if this.data[i] == '\v' {
                result += "\\v";
            } else {
                result += this.data[i];
            }
        } return result;
    }

    pub fn Replace(&this, from: &String, to: &String) -> String {
        return this.Replace(from.data, to.data, from.length);
    }

    pub fn Replace(&this, from: *i8, to: &String) -> String {
        return this.Replace(from, to.data, strlen(from));
    }

    pub fn Replace(&this, from: &String, to: *i8) -> String {
        return this.Replace(from.data, to, from.length);
    }

    pub fn Replace(&this, from: *i8, to: *i8) -> String {
        return this.Replace(from, to, strlen(from));
    }

    fn Replace(&this, from: *i8, to: *i8, length: usize) -> String {
        let mut result = String();
        let mut i: usize = 0;

        if length == 0 {
            result += this.data;
            return result;
        }

        while i < this.length {
            let mut _match = true;

            for j in 0..length {
                if i + j >= this.length || this.data[i + j] != from[j] {
                    _match = false;
                    break;
                }
            }

            if _match {
                result += to;
                i += length;
            } else {
                result += this.data[i];
                i += 1;
            }
        } return result;
    }

    pub fn SubString(&this, start: usize) -> String {
        if start < this.length {
            return String(this.data + start);
        } else {
            return String();
        }
    }

    pub fn SubString(&this, start: usize, mut length: usize) -> String {
        if start < this.length {
            let mut result = String();

            if start + length > this.length {
                length = this.length - start;
            }

            for i in 0..length {
                result += this.data[start + i];
            } return result;
        } else {
            return String();
        }
    }

    pub fn Contains(&this, substring: &String) -> bool {
        return this.Contains(substring.data, substring.length);
    }

    pub fn Contains(&this, substring: *i8) -> bool {
        return this.Contains(substring, strlen(substring));
    }

    fn Contains(&this, substring: *i8, length: usize) -> bool {
        return this.Find(substring, length) != -1;
    }

    pub fn Contains(&this, character: i8) -> bool {
        return this.Find(character) != -1;
    }

    pub fn StartsWith(&this, prefix: &String) -> bool {
        return this.StartsWith(prefix.data, prefix.length);
    }

    pub fn StartsWith(&this, prefix: *i8) -> bool {
        return this.StartsWith(prefix, strlen(prefix));
    }

    fn StartsWith(&this, prefix: *i8, length: usize) -> bool {
        if prefix == null { return false; }
        if length == 0 { return true; }
        if length > this.length { return false; }

        for i in 0..length {
            if this.data[i] != prefix[i] {
                return false;
            }
        } return true;
    }

    pub fn StartsWith(&this, character: i8) -> bool {
        if this.length == 0 { return false; }
        return this.data[0] == character;
    }

    pub fn EndsWith(&this, suffix: &String) -> bool {
        return this.EndsWith(suffix.data, suffix.length);
    }

    pub fn EndsWith(&this, suffix: *i8) -> bool {
        return this.EndsWith(suffix, strlen(suffix));
    }

    fn EndsWith(&this, suffix: *i8, length: usize) -> bool {
        if suffix == null { return false; }
        if length == 0 { return true; }
        if length > this.length { return false; }
        let start = this.length - length;

        for i in 0..length {
            if this.data[start + i] != suffix[i] {
                return false;
            }
        } return true;
    }

    pub fn EndsWith(&this, character: i8) -> bool {
        if this.length == 0 { return false; }
        return this.data[this.length - 1] == character;
    }

    pub fn Split(&this, delimiter: &String) -> Vector<String> {
        return this.Split(delimiter.data, delimiter.length);
    }

    pub fn Split(&this, delimiter: *i8) -> Vector<String> {
        return this.Split(delimiter, strlen(delimiter));
    }

    fn Split(&this, delimiter: *i8, length: usize) -> Vector<String> {
        let mut result = Vector<String>();

        if length == 0 {
            result.PushBack(String(this.data));
            return result;
        }

        if length == 1 {
            return this.Split(delimiter[0]);
        }

        let mut current = String();
        let mut i: usize = 0;

        while i < this.length {
            let mut found = true;

            if i + length <= this.length {
                for j in 0..length {
                    if this.data[i + j] != delimiter[j] {
                        found = false;
                        break;
                    }
                }
            } else {
                found = false;
            }

            if found {
                result.PushBack(current);
                current = String();
                i += length;
            } else {
                current += this.data[i];
                i += 1;
            }
        }

        if !current.Empty() {
            result.PushBack(current);
        } return result;
    }

    pub fn Split(&this, delimiter: i8) -> Vector<String> {
        let mut result = Vector<String>();
        let mut current = String();

        for i in 0..this.length {
            if this.data[i] != delimiter {
                current += this.data[i];
            } else {
                result.PushBack(current);
                current = "";
            }
        }

        if !current.Empty() {
            result.PushBack(current);
        } return result;
    }

    pub fn Count(&this, substring: &String) -> usize {
        return this.Count(substring.data, substring.length);
    }

    pub fn Count(&this, substring: *i8) -> usize {
        return this.Count(substring, strlen(substring));
    }

    fn Count(&this, substring: *i8, length: usize) -> usize {
        if substring == null { return 0; }
        if length == 0 { return 0; }
        if length > this.length { return 0; }
        let mut count: usize = 0;
        let mut i: usize = 0;

        while i <= this.length - length {
            let mut found = true;

            for j in 0..length {
                if this.data[i + j] != substring[j] {
                    found = false;
                    break;
                }
            }

            if found {
                count += 1;
                i += length;
            } else {
                i += 1;
            }
        } return count;
    }

    pub fn Count(&this, character: i8) -> usize {
        let mut count: usize = 0;

        for i in 0..this.length {
            if this.data[i] == character {
                count += 1;
            }
        } return count;
    }

    pub fn Find(&this, substring: &String) -> isize {
        return this.Find(substring.data, substring.length);
    }

    pub fn Find(&this, substring: *i8) -> isize {
        return this.Find(substring, strlen(substring));
    }

    fn Find(&this, substring: *i8, length: usize) -> isize {
        if substring == null { return -1; }
        if length == 0 { return 0; }
        if length > this.length { return -1; }

        for i in 0..=(this.length - length) {
            let mut found = true;

            for j in 0..length {
                if this.data[i + j] != substring[j] {
                    found = false;
                    break;
                }
            }

            if found {
                return i as isize;
            }
        } return -1;
    }

    pub fn Find(&this, character: i8) -> isize {
        for i in 0..this.length {
            if this.data[i] == character {
                return i as isize;
            }
        } return -1;
    }

    pub fn Strip(&this) -> String {
        let mut start: usize = 0;

        while start < this.length && (this.data[start] == ' ' || this.data[start] == '\t') {
            start += 1;
        }

        let mut end = this.length;

        while end > start && (this.data[end - 1] == ' ' || this.data[end - 1] == '\t' || this.data[end - 1] == '\n' || this.data[end - 1] == '\r') {
            end -= 1;
        }

        return this.SubString(start, end - start);
    }

    pub fn Hash(&this) -> u64 {
        let mut hash: u64 = 0xcbf29ce484222325;

        for i in 0..this.length {
            let character: i8 = this.data[i];
            hash = hash ^ (character as u64 & 0xFF);
            hash = hash * 0x100000001b3;
        } return hash;
    }

    pub fn operator=(&mut this, other: &String) -> &mut String {
        return this.operator=(other.data);
    }

    pub fn operator=(&mut this, string: *i8) -> &mut String {
        this.Release();

        if string == null {
            this.Allocate(0);
            return this;
        }

        this.Allocate(strlen(string));
        memcpy(this.data, string, this.length);
        return this;
    }

    pub fn operator=(&mut this, character: i8) -> &mut String {
        this.Release();
        this.Allocate(1);
        this.data[0] = character;
        return this;
    }

    pub fn operator+=(&mut this, other: &String) -> &mut String {
        return this.operator+=(other.data);
    }

    pub fn operator+=(&mut this, string: *i8) -> &mut String {
        if string == null { return this; }
        let string_length = strlen(string);
        let (data, length) = (this.data, this.length);
        this.Allocate(length + string_length);

        if data != null {
            memcpy(this.data, data, length);
            delete[] data;
        }

        memcpy((this.data + length), string, string_length);
        return this;
    }

    pub fn operator+=(&mut this, character: i8) -> &mut String {
        let (data, length) = (this.data, this.length);
        this.Allocate(length + 1);

        if data != null {
            memcpy(this.data, data, length);
            delete[] data;
        }

        this.data[length] = character;
        return this;
    }

    pub fn operator+(&this, other: &String) -> String {
        return this.operator+(other.data);
    }

    pub fn operator+(&this, string: *i8) -> String {
        let mut result = String(this.data);
        result += string;
        return result;
    }

    pub fn operator+(&this, character: i8) -> String {
        let mut result = String(this.data);
        result += character;
        return result;
    }

    pub fn operator*=(&mut this, count: usize) -> &mut String {
        if count <= 0 {
            this.Release();
            this.Allocate(0);
            return this;
        } else {
            let temp = String(this.data);

            for i in 0..(count - 1) {
                this.operator+=(temp.data);
            } return this;
        }
    }

    pub fn operator*(&this, count: usize) -> String {
        let mut result = String(this.data);
        result *= count;
        return result;
    }

    pub fn operator==(&this, other: &String) -> bool {
        if this.length != other.length { return false; }
        if this.data == null || other.data == null { return false; }
        return strcmp(this.data, other.data) == 0;
    }

    pub fn operator==(&this, string: *i8) -> bool {
        if this.length != strlen(string) { return false; }
        if this.data == null || string == null { return false; }
        return strcmp(this.data, string) == 0;
    }

    pub fn operator==(&this, character: i8) -> bool {
        if this.length != 1 { return false; }
        if this.data == null { return false; }
        return this.data[0] == character;
    }

    pub fn operator!=(&this, other: &String) -> bool {
        return !(this == other);
    }

    pub fn operator!=(&this, string: *i8) -> bool {
        return !(this == string);
    }

    pub fn operator!=(&this, character: i8) -> bool {
        return !(this == character);
    }

    pub fn operator[](&this, index: usize) -> &mut i8 {
        return this.data[index];
    }

    pub fn Begin(&this) -> *i8 {
        return this.data;
    }

    pub fn End(&this) -> *i8 {
        return this.data + this.length;
    }
}

fn ToString(value: i8) -> String {
    return String(value);
}

fn ToString(value: *i8) -> String {
    return String(value);
}

fn operator+(value: i8, string: &String) -> String {
    return String(value) + string;
}

fn operator+(value: *i8, string: &String) -> String {
    return String(value) + string;
}

fn operator*(value: i8, count: usize) -> String {
    return String(value) * count;
}

fn operator*(value: *i8, count: usize) -> String {
    return String(value) * count;
}
