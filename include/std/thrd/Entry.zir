const thrd_success: i32 = 0;
const thrd_busy: i32 = 1;
const thrd_error: i32 = 2;
const thrd_nomem: i32 = 3;
const thrd_timedout: i32 = 4;

const mtx_plain: i32 = 0;
const mtx_timed: i32 = 1;
const mtx_recursive: i32 = 2;

class timespec {
    pub tv_sec: i64,
    pub tv_nsec: i32
}

class thrd_t {
    pub _Handle: *mut void,
    pub _Tid: u32
}

class mtx_t {
    pub _Type: u64,
    pub _Ptr: *mut void,
    pub _Cv: *mut void,
    pub _Owner: u32,
    pub _Cnt: u32
}

class cnd_t {
    pub _Ptr: *mut void
}

class tss_t {
    pub _Idx: u32
}

class once_flag {
    pub _Opaque: *mut void
}

type thrd_start_t = fn(*mut void);
type tss_dtor_t = fn(*mut void);

extern "C" {
    fn thrd_create(thr: *mut thrd_t, func_ptr: thrd_start_t, arg: *mut void) -> i32;
    fn thrd_current() -> thrd_t;
    fn thrd_detach(thr: thrd_t) -> i32;
    fn thrd_equal(thr0: thrd_t, thr1: thrd_t) -> i32;
    fn thrd_exit(res: i32) -> void;
    fn thrd_join(thr: thrd_t, res: *mut i32) -> i32;
#[if WINDOWS]
    fn Sleep(dwMilliseconds: u32) -> void;
#[else]
    fn thrd_sleep(duration: *timespec, remaining: *mut timespec) -> i32;
#[endif]
    fn thrd_yield() -> void;

    fn mtx_init(mutex: *mut mtx_t, type_: i32) -> i32;
    fn mtx_lock(mutex: *mut mtx_t) -> i32;
    fn mtx_timedlock(mutex: *mut mtx_t, time_point: *timespec) -> i32;
    fn mtx_trylock(mutex: *mut mtx_t) -> i32;
    fn mtx_unlock(mutex: *mut mtx_t) -> i32;
    fn mtx_destroy(mutex: *mut mtx_t) -> void;

    fn cnd_init(cond: *mut cnd_t) -> i32;
    fn cnd_signal(cond: *mut cnd_t) -> i32;
    fn cnd_broadcast(cond: *mut cnd_t) -> i32;
    fn cnd_wait(cond: *mut cnd_t, mutex: *mut mtx_t) -> i32;
    fn cnd_timedwait(cond: *mut cnd_t, mutex: *mut mtx_t, time_point: *timespec) -> i32;
    fn cnd_destroy(cond: *mut cnd_t) -> void;

    fn tss_create(key: *mut tss_t, dtor: tss_dtor_t) -> i32;
    fn tss_get(key: tss_t) -> *mut void;
    fn tss_set(key: tss_t, val: *mut void) -> i32;
    fn tss_delete(key: tss_t) -> void;

    fn call_once(flag: *mut once_flag, func_ptr: *mut void) -> void;
}

type ThreadFunction = thrd_start_t;

class Thread {
    thread: thrd_t,
    joined: bool = false;

    Thread(&mut this, function: ThreadFunction, argument: *mut void) {
        thrd_create(&mut this.thread, function, argument);
    }

    ~Thread(&mut this) {
        if !this.joined {
            this.Detach();
        }
    }

    pub fn Join(&mut this) -> i32 {
        if !this.joined {
            let mut res = 0;
            let status = thrd_join(this.thread, &mut res);
            this.joined = true;
            return res;
        } return 0;
    }

    pub fn Detach(&mut this) {
        if !this.joined {
            thrd_detach(this.thread);
            this.joined = true;
        }
    }

    pub fn GetId(&this) -> u32 {
        return this.thread._Tid;
    }

    pub fn Sleep(&this, seconds: i64, nanoseconds: i32) {
#[if WINDOWS]
        Sleep((seconds * 1000 + (nanoseconds / 1000000) as i64) as u32);
#[else]
        let mut ts: timespec;
        (ts.tv_sec, ts.tv_nsec) = (seconds, nanoseconds);
        thrd_sleep(&ts, null);
#[endif]
    }

    pub fn Yield() {
        thrd_yield();
    }
}

class Mutex {
    mutex: mtx_t;

    Mutex(&mut this) {
        mtx_init(&mut this.mutex, mtx_plain);
    }

    Mutex(&mut this, _type: i32) {
        mtx_init(&mut this.mutex, _type);
    }

    ~Mutex(&mut this) {
        mtx_destroy(&mut this.mutex);
    }

    pub fn Lock(&mut this) {
        mtx_lock(&mut this.mutex);
    }

    pub fn Unlock(&mut this) {
        mtx_unlock(&mut this.mutex);
    }

    pub fn TryLock(&mut this) -> bool {
        return mtx_trylock(&mut this.mutex) == thrd_success;
    }

    pub fn Handle(&mut this) -> *mut mtx_t {
        return &mut this.mutex;
    }
}

class ScopedLock {
    mutex: *mut Mutex;

    ScopedLock(&mut this, mutex: *mut Mutex) {
        this.mutex = mutex;
        this.mutex->Lock();
    }

    ~ScopedLock(&mut this) {
        this.mutex->Unlock();
    }
}

class ConditionVariable {
    condition: cnd_t;

    ConditionVariable(&mut this) {
        cnd_init(&mut this.condition);
    }

    ~ConditionVariable(&mut this) {
        cnd_destroy(&mut this.condition);
    }

    pub fn Signal(&mut this) {
        cnd_signal(&mut this.condition);
    }

    pub fn Broadcast(&mut this) {
        cnd_broadcast(&mut this.condition);
    }

    pub fn Wait(&mut this, mtx: *mut Mutex) {
        cnd_wait(&mut this.condition, mtx->Handle());
    }
}