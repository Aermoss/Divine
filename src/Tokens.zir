#[include "std/str" : *]

enum TokenType: i32 {
    UNKNOWN, EOF,

    IDENTIFIER, INTEGER, FLOAT, STRING, CHAR, TRUE, FALSE, NULL, ZERO,

    INCLUDE, NEW, DELETE, ASYNC, AWAIT, AS, THIS, OPERATOR,
    IF, ELSE, FOR, IN, WHILE, LOOP, MATCH, RETURN, BREAK, CONTINUE,
    FUNC, CLASS, ENUM, TYPE, IMPL, EXTERN, LET, MUT, CONST, STATIC,
    PUBLIC, PRIVATE, ASSEMBLY, ASM_CODE, VOLATILE, UNSAFE,

    ASSIGN, PLUS_ASSIGN, MINUS_ASSIGN, MUL_ASSIGN, DIV_ASSIGN, MOD_ASSIGN,
    LSHIFT_ASSIGN, RSHIFT_ASSIGN, AND_ASSIGN, OR_ASSIGN, XOR_ASSIGN,

    PLUS, MINUS, MUL, DIV, MOD, AND, OR, NOT,
    BITWISE_AND, BITWISE_OR, BITWISE_XOR, LSHIFT, RSHIFT, TILDE,
    EQUAL, NOT_EQUAL, GREATER, LESS, GREATER_EQUAL, LESS_EQUAL,

    LPAREN, RPAREN, LBRACE, RBRACE, LBRACKET, RBRACKET,
    DOT, TWO_DOT, THREE_DOT, COMMA, COLON, DOUBLE_COLON, SEMICOLON,
    AT, QUESTION_MARK, BACKSLASH, ARROW, FAT_ARROW,

    PREPROCESSOR_START, PREPROCESSOR_END,
    ENDIF, ELIF, ERROR, WARNING
}

func ToString(_type: TokenType) -> String {
    if _type == TokenType::EOF { ret "EOF".ToString(); }
    else if _type == TokenType::IDENTIFIER { ret "IDENTIFIER".ToString(); }
    else if _type == TokenType::INTEGER { ret "INTEGER".ToString(); }
    else if _type == TokenType::FLOAT { ret "FLOAT".ToString(); }
    else if _type == TokenType::STRING { ret "STRING".ToString(); }
    else if _type == TokenType::CHAR { ret "CHAR".ToString(); }
    else if _type == TokenType::TRUE { ret "TRUE".ToString(); }
    else if _type == TokenType::FALSE { ret "FALSE".ToString(); }
    else if _type == TokenType::NULL { ret "NULL".ToString(); }
    else if _type == TokenType::ZERO { ret "ZERO".ToString(); }
    else if _type == TokenType::INCLUDE { ret "INCLUDE".ToString(); }
    else if _type == TokenType::NEW { ret "NEW".ToString(); }
    else if _type == TokenType::DELETE { ret "DELETE".ToString(); }
    else if _type == TokenType::ASYNC { ret "ASYNC".ToString(); }
    else if _type == TokenType::AWAIT { ret "AWAIT".ToString(); }
    else if _type == TokenType::AS { ret "AS".ToString(); }
    else if _type == TokenType::THIS { ret "THIS".ToString(); }
    else if _type == TokenType::OPERATOR { ret "OPERATOR".ToString(); }
    else if _type == TokenType::IF { ret "IF".ToString(); }
    else if _type == TokenType::ELSE { ret "ELSE".ToString(); }
    else if _type == TokenType::FOR { ret "FOR".ToString(); }
    else if _type == TokenType::IN { ret "IN".ToString(); }
    else if _type == TokenType::WHILE { ret "WHILE".ToString(); }
    else if _type == TokenType::LOOP { ret "LOOP".ToString(); }
    else if _type == TokenType::MATCH { ret "MATCH".ToString(); }
    else if _type == TokenType::RETURN { ret "RETURN".ToString(); }
    else if _type == TokenType::BREAK { ret "BREAK".ToString(); }
    else if _type == TokenType::CONTINUE { ret "CONTINUE".ToString(); }
    else if _type == TokenType::FUNC { ret "FUNC".ToString(); }
    else if _type == TokenType::CLASS { ret "CLASS".ToString(); }
    else if _type == TokenType::ENUM { ret "ENUM".ToString(); }
    else if _type == TokenType::TYPE { ret "TYPE".ToString(); }
    else if _type == TokenType::IMPL { ret "IMPL".ToString(); }
    else if _type == TokenType::EXTERN { ret "EXTERN".ToString(); }
    else if _type == TokenType::LET { ret "LET".ToString(); }
    else if _type == TokenType::MUT { ret "MUT".ToString(); }
    else if _type == TokenType::CONST { ret "CONST".ToString(); }
    else if _type == TokenType::STATIC { ret "STATIC".ToString(); }
    else if _type == TokenType::PUBLIC { ret "PUBLIC".ToString(); }
    else if _type == TokenType::PRIVATE { ret "PRIVATE".ToString(); }
    else if _type == TokenType::ASSEMBLY { ret "ASSEMBLY".ToString(); }
    else if _type == TokenType::ASM_CODE { ret "ASM_CODE".ToString(); }
    else if _type == TokenType::VOLATILE { ret "VOLATILE".ToString(); }
    else if _type == TokenType::UNSAFE { ret "UNSAFE".ToString(); }
    else if _type == TokenType::ASSIGN { ret "ASSIGN".ToString(); }
    else if _type == TokenType::PLUS_ASSIGN { ret "PLUS_ASSIGN".ToString(); }
    else if _type == TokenType::MINUS_ASSIGN { ret "MINUS_ASSIGN".ToString(); }
    else if _type == TokenType::MUL_ASSIGN { ret "MUL_ASSIGN".ToString(); }
    else if _type == TokenType::DIV_ASSIGN { ret "DIV_ASSIGN".ToString(); }
    else if _type == TokenType::MOD_ASSIGN { ret "MOD_ASSIGN".ToString(); }
    else if _type == TokenType::LSHIFT_ASSIGN { ret "LSHIFT_ASSIGN".ToString(); }
    else if _type == TokenType::RSHIFT_ASSIGN { ret "RSHIFT_ASSIGN".ToString(); }
    else if _type == TokenType::AND_ASSIGN { ret "AND_ASSIGN".ToString(); }
    else if _type == TokenType::OR_ASSIGN { ret "OR_ASSIGN".ToString(); }
    else if _type == TokenType::XOR_ASSIGN { ret "XOR_ASSIGN".ToString(); }
    else if _type == TokenType::PLUS { ret "PLUS".ToString(); }
    else if _type == TokenType::MINUS { ret "MINUS".ToString(); }
    else if _type == TokenType::MUL { ret "MUL".ToString(); }
    else if _type == TokenType::DIV { ret "DIV".ToString(); }
    else if _type == TokenType::MOD { ret "MOD".ToString(); }
    else if _type == TokenType::AND { ret "AND".ToString(); }
    else if _type == TokenType::OR { ret "OR".ToString(); }
    else if _type == TokenType::NOT { ret "NOT".ToString(); }
    else if _type == TokenType::BITWISE_AND { ret "BITWISE_AND".ToString(); }
    else if _type == TokenType::BITWISE_OR { ret "BITWISE_OR".ToString(); }
    else if _type == TokenType::BITWISE_XOR { ret "BITWISE_XOR".ToString(); }
    else if _type == TokenType::LSHIFT { ret "LSHIFT".ToString(); }
    else if _type == TokenType::RSHIFT { ret "RSHIFT".ToString(); }
    else if _type == TokenType::TILDE { ret "TILDE".ToString(); }
    else if _type == TokenType::EQUAL { ret "EQUAL".ToString(); }
    else if _type == TokenType::NOT_EQUAL { ret "NOT_EQUAL".ToString(); }
    else if _type == TokenType::GREATER { ret "GREATER".ToString(); }
    else if _type == TokenType::LESS { ret "LESS".ToString(); }
    else if _type == TokenType::GREATER_EQUAL { ret "GREATER_EQUAL".ToString(); }
    else if _type == TokenType::LESS_EQUAL { ret "LESS_EQUAL".ToString(); }
    else if _type == TokenType::LPAREN { ret "LPAREN".ToString(); }
    else if _type == TokenType::RPAREN { ret "RPAREN".ToString(); }
    else if _type == TokenType::LBRACE { ret "LBRACE".ToString(); }
    else if _type == TokenType::RBRACE { ret "RBRACE".ToString(); }
    else if _type == TokenType::LBRACKET { ret "LBRACKET".ToString(); }
    else if _type == TokenType::RBRACKET { ret "RBRACKET".ToString(); }
    else if _type == TokenType::DOT { ret "DOT".ToString(); }
    else if _type == TokenType::TWO_DOT { ret "TWO_DOT".ToString(); }
    else if _type == TokenType::THREE_DOT { ret "THREE_DOT".ToString(); }
    else if _type == TokenType::COMMA { ret "COMMA".ToString(); }
    else if _type == TokenType::COLON { ret "COLON".ToString(); }
    else if _type == TokenType::DOUBLE_COLON { ret "DOUBLE_COLON".ToString(); }
    else if _type == TokenType::SEMICOLON { ret "SEMICOLON".ToString(); }
    else if _type == TokenType::AT { ret "AT".ToString(); }
    else if _type == TokenType::QUESTION_MARK { ret "QUESTION_MARK".ToString(); }
    else if _type == TokenType::BACKSLASH { ret "BACKSLASH".ToString(); }
    else if _type == TokenType::ARROW { ret "ARROW".ToString(); }
    else if _type == TokenType::FAT_ARROW { ret "FAT_ARROW".ToString(); }
    else if _type == TokenType::PREPROCESSOR_START { ret "PREPROCESSOR_START".ToString(); }
    else if _type == TokenType::PREPROCESSOR_END { ret "PREPROCESSOR_END".ToString(); }
    else if _type == TokenType::ENDIF { ret "ENDIF".ToString(); }
    else if _type == TokenType::ELIF { ret "ELIF".ToString(); }
    else if _type == TokenType::ERROR { ret "ERROR".ToString(); }
    else if _type == TokenType::WARNING { ret "WARNING".ToString(); }
    else { ret "UNKNOWN".ToString(); }
}

func ToAssignmentOperatorString(operator: TokenType) -> String {
    if operator == TokenType::ASSIGN { ret "=".ToString(); }
    else if operator == TokenType::PLUS_ASSIGN { ret "+=".ToString(); }
    else if operator == TokenType::MINUS_ASSIGN { ret "-=".ToString(); }
    else if operator == TokenType::MUL_ASSIGN { ret "*=".ToString(); }
    else if operator == TokenType::DIV_ASSIGN { ret "/=".ToString(); }
    else if operator == TokenType::MOD_ASSIGN { ret "%=".ToString(); }
    else if operator == TokenType::LSHIFT_ASSIGN { ret "<<=".ToString(); }
    else if operator == TokenType::RSHIFT_ASSIGN { ret ">>=".ToString(); }
    else if operator == TokenType::AND_ASSIGN { ret "&=".ToString(); }
    else if operator == TokenType::OR_ASSIGN { ret "|=".ToString(); }
    else if operator == TokenType::XOR_ASSIGN { ret "^=".ToString(); }
    else { ret "unknown".ToString(); }
}

func ToBinaryOperatorString(operator: TokenType) -> String {
    if operator == TokenType::PLUS { ret "+".ToString(); }
    else if operator == TokenType::MINUS { ret "-".ToString(); }
    else if operator == TokenType::MUL { ret "*".ToString(); }
    else if operator == TokenType::DIV { ret "/".ToString(); }
    else if operator == TokenType::MOD { ret "%".ToString(); }
    else if operator == TokenType::EQUAL { ret "==".ToString(); }
    else if operator == TokenType::NOT_EQUAL { ret "!=".ToString(); }
    else if operator == TokenType::GREATER { ret ">".ToString(); }
    else if operator == TokenType::LESS { ret "<".ToString(); }
    else if operator == TokenType::GREATER_EQUAL { ret ">=".ToString(); }
    else if operator == TokenType::LESS_EQUAL { ret "<=".ToString(); }
    else if operator == TokenType::AND { ret "&&".ToString(); }
    else if operator == TokenType::OR { ret "||".ToString(); }
    else if operator == TokenType::BITWISE_AND { ret "&".ToString(); }
    else if operator == TokenType::BITWISE_OR { ret "|".ToString(); }
    else if operator == TokenType::BITWISE_XOR { ret "^".ToString(); }
    else if operator == TokenType::LSHIFT { ret "<<".ToString(); }
    else if operator == TokenType::RSHIFT { ret ">>".ToString(); }
    else { ret "unknown".ToString(); }
}

func ToUnaryOperatorString(operator: TokenType) -> String {
    if operator == TokenType::MINUS { ret "-".ToString(); }
    else if operator == TokenType::MUL { ret "*".ToString(); }
    else if operator == TokenType::NOT { ret "!".ToString(); }
    else if operator == TokenType::BITWISE_AND { ret "&".ToString(); }
    else { ret "unknown".ToString(); }
}

func StringToKeyword(string: String) -> TokenType {
    if string == "true" { ret TokenType::TRUE; }
    else if string == "false" { ret TokenType::FALSE; }
    else if string == "null" { ret TokenType::NULL; }
    else if string == "zero" { ret TokenType::ZERO; }
    else if string == "new" { ret TokenType::NEW; }
    else if string == "del" { ret TokenType::DELETE; }
    else if string == "async" { ret TokenType::ASYNC; }
    else if string == "await" { ret TokenType::AWAIT; }
    else if string == "as" { ret TokenType::AS; }
    else if string == "this" { ret TokenType::THIS; }
    else if string == "if" { ret TokenType::IF; }
    else if string == "else" { ret TokenType::ELSE; }
    else if string == "for" { ret TokenType::FOR; }
    else if string == "in" { ret TokenType::IN; }
    else if string == "while" { ret TokenType::WHILE; }
    else if string == "loop" { ret TokenType::LOOP; }
    else if string == "match" { ret TokenType::MATCH; }
    else if string == "ret" { ret TokenType::RETURN; }
    else if string == "break" { ret TokenType::BREAK; }
    else if string == "continue" { ret TokenType::CONTINUE; }
    else if string == "func" { ret TokenType::FUNC; }
    else if string == "class" { ret TokenType::CLASS; }
    else if string == "enum" { ret TokenType::ENUM; }
    else if string == "type" { ret TokenType::TYPE; }
    else if string == "impl" { ret TokenType::IMPL; }
    else if string == "extern" { ret TokenType::EXTERN; }
    else if string == "let" { ret TokenType::LET; }
    else if string == "mut" { ret TokenType::MUT; }
    else if string == "const" { ret TokenType::CONST; }
    else if string == "static" { ret TokenType::STATIC; }
    else if string == "pub" { ret TokenType::PUBLIC; }
    else if string == "priv" { ret TokenType::PRIVATE; }
    else if string == "op" { ret TokenType::OPERATOR; }
    else if string == "asm" { ret TokenType::ASSEMBLY; }
    else if string == "volatile" { ret TokenType::VOLATILE; }
    else if string == "unsafe" { ret TokenType::UNSAFE; }
    else { ret TokenType::UNKNOWN; }
}

func StringToDirective(string: String) -> TokenType {
    if string == "true" { ret TokenType::TRUE; }
    else if string == "false" { ret TokenType::FALSE; }
    else if string == "if" { ret TokenType::IF; }
    else if string == "elif" { ret TokenType::ELIF; }
    else if string == "else" { ret TokenType::ELSE; }
    else if string == "endif" { ret TokenType::ENDIF; }
    else if string == "include" { ret TokenType::INCLUDE; }
    else if string == "error" { ret TokenType::ERROR; }
    else if string == "warning" { ret TokenType::WARNING; }
    else { ret TokenType::UNKNOWN; }
}

class Token {
    pub _type: TokenType,
    pub value: String,
    pub row: u32,
    pub column: u32,
    pub file: String
}
