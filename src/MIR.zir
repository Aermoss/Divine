#[include "std/str", "std/vec", "src/Types.zir" : *]

enum MIRTypeKind: u8 {
    Void, Integer, Float, Pointer, Array, Structure, Function
}

class MIRType {
    pub kind: MIRTypeKind;

    MIRType(&mut this, kind: MIRTypeKind) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        if this.kind == MIRTypeKind::Void {
            return (this as *MIRVoidType)->ToString();
        } else if this.kind == MIRTypeKind::Integer {
            return (this as *MIRIntegerType)->ToString();
        } else if this.kind == MIRTypeKind::Float {
            return (this as *MIRFloatType)->ToString();
        } else if this.kind == MIRTypeKind::Pointer {
            return (this as *MIRPointerType)->ToString();
        } else if this.kind == MIRTypeKind::Array {
            return (this as *MIRArrayType)->ToString();
        } else if this.kind == MIRTypeKind::Structure {
            return (this as *MIRStructureType)->ToString();
        } else if this.kind == MIRTypeKind::Function {
            return (this as *MIRFunctionType)->ToString();
        } else {
            return "<invalid type>".ToString();
        }
    }
}

class MIRVoidType : MIRType {
    MIRVoidType(&mut this) : MIRType(MIRTypeKind::Void) {}

    pub fn ToString(&this) -> String {
        return "void".ToString();
    }
}

class MIRIntegerType : MIRType {
    pub width: u32;

    MIRIntegerType(&mut this, width: u32) : MIRType(MIRTypeKind::Integer) {
        this.width = width;
    }

    pub fn ToString(&this) -> String {
        return 'i' + String::FromInteger(this.width as u64);
    }
}

class MIRFloatType : MIRType {
    pub width: u32;

    MIRFloatType(&mut this, width: u32) : MIRType(MIRTypeKind::Float) {
        this.width = width;
    }

    pub fn ToString(&this) -> String {
        return 'f' + String::FromInteger(this.width as u64);
    }
}

class MIRPointerType : MIRType {
    pub pointee: *MIRType;

    MIRPointerType(&mut this, pointee: *MIRType) : MIRType(MIRTypeKind::Pointer) {
        this.pointee = pointee;
    }

    pub fn ToString(&this) -> String {
        return '*' + this.pointee->ToString();
    }
}

class MIRArrayType : MIRType {
    pub element: *MIRType,
    pub length: usize;

    MIRArrayType(&mut this, element: *MIRType, length: usize) : MIRType(MIRTypeKind::Array) {
        (this.element, this.length) = (element, length);
    }

    pub fn ToString(&this) -> String {
        return '[' + this.element->ToString() + "; " + String::FromInteger(this.length as u64) + ']';
    }
}

class MIRStructureType : MIRType {
    pub name: String,
    pub fields: Vector<*MIRType>;

    MIRStructureType(&mut this, name: String) : MIRType(MIRTypeKind::Structure) {
        this.name = name;
    }

    MIRStructureType(&mut this, fields: Vector<*MIRType>) : MIRType(MIRTypeKind::Structure) {
        (this.name, this.fields) = ("".ToString(), fields);
    }

    pub fn SetBody(&mut this, fields: Vector<*MIRType>) {
        this.fields = fields;
    }

    pub fn ToDefinitionString(&this) -> String {
        let mut result = "{ ".ToString();

        for i in 0..this.fields.Size() {
            if i != 0 { result += ", "; }
            let _type: *MIRType = this.fields[i];
            result += _type->ToString();
        } return result + " }";
    }

    pub fn ToString(&this) -> String {
        if this.name.Empty()  {
            return this.ToDefinitionString();
        } return '%' + this.name;
    }
}

class MIRFunctionType : MIRType {
    pub parameters: Vector<*MIRType>,
    pub _return: *MIRType;

    MIRFunctionType(&mut this, parameters: Vector<*MIRType>, _return: *MIRType) : MIRType(MIRTypeKind::Function) {
        (this.parameters, this._return) = (parameters, _return);
    }

    pub fn ToString(&this) -> String {
        let mut result = "fn(".ToString();

        for i in 0..this.parameters.Size() {
            if i != 0 { result += ", "; }
            let parameter: *MIRType = this.parameters[i];
            result += parameter->ToString();
        } result += ')';

        if this._return->kind != MIRTypeKind::Void {
            result += " -> " + this._return->ToString();
        } return result;
    }
}

enum MIRValueKind: u8 {
    Constant, Instruction, DeclarationReference, Parameter
}

class MIRValue {
    pub kind: MIRValueKind,
    pub _type: *MIRType;

    MIRValue(&mut this, kind: MIRValueKind, _type: *MIRType) {
        (this.kind, this._type) = (kind, _type);
    }

    pub fn ToString(&this) -> String {
        let mut _type = this._type;

        if _type->kind == MIRTypeKind::Function {
            _type = (this._type as *MIRFunctionType)->_return;
        }

        if this.kind == MIRValueKind::Constant {
            return _type->ToString() + ' ' + (this as *MIRConstant)->ToString();
        } else if this.kind == MIRValueKind::Instruction {
            return _type->ToString() + ' ' + (this as *MIRInstruction)->ToString();
        } else if this.kind == MIRValueKind::DeclarationReference {
            return _type->ToString() + ' ' + (this as *MIRDeclarationReference)->ToString();
        } else if this.kind == MIRValueKind::Parameter {
            return _type->ToString() + ' ' + (this as *MIRParameter)->ToString();
        } else {
            return "<invalid value>".ToString();
        }
    }
}

enum MIRConstantKind: u8 {
    Integer, Float, String, Array, Structure, Null, Expression
}

class MIRConstant : MIRValue {
    pub kind: MIRConstantKind;

    MIRConstant(&mut this, kind: MIRConstantKind, _type: *MIRType) : MIRValue(MIRValueKind::Constant, _type) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        if this.kind == MIRConstantKind::Integer {
            return (this as *MIRConstantInteger)->ToString();
        } else if this.kind == MIRConstantKind::Float {
            return (this as *MIRConstantFloat)->ToString();
        } else if this.kind == MIRConstantKind::String {
            return (this as *MIRConstantString)->ToString();
        } else if this.kind == MIRConstantKind::Array {
            return (this as *MIRConstantArray)->ToString();
        } else if this.kind == MIRConstantKind::Structure {
            return (this as *MIRConstantStructure)->ToString();
        } else if this.kind == MIRConstantKind::Null {
            return (this as *MIRConstantNull)->ToString();
        } else if this.kind == MIRConstantKind::Expression {
            return (this as *MIRConstantExpression)->ToString();
        } else {
            return "<invalid constant>".ToString();
        }
    }
}

class MIRConstantInteger : MIRConstant {
    pub value: u64;

    MIRConstantInteger(&mut this, value: u64, _type: *MIRType) : MIRConstant(MIRConstantKind::Integer, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        let value = (this as *MIRConstant) as *MIRValue;

        if (value->_type as *MIRIntegerType)->width == 1 {
            return (this.value != 0 ? "true" : "false").ToString();
        } return String::FromInteger(this.value);
    }
}

class MIRConstantFloat : MIRConstant {
    pub value: f64;

    MIRConstantFloat(&mut this, value: f64, _type: *MIRType) : MIRConstant(MIRConstantKind::Float, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return String::FromFloat(this.value);
    }
}

class MIRConstantString : MIRConstant {
    pub value: String;

    MIRConstantString(&mut this, value: String, _type: *MIRType) : MIRConstant(MIRConstantKind::String, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return '"' + this.value.Escape() + '"';
    }
}

class MIRConstantArray : MIRConstant {
    pub elements: Vector<*MIRValue>;

    MIRConstantArray(&mut this, elements: Vector<*MIRValue>, _type: *MIRType) : MIRConstant(MIRConstantKind::Array, _type) {
        this.elements = elements;
    }

    pub fn ToString(&this) -> String {
        let mut result = '['.ToString();

        for i in 0..this.elements.Size() {
            if i != 0 { result += ", "; }
            let element: *MIRValue = this.elements[i];
            result += element->ToString();
        } return result + ']';
    }
}

class MIRConstantStructure : MIRConstant {
    pub fields: Vector<*MIRValue>;

    MIRConstantStructure(&mut this, fields: Vector<*MIRValue>, _type: *MIRType) : MIRConstant(MIRConstantKind::Structure, _type) {
        this.fields = fields;
    }

    pub fn ToString(&this) -> String {
        let mut result = '{'.ToString();

        for i in 0..this.fields.Size() {
            if i != 0 { result += ", "; }
            let field: *MIRValue = this.fields[i];
            result += field->ToString();
        } return result + '}';
    }
}

class MIRConstantNull : MIRConstant {
    MIRConstantNull(&mut this, _type: *MIRType) : MIRConstant(MIRConstantKind::Null, _type) {}

    pub fn ToString(&this) -> String {
        return "null".ToString();
    }
}

enum MIRConstantExpressionKind: u8 {
    Unary, Binary, Cast, ArrayGEP, StructGEP
}

class MIRConstantExpression : MIRConstant {
    pub kind: MIRConstantExpressionKind;

    MIRConstantExpression(&mut this, kind: MIRConstantExpressionKind, _type: *MIRType) : MIRConstant(MIRConstantKind::Expression, _type) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        if this.kind == MIRConstantExpressionKind::Unary {
            return (this as *MIRUnaryExpression)->ToString();
        } else if this.kind == MIRConstantExpressionKind::Binary {
            return (this as *MIRBinaryExpression)->ToString();
        } else if this.kind == MIRConstantExpressionKind::Cast {
            return (this as *MIRCastExpression)->ToString();
        } else if this.kind == MIRConstantExpressionKind::ArrayGEP {
            return (this as *MIRArrayGEPExpression)->ToString();
        } else if this.kind == MIRConstantExpressionKind::StructGEP {
            return (this as *MIRStructGEPExpression)->ToString();
        } else {
            return "<invalid expression>".ToString();
        }
    }
}

enum MIRUnaryKind: u8 {
    Neg, FNeg, Not
}

fn ToString(kind: MIRUnaryKind) -> String {
    if kind == MIRUnaryKind::Neg { return "neg".ToString(); }
    else if kind == MIRUnaryKind::FNeg { return "fneg".ToString(); }
    else if kind == MIRUnaryKind::Not { return "not".ToString(); }
    else { return "<invalid unary>".ToString(); }
}

class MIRUnaryExpression : MIRConstantExpression {
    pub kind: MIRUnaryKind,
    pub operand: *MIRValue;

    MIRUnaryExpression(&mut this, kind: MIRUnaryKind, operand: *MIRValue, _type: *MIRType) : MIRConstantExpression(MIRConstantExpressionKind::Unary, _type) {
        (this.kind, this.operand) = (kind, operand);
    }

    pub fn ToString(&this) -> String {
        return this.kind.ToString() + ' ' + this.operand->ToString();
    }
}

enum MIRBinaryKind: u8 {
    Add, Sub, Mul, SDiv, UDiv, SRem, URem,
    And, Or, Xor, Shl, LShr, AShr,
    FAdd, FSub, FMul, FDiv, FRem,
    ICmpEq, ICmpNe, ICmpSlt, ICmpSgt, ICmpSle, ICmpSge, ICmpUlt, ICmpUgt, ICmpUle, ICmpUge,
    FCmpEq, FCmpNe, FCmpLt, FCmpGt, FCmpLe, FCmpGe
}

fn ToString(kind: MIRBinaryKind) -> String {
    if kind == MIRBinaryKind::Add { return "add".ToString(); }
    else if kind == MIRBinaryKind::Sub { return "sub".ToString(); }
    else if kind == MIRBinaryKind::Mul { return "mul".ToString(); }
    else if kind == MIRBinaryKind::SDiv { return "sdiv".ToString(); }
    else if kind == MIRBinaryKind::UDiv { return "udiv".ToString(); }
    else if kind == MIRBinaryKind::SRem { return "srem".ToString(); }
    else if kind == MIRBinaryKind::URem { return "urem".ToString(); }
    else if kind == MIRBinaryKind::And { return "and".ToString(); }
    else if kind == MIRBinaryKind::Or { return "or".ToString(); }
    else if kind == MIRBinaryKind::Xor { return "xor".ToString(); }
    else if kind == MIRBinaryKind::Shl { return "shl".ToString(); }
    else if kind == MIRBinaryKind::LShr { return "lshr".ToString(); }
    else if kind == MIRBinaryKind::AShr { return "ashr".ToString(); }
    else if kind == MIRBinaryKind::FAdd { return "fadd".ToString(); }
    else if kind == MIRBinaryKind::FSub { return "fsub".ToString(); }
    else if kind == MIRBinaryKind::FMul { return "fmul".ToString(); }
    else if kind == MIRBinaryKind::FDiv { return "fdiv".ToString(); }
    else if kind == MIRBinaryKind::FRem { return "frem".ToString(); }
    else if kind == MIRBinaryKind::ICmpEq { return "icmp eq".ToString(); }
    else if kind == MIRBinaryKind::ICmpNe { return "icmp ne".ToString(); }
    else if kind == MIRBinaryKind::ICmpSlt { return "icmp slt".ToString(); }
    else if kind == MIRBinaryKind::ICmpSgt { return "icmp sgt".ToString(); }
    else if kind == MIRBinaryKind::ICmpSle { return "icmp sle".ToString(); }
    else if kind == MIRBinaryKind::ICmpSge { return "icmp sge".ToString(); }
    else if kind == MIRBinaryKind::ICmpUlt { return "icmp ult".ToString(); }
    else if kind == MIRBinaryKind::ICmpUgt { return "icmp ugt".ToString(); }
    else if kind == MIRBinaryKind::ICmpUle { return "icmp ule".ToString(); }
    else if kind == MIRBinaryKind::ICmpUge { return "icmp uge".ToString(); }
    else if kind == MIRBinaryKind::FCmpEq { return "fcmp eq".ToString(); }
    else if kind == MIRBinaryKind::FCmpNe { return "fcmp ne".ToString(); }
    else if kind == MIRBinaryKind::FCmpLt { return "fcmp lt".ToString(); }
    else if kind == MIRBinaryKind::FCmpGt { return "fcmp gt".ToString(); }
    else if kind == MIRBinaryKind::FCmpLe { return "fcmp le".ToString(); }
    else if kind == MIRBinaryKind::FCmpGe { return "fcmp ge".ToString(); }
    else { return "<invalid binary>".ToString(); }
}

class MIRBinaryExpression : MIRConstantExpression {
    pub kind: MIRBinaryKind,
    pub left: *MIRValue,
    pub right: *MIRValue;

    MIRBinaryExpression(&mut this, kind: MIRBinaryKind, left: *MIRValue, right: *MIRValue, _type: *MIRType) : MIRConstantExpression(MIRConstantExpressionKind::Binary, _type) {
        (this.kind, this.left, this.right) = (kind, left, right);
    }

    pub fn ToString(&this) -> String {
        return this.kind.ToString() + ' ' + this.left->ToString() + ", " + this.right->ToString();
    }
}

enum MIRCastKind: u8 {
    Trunc, ZExt, SExt,
    FPTrunc, FPExt, FPToSI, FPToUI, SIToFP, UIToFP,
    PtrToInt, IntToPtr, Bitcast
}

fn ToString(kind: MIRCastKind) -> String {
    if kind == MIRCastKind::Trunc { return "trunc".ToString(); }
    else if kind == MIRCastKind::ZExt { return "zext".ToString(); }
    else if kind == MIRCastKind::SExt { return "sext".ToString(); }
    else if kind == MIRCastKind::FPTrunc { return "fptrunc".ToString(); }
    else if kind == MIRCastKind::FPExt { return "fpext".ToString(); }
    else if kind == MIRCastKind::FPToSI { return "fptosi".ToString(); }
    else if kind == MIRCastKind::FPToUI { return "fptoui".ToString(); }
    else if kind == MIRCastKind::SIToFP { return "sitofp".ToString(); }
    else if kind == MIRCastKind::UIToFP { return "uitofp".ToString(); }
    else if kind == MIRCastKind::PtrToInt { return "ptrtoint".ToString(); }
    else if kind == MIRCastKind::IntToPtr { return "inttoptr".ToString(); }
    else if kind == MIRCastKind::Bitcast { return "bitcast".ToString(); }
    else { return "<invalid cast>".ToString(); }
}

class MIRCastExpression : MIRConstantExpression {
    pub kind: MIRCastKind,
    pub value: *MIRValue;

    MIRCastExpression(&mut this, kind: MIRCastKind, value: *MIRValue, _type: *MIRType) : MIRConstantExpression(MIRConstantExpressionKind::Cast, _type) {
        (this.kind, this.value) = (kind, value);
    }

    pub fn ToString(&this) -> String {
        let value = ((this as *MIRConstantExpression) as *MIRConstant) as *MIRValue;
        return this.kind.ToString() + ' ' + this.value->ToString() + " to " + value->_type->ToString();
    }
}

class MIRArrayGEPExpression : MIRConstantExpression {
    pub pointer: *MIRValue,
    pub index: *MIRValue;

    MIRArrayGEPExpression(&mut this, pointer: *MIRValue, index: *MIRValue, _type: *MIRType) : MIRConstantExpression(MIRConstantExpressionKind::ArrayGEP, _type) {
        (this.pointer, this.index) = (pointer, index);
    }

    pub fn ToString(&this) -> String {
        return "getelementptr " + this.pointer->ToString() + ", " + this.index->ToString();
    }
}

class MIRStructGEPExpression : MIRConstantExpression {
    pub pointer: *MIRValue,
    pub index: u32;

    MIRStructGEPExpression(&mut this, pointer: *MIRValue, index: u32, _type: *MIRType) : MIRConstantExpression(MIRConstantExpressionKind::StructGEP, _type) {
        (this.pointer, this.index) = (pointer, index);
    }

    pub fn ToString(&this) -> String {
        return "getelementptr " + this.pointer->ToString() + ", " + String::FromInteger(this.index as u64);
    }
}

enum MIRInstructionKind: u8 {
    Alloca, Load, Store, ArrayGEP, StructGEP,
    Unary, Binary, Call, Cast,
    Select, Phi, Terminator
}

class MIRInstruction : MIRValue {
    pub kind: MIRInstructionKind,
    pub name: String;

    MIRInstruction(&mut this, kind: MIRInstructionKind, name: String, _type: *MIRType) : MIRValue(MIRValueKind::Instruction, _type) {
        this.kind = kind;

        if _type->kind == MIRTypeKind::Void {
            this.name = "".ToString();
        } else {
            this.name = name;
        }
    }

    pub fn ToDefinitionString(&this) -> String {
        let mut result = String();

        if (this as *MIRValue)->_type->kind != MIRTypeKind::Void {
            result += '%' + this.name + " = ";
        }

        if this.kind == MIRInstructionKind::Alloca {
            result += (this as *MIRAllocaInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::Load {
            result += (this as *MIRLoadInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::Store {
            result += (this as *MIRStoreInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::ArrayGEP {
            result += (this as *MIRArrayGEPInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::StructGEP {
            result += (this as *MIRStructGEPInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::Unary {
            result += (this as *MIRUnaryInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::Binary {
            result += (this as *MIRBinaryInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::Call {
            result += (this as *MIRCallInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::Cast {
            result += (this as *MIRCastInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::Select {
            result += (this as *MIRSelectInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::Phi {
            result += (this as *MIRPhiInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::Terminator {
            result += (this as *MIRTerminator)->ToString();
        } else {
            result += "<invalid instruction>";
        } return result;
    }

    pub fn ToString(&this) -> String {
        if this.name.Empty()  {
            Logger::Log("Referencing an unnamed instruction!", LogSeverity::Fatal);
        } return '%' + this.name;
    }
}

class MIRAllocaInstruction : MIRInstruction {
    pub _type: *MIRType;

    MIRAllocaInstruction(&mut this, name: String, _type: *MIRType, result_type: *MIRType) : MIRInstruction(MIRInstructionKind::Alloca, name, result_type) {
        this._type = _type;
    }

    pub fn ToString(&this) -> String {
        return "alloca " + this._type->ToString();
    }
}

class MIRLoadInstruction : MIRInstruction {
    pub pointer: *MIRValue;

    MIRLoadInstruction(&mut this, name: String, pointer: *MIRValue, _type: *MIRType) : MIRInstruction(MIRInstructionKind::Load, name, _type) {
        this.pointer = pointer;
    }

    pub fn ToString(&this) -> String {
        let value = (this as *MIRInstruction) as *MIRValue;
        return "load " + value->_type->ToString() + ", " + this.pointer->ToString();
    }
}

class MIRStoreInstruction : MIRInstruction {
    pub value: *MIRValue,
    pub pointer: *MIRValue;

    MIRStoreInstruction(&mut this, value: *MIRValue, pointer: *MIRValue, _type: *MIRType) : MIRInstruction(MIRInstructionKind::Store, "".ToString(), _type) {
        (this.value, this.pointer) = (value, pointer);
    }

    pub fn ToString(&this) -> String {
        return "store " + this.value->ToString() + ", " + this.pointer->ToString();
    }
}

class MIRArrayGEPInstruction : MIRInstruction {
    pub pointer: *MIRValue,
    pub index: *MIRValue;

    MIRArrayGEPInstruction(&mut this, name: String, pointer: *MIRValue, index: *MIRValue, _type: *MIRType) : MIRInstruction(MIRInstructionKind::ArrayGEP, name, _type) {
        (this.pointer, this.index) = (pointer, index);
    }

    pub fn ToString(&this) -> String {
        return "getelementptr " + this.pointer->ToString() + ", " + this.index->ToString();
    }
}

class MIRStructGEPInstruction : MIRInstruction {
    pub pointer: *MIRValue,
    pub index: u32;

    MIRStructGEPInstruction(&mut this, name: String, pointer: *MIRValue, index: u32, _type: *MIRType) : MIRInstruction(MIRInstructionKind::StructGEP, name, _type) {
        (this.pointer, this.index) = (pointer, index);
    }

    pub fn ToString(&this) -> String {
        return "getelementptr " + this.pointer->ToString() + ", " + String::FromInteger(this.index as u64);
    }
}

class MIRUnaryInstruction : MIRInstruction {
    pub kind: MIRUnaryKind,
    pub operand: *MIRValue;

    MIRUnaryInstruction(&mut this, name: String, kind: MIRUnaryKind, operand: *MIRValue, _type: *MIRType) : MIRInstruction(MIRInstructionKind::Unary, name, _type) {
        (this.kind, this.operand) = (kind, operand);
    }

    pub fn ToString(&this) -> String {
        return this.kind.ToString() + ' ' + this.operand->ToString();
    }
}

class MIRBinaryInstruction : MIRInstruction {
    pub kind: MIRBinaryKind,
    pub left: *MIRValue,
    pub right: *MIRValue;

    MIRBinaryInstruction(&mut this, name: String, kind: MIRBinaryKind, left: *MIRValue, right: *MIRValue, _type: *MIRType) : MIRInstruction(MIRInstructionKind::Binary, name, _type) {
        (this.kind, this.left, this.right) = (kind, left, right);
    }

    pub fn ToString(&this) -> String {
        return this.kind.ToString() + ' ' + this.left->ToString() + ", " + this.right->ToString();
    }
}

class MIRCallInstruction : MIRInstruction {
    pub callee: *MIRValue,
    pub arguments: Vector<*MIRValue>;

    MIRCallInstruction(&mut this, name: String, callee: *MIRValue, arguments: Vector<*MIRValue>, _type: *MIRType) : MIRInstruction(MIRInstructionKind::Call, name, _type) {
        (this.callee, this.arguments) = (callee, arguments);
    }

    pub fn ToString(&this) -> String {
        let mut result = "call " + this.callee->ToString() + '(';

        for i in 0..this.arguments.Size() {
            if i != 0 { result += ", "; }
            let argument: *MIRValue = this.arguments[i];
            result += argument->ToString();
        } return result + ')';
    }
}

class MIRCastInstruction : MIRInstruction {
    pub kind: MIRCastKind,
    pub value: *MIRValue;

    MIRCastInstruction(&mut this, name: String, kind: MIRCastKind, value: *MIRValue, _type: *MIRType) : MIRInstruction(MIRInstructionKind::Cast, name, _type) {
        (this.kind, this.value) = (kind, value);
    }

    pub fn ToString(&this) -> String {
        let value = (this as *MIRInstruction) as *MIRValue;
        return this.kind.ToString() + ' ' + this.value->ToString() + " to " + value->_type->ToString();
    }
}

class MIRSelectInstruction : MIRInstruction {
    pub condition: *MIRValue,
    pub then_value: *MIRValue,
    pub else_value: *MIRValue;

    MIRSelectInstruction(&mut this, name: String, condition: *MIRValue, then_value: *MIRValue, else_value: *MIRValue, _type: *MIRType) : MIRInstruction(MIRInstructionKind::Select, name, _type) {
        (this.condition, this.then_value, this.else_value) = (condition, then_value, else_value);
    }

    pub fn ToString(&this) -> String {
        return "select " + this.condition->ToString() + ", " + this.then_value->ToString() + ", " + this.else_value->ToString();
    }
}

class MIRPhiIncoming {
    pub value: *MIRValue,
    pub block: *MIRBlock;

    MIRPhiIncoming(&mut this, value: *MIRValue, block: *MIRBlock) {
        (this.value, this.block) = (value, block);
    }
}

class MIRPhiInstruction : MIRInstruction {
    pub incomings: Vector<MIRPhiIncoming>;

    MIRPhiInstruction(&mut this, name: String, _type: *MIRType) : MIRInstruction(MIRInstructionKind::Phi, name, _type) {}

    pub fn AddIncoming(&mut this, value: *MIRValue, block: *MIRBlock) {
        this.incomings.PushBack(MIRPhiIncoming(value, block));
    }

    pub fn ToString(&this) -> String {
        let mut result = "phi ".ToString();

        for i in 0..this.incomings.Size() {
            if i != 0 { result += ", "; }
            result += '[' + this.incomings[i].value->ToString() + ", " + this.incomings[i].block->ToString() + ']';
        } return result;
    }
}

enum MIRTerminatorKind: u8 {
    Return, Branch, ConditionalBranch, Unreachable
}

class MIRTerminator : MIRInstruction {
    pub kind: MIRTerminatorKind;

    MIRTerminator(&mut this, kind: MIRTerminatorKind, _type: *MIRType) : MIRInstruction(MIRInstructionKind::Terminator, "".ToString(), _type) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        if this.kind == MIRTerminatorKind::Return {
            return (this as *MIRReturnInstruction)->ToString();
        } else if this.kind == MIRTerminatorKind::Branch {
            return (this as *MIRBranchInstruction)->ToString();
        } else if this.kind == MIRTerminatorKind::ConditionalBranch {
            return (this as *MIRConditionalBranchInstruction)->ToString();
        } else if this.kind == MIRTerminatorKind::Unreachable {
            return (this as *MIRUnreachableInstruction)->ToString();
        } else {
            return "<invalid terminator>".ToString();
        }
    }
}

class MIRReturnInstruction : MIRTerminator {
    pub value: *MIRValue;

    MIRReturnInstruction(&mut this, value: *MIRValue, _type: *MIRType) : MIRTerminator(MIRTerminatorKind::Return, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        let mut result = "return".ToString();

        if this.value != null {
            result += ' ' + this.value->ToString();
        } return result;
    }
}

class MIRBranchInstruction : MIRTerminator {
    pub target: *MIRBlock;

    MIRBranchInstruction(&mut this, target: *MIRBlock, _type: *MIRType) : MIRTerminator(MIRTerminatorKind::Branch, _type) {
        this.target = target;
    }

    pub fn ToString(&this) -> String {
        return "branch " + this.target->ToString();
    }
}

class MIRConditionalBranchInstruction : MIRTerminator {
    pub condition: *MIRValue,
    pub then_target: *MIRBlock,
    pub else_target: *MIRBlock;

    MIRConditionalBranchInstruction(&mut this, condition: *MIRValue, then_target: *MIRBlock, else_target: *MIRBlock, _type: *MIRType) : MIRTerminator(MIRTerminatorKind::ConditionalBranch, _type) {
        (this.condition, this.then_target, this.else_target) = (condition, then_target, else_target);
    }

    pub fn ToString(&this) -> String {
        return "branch " + this.condition->ToString() + ", " + this.then_target->ToString() + ", " + this.else_target->ToString();
    }
}

class MIRUnreachableInstruction : MIRTerminator {
    MIRUnreachableInstruction(&mut this, _type: *MIRType) : MIRTerminator(MIRTerminatorKind::Unreachable, _type) {}

    pub fn ToString(&this) -> String {
        return "unreachable".ToString();
    }
}

class MIRDeclarationReference : MIRValue {
    pub declaration: *MIRDeclaration;

    MIRDeclarationReference(&mut this, declaration: *MIRDeclaration, _type: *MIRType) : MIRValue(MIRValueKind::DeclarationReference, _type) {
        this.declaration = declaration;
    }

    pub fn ToString(&this) -> String {
        return "@\"" + this.declaration->name + '"';
    }
}

class MIRParameter : MIRValue {
    pub name: String,
    pub index: u32;

    MIRParameter(&mut this, name: String, index: u32, _type: *MIRType) : MIRValue(MIRValueKind::Parameter, _type) {
        (this.name, this.index) = (name, index);
    }

    pub fn ToString(&this) -> String {
        return '%' + this.name;
    }
}

class MIRBlock {
    pub name: String,
    pub parent: *mut MIRFunctionDeclaration = null,
    pub instructions: Vector<*MIRInstruction>,
    pub terminator: *MIRTerminator = null;

    MIRBlock(&mut this, name: String) {
        this.name = name;
    }

    pub fn HasTerminator(&this) -> bool {
        return this.terminator != null;
    }

    pub fn GetTerminator(&this) -> *MIRTerminator {
        return this.terminator;
    }

    pub fn SetTerminator(&mut this, terminator: *MIRTerminator) {
        if this.HasTerminator() {
            Logger::Log("Block already terminated!", LogSeverity::Fatal);
        } this.terminator = terminator;
    }

    pub fn AddInstruction(&mut this, instruction: *mut MIRInstruction) {
        if this.HasTerminator() {
            Logger::Log("Appending instruction after block terminator!", LogSeverity::Fatal);
        }

        if (instruction as *MIRValue)->_type->kind != MIRTypeKind::Void {
            instruction->name = this.parent->GetUniqueName(instruction->name);
        } this.instructions.PushBack(instruction);
    }

    pub fn ToDefinitionString(&this) -> String {
        let mut result = this.name + ':';

        for instruction in this.instructions {
            result += "\n  " + instruction->ToDefinitionString();
        }

        if this.terminator != null {
            result += "\n  " + this.terminator->ToString();
        } return result;
    }

    pub fn ToString(&this) -> String {
        return '%' + this.name;
    }
}

enum MIRDeclarationKind: u8 {
    Type, Constant, Function, Static
}

class MIRDeclaration {
    pub kind: MIRDeclarationKind,
    pub name: String,
    pub _type: *MIRType;

    MIRDeclaration(&mut this, kind: MIRDeclarationKind, name: String, _type: *MIRType) {
        (this.kind, this.name, this._type) = (kind, name, _type);
    }

    pub fn ToString(&this) -> String {
        if this.kind == MIRDeclarationKind::Type {
            return (this as *MIRTypeDeclaration)->ToString();
        } else if this.kind == MIRDeclarationKind::Constant {
            return (this as *MIRConstantDeclaration)->ToString();
        } else if this.kind == MIRDeclarationKind::Function {
            return ((this as *MIRLinkableDeclaration) as *MIRFunctionDeclaration)->ToString();
        } else if this.kind == MIRDeclarationKind::Static {
            return ((this as *MIRLinkableDeclaration) as *MIRStaticDeclaration)->ToString();
        } else {
            return "<invalid declaration>".ToString();
        }
    }
}

class MIRTypeDeclaration : MIRDeclaration {
    MIRTypeDeclaration(&mut this, name: String, _type: *MIRType) : MIRDeclaration(MIRDeclarationKind::Type, name, _type) {}

    pub fn ToString(&this) -> String {
        let declaration = this as *MIRDeclaration;
        let mut result = "type %" + declaration->name + " = ";

        if declaration->_type->kind == MIRTypeKind::Structure {
            result += (declaration->_type as *MIRStructureType)->ToDefinitionString();
        } else {
            result += declaration->_type->ToString();
        } return result;
    }
}

class MIRConstantDeclaration : MIRDeclaration {
    pub initializer: *MIRValue;

    MIRConstantDeclaration(&mut this, name: String, _type: *MIRType, initializer: *MIRValue) : MIRDeclaration(MIRDeclarationKind::Constant, name, _type) {
        this.initializer = initializer;
    }

    pub fn ToString(&this) -> String {
        let declaration = this as *MIRDeclaration;
        return "const @\"" + declaration->name + "\": " + declaration->_type->ToString() + " = " + this.initializer->ToString();
    }
}

enum MIRDeclarationLinkage: u8 {
    Private, Internal, External
}

class MIRLinkableDeclaration : MIRDeclaration {
    pub linkage: MIRDeclarationLinkage;

    MIRLinkableDeclaration(&mut this, kind: MIRDeclarationKind, name: String, _type: *MIRType, linkage: MIRDeclarationLinkage) : MIRDeclaration(kind, name, _type) {
        this.linkage = linkage;
    }
}

class MIRFunctionDeclaration : MIRLinkableDeclaration {
    pub parameters: Vector<*MIRParameter>,
    pub _return: *MIRType,
    pub blocks: Vector<*mut MIRBlock>,
    pub names: Map<String, u32>,
    pub alloca_index: usize = 0;

    MIRFunctionDeclaration(&mut this, name: String, parameters: Vector<*MIRParameter>, _return: *MIRType, _type: *MIRType, linkage: MIRDeclarationLinkage) : MIRLinkableDeclaration(MIRDeclarationKind::Function, name, _type, linkage) {
        (this.parameters, this._return) = (parameters, _return);

        for parameter in this.parameters {
            if parameter->name.Empty() { continue; }
            let count = this.names.Get(parameter->name, 0);
            this.names[parameter->name] = count + 1;
        }
    }

    pub fn AddBlock(&mut this, block: *mut MIRBlock) {
        (block->name, block->parent) = (this.GetUniqueName(block->name), this);
        this.blocks.PushBack(block);
    }

    pub fn AddAllocaInstruction(&mut this, alloca: *mut MIRAllocaInstruction) {
        let instruction = alloca as *mut MIRInstruction;
        instruction->name = this.GetUniqueName(instruction->name);
        this.blocks[0]->instructions.Insert(this.alloca_index, alloca);
        this.alloca_index += 1;
    }

    pub fn GetUniqueName(&mut this, name: &String) -> String {
        if name.Empty() { return name; }
        let count = this.names.Get(name, 0);
        this.names[name] = count + 1;
        if count == 0 { return name; }
        return name + '.' + String::FromInteger(count as u64);
    }

    pub fn ToString(&this) -> String {
        let declaration = (this as *MIRLinkableDeclaration) as *MIRDeclaration;
        let mut result = "fn @\"" + declaration->name + "\"(";

        for i in 0..this.parameters.Size() {
            if i != 0 { result += ", "; }
            let parameter: *MIRParameter = this.parameters[i];
            result += '%' + parameter->name + ": " + (parameter as *MIRValue)->_type->ToString();
        } result += ')';

        if this._return->kind != MIRTypeKind::Void {
            result += " -> " + this._return->ToString();
        }

        if !this.blocks.Empty() {
            result += " {\n";

            for i in 0..this.blocks.Size() {
                if i != 0 { result += '\n'; }
                let block: *MIRBlock = this.blocks[i];
                result += block->ToDefinitionString() + '\n';
            } result += '}';
        } return result;
    }
}

class MIRStaticDeclaration : MIRLinkableDeclaration {
    pub initializer: *MIRValue,
    pub mutable: bool;

    MIRStaticDeclaration(&mut this, name: String, _type: *MIRType, mutable: bool, initializer: *MIRValue, linkage: MIRDeclarationLinkage) : MIRLinkableDeclaration(MIRDeclarationKind::Static, name, _type, linkage) {
        (this.initializer, this.mutable) = (initializer, mutable);
    }

    pub fn ToString(&this) -> String {
        let declaration = (this as *MIRLinkableDeclaration) as *MIRDeclaration;
        let mut result = "static @\"" + declaration->name + "\": " + declaration->_type->ToString();

        if this.initializer != null {
            result += " = " + this.initializer->ToString();
        } return result;
    }
}

class MIRModule {
    pub declarations: Vector<*MIRDeclaration>;

    MIRModule(&mut this) {}

    pub fn ToString(&this) -> String {
        let mut result = String();
        let mut previous: *MIRDeclaration = null;

        for declaration in this.declarations {
            if previous != null {
                result += '\n';

                if previous->kind != declaration->kind {
                    result += '\n';
                } else if declaration->kind == MIRDeclarationKind::Function {
                    let current = (declaration as *MIRLinkableDeclaration) as *MIRFunctionDeclaration;
                    let previous = (previous as *MIRLinkableDeclaration) as *MIRFunctionDeclaration;

                    if !current->blocks.Empty() || !previous->blocks.Empty() {
                        result += '\n';
                    }
                }
            }

            result += declaration->ToString();
            previous = declaration;
        } return result;
    }
}

class MIRContext {
    pub arena: Arena;

    MIRContext(&mut this) {}

    pub fn VoidType(&mut this) -> *MIRType {
        return this.arena.New<MIRVoidType>();
    }

    pub fn IntegerType(&mut this, width: u32) -> *MIRType {
        return this.arena.New<MIRIntegerType>(width);
    }

    pub fn FloatType(&mut this, width: u32) -> *MIRType {
        return this.arena.New<MIRFloatType>(width);
    }

    pub fn PointerType(&mut this, pointee: *MIRType) -> *MIRType {
        return this.arena.New<MIRPointerType>(pointee);
    }

    pub fn ArrayType(&mut this, element: *MIRType, length: usize) -> *MIRType {
        return this.arena.New<MIRArrayType>(element, length);
    }

    pub fn StructureType(&mut this, name: String) -> *MIRType {
        return this.arena.New<MIRStructureType>(name);
    }

    pub fn StructureType(&mut this, fields: Vector<*MIRType>) -> *MIRType {
        return this.arena.New<MIRStructureType>(fields);
    }

    pub fn FunctionType(&mut this, parameters: Vector<*MIRType>, _return: *MIRType) -> *MIRType {
        return this.arena.New<MIRFunctionType>(parameters, _return);
    }
}

class MIRBuilder {
    context: *mut MIRContext,
    module: *mut MIRModule,
    function: *mut MIRFunctionDeclaration = null,
    block: *mut MIRBlock = null;

    MIRBuilder(&mut this, context: *mut MIRContext, module: *mut MIRModule) {
        (this.context, this.module) = (context, module);
    }

    pub fn ConstantInteger(&mut this, value: u64, _type: *MIRType) -> *MIRConstantInteger {
        return this.context->arena.New<MIRConstantInteger>(value, _type);
    }

    pub fn ConstantFloat(&mut this, value: f64, _type: *MIRType) -> *MIRConstantFloat {
        return this.context->arena.New<MIRConstantFloat>(value, _type);
    }

    pub fn ConstantString(&mut this, value: String, _type: *MIRType) -> *MIRConstantString {
        return this.context->arena.New<MIRConstantString>(value, _type);
    }

    pub fn ConstantArray(&mut this, values: Vector<*MIRValue>, _type: *MIRType) -> *MIRConstantArray {
        return this.context->arena.New<MIRConstantArray>(values, _type);
    }

    pub fn ConstantStruct(&mut this, values: Vector<*MIRValue>, _type: *MIRType) -> *MIRConstantStructure {
        return this.context->arena.New<MIRConstantStructure>(values, _type);
    }

    pub fn ConstantNull(&mut this, _type: *MIRType) -> *MIRConstantNull {
        return this.context->arena.New<MIRConstantNull>(_type);
    }

    pub fn ConstantUnary(&mut this, kind: MIRUnaryKind, operand: *MIRValue) -> *MIRUnaryExpression {
        return this.context->arena.New<MIRUnaryExpression>(kind, operand, operand->_type);
    }

    pub fn ConstantBinary(&mut this, kind: MIRBinaryKind, left: *MIRValue, right: *MIRValue, _type: *MIRType) -> *MIRBinaryExpression {
        return this.context->arena.New<MIRBinaryExpression>(kind, left, right, _type);
    }

    pub fn ConstantCast(&mut this, kind: MIRCastKind, value: *MIRValue, _type: *MIRType) -> *MIRCastExpression {
        return this.context->arena.New<MIRCastExpression>(kind, value, _type);
    }

    pub fn ConstantArrayGEP(&mut this, pointer: *MIRValue, index: *MIRValue) -> *MIRArrayGEPExpression {
        return this.context->arena.New<MIRArrayGEPExpression>(pointer, index, pointer->_type);
    }

    pub fn ConstantStructGEP(&mut this, pointer: *MIRValue, index: u32, _type: *MIRType) -> *MIRStructGEPExpression {
        return this.context->arena.New<MIRStructGEPExpression>(pointer, index, _type);
    }

    pub fn BuildAlloca(&mut this, name: String, _type: *MIRType) -> *MIRAllocaInstruction {
        let alloca = this.context->arena.New<MIRAllocaInstruction>(name, _type, this.context->PointerType(_type));
        this.function->AddAllocaInstruction(alloca);
        return alloca;
    }

    pub fn BuildLoad(&mut this, name: String, pointer: *MIRValue) -> *MIRLoadInstruction {
        let load = this.context->arena.New<MIRLoadInstruction>(name, pointer, (pointer->_type as *MIRPointerType)->pointee);
        this.block->AddInstruction(load);
        return load;
    }

    pub fn BuildStore(&mut this, value: *MIRValue, pointer: *MIRValue) -> *MIRStoreInstruction {
        let store = this.context->arena.New<MIRStoreInstruction>(value, pointer, this.context->VoidType());
        this.block->AddInstruction(store);
        return store;
    }

    pub fn BuildArrayGEP(&mut this, name: String, pointer: *MIRValue, index: *MIRValue) -> *MIRValue {
        if this.GetCurrentBlock() == null {
            return (this.ConstantArrayGEP(pointer, index) as *MIRConstantExpression) as *MIRConstant;
        }

        let gep = this.context->arena.New<MIRArrayGEPInstruction>(name, pointer, index, pointer->_type);
        this.block->AddInstruction(gep);
        return gep as *MIRInstruction;
    }

    pub fn BuildStructGEP(&mut this, name: String, pointer: *MIRValue, index: u32, _type: *MIRType) -> *MIRValue {
        if this.GetCurrentBlock() == null {
            return (this.ConstantStructGEP(pointer, index, _type) as *MIRConstantExpression) as *MIRConstant;
        }

        let gep = this.context->arena.New<MIRStructGEPInstruction>(name, pointer, index, _type);
        this.block->AddInstruction(gep);
        return gep as *MIRInstruction;
    }

    pub fn BuildUnary(&mut this, name: String, kind: MIRUnaryKind, operand: *MIRValue) -> *MIRValue {
        if this.GetCurrentBlock() == null {
            return (this.ConstantUnary(kind, operand) as *MIRConstantExpression) as *MIRConstant;
        }

        let unary = this.context->arena.New<MIRUnaryInstruction>(name, kind, operand, operand->_type);
        this.block->AddInstruction(unary);
        return unary as *MIRInstruction;
    }

    pub fn BuildBinary(&mut this, name: String, kind: MIRBinaryKind, left: *MIRValue, right: *MIRValue, _type: *MIRType) -> *MIRValue {
        if this.GetCurrentBlock() == null {
            return (this.ConstantBinary(kind, left, right, _type) as *MIRConstantExpression) as *MIRConstant;
        }

        let binary = this.context->arena.New<MIRBinaryInstruction>(name, kind, left, right, _type);
        this.block->AddInstruction(binary);
        return binary as *MIRInstruction;
    }

    pub fn BuildCall(&mut this, name: String, callee: *MIRValue, arguments: Vector<*MIRValue>) -> *MIRCallInstruction {
        let call = this.context->arena.New<MIRCallInstruction>(name, callee, arguments, (callee->_type as *MIRFunctionType)->_return);
        this.block->AddInstruction(call);
        return call;
    }

    pub fn BuildCast(&mut this, name: String, kind: MIRCastKind, value: *MIRValue, _type: *MIRType) -> *MIRValue {
        if this.GetCurrentBlock() == null {
            return (this.ConstantCast(kind, value, _type) as *MIRConstantExpression) as *MIRConstant;
        }

        let cast = this.context->arena.New<MIRCastInstruction>(name, kind, value, _type);
        this.block->AddInstruction(cast);
        return cast as *MIRInstruction;
    }

    pub fn BuildSelect(&mut this, name: String, condition: *MIRValue, then_value: *MIRValue, else_value: *MIRValue, _type: *MIRType) -> *MIRSelectInstruction {
        let select = this.context->arena.New<MIRSelectInstruction>(name, condition, then_value, else_value, _type);
        this.block->AddInstruction(select);
        return select;
    }

    pub fn BuildPhi(&mut this, name: String, _type: *MIRType) -> *mut MIRPhiInstruction {
        let phi = this.context->arena.New<MIRPhiInstruction>(name, _type);
        this.block->AddInstruction(phi);
        return phi;
    }

    pub fn BuildReturn(&mut this, value: *MIRValue) -> *MIRReturnInstruction {
        let _return = this.context->arena.New<MIRReturnInstruction>(value, this.context->VoidType());
        this.block->SetTerminator(_return);
        return _return;
    }

    pub fn BuildBranch(&mut this, target: *MIRBlock) -> *MIRBranchInstruction {
        let branch = this.context->arena.New<MIRBranchInstruction>(target, this.context->VoidType());
        this.block->SetTerminator(branch);
        return branch;
    }

    pub fn BuildConditionalBranch(&mut this, condition: *MIRValue, then_target: *MIRBlock, else_target: *MIRBlock) -> *MIRConditionalBranchInstruction {
        let branch = this.context->arena.New<MIRConditionalBranchInstruction>(condition, then_target, else_target, this.context->VoidType());
        this.block->SetTerminator(branch);
        return branch;
    }

    pub fn BuildUnreachable(&mut this) -> *MIRUnreachableInstruction {
        let unreachable = this.context->arena.New<MIRUnreachableInstruction>(this.context->VoidType());
        this.block->SetTerminator(unreachable);
        return unreachable;
    }

    pub fn ReferenceDeclaration(&mut this, declaration: *MIRDeclaration) -> *MIRDeclarationReference {
        let mut _type: *MIRType = null;

        if declaration->kind == MIRDeclarationKind::Constant || declaration->kind == MIRDeclarationKind::Static {
            _type = this.context->PointerType(declaration->_type);
        } else {
            _type = declaration->_type;
        }

        return this.context->arena.New<MIRDeclarationReference>(declaration, _type);
    }

    pub fn BuildParameter(&mut this, name: String, index: u32, _type: *MIRType) -> *MIRParameter {
        return this.context->arena.New<MIRParameter>(name, index, _type);
    }

    pub fn BuildBlock(&mut this, name: String) -> *mut MIRBlock {
        let block = this.context->arena.New<MIRBlock>(name);
        this.function->AddBlock(block);
        return block;
    }

    pub fn SetCurrentBlock(&mut this, block: *mut MIRBlock) {
        this.block = block;
    }

    pub fn GetCurrentBlock(&this) -> *mut MIRBlock {
        return this.block;
    }

    pub fn BuildType(&mut this, name: String, _type: *MIRType) -> *mut MIRTypeDeclaration {
        let type_declaration = this.context->arena.New<MIRTypeDeclaration>(name, _type);
        this.module->declarations.PushBack(type_declaration);
        return type_declaration;
    }

    pub fn BuildConstant(&mut this, name: String, _type: *MIRType, initializer: *MIRValue) -> *mut MIRConstantDeclaration {
        let constant = this.context->arena.New<MIRConstantDeclaration>(name, _type, initializer);
        this.module->declarations.PushBack(constant);
        return constant;
    }

    pub fn BuildFunction(&mut this, name: String, parameters: Vector<*MIRParameter>, _return: *MIRType, linkage: MIRDeclarationLinkage) -> *mut MIRFunctionDeclaration {
        let parameter_types = Vector<*MIRType>();
        for parameter in parameters { parameter_types.PushBack((parameter as *MIRValue)->_type); }
        let _type = this.context->FunctionType(parameter_types, _return);
        let function = this.context->arena.New<MIRFunctionDeclaration>(name, parameters, _return, _type, linkage);
        this.module->declarations.PushBack(function as *MIRLinkableDeclaration);
        return function;
    }

    pub fn SetCurrentFunction(&mut this, function: *mut MIRFunctionDeclaration) {
        this.function = function;
    }

    pub fn GetCurrentFunction(&this) -> *mut MIRFunctionDeclaration {
        return this.function;
    }

    pub fn BuildStatic(&mut this, name: String, _type: *MIRType, mutable: bool, initializer: *MIRValue, linkage: MIRDeclarationLinkage) -> *mut MIRStaticDeclaration {
        let _static = this.context->arena.New<MIRStaticDeclaration>(name, _type, mutable, initializer, linkage);
        this.module->declarations.PushBack(_static as *MIRLinkableDeclaration);
        return _static;
    }
}
