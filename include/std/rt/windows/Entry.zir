#[include "std/str", "std/vec", "std/std" : *]

extern "C" {
    fn GetCommandLineA() -> *mut i8;

    fn _start() {
        let raw_cmd = GetCommandLineA();
        let mut args = Vector<String>();
        let mut ptr = raw_cmd;
        let mut start_ptr = raw_cmd;
        let mut in_arg = false;
        let mut in_quotes = false;

        while ptr[0] != 0 {
            let character: i8 = ptr[0];

            if character == '\"' {
                in_quotes = !in_quotes;

                if !in_arg {
                    in_arg = true;
                    start_ptr = (ptr + 1);
                } ptr[0] = '\0';
            } else if character == ' ' && !in_quotes {
                if in_arg {
                    in_arg = false;
                    ptr[0] = '\0';
                    args.PushBack(String(start_ptr));
                }
            } else if !in_arg {
                in_arg = true;
                start_ptr = ptr;
            } ptr += 1;
        }

        if in_arg {
            args.PushBack(String(start_ptr));
        }

        Exit(Main(args));
    }

    static mut _fltused: i32 = 0;
}
