#[include "vendor/clang-c/CXErrorCode.zir", "vendor/clang-c/Index.zir" : *]

struct CXComment {
    pub ASTNode: *void,
    pub TranslationUnit: CXTranslationUnit
}

enum CXCommentKind: i32 {
    CXComment_Null = 0,
    CXComment_Text = 1,
    CXComment_InlineCommand = 2,
    CXComment_HTMLStartTag = 3,
    CXComment_HTMLEndTag = 4,
    CXComment_Paragraph = 5,
    CXComment_BlockCommand = 6,
    CXComment_ParamCommand = 7,
    CXComment_TParamCommand = 8,
    CXComment_VerbatimBlockCommand = 9,
    CXComment_VerbatimBlockLine = 10,
    CXComment_VerbatimLine = 11,
    CXComment_FullComment = 12
}

enum CXCommentInlineCommandRenderKind: i32 {
    CXCommentInlineCommandRenderKind_Normal = 0,
    CXCommentInlineCommandRenderKind_Bold = 1,
    CXCommentInlineCommandRenderKind_Monospaced = 2,
    CXCommentInlineCommandRenderKind_Emphasized = 3,
    CXCommentInlineCommandRenderKind_Anchor = 4
}

enum CXCommentParamPassDirection: i32 {
    CXCommentParamPassDirection_In = 0,
    CXCommentParamPassDirection_Out = 1,
    CXCommentParamPassDirection_InOut = 2
}

class CXAPISetImpl {}

type CXAPISet = *mut CXAPISetImpl;

extern "C" {
    fn clang_Cursor_getParsedComment(C: CXCursor) -> CXComment;
    fn clang_Comment_getKind(Comment: CXComment) -> CXCommentKind;
    fn clang_Comment_getNumChildren(Comment: CXComment) -> u32;
    fn clang_Comment_getChild(Comment: CXComment, ChildIdx: u32) -> CXComment;
    fn clang_Comment_isWhitespace(Comment: CXComment) -> u32;
    fn clang_InlineContentComment_hasTrailingNewline(Comment: CXComment) -> u32;
    fn clang_TextComment_getText(Comment: CXComment) -> CXString;
    fn clang_InlineCommandComment_getCommandName(Comment: CXComment) -> CXString;
    fn clang_InlineCommandComment_getRenderKind(Comment: CXComment) -> CXCommentInlineCommandRenderKind;
    fn clang_InlineCommandComment_getNumArgs(Comment: CXComment) -> u32;
    fn clang_InlineCommandComment_getArgText(Comment: CXComment, ArgIdx: u32) -> CXString;
    fn clang_HTMLTagComment_getTagName(Comment: CXComment) -> CXString;
    fn clang_HTMLStartTagComment_isSelfClosing(Comment: CXComment) -> u32;
    fn clang_HTMLStartTag_getNumAttrs(Comment: CXComment) -> u32;
    fn clang_HTMLStartTag_getAttrName(Comment: CXComment, AttrIdx: u32) -> CXString;
    fn clang_HTMLStartTag_getAttrValue(Comment: CXComment, AttrIdx: u32) -> CXString;
    fn clang_BlockCommandComment_getCommandName(Comment: CXComment) -> CXString;
    fn clang_BlockCommandComment_getNumArgs(Comment: CXComment) -> u32;
    fn clang_BlockCommandComment_getArgText(Comment: CXComment, ArgIdx: u32) -> CXString;
    fn clang_BlockCommandComment_getParagraph(Comment: CXComment) -> CXComment;
    fn clang_ParamCommandComment_getParamName(Comment: CXComment) -> CXString;
    fn clang_ParamCommandComment_isParamIndexValid(Comment: CXComment) -> u32;
    fn clang_ParamCommandComment_getParamIndex(Comment: CXComment) -> u32;
    fn clang_ParamCommandComment_isDirectionExplicit(Comment: CXComment) -> u32;
    fn clang_ParamCommandComment_getDirection(Comment: CXComment) -> CXCommentParamPassDirection;
    fn clang_TParamCommandComment_getParamName(Comment: CXComment) -> CXString;
    fn clang_TParamCommandComment_isParamPositionValid(Comment: CXComment) -> u32;
    fn clang_TParamCommandComment_getDepth(Comment: CXComment) -> u32;
    fn clang_TParamCommandComment_getIndex(Comment: CXComment, Depth: u32) -> u32;
    fn clang_VerbatimBlockLineComment_getText(Comment: CXComment) -> CXString;
    fn clang_VerbatimLineComment_getText(Comment: CXComment) -> CXString;
    fn clang_HTMLTagComment_getAsString(Comment: CXComment) -> CXString;
    fn clang_FullComment_getAsHTML(Comment: CXComment) -> CXString;
    fn clang_FullComment_getAsXML(Comment: CXComment) -> CXString;
    fn clang_createAPISet(tu: CXTranslationUnit, out_api: *mut CXAPISet) -> CXErrorCode;
    fn clang_disposeAPISet(api: CXAPISet);
    fn clang_getSymbolGraphForUSR(usr: *i8, api: CXAPISet) -> CXString;
    fn clang_getSymbolGraphForCursor(cursor: CXCursor) -> CXString;
}
