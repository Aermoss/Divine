#[include "vendor/llvm-c/Types.zir" : *]

enum LLVMByteOrdering: i32 {
    LLVMBigEndian = 0,
    LLVMLittleEndian = 1
}

class LLVMOpaqueTargetData {}

type LLVMTargetDataRef = *mut LLVMOpaqueTargetData;

class LLVMOpaqueTargetLibraryInfotData {}

type LLVMTargetLibraryInfoRef = *mut LLVMOpaqueTargetLibraryInfotData;

