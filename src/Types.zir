#[include "std/str", "std/vec", "std/map", "vendor/llvm",
    "src/Generic.zir", "src/Scope.zir", "src/Nodes.zir", "src/Logger.zir" : *]

class Field {
    pub initializer: *const Node,
    pub visibility: TokenType,
    pub index: usize = 0usize;

    Field(&mut this, initializer: *const Node, visibility: TokenType, index: usize) {
        (this.initializer, this.visibility, this.index) = (initializer, visibility, index);
    }
}

class Method {
    pub name: String,
    pub value: LLVMValueRef,
    pub visibility: TokenType;

    Method(&mut this, name: String, value: LLVMValueRef, visibility: TokenType) {
        (this.name, this.value, this.visibility) = (name, value, visibility);
    }
}

class ParameterType {
    pub _type: *const QualifiedType,
    pub byval: *const QualifiedType = null,
    pub sret: *const QualifiedType = null;

    ParameterType(&mut this, _type: *const QualifiedType) {
        this._type = _type;
    }
}

class ReturnType {
    pub _type: *const QualifiedType,
    pub sret: *const QualifiedType = null;

    ReturnType(&mut this, _type: *const QualifiedType) {
        this._type = _type;
    }
}

enum TypeKind: i32 {
    Void,
    Boolean, Character, Integer, Float,
    Pointer, Reference, Array,
    Function, PackSpecializedFunction,
    Class, Enum
}

class QualifiedType {
    pub kind: TypeKind,
    pub name: String,

    pub width: u32 = 0u32,
    pub signed: bool = false,
    pub mutable: bool = false,
    pub length: usize = 0usize,

    pub value: LLVMTypeRef,
    pub pointee: *const QualifiedType = null,

    pub pack_name: String,
    pub declaration: *const FunctionNode = null,
    pub pack_generic: *mut Generic = null,
    pub pack_scope: *mut Scope = null,
    pub pack_generic_types: Vector<*const QualifiedType>,

    pub constructed: Vector<*const QualifiedType>,
    pub fields: Map<String, Pair<Field, *const QualifiedType>>,
    pub methods: Vector<Pair<Method, *const QualifiedType>>,

    pub variants: Vector<Pair<String, Vector<*const QualifiedType>>>,
    pub variant_field_names: Vector<Vector<String>>,

    pub params: Vector<ParameterType>,
    pub return: ReturnType;

    QualifiedType(&mut this, kind: TypeKind, value: LLVMTypeRef) {
        (this.kind, this.value) = (kind, value);
    }

    pub IsMutable(&this) -> bool { ret this.mutable; }
    pub IsSigned(&this) -> bool { ret this.signed; }

    pub IsVoid(&this) -> bool { ret this.kind == TypeKind::Void; }
    pub IsBoolean(&this) -> bool { ret this.kind == TypeKind::Boolean; }
    pub IsCharacter(&this) -> bool { ret this.kind == TypeKind::Character; }
    pub IsInteger(&this) -> bool { ret this.kind == TypeKind::Integer; }
    pub IsIntegerPointer(&this) -> bool { ret this.kind == TypeKind::Integer && this.width == 0u32; }
    pub IsFloat(&this) -> bool { ret this.kind == TypeKind::Float; }
    pub IsPointer(&this) -> bool { ret this.kind == TypeKind::Pointer || this.kind == TypeKind::Reference; }
    pub IsNullPointer(&this) -> bool { if this.kind == TypeKind::Pointer { ret this.pointee->kind == TypeKind::Void; } else { ret false; } }
    // pub IsNullPointer(&this) -> bool { ret this.kind == TypeKind::Pointer || this.pointee->kind == TypeKind::Void; }
    pub IsReference(&this) -> bool { ret this.kind == TypeKind::Reference; }
    pub IsArray(&this) -> bool { ret this.kind == TypeKind::Array; }
    pub IsFunction(&this) -> bool { ret this.kind == TypeKind::Function || this.kind == TypeKind::PackSpecializedFunction; }
    pub IsPackSpecializedFunction(&this) -> bool { ret this.kind == TypeKind::PackSpecializedFunction; }
    pub IsClass(&this) -> bool { ret this.kind == TypeKind::Class; }
    pub IsEnum(&this) -> bool { ret this.kind == TypeKind::Enum; }

    pub IsTrivial(&this) -> bool {
        if this.IsBoolean() || this.IsCharacter() || this.IsInteger() || this.IsFloat() || this.IsPointer() || this.IsReference() {
            ret true;
        }

        if this.IsArray() {
            ret this.pointee->IsTrivial();
        }

        if this.IsFunction() {
            ret false;
        }

        if this.IsClass() {
            if !this.constructed.Empty() || !this.methods.Empty() {
                ret false;
            }

            for field in this.Fields() {
                if !field.right.right->IsTrivial() {
                    ret false;
                }
            } ret true;
        }

        if this.IsEnum() {
            if !this.methods.Empty() {
                ret false;
            }

            for variant in this.variants {
                for variant_field in variant.right {
                    if !variant_field->IsTrivial() {
                        ret false;
                    }
                }
            } ret true;
        } ret false;
    }

    pub IsDerivedFrom(&this, other: &QualifiedType) -> bool {
        for field in other.Fields() {
            if field.left == this.name {
                ret true;
            }
        } ret false;
    }

    pub IsCompatible(&this, other: &QualifiedType) -> bool {
        if this.IsPointer() && other.IsPointer() {
            if LLVMGetTypeKind(this.Pointee().Value()) == LLVMTypeKind::LLVMVoidTypeKind || other.IsNullPointer() {
                ret true;
            } else if this.Pointee().IsClass() && other.Pointee().IsClass() {
                if this.Pointee().IsDerivedFrom(other.Pointee()) {
                    ret true;
                }
            }
        } ret this == other;
    }

    pub IsMutabilityCompatible(&this, other: &QualifiedType) -> bool {
        let mut left: *const QualifiedType = this;
        let mut right: *const QualifiedType = other;

        while left->IsPointer() && right->IsPointer() {
            if left->IsMutable() && !right->IsMutable() && !right->IsNullPointer() {
                ret false;
            }

            (left, right) = (left->Pointee(), right->Pointee());
        } ret true;
    }

    pub IsSame(&this, other: &QualifiedType) -> bool {
        let mut left: *const QualifiedType = this;
        let mut right: *const QualifiedType = other;

        while left->IsPointer() && right->IsPointer() {
            if left->IsMutable() != right->IsMutable() || left->IsReference() != right->IsReference() || right->IsNullPointer() {
                ret false;
            }

            (left, right) = (left->Pointee(), right->Pointee());
        } ret this == other;
    }

    pub ScorePointer(&this, other: &QualifiedType, base: u64) -> u64 {
        let mut reference_mismatch = false;
        let mut mutability_mismatch = false;
        let mut left: *const QualifiedType = this;
        let mut right: *const QualifiedType = other;
        let mut score = base;

        while left->IsPointer() && right->IsPointer() {
            if left->IsMutable() && !right->IsMutable() && !right->IsNullPointer() {
                ret 0u64;
            }

            mutability_mismatch |= left->IsMutable() != right->IsMutable();
            reference_mismatch |= left->IsReference() != right->IsReference();
            (left, right) = (left->Pointee(), right->Pointee());
        }

        if reference_mismatch { score -= 10u64; }
        if mutability_mismatch { score -= 1u64; }
        ret score;
    }

    pub ScoreParameter(&this, other: &QualifiedType) -> u64 {
        if this == other {
            ret this.ScorePointer(other, 100u64);
        }

        if this.IsReference() {
            let score = this.Pointee().ScoreParameter(other);
            if score != 0u64 { ret score - 3u64; }
        }

        if other.IsReference() {
            let score = this.ScoreParameter(other.Pointee());
            if score != 0u64 { ret score - 3u64; }
        }

        if this.IsPointer() && other.IsPointer() {
            if LLVMGetTypeKind(this.Pointee().Value()) == LLVMTypeKind::LLVMVoidTypeKind || other.IsNullPointer() {
                ret this.ScorePointer(other, 30u64);
            } else if this.Pointee().IsClass() && other.Pointee().IsClass() {
                if this.Pointee().IsDerivedFrom(other.Pointee()) {
                    ret this.ScorePointer(other, 70u64);
                }
            }
        } ret 0u64;
    }

    pub Value(&this) -> LLVMTypeRef {
        if this.value == null {
            Logger::Log("QualifiedType", "Null type!", LogSeverity::Fatal);
        } ret this.value;
    }

    pub Pointee(&this) -> &QualifiedType {
        if this.kind != TypeKind::Pointer && this.kind != TypeKind::Reference {
            Logger::Log("QualifiedType", "Not a pointer!", LogSeverity::Fatal);
        } else if this.pointee == null {
            Logger::Log("QualifiedType", "Null pointee!", LogSeverity::Fatal);
        } ret this.pointee;
    }

    pub Size(&this) -> usize {
        if this.kind != TypeKind::Array {
            Logger::Log("QualifiedType", "Not an array!", LogSeverity::Fatal);
        } ret this.length;
    }

    pub Element(&this) -> &QualifiedType {
        if this.kind != TypeKind::Array {
            Logger::Log("QualifiedType", "Not an array!", LogSeverity::Fatal);
        } else if this.pointee == null {
            Logger::Log("QualifiedType", "Null pointee!", LogSeverity::Fatal);
        } ret this.pointee;
    }

    pub Parameters(&this) -> &Vector<ParameterType> {
        if this.kind != TypeKind::Function && this.kind != TypeKind::PackSpecializedFunction {
            Logger::Log("QualifiedType", "Not a function!", LogSeverity::Fatal);
        } ret this.params;
    }

    pub Return(&this) -> &ReturnType {
        if this.kind != TypeKind::Function && this.kind != TypeKind::PackSpecializedFunction {
            Logger::Log("QualifiedType", "Not a function!", LogSeverity::Fatal);
        } ret this.return;
    }

    pub Fields(&this) -> &mut Map<String, Pair<Field, *const QualifiedType>> {
        if this.kind != TypeKind::Class {
            Logger::Log("QualifiedType", "Not a class!", LogSeverity::Fatal);
        }

        unsafe {
            ret (this as &mut QualifiedType).fields;
        }
    }

    pub Methods(&this) -> &Vector<Pair<Method, *const QualifiedType>> {
        if this.kind != TypeKind::Class && this.kind != TypeKind::Enum {
            Logger::Log("QualifiedType", "Not a class!", LogSeverity::Fatal);
        } ret this.methods;
    }

    pub Index(&this, name: &String) -> isize {
        for field in this.Fields() {
            if field.left == name {
                ret field.right.left.index as isize;
            }
        } ret -1isize;
    }

    pub Has(&this, name: &String) -> bool {
        for method in this.Methods() {
            if method.left.name == name {
                if method.left.visibility == TokenType::PUBLIC {
                    ret true;
                }

                if compiler->_class != null {
                    if *compiler->_class == this {
                        ret true;
                    }
                }
            }
        } ret false;
    }

    pub Has(&this, name: &String, params: &Vector<*const QualifiedType>) -> bool {
        for method in this.Methods() {
            if method.left.name == name {
                let mut state = false;

                if compiler->_class != null {
                    state = *compiler->_class == this;
                }

                if method.left.visibility == TokenType::PUBLIC || state {
                    let _params = method.right->Pointee().Parameters();
                    let has_pack = method.right->Pointee().pack_name != "";
                    let offset = _params[0usize].sret != null ? 2usize : 1usize;
                    let mut _match = true;

                    if (!has_pack && params.Size() != _params.Size() - offset) || (has_pack && params.Size() < _params.Size() - offset) {
                        continue;
                    }

                    for j in 0usize..(_params.Size() - offset) {
                        let param_type = _params[j + offset];
                        let _type = param_type.byval != null ? param_type.byval : param_type._type;
                        let param_score = _type->ScoreParameter(*params[j]);

                        if param_score == 0u64 {
                            _match = false;
                            break;
                        }
                    }

                    if _match {
                        ret true;
                    }
                }
            }
        } ret false;
    }

    pub Get(&this, name: &String, node: *const Node) -> *const Pair<Method, *const QualifiedType> {
        let mut state = 0u64;

        for method in this.Methods() {
            if method.left.name == name {
                let mut _state = false;

                if compiler->_class != null {
                    _state = *compiler->_class == this;
                }

                if method.left.visibility != TokenType::PUBLIC && !_state {
                    if state < 1u64 { state = 1u64; }
                } else {
                    ret &method;
                }
            }
        }

        if state == 0u64 {
            Logger::Log("Class '" + this.name + "' doesn't contain any member named '" + name + "'.", node, LogSeverity::Error);
            ret null;
        } else {
            Logger::Log("Function '" + name + "' is not accessible.", node, LogSeverity::Error);
            ret null;
        }
    }

    pub Get(&this, name: &String, params: &Vector<*const QualifiedType>, node: *const Node) -> *const Pair<Method, *const QualifiedType> {
        let methods = this.Methods();
        let (mut index, mut best, mut state) = (0usize, 0u64, 0u64);

        for i in 0usize..methods.Size() {
            if methods[i].left.name == name {
                let mut _state = false;

                if compiler->_class != null {
                    _state = *compiler->_class == this;
                }

                if methods[i].left.visibility != TokenType::PUBLIC && !_state {
                    if state < 1u64 { state = 1u64; }
                } else {
                    let (mut _match, mut score) = (true, 1u64);
                    let _params = methods[i].right->Pointee().Parameters();
                    let has_pack = methods[i].right->Pointee().pack_name != "";
                    let offset = _params[0usize].sret != null ? 2usize : 1usize;

                    if (!has_pack && params.Size() != _params.Size() - offset) || (has_pack && params.Size() < _params.Size() - offset) {
                        continue;
                    }

                    for j in 0usize..(_params.Size() - offset) {
                        let param_type = _params[j + offset];
                        let _type = param_type.byval != null ? param_type.byval : param_type._type;
                        let param_score = _type->ScoreParameter(*params[j]);

                        if param_score != 0u64 {
                            score += param_score;
                        } else {
                            _match = false;
                            break;
                        }
                    }

                    if !_match {
                        state = 2u64;
                    } else if score > best {
                        (index, best) = (i, score);
                    }
                }
            }
        }

        if best != 0u64 {
            ret methods[index];
        } else {
            if state == 0u64 {
                Logger::Log("Class '" + this.name + "' doesn't contain any member named '" + name + "'.", node, LogSeverity::Error);
                ret null;
            } else if state == 1u64 {
                Logger::Log("Function '" + name + "' is not accessible.", node, LogSeverity::Error);
                ret null;
            } else {
                Logger::Log("Invalid arguments for: '" + name + "'.", node, LogSeverity::Error);
                ret null;
            }
        }
    }

    pub op==(&this, other: &QualifiedType) -> bool {
        if this.kind == TypeKind::Integer && other.kind == TypeKind::Integer {
            ret this.signed == other.signed && this.width == other.width;
        } else if this.kind == TypeKind::Float && other.kind == TypeKind::Float {
            ret this.width == other.width;
        } else if (this.kind == TypeKind::Pointer || this.kind == TypeKind::Reference) && (other.kind == TypeKind::Pointer || other.kind == TypeKind::Reference) {
            ret *this.pointee == *other.pointee;
        } else if this.kind == TypeKind::Array && other.kind == TypeKind::Array {
            ret *this.pointee == *other.pointee && this.length == other.length;
        } else if (this.kind == TypeKind::Class || this.kind == TypeKind::Enum) && (other.kind == TypeKind::Class || other.kind == TypeKind::Enum) {
            ret this.name == other.name;
        } else if (this.kind == TypeKind::Function || this.kind == TypeKind::PackSpecializedFunction) && (other.kind == TypeKind::Function || other.kind == TypeKind::PackSpecializedFunction) {
            if this.params.Size() != other.params.Size() {
                ret false;
            }

            for i in 0usize..this.params.Size() {
                if *this.params[i]._type != *other.params[i]._type {
                    ret false;
                }
            }

            ret *this.return._type == *other.return._type;
        } else {
            ret this.kind == other.kind;
        }
    }

    pub op!=(&this, other: &QualifiedType) -> bool {
        ret !(this == other);
    }

    pub ToString(&this) -> String {
        if this.kind == TypeKind::Void {
            ret "void".ToString();
        } else if this.kind == TypeKind::Boolean {
            ret "bool".ToString();
        } else if this.kind == TypeKind::Character {
            ret "char".ToString();
        } else if this.kind == TypeKind::Integer {
            if this.width != 0u32 {
                ret (this.signed ? "i" : "u") + String(this.width as u64);
            } else {
                ret (this.signed ? "isize" : "usize").ToString();
            }
        } else if this.kind == TypeKind::Float {
            ret "f" + String(this.width as u64);
        } else if this.kind == TypeKind::Pointer {
            ret (this.mutable ? "*mut " : "*const ") + this.pointee->ToString();
        } else if this.kind == TypeKind::Reference {
            ret (this.mutable ? "&mut " : "&") + this.pointee->ToString();
        } else if this.kind == TypeKind::Array {
            ret "(" + this.pointee->ToString() + ")[" + String(this.length as u64) + "]";
        } else if this.kind == TypeKind::Function || this.kind == TypeKind::PackSpecializedFunction {
            let mut result = "func(".ToString();

            for param in this.params {
                result += param._type->ToString();
            } result += ')';

            if this.return._type->kind != TypeKind::Void {
                result += " -> " + this.return._type->ToString();
            } ret result;
        } else {
            ret this.name;
        }
    }
}
