include "divio", "divstr", "divvec", "divmem", "divstd" : *;

enum TokenType: i32 {
    UNKNOWN, EOF,

    IDENTIFIER, INTEGER, FLOAT, STRING, CHAR, TRUE, FALSE, NULL,

    INCLUDE, USE, MODULE, NEW, DELETE, ASYNC, AWAIT, AS,
    IF, ELSE, FOR, IN, WHILE, LOOP, MATCH, RETURN, BREAK, CONTINUE,
    FUNC, CLASS, ENUM, TYPE, IMPL, EXTERN, LET, MUT, CONST, STATIC,
    PUBLIC, PRIVATE, OPERATOR, ASSEMBLY, ASSEMBLY_CODE, VOLATILE,

    ASSIGN, PLUS_ASSIGN, MINUS_ASSIGN, MUL_ASSIGN, DIV_ASSIGN, MOD_ASSIGN,
    LSHIFT_ASSIGN, RSHIFT_ASSIGN, AND_ASSIGN, OR_ASSIGN, XOR_ASSIGN,

    PLUS, MINUS, MUL, DIV, MOD, EQUAL, NOT_EQUAL, 
    GREATER, LESS, GREATER_EQUAL, LESS_EQUAL, AND, OR, NOT,
    BITWISE_AND, BITWISE_OR, BITWISE_XOR, LSHIFT, RSHIFT, TILDE,

    LPAREN, RPAREN, LBRACE, RBRACE, LBRACKET, RBRACKET,
    DOT, TWO_DOT, THREE_DOT, COMMA, COLON, DOUBLE_COLON, SEMICOLON,
    QUESTION_MARK, BACKSLASH, ARROW, FAT_ARROW,

    PREPROCESSOR_START, PREPROCESSOR_END,
    ENDIF, ELIF, ERROR, WARNING
};

func TokenTypeToString(_type: TokenType) -> *const i8 {
    if _type == TokenType::EOF { ret "EOF"; }
    else if _type == TokenType::IDENTIFIER { ret "IDENTIFIER"; }
    else if _type == TokenType::INTEGER { ret "INTEGER"; }
    else if _type == TokenType::FLOAT { ret "FLOAT"; }
    else if _type == TokenType::STRING { ret "STRING"; }
    else if _type == TokenType::CHAR { ret "CHAR"; }
    else if _type == TokenType::TRUE { ret "TRUE"; }
    else if _type == TokenType::FALSE { ret "FALSE"; }
    else if _type == TokenType::NULL { ret "NULL"; }
    else if _type == TokenType::INCLUDE { ret "INCLUDE"; }
    else if _type == TokenType::USE { ret "USE"; }
    else if _type == TokenType::MODULE { ret "MODULE"; }
    else if _type == TokenType::NEW { ret "NEW"; }
    else if _type == TokenType::DELETE { ret "DELETE"; }
    else if _type == TokenType::ASYNC { ret "ASYNC"; }
    else if _type == TokenType::AWAIT { ret "AWAIT"; }
    else if _type == TokenType::AS { ret "AS"; }
    else if _type == TokenType::IF { ret "IF"; }
    else if _type == TokenType::ELSE { ret "ELSE"; }
    else if _type == TokenType::FOR { ret "FOR"; }
    else if _type == TokenType::IN { ret "IN"; }
    else if _type == TokenType::WHILE { ret "WHILE"; }
    else if _type == TokenType::LOOP { ret "LOOP"; }
    else if _type == TokenType::MATCH { ret "MATCH"; }
    else if _type == TokenType::RETURN { ret "RETURN"; }
    else if _type == TokenType::BREAK { ret "BREAK"; }
    else if _type == TokenType::CONTINUE { ret "CONTINUE"; }
    else if _type == TokenType::FUNC { ret "FUNC"; }
    else if _type == TokenType::CLASS { ret "CLASS"; }
    else if _type == TokenType::ENUM { ret "ENUM"; }
    else if _type == TokenType::TYPE { ret "TYPE"; }
    else if _type == TokenType::IMPL { ret "IMPL"; }
    else if _type == TokenType::EXTERN { ret "EXTERN"; }
    else if _type == TokenType::LET { ret "LET"; }
    else if _type == TokenType::MUT { ret "MUT"; }
    else if _type == TokenType::CONST { ret "CONST"; }
    else if _type == TokenType::STATIC { ret "STATIC"; }
    else if _type == TokenType::PUBLIC { ret "PUBLIC"; }
    else if _type == TokenType::PRIVATE { ret "PRIVATE"; }
    else if _type == TokenType::OPERATOR { ret "OPERATOR"; }
    else if _type == TokenType::ASSEMBLY { ret "ASSEMBLY"; }
    else if _type == TokenType::ASSEMBLY_CODE { ret "ASSEMBLY_CODE"; }
    else if _type == TokenType::VOLATILE { ret "VOLATILE"; }
    else if _type == TokenType::ASSIGN { ret "ASSIGN"; }
    else if _type == TokenType::PLUS_ASSIGN { ret "PLUS_ASSIGN"; }
    else if _type == TokenType::MINUS_ASSIGN { ret "MINUS_ASSIGN"; }
    else if _type == TokenType::MUL_ASSIGN { ret "MUL_ASSIGN"; }
    else if _type == TokenType::DIV_ASSIGN { ret "DIV_ASSIGN"; }
    else if _type == TokenType::MOD_ASSIGN { ret "MOD_ASSIGN"; }
    else if _type == TokenType::LSHIFT_ASSIGN { ret "LSHIFT_ASSIGN"; }
    else if _type == TokenType::RSHIFT_ASSIGN { ret "RSHIFT_ASSIGN"; }
    else if _type == TokenType::AND_ASSIGN { ret "AND_ASSIGN"; }
    else if _type == TokenType::OR_ASSIGN { ret "OR_ASSIGN"; }
    else if _type == TokenType::XOR_ASSIGN { ret "XOR_ASSIGN"; }
    else if _type == TokenType::PLUS { ret "PLUS"; }
    else if _type == TokenType::MINUS { ret "MINUS"; }
    else if _type == TokenType::MUL { ret "MUL"; }
    else if _type == TokenType::DIV { ret "DIV"; }
    else if _type == TokenType::MOD { ret "MOD"; }
    else if _type == TokenType::EQUAL { ret "EQUAL"; }
    else if _type == TokenType::NOT_EQUAL { ret "NOT_EQUAL"; }
    else if _type == TokenType::GREATER { ret "GREATER"; }
    else if _type == TokenType::LESS { ret "LESS"; }
    else if _type == TokenType::GREATER_EQUAL { ret "GREATER_EQUAL"; }
    else if _type == TokenType::LESS_EQUAL { ret "LESS_EQUAL"; }
    else if _type == TokenType::AND { ret "AND"; }
    else if _type == TokenType::OR { ret "OR"; }
    else if _type == TokenType::NOT { ret "NOT"; }
    else if _type == TokenType::BITWISE_AND { ret "BITWISE_AND"; }
    else if _type == TokenType::BITWISE_OR { ret "BITWISE_OR"; }
    else if _type == TokenType::BITWISE_XOR { ret "BITWISE_XOR"; }
    else if _type == TokenType::LSHIFT { ret "LSHIFT"; }
    else if _type == TokenType::RSHIFT { ret "RSHIFT"; }
    else if _type == TokenType::TILDE { ret "TILDE"; }
    else if _type == TokenType::LPAREN { ret "LPAREN"; }
    else if _type == TokenType::RPAREN { ret "RPAREN"; }
    else if _type == TokenType::LBRACE { ret "LBRACE"; }
    else if _type == TokenType::RBRACE { ret "RBRACE"; }
    else if _type == TokenType::LBRACKET { ret "LBRACKET"; }
    else if _type == TokenType::RBRACKET { ret "RBRACKET"; }
    else if _type == TokenType::DOT { ret "DOT"; }
    else if _type == TokenType::TWO_DOT { ret "TWO_DOT"; }
    else if _type == TokenType::THREE_DOT { ret "THREE_DOT"; }
    else if _type == TokenType::COMMA { ret "COMMA"; }
    else if _type == TokenType::COLON { ret "COLON"; }
    else if _type == TokenType::DOUBLE_COLON { ret "DOUBLE_COLON"; }
    else if _type == TokenType::SEMICOLON { ret "SEMICOLON"; }
    else if _type == TokenType::QUESTION_MARK { ret "QUESTION_MARK"; }
    else if _type == TokenType::BACKSLASH { ret "BACKSLASH"; }
    else if _type == TokenType::ARROW { ret "ARROW"; }
    else if _type == TokenType::FAT_ARROW { ret "FAT_ARROW"; }
    else if _type == TokenType::PREPROCESSOR_START { ret "PREPROCESSOR_START"; }
    else if _type == TokenType::PREPROCESSOR_END { ret "PREPROCESSOR_END"; }
    else if _type == TokenType::ENDIF { ret "ENDIF"; }
    else if _type == TokenType::ELIF { ret "ELIF"; }
    else if _type == TokenType::ERROR { ret "ERROR"; }
    else if _type == TokenType::WARNING { ret "WARNING"; }
    else { ret "UNKNOWN"; }
}

func AssignmentOperatorToString(operator: TokenType) -> *const i8 {
    if operator == TokenType::ASSIGN { ret "="; }
    else if operator == TokenType::PLUS_ASSIGN { ret "+="; }
    else if operator == TokenType::MINUS_ASSIGN { ret "-="; }
    else if operator == TokenType::MUL_ASSIGN { ret "*="; }
    else if operator == TokenType::DIV_ASSIGN { ret "/="; }
    else if operator == TokenType::MOD_ASSIGN { ret "%="; }
    else if operator == TokenType::LSHIFT_ASSIGN { ret "<<="; }
    else if operator == TokenType::RSHIFT_ASSIGN { ret ">>="; }
    else if operator == TokenType::AND_ASSIGN { ret "&="; }
    else if operator == TokenType::OR_ASSIGN { ret "|="; }
    else if operator == TokenType::XOR_ASSIGN { ret "^="; }
    else { ret "unknown"; }
}

func BinaryOperatorToString(operator: TokenType) -> *const i8 {
    if operator == TokenType::PLUS { ret "+"; }
    else if operator == TokenType::MINUS { ret "-"; }
    else if operator == TokenType::MUL { ret "*"; }
    else if operator == TokenType::DIV { ret "/"; }
    else if operator == TokenType::MOD { ret "%"; }
    else if operator == TokenType::EQUAL { ret "=="; }
    else if operator == TokenType::NOT_EQUAL { ret "!="; }
    else if operator == TokenType::GREATER { ret ">"; }
    else if operator == TokenType::LESS { ret "<"; }
    else if operator == TokenType::GREATER_EQUAL { ret ">="; }
    else if operator == TokenType::LESS_EQUAL { ret "<="; }
    else if operator == TokenType::AND { ret "&&"; }
    else if operator == TokenType::OR { ret "||"; }
    else if operator == TokenType::BITWISE_AND { ret "&"; }
    else if operator == TokenType::BITWISE_OR { ret "|"; }
    else if operator == TokenType::BITWISE_XOR { ret "^"; }
    else if operator == TokenType::LSHIFT { ret "<<"; }
    else if operator == TokenType::RSHIFT { ret ">>"; }
    else { ret "unknown"; }
}

func UnaryOperatorToCString(operator: TokenType) -> *const i8 {
    if operator == TokenType::MINUS { ret "-"; }
    else if operator == TokenType::MUL { ret "*"; }
    else if operator == TokenType::NOT { ret "!"; }
    else if operator == TokenType::BITWISE_AND { ret "&"; }
    else { ret "unknown"; }
}

func StringToKeyword(string: String) -> TokenType {
    if string == "true" { ret TokenType::TRUE; }
    else if string == "false" { ret TokenType::FALSE; }
    else if string == "null" { ret TokenType::NULL; }
    else if string == "include" { ret TokenType::INCLUDE; }
    else if string == "use" { ret TokenType::USE; }
    else if string == "mod" { ret TokenType::MODULE; }
    else if string == "new" { ret TokenType::NEW; }
    else if string == "del" { ret TokenType::DELETE; }
    else if string == "async" { ret TokenType::ASYNC; }
    else if string == "await" { ret TokenType::AWAIT; }
    else if string == "as" { ret TokenType::AS; }
    else if string == "if" { ret TokenType::IF; }
    else if string == "else" { ret TokenType::ELSE; }
    else if string == "for" { ret TokenType::FOR; }
    else if string == "in" { ret TokenType::IN; }
    else if string == "while" { ret TokenType::WHILE; }
    else if string == "loop" { ret TokenType::LOOP; }
    else if string == "match" { ret TokenType::MATCH; }
    else if string == "ret" { ret TokenType::RETURN; }
    else if string == "break" { ret TokenType::BREAK; }
    else if string == "continue" { ret TokenType::CONTINUE; }
    else if string == "func" { ret TokenType::FUNC; }
    else if string == "class" { ret TokenType::CLASS; }
    else if string == "enum" { ret TokenType::ENUM; }
    else if string == "type" { ret TokenType::TYPE; }
    else if string == "impl" { ret TokenType::IMPL; }
    else if string == "extern" { ret TokenType::EXTERN; }
    else if string == "let" { ret TokenType::LET; }
    else if string == "mut" { ret TokenType::MUT; }
    else if string == "const" { ret TokenType::CONST; }
    else if string == "static" { ret TokenType::STATIC; }
    else if string == "pub" { ret TokenType::PUBLIC; }
    else if string == "priv" { ret TokenType::PRIVATE; }
    else if string == "op" { ret TokenType::OPERATOR; }
    else if string == "asm" { ret TokenType::ASSEMBLY; }
    else if string == "volatile" { ret TokenType::VOLATILE; }
    else { ret TokenType::UNKNOWN; }
}

func StringToDirective(string: String) -> TokenType {
    if string == "true" { ret TokenType::TRUE; }
    else if string == "false" { ret TokenType::FALSE; }
    else if string == "if" { ret TokenType::IF; }
    else if string == "elif" { ret TokenType::ELIF; }
    else if string == "else" { ret TokenType::ELSE; }
    else if string == "endif" { ret TokenType::ENDIF; }
    else if string == "error" { ret TokenType::ERROR; }
    else if string == "warning" { ret TokenType::WARNING; }
    else { ret TokenType::UNKNOWN; }
}

class Token {
    pub _type: TokenType, pub value: String,
    pub row: u64, pub column: u64
};

class Lexer {
    priv row: u64, priv column: u64,
    priv text: String, priv file: String,
    priv length: u64, priv index: u64,
    priv preprocessor: bool = false,
    priv assembly: bool = false
} impl {
    priv IsDigit(this: &Lexer, character: i8) -> bool {
        ret character >= '0' && character <= '9';
    }

    priv IsHexDigit(this: &Lexer, character: i8) -> bool {
        ret (character >= '0' && character <= '9') || (character >= 'a' && character <= 'f') || (character >= 'A' && character <= 'F');
    }

    priv IsBinDigit(this: &Lexer, character: i8) -> bool {
        ret character == '0' || character == '1';
    }

    priv IsOctDigit(this: &Lexer, character: i8) -> bool {
        ret character >= '0' && character <= '7';
    }

    priv IsAlpha(this: &Lexer, character: i8) -> bool {
        ret (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') || character == '_';
    }

    priv IsAlphaNum(this: &Lexer, character: i8) -> bool {
        ret this.IsAlpha(character) || this.IsDigit(character);
    }

    priv CurrentChar(this: &Lexer) -> i8 {
        if this.index >= this.length { ret '\0'; }
        ret this.text.Data()[this.index];
    }

    priv PeekChar(this: &Lexer, offset: u64) -> i8 {
        let peek_index: u64 = this.index + offset;
        if peek_index >= this.length { ret '\0'; }
        ret this.text.Data()[peek_index];
    }

    priv Advance(this: &mut Lexer, count: u64) {
        let mut i: u64 = 0u64;

        while i < count {
            if this.index < this.length {
                if this.CurrentChar() == '\n' {
                    this.row += 1u64;
                    this.column = 1u64;
                } else {
                    this.column += 1u64;
                } this.index += 1u64;
            } i += 1u64;
        }
    }

    priv SkipWhitespace(this: &mut Lexer) {
        while this.CurrentChar() == ' ' || this.CurrentChar() == '\t' || this.CurrentChar() == '\r' {
            this.Advance(1u64);
        }
    }

    priv SkipComment(this: &mut Lexer) -> bool {
        if this.CurrentChar() == '/' {
            if this.PeekChar(1u64) == '/' {
                while this.CurrentChar() != '\n' && this.CurrentChar() != '\0' {
                    this.Advance(1u64);
                } ret true;
            } else if this.PeekChar(1u64) == '*' {
                this.Advance(2u64);

                while this.CurrentChar() != '\0' {
                    if this.CurrentChar() == '*' && this.PeekChar(1u64) == '/' {
                        this.Advance(2u64);
                        break;
                    } this.Advance(1u64);
                } ret true;
            }
        } ret false;
    }

    priv LexString(this: &mut Lexer) -> Token {
        let mut token: Token;
        (token.row, token.column) = (this.row, this.column);
        let quote_char: i8 = this.CurrentChar();
        token._type = quote_char != '"' ? TokenType::CHAR : TokenType::STRING;
        this.Advance(1u64);

        while this.CurrentChar() != quote_char && this.CurrentChar() != '\n' && this.CurrentChar() != '\0' {
            if this.CurrentChar() == '\\' {
                this.Advance(1u64);

                if this.CurrentChar() != '\0' {
                    let escaped: i8 = this.CurrentChar();

                    if escaped == '\'' {
                        token.value += "'";
                    } else if escaped == '"' {
                        token.value += "\"";
                    } else if escaped == '?' {
                        token.value += "\?";
                    } else if escaped == '\\' {
                        token.value += "\\";
                    } else if escaped == 'a' {
                        token.value += "\a";
                    } else if escaped == 'b' {
                        token.value += "\b";
                    } else if escaped == 'f' {
                        token.value += "\f";
                    } else if escaped == 'n' {
                        token.value += "\n";
                    } else if escaped == 'r' {
                        token.value += "\r";
                    } else if escaped == 't' {
                        token.value += "\t";
                    } else if escaped == 'v' {
                        token.value += "\v";
                    } else if escaped == 'x' {
                        this.Advance(1u64);
                        let mut value: String;

                        while this.IsHexDigit(this.CurrentChar()) {
                            value += this.CurrentChar();
                            this.Advance(1u64);
                        } else {
                            Logger::Log(this.file, token.row, token.column, "Invalid hexadecimal escape sequence.", LogSeverity::Error);
                        }

                        if value.Size() > 3u64 {
                            Logger::Log(this.file, token.row, token.column, "Hexadecimal escape sequence too long.", LogSeverity::Error);
                        }

                        token.value += value.ToInteger(16i32) as i8;
                        this.index -= 1u64;
                    } else {
                        let mut value: String;

                        while this.IsOctDigit(this.CurrentChar()) {
                            value += this.CurrentChar();
                            this.Advance(1u64);
                        } else {
                            Logger::Log(this.file, token.row, token.column, "Invalid octal escape sequence.", LogSeverity::Error);
                        }

                        if value.Size() > 4u64 {
                            Logger::Log(this.file, token.row, token.column, "Octal escape sequence too long.", LogSeverity::Error);
                        }

                        token.value += value.ToInteger(8i32) as i8;
                        this.index -= 1u64;
                    } this.Advance(1u64);
                }
            } else {
                token.value += this.CurrentChar();
                this.Advance(1u64);
            }
        }

        if this.CurrentChar() == quote_char {
            this.Advance(1u64);
        } else {
            Logger::Log(this.file, token.row, token.column, "Unterminated string literal.", LogSeverity::Error);
        } ret token;
    }

    priv LexNumber(this: &mut Lexer) -> Token {
        let mut token: Token;
        (token.row, token.column) = (this.row, this.column);
        token._type = TokenType::INTEGER;

        if this.CurrentChar() == '0' {
            token.value += this.CurrentChar();
            this.Advance(1u64);

            if this.CurrentChar() == 'x' || this.CurrentChar() == 'X' {
                token.value += this.CurrentChar();
                this.Advance(1u64);

                while this.IsHexDigit(this.CurrentChar()) {
                    token.value += this.CurrentChar();
                    this.Advance(1u64);
                }
            } else if this.CurrentChar() == 'b' || this.CurrentChar() == 'B' {
                token.value += this.CurrentChar();
                this.Advance(1u64);

                while this.IsBinDigit(this.CurrentChar()) {
                    token.value += this.CurrentChar();
                    this.Advance(1u64);
                }
            } else if this.CurrentChar() == 'o' || this.CurrentChar() == 'O' {
                token.value += this.CurrentChar();
                this.Advance(1u64);

                while this.IsOctDigit(this.CurrentChar()) {
                    token.value += this.CurrentChar();
                    this.Advance(1u64);
                }
            } else {
                while this.IsDigit(this.CurrentChar()) {
                    token.value += this.CurrentChar();
                    this.Advance(1u64);
                }
            }
        } else {
            while this.IsDigit(this.CurrentChar()) {
                token.value += this.CurrentChar();
                this.Advance(1u64);
            }
        }

        if this.CurrentChar() == '.' && this.IsDigit(this.PeekChar(1u64)) {
            token._type = TokenType::FLOAT;
            token.value += this.CurrentChar();
            this.Advance(1u64);

            while this.IsDigit(this.CurrentChar()) {
                token.value += this.CurrentChar();
                this.Advance(1u64);
            }
        }

        if this.CurrentChar() == 'e' || this.CurrentChar() == 'E' {
            token._type = TokenType::FLOAT;
            token.value += this.CurrentChar();
            this.Advance(1u64);

            if this.CurrentChar() == '+' || this.CurrentChar() == '-' {
                token.value += this.CurrentChar();
                this.Advance(1u64);
            }

            while this.IsDigit(this.CurrentChar()) {
                token.value += this.CurrentChar();
                this.Advance(1u64);
            }
        }

        if this.CurrentChar() == 'i' || this.CurrentChar() == 'u' {
            token.value += this.CurrentChar();
            this.Advance(1u64);

            while this.IsDigit(this.CurrentChar()) {
                token.value += this.CurrentChar();
                this.Advance(1u64);
            }
        } else if this.CurrentChar() == 'f' {
            token._type = TokenType::FLOAT;
            token.value += this.CurrentChar();
            this.Advance(1u64);

            while this.IsDigit(this.CurrentChar()) {
                token.value += this.CurrentChar();
                this.Advance(1u64);
            }
        } ret token;
    }

    priv LexIdentifier(this: &mut Lexer) -> Token {
        let mut token: Token;
        (token.row, token.column) = (this.row, this.column);

        loop {
            let byte: u8 = this.CurrentChar() as u8;

            if byte > 0x7Fu8 {
                token.value += byte as i8;
                token.value += this.PeekChar(1u64);

                if (byte & 0xE0u8) == 0xC0u8 {
                    this.Advance(2u64);
                } else {
                    token.value += this.PeekChar(2u64);

                    if (byte & 0xF0u8) == 0xE0u8 {
                        this.Advance(3u64);
                    } else {
                        token.value += this.PeekChar(3u64);
                        this.Advance(4u64);
                    }
                }
            } else {
                if token.value.Size() > 1u64 ? this.IsAlphaNum(byte as i8) : this.IsAlpha(byte as i8) {
                    token.value += byte as i8;
                    this.Advance(1u64);
                } else {
                    break;
                }
            }
        }

        if this.preprocessor {
            token._type = StringToDirective(token.value);
        } else {
            token._type = StringToKeyword(token.value);

            if token._type == TokenType::ASSEMBLY {
                this.assembly = true;
            }
        }

        if token._type == TokenType::UNKNOWN {
            token._type = TokenType::IDENTIFIER;
        } ret token;
    }

    priv LexSymbol(this: &mut Lexer) -> Token {
        let mut token: Token;
        (token.row, token.column) = (this.row, this.column);
        let current: i8 = this.CurrentChar();
        let next: i8 = this.PeekChar(1u64);
        token.value += current;

        if current == '#' && next == '[' {
            token.value += next;
            this.preprocessor = true;
            token._type = TokenType::PREPROCESSOR_START;
            this.Advance(2u64);
        } else if current == '+' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::PLUS_ASSIGN;
                this.Advance(2u64);
            } else {
                token._type = TokenType::PLUS;
                this.Advance(1u64);
            }
        } else if current == '-' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::MINUS_ASSIGN;
                this.Advance(2u64);
            } else if next == '>' {
                token.value += next;
                token._type = TokenType::ARROW;
                this.Advance(2u64);
            } else {
                token._type = TokenType::MINUS;
                this.Advance(1u64);
            }
        } else if current == '*' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::MUL_ASSIGN;
                this.Advance(2u64);
            } else {
                token._type = TokenType::MUL;
                this.Advance(1u64);
            }
        } else if current == '/' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::DIV_ASSIGN;
                this.Advance(2u64);
            } else {
                token._type = TokenType::DIV;
                this.Advance(1u64);
            }
        } else if current == '%' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::MOD_ASSIGN;
                this.Advance(2u64);
            } else {
                token._type = TokenType::MOD;
                this.Advance(1u64);
            }
        } else if current == '<' {
            if next == '<' && this.PeekChar(2u64) == '=' {
                token.value += next;
                token.value += this.PeekChar(2u64);
                token._type = TokenType::LSHIFT_ASSIGN;
                this.Advance(3u64);
            } else if next == '=' {
                token.value += next;
                token._type = TokenType::LESS_EQUAL;
                this.Advance(2u64);
            } else {
                token._type = TokenType::LESS;
                this.Advance(1u64);
            }
        } else if current == '>' {
            if next == '>' && this.PeekChar(2u64) == '=' {
                token.value += next;
                token.value += this.PeekChar(2u64);
                token._type = TokenType::RSHIFT_ASSIGN;
                this.Advance(3u64);
            } else if next == '=' {
                token.value += next;
                token._type = TokenType::GREATER_EQUAL;
                this.Advance(2u64);
            } else {
                token._type = TokenType::GREATER;
                this.Advance(1u64);
            }
        } else if current == '&' {
            if next == '&' {
                token.value += next;
                token._type = TokenType::AND;
                this.Advance(2u64);
            } else if next == '=' {
                token.value += next;
                token._type = TokenType::AND_ASSIGN;
                this.Advance(2u64);
            } else {
                token._type = TokenType::BITWISE_AND;
                this.Advance(1u64);
            }
        } else if current == '|' {
            if next == '|' {
                token.value += next;
                token._type = TokenType::OR;
                this.Advance(2u64);
            } else if next == '=' {
                token.value += next;
                token._type = TokenType::OR_ASSIGN;
                this.Advance(2u64);
            } else {
                token._type = TokenType::BITWISE_OR;
                this.Advance(1u64);
            }
        } else if current == '^' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::XOR_ASSIGN;
                this.Advance(2u64);
            } else {
                token._type = TokenType::BITWISE_XOR;
                this.Advance(1u64);
            }
        } else if current == '=' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::EQUAL;
                this.Advance(2u64);
            } else if next == '>' {
                token.value += next;
                token._type = TokenType::FAT_ARROW;
                this.Advance(2u64);
            } else {
                token._type = TokenType::ASSIGN;
                this.Advance(1u64);
            }
        } else if current == '!' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::NOT_EQUAL;
                this.Advance(2u64);
            } else {
                token._type = TokenType::NOT;
                this.Advance(1u64);
            }
        } else if current == '?' {
            token._type = TokenType::QUESTION_MARK;
            this.Advance(1u64);
        } else if current == '~' {
            token._type = TokenType::TILDE;
            this.Advance(1u64);
        } else if current == '.' {
            if next == '.' {
                if this.PeekChar(2u64) == '.' {
                    token.value += this.PeekChar(2u64);
                    token._type = TokenType::THREE_DOT;
                    this.Advance(3u64);
                } else {
                    token.value += next;
                    token._type = TokenType::TWO_DOT;
                    this.Advance(2u64);
                }
            } else {
                token._type = TokenType::DOT;
                this.Advance(1u64);
            }
        } else if current == ',' {
            token._type = TokenType::COMMA;
            this.Advance(1u64);
        } else if current == ':' {
            if next == ':' {
                token.value += next;
                token._type = TokenType::DOUBLE_COLON;
                this.Advance(2u64);
            } else {
                token._type = TokenType::COLON;
                this.Advance(1u64);
            }
        } else if current == ';' {
            if this.assembly {
                Logger::Log(this.file, token.row, token.column, "Expected an assembly block before the semicolon.", LogSeverity::Error);
            }

            token._type = TokenType::SEMICOLON;
            this.Advance(1u64);
        } else if current == '(' {
            token._type = TokenType::LPAREN;
            this.Advance(1u64);
        } else if current == ')' {
            token._type = TokenType::RPAREN;
            this.Advance(1u64);
        } else if current == '[' {
            token._type = TokenType::LBRACKET;
            this.Advance(1u64);
        } else if current == ']' {
            if this.preprocessor {
                this.preprocessor = false;
                token._type = TokenType::PREPROCESSOR_END;
                this.Advance(1u64);
            } else {
                token._type = TokenType::RBRACKET;
                this.Advance(1u64);
            }
        } else if current == '{' {
            token._type = TokenType::LBRACE;
            this.Advance(1u64);
        } else if current == '}' {
            token._type = TokenType::RBRACE;
            this.Advance(1u64);
        } else if current == '\\' {
            token._type = TokenType::BACKSLASH;
            this.Advance(1u64);
        } else {
            Logger::Log(this.file, this.row, this.column, String("Invalid symbol '") + current + "'.", LogSeverity::Error);
            this.Advance(1u64);
        } ret token;
    }

    priv LexAssembly(this: &mut Lexer) -> Token {
        let mut token: Token;
        (token.row, token.column, token._type) = (this.row, this.column, TokenType::ASSEMBLY_CODE);
        let mut indent: i32 = 1i32;
        this.Advance(1u64);

        while this.CurrentChar() != '\0' {
            if this.CurrentChar() == '{' {
                indent += 1i32;
            } else if this.CurrentChar() == '}' {
                indent -= 1i32;

                if indent == 0i32 {
                    break;
                }
            }

            token.value += this.CurrentChar();
            this.Advance(1u64);
        }

        if indent > 0i32 {
            Logger::Log(this.file, token.row, token.column, "Unterminated assembly block.", LogSeverity::Error);
        }

        this.Advance(1u64);
        this.assembly = false;
        ret token;
    }

    pub Lex(this: &mut Lexer, text: String, file: String) -> Vector<Token> {
        (this.index, this.row, this.column) = (0u64, 1u64, 1u64);
        (this.file, this.text, this.length) = (file, text, text.Size());
        let mut tokens: Vector<Token>;

        while this.CurrentChar() != '\0' {
            this.SkipWhitespace();

            if this.CurrentChar() == '\0' {
                break;
            }

            if this.CurrentChar() == '\n' {
                this.Advance(1u64);
                continue;
            }

            if this.SkipComment() {
                continue;
            }

            let character: i8 = this.CurrentChar();

            if character == '"' || character == '\'' {
                tokens.PushBack(this.LexString());
            } else if this.IsDigit(character) || (character == '.' && this.IsDigit(this.PeekChar(1u64))) {
                tokens.PushBack(this.LexNumber());
            } else if this.IsAlpha(character) || (character as u8) > 0x7Fu8 {
                tokens.PushBack(this.LexIdentifier());
            } else {
                if this.assembly && character == '{' {
                    tokens.PushBack(this.LexAssembly());
                } else {
                    tokens.PushBack(this.LexSymbol());
                }
            }
        }

        let mut eof: Token;
        (eof._type, eof.row, eof.column) = (TokenType::EOF, this.row, this.column);
        tokens.PushBack(eof);
        ret tokens;
    }
};

include "logger.div" : *;