include "divio", "divfile", "divstd", "divllvm", "lexer.div", "preprocessor.div", "parser.div", "compiler.div" : *;

const STARTF_USESTDHANDLES: u32 = 0x00000100u32;
const INFINITE: u32 = 0xFFFFFFFFu32;

class STARTUPINFOA {
    pub cb: u32,
    pub lpReserved: *mut i8,
    pub lpDesktop: *mut i8,
    pub lpTitle: *mut i8,
    pub dwX: u32,
    pub dwY: u32,
    pub dwXSize: u32,
    pub dwYSize: u32,
    pub dwXCountChars: u32,
    pub dwYCountChars: u32,
    pub dwFillAttribute: u32,
    pub dwFlags: u32,
    pub wShowWindow: u16,
    pub cbReserved2: u16,
    pub lpReserved2: *mut u8,
    pub hStdInput: *mut void,
    pub hStdOutput: *mut void,
    pub hStdError: *mut void
};

type LPSTARTUPINFOA = *mut STARTUPINFOA;

class PROCESS_INFORMATION {
    pub hProcess: *mut void,
    pub hThread: *mut void,
    pub dwProcessId: u32,
    pub dwThreadId: u32
};

type LPPROCESS_INFORMATION = *mut PROCESS_INFORMATION;

extern "C" {
    func QueryPerformanceCounter(lpPerformanceCount: *mut i64) -> i32;
    func QueryPerformanceFrequency(lpFrequency: *mut i64) -> i32;

    func CreateProcessA(lpApplicationName: *const i8, lpCommandLine: *mut i8, lpProcessAttributes: *mut void, lpThreadAttributes: *mut void, bInheritHandles: i32, dwCreationFlags: u32, lpEnvironment: *mut void, lpCurrentDirectory: *const i8, lpStartupInfo: LPSTARTUPINFOA, lpProcessInformation: LPPROCESS_INFORMATION) -> i32;
    func WaitForSingleObject(hHandle: *mut void, dwMilliseconds: u32) -> u32;
    func GetExitCodeProcess(hProcess: *mut void, lpExitCode: *mut u32) -> i32;
    func GetLastError() -> u32;
}

class Timer {
    priv frequency: i64,
    priv counter: i64
} impl {
    Timer(this: &Timer) {
        QueryPerformanceFrequency(&this.frequency);
    }

    ~Timer(this: &Timer) {}

    pub Get(this: &Timer) -> f64 {
        QueryPerformanceCounter(&this.counter);
        ret (this.counter as f64) / (this.frequency as f64);
    }
};

func Execute(command: *const i8, output: bool) -> u32 {
    let mut startup_info: STARTUPINFOA;
    memset(&startup_info as *const void, 0i32, sizeof(startup_info));
    startup_info.cb = sizeof(startup_info) as u32;
    let process_info: PROCESS_INFORMATION;

    if output != true {
        (startup_info.hStdOutput, startup_info.hStdError, startup_info.hStdInput) = (null, null, null);
        startup_info.dwFlags |= STARTF_USESTDHANDLES;
    }

    if CreateProcessA(null, command, null, null, 0i32, 0u32, null, null, &startup_info, &process_info) == 0i32 {
        WriteLine(String("\x1b[31mFailed to create process: ") + String(GetLastError() as i64) + ".\x1b[0m");
        Exit(1i32);
    }

    let exit_code: u32;
    WaitForSingleObject(process_info.hProcess, INFINITE);

    if GetExitCodeProcess(process_info.hProcess, &exit_code) == 0i32 {
        WriteLine(String("\x1b[31mFailed to get process exit code: ") + String(GetLastError() as i64) + ".\x1b[0m");
    }

    CloseHandle(process_info.hProcess);
    CloseHandle(process_info.hThread);
    ret exit_code;
}

func GetWindowsSDKPath() -> String {
    let mut path: String = "C:\\Program Files (x86)\\Windows Kits\\10\\Lib";

    let find_data: WIN32_FIND_DATAA;
    let find_handle: *mut void = FindFirstFileA((path + "\\*").Data(), &find_data);

    if find_handle == INVALID_HANDLE_VALUE {
        WriteLine("\x1b[31mFailed to find Windows SDK path.\x1b[0m");
        Exit(1i32);
    }

    let mut highest_version_string: String = "";
    let (mut highest_v1: u64, mut highest_v2: u64) = (0u64, 0u64);
    let (mut highest_v3: u64, mut highest_v4: u64) = (0u64, 0u64);

    loop {
        if (find_data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0u32 {
            let file_name: String = find_data.cFileName;

            if file_name != "." && file_name != ".." && file_name != "wdf" {
                let parts: Vector<String> = file_name.Split('.');
                let (mut parsed_v1: u64, mut parsed_v2: u64, mut parsed_v3: u64, mut parsed_v4: u64) = (0u64, 0u64, 0u64, 0u64);

                if parts.Size() == 4u64 {
                    (parsed_v1, parsed_v2, parsed_v3, parsed_v4) = (parts[0u64].ToInteger() as u64, parts[1u64].ToInteger() as u64, parts[2u64].ToInteger() as u64, parts[3u64].ToInteger() as u64);
                } else {
                    WriteLine("\x1b[31mFailed to parse Windows SDK version.\x1b[0m");
                    Exit(1i32);
                }

                if parsed_v1 > highest_v1 || (parsed_v1 == highest_v1 && parsed_v2 > highest_v2) || (parsed_v1 == highest_v1 && parsed_v2 == highest_v2 && parsed_v3 > highest_v3) || (parsed_v1 == highest_v1 && parsed_v2 == highest_v2 && parsed_v3 == highest_v3 && parsed_v4 > highest_v4) {
                    (highest_version_string, highest_v1, highest_v2, highest_v3, highest_v4) = (file_name, parsed_v1, parsed_v2, parsed_v3, parsed_v4);
                }
            }
        }

        if FindNextFileA(find_handle, &find_data) == 0i32 {
            break;
        }
    }

    if highest_version_string != "" {
        path += "\\";
        path += highest_version_string;
    } else {
        WriteLine("\x1b[31mFailed to find a valid Windows SDK version.\x1b[0m");
        Exit(1i32);
    }

    FindClose(find_handle);
    ret path;
}

func GetMSVCPath() -> String {
    let mut path: String = "C:\\Program Files\\Microsoft Visual Studio";

    let find_data: WIN32_FIND_DATAA;
    let find_handle: *mut void = FindFirstFileA((path + "\\*").Data(), &find_data);

    if find_handle == INVALID_HANDLE_VALUE {
        WriteLine("\x1b[31mFailed to find Visual Studio path.\x1b[0m");
        Exit(1i32);
    }

    let mut highest_version_string: String = "";
    let mut highest_version: u64 = 0u64;

    loop {
        if (find_data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0u32 {
            let file_name: String = find_data.cFileName;

            if file_name != "." && file_name != ".." {
                let mut parsed_version: u64 = file_name.ToInteger() as u64;

                if parsed_version == 2017u64 { parsed_version = 15u64; }
                else if parsed_version == 2019u64 { parsed_version = 16u64; }
                else if parsed_version == 2022u64 { parsed_version = 17u64; }

                if parsed_version > highest_version {
                    (highest_version_string, highest_version) = (file_name, parsed_version);
                }
            }
        }

        if FindNextFileA(find_handle, &find_data) == 0i32 {
            break;
        }
    }

    if highest_version_string != "" {
        path += "\\";
        path += highest_version_string;
    } else {
        WriteLine("\x1b[31mFailed to find a valid Visual Studio version.\x1b[0m");
        Exit(1i32);
    }

    FindClose(find_handle);
    let find_data2: WIN32_FIND_DATAA;
    let find_handle2: *mut void = FindFirstFileA((path + "\\*").Data(), &find_data2);

    if find_handle2 == INVALID_HANDLE_VALUE {
        WriteLine("\x1b[31mFailed to find Visual Studio path.\x1b[0m");
        Exit(1i32);
    }

    loop {
        if (find_data2.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0u32 {
            let file_name: String = find_data2.cFileName;

            if file_name != "." && file_name != ".." {
                path += "\\";
                path += file_name;
                path += "\\VC\\Tools\\MSVC";
                break;
            }
        }

        if FindNextFileA(find_handle2, &find_data2) == 0i32 {
            break;
        }
    }

    FindClose(find_handle2);
    let find_data3: WIN32_FIND_DATAA;
    let find_handle3: *mut void = FindFirstFileA((path + "\\*").Data(), &find_data3);

    if find_handle3 == INVALID_HANDLE_VALUE {
        WriteLine("\x1b[31mFailed to find MSVC path.\x1b[0m");
        Exit(1i32);
    }

    let mut highest_version_string2: String = "";
    let (mut highest_v1: u64, mut highest_v2: u64) = (0u64, 0u64);
    let (mut highest_v3: u64, mut highest_v4: u64) = (0u64, 0u64);

    loop {
        if (find_data3.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0u32 {
            let file_name: String = find_data3.cFileName;

            if file_name != "." && file_name != ".." {
                let parts: Vector<String> = file_name.Split('.');
                let (mut parsed_v1: u64, mut parsed_v2: u64, mut parsed_v3: u64) = (0u64, 0u64, 0u64);

                if parts.Size() == 3u64 {
                    (parsed_v1, parsed_v2, parsed_v3) = (parts[0u64].ToInteger() as u64, parts[1u64].ToInteger() as u64, parts[2u64].ToInteger() as u64);
                } else {
                    WriteLine("\x1b[31mFailed to parse MSVC version.\x1b[0m");
                    Exit(1i32);
                }

                if parsed_v1 > highest_v1 || (parsed_v1 == highest_v1 && parsed_v2 > highest_v2) || (parsed_v1 == highest_v1 && parsed_v2 == highest_v2 && parsed_v3 > highest_v3) {
                    (highest_version_string2, highest_v1, highest_v2, highest_v3) = (file_name, parsed_v1, parsed_v2, parsed_v3);
                }
            }
        }

        if FindNextFileA(find_handle3, &find_data3) == 0i32 {
            break;
        }
    }

    if highest_version_string2 != "" {
        path += "\\";
        path += highest_version_string2;
    } else {
        WriteLine("\x1b[31mFailed to find a valid MSVC version.\x1b[0m");
        Exit(1i32);
    }

    FindClose(find_handle3);
    ret path;
}

func PrintVersion(executable: String) {
    WriteLine(String("Unversioned build of ") + executable + " (" + LLVMGetDefaultTargetTriple() + ").");
    WriteLine("Copyright (c) 2025-2026 Yusuf Rençber. All rights reserved.");
    WriteLine("This software is licensed under the Apache License, Version 2.0.");
    WriteLine("See the LICENSE file in the project root for more information.");
}

func PrintUsage(executable: String) {
    WriteLine("OVERVIEW: Divine compiler");
    WriteLine(String("USAGE: ") + executable + " [options] <inputs>");
    WriteLine("OPTIONS:");
    WriteLine("  -o <file>                Write output to <file>");
    WriteLine("  -I <dir>                 Add directory to include search path");
    WriteLine("  -L <dir>                 Add directory to library search path");
    WriteLine("  -l <name>                Link against library <name>");
    WriteLine("  -D <macro>[=<value>]     Define a macro");
    WriteLine("  -O<level>, -O            Optimization level (0, 1, 2, 3) [-O defaults to -O2]");
    WriteLine("  -g, --debug              Enable debug information");
    WriteLine("  -c                       Emit object code (.obj) alongside the executable");
    WriteLine("  -S                       Emit assembly code (.s) alongside the executable");
    WriteLine("  -emit-llvm               Emit LLVM IR (.ll) alongside the executable");
    WriteLine("  -target <triple>         Generate code for the given target");
    WriteLine("  -march <arch>            Architecture to generate code for");
    WriteLine("  -r, --run                Run the program after compiling");
    WriteLine("  -v, --verbose            Show verbose output");
    WriteLine("  --version                Display compiler version");
    WriteLine("  -h, --help               Display this help message");
}

func ErrorHandler(reason: *const i8) {
    WriteLine(String("\x1b[31mLLVM: Fatal Error: ") + reason + "\x1b[0m");
    Exit(1i32);
}

func main(argc: i32, argv[]: *const i8) -> i32 {
    LLVMEnablePrettyStackTrace();
    LLVMInstallFatalErrorHandler(ErrorHandler);

    let executable: String = SplitPath(String(argv[0u64])).right;

    if argc < 2i32 {
        PrintUsage(executable);
        ret 1i32;
    }

    let (mut input_files: Vector<String>, mut output_file: String);
    let (mut include_paths: Vector<String>, mut lib_paths: Vector<String>);
    let (mut defines: Vector<String>, mut libs: Vector<String>);

    include_paths.PushBack(String("."));
    include_paths.PushBack(String("include"));

#[if WINDOWS]
    defines.PushBack(String("WINDOWS"));
#[endif]

    let mut opt_level: LLVMCodeGenOptLevel = LLVMCodeGenOptLevel::LLVMCodeGenLevelDefault;
    let (mut triple: String, mut march: String) = (LLVMGetDefaultTargetTriple(), "generic");
    let (mut emit_object: bool, mut emit_asm: bool, mut emit_llvm: bool) = (false, false, false);
    let (mut run: bool, mut debug: bool, mut verbose: bool) = (false, false, false);
    let mut i: i32 = 1i32;

    while i < argc {
        let arg: String = argv[i as u64];

        if arg == "--help" || arg == "-h" {
            PrintUsage(executable);
            ret 0i32;
        } else if arg == "--version" {
            PrintVersion(executable);
            ret 0i32;
        } else if arg == "-v" || arg == "--verbose" {
            verbose = true;
        } else if arg == "-g" || arg == "--debug" {
            debug = true;
        } else if arg == "-c" {
            emit_object = true;
        } else if arg == "-S" {
            emit_asm = true;
        } else if arg == "-emit-llvm" {
            emit_llvm = true;
        } else if arg == "-r" || arg == "--run" {
            run = true;
        } else if arg == "-O0" {
            opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelNone;
        } else if arg == "-O1" {
            opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelLess;
        } else if arg == "-O2" || arg == "-O" {
            opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelDefault;
        } else if arg == "-O3" {
            opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelAggressive;
        } else if arg == "-o" {
            i += 1i32;

            if i < argc {
                output_file = argv[i as u64];
            } else {
                WriteLine(executable + ": \x1b[31mError:\x1b[0m Missing argument to '-o'.");
                ret 1i32;
            }
        } else if arg.StartsWith("-I") {
            let mut path: String = arg.SubString(2u64);

            if path.Empty() {
                i += 1i32;

                if i < argc {
                    path = argv[i as u64];
                } else {
                    WriteLine(executable + ": \x1b[31mError:\x1b[0m Missing argument to '-I'.");
                    ret 1i32;
                }
            }

            include_paths.PushBack(path);
        } else if arg.StartsWith("-L") {
            let mut path: String = arg.SubString(2u64);

            if path.Empty() {
                i += 1i32;

                if i < argc {
                    path = argv[i as u64];
                } else {
                    WriteLine(executable + ": \x1b[31mError:\x1b[0m Missing argument to '-L'.");
                    ret 1i32;
                }
            }

            lib_paths.PushBack(path);
        } else if arg.StartsWith("-l") {
            let mut name: String = arg.SubString(2u64);

            if name.Empty() {
                i += 1i32;

                if i < argc {
                    name = argv[i as u64];
                } else {
                    WriteLine(executable + ": \x1b[31mError:\x1b[0m Missing argument to '-l'.");
                    ret 1i32;
                }
            }

            libs.PushBack(name);
        } else if arg.StartsWith("-D") {
            let mut define: String = arg.SubString(2u64);

            if define.Empty() {
                i += 1i32;

                if i < argc {
                    define = argv[i as u64];
                } else {
                    WriteLine(executable + ": \x1b[31mError:\x1b[0m Missing argument to '-D'.");
                    ret 1i32;
                }
            }

            defines.PushBack(define);
        } else if arg == "-target" {
            i += 1i32;

            if i < argc {
                triple = argv[i as u64];
            } else {
                WriteLine(executable + ": \x1b[31mError:\x1b[0m Missing argument to '-target'.");
                ret 1i32;
            }
        } else if arg == "-march" {
            i += 1i32;

            if i < argc {
                march = argv[i as u64];
            } else {
                WriteLine(executable + ": \x1b[31mError:\x1b[0m Missing argument to '-march'.");
                ret 1i32;
            }
        } else if arg.StartsWith("-") {
            WriteLine(executable + ": \x1b[31mError:\x1b[0m Unknown option '" + arg + "'.");
            ret 1i32;
        } else {
            if FileExists(arg) {
                input_files.PushBack(arg);
            } else {
                WriteLine(executable + ": \x1b[31mError:\x1b[0m Cannot find '" + arg + "'.");
                ret 1i32;
            }
        } i += 1i32;
    }

    if input_files.Empty() {
        WriteLine(executable + ": \x1b[31mError:\x1b[0m No input files.");
        ret 1i32;
    }

    let timer: Timer;
    let start: f64 = timer.Get();
    let mut objects: Vector<String>;
    let temp_path: String = GetTemporaryPath();
    if temp_path.Empty() { ret 1i32; }
    let mut j: u64 = 0u64;

    while j < input_files.Size() {
        let input_file: String = input_files[j];
        if verbose { WriteLine(String("Compiling: ") + input_file); }
        let source: String = _ReadFile(input_file);

        let mut lexer: Lexer;
        let mut preprocessor: Preprocessor;
        preprocessor.defines = defines;

        let mut tokens: Vector<Token> = lexer.Lex(source, input_file);
        tokens = preprocessor.Process(tokens, input_file);

        let mut parser: Parser;
        (parser.defines, parser.include_paths) = (defines, include_paths);
        let ast: *const RootNode = parser.Parse(tokens, input_file);

        let mut compiler: Compiler = { triple, march, opt_level };
        let module: LLVMModuleRef = compiler.Compile(ast, input_file);
        let name: String = SplitExtension(input_file).left;

        if opt_level != LLVMCodeGenOptLevel::LLVMCodeGenLevelNone {
            let mut passes: String;

            if opt_level == LLVMCodeGenOptLevel::LLVMCodeGenLevelLess {
                WriteLine(input_file + ": \x1b[35mWarning:\x1b[0m Optimizing at less level which may break your program in this version. (\x1b[36m-O1\x1b[0m)");
                passes = "default<O1>";
            } else if opt_level == LLVMCodeGenOptLevel::LLVMCodeGenLevelDefault {
                WriteLine(input_file + ": \x1b[35mWarning:\x1b[0m Optimizing at default level which may break your program in this version. (\x1b[36m-O2\x1b[0m)");
                passes = "default<O2>";
            } else if opt_level == LLVMCodeGenOptLevel::LLVMCodeGenLevelAggressive {
                WriteLine(input_file + ": \x1b[35mWarning:\x1b[0m Optimizing at aggressive level which may break your program in this version. (\x1b[36m-O3\x1b[0m)");
                passes = "default<O3>";
            } else {
                WriteLine(input_file + ": \x1b[31mError:\x1b[0m Failed to optimize module, unknown optimization level. (\x1b[36m-O" + String(opt_level as i64) + "\x1b[0m)");
                ret 1i32;
            }

            if passes.Size() > 1u64 {
                let pass_options: LLVMPassBuilderOptionsRef = LLVMCreatePassBuilderOptions();
                let error: LLVMErrorRef = LLVMRunPasses(module, passes.Data(), compiler.target_machine, pass_options);
                LLVMDisposePassBuilderOptions(pass_options);

                if error != LLVMErrorSuccess {
                    let message: *const i8 = LLVMGetErrorMessage(error);
                    WriteLine(input_file + ": \x1b[31mError:\x1b[0m Failed to optimize module: " + message);
                    LLVMDisposeErrorMessage(message);
                    ret 1i32;
                }
            }
        }

        if emit_llvm {
            let string: *const i8 = LLVMPrintModuleToString(module);
            _WriteFile(name + ".ll", String(string));
            LLVMDisposeMessage(string);
        }

        if emit_asm {
            let message: *const i8 = null;

            if LLVMTargetMachineEmitToFile(compiler.target_machine, module, (name + ".s").Data(), LLVMCodeGenFileType::LLVMAssemblyFile, &message) != 0i32 {
                WriteLine(input_file + ": \x1b[31mError:\x1b[0m Failed to emit assembly: " + message);
                LLVMDisposeMessage(message);
                ret 1i32;
            }

            LLVMDisposeMessage(message);
        }

        let message: *const i8 = null;
        let mut object_name: String = name + ".obj";

        if !emit_object {
            object_name = JoinPath(temp_path, SplitPath(object_name).right);
        }

        if LLVMTargetMachineEmitToFile(compiler.target_machine, module, object_name.Data(), LLVMCodeGenFileType::LLVMObjectFile, &message) != 0i32 {
            WriteLine(input_file + ": \x1b[31mError:\x1b[0m Failed to emit object: " + message);
            LLVMDisposeMessage(message);
            ret 1i32;
        }

        LLVMDisposeMessage(message);
        objects.PushBack(object_name);
        j += 1u64;
    }

    let (sdk_path: String, msvc_path: String) = (GetWindowsSDKPath(), GetMSVCPath());
    let mut command: String = String("\"") + msvc_path + "\\bin\\Hostx64\\x64\\link.exe\" /NOLOGO /SUBSYSTEM:CONSOLE /NODEFAULTLIB /ENTRY:_start";
    if debug { command += " /DEBUG"; }

    let mut final_output: String;
    if output_file.Size() > 1u64 { final_output = output_file; }
    else { final_output = SplitExtension(input_files[0u64]).left + ".exe"; }
    command += String(" /OUT:") + final_output;
    let mut k: u64 = 0u64;

    while k < objects.Size() {
        command += String(" ") + objects[k];
        k += 1u64;
    } k = 0u64;

    command += String(" \"/LIBPATH:") + msvc_path + "\\lib\\x64\"";
    command += String(" \"/LIBPATH:") + sdk_path + "\\um\\x64\"";
    command += String(" \"/LIBPATH:") + sdk_path + "\\ucrt\\x64\"";

    while k < lib_paths.Size() {
        command += String(" \"/LIBPATH:") + lib_paths[k] + "\"";
        k += 1u64;
    } k = 0u64;

    command += " user32.lib shell32.lib kernel32.lib";

    while k < libs.Size() {
        command += String(" ") + libs[k] + ".lib";
        k += 1u64;
    } k = 0u64;

    if verbose { WriteLine(String("Link: ") + command); }
    Execute(command.Data(), true);
    WriteLine(String("Program compiled in ") + String(timer.Get() - start) + " seconds.");

    if !emit_object {
        while k < objects.Size() {
            RemoveFile(objects[k]);
            k += 1u64;
        }
    }

    if run {
        WriteLine(String("Program finished with exit code: ") + String(Execute(final_output.Data(), true) as i64) + ".");
    } ret 0i32;
}