#[include "std/str", "std/vec", "std/map", "std/pair",
    "src/Scope.zir", "src/Symbol.zir", "src/HIR.zir" : *]

class GenericInstance {
    pub name: String,
    pub symbol: *Symbol = null,
    pub scope: *mut Scope = null,
    pub declaration: *mut HIRDeclaration = null,
    pub completed: HIRLoweringPass = HIRLoweringPass::None,
    pub active: HIRLoweringPass = HIRLoweringPass::None,
    pub types: Vector<*HIRType>;

    GenericInstance(&mut this, name: &String, types: &Vector<*HIRType>) {
        (this.name, this.types) = (name, types);
    }
}

class GenericDeclaration {
    cache: Map<String, *mut GenericInstance>,

    pub declaration: *ASTDeclaration,
    pub scope: *mut Scope,
    pub _class: *HIRType,

    pub name: String,
    pub types: Vector<String>;

    GenericDeclaration(&mut this, declaration: *ASTDeclaration) {
        (this.declaration, this.scope, this._class) = (declaration, hir_lowerer->scope_manager.current, hir_lowerer->current_class);

        if declaration->kind == ASTDeclarationKind::Class {
            let _class = declaration as *ASTClassDeclaration;
            (this.name, this.types) = (_class->name, _class->types);
        } else if declaration->kind == ASTDeclarationKind::Structure {
            let structure = declaration as *ASTStructureDeclaration;
            (this.name, this.types) = (structure->name, structure->types);
        } else {
            let function = declaration as *ASTFunctionDeclaration;
            (this.name, this.types) = (function->name, function->types);
        }
    }

    ~GenericDeclaration(&this) {
        for instance in this.cache.Values() {
            if instance->symbol != null {
                delete instance->symbol;
            } delete instance;
        }
    }

    pub fn Instantiate(&mut this, types: &Vector<*HIRType>, node: *ASTNode) -> *GenericInstance {
        if types.Size() != this.types.Size() {
            Logger::Log("Generic '" + this.name + "' expects " + String::FromInteger(this.types.Size() as u64) + " type argument(s), but " + String::FromInteger(types.Size() as u64) + " were provided.", node, LogSeverity::Error);
            return null;
        }

        let (prev_unsafe, prev_class) = (hir_lowerer->_unsafe, hir_lowerer->current_class);
        let (prev_scope, prev_generic) = (hir_lowerer->scope_manager.current, hir_lowerer->current_generic);
        let prev_function = hir_lowerer->builder.GetCurrentFunction();
        let prev_block = hir_lowerer->builder.GetCurrentBlock();

        hir_lowerer->builder.SetCurrentBlock(null);
        hir_lowerer->builder.SetCurrentFunction(null);
        (hir_lowerer->scope_manager.current, hir_lowerer->current_generic) = (this.scope, this);
        (hir_lowerer->_unsafe, hir_lowerer->current_class) = (false, this._class);
        let mut name = this.name + '<';

        for i in 0..types.Size() {
            if i != 0 { name += ", "; }
            name += types[i]->ToString();
        } name += '>';

        let mut instance: *mut GenericInstance = null;

        if this.cache.Has(name) {
            instance = this.cache[name];
        } else {
            instance = new GenericInstance(name, types);
            this.cache[name] = instance;
        }

        if instance->active != HIRLoweringPass::None {
            hir_lowerer->builder.SetCurrentBlock(prev_block);
            hir_lowerer->builder.SetCurrentFunction(prev_function);
            (hir_lowerer->scope_manager.current, hir_lowerer->current_generic) = (prev_scope, prev_generic);
            (hir_lowerer->_unsafe, hir_lowerer->current_class) = (prev_unsafe, prev_class);
            return instance;
        }

        hir_lowerer->scope_manager.PushScope("<generic>".ToString(), true);

        for i in 0..this.types.Size() {
            hir_lowerer->scope_manager.current->Set(this.types[i], types[i], this.declaration);
        }

        if this.declaration->kind == ASTDeclarationKind::Class {
            let _class = this.declaration as *ASTClassDeclaration;

            if instance->completed < HIRLoweringPass::First && hir_lowerer->current_pass >= HIRLoweringPass::First {
                instance->active = HIRLoweringPass::First;
                let pair = hir_lowerer->LowerClassDeclarationFirstPass(_class, instance);
                (instance->completed, instance->active) = (HIRLoweringPass::First, HIRLoweringPass::None);
                (instance->declaration, instance->scope) = (pair.left, hir_lowerer->scope_manager.current);
                instance->symbol = new Symbol(instance->declaration->_type);
            }

            if instance->completed < HIRLoweringPass::Second && hir_lowerer->current_pass >= HIRLoweringPass::Second {
                instance->active = HIRLoweringPass::Second;
                hir_lowerer->LowerClassDeclarationSecondPass(instance->declaration as *mut HIRClassDeclaration, _class, instance->scope);
                (instance->completed, instance->active) = (HIRLoweringPass::Second, HIRLoweringPass::None);
            }

            if instance->completed < HIRLoweringPass::Third && hir_lowerer->current_pass >= HIRLoweringPass::Third {
                instance->active = HIRLoweringPass::Third;
                hir_lowerer->LowerClassDeclarationThirdPass(instance->declaration as *mut HIRClassDeclaration, _class, instance->scope);
                (instance->completed, instance->active) = (HIRLoweringPass::Third, HIRLoweringPass::None);
            }

            if instance->completed < HIRLoweringPass::Fourth && hir_lowerer->current_pass >= HIRLoweringPass::Fourth {
                instance->active = HIRLoweringPass::Fourth;
                hir_lowerer->LowerClassDeclarationFourthPass(instance->declaration as *mut HIRClassDeclaration, _class, instance->scope);
                (instance->completed, instance->active) = (HIRLoweringPass::Fourth, HIRLoweringPass::None);
            }
        } else if this.declaration->kind == ASTDeclarationKind::Structure {
            let structure = this.declaration as *ASTStructureDeclaration;

            if instance->completed < HIRLoweringPass::First && hir_lowerer->current_pass >= HIRLoweringPass::First {
                instance->active = HIRLoweringPass::First;
                let pair = hir_lowerer->LowerStructureDeclarationFirstPass(structure, instance);
                (instance->completed, instance->active) = (HIRLoweringPass::First, HIRLoweringPass::None);
                (instance->declaration, instance->scope) = (pair.left, hir_lowerer->scope_manager.current);
                instance->symbol = new Symbol(instance->declaration->_type);
            }

            if instance->completed < HIRLoweringPass::Second && hir_lowerer->current_pass >= HIRLoweringPass::Second {
                instance->active = HIRLoweringPass::Second;
                hir_lowerer->LowerStructureDeclarationSecondPass(instance->declaration as *mut HIRStructureDeclaration, structure, instance->scope);
                (instance->completed, instance->active) = (HIRLoweringPass::Second, HIRLoweringPass::None);
            }

            if instance->completed < HIRLoweringPass::Third && hir_lowerer->current_pass >= HIRLoweringPass::Third {
                instance->active = HIRLoweringPass::Third;
                hir_lowerer->LowerStructureDeclarationThirdPass(instance->declaration as *mut HIRStructureDeclaration, structure, instance->scope);
                (instance->completed, instance->active) = (HIRLoweringPass::Third, HIRLoweringPass::None);
            }

            if instance->completed < HIRLoweringPass::Fourth && hir_lowerer->current_pass >= HIRLoweringPass::Fourth {
                instance->active = HIRLoweringPass::Fourth;
                hir_lowerer->LowerStructureDeclarationFourthPass(instance->declaration as *mut HIRStructureDeclaration, structure, instance->scope);
                (instance->completed, instance->active) = (HIRLoweringPass::Fourth, HIRLoweringPass::None);
            }
        } else {
            let function = this.declaration as *ASTFunctionDeclaration;

            if instance->completed < HIRLoweringPass::Third && hir_lowerer->current_pass >= HIRLoweringPass::Third {
                instance->active = HIRLoweringPass::Third;
                instance->declaration = hir_lowerer->LowerFunctionDeclarationFirstPass(function, instance);
                (instance->completed, instance->active) = (HIRLoweringPass::Third, HIRLoweringPass::None);
                instance->symbol = new Symbol(instance->declaration);
            }

            if instance->completed < HIRLoweringPass::Fourth && hir_lowerer->current_pass >= HIRLoweringPass::Fourth {
                instance->active = HIRLoweringPass::Fourth;
                hir_lowerer->LowerFunctionDeclarationSecondPass(instance->declaration as *mut HIRFunctionDeclaration, function);
                (instance->completed, instance->active) = (HIRLoweringPass::Fourth, HIRLoweringPass::None);
            }
        }

        hir_lowerer->scope_manager.PopScope();
        hir_lowerer->builder.SetCurrentBlock(prev_block);
        hir_lowerer->builder.SetCurrentFunction(prev_function);
        (hir_lowerer->scope_manager.current, hir_lowerer->current_generic) = (prev_scope, prev_generic);
        (hir_lowerer->_unsafe, hir_lowerer->current_class) = (prev_unsafe, prev_class);
        return instance;
    }
}

#[include "src/HIRLowerer.zir" : *]
