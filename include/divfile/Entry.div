include "divio", "divstd", "divwin", "divstr" : *;

func ReadFile(path: *const i8) -> String {
    let mut content: String;
    let file: *const FILE = fopen(path, "r");
    let buffer[256u64]: i8;

    if file == null {
        printf("\x1b[31mFailed to open file: '%s'.\x1b[0m\n", path);
        ret content;
    }

    while fgets(buffer, sizeof(buffer) as i32, file) != null {
        content += buffer;
    }

    fclose(file);
    ret content;
}

func WriteFile(path: *const i8, content: *const i8) -> bool {
    let file: *const FILE = fopen(path, "w");

    if file == null {
        printf("\x1b[31mFailed to open file: '%s'.\x1b[0m\n", path);
        ret false;
    }

    fwrite(content, 1u64, strlen(content), file);
    fclose(file);
    ret true;
}

func PathExists(path: *const i8) -> bool {
    ret GetFileAttributesA(path) != INVALID_FILE_ATTRIBUTES;
}

func FileExists(path: *const i8) -> bool {
    let attributes: DWORD = GetFileAttributesA(path);

    if attributes != INVALID_FILE_ATTRIBUTES {
        ret (attributes & FILE_ATTRIBUTE_DIRECTORY) == 0u32;
    } else {
        ret false;
    }
}

func FolderExists(path: *const i8) -> bool {
    let attributes: DWORD = GetFileAttributesA(path);

    if attributes != INVALID_FILE_ATTRIBUTES {
        ret (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0u32;
    } else {
        ret false;
    }
}

func SplitName(path: String) -> String {
    let (mut address: *const i8, mut i: u64) = (path[0u64], 0u64);

    while i < path.Size() {
        if path[i] == '/' || path[i] == '\\' {
            address = path[i + 1u64];
        } else if path[i] == '.' {
            path[i] = '\0';
        } i += 1u64;
    } ret String(address);
}