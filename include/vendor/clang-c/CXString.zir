class CXString {
    pub data: *void,
    pub private_flags: u32,
}

class CXStringSet {
    pub Strings: *mut CXString,
    pub Count: u32,
}

extern "C" {
    func clang_getCString(string: CXString) -> *i8;
    func clang_disposeString(string: CXString);
    func clang_disposeStringSet(set: *mut CXStringSet);
}
