#[include "std/std", "std/io" : *]

enum Option<T> {
    Some(T), None;

    pub IsSome(&this) -> bool {
        match this {
            Option::Some(_) => ret true,
            Option::None => ret false
        }
    }

    pub IsNone(&this) -> bool {
        match this {
            Option::Some(_) => ret false,
            Option::None => ret true
        }
    }

    pub Unwrap(&this) -> T {
        match this {
            Option::Some(value) => ret value,
            Option::None => {
                WriteLine("Panicked: called Unwrap() on a None value.");
                Exit(1);
                loop {}
            }
        }
    }

    pub UnwrapOr(&this, default: T) -> T {
        match this {
            Option::Some(value) => ret value,
            Option::None => ret default
        }
    }
}
