include "divmem" : *;

class Vector<T> {
    priv data: *mut T = null,
    priv capacity: u64 = 0u64,
    priv size: u64 = 0u64
} impl {
    Vector(this: &mut Vector<T>) {}

    Vector(this: &mut Vector<T>, other: &Vector<T>) {
        if other.data == null { ret; }
        this.Allocate(other.capacity);

        while this.size < other.size {
            this.data[this.size] = other.data[this.size];
            this.size += 1u64;
        }
    }

    ~Vector(this: &mut Vector<T>) {
        this.Release();
    }

    pub Data(this: &Vector<T>) -> *const T { ret this.data; }
    pub Front(this: &Vector<T>) -> &mut T { ret this.data[0u64]; }
    pub Back(this: &Vector<T>) -> &mut T { ret this.data[this.size - 1u64]; }
    pub Empty(this: &Vector<T>) -> bool { ret this.size == 0u64; }
    pub Size(this: &Vector<T>) -> u64 { ret this.size; }

    priv Allocate(this: &mut Vector<T>, capacity: u64) {
        (this.data, this.capacity) = (new T[capacity], capacity);
    }

    priv Release(this: &mut Vector<T>) {
        if this.data != null { del[] this.data; }
        (this.data, this.capacity, this.size) = (null, 0u64, 0u64);
    }

    pub Clear(this: &mut Vector<T>) {
        this.Release();
    }

    pub Reserve(this: &mut Vector<T>, capacity: u64) {
        if capacity > this.capacity {
            let temp: *const T = this.data;
            this.Allocate(capacity);

            if temp != null {
                let mut i: u64 = 0u64;

                while i < this.size {
                    this.data[i] = temp[i];
                    i += 1u64;
                } del[] temp;
            }
        }
    }

    pub Resize(this: &mut Vector<T>, size: u64) {
        if size > this.size {
            this.Reserve(size);
        } this.size = size;
    }

    pub Shrink(this: &mut Vector<T>) {
        if this.size < this.capacity {
            let temp: *const T = this.data;
            let size: u64 = this.size;
            this.Allocate(size);

            if temp != null {
                let mut i: u64 = 0u64;

                while i < size {
                    this.data[i] = temp[i];
                    i += 1u64;
                } del[] temp;
            } this.size = size;
        }
    }

    pub Swap(this: &mut Vector<T>, other: &mut Vector<T>) {
        let (data: *mut T, capacity: u64, size: u64) = (this.data, this.capacity, this.size);
        (this.data, this.capacity, this.size) = (other.data, other.capacity, other.size);
        (other.data, other.capacity, other.size) = (data, capacity, size);
    }

    pub PushBack(this: &mut Vector<T>, value: T) {
        if this.capacity < this.size + 1u64 {
            this.Reserve(this.capacity != 0u64 ? this.capacity * 2u64 : 1u64);
        }

        this.data[this.size] = value;
        this.size += 1u64;
    }

    pub PopBack(this: &mut Vector<T>) -> T {
        this.size -= 1u64;
        ret this.data[this.size];
    }

    pub Insert(this: &mut Vector<T>, index: u64, value: T) {
        if this.capacity < this.size + 1u64 {
            this.Reserve(this.capacity != 0u64 ? this.capacity * 2u64 : 1u64);
        }

        let mut i: u64 = this.size;

        while i > index {
            this.data[i] = this.data[i - 1u64];
            i -= 1u64;
        }

        this.data[index] = value;
        this.size += 1u64;
    }

    pub RemoveAt(this: &mut Vector<T>, index: u64) -> T {
        let temp: T = this.data[index];
        let mut i: u64 = index + 1u64;

        while i < this.size {
            this.data[i - 1u64] = this.data[i];
            i += 1u64;
        }

        this.size -= 1u64;
        ret temp;
    }

    pub Remove(this: &mut Vector<T>, value: T) {
        let mut i: u64 = 0u64;

        while i < this.size {
            if this.data[i] == value {
                let mut j: u64 = i + 1u64;

                while j < this.size {
                    this.data[j - 1u64] = this.data[j];
                    j += 1u64;
                }

                this.size -= 1u64;
            } else {
                i += 1u64;
            }
        }
    }

    pub Contains(this: &Vector<T>, value: T) -> bool {
        let mut i: u64 = 0u64;

        while i < this.size {
            if this.data[i] == value {
                ret true;
            } i += 1u64;
        } ret false;
    }

    pub Index(this: &Vector<T>, value: T) -> i64 {
        let mut i: u64 = 0u64;

        while i < this.size {
            if this.data[i] == value {
                ret i as i64;
            } i += 1u64;
        } ret -1i64;
    }

    pub op+(this: &Vector<T>, other: &Vector<T>) -> Vector<T> {
        let mut result: Vector<T>;
        result.Resize(this.size + other.size);
        let mut i: u64 = 0u64;

        while i < this.size {
            result.data[i] = this.data[i];
            i += 1u64;
        } i = 0u64;

        while i < other.size {
            result.data[this.size + i] = other.data[i];
            i += 1u64;
        } ret result;
    }

    pub op+=(this: &mut Vector<T>, other: &Vector<T>) -> &Vector<T> {
        let old_size: u64 = this.size;
        this.Resize(this.size + other.size);
        let mut i: u64 = 0u64;

        while i < other.size {
            this.data[old_size + i] = other.data[i];
            i += 1u64;
        } ret this;
    }

    pub op=(this: &mut Vector<T>, other: &Vector<T>) -> &Vector<T> {
        this.Release();
        if other.data == null { ret this; }
        this.Allocate(other.capacity);

        while this.size < other.size {
            this.data[this.size] = other.data[this.size];
            this.size += 1u64;
        } ret this;
    }

    pub op[](this: &Vector<T>, index: u64) -> &mut T {
        ret this.data[index];
    }
};