fn AtomicMemoryFence() {
    volatile asm {
        mfence
    } : memory;
}

fn AtomicLoadFence() {
    volatile asm {
        lfence
    } : memory;
}

fn AtomicStoreFence() {
    volatile asm {
        sfence
    } : memory;
}

fn AtomicPause() {
    volatile asm {
        pause
    };
}

class Atomic<T> {
    value: T;

    pub fn Atomic(&mut this) {}

    pub fn Atomic(&mut this, value: T) {
        this.value = value;
    }

    pub fn Load(&this) -> T {
        if sizeof(T) == 1 {
            return AtomicLoad8(&this.value as *u8) as T;
        } else if sizeof(T) == 2 {
            return AtomicLoad16(&this.value as *i16) as T;
        } else if sizeof(T) == 4 {
            return AtomicLoad32(&this.value as *u32) as T;
        } else if sizeof(T) == 8 {
            return AtomicLoad64(&this.value as *u64) as T;
        } else {
            AtomicLoadFence();
            let value = this.value;
            AtomicLoadFence();
            return value;
        }
    }

    pub fn Store(&mut this, value: T) {
        if sizeof(T) == 1 {
            AtomicExchange8(&this.value as *mut u8, value as u8);
        } else if sizeof(T) == 2 {
            AtomicExchange16(&this.value as *mut i16, value as i16);
        } else if sizeof(T) == 4 {
            AtomicExchange32(&this.value as *mut u32, value as u32);
        } else if sizeof(T) == 8 {
            AtomicExchange64(&this.value as *mut u64, value as u64);
        } else {
            AtomicStoreFence();
            this.value = value;
            AtomicStoreFence();
        }
    }

    pub fn Exchange(&mut this, value: T) -> T {
        if sizeof(T) == 1 {
            return AtomicExchange8(&this.value as *mut u8, value as u8) as T;
        } else if sizeof(T) == 2 {
            return AtomicExchange16(&this.value as *mut i16, value as i16) as T;
        } else if sizeof(T) == 4 {
            return AtomicExchange32(&this.value as *mut u32, value as u32) as T;
        } else if sizeof(T) == 8 {
            return AtomicExchange64(&this.value as *mut u64, value as u64) as T;
        } else {
            AtomicStoreFence();
            let old = this.value;
            this.value = value;
            AtomicStoreFence();
            return old;
        }
    }

    pub fn CompareExchange(&mut this, expected: T, desired: T) -> bool {
        if sizeof(T) == 1 {
            return AtomicCompareExchangeBool8(&this.value as *mut u8, expected as u8, desired as u8);
        } else if sizeof(T) == 2 {
            return AtomicCompareExchangeBool16(&this.value as *mut i16, expected as i16, desired as i16);
        } else if sizeof(T) == 4 {
            return AtomicCompareExchangeBool32(&this.value as *mut u32, expected as u32, desired as u32);
        } else if sizeof(T) == 8 {
            return AtomicCompareExchangeBool64(&this.value as *mut u64, expected as u64, desired as u64);
        } else {
            AtomicMemoryFence();

            if this.value == expected {
                this.value = desired;
                AtomicMemoryFence();
                return true;
            } else {
                AtomicMemoryFence();
                return false;
            }
        }
    }

    pub fn operator==(&this, other: T) -> bool {
        return this.Load() == other;
    }

    pub fn operator!=(&this, other: T) -> bool {
        return this.Load() != other;
    }

    pub fn operator==(&this, other: &Atomic<T>) -> bool {
        return this.Load() == other.Load();
    }

    pub fn operator!=(&this, other: &Atomic<T>) -> bool {
        return this.Load() != other.Load();
    }

    pub fn operator=(&mut this, value: T) -> &mut Atomic<T> {
        this.Store(value);
        return this;
    }
}
