include "divio", "divstr", "divopt", "divres" : *;

func Divide(a: f64, b: f64) -> Result<f64, String> {
    if b == 0.0f64 {
        ret Result::Err(String("division by zero"));
    }

    ret Result::Ok(a / b);
}

func Find(haystack: *const i8, needle: i8) -> Option<u64> {
    let mut i: u64 = 0u64;

    while haystack[i] != '\0' {
        if haystack[i] == needle {
            ret Option::Some(i);
        } i += 1u64;
    }

    ret Option::None;
}

func main(argc: i32, argv[]: *const i8) -> i32 {
    let result: Result<f64, String> = Divide(10.0f64, 3.0f64);

    match result {
        Result::Ok(value) => printf("10 / 3 = %f\n", value),
        Result::Err(message) => printf("Error: %s\n", message.Data())
    }

    let error: Result<f64, String> = Divide(1.0f64, 0.0f64);

    match error {
        Result::Ok(value) => printf("Result: %f\n", value),
        Result::Err(message) => printf("Error: %s (expected)\n", message.Data())
    }

    let found: Option<u64> = Find("hello", 'l');

    match found {
        Option::Some(index) => printf("Found at index: %llu\n", index),
        Option::None => printf("Not found\n")
    }

    let missing: Option<u64> = Find("hello", 'z');

    if let Option::Some(index) = missing {
        printf("Found at: %llu\n", index);
    } else {
        printf("Not found (expected)\n");
    }

    ret 0i32;
}