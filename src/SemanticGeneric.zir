#[include "std/str", "std/vec", "std/map", "std/pair", "src/Mangler.zir",
    "src/SemanticScope.zir", "src/SemanticSymbol.zir", "src/SemanticValue.zir", "src/SemanticTypes.zir" : *]

class SemanticGeneric {
    cache: Map<String, Pair<SemanticValue, *mut SemanticScope>>,

    pub node: *Node,
    pub scope: *mut SemanticScope,
    pub _class: *SemanticType,

    pub name: String,
    pub type_names: Vector<String>,

    pub current: String,
    pub types: Vector<*SemanticType>;

    SemanticGeneric(&mut this, node: *Node) {
        (this.node, this.scope, this._class) = (node, analyzer->scope_manager.current, analyzer->current_class);
        analyzer->generics.PushBack(this);

        if node->_type == NodeType::CLASS {
            let _class = node as *ClassNode;
            (this.name, this.type_names) = (_class->name, _class->types);
        } else if node->_type == NodeType::STRUCTURE {
            let structure = node as *StructureNode;
            (this.name, this.type_names) = (structure->name, structure->types);
        } else if node->_type == NodeType::ENUMERATION {
            let enumeration = node as *EnumerationNode;
            (this.name, this.type_names) = (enumeration->name, enumeration->types);
        } else {
            let function = node as *FunctionNode;
            (this.name, this.type_names) = (function->name, function->types);
        }
    }

    pub fn Set(&mut this, value: SemanticValue) {
        if this.current.Empty() {
            Logger::Log("SemanticGeneric", "Not in a generic compilation!", LogSeverity::Fatal);
        }

        let scope = !value.Null() ? analyzer->scope_manager.current : null;
        this.cache[this.current] = Pair<SemanticValue, *mut SemanticScope>(value, scope);
        this.current = "";
    }

    pub fn Get(&mut this, types: &Vector<*SemanticType>) -> Pair<SemanticValue, *mut SemanticScope> {
        if !this.current.Empty() {
            Logger::Log("SemanticGeneric", "Nested generics are not supported!", LogSeverity::Fatal);
        }

        if types.Size() != this.type_names.Size() {
            Logger::Log("SemanticGeneric", "Generic type parameter count mismatch.", LogSeverity::Error);
            return Pair<SemanticValue, *mut SemanticScope>(SemanticValue(), null);
        }

        let (prev_mangling, prev_unsafe) = (analyzer->mangling, analyzer->_unsafe);
        let (prev_scope, prev_generic) = (analyzer->scope_manager.current, analyzer->current_generic);
        let (prev_class, prev_function) = (analyzer->current_class, analyzer->current_function);

        (analyzer->current_class, analyzer->current_function) = (this._class, null);
        (analyzer->scope_manager.current, analyzer->current_generic) = (this.scope, this);
        (analyzer->mangling, analyzer->_unsafe) = (true, false);
        let (mut name, mut first) = (this.name + '<', true);

        for _type in types {
            if !first {
                name += ", ";
            } else {
                first = false;
            }

            name += _type->ToString();
        } name += '>';

        if this.cache.Has(name) {
            (analyzer->current_class, analyzer->current_function) = (prev_class, prev_function);
            (analyzer->scope_manager.current, analyzer->current_generic) = (prev_scope, prev_generic);
            (analyzer->mangling, analyzer->_unsafe) = (prev_mangling, prev_unsafe);
            return this.cache[name];
        } else {
            this.current = name;
            this.types = types;
        }

        analyzer->scope_manager.PushScope(String("generic"), false);

        for i in 0..this.type_names.Size() {
            analyzer->scope_manager.Set(this.type_names[i], SemanticSymbolKind::Type, this.types[i], this.node);
        }

        let mut result: SemanticValue;

        if this.node->_type == NodeType::CLASS {
            result = SemanticValue(analyzer->AnalyzeClass(this.node as *ClassNode, this));
        } else if this.node->_type == NodeType::STRUCTURE {
            result = SemanticValue(analyzer->AnalyzeStructure(this.node as *StructureNode, this));
        } else if this.node->_type == NodeType::ENUMERATION {
            result = SemanticValue(analyzer->AnalyzeVariant(this.node as *EnumerationNode, this));
        } else {
            result = analyzer->AnalyzeFunction(this.node as *FunctionNode, this);
        }

        this.types.Clear();
        analyzer->scope_manager.PopScope();
        (analyzer->current_class, analyzer->current_function) = (prev_class, prev_function);
        (analyzer->scope_manager.current, analyzer->current_generic) = (prev_scope, prev_generic);
        (analyzer->mangling, analyzer->_unsafe) = (prev_mangling, prev_unsafe);
        return this.cache[name];
    }
}

#[include "src/SemanticAnalyzer.zir" : *]
