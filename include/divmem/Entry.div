include "divdef" : *;

extern "C" {
    func GetProcessHeap() -> *mut void;
    func HeapAlloc(hHeap: *mut void, dwFlags: u32, dwBytes: u64) -> *mut void;
    func HeapFree(hHeap: *mut void, dwFlags: u32, lpMem: *mut void) -> i32;

    func RtlCopyMemory(Destination: *mut void, Source: *const void, Length: u64);
    func RtlFillMemory(Destination: *mut void, Length: u64, Fill: u8);

    func malloc(size: size_t) -> *mut void {
        ret HeapAlloc(GetProcessHeap(), 0u32, size);
    }

    func free(ptr: *const void) {
        HeapFree(GetProcessHeap(), 0u32, ptr);
    }

    func memcpy(dst: *mut void, src: *const void, size: size_t) -> *mut void {
        RtlCopyMemory(dst, src, size);
        ret dst;
    }

    func memset(ptr: *mut void, value: i32, num: size_t) -> *mut void {
        RtlFillMemory(ptr, num, value as u8);
        ret ptr;
    }
}