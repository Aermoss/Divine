#[include "std/str", "std/vec", "std/map", "vendor/llvm",
    "src/Generic.zir", "src/Scope.zir", "src/Nodes.zir", "src/Logger.zir" : *]

class Field {
    pub initializer: *Node,
    pub public: bool,
    pub index: usize;

    Field(&mut this, initializer: *Node, public: bool, index: usize) {
        (this.initializer, this.public, this.index) = (initializer, public, index);
    }
}

class Method {
    pub name: String,
    pub value: LLVMValueRef,
    pub public: bool;

    Method(&mut this, name: String, value: LLVMValueRef, public: bool) {
        (this.name, this.value, this.public) = (name, value, public);
    }
}

class ParameterType {
    pub _type: *QualifiedType,
    pub byval: *QualifiedType = null,
    pub sret: *QualifiedType = null;

    ParameterType(&mut this, _type: *QualifiedType) {
        this._type = _type;
    }
}

class ReturnType {
    pub _type: *QualifiedType,
    pub sret: *QualifiedType = null;

    ReturnType(&mut this, _type: *QualifiedType) {
        this._type = _type;
    }
}

enum TypeKind: i32 {
    Void, Boolean, Character,
    Integer, IntegerLiteral, Float, FloatLiteral,
    Pointer, Reference, Array,
    Function, PackSpecializedFunction,
    Class, Enumeration, Variant
}

class QualifiedType {
    pub kind: TypeKind,
    pub name: String,

    pub width: u32 = 0,
    pub signed: bool = false,
    pub mutable: bool = false,
    pub length: usize = 0,

    pub value: LLVMTypeRef,
    pub pointee: *QualifiedType = null,

    pub pack_name: String,
    pub declaration: *FunctionNode = null,
    pub pack_generic: *mut Generic = null,
    pub pack_scope: *mut Scope = null,
    pub pack_generic_types: Vector<*QualifiedType>,

    pub constructed: Vector<*QualifiedType>,
    pub fields: Map<String, Pair<Field, *QualifiedType>>,
    pub methods: Vector<Pair<Method, *QualifiedType>>,

    pub variants: Vector<Pair<String, Vector<*QualifiedType>>>,
    pub variant_field_names: Vector<Vector<String>>,

    pub params: Vector<ParameterType>,
    pub return: ReturnType;

    QualifiedType(&mut this, kind: TypeKind, value: LLVMTypeRef) {
        (this.kind, this.value) = (kind, value);
    }

    pub func IsMutable(&this) -> bool { ret this.mutable; }
    pub func IsLiteral(&this) -> bool { ret this.kind == TypeKind::IntegerLiteral || this.kind == TypeKind::FloatLiteral; }
    pub func IsSigned(&this) -> bool { ret this.signed; }

    pub func IsVoid(&this) -> bool { ret this.kind == TypeKind::Void; }
    pub func IsBoolean(&this) -> bool { ret this.kind == TypeKind::Boolean; }
    pub func IsCharacter(&this) -> bool { ret this.kind == TypeKind::Character; }
    pub func IsInteger(&this) -> bool { ret this.kind == TypeKind::Integer || this.kind == TypeKind::IntegerLiteral; }
    pub func IsIntegerPointer(&this) -> bool { ret this.kind == TypeKind::Integer && this.width == 0; }
    pub func IsIntegerLiteral(&this) -> bool { ret this.kind == TypeKind::IntegerLiteral; }
    pub func IsFloat(&this) -> bool { ret this.kind == TypeKind::Float || this.kind == TypeKind::FloatLiteral; }
    pub func IsFloatLiteral(&this) -> bool { ret this.kind == TypeKind::FloatLiteral; }
    pub func IsPointer(&this) -> bool { ret this.kind == TypeKind::Pointer || this.kind == TypeKind::Reference; }
    pub func IsNullPointer(&this) -> bool { ret this.kind == TypeKind::Pointer && this.pointee->kind == TypeKind::Void; }
    pub func IsReference(&this) -> bool { ret this.kind == TypeKind::Reference; }
    pub func IsArray(&this) -> bool { ret this.kind == TypeKind::Array; }
    pub func IsFunction(&this) -> bool { ret this.kind == TypeKind::Function || this.kind == TypeKind::PackSpecializedFunction; }
    pub func IsPackSpecializedFunction(&this) -> bool { ret this.kind == TypeKind::PackSpecializedFunction; }
    pub func IsClass(&this) -> bool { ret this.kind == TypeKind::Class; }
    pub func IsEnumeration(&this) -> bool { ret this.kind == TypeKind::Enumeration; }
    pub func IsVariant(&this) -> bool { ret this.kind == TypeKind::Variant; }

    pub func IsTrivial(&this) -> bool {
        if this.IsBoolean() || this.IsCharacter() || this.IsInteger() || this.IsFloat() || this.IsPointer() || this.IsReference() {
            ret true;
        }

        if this.IsArray() {
            ret this.pointee->IsTrivial();
        }

        if this.IsFunction() {
            ret false;
        }

        if this.IsClass() {
            if !this.constructed.Empty() || !this.methods.Empty() {
                ret false;
            }

            for field in this.Fields() {
                if !field.right.right->IsTrivial() {
                    ret false;
                }
            } ret true;
        }

        if this.IsVariant() {
            if !this.methods.Empty() {
                ret false;
            }

            for variant in this.variants {
                for variant_field in variant.right {
                    if !variant_field->IsTrivial() {
                        ret false;
                    }
                }
            } ret true;
        } ret false;
    }

    pub func IsDerivedFrom(&this, other: &QualifiedType) -> bool {
        for field in other.Fields() {
            if field.left == this.name {
                ret true;
            }
        } ret false;
    }

    pub func IsCompatible(&this, other: &QualifiedType) -> bool {
        if this.IsPointer() && other.IsPointer() {
            if this.Pointee().IsVoid() || other.IsNullPointer() {
                ret true;
            } else if this.Pointee().IsClass() && other.Pointee().IsClass() {
                if this.Pointee().IsDerivedFrom(other.Pointee()) {
                    ret true;
                }
            }
        } ret this == other;
    }

    pub func IsMutabilityCompatible(&this, other: &QualifiedType) -> bool {
        let mut left: *QualifiedType = this;
        let mut right: *QualifiedType = other;

        while left->IsPointer() && right->IsPointer() {
            if left->IsMutable() && !right->IsMutable() && !right->IsNullPointer() {
                ret false;
            }

            (left, right) = (left->Pointee(), right->Pointee());
        } ret true;
    }

    pub func IsSame(&this, other: &QualifiedType) -> bool {
        let mut left: *QualifiedType = this;
        let mut right: *QualifiedType = other;

        while left->IsPointer() && right->IsPointer() {
            if left->IsMutable() != right->IsMutable() || left->IsReference() != right->IsReference() || right->IsNullPointer() {
                ret false;
            }

            (left, right) = (left->Pointee(), right->Pointee());
        } ret this == other;
    }

    pub func ScorePointer(&this, other: &QualifiedType, base: u64) -> u64 {
        let mut reference_mismatch = false;
        let mut mutability_mismatch = false;
        let mut left: *QualifiedType = this;
        let mut right: *QualifiedType = other;
        let mut score = base;

        while left->IsPointer() && right->IsPointer() {
            if left->IsMutable() && !right->IsMutable() && !right->IsNullPointer() {
                ret 0;
            }

            mutability_mismatch |= left->IsMutable() != right->IsMutable();
            reference_mismatch |= left->IsReference() != right->IsReference();
            (left, right) = (left->Pointee(), right->Pointee());
        }

        if reference_mismatch { score -= 10; }
        if mutability_mismatch { score -= 1; }
        ret score;
    }

    pub func ScoreParameter(&this, other: &QualifiedType) -> u64 {
        if other.IsLiteral() {
            if this.IsInteger() && other.IsInteger() {
                if this.width == other.width && this.signed == other.signed {
                    ret 100;
                } ret 1;
            } else if this.IsFloat() && other.IsFloat() {
                if this.width == other.width {
                    ret 100;
                } ret 1;
            } ret 0;
        }

        if this == other {
            ret this.ScorePointer(other, 100);
        }

        if this.IsReference() {
            let score = this.Pointee().ScoreParameter(other);
            if score != 0 { ret score - 3; }
        }

        if other.IsReference() {
            let score = this.ScoreParameter(other.Pointee());
            if score != 0 { ret score - 3; }
        }

        if this.IsPointer() && other.IsPointer() {
            if this.Pointee().IsVoid() || other.IsNullPointer() {
                ret this.ScorePointer(other, 30);
            } else if this.Pointee().IsClass() && other.Pointee().IsClass() {
                if this.Pointee().IsDerivedFrom(other.Pointee()) {
                    ret this.ScorePointer(other, 70);
                }
            }
        } ret 0;
    }

    pub func UnderlyingType(&this) -> &QualifiedType {
        if !this.IsEnumeration() {
            Logger::Log("QualifiedType", "Not an enumeration!", LogSeverity::Fatal);
        }

        if this.width == 0 {
            ret compiler->type_manager.IntegerPointer(this.signed);
        } else {
            ret compiler->type_manager.Integer(this.width, this.signed);
        }
    }

    pub func Value(&this) -> LLVMTypeRef {
        if this.value == null {
            Logger::Log("QualifiedType", "Null type!", LogSeverity::Fatal);
        } ret this.value;
    }

    pub func Pointee(&this) -> &QualifiedType {
        if !this.IsPointer() {
            Logger::Log("QualifiedType", "Not a pointer!", LogSeverity::Fatal);
        } else if this.pointee == null {
            Logger::Log("QualifiedType", "Null pointee!", LogSeverity::Fatal);
        } ret this.pointee;
    }

    pub func Width(&this) -> u32 {
        if !this.IsBoolean() && !this.IsCharacter() && !this.IsInteger() && !this.IsFloat() && !this.IsEnumeration() {
            Logger::Log("QualifiedType", "Not a boolean, character, integer, float, or enumeration!", LogSeverity::Fatal);
        } ret this.width == 0 ? LLVMPointerSize(compiler->target->layout) * 8 : this.width;
    }

    pub func Length(&this) -> usize {
        if !this.IsArray() {
            Logger::Log("QualifiedType", "Not an array!", LogSeverity::Fatal);
        } ret this.length;
    }

    pub func Element(&this) -> &QualifiedType {
        if !this.IsArray() {
            Logger::Log("QualifiedType", "Not an array!", LogSeverity::Fatal);
        } else if this.pointee == null {
            Logger::Log("QualifiedType", "Null pointee!", LogSeverity::Fatal);
        } ret this.pointee;
    }

    pub func Parameters(&this) -> &Vector<ParameterType> {
        if !this.IsFunction() {
            Logger::Log("QualifiedType", "Not a function!", LogSeverity::Fatal);
        } ret this.params;
    }

    pub func Return(&this) -> &ReturnType {
        if !this.IsFunction() {
            Logger::Log("QualifiedType", "Not a function!", LogSeverity::Fatal);
        } ret this.return;
    }

    pub func Fields(&this) -> &mut Map<String, Pair<Field, *QualifiedType>> {
        if !this.IsClass() {
            Logger::Log("QualifiedType", "Not a class!", LogSeverity::Fatal);
        }

        unsafe {
            ret (this as &mut QualifiedType).fields;
        }
    }

    pub func Methods(&this) -> &Vector<Pair<Method, *QualifiedType>> {
        if !this.IsClass() && !this.IsVariant() {
            Logger::Log("QualifiedType", "Not a class or variant!", LogSeverity::Fatal);
        } ret this.methods;
    }

    pub func Index(&this, name: &String) -> isize {
        for field in this.Fields() {
            if field.left == name {
                ret field.right.left.index as isize;
            }
        } ret -1;
    }

    pub func Has(&this, name: &String) -> bool {
        for method in this.Methods() {
            if method.left.name == name {
                if method.left.public {
                    ret true;
                }

                if compiler->_class != null {
                    if *compiler->_class == this {
                        ret true;
                    }
                }
            }
        } ret false;
    }

    pub func Has(&this, name: &String, params: &Vector<*QualifiedType>) -> bool {
        for method in this.Methods() {
            if method.left.name == name {
                let mut state = false;

                if compiler->_class != null {
                    state = *compiler->_class == this;
                }

                if method.left.public || state {
                    let _params = method.right->Pointee().Parameters();
                    let has_pack = method.right->Pointee().pack_name != "";
                    let offset: usize = _params[0].sret != null ? 2 : 1;
                    let mut _match = true;

                    if (!has_pack && params.Size() != _params.Size() - offset) || (has_pack && params.Size() < _params.Size() - offset) {
                        continue;
                    }

                    for j in 0..(_params.Size() - offset) {
                        let param_type = _params[j + offset];
                        let _type = param_type.byval != null ? param_type.byval : param_type._type;
                        let param_score = _type->ScoreParameter(*params[j]);

                        if param_score == 0 {
                            _match = false;
                            break;
                        }
                    }

                    if _match {
                        ret true;
                    }
                }
            }
        } ret false;
    }

    pub func Get(&this, name: &String, node: *Node) -> *Pair<Method, *QualifiedType> {
        let mut state = 0;

        for method in this.Methods() {
            if method.left.name == name {
                let mut _state = false;

                if compiler->_class != null {
                    _state = *compiler->_class == this;
                }

                if !method.left.public && !_state {
                    if state < 1 { state = 1; }
                } else {
                    ret &method;
                }
            }
        }

        if state == 0 {
            Logger::Log("Class '" + this.name + "' doesn't contain any member named '" + name + "'.", node, LogSeverity::Error);
            ret null;
        } else {
            Logger::Log("Function '" + name + "' is not accessible.", node, LogSeverity::Error);
            ret null;
        }
    }

    pub func Get(&this, name: &String, params: &Vector<*QualifiedType>, node: *Node) -> *Pair<Method, *QualifiedType> {
        let methods = this.Methods();
        let mut index: usize = 0;
        let mut best: u64 = 0;
        let mut state = 0;

        for i in 0..methods.Size() {
            if methods[i].left.name == name {
                let mut _state = false;

                if compiler->_class != null {
                    _state = *compiler->_class == this;
                }

                if !methods[i].left.public && !_state {
                    if state < 1 { state = 1; }
                } else {
                    let (mut _match, mut score: u64) = (true, 1);
                    let _params = methods[i].right->Pointee().Parameters();
                    let has_pack = methods[i].right->Pointee().pack_name != "";
                    let offset: usize = _params[0].sret != null ? 2 : 1;

                    if (!has_pack && params.Size() != _params.Size() - offset) || (has_pack && params.Size() < _params.Size() - offset) {
                        continue;
                    }

                    for j in 0..(_params.Size() - offset) {
                        let param_type = _params[j + offset];
                        let _type = param_type.byval != null ? param_type.byval : param_type._type;
                        let param_score = _type->ScoreParameter(*params[j]);

                        if param_score != 0 {
                            score += param_score;
                        } else {
                            _match = false;
                            break;
                        }
                    }

                    if !_match {
                        state = 2;
                    } else if score > best {
                        (index, best) = (i, score);
                    }
                }
            }
        }

        if best != 0 {
            ret methods[index];
        } else {
            if state == 0 {
                Logger::Log("Class '" + this.name + "' doesn't contain any member named '" + name + "'.", node, LogSeverity::Error);
                ret null;
            } else if state == 1 {
                Logger::Log("Function '" + name + "' is not accessible.", node, LogSeverity::Error);
                ret null;
            } else {
                Logger::Log("Invalid arguments for: '" + name + "'.", node, LogSeverity::Error);
                ret null;
            }
        }
    }

    pub func op==(&this, other: &QualifiedType) -> bool {
        if this.IsInteger() && other.IsInteger() {
            ret this.signed == other.signed && this.width == other.width;
        } else if this.IsFloat() && other.IsFloat() {
            ret this.width == other.width;
        } else if (this.IsPointer() || this.IsArray()) && (other.IsPointer() || other.IsArray()) {
            if this.pointee == other.pointee { ret true; }
            if this.pointee == null || other.pointee == null { ret false; }
            ret *this.pointee == *other.pointee;
        } else if this.IsFunction() && other.IsFunction() {
            if this.params.Size() != other.params.Size() {
                ret false;
            }

            for i in 0..this.params.Size() {
                let (left, right) = (this.params[i]._type, other.params[i]._type);

                if left != right {
                    if left == null || right == null { ret false; }
                    if *left != *right { ret false; }
                }
            }

            let (left, right) = (this.return._type, other.return._type);

            if left != right {
                if left == null || right == null { ret false; }
                if *left != *right { ret false; }
            } ret true;
        } else {
            ret this.kind == other.kind && this.name == other.name;
        }
    }

    pub func op!=(&this, other: &QualifiedType) -> bool {
        ret !(this == other);
    }

    pub func ToString(&this) -> String {
        if this.IsVoid() {
            ret "void".ToString();
        } else if this.IsBoolean() {
            ret "bool".ToString();
        } else if this.IsCharacter() {
            ret "char".ToString();
        } else if this.IsInteger() {
            if this.IsLiteral() {
                ret "(integer literal)".ToString();
            } else if this.width != 0 {
                ret (this.signed ? 'i' : 'u') + String::FromInteger(this.width as u64);
            } else {
                ret (this.signed ? "isize" : "usize").ToString();
            }
        } else if this.IsFloat() {
            if this.IsLiteral() {
                ret "(float literal)".ToString();
            } else {
                ret 'f' + String::FromInteger(this.width as u64);
            }
        } else if this.IsPointer() {
            if this.IsReference() {
                ret (this.mutable ? "&mut " : "&") + this.pointee->ToString();
            } else {
                ret (this.mutable ? "*mut " : "*") + this.pointee->ToString();
            }
        } else if this.IsArray() {
            ret '(' + this.pointee->ToString() + ")[" + String::FromInteger(this.length as u64) + ']';
        } else if this.IsFunction() {
            let mut result = "func(".ToString();

            for param in this.params {
                result += param._type->ToString();
            } result += ')';

            if this.return._type->kind != TypeKind::Void {
                result += " -> " + this.return._type->ToString();
            } ret result;
        } else {
            ret this.name;
        }
    }
}
