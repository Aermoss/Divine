include "divio", "divwin", "divfile", "divstd", "divllvm", "lexer.div", "preprocessor.div", "parser.div", "compiler.div" : *;

class Timer {
    priv frequency: LARGE_INTEGER,
    priv counter: LARGE_INTEGER
} impl {
    Timer(this: &Timer) {
        QueryPerformanceFrequency(&this.frequency);
    }

    ~Timer(this: &Timer) {}

    pub Get(this: &Timer) -> f64 {
        QueryPerformanceCounter(&this.counter);
        ret (this.counter as f64) / (this.frequency as f64);
    }
};

func Execute(command: *const i8, output: bool) -> DWORD {
    let mut startup_info: STARTUPINFOA;
    memset(&startup_info as *const void, 0i32, sizeof(startup_info));
    startup_info.cb = sizeof(startup_info) as DWORD;
    let process_info: PROCESS_INFORMATION;

    if output != true {
        (startup_info.hStdOutput, startup_info.hStdError, startup_info.hStdInput) = (null, null, null);
        startup_info.dwFlags |= STARTF_USESTDHANDLES;
    }

    if CreateProcessA(null, command, null, null, 0i32, 0u32, null, null, &startup_info, &process_info) == 0i32 {
        printf("\x1b[31mFailed to create process: %lu.\x1b[0m\n", GetLastError());
        exit(1i32);
    }

    let exit_code: DWORD;
    WaitForSingleObject(process_info.hProcess, INFINITE);

    if GetExitCodeProcess(process_info.hProcess, &exit_code) == 0i32 {
        printf("\x1b[31mFailed to get process exit code: %lu.\x1b[0m\n", GetLastError());
    }

    CloseHandle(process_info.hProcess);
    CloseHandle(process_info.hThread);
    ret exit_code;
}

func GetWindowsSDKPath() -> String {
    let search_path[MAX_PATH]: i8;
    let mut path: String = "C:\\Program Files (x86)\\Windows Kits\\10\\Lib";
    sprintf(search_path, "%s\\*", path.Data());

    let find_data: WIN32_FIND_DATAA;
    let find_handle: HANDLE = FindFirstFileA(search_path, &find_data);

    if find_handle == INVALID_HANDLE_VALUE {
        printf("\x1b[31mFailed to find Windows SDK path.\x1b[0m\n");
        exit(1i32);
    }

    let mut highest_version_string: String = "";
    let (mut highest_v1: u64, mut highest_v2: u64) = (0u64, 0u64);
    let (mut highest_v3: u64, mut highest_v4: u64) = (0u64, 0u64);

    loop {
        if (find_data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0u32 {
            if strcmp(find_data.cFileName, ".") != 0i32 && strcmp(find_data.cFileName, "..") != 0i32 && strcmp(find_data.cFileName, "wdf") != 0i32 {
                let (parsed_v1: u64, parsed_v2: u64, parsed_v3: u64, parsed_v4: u64) = (0u64, 0u64, 0u64, 0u64);
                sscanf(find_data.cFileName, "%llu.%llu.%llu.%llu", &parsed_v1, &parsed_v2, &parsed_v3, &parsed_v4);

                if parsed_v1 > highest_v1 || (parsed_v1 == highest_v1 && parsed_v2 > highest_v2) || (parsed_v1 == highest_v1 && parsed_v2 == highest_v2 && parsed_v3 > highest_v3) || (parsed_v1 == highest_v1 && parsed_v2 == highest_v2 && parsed_v3 == highest_v3 && parsed_v4 > highest_v4) {
                    (highest_version_string, highest_v1, highest_v2, highest_v3, highest_v4) = (find_data.cFileName, parsed_v1, parsed_v2, parsed_v3, parsed_v4);
                }
            }
        }

        if FindNextFileA(find_handle, &find_data) == 0i32 {
            break;
        }
    }

    if highest_version_string != "" {
        path += "\\";
        path += highest_version_string;
    } else {
        printf("\x1b[31mFailed to find a valid Windows SDK version.\x1b[0m\n");
        exit(1i32);
    }

    FindClose(find_handle);
    ret path;
}

func GetMSVCPath() -> String {
    let search_path[MAX_PATH]: i8;
    let mut path: String = "C:\\Program Files\\Microsoft Visual Studio";
    sprintf(search_path, "%s\\*", path.Data());

    let find_data: WIN32_FIND_DATAA;
    let find_handle: HANDLE = FindFirstFileA(search_path, &find_data);

    if find_handle == INVALID_HANDLE_VALUE {
        printf("\x1b[31mFailed to find Visual Studio path.\x1b[0m\n");
        exit(1i32);
    }

    let mut highest_version_string: String = "";
    let mut highest_version: u64 = 0u64;

    loop {
        if (find_data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0u32 {
            if strcmp(find_data.cFileName, ".") != 0i32 && strcmp(find_data.cFileName, "..") != 0i32 {
                let mut parsed_version: u64 = 0u64;
                sscanf(find_data.cFileName, "%llu", &parsed_version);
                let mut normalized_version: u64;

                if parsed_version == 2017u64 { normalized_version = 15u64; }
                else if parsed_version == 2019u64 { normalized_version = 16u64; }
                else if parsed_version == 2022u64 { normalized_version = 17u64; }
                else { normalized_version = parsed_version; }

                if normalized_version > highest_version {
                    (highest_version_string, highest_version) = (find_data.cFileName, normalized_version);
                }
            }
        }

        if FindNextFileA(find_handle, &find_data) == 0i32 {
            break;
        }
    }

    if highest_version_string != "" {
        path += "\\";
        path += highest_version_string;
    } else {
        printf("\x1b[31mFailed to find a valid Visual Studio version.\x1b[0m\n");
        exit(1i32);
    }

    FindClose(find_handle);
    let search_path2[MAX_PATH]: i8;
    sprintf(search_path2, "%s\\*", path.Data());

    let find_data2: WIN32_FIND_DATAA;
    let find_handle2: HANDLE = FindFirstFileA(search_path2, &find_data2);

    if find_handle2 == INVALID_HANDLE_VALUE {
        printf("\x1b[31mFailed to find Visual Studio path.\x1b[0m\n");
        exit(1i32);
    }

    loop {
        if (find_data2.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0u32 {
            if strcmp(find_data2.cFileName, ".") != 0i32 && strcmp(find_data2.cFileName, "..") != 0i32 {
                path += "\\";
                path += find_data2.cFileName;
                path += "\\VC\\Tools\\MSVC";
                break;
            }
        }

        if FindNextFileA(find_handle2, &find_data2) == 0i32 {
            break;
        }
    }

    FindClose(find_handle2);
    let search_path3[MAX_PATH]: i8;
    sprintf(search_path3, "%s\\*", path.Data());

    let find_data3: WIN32_FIND_DATAA;
    let find_handle3: HANDLE = FindFirstFileA(search_path3, &find_data3);

    if find_handle3 == INVALID_HANDLE_VALUE {
        printf("\x1b[31mFailed to find MSVC path.\x1b[0m\n");
        exit(1i32);
    }

    let mut highest_version_string2: String = "";
    let (mut highest_v1: u64, mut highest_v2: u64) = (0u64, 0u64);
    let (mut highest_v3: u64, mut highest_v4: u64) = (0u64, 0u64);

    loop {
        if (find_data3.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0u32 {
            if strcmp(find_data3.cFileName, ".") != 0i32 && strcmp(find_data3.cFileName, "..") != 0i32 {
                let (mut parsed_v1: u64, mut parsed_v2: u64, mut parsed_v3: u64) = (0u64, 0u64, 0u64);
                sscanf(find_data3.cFileName, "%llu.%llu.%llu", &parsed_v1, &parsed_v2, &parsed_v3);

                if parsed_v1 > highest_v1 || (parsed_v1 == highest_v1 && parsed_v2 > highest_v2) || (parsed_v1 == highest_v1 && parsed_v2 == highest_v2 && parsed_v3 > highest_v3) {
                    (highest_version_string2, highest_v1, highest_v2, highest_v3) = (find_data3.cFileName, parsed_v1, parsed_v2, parsed_v3);
                }
            }
        }

        if FindNextFileA(find_handle3, &find_data3) == 0i32 {
            break;
        }
    }

    if highest_version_string2 != "" {
        path += "\\";
        path += highest_version_string2;
    } else {
        printf("\x1b[31mFailed to find a valid MSVC version.\x1b[0m\n");
        exit(1i32);
    }

    FindClose(find_handle3);
    ret path;
}

func PrintVersion(executable: String) {
    printf("Unversioned build of %s (%s).\n", executable.Data(), LLVMGetDefaultTargetTriple());
    printf("Copyright (c) 2025-2026 Yusuf Rençber. All rights reserved.\n");
    printf("This software is licensed under the Apache License, Version 2.0.\n");
    printf("See the LICENSE file in the project root for more information.\n");
}

func PrintUsage(executable: String) {
    printf("OVERVIEW: Divine compiler\n\n");
    printf("USAGE: %s [options] <inputs>\n\n", executable.Data());
    printf("OPTIONS:\n");
    printf("  -o <file>                Write output to <file>\n");
    printf("  -I <dir>                 Add directory to include search path\n");
    printf("  -L <dir>                 Add directory to library search path\n");
    printf("  -l <name>                Link against library <name>\n");
    printf("  -D <macro>[=<value>]     Define a macro\n");
    printf("  -O<level>, -O            Optimization level (0, 1, 2, 3) [-O defaults to -O2]\n");
    printf("  -g, --debug              Enable debug information\n");
    printf("  -c                       Emit object code (.obj) alongside the executable\n");
    printf("  -S                       Emit assembly code (.s) alongside the executable\n");
    printf("  -emit-llvm               Emit LLVM IR (.ll) alongside the executable\n");
    printf("  -target <triple>         Generate code for the given target\n");
    printf("  -march <arch>            Architecture to generate code for\n");
    printf("  -r, --run                Run the program after compiling\n");
    printf("  -v, --verbose            Show verbose output\n");
    printf("  --version                Display compiler version\n");
    printf("  -h, --help               Display this help message\n");
}

func ErrorHandler(reason: *const i8) {
    printf("\x1b[31mLLVM: Fatal Error: %s\x1b[0m\n", reason);
    exit(1i32);
}

func main(argc: i32, argv[]: *const i8) -> i32 {
    LLVMEnablePrettyStackTrace();
    LLVMInstallFatalErrorHandler(ErrorHandler);

    let executable: String = SplitPath(String(argv[0u64])).right;

    if argc < 2i32 {
        PrintUsage(executable);
        ret 1i32;
    }

    let (mut input_files: Vector<String>, mut output_file: String);
    let (mut include_paths: Vector<String>, mut lib_paths: Vector<String>);
    let (mut defines: Vector<String>, mut libs: Vector<String>);

    include_paths.PushBack(String("."));
    include_paths.PushBack(String("include"));

#[if WINDOWS]
    defines.PushBack(String("WINDOWS"));
#[endif]

    let mut opt_level: LLVMCodeGenOptLevel = LLVMCodeGenOptLevel::LLVMCodeGenLevelDefault;
    let (mut triple: String, mut march: String) = (LLVMGetDefaultTargetTriple(), "generic");
    let (mut emit_object: bool, mut emit_asm: bool, mut emit_llvm: bool) = (false, false, false);
    let (mut run: bool, mut debug: bool, mut verbose: bool) = (false, false, false);
    let mut i: i32 = 1i32;

    while i < argc {
        let arg: String = argv[i as u64];

        if arg == "--help" || arg == "-h" {
            PrintUsage(executable);
            ret 0i32;
        } else if arg == "--version" {
            PrintVersion(executable);
            ret 0i32;
        } else if arg == "-v" || arg == "--verbose" {
            verbose = true;
        } else if arg == "-g" || arg == "--debug" {
            debug = true;
        } else if arg == "-c" {
            emit_object = true;
        } else if arg == "-S" {
            emit_asm = true;
        } else if arg == "-emit-llvm" {
            emit_llvm = true;
        } else if arg == "-r" || arg == "--run" {
            run = true;
        } else if arg == "-O0" {
            opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelNone;
        } else if arg == "-O1" {
            opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelLess;
        } else if arg == "-O2" || arg == "-O" {
            opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelDefault;
        } else if arg == "-O3" {
            opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelAggressive;
        } else if arg == "-o" {
            i += 1i32;

            if i < argc {
                output_file = argv[i as u64];
            } else {
                printf("%s: \x1b[31mError:\x1b[0m Missing argument to '-o'.\n", executable.Data());
                ret 1i32;
            }
        } else if arg.StartsWith("-I") {
            let mut path: String = arg.SubString(2u64);

            if path.Empty() {
                i += 1i32;

                if i < argc {
                    path = argv[i as u64];
                } else {
                    printf("%s: \x1b[31mError:\x1b[0m Missing argument to '-I'.\n", executable.Data());
                    ret 1i32;
                }
            }

            include_paths.PushBack(path);
        } else if arg.StartsWith("-L") {
            let mut path: String = arg.SubString(2u64);

            if path.Empty() {
                i += 1i32;

                if i < argc {
                    path = argv[i as u64];
                } else {
                    printf("%s: \x1b[31mError:\x1b[0m Missing argument to '-L'.\n", executable.Data());
                    ret 1i32;
                }
            }

            lib_paths.PushBack(path);
        } else if arg.StartsWith("-l") {
            let mut name: String = arg.SubString(2u64);

            if name.Empty() {
                i += 1i32;

                if i < argc {
                    name = argv[i as u64];
                } else {
                    printf("%s: \x1b[31mError:\x1b[0m Missing argument to '-l'.\n", executable.Data());
                    ret 1i32;
                }
            }

            libs.PushBack(name);
        } else if arg.StartsWith("-D") {
            let mut define: String = arg.SubString(2u64);

            if define.Empty() {
                i += 1i32;

                if i < argc {
                    define = argv[i as u64];
                } else {
                    printf("%s: \x1b[31mError:\x1b[0m Missing argument to '-D'.\n", executable.Data());
                    ret 1i32;
                }
            }

            defines.PushBack(define);
        } else if arg == "-target" {
            i += 1i32;

            if i < argc {
                triple = argv[i as u64];
            } else {
                printf("%s: \x1b[31mError:\x1b[0m Missing argument to '-target'.\n", executable.Data());
                ret 1i32;
            }
        } else if arg == "-march" {
            i += 1i32;

            if i < argc {
                march = argv[i as u64];
            } else {
                printf("%s: \x1b[31mError:\x1b[0m Missing argument to '-march'.\n", executable.Data());
                ret 1i32;
            }
        } else if arg.StartsWith("-") {
            printf("%s: \x1b[31mError:\x1b[0m Unknown option '%s'.\n", executable.Data(), arg.Data());
            ret 1i32;
        } else {
            input_files.PushBack(arg);
        } i += 1i32;
    }

    if input_files.Empty() {
        printf("%s: \x1b[31mError:\x1b[0m No input files.\n", executable.Data());
        ret 1i32;
    }

    let timer: Timer;
    let start: f64 = timer.Get();

    let mut objects: Vector<String>;
    let temp_path: String = GetTemporaryPath();
    let mut j: u64 = 0u64;

    while j < input_files.Size() {
        let input_file: String = input_files[j];
        if verbose { printf("Compiling: %s\n", input_file.Data()); }
        let source: String = ReadFile(input_file);

        let mut lexer: Lexer;
        let mut preprocessor: Preprocessor;
        preprocessor.defines = defines;

        let mut tokens: Vector<Token> = lexer.Lex(source, input_file);
        tokens = preprocessor.Process(tokens, input_file);

        let mut parser: Parser;
        (parser.defines, parser.include_paths) = (defines, include_paths);
        let ast: *const RootNode = parser.Parse(tokens, input_file);

        let mut compiler: Compiler = { triple, march, opt_level };
        let module: LLVMModuleRef = compiler.Compile(ast, input_file);
        let name: String = SplitExtension(input_file).left;

        if opt_level != LLVMCodeGenOptLevel::LLVMCodeGenLevelNone {
            let mut passes: String;

            if opt_level == LLVMCodeGenOptLevel::LLVMCodeGenLevelLess {
                printf("%s: \x1b[35mWarning:\x1b[0m Optimizing at less level which may break your program in this version. (\x1b[36m-O1\x1b[0m)\n", input_file.Data());
                passes = "default<O1>";
            } else if opt_level == LLVMCodeGenOptLevel::LLVMCodeGenLevelDefault {
                printf("%s: \x1b[35mWarning:\x1b[0m Optimizing at default level which may break your program in this version. (\x1b[36m-O2\x1b[0m)\n", input_file.Data());
                passes = "default<O2>";
            } else if opt_level == LLVMCodeGenOptLevel::LLVMCodeGenLevelAggressive {
                printf("%s: \x1b[35mWarning:\x1b[0m Optimizing at aggressive level which may break your program in this version. (\x1b[36m-O3\x1b[0m)\n", input_file.Data());
                passes = "default<O3>";
            } else {
                printf("%s: \x1b[31mError:\x1b[0m Failed to optimize module, unknown optimization level. (\x1b[36m-O%d\x1b[0m)\n", input_file.Data(), opt_level);
                ret 1i32;
            }

            if passes.Size() > 1u64 {
                let pass_options: LLVMPassBuilderOptionsRef = LLVMCreatePassBuilderOptions();
                let error: LLVMErrorRef = LLVMRunPasses(module, passes.Data(), compiler.target_machine, pass_options);
                LLVMDisposePassBuilderOptions(pass_options);

                if error != LLVMErrorSuccess {
                    let message: *const i8 = LLVMGetErrorMessage(error);
                    printf("%s: \x1b[31mError:\x1b[0m Failed to optimize module: %s\n", input_file.Data(), message);
                    LLVMDisposeErrorMessage(message);
                    ret 1i32;
                }
            }
        }

        if emit_llvm {
            let string: *const i8 = LLVMPrintModuleToString(module);
            WriteFile(name + ".ll", String(string));
            LLVMDisposeMessage(string);
        }

        if emit_asm {
            let message: *const i8 = null;

            if LLVMTargetMachineEmitToFile(compiler.target_machine, module, (name + ".s").Data(), LLVMCodeGenFileType::LLVMAssemblyFile, &message) != 0i32 {
                printf("%s: \x1b[31mError:\x1b[0m Failed to emit assembly: %s\n", input_file.Data(), message);
                LLVMDisposeMessage(message);
                ret 1i32;
            }

            LLVMDisposeMessage(message);
        }

        let message: *const i8 = null;
        let mut object_name: String = name + ".obj";

        if !emit_object {
            object_name = JoinPath(temp_path, SplitPath(object_name).right);
        }

        if LLVMTargetMachineEmitToFile(compiler.target_machine, module, object_name.Data(), LLVMCodeGenFileType::LLVMObjectFile, &message) != 0i32 {
            printf("%s: \x1b[31mError:\x1b[0m Failed to emit object: %s\n", input_file.Data(), message);
            LLVMDisposeMessage(message);
            ret 1i32;
        }

        LLVMDisposeMessage(message);
        objects.PushBack(object_name);
        j += 1u64;
    }

    let (sdk_path: String, msvc_path: String) = (GetWindowsSDKPath(), GetMSVCPath());
    let mut command: String = String("\"") + msvc_path + "\\bin\\Hostx64\\x64\\link.exe\" /NOLOGO";
    if debug { command += " /DEBUG"; }

    let mut final_output: String;
    if output_file.Size() > 1u64 { final_output = output_file; }
    else { final_output = SplitExtension(input_files[0u64]).left + ".exe"; }
    command += String(" /OUT:") + final_output;
    let mut k: u64 = 0u64;

    while k < objects.Size() {
        command += String(" ") + objects[k];
        k += 1u64;
    } k = 0u64;

    command += String(" \"/LIBPATH:") + msvc_path + "\\lib\\x64\"";
    command += String(" \"/LIBPATH:") + sdk_path + "\\um\\x64\"";
    command += String(" \"/LIBPATH:") + sdk_path + "\\ucrt\\x64\"";

    while k < lib_paths.Size() {
        command += String(" \"/LIBPATH:") + lib_paths[k] + "\"";
        k += 1u64;
    } k = 0u64;

    command += " legacy_stdio_definitions.lib ucrt.lib vcruntime.lib msvcrt.lib user32.lib kernel32.lib";

    while k < libs.Size() {
        command += String(" ") + libs[k] + ".lib";
        k += 1u64;
    } k = 0u64;

    if verbose { printf("Link: %s\n", command.Data()); }
    Execute(command.Data(), true);
    printf("Program compiled in %f seconds.\n", timer.Get() - start);

    if !emit_object {
        while k < objects.Size() {
            RemoveFile(objects[k]);
            k += 1u64;
        }
    }

    if run {
        printf("Program finished with exit code: %d.\n", Execute(final_output.Data(), true));
    } ret 0i32;
}