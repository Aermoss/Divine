#[include "std/str", "std/vec", "std/map", "src/Types.zir" : *]

class Mangler {
    pub fn IsMangled(name: &String) -> bool {
        return name.StartsWith("$z");
    }

    fn MangleType(_type: *SemanticType) -> String {
        let mut result = String();

        if _type->IsMutable() {
            result += 'M';
        }

        if _type->IsVoid() {
            result += 'v';
        } else if _type->IsBoolean() {
            result += 'b';
        } else if _type->IsCharacter() {
            result += 'c';
        } else if _type->IsInteger() {
            result += (_type->IsSigned() ? 'i' : 'u') + String::FromInteger(_type->Width() as u64);
        } else if _type->IsFloat() {
            result += 'f' + String::FromInteger(_type->Width() as u64);
        } else if _type->IsPointer() {
            result += (_type->IsReference() ? 'R' : 'P') + Mangler::MangleType(_type->Pointee());
        } else if _type->IsFunction() {
            result += 'F';
            result += Mangler::MangleType(_type->Return());

            for param in _type->Parameters() {
                result += Mangler::MangleType(param);
            }
        } else if _type->IsClass() || _type->IsStructure() || _type->IsEnumeration() ||  _type->IsVariant() {
            let mut name = _type->name;

            if Mangler::IsMangled(name) {
                let (mut start: usize, mut end) = (2, name.Length() - 1);

                while name[start] == 'N' && name[end] == 'E' {
                    (start, end) = (start + 1, end - 1);
                }

                name = name.SubString(start, end - start + 1);
            } result += name;
        } else {
            Logger::Log("Mangler", "Unknown type '" + _type->ToString() + "'.", LogSeverity::Error);
        } return result;
    }

    fn MangleTypeSubstituted(_type: *SemanticType, substitution_table: &mut Map<*SemanticType, String>) -> String {
        for i in 0..substitution_table.Size() {
            let pair = substitution_table[i];

            if *_type == *pair.left {
                let mut left = _type;
                let mut right = pair.left;
                let mut equal = true;

                while left->IsPointer() {
                    if left->IsMutable() != right->IsMutable() { equal = false; }
                    (left, right) = (left->Pointee(), right->Pointee());
                }

                if equal {
                    return "S" + String::FromInteger(i as u64) + "_";
                }
            }
        }

        let result = Mangler::MangleType(_type);

        if result.Length() >= String::FromInteger(substitution_table.Size() as u64).Length() + 2 {
            substitution_table[_type] = result;
        } return result;
    }

    fn MangleName(name: &String, mut names: Vector<String>) -> String {
        let mut result = "$z".ToString();
        names.PushBack(name);

        let mut has_namespace = false;
        let mut name_result = String();

        for name in names {
            if Mangler::IsMangled(name) {
                let (mut start: usize, mut end) = (2, name.Length() - 1);

                while name[start] == 'N' && name[end] == 'E' {
                    (start, end) = (start + 1, end - 1);
                }

                name_result += name.SubString(start, end - start + 1);
                has_namespace = true;
            } else {
                name_result += String::FromInteger(name.Length() as u64) + name;
            }
        }

        if names.Size() > 1 || has_namespace {
            result += "N";
        }

        result += name_result;

        if names.Size() > 1 || has_namespace {
            result += "E";
        } return result;
    }

    pub fn MangleFunction(name: &String, _type: *SemanticType, types: &Vector<*SemanticType>, mut names: Vector<String>) -> String {
        let mut result = "$z".ToString();
        names.PushBack(name);

        let mut has_namespace = false;
        let mut name_result = String();

        for name in names {
            if Mangler::IsMangled(name) {
                let (mut start: usize, mut end) = (2, name.Length() - 1);

                while name[start] == 'N' && name[end] == 'E' {
                    (start, end) = (start + 1, end - 1);
                }

                name_result += name.SubString(start, end - start + 1);
                has_namespace = true;
            } else {
                name_result += String::FromInteger(name.Length() as u64) + name;
            }
        }

        if names.Size() > 1 || !types.Empty() || has_namespace {
            result += "N";
        }

        result += name_result;

        if !types.Empty() {
            result += "I";

            for _type in types {
                result += Mangler::MangleType(_type);
            } result += "E";
        }

        if names.Size() > 1 || !types.Empty() || has_namespace {
            result += "E";
        }

        let mut substitution_table = Map<*SemanticType, String>();

        for param in _type->Parameters() {
            result += Mangler::MangleTypeSubstituted(param, substitution_table);
        } return result;
    }

    pub fn MangleClass(name: &String, types: &Vector<*SemanticType>, mut names: Vector<String>) -> String {
        let mut result = "$z".ToString();
        names.PushBack(name);

        let mut has_namespace = false;
        let mut name_result = String();

        for name in names {
            if Mangler::IsMangled(name) {
                let (mut start: usize, mut end) = (2, name.Length() - 1);

                while name[start] == 'N' && name[end] == 'E' {
                    (start, end) = (start + 1, end - 1);
                }

                name_result += name.SubString(start, end - start + 1);
                has_namespace = true;
            } else {
                name_result += String::FromInteger(name.Length() as u64) + name;
            }
        }

        if names.Size() > 1 || !types.Empty() || has_namespace {
            result += "N";
        }

        result += name_result;

        if !types.Empty() {
            result += "I";

            for _type in types {
                result += Mangler::MangleType(_type);
            } result += "E";
        }

        if names.Size() > 1 || !types.Empty() || has_namespace {
            result += "E";
        } return result;
    }
}
