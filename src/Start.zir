include "std/io", "std/std", "std/str", "std/vec" : *;

#[if WINDOWS]
extern "C" {
    func GetCommandLineA() -> *mut i8;

    func _start() {
        let raw_cmd: *mut i8 = GetCommandLineA();
        let mut args: Vector<String>;
        let mut ptr: *mut i8 = raw_cmd;
        let mut start_ptr: *mut i8 = raw_cmd;
        let mut in_arg: bool = false;
        let mut in_quotes: bool = false;

        while ptr[0u64] != 0i8 {
            let character: i8 = ptr[0u64];

            if character == '\"' {
                in_quotes = !in_quotes;

                if !in_arg {
                    in_arg = true;
                    start_ptr = (ptr as u64 + 1u64) as *mut i8;
                } ptr[0u64] = '\0';
            } else if character == ' ' && !in_quotes {
                if in_arg {
                    in_arg = false;
                    ptr[0u64] = '\0';
                    args.PushBack(String(start_ptr));
                }
            } else if !in_arg {
                in_arg = true;
                start_ptr = ptr;
            }

            ptr = (ptr as u64 + 1u64) as *mut i8;
        }

        if in_arg {
            args.PushBack(String(start_ptr));
        }

        Exit(main(args));
    }

    static mut _fltused: i32 = 0i32;
}
#[else]
extern "C" {
    func _bootstrap(argc: i64, argv[]: *const i8) {
        let mut args: Vector<String>;
        let mut i: i64 = 0i64;

        while i < argc {
            args.PushBack(argv[i as u64].ToString());
            i += 1i64;
        }

        Exit(main(args));
    }
}

asm {
    .globl _start

_start:
    xorq %rbp, %rbp
    popq %rdi
    movq %rsp, %rsi
    andq $-16, %rsp
    call _bootstrap
};
#[endif]
