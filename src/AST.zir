    ASTVariable(&mut this, name: String, _type: *ASTNode, initializer: *ASTNode, mutable: bool, start: Token) : ASTNode(ASTNodeKind::VARIABLE, start) {
        (this.name, this._type, this.initializer, this.mutable) = (name, _type, initializer, mutable);
    }
}

class ASTAssignment : ASTNode {
