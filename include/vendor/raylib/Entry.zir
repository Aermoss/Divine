    CUBEMAP_LAYOUT_CROSS_THREE_BY_FOUR,
    CUBEMAP_LAYOUT_CROSS_FOUR_BY_THREE
}

enum FontType: i32 {
    FONT_DEFAULT = 0,
    FONT_BITMAP,
    FONT_SDF
}

