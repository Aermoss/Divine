#[include "std/str", "src/SemanticTypes.zir" : *]

enum ValueCategory: u8 {
    Place, Value
}

class SemanticValue {
    _type: *SemanticType = null,
    category: ValueCategory = ValueCategory::Value,
    mutable: bool = false;

    SemanticValue(&mut this) {}

    SemanticValue(&mut this, _type: *SemanticType) {
        this._type = _type;
    }

    SemanticValue(&mut this, _type: *SemanticType, category: ValueCategory, mutable: bool) {
        (this._type, this.category, this.mutable) = (_type, category, mutable);
    }

    SemanticValue(&mut this, _type: *SemanticType, category: ValueCategory) {
        (this._type, this.category) = (_type, category);
    }

    pub fn Null(&this) -> bool {
        return this._type == null;
    }

    pub fn Type(&this) -> &SemanticType {
        if this.Null() {
            Logger::Log("SemanticValue", "Null type!", LogSeverity::Fatal);
        } return this._type;
    }

    pub fn IsPlace(&this) -> bool { return this.category == ValueCategory::Place; }
    pub fn IsValue(&this) -> bool { return this.category == ValueCategory::Value; }

    pub fn WithCategory(&this, category: ValueCategory) -> SemanticValue {
        return SemanticValue(this._type, category, this.mutable);
    }

    pub fn WithCategoryAndMutability(&this, category: ValueCategory, mutable: bool) -> SemanticValue {
        return SemanticValue(this._type, category, mutable);
    }

    pub fn WithMutability(&this, mutable: bool) -> SemanticValue {
        return SemanticValue(this._type, this.category, mutable);
    }

    pub fn Materialize(&this, target: &SemanticType) -> SemanticValue {
        if this.Null() {
            return this;
        }

        if this.Type().IsInteger() && this.Type().IsLiteral() && target.IsPointer() {
            if !(target.IsReference() && target.Pointee().IsInteger()) {
                return SemanticValue(analyzer->type_manager.IntegerPointer(false));
            }
        }

        if this.Type().IsLiteral() {
            if this.Type().IsInteger() {
                if !target.IsInteger() {
                    return SemanticValue(analyzer->type_manager.Integer(32, true));
                } else {
                    return SemanticValue(target);
                }
            } else if !target.IsFloat() {
                return SemanticValue(analyzer->type_manager.Float(64));
            } else {
                return SemanticValue(target);
            }
        } return this;
    }

    pub fn Materialize(&this) -> SemanticValue {
        if !this.Null() && this.Type().IsLiteral() {
            return SemanticValue(this.Type().IsInteger() ? analyzer->type_manager.Integer(32, true) : analyzer->type_manager.Float(64));
        } return this;
    }

    pub fn Dereference(&this) -> SemanticValue {
        if !this.Null() && this.Type().IsReference() {
            return SemanticValue(this.Type().Pointee());
        } return this;
    }
}

#[include "src/SemanticAnalyzer.zir" : *]
