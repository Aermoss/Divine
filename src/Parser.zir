#[include "std/str", "std/vec", "std/map", "std/pair", "std/arena",
    "src/Logger.zir", "src/Lexer.zir", "src/Preprocessor.zir", "src/AST.zir" : *]

class Parser {
    arena: Arena,
    tokens: Vector<Token>,
    index: usize;

    fn Current(&this) -> Token {
        if this.index >= this.tokens.Size() {
            return this.tokens[this.tokens.Size() - 1];
        } else {
            return this.tokens[this.index];
        }
    }

    fn Peek(&this, offset: usize) -> Token {
        let index = this.index + offset;

        if index >= this.tokens.Size() {
            return this.tokens[this.tokens.Size() - 1];
        } else {
            return this.tokens[index];
        }
    }

    fn PeekBack(&this, offset: usize) -> Token {
        if offset > this.index {
            return this.tokens[0];
        } else {
            return this.tokens[this.index - offset];
        }
    }

    fn Advance(&mut this) -> Token {
        let token = this.Current();

        if this.index < this.tokens.Size() {
            this.index += 1;
        } return token;
    }

    fn Match(&mut this, _type: TokenType) -> bool {
        if this.Current()._type == _type {
            this.Advance();
            return true;
        } else {
            return false;
        }
    }

    fn Expect(&mut this, _type: TokenType) -> Token {
        let token = this.Current();

        if token._type == _type {
            return this.Advance();
        }

        if token._type == TokenType::EOF {
            Logger::Log("Expected '" + _type.ToString() + "', but reached end of file.", token, LogSeverity::Error);
        } else if !token.value.Empty() && token.value != token._type.ToString() {
            Logger::Log("Expected '" + _type.ToString() + "', found '" + token.value + "' (" + token._type.ToString() + ").", token, LogSeverity::Error);
        } else {
            Logger::Log("Expected '" + _type.ToString() + "', found '" + token._type.ToString() + "'.", token, LogSeverity::Error);
        }

        let mut error: Token;
        (error._type, error.row, error.column, error.file) = (TokenType::UNKNOWN, token.row, token.column, token.file);
        return error;
    }

    fn ExpectSuccess(&mut this, _type: TokenType) -> bool {
        let token = this.Current();

        if token._type == _type {
            this.Advance();
            return true;
        }

        if token._type == TokenType::EOF {
            Logger::Log("Expected '" + _type.ToString() + "', but reached end of file.", token, LogSeverity::Error);
        } else if !token.value.Empty() && token.value != token._type.ToString() {
            Logger::Log("Expected '" + _type.ToString() + "', found '" + token.value + "' (" + token._type.ToString() + ").", token, LogSeverity::Error);
        } else {
            Logger::Log("Expected '" + _type.ToString() + "', found '" + token._type.ToString() + "'.", token, LogSeverity::Error);
        } return false;
    }

    fn IsTypeApplication(&this) -> bool {
        if this.Current()._type != TokenType::LESS { return false; }
        let mut index: usize = 1;
        let mut depth: u64 = 1;

        loop {
            let token = this.Peek(index);
            if token._type == TokenType::EOF { return false; }
            let _type = token._type;
            index += 1;

            if _type == TokenType::LESS {
                let increment: u64 = 1;
                depth += increment;
            } else if _type == TokenType::GREATER {
                if depth >= 1 {
                    let decrement: u64 = 1;
                    depth -= decrement;
                } else {
                    return false;
                }
            } else if _type == TokenType::SEMICOLON || _type == TokenType::LBRACE || _type == TokenType::RBRACE {
                return false;
            } else {
                if _type != TokenType::IDENTIFIER && _type != TokenType::COLON && _type != TokenType::DOUBLE_COLON && _type != TokenType::LPAREN && _type != TokenType::RPAREN
                    && _type != TokenType::MUL && _type != TokenType::BITWISE_AND && _type != TokenType::MUT && _type != TokenType::CONST && _type != TokenType::LBRACKET && _type != TokenType::RBRACKET
                        && _type != TokenType::FUNCTION && _type != TokenType::THREE_DOT && _type != TokenType::ARROW && _type != TokenType::INTEGER && _type != TokenType::COMMA { return false; }
            }

            if depth == 0 {
                let next = this.Peek(index);

                return next._type != TokenType::IDENTIFIER && next._type != TokenType::INTEGER && next._type != TokenType::FLOAT && next._type != TokenType::STRING
                    && next._type != TokenType::CHAR && next._type != TokenType::TRUE && next._type != TokenType::FALSE && next._type != TokenType::NULL;
            }
        } return false;
    }

    fn ParsePath(&mut this) -> *ASTPath {
        let token = this.Current();
        let path = this.arena.New<ASTPath>(this.Match(TokenType::DOUBLE_COLON), token);

        loop {
            if this.Match(TokenType::OPERATOR) {
                let mut _identifier = "operator".ToString();

                while this.Current()._type != TokenType::LPAREN && this.Current()._type != TokenType::LESS {
                    _identifier += this.Current().value;
                    this.Advance();
                }

                path->segments.PushBack(ASTPathSegment(_identifier));
            } else {
                let _identifier = this.Expect(this.Current()._type != TokenType::THIS ? TokenType::IDENTIFIER : TokenType::THIS);
                if _identifier._type == TokenType::UNKNOWN { return null; }
                let mut segment = ASTPathSegment(_identifier.value);

                if this.IsTypeApplication() {
                    this.Advance();

                    while this.Current()._type != TokenType::GREATER {
                        let _type = this.ParseType();
                        if _type == null { return null; }
                        segment.types.PushBack(_type);
                        if !this.Match(TokenType::COMMA) { break; }
                    }

                    if !this.ExpectSuccess(TokenType::GREATER) { return null; }
                } path->segments.PushBack(segment);
            }

            if !this.Match(TokenType::DOUBLE_COLON) {
                break;
            }
        } return path;
    }

    fn ParsePrimary(&mut this) -> *ASTExpression {
        let token = this.Current();

        if token._type == TokenType::TRUE || token._type == TokenType::FALSE {
            this.Advance();
            return this.arena.New<ASTBooleanLiteral>(token._type == TokenType::TRUE, token) as *ASTLiteral;
        } else if token._type == TokenType::CHAR {
            this.Advance();

            if !(token.value.Size() == 2 && token.value[1] == '\0') && !(token.value.Size() == 1 && token.value[0] == '\0') {
                Logger::Log("Invalid character literal '" + token.value + "'.", token, LogSeverity::Error);
                return null;
            }

            let character: i8 = token.value[0];
            return this.arena.New<ASTCharacterLiteral>(character as u32, token) as *ASTLiteral;
        } else if token._type == TokenType::INTEGER {
            this.Advance();
            let (mut value, mut suffix, mut base: u64) = (String(), String(), 10);
            let mut index = token.value.Find('i');

            if index == -1 {
                index = token.value.Find('u');
            }

            if index != -1 {
                value = token.value.SubString(0, index as usize);
                suffix = token.value.SubString(index as usize);
            } else {
                value = token.value;
            }

            if value.StartsWith("0x") {
                (value, base) = (value.SubString(2), 16);
            } else if value.StartsWith("0o") {
                (value, base) = (value.SubString(2), 8);
            } else if value.StartsWith("0b") {
                (value, base) = (value.SubString(2), 2);
            }

            return this.arena.New<ASTIntegerLiteral>(value.ToUnsignedInteger(base), suffix, token) as *ASTLiteral;
        } else if token._type == TokenType::FLOAT {
            this.Advance();
            let (mut value, mut suffix) = (String(), String());
            let mut index = token.value.Find('f');

            if index != -1 {
                value = token.value.SubString(0, index as usize);
                suffix = token.value.SubString(index as usize);
            } else {
                value = token.value;
            }

            return this.arena.New<ASTFloatLiteral>(value.ToFloat(), suffix, token) as *ASTLiteral;
        } else if token._type == TokenType::STRING {
            this.Advance();
            return this.arena.New<ASTStringLiteral>(token.value, token) as *ASTLiteral;
        } else if token._type == TokenType::NULL {
            this.Advance();
            return this.arena.New<ASTNullLiteral>(token) as *ASTLiteral;
        } else if token._type == TokenType::IDENTIFIER || token._type == TokenType::THIS || token._type == TokenType::OPERATOR || token._type == TokenType::DOUBLE_COLON {
            return this.arena.New<ASTPathExpression>(this.ParsePath(), token);
        } else if token._type == TokenType::LBRACE {
            this.Advance();
            let array = this.arena.New<ASTArrayLiteral>(token);

            if !this.Match(TokenType::RBRACE) {
                let expression = this.ParseExpression();
                if expression == null { return null; }
                array->elements.PushBack(expression);

                while this.Match(TokenType::COMMA) {
                    let expression = this.ParseExpression();
                    if expression == null { return null; }
                    array->elements.PushBack(expression);
                }

                if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
            } return array as *ASTLiteral;
        } else if token._type == TokenType::LPAREN {
            this.Advance();
            let mut expression = this.ParseExpression();
            if expression == null { return null; }

            if this.Match(TokenType::COMMA) {
                let tuple = this.arena.New<ASTTupleExpression>(token);
                tuple->values.PushBack(expression);

                if !this.Match(TokenType::RPAREN) {
                    while this.Current()._type != TokenType::RPAREN && this.Current()._type != TokenType::EOF {
                        let expression = this.ParseExpression();
                        if expression == null { return null; }
                        tuple->values.PushBack(expression);

                        if !this.Match(TokenType::COMMA) {
                            break;
                        }
                    }
                } expression = tuple;
            }

            if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
            return expression;
        } else {
            this.Advance();
            Logger::Log("Unexpected token '" + token.value + "'.", token, LogSeverity::Error);
            return null;
        }
    }

    fn ParsePostfix(&mut this) -> *ASTExpression {
        let mut expression = this.ParsePrimary();
        if expression == null { return null; }

        loop {
            let token = this.Current();

            if token._type == TokenType::LPAREN {
                this.Advance();
                let call = this.arena.New<ASTCallExpression>(expression, token);

                if !this.Match(TokenType::RPAREN) {
                    while this.Current()._type != TokenType::RPAREN && this.Current()._type != TokenType::EOF {
                        let expression = this.ParseExpression();
                        if expression == null { return null; }
                        call->arguments.PushBack(expression);

                        if !this.Match(TokenType::COMMA) {
                            break;
                        }
                    }

                    if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
                } expression = call;
            } else if token._type == TokenType::DOT || token._type == TokenType::ARROW {
                this.Advance();
                let member_access = this.arena.New<ASTMemberAccessExpression>(expression, token._type == TokenType::ARROW, token);

                if this.Match(TokenType::OPERATOR) {
                    member_access->member += "operator";

                    while this.Current()._type != TokenType::LPAREN && this.Current()._type != TokenType::LESS {
                        member_access->member += this.Current().value;
                        this.Advance();
                    }
                } else {
                    let identifier = this.Expect(TokenType::IDENTIFIER);
                    if identifier._type == TokenType::UNKNOWN { return null; }
                    member_access->member += identifier.value;
                }

                if this.IsTypeApplication() {
                    this.Advance();

                    while this.Current()._type != TokenType::GREATER {
                        let _type = this.ParseType();
                        if _type == null { return null; }
                        member_access->types.PushBack(_type);
                        if !this.Match(TokenType::COMMA) { break; }
                    }

                    if !this.ExpectSuccess(TokenType::GREATER) { return null; }
                } expression = member_access;
            } else if token._type == TokenType::LBRACKET {
                this.Advance();
                let _expression = this.ParseExpression();
                if _expression == null { return null; }
                expression = this.arena.New<ASTIndexAccessExpression>(expression, _expression, token);
                if !this.ExpectSuccess(TokenType::RBRACKET) { return null; }
            } else if token._type == TokenType::LBRACE && this.Peek(1)._type == TokenType::IDENTIFIER && this.Peek(2)._type == TokenType::COLON {
                this.Advance();
                let structure = this.arena.New<ASTStructureLiteral>(expression, token);

                while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                    if this.Current()._type == TokenType::TWO_DOT {
                        this.Advance();
                        break;
                    }

                    let field_name = this.Expect(TokenType::IDENTIFIER);
                    if field_name._type == TokenType::UNKNOWN { return null; }
                    if !this.ExpectSuccess(TokenType::COLON) { return null; }
                    let expression = this.ParseExpression();
                    if expression == null { return null; }
                    structure->fields[field_name.value] = expression;
                    if !this.Match(TokenType::COMMA) { break; }
                }

                if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
                expression = structure as *ASTLiteral;
            } else if token._type == TokenType::THREE_DOT {
                this.Advance();
                expression = this.arena.New<ASTPackSplatExpression>(expression, token);
            } else {
                break;
            }
        } return expression;
    }

    fn ParseUnaryExpression(&mut this) -> *ASTExpression {
        let token = this.Current();

        if token._type == TokenType::BITWISE_AND {
            this.Advance();
            let mutable = this.Match(TokenType::MUT);
            let expression = this.ParseUnaryExpression();
            if expression == null { return null; }
            return this.arena.New<ASTUnaryExpression>(ASTUnaryKind::AddressOf, expression, mutable, token);
        } else if token._type == TokenType::MUL {
            this.Advance();
            let expression = this.ParseUnaryExpression();
            if expression == null { return null; }
            return this.arena.New<ASTUnaryExpression>(ASTUnaryKind::Dereference, expression, false, token);
        } else if token._type == TokenType::MINUS {
            this.Advance();
            let expression = this.ParseUnaryExpression();
            if expression == null { return null; }
            return this.arena.New<ASTUnaryExpression>(ASTUnaryKind::Negate, expression, false, token);
        } else if token._type == TokenType::NOT {
            this.Advance();
            let expression = this.ParseUnaryExpression();
            if expression == null { return null; }
            return this.arena.New<ASTUnaryExpression>(ASTUnaryKind::Not, expression, false, token);
        } else if token._type == TokenType::NEW {
            this.Advance();
            let _type = this.ParseType();
            if _type == null { return null; }
            let _new = this.arena.New<ASTNewExpression>(_type, token);

            if this.Match(TokenType::LBRACKET) {
                _new->size = this.ParseExpression();

                if _new->size == null || !this.ExpectSuccess(TokenType::RBRACKET) {
                    return null;
                }
            } else if this.Match(TokenType::LPAREN) {
                _new->initialized = true;

                if !this.Match(TokenType::RPAREN) {
                    while this.Current()._type != TokenType::RPAREN {
                        let argument = this.ParseExpression();
                        if argument == null { return null; }
                        _new->arguments.PushBack(argument);
                        if !this.Match(TokenType::COMMA) { break; }
                    }

                    if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
                }
            } return _new;
        } else if token._type == TokenType::DELETE {
            this.Advance();
            let _delete = this.arena.New<ASTDeleteExpression>(token);

            if this.Match(TokenType::LBRACKET) {
                if !this.ExpectSuccess(TokenType::RBRACKET) { return null; }
                _delete->array = true;
            }

            _delete->expression = this.ParseExpression();
            if _delete->expression == null { return null; }
            return _delete;
        } else if token._type == TokenType::AWAIT {
            this.Advance();
            let expression = this.ParseUnaryExpression();
            if expression == null { return null; }
            return this.arena.New<ASTAwaitExpression>(expression, token);
        } else {
            return this.ParsePostfix();
        }
    }

    fn GetBinaryPrecedence(&this, _type: TokenType) -> i32 {
        if _type == TokenType::OR { return 1; }
        else if _type == TokenType::AND { return 2; }
        else if _type == TokenType::BITWISE_OR { return 3; }
        else if _type == TokenType::BITWISE_XOR { return 4; }
        else if _type == TokenType::BITWISE_AND { return 5; }
        else if _type == TokenType::EQUAL || _type == TokenType::NOT_EQUAL { return 6; }
        else if _type == TokenType::LESS || _type == TokenType::LESS_EQUAL || _type == TokenType::GREATER || _type == TokenType::GREATER_EQUAL { return 7; }
        else if _type == TokenType::LSHIFT || _type == TokenType::RSHIFT { return 8; }
        else if _type == TokenType::PLUS || _type == TokenType::MINUS { return 9; }
        else if _type == TokenType::MUL || _type == TokenType::DIV || _type == TokenType::MOD { return 10; }
        else if _type == TokenType::AS { return 11; }
        else { return -1; }
    }

    fn ParseBinaryKind(&this, _type: TokenType) -> ASTBinaryKind {
        if _type == TokenType::PLUS { return ASTBinaryKind::Add; }
        else if _type == TokenType::MINUS { return ASTBinaryKind::Subtract; }
        else if _type == TokenType::MUL { return ASTBinaryKind::Multiply; }
        else if _type == TokenType::DIV { return ASTBinaryKind::Divide; }
        else if _type == TokenType::MOD { return ASTBinaryKind::Modulo; }
        else if _type == TokenType::EQUAL { return ASTBinaryKind::Equal; }
        else if _type == TokenType::NOT_EQUAL { return ASTBinaryKind::NotEqual; }
        else if _type == TokenType::LESS { return ASTBinaryKind::Less; }
        else if _type == TokenType::LESS_EQUAL { return ASTBinaryKind::LessEqual; }
        else if _type == TokenType::GREATER { return ASTBinaryKind::Greater; }
        else if _type == TokenType::GREATER_EQUAL { return ASTBinaryKind::GreaterEqual; }
        else if _type == TokenType::AND { return ASTBinaryKind::LogicalAnd; }
        else if _type == TokenType::OR { return ASTBinaryKind::LogicalOr; }
        else if _type == TokenType::BITWISE_AND { return ASTBinaryKind::BitwiseAnd; }
        else if _type == TokenType::BITWISE_OR { return ASTBinaryKind::BitwiseOr; }
        else if _type == TokenType::BITWISE_XOR { return ASTBinaryKind::BitwiseXor; }
        else if _type == TokenType::LSHIFT { return ASTBinaryKind::LeftShift; }
        else { return ASTBinaryKind::RightShift; }
    }

    fn ParseBinaryExpression(&mut this, min_precedence: i32) -> *ASTExpression {
        let mut left = this.ParseUnaryExpression();
        if left == null { return null; }

        loop {
            let mut token = this.Current();

            if this.Peek(1)._type == token._type {
                if token._type == TokenType::GREATER {
                    token._type = TokenType::RSHIFT;
                    this.Advance();
                }

                if token._type == TokenType::LESS {
                    token._type = TokenType::LSHIFT;
                    this.Advance();
                }
            }

            let precedence = this.GetBinaryPrecedence(token._type);
            if precedence < min_precedence { break; }
            this.Advance();

            if token._type == TokenType::AS {
                let _type = this.ParseType();
                if _type == null { return null; }
                left = this.arena.New<ASTCastExpression>(left, _type, token);
            } else {
                let right = this.ParseBinaryExpression(precedence + 1);
                if right == null { return null; }
                left = this.arena.New<ASTBinaryExpression>(this.ParseBinaryKind(token._type), left, right, token);
            }
        } return left;
    }

    fn ParseExpression(&mut this) -> *ASTExpression {
        let mut expression = this.ParseBinaryExpression(0);
        if expression == null { return null; }
        let token = this.Current();

        if token._type == TokenType::QUESTION_MARK {
            this.Advance();
            let then = this.ParseExpression();
            if then == null || !this.ExpectSuccess(TokenType::COLON) { return null; }
            let _else = this.ParseExpression();
            if _else == null { return null; }
            expression = this.arena.New<ASTTernaryExpression>(expression, then, _else, token);
        } return expression;
    }

    fn ParseType(&mut this) -> *ASTType {
        let mut references = Vector<bool>();

        if this.Match(TokenType::BITWISE_AND) {
            references.PushBack(this.Match(TokenType::MUT));
        }

        let mut pointers = Vector<bool>();

        while this.Match(TokenType::MUL) {
            if this.Match(TokenType::MUT) {
                pointers.PushBack(true);
            } else {
                pointers.PushBack(false);
            }
        }

        let token = this.Current();
        let mut node: *ASTType = null;

        if this.Match(TokenType::FUNCTION) {
            if !this.ExpectSuccess(TokenType::LPAREN) { return null; }
            let function = this.arena.New<ASTFunctionType>(token);

            if this.Current()._type != TokenType::RPAREN {
                while this.Current()._type != TokenType::EOF {
                    if this.Match(TokenType::THREE_DOT) {
                        function->var_arg = true;
                        break;
                    }

                    let _type = this.ParseType();
                    if _type == null { return null; }
                    function->parameters.PushBack(_type);

                    if !this.Match(TokenType::COMMA) {
                        break;
                    }
                }
            }

            if !this.ExpectSuccess(TokenType::RPAREN) { return null; }

            if this.Match(TokenType::ARROW) {
                function->_return = this.ParseType();
                if function->_return == null { return null; }
            } node = function;
        } else {
            node = this.arena.New<ASTPathType>(this.ParsePath(), token);
        }

        while !pointers.Empty() {
            node = this.arena.New<ASTPointerType>(node, pointers.PopBack(), token);
        }

        if !references.Empty() {
            node = this.arena.New<ASTReferenceType>(node, references[0], token);
        } return node;
    }

    fn ParseAssignmentKind(&this, _type: TokenType) -> ASTAssignmentKind {
        if _type == TokenType::ASSIGN { return ASTAssignmentKind::Assign; }
        else if _type == TokenType::PLUS_ASSIGN { return ASTAssignmentKind::AddAssign; }
        else if _type == TokenType::MINUS_ASSIGN { return ASTAssignmentKind::SubtractAssign; }
        else if _type == TokenType::MUL_ASSIGN { return ASTAssignmentKind::MultiplyAssign; }
        else if _type == TokenType::DIV_ASSIGN { return ASTAssignmentKind::DivideAssign; }
        else if _type == TokenType::MOD_ASSIGN { return ASTAssignmentKind::ModuloAssign; }
        else if _type == TokenType::AND_ASSIGN { return ASTAssignmentKind::AndAssign; }
        else if _type == TokenType::OR_ASSIGN { return ASTAssignmentKind::OrAssign; }
        else if _type == TokenType::XOR_ASSIGN { return ASTAssignmentKind::XorAssign; }
        else if _type == TokenType::LSHIFT_ASSIGN { return ASTAssignmentKind::LeftShiftAssign; }
        else { return ASTAssignmentKind::RightShiftAssign; }
    }

    fn ParseStatement(&mut this, expression: bool) -> *ASTStatement {
        let token = this.Current();

        if token._type == TokenType::LET && !expression {
            return this.ParseVariableStatement();
        } else if token._type == TokenType::IF && !expression {
            return this.ParseIfStatement();
        } else if token._type == TokenType::WHILE && !expression {
            return this.ParseWhileStatement();
        } else if token._type == TokenType::FOR && !expression {
            return this.ParseForStatement();
        } else if token._type == TokenType::LOOP && !expression {
            return this.ParseLoopStatement();
        } else if token._type == TokenType::UNSAFE && !expression {
            return this.ParseUnsafeStatement();
        } else if (token._type == TokenType::ASSEMBLY || token._type == TokenType::VOLATILE) && !expression {
            return this.ParseAssembly();
        } else if token._type == TokenType::RETURN {
            return this.ParseReturnStatement(expression);
        } else if token._type == TokenType::BREAK {
            return this.ParseBreakStatement(expression);
        } else if token._type == TokenType::CONTINUE {
            return this.ParseContinueStatement(expression);
        } else {
            let index = this.index;

            if this.Match(TokenType::LPAREN) {
                let mut current: *mut ASTAssignmentExpression = null;
                let mut root: *mut ASTAssignmentExpression = null;

                while root == null || this.Match(TokenType::COMMA) {
                    let _expression = this.ParseExpression();
                    if _expression == null { return null; }
                    let assignment = this.arena.New<ASTAssignmentExpression>(ASTAssignmentKind::Assign, _expression, null, token);

                    if root != null {
                        current->next = assignment;
                    } else {
                        root = assignment;
                    } current = assignment;
                }

                if root->next != null {
                    if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
                    if !this.ExpectSuccess(TokenType::ASSIGN) { return null; }
                    if !this.ExpectSuccess(TokenType::LPAREN) { return null; }
                    current = root;

                    while current != null {
                        current->right = this.ParseExpression();
                        if current->right == null { return null; }

                        if current->next != null {
                            if !this.ExpectSuccess(TokenType::COMMA) { return null; }
                        } current = current->next;
                    }

                    if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
                    if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
                    return this.arena.New<ASTExpressionStatement>(root, token);
                } else {
                    this.index = index;
                }
            }

            let left = this.ParseExpression();
            let _operator = this.Current();

            if _operator._type == TokenType::ASSIGN || _operator._type == TokenType::PLUS_ASSIGN || _operator._type == TokenType::MINUS_ASSIGN || _operator._type == TokenType::MUL_ASSIGN || _operator._type == TokenType::DIV_ASSIGN || _operator._type == TokenType::MOD_ASSIGN
                || _operator._type == TokenType::AND_ASSIGN || _operator._type == TokenType::OR_ASSIGN || _operator._type == TokenType::XOR_ASSIGN || _operator._type == TokenType::LSHIFT_ASSIGN || _operator._type == TokenType::RSHIFT_ASSIGN {

                this.Advance();
                let right = this.ParseExpression();
                if right == null { return null; }
                let assignment = this.arena.New<ASTAssignmentExpression>(this.ParseAssignmentKind(_operator._type), left, right, _operator);
                if !expression && !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
                return this.arena.New<ASTExpressionStatement>(assignment, token);
            } else {
                if !expression && !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
                return this.arena.New<ASTExpressionStatement>(left, token);
            }
        }
    }

    fn ParseVariableStatement(&mut this) -> *ASTVariableStatement {
        let token = this.Expect(TokenType::LET);
        if token._type == TokenType::UNKNOWN { return null; }
        let multiple = this.Match(TokenType::LPAREN);
        let mut current: *mut ASTVariableStatement = null;
        let mut root: *mut ASTVariableStatement = null;

        while root == null || (multiple && root != null && this.Match(TokenType::COMMA)) {
            let mutable = this.Match(TokenType::MUT);
            let identifier = this.Expect(TokenType::IDENTIFIER);
            if identifier._type == TokenType::UNKNOWN { return null; }
            let mut sizes = Vector<*ASTExpression>();

            while this.Match(TokenType::LBRACKET) {
                if this.Match(TokenType::RBRACKET) {
                    sizes.PushBack(null);
                } else {
                    let expression = this.ParseExpression();
                    if expression == null || !this.ExpectSuccess(TokenType::RBRACKET) { return null; }
                    sizes.PushBack(expression);
                }
            }

            let mut _type = null;

            if this.Match(TokenType::COLON) {
                _type = this.ParseType();
                if _type == null { return null; }

                for size in sizes {
                    _type = this.arena.New<ASTArrayType>(_type, size, token);
                }
            } else if !sizes.Empty() {
                Logger::Log("Array size specified but type is missing.", token, LogSeverity::Error);
                return null;
            }

            let declaration = this.arena.New<ASTVariableStatement>(identifier.value, _type, null, mutable, token);

            if root != null {
                current->next = declaration;
            } else {
                root = declaration;
            } current = declaration;
        }

        if multiple {
            if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
        }

        if this.Match(TokenType::ASSIGN) {
            if multiple {
                if !this.ExpectSuccess(TokenType::LPAREN) { return null; }
            } current = root;

            while current != null {
                current->initializer = this.ParseExpression();
                if current->initializer == null { return null; }

                if current->next != null {
                    if !this.ExpectSuccess(TokenType::COMMA) { return null; }
                } current = current->next;
            }

            if multiple {
                if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
            }
        }

        if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        return root;
    }

    fn ParseIfStatement(&mut this) -> *ASTIfStatement {
        let token = this.Expect(TokenType::IF);
        if token._type == TokenType::UNKNOWN { return null; }
        let condition = this.ParseExpression();
        if condition == null { return null; }
        let then = this.ParseBlockStatement();
        if then == null { return null; }
        let mut _else = null;

        if this.Match(TokenType::ELSE) {
            if this.Current()._type == TokenType::IF {
                _else = this.ParseIfStatement();
            } else {
                _else = this.ParseBlockStatement();
            }
        }

        return this.arena.New<ASTIfStatement>(condition, then, _else, token);
    }

    fn ParseWhileStatement(&mut this) -> *ASTWhileStatement {
        let token = this.Expect(TokenType::WHILE);
        if token._type == TokenType::UNKNOWN { return null; }
        let expression = this.ParseExpression();
        if expression == null { return null; }
        let _loop = this.ParseBlockStatement();
        if _loop == null { return null; }
        let mut _else = null;

        if this.Match(TokenType::ELSE) {
            _else = this.ParseBlockStatement();
        }

        return this.arena.New<ASTWhileStatement>(expression, _loop, _else, token);
    }

    fn ParseForStatement(&mut this) -> *ASTForStatement {
        let token = this.Expect(TokenType::FOR);
        if token._type == TokenType::UNKNOWN { return null; }
        let name = this.Expect(TokenType::IDENTIFIER);
        if name._type == TokenType::UNKNOWN { return null; }
        if !this.ExpectSuccess(TokenType::IN) { return null; }
        let iterable = this.ParseForIterable();
        if iterable == null { return null; }
        let _loop = this.ParseBlockStatement();
        if _loop == null { return null; }
        return this.arena.New<ASTForStatement>(name.value, iterable, _loop, token);
    }

    fn ParseForIterable(&mut this) -> *ASTExpression {
        let left = this.ParseBinaryExpression(0);
        if left == null { return null; }

        if this.Current()._type == TokenType::TWO_DOT {
            let token = this.Advance();
            let inclusive = this.Match(TokenType::ASSIGN);
            let right = this.ParseBinaryExpression(0);
            if right == null { return null; }
            let range = this.arena.New<ASTRangeExpression>(left, right, token);
            range->inclusive = inclusive;
            return range;
        } return left;
    }

    fn ParseLoopStatement(&mut this) -> *ASTLoopStatement {
        let token = this.Expect(TokenType::LOOP);
        if token._type == TokenType::UNKNOWN { return null; }
        let _loop = this.ParseBlockStatement();
        if _loop == null { return null; }
        return this.arena.New<ASTLoopStatement>(_loop, token);
    }

    fn ParseUnsafeStatement(&mut this) -> *ASTUnsafeStatement {
        let token = this.Expect(TokenType::UNSAFE);
        if token._type == TokenType::UNKNOWN { return null; }
        let body = this.ParseBlockStatement();
        if body == null { return null; }
        return this.arena.New<ASTUnsafeStatement>(body, token);
    }

    fn ParseAssembly(&mut this) -> *ASTAssemblyStatement {
        let _volatile = this.Match(TokenType::VOLATILE);
        let token = this.Expect(TokenType::ASSEMBLY);
        if token._type == TokenType::UNKNOWN { return null; }
        let node = this.arena.New<ASTAssemblyStatement>(_volatile, token);

        if this.Match(TokenType::COLON) {
            while this.Current()._type == TokenType::IDENTIFIER {
                let register = this.Advance().value;
                if !this.ExpectSuccess(TokenType::LPAREN) { return null; }
                let expression = this.ParseExpression();
                if expression == null || !this.ExpectSuccess(TokenType::RPAREN) { return null; }
                node->inputs.PushBack(Pair<String, *ASTNode>(register, expression));
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.ExpectSuccess(TokenType::ARROW) { return null; }
        }

        let code = this.Expect(TokenType::ASSEMBLY_CODE);
        if code._type == TokenType::UNKNOWN { return null; }
        node->code = code.value;

        if this.Match(TokenType::ARROW) {
            while this.Current()._type == TokenType::IDENTIFIER {
                let register = this.Advance().value;
                if !this.ExpectSuccess(TokenType::LPAREN) { return null; }
                let expression = this.ParseExpression();
                if expression == null || !this.ExpectSuccess(TokenType::RPAREN) { return null; }
                node->outputs.PushBack(Pair<String, *ASTNode>(register, expression));
                if !this.Match(TokenType::COMMA) { break; }
            }
        }

        if this.Match(TokenType::COLON) {
            while this.Current()._type == TokenType::IDENTIFIER {
                node->clobbers.PushBack(this.Advance().value);
                if !this.Match(TokenType::COMMA) { break; }
            }
        }

        if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        return node;
    }

    fn ParseReturnStatement(&mut this, expression: bool) -> *ASTReturnStatement {
        let token = this.Expect(TokenType::RETURN);
        if token._type == TokenType::UNKNOWN { return null; }
        let mut value = null;

        if this.Current()._type != TokenType::SEMICOLON {
            value = this.ParseExpression();
            if value == null { return null; }
        }

        if !expression {
            if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        }

        return this.arena.New<ASTReturnStatement>(value, token);
    }

    fn ParseBreakStatement(&mut this, expression: bool) -> *ASTBreakStatement {
        let token = this.Expect(TokenType::BREAK);
        if token._type == TokenType::UNKNOWN { return null; }

        if !expression {
            if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        }

        return this.arena.New<ASTBreakStatement>(token);
    }

    fn ParseContinueStatement(&mut this, expression: bool) -> *ASTContinueStatement {
        let token = this.Expect(TokenType::CONTINUE);
        if token._type == TokenType::UNKNOWN { return null; }

        if !expression {
            if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        }

        return this.arena.New<ASTContinueStatement>(token);
    }

    fn ParseBlockStatement(&mut this) -> *ASTBlockStatement {
        let token = this.Expect(TokenType::LBRACE);
        if token._type == TokenType::UNKNOWN { return null; }
        let block = this.arena.New<ASTBlockStatement>(token);

        while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
            let statement = this.ParseStatement(false);

            if statement != null {
                block->statements.PushBack(statement);
            } else {
                while this.Current()._type != TokenType::EOF && this.Current()._type != TokenType::RBRACE {
                    let _type = this.Current()._type;

                    if _type == TokenType::SEMICOLON {
                        this.Advance();
                        break;
                    }

                    if _type == TokenType::LET || _type == TokenType::IF || _type == TokenType::WHILE || _type == TokenType::FOR || _type == TokenType::LOOP || _type == TokenType::MATCH || _type == TokenType::RETURN || _type == TokenType::BREAK || _type == TokenType::CONTINUE || _type == TokenType::ASSEMBLY || _type == TokenType::VOLATILE {
                        break;
                    }

                    this.Advance();
                }
            }
        }

        if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
        return block;
    }

    fn SynchronizeDeclaration(&mut this) {
        while this.Current()._type != TokenType::EOF {
            let _type = this.Current()._type;

            if _type == TokenType::FUNCTION || _type == TokenType::CLASS || _type == TokenType::ENUMERATION || _type == TokenType::EXTERN || _type == TokenType::INCLUDE || _type == TokenType::CONST || _type == TokenType::STATIC || _type == TokenType::TYPE || _type == TokenType::ASSEMBLY || _type == TokenType::VOLATILE || _type == TokenType::AT {
                break;
            }

            this.Advance();
        }
    }

    fn ParseAttributes(&mut this) -> Vector<Pair<String, Vector<*ASTNode>>> {
        let mut attributes = Vector<Pair<String, Vector<*ASTNode>>>();

        while this.Match(TokenType::AT) {
            let mut pair = Pair<String, Vector<*ASTNode>>();
            let identifier = this.Expect(TokenType::IDENTIFIER);
            if identifier._type == TokenType::UNKNOWN { return attributes; }
            pair.left = identifier.value;

            if this.Match(TokenType::LPAREN) {
                if !this.Match(TokenType::RPAREN) {
                    while this.Current()._type != TokenType::RPAREN && this.Current()._type != TokenType::EOF {
                        let expression = this.ParseExpression();
                        if expression == null { return attributes; }
                        pair.right.PushBack(expression);

                        if !this.Match(TokenType::COMMA) {
                            break;
                        }
                    }

                    if !this.ExpectSuccess(TokenType::RPAREN) { return attributes; }
                }
            }

            attributes.PushBack(pair);
        } return attributes;
    }

    fn ParseDeclaration(&mut this) -> *ASTDeclaration {
        let attributes = this.ParseAttributes();
        let token = this.Current();

        if token._type == TokenType::FUNCTION {
            return this.ParseFunctionDeclaration(attributes, false);
        } else if token._type == TokenType::CLASS {
            return this.ParseClassDeclaration(attributes);
        } else if token._type == TokenType::STRUCTURE {
            return this.ParseStructureDeclaration(attributes);
        } else if token._type == TokenType::ENUMERATION {
            return this.ParseEnumerationDeclaration(attributes);
        } else if token._type == TokenType::EXTERN {
            return this.ParseExternDeclaration();
        } else if token._type == TokenType::CONST {
            return this.ParseConstantDeclaration();
        } else if token._type == TokenType::STATIC {
            return this.ParseStaticDeclaration(attributes);
        } else if token._type == TokenType::TYPE {
            return this.ParseTypeDeclaration();
        } else if token._type == TokenType::ASSEMBLY || token._type == TokenType::VOLATILE {
            return this.ParseAssemblyDeclaration();
        } else {
            this.Advance();
            Logger::Log("Expected declaration.", token, LogSeverity::Error);
            return null;
        }
    }

    fn ParseFunctionDeclaration(&mut this, attributes: &Vector<Pair<String, Vector<*ASTNode>>>, _class: bool) -> *ASTFunctionDeclaration {
        let token = this.Current();
        let mut no_mangle = false;

        for attribute in attributes {
            if attribute.left == "nomangle" {
                if attribute.right.Size() != 0 {
                    Logger::Log("Invalid number of arguments for attribute '" + attribute.left + "'.", token, LogSeverity::Error);
                    return null;
                }

                if no_mangle {
                    Logger::Log("Attribute '" + attribute.left + "' already set.", token, LogSeverity::Error);
                    return null;
                }

                no_mangle = true;
            } else {
                Logger::Log("Invalid attribute '" + attribute.left + "'.", token, LogSeverity::Error);
                return null;
            }
        }

        let public = this.Match(TokenType::PUBLIC);
        let mut name = String();

        if !_class || public {
            if !this.ExpectSuccess(TokenType::FUNCTION) { return null; }
        } else {
            if this.Match(TokenType::TILDE) {
                name += token.value;
                let identifier = this.Expect(TokenType::IDENTIFIER);
                if identifier._type == TokenType::UNKNOWN { return null; }
                name += identifier.value;
            } else if this.Match(TokenType::IDENTIFIER) {
                name += token.value;
            } else if !this.ExpectSuccess(TokenType::FUNCTION) {
                return null;
            }
        }

        if name.Empty() {
            if this.Match(TokenType::OPERATOR) {
                name += "operator";

                while this.Current()._type != TokenType::LPAREN {
                    name += this.Current().value;
                    this.Advance();
                }
            } else {
                let identifier = this.Expect(TokenType::IDENTIFIER);
                if identifier._type == TokenType::UNKNOWN { return null; }
                name += identifier.value;
            }
        }

        let function = this.arena.New<ASTFunctionDeclaration>(name, public, no_mangle, token);

        if this.Match(TokenType::LESS) {
            function->generic = true;

            while this.Current()._type != TokenType::GREATER {
                let type_name = this.Expect(TokenType::IDENTIFIER);
                if type_name._type == TokenType::UNKNOWN { return null; }
                function->types.PushBack(type_name.value);
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.ExpectSuccess(TokenType::GREATER) {
                return null;
            }
        }

        if !this.ExpectSuccess(TokenType::LPAREN) {
            return null;
        }

        if this.Current()._type != TokenType::RPAREN {
            let mut has_instance = true;

            if this.Match(TokenType::BITWISE_AND) {
                let mutable = this.Match(TokenType::MUT);
                if !this.ExpectSuccess(TokenType::THIS) { return null; }
                function->instance_kind = mutable ? ASTInstanceKind::MutRef : ASTInstanceKind::ConstRef;
            } else if this.Match(TokenType::THIS) {
                function->instance_kind = ASTInstanceKind::Copy;
            } else {
                has_instance = false;
            }

            if !has_instance || this.Match(TokenType::COMMA) {
                while this.Current()._type != TokenType::EOF {
                    if this.Peek(1)._type == TokenType::THREE_DOT {
                        let pack_name = this.Expect(TokenType::IDENTIFIER);
                        if pack_name._type == TokenType::UNKNOWN { return null; }
                        function->pack_name = pack_name.value;
                        this.Advance();
                        break;
                    }

                    if this.Match(TokenType::THREE_DOT) {
                        function->var_arg = true;
                        break;
                    }

                    let param = this.ParseParameter();
                    if param == null { return null; }
                    function->parameters.PushBack(param);

                    if !this.Match(TokenType::COMMA) {
                        break;
                    }
                }
            }
        }

        if !this.ExpectSuccess(TokenType::RPAREN) {
            return null;
        }

        if this.Match(TokenType::ASYNC) {
            function->_async = true;
        }

        if this.Match(TokenType::ARROW) {
            function->_return = this.ParseType();
            if function->_return == null { return null; }
        } else {
            if token._type != TokenType::FUNCTION && token._type != TokenType::PUBLIC {
                while (this.Match(TokenType::COLON) && function->constructors.Empty()) || (this.Match(TokenType::COMMA) && !function->constructors.Empty()) {
                    let expression = this.ParseExpression();
                    if expression == null { return null; }

                    if expression->kind == ASTExpressionKind::Call {
                        function->constructors.PushBack(expression as *ASTCallExpression);
                    } else {
                        Logger::Log("Expected a constructor.", token, LogSeverity::Error);
                        break;
                    }
                }
            }
        }

        if this.Current()._type == TokenType::LBRACE {
            let body = this.ParseBlockStatement();
            if body == null { return null; }
            function->body = body;
        } else if !this.ExpectSuccess(TokenType::SEMICOLON) {
            return null;
        } return function;
    }

    fn ParseParameter(&mut this) -> *ASTParameterDeclaration {
        let mutable = this.Match(TokenType::MUT);
        let token = this.Expect(TokenType::IDENTIFIER);
        if token._type == TokenType::UNKNOWN { return null; }
        let mut sizes = Vector<*ASTExpression>();

        while this.Match(TokenType::LBRACKET) {
            if this.Match(TokenType::RBRACKET) {
                sizes.PushBack(null);
            } else {
                let expression = this.ParseExpression();
                if expression == null || !this.ExpectSuccess(TokenType::RBRACKET) { return null; }
                sizes.PushBack(expression);
            }
        }

        if !this.ExpectSuccess(TokenType::COLON) { return null; }
        let mut _type = this.ParseType();
        if _type == null { return null; }

        for size in sizes {
            _type = this.arena.New<ASTArrayType>(_type, size, token);
        }

        return this.arena.New<ASTParameterDeclaration>(token.value, _type, mutable, token);
    }

    fn ParseClassDeclaration(&mut this, attributes: &Vector<Pair<String, Vector<*ASTNode>>>) -> *ASTClassDeclaration {
        let token = this.Expect(TokenType::CLASS);
        if token._type == TokenType::UNKNOWN { return null; }

        for attribute in attributes {
            Logger::Log("Invalid attribute '" + attribute.left + "'.", token, LogSeverity::Error);
            return null;
        }

        let identifier = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { return null; }
        let _class = this.arena.New<ASTClassDeclaration>(identifier.value, token);

        if this.Match(TokenType::LESS) {
            _class->generic = true;

            while this.Current()._type != TokenType::GREATER {
                let type_name = this.Expect(TokenType::IDENTIFIER);
                if type_name._type == TokenType::UNKNOWN { return null; }
                _class->types.PushBack(type_name.value);
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.ExpectSuccess(TokenType::GREATER) {
                return null;
            }
        }

        if this.Match(TokenType::COLON) {
            let _type = this.ParseType();
            if _type == null { return null; }
            _class->parents.PushBack(_type);

            while this.Match(TokenType::COMMA) {
                let _type = this.ParseType();
                if _type == null { return null; }
                _class->parents.PushBack(_type);
            }
        }

        if !this.ExpectSuccess(TokenType::LBRACE) {
            return null;
        }

        let mut state = false;

        if this.Current()._type == TokenType::PUBLIC && this.Peek(1)._type == TokenType::IDENTIFIER && (this.Peek(2)._type == TokenType::COLON || this.Peek(2)._type == TokenType::LBRACKET) {
            state = true;
        }

        if this.Current()._type == TokenType::IDENTIFIER && (this.Peek(1)._type == TokenType::COLON || this.Peek(1)._type == TokenType::LBRACKET) {
            state = true;
        }

        if state {
            while this.Current()._type != TokenType::SEMICOLON && this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                let field = this.ParseField();
                if field == null { return null; }
                _class->fields.PushBack(field);

                if !this.Match(TokenType::COMMA) {
                    break;
                }
            }
        }

        if !state || this.Match(TokenType::SEMICOLON) {
            while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                let attributes = this.ParseAttributes();
                let token = this.Current();
                let function = this.ParseFunctionDeclaration(attributes, true);
                if function == null { return null; }

                if token._type == TokenType::PUBLIC || token._type == TokenType::FUNCTION {
                    _class->methods.PushBack(function);
                } else if token._type != TokenType::TILDE {
                    _class->constructors.PushBack(function);
                } else {
                    if _class->destructor != null {
                        Logger::Log("Multiple destructor declarations are not allowed.", token, LogSeverity::Error);
                        return null;
                    }

                    _class->destructor = function;
                }
            }
        }

        if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
        return _class;
    }

    fn ParseStructureDeclaration(&mut this, attributes: &Vector<Pair<String, Vector<*ASTNode>>>) -> *ASTStructureDeclaration {
        let token = this.Expect(TokenType::STRUCTURE);
        if token._type == TokenType::UNKNOWN { return null; }

        for attribute in attributes {
            Logger::Log("Invalid attribute '" + attribute.left + "'.", token, LogSeverity::Error);
            return null;
        }

        let identifier = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { return null; }
        let structure = this.arena.New<ASTStructureDeclaration>(identifier.value, token);

        if this.Match(TokenType::LESS) {
            structure->generic = true;

            while this.Current()._type != TokenType::GREATER {
                let type_name = this.Expect(TokenType::IDENTIFIER);
                if type_name._type == TokenType::UNKNOWN { return null; }
                structure->types.PushBack(type_name.value);
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.ExpectSuccess(TokenType::GREATER) {
                return null;
            }
        }

        if !this.ExpectSuccess(TokenType::LBRACE) {
            return null;
        }

        let mut state = false;

        if this.Current()._type == TokenType::PUBLIC && this.Peek(1)._type == TokenType::IDENTIFIER && (this.Peek(2)._type == TokenType::COLON || this.Peek(2)._type == TokenType::LBRACKET) {
            state = true;
        }

        if this.Current()._type == TokenType::IDENTIFIER && (this.Peek(1)._type == TokenType::COLON || this.Peek(1)._type == TokenType::LBRACKET) {
            state = true;
        }

        if state {
            while this.Current()._type != TokenType::SEMICOLON && this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                let field = this.ParseField();
                if field == null { return null; }
                structure->fields.PushBack(field);

                if !this.Match(TokenType::COMMA) {
                    break;
                }
            }
        }

        if !state || this.Match(TokenType::SEMICOLON) {
            while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                let attributes = this.ParseAttributes();
                let function = this.ParseFunctionDeclaration(attributes, false);
                if function == null { return null; }
                structure->methods.PushBack(function);
            }
        }

        if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
        return structure;
    }

    fn ParseField(&mut this) -> *ASTFieldDeclaration {
        let public = this.Match(TokenType::PUBLIC);
        let token = this.Expect(TokenType::IDENTIFIER);
        if token._type == TokenType::UNKNOWN { return null; }
        let mut sizes = Vector<*ASTExpression>();

        while this.Match(TokenType::LBRACKET) {
            if this.Match(TokenType::RBRACKET) {
                sizes.PushBack(null);
            } else {
                let expression = this.ParseExpression();
                if expression == null || !this.ExpectSuccess(TokenType::RBRACKET) { return null; }
                sizes.PushBack(expression);
            }
        }

        if !this.ExpectSuccess(TokenType::COLON) { return null; }
        let mut _type = this.ParseType();
        if _type == null { return null; }
        let mut initializer = null;

        for size in sizes {
            _type = this.arena.New<ASTArrayType>(_type, size, token);
        }

        if this.Match(TokenType::ASSIGN) {
            initializer = this.ParseExpression();
            if initializer == null { return null; }
        }

        return this.arena.New<ASTFieldDeclaration>(token.value, _type, initializer, public, token);
    }

    fn ParseEnumerationDeclaration(&mut this, attributes: &Vector<Pair<String, Vector<*ASTNode>>>) -> *ASTEnumerationDeclaration {
        let token = this.Expect(TokenType::ENUMERATION);
        if token._type == TokenType::UNKNOWN { return null; }

        for attribute in attributes {
            Logger::Log("Invalid attribute '" + attribute.left + "'.", token, LogSeverity::Error);
            return null;
        }

        let identifier = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { return null; }
        let enumeration = this.arena.New<ASTEnumerationDeclaration>(identifier.value, token);
        if !this.ExpectSuccess(TokenType::COLON) { return null; }
        enumeration->underlying_type = this.ParseType();
        if enumeration->underlying_type == null { return null; }
        if !this.ExpectSuccess(TokenType::LBRACE) { return null; }

        while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
            let member_identifier = this.Expect(TokenType::IDENTIFIER);
            if member_identifier._type == TokenType::UNKNOWN { return null; }
            let member = this.arena.New<ASTEnumerationMember>(member_identifier.value, member_identifier);

            if this.Match(TokenType::ASSIGN) {
                member->value = this.ParseExpression();
                if member->value == null { return null; }
            }

            enumeration->members.PushBack(member);

            if !this.Match(TokenType::COMMA) {
                break;
            }
        }

        if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
        return enumeration;
    }

    fn ParseExternDeclaration(&mut this) -> *ASTExternDeclaration {
        let extern_token = this.Expect(TokenType::EXTERN);
        if extern_token._type == TokenType::UNKNOWN { return null; }
        let linkage_token = this.Expect(TokenType::STRING);
        if linkage_token._type == TokenType::UNKNOWN { return null; }
        let extern_block = this.arena.New<ASTExternDeclaration>(linkage_token.value, extern_token);
        if !this.ExpectSuccess(TokenType::LBRACE) { return null; }

        while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
            let attributes = this.ParseAttributes();

            if this.Current()._type == TokenType::FUNCTION {
                let function = this.ParseFunctionDeclaration(attributes, false);

                if function == null {
                    this.SynchronizeDeclaration();
                    continue;
                }

                extern_block->declarations.PushBack(function as *ASTDeclaration);
            } else if this.Current()._type == TokenType::STATIC {
                let _static = this.ParseStaticDeclaration(attributes);

                if _static == null {
                    this.SynchronizeDeclaration();
                    continue;
                }

                extern_block->declarations.PushBack(_static as *ASTDeclaration);
            } else {
                Logger::Log("Only function and static declarations allowed in extern block.", this.Current(), LogSeverity::Error);
                this.Advance();
                this.SynchronizeDeclaration();
            }
        }

        if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
        return extern_block;
    }

    fn ParseConstantDeclaration(&mut this) -> *ASTConstantDeclaration {
        let token = this.Expect(TokenType::CONST);
        if token._type == TokenType::UNKNOWN { return null; }
        let identifier = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { return null; }
        let mut sizes = Vector<*ASTExpression>();

        while this.Match(TokenType::LBRACKET) {
            if this.Match(TokenType::RBRACKET) {
                sizes.PushBack(null);
            } else {
                let expression = this.ParseExpression();
                if expression == null || !this.ExpectSuccess(TokenType::RBRACKET) { return null; }
                sizes.PushBack(expression);
            }
        }

        if !this.ExpectSuccess(TokenType::COLON) { return null; }
        let mut _type = this.ParseType();
        if _type == null { return null; }

        for size in sizes {
            _type = this.arena.New<ASTArrayType>(_type, size, token);
        }

        if !this.ExpectSuccess(TokenType::ASSIGN) { return null; }
        let initializer = this.ParseExpression();
        if initializer == null || !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        return this.arena.New<ASTConstantDeclaration>(identifier.value, _type, initializer, token);
    }

    fn ParseStaticDeclaration(&mut this, attributes: &Vector<Pair<String, Vector<*ASTNode>>>) -> *ASTStaticDeclaration {
        let token = this.Expect(TokenType::STATIC);
        if token._type == TokenType::UNKNOWN { return null; }
        let mut alignment = null;

        for attribute in attributes {
            if attribute.left == "align" {
                if attribute.right.Size() != 1 {
                    Logger::Log("Invalid number of arguments for attribute '" + attribute.left + "'.", token, LogSeverity::Error);
                    return null;
                }

                if alignment != null {
                    Logger::Log("Attribute '" + attribute.left + "' already set.", token, LogSeverity::Error);
                    return null;
                }

                alignment = attribute.right[0];
            } else {
                Logger::Log("Invalid attribute '" + attribute.left + "'.", token, LogSeverity::Error);
                return null;
            }
        }

        let mutable = this.Match(TokenType::MUT);
        let identifier = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { return null; }
        let mut sizes = Vector<*ASTExpression>();

        while this.Match(TokenType::LBRACKET) {
            if this.Match(TokenType::RBRACKET) {
                sizes.PushBack(null);
            } else {
                let expression = this.ParseExpression();
                if expression == null || !this.ExpectSuccess(TokenType::RBRACKET) { return null; }
                sizes.PushBack(expression);
            }
        }

        if !this.ExpectSuccess(TokenType::COLON) { return null; }
        let mut _type = this.ParseType();
        if _type == null { return null; }

        for size in sizes {
            _type = this.arena.New<ASTArrayType>(_type, size, token);
        }

        let _static = this.arena.New<ASTStaticDeclaration>(identifier.value, _type, mutable, alignment, token);

        if this.Match(TokenType::ASSIGN) {
            if this.Match(TokenType::ZERO) {
                _static->zero_initializer = true;
            } else {
                _static->initializer = this.ParseExpression();
                if _static->initializer == null { return null; }
            }
        }

        if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        return _static;
    }

    fn ParseTypeDeclaration(&mut this) -> *ASTTypeDeclaration {
        let token = this.Expect(TokenType::TYPE);
        if token._type == TokenType::UNKNOWN { return null; }
        let identifier = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { return null; }
        if !this.ExpectSuccess(TokenType::ASSIGN) { return null; }
        let _type = this.ParseType();
        if _type == null { return null; }
        let type_definition = this.arena.New<ASTTypeDeclaration>(identifier.value, _type, token);
        if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        return type_definition;
    }

    fn ParseAssemblyDeclaration(&mut this) -> *ASTAssemblyDeclaration {
        let token = this.Expect(TokenType::ASSEMBLY);
        if token._type == TokenType::UNKNOWN { return null; }
        let code = this.Expect(TokenType::ASSEMBLY_CODE);
        if code._type == TokenType::UNKNOWN { return null; }
        return this.arena.New<ASTAssemblyDeclaration>(code.value, token);
    }

    pub fn Parse(&mut this, tokens: &Vector<Token>) -> *ASTModule {
        let module = this.arena.New<ASTModule>();
        (this.tokens, this.index) = (tokens, 0);

        while this.Current()._type != TokenType::EOF {
            let declaration = this.ParseDeclaration();

            if declaration != null {
                module->declarations.PushBack(declaration);
            } else {
                this.SynchronizeDeclaration();
            }
        } return module;
    }
}
