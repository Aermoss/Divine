#[include "std/arg" : *]

class Vector2 {
    pub x: f32,
    pub y: f32
}

class Vector3 {
    pub x: f32,
    pub y: f32,
    pub z: f32
}

class Vector4 {
    pub x: f32,
    pub y: f32,
    pub z: f32,
    pub w: f32
}

type Quaternion = Vector4;

class Matrix {
    pub m0: f32, pub m4: f32, pub m8: f32, pub m12: f32,
    pub m1: f32, pub m5: f32, pub m9: f32, pub m13: f32,
    pub m2: f32, pub m6: f32, pub m10: f32, pub m14: f32,
    pub m3: f32, pub m7: f32, pub m11: f32, pub m15: f32
}

class Color {
    pub r: u8,
    pub g: u8,
    pub b: u8,
    pub a: u8 = 255
}

const LIGHTGRAY: Color = { 200, 200, 200 };
const GRAY: Color = { 130, 130, 130 };
const DARKGRAY: Color = { 80, 80, 80 };
const YELLOW: Color = { 253, 249, 0 };
const GOLD: Color = { 255, 203, 0 };
const ORANGE: Color = { 255, 161, 0 };
const PINK: Color = { 255, 109, 194 };
const RED: Color = { 230, 41, 55 };
const MAROON: Color = { 190, 33, 55 };
const GREEN: Color = { 0, 228, 48 };
const LIME: Color = { 0, 158, 47 };
const DARKGREEN: Color = { 0, 117, 44 };
const SKYBLUE: Color = { 102, 191, 255 };
const BLUE: Color = { 0, 121, 241 };
const DARKBLUE: Color = { 0, 82, 172 };
const PURPLE: Color = { 200, 122, 255 };
const VIOLET: Color = { 135, 60, 190 };
const DARKPURPLE: Color = { 112, 31, 126 };
const BEIGE: Color = { 211, 176, 131 };
const BROWN: Color = { 127, 106, 79 };
const DARKBROWN: Color = { 76, 63, 47 };

const WHITE: Color = { 255, 255, 255 };
const BLACK: Color = { 0, 0, 0, 255 };
const BLANK: Color = { 0, 0, 0, 0 };
const MAGENTA: Color = { 255, 0, 255 };
const RAYWHITE: Color = { 245, 245, 245 };

class Rectangle {
    pub x: f32,
    pub y: f32,
    pub width: f32,
    pub height: f32
}

class Image {
    pub data: *mut void,
    pub width: i32,
    pub height: i32,
    pub mipmaps: i32,
    pub format: i32
}

class Texture {
    pub id: u32,
    pub width: i32,
    pub height: i32,
    pub mipmaps: i32,
    pub format: i32
}

type Texture2D = Texture;
type TextureCubemap = Texture;

class RenderTexture {
    pub id: u32,
    pub texture: Texture,
    pub depth: Texture
}

type RenderTexture2D = RenderTexture;

class NPatchInfo {
    pub source: Rectangle,
    pub left: i32,
    pub top: i32,
    pub right: i32,
    pub bottom: i32,
    pub layout: i32
}

class GlyphInfo {
    pub value: i32,
    pub offsetX: i32,
    pub offsetY: i32,
    pub advanceX: i32,
    pub image: Image
}

class Font {
    pub baseSize: i32,
    pub glyphCount: i32,
    pub glyphPadding: i32,
    pub texture: Texture2D,
    pub recs: *mut Rectangle,
    pub glyphs: *mut GlyphInfo
}

class Camera3D {
    pub position: Vector3,
    pub target: Vector3,
    pub up: Vector3,
    pub fovy: f32,
    pub projection: i32
}

type Camera = Camera3D;

class Camera2D {
    pub offset: Vector2,
    pub target: Vector2,
    pub rotation: f32,
    pub zoom: f32
}

class Mesh {
    pub vertexCount: i32,
    pub triangleCount: i32,

    pub vertices: *mut f32,
    pub texcoords: *mut f32,
    pub texcoords2: *mut f32,
    pub normals: *mut f32,
    pub tangents: *mut f32,
    pub colors: *mut u8,
    pub indices: *mut u16,

    pub animVertices: *mut f32,
    pub animNormals: *mut f32,
    pub boneIds: *mut u8,
    pub boneWeights: *mut f32,
    pub boneMatrices: *mut Matrix,
    pub boneCount: i32,

    pub vaoId: u32,
    pub vboId: *mut u32
}

class Shader {
    pub id: u32,
    pub locs: *mut i32
}

class MaterialMap {
    pub texture: Texture2D,
    pub color: Color,
    pub value: f32
}

class Material {
    pub shader: Shader,
    pub maps: *mut MaterialMap,
    pub params[4]: f32
}

class Transform {
    pub translation: Vector3,
    pub rotation: Quaternion,
    pub scale: Vector3
}

class BoneInfo {
    pub name[32]: i8,
    pub parent: i32
}

class Model {
    pub transform: Matrix,

    pub meshCount: i32,
    pub materialCount: i32,
    pub meshes: *mut Mesh,
    pub materials: *mut Material,
    pub meshMaterial: *mut i32,

    pub boneCount: i32,
    pub bones: *mut BoneInfo,
    pub bindPose: *mut Transform
}

class ModelAnimation {
    pub boneCount: i32,
    pub frameCount: i32,
    pub bones: *mut BoneInfo,
    pub framePoses: *mut *mut Transform,
    pub name[32]: i8
}

class Ray {
    pub position: Vector3,
    pub direction: Vector3
}

class RayCollision {
    pub hit: bool,
    pub distance: f32,
    pub point: Vector3,
    pub normal: Vector3
}

class BoundingBox {
    pub min: Vector3,
    pub max: Vector3
}

class Wave {
    pub frameCount: u32,
    pub sampleRate: u32,
    pub sampleSize: u32,
    pub channels: u32,
    pub data: *mut void
}

class rAudioBuffer {}
class rAudioProcessor {}

class AudioStream {
    pub buffer: *mut rAudioBuffer,
    pub processor: *mut rAudioProcessor,

    pub sampleRate: u32,
    pub sampleSize: u32,
    pub channels: u32
}

class Sound {
    pub stream: AudioStream,
    pub frameCount: u32
}

class Music {
    pub stream: AudioStream,
    pub frameCount: u32,
    pub looping: bool,

    pub ctxType: i32,
    pub ctxData: *mut void
}

class VrDeviceInfo {
    pub hResolution: i32,
    pub vResolution: i32,
    pub hScreenSize: f32,
    pub vScreenSize: f32,
    pub eyeToScreenDistance: f32,
    pub lensSeparationDistance: f32,
    pub interpupillaryDistance: f32,
    pub lensDistortionValues[4]: f32,
    pub chromaAbCorrection[4]: f32
}

class VrStereoConfig {
    pub projection[2]: Matrix,
    pub viewOffset[2]: Matrix,
    pub leftLensCenter[2]: f32,
    pub rightLensCenter[2]: f32,
    pub leftScreenCenter[2]: f32,
    pub rightScreenCenter[2]: f32,
    pub scale[2]: f32,
    pub scaleIn[2]: f32
}

class FilePathList {
    pub capacity: u32,
    pub count: u32,
    pub paths: *mut *mut i8
}

class AutomationEvent {
    pub frame: u32,
    pub _type: u32,
    pub params[4]: i32
}

class AutomationEventList {
    pub capacity: u32,
    pub count: u32,
    pub events: *mut AutomationEvent
}

enum ConfigFlags: u32 {
    FLAG_VSYNC_HINT = 0x00000040,
    FLAG_FULLSCREEN_MODE = 0x00000002,
    FLAG_WINDOW_RESIZABLE = 0x00000004,
    FLAG_WINDOW_UNDECORATED = 0x00000008,
    FLAG_WINDOW_HIDDEN = 0x00000080,
    FLAG_WINDOW_MINIMIZED = 0x00000200,
    FLAG_WINDOW_MAXIMIZED = 0x00000400,
    FLAG_WINDOW_UNFOCUSED = 0x00000800,
    FLAG_WINDOW_TOPMOST = 0x00001000,
    FLAG_WINDOW_ALWAYS_RUN = 0x00000100,
    FLAG_WINDOW_TRANSPARENT = 0x00000010,
    FLAG_WINDOW_HIGHDPI = 0x00002000,
    FLAG_WINDOW_MOUSE_PASSTHROUGH = 0x00004000,
    FLAG_BORDERLESS_WINDOWED_MODE = 0x00008000,
    FLAG_MSAA_4X_HINT = 0x00000020,
    FLAG_INTERLACED_HINT = 0x00010000
}

enum TraceLogLevel: i32 {
    LOG_ALL = 0,
    LOG_TRACE,
    LOG_DEBUG,
    LOG_INFO,
    LOG_WARNING,
    LOG_ERROR,
    LOG_FATAL,
    LOG_NONE
}

