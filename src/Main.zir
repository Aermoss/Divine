include "std/io", "std/file", "std/std", "vendor/llvm", "src/Logger.zir", "src/Context.zir", "src/Target.zir",
    "src/Lexer.zir", "src/Preprocessor.zir", "src/Parser.zir", "src/Compiler.zir", "src/Assembler.zir" : *;

#[if WINDOWS]
const INFINITE: u32 = 0xFFFFFFFFu32;

class STARTUPINFOA {
    pub cb: u32,
    pub lpReserved: *mut i8,
    pub lpDesktop: *mut i8,
    pub lpTitle: *mut i8,
    pub dwX: u32,
    pub dwY: u32,
    pub dwXSize: u32,
    pub dwYSize: u32,
    pub dwXCountChars: u32,
    pub dwYCountChars: u32,
    pub dwFillAttribute: u32,
    pub dwFlags: u32,
    pub wShowWindow: u16,
    pub cbReserved2: u16,
    pub lpReserved2: *mut u8,
    pub hStdInput: *mut void,
    pub hStdOutput: *mut void,
    pub hStdError: *mut void
}

type LPSTARTUPINFOA = *mut STARTUPINFOA;

class PROCESS_INFORMATION {
    pub hProcess: *mut void,
    pub hThread: *mut void,
    pub dwProcessId: u32,
    pub dwThreadId: u32
}

type LPPROCESS_INFORMATION = *mut PROCESS_INFORMATION;

extern "C" {
    func QueryPerformanceCounter(lpPerformanceCount: *mut i64) -> i32;
    func QueryPerformanceFrequency(lpFrequency: *mut i64) -> i32;

    func CreateProcessA(lpApplicationName: *const i8, lpCommandLine: *mut i8, lpProcessAttributes: *mut void, lpThreadAttributes: *mut void, bInheritHandles: i32, dwCreationFlags: u32, lpEnvironment: *mut void, lpCurrentDirectory: *const i8, lpStartupInfo: LPSTARTUPINFOA, lpProcessInformation: LPPROCESS_INFORMATION) -> i32;
    func WaitForSingleObject(hHandle: *mut void, dwMilliseconds: u32) -> u32;
    func GetExitCodeProcess(hProcess: *mut void, lpExitCode: *mut u32) -> i32;
    func GetLastError() -> u32;
}

class Timer {
    priv frequency: i64,
    priv counter: i64;

    Timer(&this) {
        QueryPerformanceFrequency(&this.frequency);
    }

    ~Timer(&this) {}

    pub Get(&this) -> f64 {
        QueryPerformanceCounter(&this.counter);
        ret (this.counter as f64) / (this.frequency as f64);
    }
}

func Execute(command: *const i8) -> u32 {
    let mut startup_info: STARTUPINFOA;
    memset(&startup_info as *const void, 0i32, sizeof(startup_info));
    startup_info.cb = sizeof(startup_info) as u32;
    let mut process_info: PROCESS_INFORMATION;

    if CreateProcessA(null, command, null, null, 0i32, 0u32, null, null, &startup_info, &process_info) == 0i32 {
        WriteLine("\x1b[31mFailed to create process: " + String(GetLastError() as i64) + ".\x1b[0m");
        Exit(1i32);
    }

    let mut exit_code: u32 = 0u32;
    WaitForSingleObject(process_info.hProcess, INFINITE);

    if GetExitCodeProcess(process_info.hProcess, &exit_code) == 0i32 {
        WriteLine("\x1b[31mFailed to get process exit code: " + String(GetLastError() as i64) + ".\x1b[0m");
    }

    CloseHandle(process_info.hProcess);
    CloseHandle(process_info.hThread);
    ret exit_code;
}
#[else]
class _TimeSpec {
    pub sec: i64,
    pub nsec: i64
}

class _SHArgs {
    pub sh: *const i8,
    pub flag: *const i8,
    pub cmd: *const i8,
    pub end: *const i8
}

class _NullEnv {
    pub end: *const i8
}

extern "C" {
    func clock_gettime(clk_id: i32, tp: *mut _TimeSpec) -> i32 #[if DARWIN] ; #[else] {
        let mut result: i64 = 0i64;
        let _clk_id: i64 = clk_id as i64;

        volatile asm : rax(228i64), rdi(_clk_id), rsi(tp) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        ret result as i32;
    } #[endif]

    func fork() -> i32 #[if DARWIN] ; #[else] {
        let mut result: i64 = 0i64;

        volatile asm : rax(57i64) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        ret result as i32;
    } #[endif]

    func execve(path: *const i8, argv: *const *const i8, envp: *const *const i8) -> i32 #[if DARWIN] ; #[else] {
        let mut result: i64 = 0i64;

        volatile asm : rax(59i64), rdi(path), rsi(argv), rdx(envp) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        ret result as i32;
    } #[endif]

    func waitpid(pid: i32, status: *mut i32, options: i32) -> i32 #[if DARWIN] ; #[else] {
        let mut result: i64 = 0i64;
        let _pid: i64 = pid as i64;
        let _options: i64 = options as i64;

        volatile asm : rax(61i64), rdi(_pid), rsi(status), rdx(_options) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        ret result as i32;
    } #[endif]
}

class Timer {
    priv dummy: i64;

    Timer(&mut this) { this.dummy = 0i64; }
    ~Timer(&mut this) {}

    pub Get(&this) -> f64 {
        let mut ts: _TimeSpec;
        (ts.sec, ts.nsec) = (0i64, 0i64);
        clock_gettime(0i32, &ts);
        ret (ts.sec as f64) + (ts.nsec as f64) / 1000000000.0f64;
    }
}

func Execute(command: *const i8) -> u32 {
    let mut shargs: _SHArgs;
    shargs.sh = "/bin/sh";
    shargs.flag = "-c";
    shargs.cmd = command;
    shargs.end = null;
    let mut nullenv: _NullEnv;
    nullenv.end = null;
    let pid: i32 = fork();

    if pid == 0i32 {
        execve(shargs.sh, &shargs as *const *const i8, &nullenv as *const *const i8);
        Exit(1i32);
    }

    let mut status: i32 = 0i32;
    waitpid(pid, &status, 0i32);
    ret ((status >> 8i32) & 0xFFi32) as u32;
}
#[endif]

#[if WINDOWS]
func GetWindowsSDKPath() -> String {
    let mut path: String = "C:\\Program Files (x86)\\Windows Kits\\10\\Lib";

    let mut find_data: WIN32_FIND_DATAA;
    let find_handle: *mut void = FindFirstFileA((path + "\\*").Data(), &find_data);

    if find_handle == INVALID_HANDLE_VALUE {
        WriteLine("\x1b[31mFailed to find Windows SDK path.\x1b[0m");
        Exit(1i32);
    }

    let mut highest_version_string: String = "";
    let (mut highest_v1: u64, mut highest_v2: u64) = (0u64, 0u64);
    let (mut highest_v3: u64, mut highest_v4: u64) = (0u64, 0u64);

    loop {
        if (find_data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0u32 {
            let file_name: String = find_data.cFileName;

            if file_name != "." && file_name != ".." && file_name != "wdf" {
                let parts: Vector<String> = file_name.Split('.');
                let (mut parsed_v1: u64, mut parsed_v2: u64, mut parsed_v3: u64, mut parsed_v4: u64) = (0u64, 0u64, 0u64, 0u64);

                if parts.Size() == 4u64 {
                    (parsed_v1, parsed_v2, parsed_v3, parsed_v4) = (parts[0u64].ToInteger() as u64, parts[1u64].ToInteger() as u64, parts[2u64].ToInteger() as u64, parts[3u64].ToInteger() as u64);
                } else {
                    WriteLine("\x1b[31mFailed to parse Windows SDK version.\x1b[0m");
                    Exit(1i32);
                }

                if parsed_v1 > highest_v1 || (parsed_v1 == highest_v1 && parsed_v2 > highest_v2) || (parsed_v1 == highest_v1 && parsed_v2 == highest_v2 && parsed_v3 > highest_v3) || (parsed_v1 == highest_v1 && parsed_v2 == highest_v2 && parsed_v3 == highest_v3 && parsed_v4 > highest_v4) {
                    (highest_version_string, highest_v1, highest_v2, highest_v3, highest_v4) = (file_name, parsed_v1, parsed_v2, parsed_v3, parsed_v4);
                }
            }
        }

        if FindNextFileA(find_handle, &find_data) == 0i32 {
            break;
        }
    }

    if highest_version_string != "" {
        path += "\\";
        path += highest_version_string;
    } else {
        WriteLine("\x1b[31mFailed to find a valid Windows SDK version.\x1b[0m");
        Exit(1i32);
    }

    FindClose(find_handle);
    ret path;
}

func GetMSVCPath() -> String {
    let mut path: String = "C:\\Program Files\\Microsoft Visual Studio";

    let mut find_data: WIN32_FIND_DATAA;
    let find_handle: *mut void = FindFirstFileA((path + "\\*").Data(), &find_data);

    if find_handle == INVALID_HANDLE_VALUE {
        WriteLine("\x1b[31mFailed to find Visual Studio path.\x1b[0m");
        Exit(1i32);
    }

    let mut highest_version_string: String = "";
    let mut highest_version: u64 = 0u64;

    loop {
        if (find_data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0u32 {
            let file_name: String = find_data.cFileName;

            if file_name != "." && file_name != ".." {
                let mut parsed_version: u64 = file_name.ToInteger() as u64;

                if parsed_version == 2017u64 { parsed_version = 15u64; }
                else if parsed_version == 2019u64 { parsed_version = 16u64; }
                else if parsed_version == 2022u64 { parsed_version = 17u64; }

                if parsed_version > highest_version {
                    (highest_version_string, highest_version) = (file_name, parsed_version);
                }
            }
        }

        if FindNextFileA(find_handle, &find_data) == 0i32 {
            break;
        }
    }

    if highest_version_string != "" {
        path += "\\";
        path += highest_version_string;
    } else {
        WriteLine("\x1b[31mFailed to find a valid Visual Studio version.\x1b[0m");
        Exit(1i32);
    }

    FindClose(find_handle);
    let mut find_data2: WIN32_FIND_DATAA;
    let find_handle2: *mut void = FindFirstFileA((path + "\\*").Data(), &find_data2);

    if find_handle2 == INVALID_HANDLE_VALUE {
        WriteLine("\x1b[31mFailed to find Visual Studio path.\x1b[0m");
        Exit(1i32);
    }

    loop {
        if (find_data2.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0u32 {
            let file_name: String = find_data2.cFileName;

            if file_name != "." && file_name != ".." {
                path += "\\";
                path += file_name;
                path += "\\VC\\Tools\\MSVC";
                break;
            }
        }

        if FindNextFileA(find_handle2, &find_data2) == 0i32 {
            break;
        }
    }

    FindClose(find_handle2);
    let mut find_data3: WIN32_FIND_DATAA;
    let find_handle3: *mut void = FindFirstFileA((path + "\\*").Data(), &find_data3);

    if find_handle3 == INVALID_HANDLE_VALUE {
        WriteLine("\x1b[31mFailed to find MSVC path.\x1b[0m");
        Exit(1i32);
    }

    let mut highest_version_string2: String = "";
    let (mut highest_v1: u64, mut highest_v2: u64) = (0u64, 0u64);
    let (mut highest_v3: u64, mut highest_v4: u64) = (0u64, 0u64);

    loop {
        if (find_data3.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0u32 {
            let file_name: String = find_data3.cFileName;

            if file_name != "." && file_name != ".." {
                let parts: Vector<String> = file_name.Split('.');
                let (mut parsed_v1: u64, mut parsed_v2: u64, mut parsed_v3: u64) = (0u64, 0u64, 0u64);

                if parts.Size() == 3u64 {
                    (parsed_v1, parsed_v2, parsed_v3) = (parts[0u64].ToInteger() as u64, parts[1u64].ToInteger() as u64, parts[2u64].ToInteger() as u64);
                } else {
                    WriteLine("\x1b[31mFailed to parse MSVC version.\x1b[0m");
                    Exit(1i32);
                }

                if parsed_v1 > highest_v1 || (parsed_v1 == highest_v1 && parsed_v2 > highest_v2) || (parsed_v1 == highest_v1 && parsed_v2 == highest_v2 && parsed_v3 > highest_v3) {
                    (highest_version_string2, highest_v1, highest_v2, highest_v3) = (file_name, parsed_v1, parsed_v2, parsed_v3);
                }
            }
        }

        if FindNextFileA(find_handle3, &find_data3) == 0i32 {
            break;
        }
    }

    if highest_version_string2 != "" {
        path += "\\";
        path += highest_version_string2;
    } else {
        WriteLine("\x1b[31mFailed to find a valid MSVC version.\x1b[0m");
        Exit(1i32);
    }

    FindClose(find_handle3);
    ret path;
}
#[endif]

func PrintVersion(executable: String) {
    WriteLine("Unversioned build of " + executable + " (" + LLVMGetDefaultTargetTriple() + ").");
    WriteLine("Copyright (c) 2025-2026 Yusuf Rençber. All rights reserved.");
    WriteLine("This software is licensed under the Apache License, Version 2.0.");
    WriteLine("See the LICENSE file in the project root for more information.");
}

func PrintUsage(executable: String) {
    WriteLine("OVERVIEW: Zircon compiler");
    WriteLine("USAGE: " + executable + " [options] <inputs>");
    WriteLine("OPTIONS:");
    WriteLine("  -o <file>                Write output to <file>");
    WriteLine("  -I <dir>                 Add directory to include search path");
    WriteLine("  -L <dir>                 Add directory to library search path");
    WriteLine("  -l <name>                Link against library <name>");
    WriteLine("  -D <macro>               Define a macro");
    WriteLine("  -O<level>, -O            Optimization level (0, 1, 2, 3) [-O defaults to -O2]");
    WriteLine("  -g                       Enable debug information");
    WriteLine("  -c                       Only run preprocess, compile, and assemble steps");
    WriteLine("  -S                       Only run preprocess and compilation steps");
    WriteLine("  -emit-llvm               Emit LLVM intermediate representation");
    WriteLine("  -emit-bc                 Emit LLVM bitcode");
    WriteLine("  -check, -fsyntax-only    Check code for errors, but do not emit code");
    WriteLine("  -target <triple>         Generate code for the given target");
    WriteLine("  -march <arch>            Architecture to generate code for");
    WriteLine("  -mcmodel <model>         Code model (tiny, small, medium, large, kernel)");
    WriteLine("  -ffreestanding           Assert that the compilation takes place in a freestanding environment");
    WriteLine("  -mno-red-zone            Do not use the red-zone for x86-64 code");
    WriteLine("  -mgeneral-regs-only      Generate code which only uses the general-purpose registers");
    WriteLine("  -r, --run                Run the program after compiling");
    WriteLine("  -v, --verbose            Show commands to run and use verbose output");
    WriteLine("  --version                Display compiler version");
    WriteLine("  -h, --help               Display this help message");
}

func ErrorHandler(reason: *const i8) {
    WriteLine("\x1b[31mLLVM: Fatal Error: " + reason.ToString() + "\x1b[0m");
    Exit(1i32);
}

func main(args: &mut Vector<String>) -> i32 {
    let mut logger: Logger;

    LLVMEnablePrettyStackTrace();
    LLVMInstallFatalErrorHandler(ErrorHandler);

    LLVMInitializeAllTargetInfos();
    LLVMInitializeAllTargets();
    LLVMInitializeAllTargetMCs();
    LLVMInitializeAllAsmPrinters();
    LLVMInitializeAllAsmParsers();
    LLVMInitializeAllDisassemblers();

    let executable: String = SplitPath(args[0u64]).right;

    if args.Size() < 2u64 {
        PrintUsage(executable);
        ret 1i32;
    }

    let (mut input_files: Vector<String>, mut output_file: String);
    let (mut include_paths: Vector<String>, mut lib_paths: Vector<String>);
    let (mut defines: Vector<String>, mut libs: Vector<String>);

    include_paths.PushBack(String("."));
    include_paths.PushBack(String("include"));

    let mut opt_level: LLVMCodeGenOptLevel = LLVMCodeGenOptLevel::LLVMCodeGenLevelLess;
    let (mut triple: String, mut arch: String, mut code_model: String, mut features: String) = (LLVMGetDefaultTargetTriple(), "generic", "default", "");
    let (mut emit_object: bool, mut emit_asm: bool, mut emit_llvm: bool, mut emit_bc: bool) = (false, false, false, false);
    let (mut run: bool, mut debug: bool, mut verbose: bool, mut check: bool) = (false, false, false, false);
    let (mut freestanding: bool, mut no_red_zone: bool) = (false, false);
    let mut i: u64 = 1u64;

    while i < args.Size() {
        let arg: &String = args[i];

        if arg == "--help" || arg == "-h" {
            PrintUsage(executable);
            ret 0i32;
        } else if arg == "--version" {
            PrintVersion(executable);
            ret 0i32;
        } else if arg == "-v" || arg == "--verbose" {
            verbose = true;
        } else if arg == "-check" || arg == "-fsyntax-only" {
            check = true;
        } else if arg == "-g" || arg == "--debug" {
            debug = true;
        } else if arg == "-c" {
            emit_object = true;
        } else if arg == "-S" {
            emit_asm = true;
        } else if arg == "-emit-llvm" {
            emit_llvm = true;
        } else if arg == "-emit-bc" {
            emit_bc = true;
        } else if arg == "-ffreestanding" {
            freestanding = true;
        } else if arg == "-mno-red-zone" {
            no_red_zone = true;
        } else if arg == "-mgeneral-regs-only" {
            if !features.Empty() { features += ","; }
            features += "+nofp,+nosimd";

            if triple.Contains("aarch64") || triple.Contains("arm64") {
                features += ",+fixed-x18";
            }
        } else if arg == "-r" || arg == "--run" {
            run = true;
        } else if arg == "-O0" {
            opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelNone;
        } else if arg == "-O1" {
            opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelLess;
        } else if arg == "-O2" || arg == "-O" {
            opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelDefault;
        } else if arg == "-O3" {
            opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelAggressive;
        } else if arg == "-o" {
            i += 1u64;

            if i < args.Size() {
                output_file = args[i];
            } else {
                Logger::Log(executable, "Missing argument to '-o'.", LogSeverity::Error);
                ret 1i32;
            }
        } else if arg.StartsWith("-I") {
            let mut path: String = arg.SubString(2u64);

            if path.Empty() {
                i += 1u64;

                if i < args.Size() {
                    path = args[i];
                } else {
                    Logger::Log(executable, "Missing argument to '-I'.", LogSeverity::Error);
                    ret 1i32;
                }
            }

            include_paths.PushBack(path);
        } else if arg.StartsWith("-L") {
            let mut path: String = arg.SubString(2u64);

            if path.Empty() {
                i += 1u64;

                if i < args.Size() {
                    path = args[i];
                } else {
                    Logger::Log(executable, "Missing argument to '-L'.", LogSeverity::Error);
                    ret 1i32;
                }
            }

            lib_paths.PushBack(path);
        } else if arg.StartsWith("-l") {
            let mut name: String = arg.SubString(2u64);

            if name.Empty() {
                i += 1u64;

                if i < args.Size() {
                    name = args[i];
                } else {
                    Logger::Log(executable, "Missing argument to '-l'.", LogSeverity::Error);
                    ret 1i32;
                }
            }

            libs.PushBack(name);
        } else if arg.StartsWith("-D") {
            let mut define: String = arg.SubString(2u64);

            if define.Empty() {
                i += 1u64;

                if i < args.Size() {
                    define = args[i];
                } else {
                    Logger::Log(executable, "Missing argument to '-D'.", LogSeverity::Error);
                    ret 1i32;
                }
            }

            defines.PushBack(define);
        } else if arg == "-target" {
            i += 1u64;

            if i < args.Size() {
                triple = args[i];
            } else {
                Logger::Log(executable, "Missing argument to '-target'.", LogSeverity::Error);
                ret 1i32;
            }
        } else if arg == "-march" {
            i += 1u64;

            if i < args.Size() {
                arch = args[i];
            } else {
                Logger::Log(executable, "Missing argument to '-march'.", LogSeverity::Error);
                ret 1i32;
            }
        } else if arg == "-mcmodel" {
            i += 1u64;

            if i < args.Size() {
                code_model = args[i];
            } else {
                Logger::Log(executable, "Missing argument to '-mcmodel'.", LogSeverity::Error);
                ret 1i32;
            }
        } else if arg.StartsWith("-") {
            Logger::Log(executable, "Unknown option '" + arg + "'.", LogSeverity::Error);
            ret 1i32;
        } else {
            if FileExists(arg) {
                input_files.PushBack(arg);
            } else {
                Logger::Log(executable, "Cannot find '" + arg + "'.", LogSeverity::Error);
                ret 1i32;
            }
        } i += 1u64;
    }

    if input_files.Empty() {
        Logger::Log(executable, "No input files.", LogSeverity::Error);
        ret 1i32;
    }

    if !output_file.Empty() && input_files.Size() > 1u64 && (emit_object || emit_asm) {
        Logger::Log(executable, "Cannot specify '-o' when generating multiple output files.", LogSeverity::Error);
        ret 1i32;
    }

    if triple.Contains("windows") {
        defines.PushBack(String("WINDOWS"));
    } else if triple.Contains("darwin") || triple.Contains("apple") {
        defines.PushBack(String("DARWIN"));
    } else if triple.Contains("linux") {
        defines.PushBack(String("LINUX"));
    }

    if triple.Contains("x86_64") {
        defines.PushBack(String("AMD64"));
    } else if triple.Contains("aarch64") || triple.Contains("arm64") {
        defines.PushBack(String("ARM64"));
    }

    let timer: Timer;
    let start: f64 = timer.Get();
    let mut objects: Vector<String>;
    let mut temp_files: Vector<String>;
    let temp_path: String = GetTemporaryPath();
    if temp_path.Empty() { ret 1i32; }
    let mut failed: bool = false;

    let context: Context;
    let target: Target = { triple, arch, code_model, features, opt_level };
    let mut j: u64 = 0u64;

    while j < input_files.Size() {
        let input_file: String = input_files[j];
        let parts: Pair<String, String> = SplitExtension(input_file);
        let extension: &String = parts.right;
        let name: &String = parts.left;

        let mut module: LLVMModuleRef = null;
        let mut compiler: Compiler = { context, target, freestanding, no_red_zone };
        let mut assembler: Assembler = { context, target };

        if extension == ".zir" {
            if verbose {
                Logger::Log(executable, "Compiling: '" + input_file + "'.", LogSeverity::Info);
            }

            let mut lexer: Lexer;
            let mut preprocessor: Preprocessor;
            preprocessor.include_paths = include_paths;
            preprocessor.defines = defines;

            let mut source: String = _ReadFile(input_file);
            if j == 0u64 && !check && !freestanding { source += "\n#[include \"src/Start.zir\" : *]\n"; }
            let tokens: Vector<Token> = preprocessor.Process(lexer.Lex(source, input_file), input_file);

            let mut parser: Parser;
            let ast: *const RootNode = parser.Parse(tokens);
            module = compiler.Compile(ast, input_file);
        } else if extension == ".ll" || extension == ".bc" {
            if verbose {
                Logger::Log(executable, "Compiling: '" + input_file + "'.", LogSeverity::Info);
            }

            let mut buffer: LLVMMemoryBufferRef = null;
            let mut message: *mut i8 = null;

            if LLVMCreateMemoryBufferWithContentsOfFile(input_file.Data(), &mut buffer, &mut message) != 0i32 {
                let final_message: *const i8 = message != null ? message : "Unknown reason.";
                Logger::Log(input_file, "Failed to read file: " + final_message.ToString(), LogSeverity::Error);
            }

            if message != null {
                LLVMDisposeMessage(message);
                message = null;
            }

            if buffer != null {
                if extension == ".ll" {
                    if LLVMParseIRInContext(context.context, buffer, &mut module, &mut message) != 0i32 {
                        let final_message: *const i8 = message != null ? message : "Unknown reason.";
                        Logger::Log(input_file, "Failed to parse LLVM IR: " + final_message.ToString(), LogSeverity::Error);
                    }
                } else {
                    if LLVMParseBitcodeInContext(context.context, buffer, &mut module, &mut message) != 0i32 {
                        let final_message: *const i8 = message != null ? message : "Unknown reason.";
                        Logger::Log(input_file, "Failed to parse bitcode: " + final_message.ToString(), LogSeverity::Error);
                    }
                }

                if message != null {
                    LLVMDisposeMessage(message);
                    message = null;
                }
            }

            if module != null {
                LLVMSetSourceFileName(module, input_file.Data(), input_file.Length());
                LLVMSetModuleDataLayout(module, target.layout);
                LLVMSetTarget(module, target.triple.Data());

                if LLVMVerifyModule(module, LLVMVerifierFailureAction::LLVMReturnStatusAction, &mut message) != 0i32 {
                    let final_message: *const i8 = message != null ? message : "Unknown reason.";
                    Logger::Log(input_file, "Module verification failed: " + final_message.ToString(), LogSeverity::Error);
                    LLVMDisposeModule(module);
                    module = null;
                }

                if message != null {
                    LLVMDisposeMessage(message);
                }
            }
        } else if extension == ".asm" || extension == ".s" {
            if emit_asm {
                Logger::Log(executable, "Skipping input: '" + input_file + "'.", LogSeverity::Warning);
                j += 1u64;
                continue;
            }

            if verbose {
                Logger::Log(executable, "Assembling: '" + input_file + "'.", LogSeverity::Info);
            } module = assembler.Assemble(_ReadFile(input_file), input_file);
        } else if extension == ".obj" || extension == ".o" {
            j += 1u64;

            if emit_object {
                Logger::Log(executable, "Skipping input: '" + input_file + "'.", LogSeverity::Warning);
            } else {
                objects.PushBack(input_file);
            } continue;
        } else {
            Logger::Log(input_file, "Unsupported file extension '" + extension + "'.", LogSeverity::Error);
        }

        failed |= module == null;

        if check || failed {
            j += 1u64;

            if !check {
                Logger::Clear();
            } continue;
        }

        if opt_level != LLVMCodeGenOptLevel::LLVMCodeGenLevelNone && extension == ".zir" {
            let mut passes: String;

            if opt_level == LLVMCodeGenOptLevel::LLVMCodeGenLevelLess {
                passes = "default<O1>";
            } else if opt_level == LLVMCodeGenOptLevel::LLVMCodeGenLevelDefault {
                passes = "default<O2>";
                Logger::Log(input_file, "Optimizing at default level which may break your program in this version. (\x1b[36m-O2\x1b[0m)", LogSeverity::Warning);
            } else if opt_level == LLVMCodeGenOptLevel::LLVMCodeGenLevelAggressive {
                passes = "default<O3>";
                Logger::Log(input_file, "Optimizing at aggressive level which may break your program in this version. (\x1b[36m-O3\x1b[0m)", LogSeverity::Warning);
            }

            if passes.Size() > 1u64 {
                let pass_options: LLVMPassBuilderOptionsRef = LLVMCreatePassBuilderOptions();
                let error: LLVMErrorRef = LLVMRunPasses(module, passes.Data(), target.target_machine, pass_options);
                LLVMDisposePassBuilderOptions(pass_options);

                if error != LLVMErrorSuccess {
                    let message: *const i8 = LLVMGetErrorMessage(error);
                    Logger::Log(input_file, "Failed to optimize module: " + message.ToString(), LogSeverity::Error);
                    LLVMDisposeErrorMessage(message);
                    ret 1i32;
                }
            }
        }

        if emit_llvm && extension != ".ll" {
            let mut message: *mut i8 = null;

            if LLVMPrintModuleToFile(module, (name + ".ll").Data(), &mut message) != 0i32 {
                let final_message: *const i8 = message != null ? message : "Unknown reason.";
                Logger::Log(input_file, "Failed to emit LLVM IR: " + final_message.ToString(), LogSeverity::Error);
            }

            if message != null {
                LLVMDisposeMessage(message);
            }
        }

        if emit_bc && extension != ".bc" {
            if LLVMWriteBitcodeToFile(module, (name + ".bc").Data()) != 0i32 {
                Logger::Log(input_file, "Failed to emit LLVM bitcode.", LogSeverity::Error);
            }
        }

        if emit_asm {
            let mut asm_name: String = name + ".s";
            if !output_file.Empty() { asm_name = output_file; }
            let result: String = target.Emit(module, asm_name, LLVMCodeGenFileType::LLVMAssemblyFile);
            j += 1u64;

            if !result.Empty() {
                Logger::Log(input_file, "Failed to emit assembly: " + result, LogSeverity::Error);
                ret 1i32;
            } continue;
        }

        let mut object_name: String = name + (triple.Contains("windows") ? ".obj" : ".o");

        if !emit_object {
            object_name = JoinPath(temp_path, SplitPath(object_name).right);
        } else if !output_file.Empty() {
            object_name = output_file;
        }

        let result: String = target.Emit(module, object_name, LLVMCodeGenFileType::LLVMObjectFile);

        if !result.Empty() {
            Logger::Log(input_file, "Failed to emit object: " + result, LogSeverity::Error);
            ret 1i32;
        }

        objects.PushBack(object_name);

        if !emit_object {
            temp_files.PushBack(object_name);
        } j += 1u64;
    }

    if check || failed || emit_object || emit_asm {
        let mut i: u64 = 0u64;

        while i < temp_files.Size() {
            RemoveFile(temp_files[i]);
            i += 1u64;
        }

        ret failed ? 1i32 : 0i32;
    }

    if output_file.Empty() {
        output_file = SplitExtension(input_files[0u64]).left;
        if triple.Contains("windows") { output_file += ".exe"; }
    }

#[if WINDOWS]
    let lld_exe: String = "ld.lld.exe";
    let lld64_exe: String = "ld64.lld.exe";
    let lld_link_exe: String = "lld-link.exe";
#[else]
    let lld_exe: String = "ld.lld";
    let lld64_exe: String = "ld64.lld";
    let lld_link_exe: String = "lld-link";
#[endif]
    let mut command: String;

    if triple.Contains("windows") {
#[if WINDOWS]
        let (sdk_path: String, msvc_path: String) = (GetWindowsSDKPath(), GetMSVCPath());
        command = "\"" + msvc_path + "\\bin\\Hostx64\\x64\\link.exe\" /NOLOGO /SUBSYSTEM:CONSOLE /NODEFAULTLIB /ENTRY:_start";
        if debug { command += " /DEBUG"; }
        command += " /OUT:" + output_file;
        let (mut i: u64, mut j: u64, mut k: u64) = (0u64, 0u64, 0u64);
        while i < objects.Size() { command += " " + objects[i]; i += 1u64; }

        if !freestanding {
            command += " \"/LIBPATH:" + msvc_path + "\\lib\\x64\"";
            command += " \"/LIBPATH:" + sdk_path + "\\um\\x64\"";
            command += " \"/LIBPATH:" + sdk_path + "\\ucrt\\x64\"";
            while j < lib_paths.Size() { command += " \"/LIBPATH:" + lib_paths[j] + "\""; j += 1u64; }
            command += " user32.lib shell32.lib kernel32.lib";
            while k < libs.Size() { command += " " + libs[k] + ".lib"; k += 1u64; }
        }
#[else]
        Logger::Log(executable, "Cannot link to windows from another platform.", LogSeverity::Error);
        ret 1i32;
#[endif]
    } else if triple.Contains("darwin") || triple.Contains("apple") {
        Logger::Log(executable, "Cannot link to darwin.", LogSeverity::Error);
        ret 1i32;
    } else if triple.Contains("linux") {
        command = lld_exe + " --nostdlib --entry _start";
        if !freestanding { command += " --dynamic-linker /lib64/ld-linux-x86-64.so.2"; }
        command += " -o " + output_file;
        let (mut i: u64, mut j: u64, mut k: u64) = (0u64, 0u64, 0u64);
        while i < objects.Size() { command += " " + objects[i]; i += 1u64; }
        while j < lib_paths.Size() { command += " -L" + lib_paths[j]; j += 1u64; }
        while k < libs.Size() { command += " -l" + libs[k]; k += 1u64; }
    } else {
        Logger::Log(executable, "Invalid target: '" + triple + "'.", LogSeverity::Error);
        ret 1i32;
    }

    if verbose {
        Logger::Log(executable, "Link: '" + command.Replace("\"", "") + "'.", LogSeverity::Info);
    }

    Execute(command.Data());
    WriteLine("Program compiled in " + String(timer.Get() - start) + " seconds.");
    let mut k: u64 = 0u64;

    while k < temp_files.Size() {
        RemoveFile(temp_files[k]);
        k += 1u64;
    }

    if run {
#[if !WINDOWS]
        if SplitPath(output_file).left.Empty() { output_file = JoinPath(String("."), output_file); }
#[endif]
        WriteLine("Program finished with exit code: " + String(Execute(output_file.Data()) as i64) + ".");
    } ret 0i32;
}
