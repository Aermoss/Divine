func AtomicFetchNot8(target: *mut u8) -> u8 {
    let mut old: u8 = AtomicLoad8(target);

    loop {
        if AtomicCompareExchangeBool8(target, old, !old) {
            break;
        }

        old = AtomicLoad8(target);
        AtomicPause();
    } ret old;
}

