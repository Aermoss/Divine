    pub name: String,
    pub _type: *ASTType;

    ASTTypeDeclaration(&mut this, name: String, _type: *ASTType, start: Token) : ASTDeclaration(ASTDeclarationKind::Type, start) {
        (this.name, this._type) = (name, _type);
    }
}

