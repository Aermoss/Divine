#[include "vendor/llvm", "src/Logger.zir" : *]

class Context {
    pub context: LLVMContextRef;

    Context(&mut this) {
        if context != null {
            Logger::Log("Another instance of 'Context' already exists!", LogSeverity::Fatal);
        }

        (context, this.context) = (this, LLVMContextCreate());
    }

    ~Context(&mut this) {
        LLVMContextDispose(this.context);
    }
}

static mut context: *mut Context = null;
