#[include "std/str", "src/Types.zir" : *]

enum SymbolKind: i32 {
    Variable, GlobalVariable, Constant, Parameter, Variant,

    Declaration, Generic, Type
}

class Symbol {
    pub kind: SymbolKind,
    pub value: SemanticValue,
    pub declaration: *HIRDeclaration = null,
    pub generic: *mut Generic = null;

    Symbol(&mut this, kind: SymbolKind, value: &SemanticValue) {
        (this.kind, this.value) = (kind, value);
    }

    Symbol(&mut this, declaration: *HIRDeclaration) {
        (this.kind, this.declaration) = (SymbolKind::Declaration, declaration);
    }

    Symbol(&mut this, generic: *mut Generic) {
        (this.kind, this.generic) = (SymbolKind::Generic, generic);
    }
}
