class SharedControlBlock<T> {
    pub ptr: *mut T = null,
    pub strong: u64 = 1u64,
    pub weak: u64 = 0u64;

    SharedControlBlock(&mut this, ptr: *mut T) {
        this.ptr = ptr;
    }
}

class Shared<T> {
    pub control: *mut SharedControlBlock<T> = null;

    Shared(&mut this) {}

    Shared(&mut this, args...) {
        this.control = new SharedControlBlock<T>(new T(args...));
    }

    Shared(&mut this, ptr: *mut T) {
        if ptr != null {
            this.control = new SharedControlBlock<T>(ptr);
        }
    }

    Shared(&mut this, other: &Shared<T>) {
        this.control = other.control;

        if this.control != null {
            this.control->strong += 1u64;
        }
    }

    ~Shared(&mut this) {
        this.Release();
    }

    priv Release(&mut this) {
        if this.control == null { ret; }
        this.control->strong -= 1u64;

        if this.control->strong == 0u64 {
            del this.control->ptr;
            this.control->ptr = null;

            if this.control->weak == 0u64 {
                del this.control;
            }
        }

        this.control = null;
    }

    pub Ptr(&this) -> *mut T {
        if this.control == null { ret null; }
        ret this.control->ptr;
    }

    pub StrongCount(&this) -> u64 {
        if this.control == null { ret 0u64; }
        ret this.control->strong;
    }

    pub WeakCount(&this) -> u64 {
        if this.control == null { ret 0u64; }
        ret this.control->weak;
    }

    pub Valid(&this) -> bool {
        ret this.Ptr() != null;
    }

    pub op->(&this) -> *mut T {
        ret this.Ptr();
    }

    pub op*(&this) -> &mut T {
        ret *this.Ptr();
    }

    pub op=(&mut this, other: &Shared<T>) -> &mut Shared<T> {
        if &this != &other {
            this.Release();
            this.control = other.control;

            if this.control != null {
                this.control->strong += 1u64;
            }
        } ret this;
    }

    pub op!=(&this, other: &Shared<T>) -> bool {
        ret this.Ptr() != other.Ptr();
    }

    pub op==(&this, other: &Shared<T>) -> bool {
        ret this.Ptr() == other.Ptr();
    }

    pub op!=(&this, other: *const T) -> bool {
        ret this.Ptr() != other;
    }

    pub op==(&this, other: *const T) -> bool {
        ret this.Ptr() == other;
    }

    pub ToWeak(&this) -> Weak<T> {
        let mut result: Weak<T>;
        result.control = this.control;

        if result.control != null {
            result.control->weak += 1u64;
        } ret result;
    }
}

class Weak<T> {
    pub control: *mut SharedControlBlock<T> = null;

    Weak(&mut this) {}

    Weak(&mut this, shared: &Shared<T>) {
        this.control = shared.control;

        if this.control != null {
            this.control->weak += 1u64;
        }
    }

    Weak(&mut this, other: &Weak<T>) {
        this.control = other.control;

        if this.control != null {
            this.control->weak += 1u64;
        }
    }

    ~Weak(&mut this) {
        this.Release();
    }

    priv Release(&mut this) {
        if this.control == null { ret; }
        this.control->weak -= 1u64;

        if this.control->weak == 0u64 &&
            this.control->strong == 0u64 {
            del this.control;
        }

        this.control = null;
    }

    pub Expired(&this) -> bool {
        if this.control == null { ret true; }
        ret this.control->strong == 0u64;
    }

    pub Lock(&this) -> Shared<T> {
        let mut result: Shared<T>;

        if !this.Expired() {
            result.control = this.control;
            result.control->strong += 1u64;
        } ret result;
    }

    pub StrongCount(&this) -> u64 {
        if this.control == null { ret 0u64; }
        ret this.control->strong;
    }

    pub WeakCount(&this) -> u64 {
        if this.control == null { ret 0u64; }
        ret this.control->weak;
    }

    pub op=(&mut this, other: &Weak<T>) -> &mut Weak<T> {
        if &this != &other {
            this.Release();
            this.control = other.control;

            if this.control != null {
                this.control->weak += 1u64;
            }
        } ret this;
    }
}
