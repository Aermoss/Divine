enum HIRIntrinsicKind: u8 {
    SizeOf, AlignOf
}

class HIRIntrinsic : HIRExpression {
    pub kind: HIRIntrinsicKind,
    pub _type: *SemanticType;

    HIRIntrinsic(&mut this, kind: HIRIntrinsicKind, _type: *SemanticType) : HIRExpression(HIRExpressionKind::Intrinsic, analyzer->type_manager.IntegerPointer(false)) {
        (this.kind, this._type) = (kind, _type);
    }
}

class HIRConstruct : HIRExpression {
    pub _type: *SemanticType,
