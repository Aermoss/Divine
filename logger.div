include "lexer.div", "parser.div" : *;

enum LogSeverity {
    Info, Warning, Error
}

class Log {
    pub file: String,
    pub start: Pair<u64, u64>,
    pub end: Pair<u64, u64>,
    pub message: String,
    pub severity: LogSeverity
}

class Logger {
    pub logs: Vector<Log>,
    pub has_error: bool = false;

    Logger(&mut this) {
        logger = this;
    }

    ~Logger(&mut this) {
        logger = null;
    }

    pub Log(file: *const i8, start_row: u64, start_column: u64, end_row: u64, end_column: u64, message: *const i8, severity: LogSeverity) {
        let mut log: Log;
        (log.start.left, log.start.right) = (start_row, start_column);
        (log.end.left, log.end.right) = (end_row, end_column);
        (log.file, log.severity) = (file, severity);
        log.message += file;
        log.message += ":";

        if start_row != -1i64 as u64 {
            log.message += String(start_row as i64);
            log.message += ":";
        }

        if start_column != -1i64 as u64 {
            log.message += String(start_column as i64);
            log.message += ":";
        }

        if severity == LogSeverity::Info {
            log.message += " \x1b[36mInfo:\x1b[0m ";
        } else if severity == LogSeverity::Warning {
            log.message += " \x1b[35mWarning:\x1b[0m ";
        } else if severity == LogSeverity::Error {
            log.message += " \x1b[31mError:\x1b[0m ";
            logger->has_error = true;
        }

        log.message += message;
        logger->logs.PushBack(log);
        WriteLine(log.message);
    }

    pub Log(file: &String, row: u64, column: u64, message: &String, severity: LogSeverity) {
        Logger::Log(file.Data(), row, column, -1i64 as u64, -1i64 as u64, message.Data(), severity);
    }

    pub Log(file: &String, row: u64, column: u64, message: *const i8, severity: LogSeverity) {
        Logger::Log(file.Data(), row, column, -1i64 as u64, -1i64 as u64, message, severity);
    }

    pub Log(file: *const i8, row: u64, column: u64, message: &String, severity: LogSeverity) {
        Logger::Log(file, row, column, -1i64 as u64, -1i64 as u64, message.Data(), severity);
    }

    pub Log(file: *const i8, row: u64, column: u64, message: *const i8, severity: LogSeverity) {
        Logger::Log(file, row, column, -1i64 as u64, -1i64 as u64, message, severity);
    }

    pub Log(file: &String, message: &String, severity: LogSeverity) {
        Logger::Log(file.Data(), -1i64 as u64, -1i64 as u64, -1i64 as u64, -1i64 as u64, message.Data(), severity);
    }

    pub Log(file: &String, message: *const i8, severity: LogSeverity) {
        Logger::Log(file.Data(), -1i64 as u64, -1i64 as u64, -1i64 as u64, -1i64 as u64, message, severity);
    }

    pub Log(file: *const i8, message: &String, severity: LogSeverity) {
        Logger::Log(file, -1i64 as u64, -1i64 as u64, -1i64 as u64, -1i64 as u64, message.Data(), severity);
    }

    pub Log(file: *const i8, message: *const i8, severity: LogSeverity) {
        Logger::Log(file, -1i64 as u64, -1i64 as u64, -1i64 as u64, -1i64 as u64, message, severity);
    }

    pub Log(file: &String, message: &String, token: Token, severity: LogSeverity) {
        Logger::Log(file.Data(), token.row, token.column, -1i64 as u64, -1i64 as u64, message.Data(), severity);
    }

    pub Log(file: &String, message: *const i8, token: Token, severity: LogSeverity) {
        Logger::Log(file.Data(), token.row, token.column, -1i64 as u64, -1i64 as u64, message, severity);
    }

    pub Log(file: *const i8, message: &String, token: Token, severity: LogSeverity) {
        Logger::Log(file, token.row, token.column, -1i64 as u64, -1i64 as u64, message.Data(), severity);
    }

    pub Log(file: *const i8, message: *const i8, token: Token, severity: LogSeverity) {
        Logger::Log(file, token.row, token.column, -1i64 as u64, -1i64 as u64, message, severity);
    }

    pub Log(message: &String, node: *const ASTNode, severity: LogSeverity) {
        if node != null {
            Logger::Log(node->file.Data(), node->row, node->column, -1i64 as u64, -1i64 as u64, message.Data(), severity);
        } else {
            Logger::Log("<unknown>", -1i64 as u64, -1i64 as u64, -1i64 as u64, -1i64 as u64, message.Data(), severity);
        }
    }

    pub Log(message: *const i8, node: *const ASTNode, severity: LogSeverity) {
        if node != null {
            Logger::Log(node->file.Data(), node->row, node->column, -1i64 as u64, -1i64 as u64, message, severity);
        } else {
            Logger::Log("<unknown>", -1i64 as u64, -1i64 as u64, -1i64 as u64, -1i64 as u64, message, severity);
        }
    }
}

static mut logger: *mut Logger = null;