include "divstr", "divdef" : *;

class gladGLversionStruct {
    pub major: i32,
    pub minor: i32
}

static mut GLVersion: gladGLversionStruct = { 0i32, 0i32 };

static mut max_loaded_major: i32 = 0i32;
static mut max_loaded_minor: i32 = 0i32;

static mut GLAD_GL_VERSION_1_0: i32 = 0i32;
static mut GLAD_GL_VERSION_1_1: i32 = 0i32;
static mut GLAD_GL_VERSION_1_2: i32 = 0i32;
static mut GLAD_GL_VERSION_1_3: i32 = 0i32;
static mut GLAD_GL_VERSION_1_4: i32 = 0i32;
static mut GLAD_GL_VERSION_1_5: i32 = 0i32;
static mut GLAD_GL_VERSION_2_0: i32 = 0i32;
static mut GLAD_GL_VERSION_2_1: i32 = 0i32;
static mut GLAD_GL_VERSION_3_0: i32 = 0i32;
static mut GLAD_GL_VERSION_3_1: i32 = 0i32;
static mut GLAD_GL_VERSION_3_2: i32 = 0i32;
static mut GLAD_GL_VERSION_3_3: i32 = 0i32;
static mut GLAD_GL_VERSION_4_0: i32 = 0i32;
static mut GLAD_GL_VERSION_4_1: i32 = 0i32;
static mut GLAD_GL_VERSION_4_2: i32 = 0i32;
static mut GLAD_GL_VERSION_4_3: i32 = 0i32;
static mut GLAD_GL_VERSION_4_4: i32 = 0i32;
static mut GLAD_GL_VERSION_4_5: i32 = 0i32;
static mut GLAD_GL_VERSION_4_6: i32 = 0i32;

type GLADloadproc = func(name: *const i8) -> *const void;

extern "C" {
    func load_GL_VERSION_1_0(load: GLADloadproc) {
        if GLAD_GL_VERSION_1_0 == 0i32 {
            ret;
        }

        glCullFace = load("glCullFace") as PFNGLCULLFACEPROC;
        glFrontFace = load("glFrontFace") as PFNGLFRONTFACEPROC;
        glHint = load("glHint") as PFNGLHINTPROC;
        glLineWidth = load("glLineWidth") as PFNGLLINEWIDTHPROC;
        glPointSize = load("glPointSize") as PFNGLPOINTSIZEPROC;
        glPolygonMode = load("glPolygonMode") as PFNGLPOLYGONMODEPROC;
        glScissor = load("glScissor") as PFNGLSCISSORPROC;
        glTexParameterf = load("glTexParameterf") as PFNGLTEXPARAMETERFPROC;
        glTexParameterfv = load("glTexParameterfv") as PFNGLTEXPARAMETERFVPROC;
        glTexParameteri = load("glTexParameteri") as PFNGLTEXPARAMETERIPROC;
        glTexParameteriv = load("glTexParameteriv") as PFNGLTEXPARAMETERIVPROC;
        glTexImage1D = load("glTexImage1D") as PFNGLTEXIMAGE1DPROC;
        glTexImage2D = load("glTexImage2D") as PFNGLTEXIMAGE2DPROC;
        glDrawBuffer = load("glDrawBuffer") as PFNGLDRAWBUFFERPROC;
        glClear = load("glClear") as PFNGLCLEARPROC;
        glClearColor = load("glClearColor") as PFNGLCLEARCOLORPROC;
        glClearStencil = load("glClearStencil") as PFNGLCLEARSTENCILPROC;
        glClearDepth = load("glClearDepth") as PFNGLCLEARDEPTHPROC;
        glStencilMask = load("glStencilMask") as PFNGLSTENCILMASKPROC;
        glColorMask = load("glColorMask") as PFNGLCOLORMASKPROC;
        glDepthMask = load("glDepthMask") as PFNGLDEPTHMASKPROC;
        glDisable = load("glDisable") as PFNGLDISABLEPROC;
        glEnable = load("glEnable") as PFNGLENABLEPROC;
        glFinish = load("glFinish") as PFNGLFINISHPROC;
        glFlush = load("glFlush") as PFNGLFLUSHPROC;
        glBlendFunc = load("glBlendFunc") as PFNGLBLENDFUNCPROC;
        glLogicOp = load("glLogicOp") as PFNGLLOGICOPPROC;
        glStencilFunc = load("glStencilFunc") as PFNGLSTENCILFUNCPROC;
        glStencilOp = load("glStencilOp") as PFNGLSTENCILOPPROC;
        glDepthFunc = load("glDepthFunc") as PFNGLDEPTHFUNCPROC;
        glPixelStoref = load("glPixelStoref") as PFNGLPIXELSTOREFPROC;
        glPixelStorei = load("glPixelStorei") as PFNGLPIXELSTOREIPROC;
        glReadBuffer = load("glReadBuffer") as PFNGLREADBUFFERPROC;
        glReadPixels = load("glReadPixels") as PFNGLREADPIXELSPROC;
        glGetBooleanv = load("glGetBooleanv") as PFNGLGETBOOLEANVPROC;
        glGetDoublev = load("glGetDoublev") as PFNGLGETDOUBLEVPROC;
        glGetError = load("glGetError") as PFNGLGETERRORPROC;
        glGetFloatv = load("glGetFloatv") as PFNGLGETFLOATVPROC;
        glGetIntegerv = load("glGetIntegerv") as PFNGLGETINTEGERVPROC;
        glGetString = load("glGetString") as PFNGLGETSTRINGPROC;
        glGetTexImage = load("glGetTexImage") as PFNGLGETTEXIMAGEPROC;
        glGetTexParameterfv = load("glGetTexParameterfv") as PFNGLGETTEXPARAMETERFVPROC;
        glGetTexParameteriv = load("glGetTexParameteriv") as PFNGLGETTEXPARAMETERIVPROC;
        glGetTexLevelParameterfv = load("glGetTexLevelParameterfv") as PFNGLGETTEXLEVELPARAMETERFVPROC;
        glGetTexLevelParameteriv = load("glGetTexLevelParameteriv") as PFNGLGETTEXLEVELPARAMETERIVPROC;
        glIsEnabled = load("glIsEnabled") as PFNGLISENABLEDPROC;
        glDepthRange = load("glDepthRange") as PFNGLDEPTHRANGEPROC;
        glViewport = load("glViewport") as PFNGLVIEWPORTPROC;
    }

    func load_GL_VERSION_1_1(load: GLADloadproc) {
