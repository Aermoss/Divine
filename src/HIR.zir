#[include "std/str", "std/vec", "src/Tokens.zir", "src/Types.zir" : *]

enum HIRExpressionKind: u8 {
    BooleanLiteral, CharacterLiteral, IntegerLiteral, FloatLiteral, 
    StringLiteral, ArrayLiteral, StructureLiteral, NullLiteral,
    VariableReference, DeclarationReference,
    Dereference, AddressOf, Assignment, Unary, Binary, Ternary,
    Call, Cast, IndexAccess, MemberAccess,
    New, Delete, Construct, Destruct,
    Intrinsic, Temporary, Deferred
}

enum HIRExpressionCategory: u8 {
    Place, Value
}

class HIRExpression {
    pub kind: HIRExpressionKind,
    pub _type: *SemanticType,
    pub category: HIRExpressionCategory = ::HIRExpressionCategory::Value,
    pub mutable: bool = false,
    pub deferred: *ASTExpression = null;

    HIRExpression(&mut this, kind: HIRExpressionKind, _type: *SemanticType) {
        (this.kind, this._type) = (kind, _type);
    }

    HIRExpression(&mut this, kind: HIRExpressionKind, _type: *SemanticType, category: HIRExpressionCategory, mutable: bool) {
        (this.kind, this._type, this.category, this.mutable) = (kind, _type, category, mutable);
    }

    HIRExpression(&mut this, kind: HIRExpressionKind, _type: *SemanticType, deferred: *ASTExpression) {
        (this.kind, this._type, this.deferred) = (kind, _type, deferred);
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        if this.kind == HIRExpressionKind::IntegerLiteral {
            result += String::FromInteger((this as *HIRIntegerLiteral)->value);
        } else if this.kind == HIRExpressionKind::FloatLiteral {
            result += String::FromFloat((this as *HIRFloatLiteral)->value);
        } else if this.kind == HIRExpressionKind::BooleanLiteral {
            result += (this as *HIRBooleanLiteral)->value ? "true" : "false";
        } else if this.kind == HIRExpressionKind::CharacterLiteral {
            result += '\'' + String((this as *HIRCharacterLiteral)->value as i8).Escape() + '\'';
        } else if this.kind == HIRExpressionKind::StringLiteral {
            result += '"' + (this as *HIRStringLiteral)->value.Escape() + '"';
        } else if this.kind == HIRExpressionKind::NullLiteral {
            result += "null";
        } else if this.kind == HIRExpressionKind::VariableReference {
            result += '%' + (this as *HIRVariableReference)->variable->name;
        } else if this.kind == HIRExpressionKind::DeclarationReference {
            if (this as *HIRDeclarationReference)->declaration->kind == HIRDeclarationKind::Parameter {
                result += '%' + (this as *HIRDeclarationReference)->declaration->name;
            } else if (this as *HIRDeclarationReference)->declaration->kind == HIRDeclarationKind::Function {
                result += "@\"" + (this as *HIRDeclarationReference)->declaration->name + '"';
            } else {
                result += '@' + (this as *HIRDeclarationReference)->declaration->name;
            }
        } else if this.kind == HIRExpressionKind::Call {
            let call = this as *HIRCallExpression;
            result += "call " + call->function->ToString() + '(';

            for i in 0..call->arguments.Size() {
                if i != 0 { result += ", "; }
                result += call->arguments[i]->ToString();
            } result += ')';
        } else if this.kind == HIRExpressionKind::Unary {
            let unary = this as *HIRUnaryExpression;
            result += ToUnaryOperatorString(unary->_operator) + '(' + unary->operand->ToString() + ')';
        } else if this.kind == HIRExpressionKind::Binary {
            let binary = this as *HIRBinaryExpression;
            result += '(' + binary->left->ToString() + ' ' + ToBinaryOperatorString(binary->_operator) + ' ' + binary->right->ToString() + ')';
        } else if this.kind == HIRExpressionKind::Ternary {
            let ternary = this as *HIRTernaryExpression;
            result += '(' + ternary->condition->ToString() + " ? " + ternary->then->ToString() + " : " + ternary->_else->ToString() + ')';
        } else if this.kind == HIRExpressionKind::Assignment {
            let assignment = this as *HIRAssignmentExpression;
            result += assignment->left->ToString() + " = " + assignment->right->ToString();
        } else if this.kind == HIRExpressionKind::Cast {
            result += (this as *HIRCastExpression)->value->ToString() + " as " + this._type->ToString();
        } else if this.kind == HIRExpressionKind::IndexAccess {
            let access = this as *HIRIndexAccessExpression;
            result += access->value->ToString() + '[' + access->index->ToString() + ']';
        } else if this.kind == HIRExpressionKind::MemberAccess {
            let access = this as *HIRMemberAccessExpression;
            result += "(member " + access->instance->ToString() + ", " + String::FromInteger(access->index as u64) + ')';
        } else if this.kind == HIRExpressionKind::Dereference {
            result += "*(" + (this as *HIRDereferenceExpression)->operand->ToString() + ')';
        } else if this.kind == HIRExpressionKind::AddressOf {
            result += "&(" + (this as *HIRAddressOfExpression)->operand->ToString() + ')';
        } else if this.kind == HIRExpressionKind::Temporary {
            result += "(temporary " + (this as *HIRTemporaryExpression)->initializer->ToString() + ')';
        } else {
            result += "<invalid expression>";
        } return result;
    }
}

class HIRBooleanLiteral : HIRExpression {
    pub value: bool;

    HIRBooleanLiteral(&mut this, value: bool, _type: *SemanticType) : HIRExpression(HIRExpressionKind::BooleanLiteral, _type) {
        this.value = value;
    }
}

class HIRCharacterLiteral : HIRExpression {
    pub value: u32;

    HIRCharacterLiteral(&mut this, value: u32, _type: *SemanticType) : HIRExpression(HIRExpressionKind::CharacterLiteral, _type) {
        this.value = value;
    }
}

class HIRIntegerLiteral : HIRExpression {
    pub value: u64;

    HIRIntegerLiteral(&mut this, value: u64, _type: *SemanticType) : HIRExpression(HIRExpressionKind::IntegerLiteral, _type) {
        this.value = value;
    }
}

class HIRFloatLiteral : HIRExpression {
    pub value: f64;

    HIRFloatLiteral(&mut this, value: f64, _type: *SemanticType) : HIRExpression(HIRExpressionKind::FloatLiteral, _type) {
        this.value = value;
    }
}

class HIRStringLiteral : HIRExpression {
    pub value: String;

    HIRStringLiteral(&mut this, value: String, _type: *SemanticType) : HIRExpression(HIRExpressionKind::StringLiteral, _type) {
        this.value = value;
    }
}

class HIRArrayLiteral : HIRExpression {
    pub values: Vector<*HIRExpression>;

    HIRArrayLiteral(&mut this, values: Vector<*HIRExpression>, _type: *SemanticType) : HIRExpression(HIRExpressionKind::ArrayLiteral, _type) {
        this.values = values;
    }
}

class HIRStructureLiteral : HIRExpression {
    pub values: Vector<*HIRExpression>;

    HIRStructureLiteral(&mut this, values: Vector<*HIRExpression>, _type: *SemanticType) : HIRExpression(HIRExpressionKind::StructureLiteral, _type) {
        this.values = values;
    }
}

class HIRNullLiteral : HIRExpression {
    HIRNullLiteral(&mut this, _type: *SemanticType) : HIRExpression(HIRExpressionKind::NullLiteral, _type) {}
}

class HIRVariableReference : HIRExpression {
    pub variable: *HIRVariableStatement;

    HIRVariableReference(&mut this, variable: *HIRVariableStatement) : HIRExpression(HIRExpressionKind::VariableReference, variable->_type, HIRExpressionCategory::Place, variable->mutable) {
        this.variable = variable;
    }
}

class HIRDeclarationReference : HIRExpression {
    pub declaration: *HIRDeclaration;

    HIRDeclarationReference(&mut this, declaration: *HIRDeclaration, mutable: bool) : HIRExpression(HIRExpressionKind::DeclarationReference, declaration->_type, HIRExpressionCategory::Place, mutable) {
        this.declaration = declaration;
    }
}

class HIRDereferenceExpression : HIRExpression {
    pub operand: *HIRExpression;

    HIRDereferenceExpression(&mut this, operand: *HIRExpression) : HIRExpression(HIRExpressionKind::Dereference, operand->_type->Pointee(), HIRExpressionCategory::Place, operand->_type->IsMutable()) {
        this.operand = operand;
    }
}

class HIRAddressOfExpression : HIRExpression {
    pub operand: *HIRExpression;

    HIRAddressOfExpression(&mut this, operand: *HIRExpression, mutable: bool) : HIRExpression(HIRExpressionKind::AddressOf, analyzer->type_manager.Reference(operand->_type, mutable)) {
        this.operand = operand;
    }
}

class HIRAssignmentExpression : HIRExpression {
    pub left: *HIRExpression,
    pub right: *HIRExpression;

    HIRAssignmentExpression(&mut this, left: *HIRExpression, right: *HIRExpression) : HIRExpression(HIRExpressionKind::Assignment, analyzer->type_manager.Void()) {
        (this.left, this.right) = (left, right);
    }
}

class HIRUnaryExpression : HIRExpression {
    pub _operator: TokenType,
    pub operand: *HIRExpression;

    HIRUnaryExpression(&mut this, _operator: TokenType, operand: *HIRExpression) : HIRExpression(HIRExpressionKind::Unary, operand->_type) {
        (this._operator, this.operand) = (_operator, operand);
    }
}

class HIRBinaryExpression : HIRExpression {
    pub _operator: TokenType,
    pub left: *HIRExpression,
    pub right: *HIRExpression;

    HIRBinaryExpression(&mut this, _operator: TokenType, left: *HIRExpression, right: *HIRExpression, _type: *SemanticType) : HIRExpression(HIRExpressionKind::Binary, _type) {
        (this._operator, this.left, this.right) = (_operator, left, right);
    }
}

class HIRTernaryExpression : HIRExpression {
    pub condition: *HIRExpression,
    pub then: *HIRExpression,
    pub _else: *HIRExpression;

    HIRTernaryExpression(&mut this, condition: *HIRExpression, then: *HIRExpression, _else: *HIRExpression, category: HIRExpressionCategory, mutable: bool) : HIRExpression(HIRExpressionKind::Ternary, then->_type, category, mutable) {
        (this.condition, this.then, this._else) = (condition, then, _else);
    }
}

class HIRCallExpression : HIRExpression {
    pub function: *HIRExpression,
    pub arguments: Vector<*HIRExpression>;

    HIRCallExpression(&mut this, function: *HIRExpression, arguments: &Vector<*HIRExpression>) : HIRExpression(HIRExpressionKind::Call, function->_type->Return()) {
        (this.function, this.arguments) = (function, arguments);
    }
}

class HIRCastExpression : HIRExpression {
    pub value: *HIRExpression;

    HIRCastExpression(&mut this, value: *HIRExpression, _type: *SemanticType) : HIRExpression(HIRExpressionKind::Cast, _type) {
        this.value = value;
    }
}

class HIRIndexAccessExpression : HIRExpression {
    pub value: *HIRExpression,
    pub index: *HIRExpression;

    HIRIndexAccessExpression(&mut this, value: *HIRExpression, index: *HIRExpression) : HIRExpression(HIRExpressionKind::IndexAccess, value->_type->AsReference()) {
        (this.value, this.index) = (value, index);
    }
}

class HIRMemberAccessExpression : HIRExpression {
    pub instance: *HIRExpression,
    pub index: usize;

    HIRMemberAccessExpression(&mut this, instance: *HIRExpression, _type: *SemanticType, index: usize) : HIRExpression(HIRExpressionKind::MemberAccess, _type, instance->category, instance->mutable) {
        (this.instance, this.index) = (instance, index);
    }
}

class HIRNewExpression : HIRExpression {
    pub _type: *SemanticType,
    pub size: *HIRExpression;

    HIRNewExpression(&mut this, _type: *SemanticType, size: *HIRExpression) : HIRExpression(HIRExpressionKind::New, analyzer->type_manager.Pointer(_type, true)) {
        (this._type, this.size) = (_type, size);
    }
}

class HIRDeleteExpression : HIRExpression {
    pub value: *HIRExpression;

    HIRDeleteExpression(&mut this, value: *HIRExpression) : HIRExpression(HIRExpressionKind::Delete, analyzer->type_manager.Void()) {
        this.value = value;
    }
