    ASTFieldDeclaration(&mut this, name: String, _type: *ASTType, initializer: *ASTExpression, start: Token) : ASTDeclaration(ASTDeclarationKind::Field, start) {
        (this.name, this._type, this.initializer) = (name, _type, initializer);
    }
}

