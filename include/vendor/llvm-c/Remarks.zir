#[include "vendor/llvm-c/Types.zir" : *]

const REMARKS_API_VERSION: i32 = 1;

enum LLVMRemarkType: i32 {
    LLVMRemarkTypeUnknown = 0,
    LLVMRemarkTypePassed = 1,
    LLVMRemarkTypeMissed = 2,
    LLVMRemarkTypeAnalysis = 3,
    LLVMRemarkTypeAnalysisFPCommute = 4,
    LLVMRemarkTypeAnalysisAliasing = 5,
    LLVMRemarkTypeFailure = 6
}

struct LLVMRemarkOpaqueString {}

type LLVMRemarkStringRef = *mut LLVMRemarkOpaqueString;

struct LLVMRemarkOpaqueDebugLoc {}

type LLVMRemarkDebugLocRef = *mut LLVMRemarkOpaqueDebugLoc;

struct LLVMRemarkOpaqueArg {}

type LLVMRemarkArgRef = *mut LLVMRemarkOpaqueArg;

struct LLVMRemarkOpaqueEntry {}

type LLVMRemarkEntryRef = *mut LLVMRemarkOpaqueEntry;

struct LLVMRemarkOpaqueParser {}

type LLVMRemarkParserRef = *mut LLVMRemarkOpaqueParser;

extern "C" {
    fn LLVMRemarkStringGetData(String: LLVMRemarkStringRef) -> *i8;
    fn LLVMRemarkStringGetLen(String: LLVMRemarkStringRef) -> u32;
    fn LLVMRemarkDebugLocGetSourceFilePath(DL: LLVMRemarkDebugLocRef) -> LLVMRemarkStringRef;
    fn LLVMRemarkDebugLocGetSourceLine(DL: LLVMRemarkDebugLocRef) -> u32;
    fn LLVMRemarkDebugLocGetSourceColumn(DL: LLVMRemarkDebugLocRef) -> u32;
    fn LLVMRemarkArgGetKey(Arg: LLVMRemarkArgRef) -> LLVMRemarkStringRef;
    fn LLVMRemarkArgGetValue(Arg: LLVMRemarkArgRef) -> LLVMRemarkStringRef;
    fn LLVMRemarkArgGetDebugLoc(Arg: LLVMRemarkArgRef) -> LLVMRemarkDebugLocRef;
    fn LLVMRemarkEntryDispose(Remark: LLVMRemarkEntryRef);
    fn LLVMRemarkEntryGetType(Remark: LLVMRemarkEntryRef) -> LLVMRemarkType;
    fn LLVMRemarkEntryGetPassName(Remark: LLVMRemarkEntryRef) -> LLVMRemarkStringRef;
    fn LLVMRemarkEntryGetRemarkName(Remark: LLVMRemarkEntryRef) -> LLVMRemarkStringRef;
    fn LLVMRemarkEntryGetFunctionName(Remark: LLVMRemarkEntryRef) -> LLVMRemarkStringRef;
    fn LLVMRemarkEntryGetDebugLoc(Remark: LLVMRemarkEntryRef) -> LLVMRemarkDebugLocRef;
    fn LLVMRemarkEntryGetHotness(Remark: LLVMRemarkEntryRef) -> u64;
    fn LLVMRemarkEntryGetNumArgs(Remark: LLVMRemarkEntryRef) -> u32;
    fn LLVMRemarkEntryGetFirstArg(Remark: LLVMRemarkEntryRef) -> LLVMRemarkArgRef;
    fn LLVMRemarkEntryGetNextArg(It: LLVMRemarkArgRef, Remark: LLVMRemarkEntryRef) -> LLVMRemarkArgRef;
    fn LLVMRemarkParserCreateYAML(Buf: *void, Size: u64) -> LLVMRemarkParserRef;
    fn LLVMRemarkParserCreateBitstream(Buf: *void, Size: u64) -> LLVMRemarkParserRef;
    fn LLVMRemarkParserGetNext(Parser: LLVMRemarkParserRef) -> LLVMRemarkEntryRef;
    fn LLVMRemarkParserHasError(Parser: LLVMRemarkParserRef) -> LLVMBool;
    fn LLVMRemarkParserGetErrorMessage(Parser: LLVMRemarkParserRef) -> *i8;
    fn LLVMRemarkParserDispose(Parser: LLVMRemarkParserRef);
    fn LLVMRemarkVersion() -> u32;
}
