func Hash(x: i32, y: i32, seed: i32) -> i32 {
    let mut y_index = (y + seed) % 256i32;

    if y_index < 0i32 {
        y_index += 256i32;
    }

    let y_value: u8 = hash[y_index];
    let mut x_index = (y_value as i32 + x) % 256i32;

    if x_index < 0i32 {
        x_index += 256i32;
    }

    let x_value: u8 = hash[x_index];
    ret x_value as i32;
}

func Lerp(x: f64, y: f64, t: f64) -> f64 {
    ret x + t * (y - x);
}

func Smooth(x: f64, y: f64, t: f64) -> f64 {
    ret Lerp(x, y, t * t * (3.0f64 - 2.0f64 * t));
}

func Noise(x: f64, y: f64, seed: i32) -> f64 {
    let x_int = floor(x) as i32;
    let y_int = floor(y) as i32;
    let x_frac = x - (x_int as f64);
    let y_frac = y - (y_int as f64);
    let s = Hash(x_int, y_int, seed);
    let t = Hash(x_int + 1i32, y_int, seed);
    let u = Hash(x_int, y_int + 1i32, seed);
    let v = Hash(x_int + 1i32, y_int + 1i32, seed);
    let low = Smooth(s as f64, t as f64, x_frac);
    let high = Smooth(u as f64, v as f64, x_frac);
    ret Smooth(low, high, y_frac);
}

func Perlin(x: f64, y: f64, freq: f64, depth: i32, seed: i32) -> f64 {
    let mut xa = x * freq;
    let mut ya = y * freq;
    let mut amp = 1.0f64;
    let mut fin = 0.0f64;
    let mut div = 0.0f64;
    let mut i = 0i32;

    while i < depth {
        div += 256.0f64 * amp;
        fin += Noise(xa, ya, seed) * amp;
        amp /= 2.0f64;
        xa *= 2.0f64;
        ya *= 2.0f64;
        i += 1i32;
    } ret fin / div;
}