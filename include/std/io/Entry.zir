#[include "std/str" : *]

extern "C" {
#[if WINDOWS]
    func ReadFile(hFile: *mut void, lpBuffer: *mut i8, nNumberOfBytesToRead: u32, lpNumberOfBytesRead: *mut u32, lpOverlapped: *mut void) -> i32;
    func WriteFile(hFile: *mut void, lpBuffer: *const i8, nNumberOfBytesToWrite: u32, lpNumberOfBytesWritten: *mut u32, lpOverlapped: *mut void) -> i32;

    func GetStdHandle(nStdHandle: u32) -> *mut void;
#[else]
    func write(fd: i32, buf: *const i8, len: u64) #[if DARWIN] ; #[else] {
        volatile asm : rax(1i64), rdi(fd), rsi(buf), rdx(len) -> {
            syscall
        } : memory, rcx, r11, rax;
    } #[endif]
#[endif]
}

#[if WINDOWS]
const STD_INPUT_HANDLE: u32 = 0xFFFFFFF6u32;
const STD_OUTPUT_HANDLE: u32 = 0xFFFFFFF5u32;
const STD_ERROR_HANDLE: u32 = 0xFFFFFFF4u32;
#[else]
const STDIN_FILENO: i32 = 0i32;
const STDOUT_FILENO: i32 = 1i32;
const STDERR_FILENO: i32 = 2i32;
#[endif]

func Write(text: &String) {
#[if WINDOWS]
    WriteFile(GetStdHandle(STD_OUTPUT_HANDLE), text.Data(), text.Length() as u32, null, null);
#[else]
    write(STDOUT_FILENO, text.Data(), text.Length());
#[endif]
}

func Write(text: *const i8) {
#[if WINDOWS]
    WriteFile(GetStdHandle(STD_OUTPUT_HANDLE), text, strlen(text) as u32, null, null);
#[else]
    write(STDOUT_FILENO, text, strlen(text));
#[endif]
}

func WriteLine(text: &String) {
#[if WINDOWS]
    WriteFile(GetStdHandle(STD_OUTPUT_HANDLE), text.Data(), text.Length() as u32, null, null);
    WriteFile(GetStdHandle(STD_OUTPUT_HANDLE), "\n", 1u32, null, null);
#[else]
    write(STDOUT_FILENO, text.Data(), text.Length());
    write(STDOUT_FILENO, "\n", 1u64);
#[endif]
}

func WriteLine(text: *const i8) {
#[if WINDOWS]
    WriteFile(GetStdHandle(STD_OUTPUT_HANDLE), text, strlen(text) as u32, null, null);
    WriteFile(GetStdHandle(STD_OUTPUT_HANDLE), "\n", 1u32, null, null);
#[else]
    write(STDOUT_FILENO, text, strlen(text));
    write(STDOUT_FILENO, "\n", 1u64);
#[endif]
}