include "divvec", "divpair" : *;

class Map<K, V> {
    priv vector: Vector<Pair<K, V>>;

    Map(this: &mut Map<K, V>) {}

    Map(this: &mut Map<K, V>, other: &Map<K, V>) {
        this.vector = other.vector;
    }

    ~Map(this: &mut Map<K, V>) {}

    pub Data(this: &Map<K, V>) -> *const Pair<K, V> { ret this.vector.Data(); }
    pub Empty(this: &Map<K, V>) -> bool { ret this.vector.Empty(); }
    pub Size(this: &Map<K, V>) -> u64 { ret this.vector.Size(); }

    pub Clear(this: &mut Map<K, V>) {
        this.vector.Clear();
    }

    pub Swap(this: &mut Map<K, V>, other: &mut Map<K, V>) {
        this.vector.Swap(other.vector);
    }

    pub Keys(this: &Map<K, V>) -> Vector<K> {
        let mut keys: Vector<K>;
        let mut i: u64 = 0u64;

        while i < this.vector.Size() {
            keys.PushBack(this.vector[i].left);
            i += 1u64;
        } ret keys;
    }

    pub Values(this: &Map<K, V>) -> Vector<V> {
        let mut values: Vector<V>;
        let mut i: u64 = 0u64;

        while i < this.vector.Size() {
            values.PushBack(this.vector[i].right);
            i += 1u64;
        } ret values;
    }

    pub Has(this: &Map<K, V>, key: K) -> bool {
        let mut i: u64 = 0u64;

        while i < this.vector.Size() {
            if this.vector[i].left == key {
                ret true;
            } i += 1u64;
        } ret false;
    }

    pub Get(this: &mut Map<K, V>, key: K, default: V) -> V {
        let mut i: u64 = 0u64;

        while i < this.vector.Size() {
            if this.vector[i].left == key {
                ret this.vector[i].right;
            } i += 1u64;
        } ret default;
    }

    pub Remove(this: &mut Map<K, V>, key: K) {
        let mut i: u64 = 0u64;

        while i < this.vector.Size() {
            if this.vector[i].left == key {
                this.vector.RemoveAt(i);
                ret;
            } i += 1u64;
        }
    }

    pub op=(this: &mut Map<K, V>, other: &Map<K, V>) -> &Map<K, V> {
        this.vector = other.vector;
        ret this;
    }

    pub op[](this: &mut Map<K, V>, key: K) -> &mut V {
        let mut i: u64 = 0u64;

        while i < this.vector.Size() {
            if this.vector[i].left == key {
                ret this.vector[i].right;
            } i += 1u64;
        }

        this.vector.PushBack(Pair<K, V>(key));
        ret this.vector[i].right;
    }

    pub op[](this: &mut Map<K, V>, index: u64) -> &mut Pair<K, V> {
        ret this.vector[index];
    }

    pub Begin(this: &Map<K, V>) -> *mut Pair<K, V> {
        ret this.vector.Begin();
    }

    pub End(this: &Map<K, V>) -> *mut Pair<K, V> {
        ret this.vector.End();
    }
}