fn AtomicExchange8(target: *mut u8, value: u8) -> u8 {
    let result: u8;

    volatile asm : rdi(target), sil(value) -> {
        lock xchgb %sil, (%rdi)
    } -> sil(result) : memory;

    return result;
}

fn AtomicExchange16(target: *mut i16, value: i16) -> i16 {
    let result: i16;

    volatile asm : rdi(target), si(value) -> {
        lock xchgw %si, (%rdi)
    } -> si(result) : memory;

    return result;
}

fn AtomicExchange32(target: *mut u32, value: u32) -> u32 {
    let result: u32;

    volatile asm : rdi(target), esi(value) -> {
        lock xchgl %esi, (%rdi)
    } -> esi(result) : memory;

    return result;
}

fn AtomicExchange64(target: *mut u64, value: u64) -> u64 {
    let result: u64;

    volatile asm : rdi(target), rsi(value) -> {
        lock xchgq %rsi, (%rdi)
    } -> rsi(result) : memory;

    return result;
}

fn AtomicCompareExchange8(target: *mut u8, expected: u8, desired: u8) -> u8 {
    let result: u8;

    volatile asm : rdi(target), al(expected), sil(desired) -> {
        lock cmpxchgb %sil, (%rdi)
    } -> al(result) : memory;

    return result;
}

fn AtomicCompareExchange16(target: *mut i16, expected: i16, desired: i16) -> i16 {
    let result: i16;

    volatile asm : rdi(target), ax(expected), si(desired) -> {
        lock cmpxchgw %si, (%rdi)
    } -> ax(result) : memory;

    return result;
}

fn AtomicCompareExchange32(target: *mut u32, expected: u32, desired: u32) -> u32 {
    let result: u32;

    volatile asm : rdi(target), eax(expected), esi(desired) -> {
        lock cmpxchgl %esi, (%rdi)
    } -> eax(result) : memory;

    return result;
}

fn AtomicCompareExchange64(target: *mut u64, expected: u64, desired: u64) -> u64 {
    let result: u64;

    volatile asm : rdi(target), rax(expected), rsi(desired) -> {
        lock cmpxchgq %rsi, (%rdi)
    } -> rax(result) : memory;

    return result;
}

fn AtomicCompareExchangeBool8(target: *mut u8, expected: u8, desired: u8) -> bool {
    let result: u8;

    volatile asm : rdi(target), al(expected), sil(desired) -> {
        lock cmpxchgb %sil, (%rdi)
        sete %al
    } -> al(result) : memory;

    return result != 0;
}

fn AtomicCompareExchangeBool16(target: *mut i16, expected: i16, desired: i16) -> bool {
    let result: u8;

    volatile asm : rdi(target), ax(expected), si(desired) -> {
        lock cmpxchgw %si, (%rdi)
        sete %al
    } -> al(result) : memory;

    return result != 0;
}

fn AtomicCompareExchangeBool32(target: *mut u32, expected: u32, desired: u32) -> bool {
    let result: u8;

    volatile asm : rdi(target), eax(expected), esi(desired) -> {
        lock cmpxchgl %esi, (%rdi)
        sete %al
    } -> al(result) : memory;

    return result != 0;
}

fn AtomicCompareExchangeBool64(target: *mut u64, expected: u64, desired: u64) -> bool {
    let result: u8;

    volatile asm : rdi(target), rax(expected), rsi(desired) -> {
        lock cmpxchgq %rsi, (%rdi)
        sete %al
    } -> al(result) : memory;

    return result != 0;
}

fn AtomicLoad8(target: *u8) -> u8 {
    let result: u8;

    volatile asm : rdi(target) -> {
        movb (%rdi), %al
        lfence
    } -> al(result) : memory;

    return result;
}

fn AtomicLoad16(target: *i16) -> i16 {
    let result: i16;

    volatile asm : rdi(target) -> {
        movw (%rdi), %ax
        lfence
    } -> ax(result) : memory;

    return result;
}

fn AtomicLoad32(target: *u32) -> u32 {
    let result: u32;

    volatile asm : rdi(target) -> {
        movl (%rdi), %eax
        lfence
    } -> eax(result) : memory;

    return result;
}

fn AtomicLoad64(target: *u64) -> u64 {
    let result: u64;

    volatile asm : rdi(target) -> {
        movq (%rdi), %rax
        lfence
    } -> rax(result) : memory;

    return result;
}

