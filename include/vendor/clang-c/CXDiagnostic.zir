#[include "vendor/clang-c/CXSourceLocation.zir", "vendor/clang-c/CXString.zir" : *]

enum CXDiagnosticSeverity: i32 {
    CXDiagnostic_Ignored,
    CXDiagnostic_Note,
    CXDiagnostic_Warning,
    CXDiagnostic_Error,
    CXDiagnostic_Fatal
}

type CXDiagnostic = *mut void;
type CXDiagnosticSet = *mut void;

enum CXLoadDiag_Error: i32 {
    CXLoadDiag_None,
    CXLoadDiag_Unknown,
    CXLoadDiag_CannotLoad,
    CXLoadDiag_InvalidFile
}

enum CXDiagnosticDisplayOptions: i32 {
    CXDiagnostic_DisplaySourceLocation = 1,
    CXDiagnostic_DisplayColumn,
    CXDiagnostic_DisplaySourceRanges = 4,
    CXDiagnostic_DisplayOption = 8,
    CXDiagnostic_DisplayCategoryId = 16,
    CXDiagnostic_DisplayCategoryName = 32
}

extern "C" {
    fn clang_getNumDiagnosticsInSet(Diags: CXDiagnosticSet) -> u32;
    fn clang_getDiagnosticInSet(Diags: CXDiagnosticSet, Index: u32) -> CXDiagnostic;
    fn clang_loadDiagnostics(file: *i8, error: *mut CXLoadDiag_Error, errorString: *mut CXString) -> CXDiagnosticSet;
    fn clang_disposeDiagnosticSet(Diags: CXDiagnosticSet);
    fn clang_getChildDiagnostics(D: CXDiagnostic) -> CXDiagnosticSet;
    fn clang_disposeDiagnostic(Diagnostic: CXDiagnostic);
    fn clang_formatDiagnostic(Diagnostic: CXDiagnostic, Options: u32) -> CXString;
    fn clang_defaultDiagnosticDisplayOptions() -> u32;
    fn clang_getDiagnosticSeverity(_p0: CXDiagnostic) -> CXDiagnosticSeverity;
    fn clang_getDiagnosticLocation(_p0: CXDiagnostic) -> CXSourceLocation;
    fn clang_getDiagnosticSpelling(_p0: CXDiagnostic) -> CXString;
    fn clang_getDiagnosticOption(Diag: CXDiagnostic, Disable: *mut CXString) -> CXString;
    fn clang_getDiagnosticCategory(_p0: CXDiagnostic) -> u32;
    fn clang_getDiagnosticCategoryName(Category: u32) -> CXString;
    fn clang_getDiagnosticCategoryText(_p0: CXDiagnostic) -> CXString;
    fn clang_getDiagnosticNumRanges(_p0: CXDiagnostic) -> u32;
    fn clang_getDiagnosticRange(Diagnostic: CXDiagnostic, Range: u32) -> CXSourceRange;
    fn clang_getDiagnosticNumFixIts(Diagnostic: CXDiagnostic) -> u32;
    fn clang_getDiagnosticFixIt(Diagnostic: CXDiagnostic, FixIt: u32, ReplacementRange: *mut CXSourceRange) -> CXString;
}
