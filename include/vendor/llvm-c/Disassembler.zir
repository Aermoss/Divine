#[include "vendor/llvm-c/DisassemblerTypes.zir" : *]

const LLVMDisassembler_Option_UseMarkup: i32 = 1;
const LLVMDisassembler_Option_PrintImmHex: i32 = 2;
const LLVMDisassembler_Option_AsmPrinterVariant: i32 = 4;
const LLVMDisassembler_Option_SetInstrComments: i32 = 8;
const LLVMDisassembler_Option_PrintLatency: i32 = 16;
const LLVMDisassembler_Option_Color: i32 = 32;

extern "C" {
    fn LLVMCreateDisasm(TripleName: *i8, DisInfo: *mut void, TagType: i32, GetOpInfo: LLVMOpInfoCallback, SymbolLookUp: LLVMSymbolLookupCallback) -> LLVMDisasmContextRef;
    fn LLVMCreateDisasmCPU(Triple: *i8, CPU: *i8, DisInfo: *mut void, TagType: i32, GetOpInfo: LLVMOpInfoCallback, SymbolLookUp: LLVMSymbolLookupCallback) -> LLVMDisasmContextRef;
    fn LLVMCreateDisasmCPUFeatures(Triple: *i8, CPU: *i8, Features: *i8, DisInfo: *mut void, TagType: i32, GetOpInfo: LLVMOpInfoCallback, SymbolLookUp: LLVMSymbolLookupCallback) -> LLVMDisasmContextRef;
    fn LLVMSetDisasmOptions(DC: LLVMDisasmContextRef, Options: u64) -> i32;
    fn LLVMDisasmDispose(DC: LLVMDisasmContextRef);
    fn LLVMDisasmInstruction(DC: LLVMDisasmContextRef, Bytes: *mut u8, BytesSize: u64, PC: u64, OutString: *mut i8, OutStringSize: usize) -> usize;
}
