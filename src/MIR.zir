#[include "std/str", "std/vec", "src/Types.zir" : *]

enum MIRValueKind: u8 {
    Constant, Instruction, DeclarationReference, Parameter
}

class MIRValue {
    pub kind: MIRValueKind,
    pub _type: *SemanticType;

    MIRValue(&mut this, kind: MIRValueKind, _type: *SemanticType) {
        (this.kind, this._type) = (kind, _type);
    }

    pub fn ToString(&this) -> String {
        if this.kind == MIRValueKind::Constant {
            return (this as *MIRConstant)->ToString();
        } else if this.kind == MIRValueKind::Instruction {
            return (this as *MIRInstruction)->ToString();
        } else if this.kind == MIRValueKind::DeclarationReference {
            return (this as *MIRDeclarationReference)->ToString();
        } else if this.kind == MIRValueKind::Parameter {
            return (this as *MIRParameter)->ToString();
        } else {
            return "<invalid value>".ToString();
        }
    }
}

enum MIRConstantKind: u8 {
    Integer, Float, Boolean, Character, String, Null
}

class MIRConstant : MIRValue {
    pub kind: MIRConstantKind;

    MIRConstant(&mut this, kind: MIRConstantKind, _type: *SemanticType) : MIRValue(MIRValueKind::Constant, _type) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        if this.kind == MIRConstantKind::Boolean {
            return (this as *MIRConstantBoolean)->ToString();
        } else if this.kind == MIRConstantKind::Character {
            return (this as *MIRConstantCharacter)->ToString();
        } else if this.kind == MIRConstantKind::Integer {
            return (this as *MIRConstantInteger)->ToString();
        } else if this.kind == MIRConstantKind::Float {
            return (this as *MIRConstantFloat)->ToString();
        } else if this.kind == MIRConstantKind::String {
            return (this as *MIRConstantString)->ToString();
        } else if this.kind == MIRConstantKind::Null {
            return (this as *MIRConstantNull)->ToString();
        } else {
            return "<invalid literal>".ToString();
        }
    }
}

class MIRConstantBoolean : MIRConstant {
    pub value: bool;

    MIRConstantBoolean(&mut this, value: bool, _type: *SemanticType) : MIRConstant(MIRConstantKind::Boolean, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return (this.value ? "true" : "false").ToString();
    }
}

class MIRConstantCharacter : MIRConstant {
    pub value: u32;

    MIRConstantCharacter(&mut this, value: u32, _type: *SemanticType) : MIRConstant(MIRConstantKind::Character, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return '\'' + String(this.value as i8).Escape() + '\'';
    }
}

class MIRConstantInteger : MIRConstant {
    pub value: u64;

    MIRConstantInteger(&mut this, value: u64, _type: *SemanticType) : MIRConstant(MIRConstantKind::Integer, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return String::FromInteger(this.value);
    }
}

class MIRConstantFloat : MIRConstant {
    pub value: f64;

    MIRConstantFloat(&mut this, value: f64, _type: *SemanticType) : MIRConstant(MIRConstantKind::Float, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return String::FromFloat(this.value);
    }
}

class MIRConstantString : MIRConstant {
    pub value: String;

    MIRConstantString(&mut this, value: String, _type: *SemanticType) : MIRConstant(MIRConstantKind::String, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return '"' + this.value.Escape() + '"';
    }
}

class MIRConstantNull : MIRConstant {
    MIRConstantNull(&mut this, _type: *SemanticType) : MIRConstant(MIRConstantKind::Null, _type) {}

    pub fn ToString(&this) -> String {
        return "null".ToString();
    }
}

enum MIRInstructionKind: u8 {
    Alloca, Load, Store, ArrayGEP, StructGEP,
    Unary, Binary, Call, Cast,
    Select, Phi, Terminator
}

class MIRInstruction : MIRValue {
    pub kind: MIRInstructionKind,
    pub name: String;

    MIRInstruction(&mut this, kind: MIRInstructionKind) : MIRValue(MIRValueKind::Instruction, analyzer->type_manager.Void()) {
        (this.kind, this.name) = (kind, "".ToString());
    }

    MIRInstruction(&mut this, kind: MIRInstructionKind, name: String, _type: *SemanticType) : MIRValue(MIRValueKind::Instruction, _type) {
        (this.kind, this.name) = (kind, name);
    }

    pub fn ToDefinitionString(&this) -> String {
        let mut result = String();

        if !(this as *MIRValue)->_type->IsVoid() {
            result += '%' + this.name + " = ";
        }

        if this.kind == MIRInstructionKind::Alloca {
            result += (this as *MIRAllocaInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::Load {
            result += (this as *MIRLoadInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::Store {
            result += (this as *MIRStoreInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::ArrayGEP {
            result += (this as *MIRArrayGEPInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::StructGEP {
            result += (this as *MIRStructGEPInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::Unary {
            result += (this as *MIRUnaryInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::Binary {
            result += (this as *MIRBinaryInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::Call {
            result += (this as *MIRCallInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::Cast {
            result += (this as *MIRCastInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::Select {
            result += (this as *MIRSelectInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::Phi {
            result += (this as *MIRPhiInstruction)->ToString();
        } else if this.kind == MIRInstructionKind::Terminator {
            result += (this as *MIRTerminator)->ToString();
        } else {
            result += "<invalid instruction>";
        } return result;
    }

    pub fn ToString(&this) -> String {
        if this.name.Empty()  {
            Logger::Log("Referencing an unnamed instruction!", LogSeverity::Fatal);
        } return '%' + this.name;
    }
}

class MIRAllocaInstruction : MIRInstruction {
    pub _type: *SemanticType;

    MIRAllocaInstruction(&mut this, name: String, _type: *SemanticType) : MIRInstruction(MIRInstructionKind::Alloca, name, analyzer->type_manager.Pointer(_type, true)) {
        this._type = _type;
    }

    pub fn ToString(&this) -> String {
        return "alloca " + this._type->ToString();
    }
}

class MIRLoadInstruction : MIRInstruction {
    pub pointer: *MIRValue;

    MIRLoadInstruction(&mut this, name: String, pointer: *MIRValue) : MIRInstruction(MIRInstructionKind::Load, name, pointer->_type->Pointee()) {
        this.pointer = pointer;
    }

    pub fn ToString(&this) -> String {
        return "load " + this.pointer->_type->Pointee()->ToString() + ", " + this.pointer->ToString();
    }
}

class MIRStoreInstruction : MIRInstruction {
    pub pointer: *MIRValue,
    pub value: *MIRValue;

    MIRStoreInstruction(&mut this, pointer: *MIRValue, value: *MIRValue) : MIRInstruction(MIRInstructionKind::Store) {
        (this.pointer, this.value) = (pointer, value);
    }

    pub fn ToString(&this) -> String {
        return "store " + this.pointer->ToString() + ", " + this.value->ToString();
    }
}

class MIRArrayGEPInstruction : MIRInstruction {
    pub pointer: *MIRValue,
    pub index: *MIRValue;

    MIRArrayGEPInstruction(&mut this, name: String, pointer: *MIRValue, index: *MIRValue) : MIRInstruction(MIRInstructionKind::ArrayGEP, name, pointer->_type) {
        (this.pointer, this.index) = (pointer, index);
    }

    pub fn ToString(&this) -> String {
        return "getelementptr " + this.pointer->ToString() + ", " + this.index->ToString();
    }
}

class MIRStructGEPInstruction : MIRInstruction {
    pub pointer: *MIRValue,
    pub index: u32;

    MIRStructGEPInstruction(&mut this, name: String, pointer: *MIRValue, index: u32, _type: *SemanticType) : MIRInstruction(MIRInstructionKind::StructGEP, name, _type) {
        (this.pointer, this.index) = (pointer, index);
    }

    pub fn ToString(&this) -> String {
        return "getelementptr " + this.pointer->ToString() + ", " + String::FromInteger(this.index as u64);
    }
}

enum MIRUnaryKind: u8 {
    Neg, FNeg, Not
}

fn ToString(kind: MIRUnaryKind) -> String {
    if kind == MIRUnaryKind::Neg { return "neg".ToString(); }
    else if kind == MIRUnaryKind::FNeg { return "fneg".ToString(); }
    else if kind == MIRUnaryKind::Not { return "not".ToString(); }
    else { return "<invalid unary>".ToString(); }
}

class MIRUnaryInstruction : MIRInstruction {
    pub kind: MIRUnaryKind,
    pub operand: *MIRValue;

    MIRUnaryInstruction(&mut this, name: String, kind: MIRUnaryKind, operand: *MIRValue) : MIRInstruction(MIRInstructionKind::Unary, name, operand->_type) {
        (this.kind, this.operand) = (kind, operand);
    }

    pub fn ToString(&this) -> String {
        return this.kind.ToString() + ' ' + this.operand->ToString();
    }
}

enum MIRBinaryKind: u8 {
    Add, Sub, Mul, SDiv, UDiv, SRem, URem,
    And, Or, Xor, Shl, LShr, AShr,
    FAdd, FSub, FMul, FDiv, FRem,
    ICmpEq, ICmpNe, ICmpSlt, ICmpSgt, ICmpSle, ICmpSge, ICmpUlt, ICmpUgt, ICmpUle, ICmpUge,
    FCmpEq, FCmpNe, FCmpLt, FCmpGt, FCmpLe, FCmpGe
}

fn ToString(kind: MIRBinaryKind) -> String {
    if kind == MIRBinaryKind::Add { return "add".ToString(); }
    else if kind == MIRBinaryKind::Sub { return "sub".ToString(); }
    else if kind == MIRBinaryKind::Mul { return "mul".ToString(); }
    else if kind == MIRBinaryKind::SDiv { return "sdiv".ToString(); }
    else if kind == MIRBinaryKind::UDiv { return "udiv".ToString(); }
    else if kind == MIRBinaryKind::SRem { return "srem".ToString(); }
    else if kind == MIRBinaryKind::URem { return "urem".ToString(); }
    else if kind == MIRBinaryKind::And { return "and".ToString(); }
    else if kind == MIRBinaryKind::Or { return "or".ToString(); }
    else if kind == MIRBinaryKind::Xor { return "xor".ToString(); }
    else if kind == MIRBinaryKind::Shl { return "shl".ToString(); }
    else if kind == MIRBinaryKind::LShr { return "lshr".ToString(); }
    else if kind == MIRBinaryKind::AShr { return "ashr".ToString(); }
    else if kind == MIRBinaryKind::FAdd { return "fadd".ToString(); }
    else if kind == MIRBinaryKind::FSub { return "fsub".ToString(); }
    else if kind == MIRBinaryKind::FMul { return "fmul".ToString(); }
    else if kind == MIRBinaryKind::FDiv { return "fdiv".ToString(); }
    else if kind == MIRBinaryKind::FRem { return "frem".ToString(); }
    else if kind == MIRBinaryKind::ICmpEq { return "icmp eq".ToString(); }
    else if kind == MIRBinaryKind::ICmpNe { return "icmp ne".ToString(); }
    else if kind == MIRBinaryKind::ICmpSlt { return "icmp slt".ToString(); }
    else if kind == MIRBinaryKind::ICmpSgt { return "icmp sgt".ToString(); }
    else if kind == MIRBinaryKind::ICmpSle { return "icmp sle".ToString(); }
    else if kind == MIRBinaryKind::ICmpSge { return "icmp sge".ToString(); }
    else if kind == MIRBinaryKind::ICmpUlt { return "icmp ult".ToString(); }
    else if kind == MIRBinaryKind::ICmpUgt { return "icmp ugt".ToString(); }
    else if kind == MIRBinaryKind::ICmpUle { return "icmp ule".ToString(); }
    else if kind == MIRBinaryKind::ICmpUge { return "icmp uge".ToString(); }
    else if kind == MIRBinaryKind::FCmpEq { return "fcmp eq".ToString(); }
    else if kind == MIRBinaryKind::FCmpNe { return "fcmp ne".ToString(); }
    else if kind == MIRBinaryKind::FCmpLt { return "fcmp lt".ToString(); }
    else if kind == MIRBinaryKind::FCmpGt { return "fcmp gt".ToString(); }
    else if kind == MIRBinaryKind::FCmpLe { return "fcmp le".ToString(); }
    else if kind == MIRBinaryKind::FCmpGe { return "fcmp ge".ToString(); }
    else { return "<invalid binary>".ToString(); }
}

class MIRBinaryInstruction : MIRInstruction {
    pub kind: MIRBinaryKind,
    pub left: *MIRValue,
    pub right: *MIRValue;

    MIRBinaryInstruction(&mut this, name: String, kind: MIRBinaryKind, left: *MIRValue, right: *MIRValue, _type: *SemanticType) : MIRInstruction(MIRInstructionKind::Binary, name, _type) {
        (this.kind, this.left, this.right) = (kind, left, right);
    }

    pub fn ToString(&this) -> String {
        return this.kind.ToString() + ' ' + this.left->ToString() + ", " + this.right->ToString();
    }
}

class MIRCallInstruction : MIRInstruction {
    pub callee: *MIRValue,
    pub arguments: Vector<*MIRValue>;

    MIRCallInstruction(&mut this, name: String, callee: *MIRValue, arguments: Vector<*MIRValue>) : MIRInstruction(MIRInstructionKind::Call, name, callee->_type->Return()) {
        (this.callee, this.arguments) = (callee, arguments);
    }

    pub fn ToString(&this) -> String {
        let mut result = "call " + this.callee->ToString() + '(';

        for i in 0..this.arguments.Size() {
            if i != 0 { result += ", "; }
            let argument: *MIRValue = this.arguments[i];
            result += argument->ToString();
        } return result + ')';
    }
}

enum MIRCastKind: u8 {
    Trunc, ZExt, SExt,
    FPTrunc, FPExt, FPToSI, FPToUI, SIToFP, UIToFP,
    PtrToInt, IntToPtr, Bitcast
}

fn ToString(kind: MIRCastKind) -> String {
    if kind == MIRCastKind::Trunc { return "trunc".ToString(); }
    else if kind == MIRCastKind::ZExt { return "zext".ToString(); }
    else if kind == MIRCastKind::SExt { return "sext".ToString(); }
    else if kind == MIRCastKind::FPTrunc { return "fptrunc".ToString(); }
    else if kind == MIRCastKind::FPExt { return "fpext".ToString(); }
    else if kind == MIRCastKind::FPToSI { return "fptosi".ToString(); }
    else if kind == MIRCastKind::FPToUI { return "fptoui".ToString(); }
    else if kind == MIRCastKind::SIToFP { return "sitofp".ToString(); }
    else if kind == MIRCastKind::UIToFP { return "uitofp".ToString(); }
    else if kind == MIRCastKind::PtrToInt { return "ptrtoint".ToString(); }
    else if kind == MIRCastKind::IntToPtr { return "inttoptr".ToString(); }
    else if kind == MIRCastKind::Bitcast { return "bitcast".ToString(); }
    else { return "<invalid cast>".ToString(); }
}

class MIRCastInstruction : MIRInstruction {
    pub kind: MIRCastKind,
    pub value: *MIRValue,
    pub target: *SemanticType;

    MIRCastInstruction(&mut this, name: String, kind: MIRCastKind, value: *MIRValue, target: *SemanticType) : MIRInstruction(MIRInstructionKind::Cast, name, target) {
        (this.kind, this.value, this.target) = (kind, value, target);
    }

    pub fn ToString(&this) -> String {
        return this.kind.ToString() + ' ' + this.value->ToString() + " to " + this.target->ToString();
    }
}

class MIRSelectInstruction : MIRInstruction {
    pub condition: *MIRValue,
    pub then_value: *MIRValue,
    pub else_value: *MIRValue;

    MIRSelectInstruction(&mut this, name: String, condition: *MIRValue, then_value: *MIRValue, else_value: *MIRValue, _type: *SemanticType) : MIRInstruction(MIRInstructionKind::Select, name, _type) {
        (this.condition, this.then_value, this.else_value) = (condition, then_value, else_value);
    }

    pub fn ToString(&this) -> String {
        return "select " + this.condition->ToString() + ", " + this.then_value->ToString() + ", " + this.else_value->ToString();
    }
}

class MIRPhiIncoming {
    pub value: *MIRValue,
    pub block: *MIRBlock;

    MIRPhiIncoming(&mut this, value: *MIRValue, block: *MIRBlock) {
        (this.value, this.block) = (value, block);
    }
}

class MIRPhiInstruction : MIRInstruction {
    pub incomings: Vector<MIRPhiIncoming>;

    MIRPhiInstruction(&mut this, name: String, _type: *SemanticType) : MIRInstruction(MIRInstructionKind::Phi, name, _type) {}

    pub fn AddIncoming(&mut this, value: *MIRValue, block: *MIRBlock) {
        this.incomings.PushBack(MIRPhiIncoming(value, block));
    }

    pub fn ToString(&this) -> String {
        let mut result = "phi ".ToString();

        for i in 0..this.incomings.Size() {
            if i != 0 { result += ", "; }
            result += '[' + this.incomings[i].value->ToString() + ", %" + this.incomings[i].block->name + ']';
        } return result;
    }
}

enum MIRTerminatorKind: u8 {
    Return, Branch, ConditionalBranch, Unreachable
}

class MIRTerminator : MIRInstruction {
    pub kind: MIRTerminatorKind;

    MIRTerminator(&mut this, kind: MIRTerminatorKind) : MIRInstruction(MIRInstructionKind::Terminator) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        if this.kind == MIRTerminatorKind::Return {
            return (this as *MIRReturnInstruction)->ToString();
        } else if this.kind == MIRTerminatorKind::Branch {
            return (this as *MIRBranchInstruction)->ToString();
        } else if this.kind == MIRTerminatorKind::ConditionalBranch {
            return (this as *MIRConditionalBranchInstruction)->ToString();
        } else if this.kind == MIRTerminatorKind::Unreachable {
            return (this as *MIRUnreachableInstruction)->ToString();
        } else {
            return "<invalid terminator>".ToString();
        }
    }
}

class MIRReturnInstruction : MIRTerminator {
    pub value: *MIRValue;

    MIRReturnInstruction(&mut this, value: *MIRValue) : MIRTerminator(MIRTerminatorKind::Return) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        let mut result = "return".ToString();

        if this.value != null {
            result += ' ' + this.value->ToString();
        } return result;
    }
}

class MIRBranchInstruction : MIRTerminator {
    pub target: *MIRBlock;

    MIRBranchInstruction(&mut this, target: *MIRBlock) : MIRTerminator(MIRTerminatorKind::Branch) {
        this.target = target;
    }

    pub fn ToString(&this) -> String {
        return "branch %" + this.target->name;
    }
}

class MIRConditionalBranchInstruction : MIRTerminator {
    pub condition: *MIRValue,
    pub then_target: *MIRBlock,
    pub else_target: *MIRBlock;

    MIRConditionalBranchInstruction(&mut this, condition: *MIRValue, then_target: *MIRBlock, else_target: *MIRBlock) : MIRTerminator(MIRTerminatorKind::ConditionalBranch) {
        (this.condition, this.then_target, this.else_target) = (condition, then_target, else_target);
    }

    pub fn ToString(&this) -> String {
        return "branch " + this.condition->ToString() + ", %" + this.then_target->name + ", %" + this.else_target->name;
    }
}

class MIRUnreachableInstruction : MIRTerminator {
    MIRUnreachableInstruction(&mut this) : MIRTerminator(MIRTerminatorKind::Unreachable) {}

    pub fn ToString(&this) -> String {
        return "unreachable".ToString();
    }
}

class MIRDeclarationReference : MIRValue {
    pub declaration: *MIRDeclaration;

    MIRDeclarationReference(&mut this, declaration: *MIRDeclaration) : MIRValue(MIRValueKind::DeclarationReference, declaration->kind == MIRDeclarationKind::Function ? declaration->_type : analyzer->type_manager.Pointer(declaration->_type, declaration->kind == MIRDeclarationKind::Static ? ((declaration as *MIRLinkableDeclaration) as *MIRStaticDeclaration)->mutable : false)) {
        this.declaration = declaration;
    }

    pub fn ToString(&this) -> String {
        return "@\"" + this.declaration->name + '"';
    }
}

class MIRParameter : MIRValue {
    pub name: String,
    pub index: u32;

    MIRParameter(&mut this, name: String, index: u32, _type: *SemanticType) : MIRValue(MIRValueKind::Parameter, _type) {
        (this.name, this.index) = (name, index);
    }

    pub fn ToString(&this) -> String {
        return '%' + this.name;
    }
}

class MIRBlock {
    pub name: String,
    pub instructions: Vector<*MIRInstruction>,
    pub terminator: *MIRTerminator = null;

    MIRBlock(&mut this, name: String) {
        this.name = name;
    }

    pub fn ToString(&this) -> String {
        let mut result = this.name + ':';

        for instruction in this.instructions {
            result += "\n  " + instruction->ToDefinitionString();
        }

        if this.terminator != null {
            result += "\n  " + this.terminator->ToString();
        } return result;
    }
}

enum MIRDeclarationKind: u8 {
    Type, Constant, Function, Static
}

class MIRDeclaration {
    pub kind: MIRDeclarationKind,
    pub name: String,
    pub _type: *SemanticType;

    MIRDeclaration(&mut this, kind: MIRDeclarationKind, name: String, _type: *SemanticType) {
        (this.kind, this.name, this._type) = (kind, name, _type);
    }

    pub fn ToString(&this) -> String {
        if this.kind == MIRDeclarationKind::Type {
            return (this as *MIRTypeDeclaration)->ToString();
        } else if this.kind == MIRDeclarationKind::Constant {
            return (this as *MIRConstantDeclaration)->ToString();
        } else if this.kind == MIRDeclarationKind::Function {
            return ((this as *MIRLinkableDeclaration) as *MIRFunctionDeclaration)->ToString();
        } else if this.kind == MIRDeclarationKind::Static {
            return ((this as *MIRLinkableDeclaration) as *MIRStaticDeclaration)->ToString();
        } else {
            return "<invalid declaration>".ToString();
        }
    }
}

class MIRTypeDeclaration : MIRDeclaration {
    pub types: Vector<*SemanticType>;

    MIRTypeDeclaration(&mut this, name: String, _type: *SemanticType) : MIRDeclaration(MIRDeclarationKind::Type, name, _type) {}

    pub fn ToString(&this) -> String {
        let declaration = this as *MIRDeclaration;
        let mut result = "type %" + declaration->name + " = { ";

        for i in 0..this.types.Size() {
            if i != 0 { result += ", "; }
            let _type: *SemanticType = this.types[i];
            result += _type->ToString();
        } return result + " }";
    }
}

class MIRConstantDeclaration : MIRDeclaration {
    pub initializer: *MIRValue;

    MIRConstantDeclaration(&mut this, name: String, _type: *SemanticType, initializer: *MIRValue) : MIRDeclaration(MIRDeclarationKind::Constant, name, _type) {
        this.initializer = initializer;
    }

    pub fn ToString(&this) -> String {
        let declaration = this as *MIRDeclaration;
        return "const @\"" + declaration->name + "\": " + declaration->_type->ToString() + " = " + this.initializer->ToString();
    }
}

enum MIRDeclarationLinkage: u8 {
    Internal, External
}

class MIRLinkableDeclaration : MIRDeclaration {
    pub linkage: MIRDeclarationLinkage;

    MIRLinkableDeclaration(&mut this, kind: MIRDeclarationKind, name: String, _type: *SemanticType, linkage: MIRDeclarationLinkage) : MIRDeclaration(kind, name, _type) {
        this.linkage = linkage;
    }
}

class MIRFunctionDeclaration : MIRLinkableDeclaration {
    pub parameters: Vector<*MIRParameter>,
    pub blocks: Vector<*MIRBlock>;

    MIRFunctionDeclaration(&mut this, name: String, _type: *SemanticType, linkage: MIRDeclarationLinkage) : MIRLinkableDeclaration(MIRDeclarationKind::Function, name, _type, linkage) {}

    pub fn ToString(&this) -> String {
        let declaration = (this as *MIRLinkableDeclaration) as *MIRDeclaration;
        let mut result = "fn @\"" + declaration->name + "\"(";

        for i in 0..this.parameters.Size() {
            if i != 0 { result += ", "; }
            let parameter: *MIRParameter = this.parameters[i];
            result += '%' + parameter->name + ": " + (parameter as *MIRValue)->_type->ToString();
        } result += ')';

        if !declaration->_type->Return().IsVoid() {
            result += " -> " + declaration->_type->Return().ToString();
        }

        if !this.blocks.Empty() {
            result += " {\n";

            for block in this.blocks {
                result += block->ToString() + '\n';
            } result += '}';
        } return result;
    }
}

class MIRStaticDeclaration : MIRLinkableDeclaration {
    pub initializer: *MIRValue,
    pub mutable: bool;

    MIRStaticDeclaration(&mut this, name: String, _type: *SemanticType, mutable: bool, initializer: *MIRValue, linkage: MIRDeclarationLinkage) : MIRLinkableDeclaration(MIRDeclarationKind::Static, name, _type, linkage) {
        (this.initializer, this.mutable) = (initializer, mutable);
    }

    pub fn ToString(&this) -> String {
        let declaration = (this as *MIRLinkableDeclaration) as *MIRDeclaration;
        let mut result = "static @\"" + declaration->name + "\": " + declaration->_type->ToString();

        if this.initializer != null {
            result += " = " + this.initializer->ToString();
        } return result;
    }
}

class MIRModule {
    pub declarations: Vector<*MIRDeclaration>;

    MIRModule(&mut this) {}

    pub fn ToString(&this) -> String {
        let mut result = String();

        for declaration in this.declarations {
            if !result.Empty() { result += "\n"; }
            result += declaration->ToString();
        } return result;
    }
}
