#[include "src/Types.zir" : *]

enum MIRValueKind: u8 {
    Literal, GlobalRef, Parameter, Instruction
}

class MIRValue {
    pub kind: MIRValueKind,
    pub _type: *SemanticType;

    MIRValue(&mut this, kind: MIRValueKind, _type: *SemanticType) {
        (this.kind, this._type) = (kind, _type);
    }

    pub fn ToString(&this) -> String {
        if this->kind == MIRValueKind::Literal {
            return (this as *MIRLiteral)->ToString();
        } else if this->kind == MIRValueKind::GlobalRef {
            return (this as *MIRGlobalRef)->ToString();
        } else if this->kind == MIRValueKind::Parameter {
            return (this as *MIRParameter)->ToString();
        } else if this->kind == MIRValueKind::Instruction {
            return (this as *MIRInstruction)->ToString();
        } else {
            return "<invalid value>".ToString();
        }
    }
}

enum MIRLiteralKind: u8 {
    Integer, Float, Boolean, Character, String, Null
}

class MIRLiteral : MIRValue {
    pub kind: MIRLiteralKind;

    MIRLiteral(&mut this, kind: MIRLiteralKind, _type: *SemanticType) : MIRValue(MIRValueKind::Literal, _type) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        if this->kind == MIRLiteralKind::Boolean {
            return (this as *MIRBooleanLiteral)->ToString();
        } else if this->kind == MIRLiteralKind::Character {
            return (this as *MIRCharacterLiteral)->ToString();
        } else if this->kind == MIRLiteralKind::Integer {
            return (this as *MIRIntegerLiteral)->ToString();
        } else if this->kind == MIRLiteralKind::Float {
            return (this as *MIRFloatLiteral)->ToString();
        } else if this->kind == MIRLiteralKind::String {
            return (this as *MIRStringLiteral)->ToString();
        } else if this->kind == MIRLiteralKind::Null {
            return (this as *MIRNullLiteral)->ToString();
        } else {
            return "<invalid literal>".ToString();
        }
    }
}

class MIRBooleanLiteral : MIRLiteral {
    pub value: bool;

    MIRBooleanLiteral(&mut this, value: bool, _type: *SemanticType) : MIRLiteral(MIRLiteralKind::Boolean, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return (this.value ? "true" : "false").ToString();
    }
}

class MIRCharacterLiteral : MIRLiteral {
    pub value: u32;

    MIRCharacterLiteral(&mut this, value: u32, _type: *SemanticType) : MIRLiteral(MIRLiteralKind::Character, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return '\'' + String(this.value as i8).Escape() + '\'';
    }
}

class MIRIntegerLiteral : MIRLiteral {
    pub value: u64;

    MIRIntegerLiteral(&mut this, value: u64, _type: *SemanticType) : MIRLiteral(MIRLiteralKind::Integer, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return String::FromInteger(this.value);
    }
}

class MIRFloatLiteral : MIRLiteral {
    pub value: f64;

    MIRFloatLiteral(&mut this, value: f64, _type: *SemanticType) : MIRLiteral(MIRLiteralKind::Float, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return String::FromFloat(this.value);
    }
}

class MIRStringLiteral : MIRLiteral {
    pub value: String;

    MIRStringLiteral(&mut this, value: String, _type: *SemanticType) : MIRLiteral(MIRLiteralKind::String, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return '"' + this.value.Escape() + '"';
    }
}

class MIRNullLiteral : MIRLiteral {
    MIRNullLiteral(&mut this, _type: *SemanticType) : MIRLiteral(MIRLiteralKind::Null, _type) {}

    pub fn ToString(&this) -> String {
        return "null".ToString();
    }
}

class MIRGlobalRef : MIRValue {
    pub declaration: *MIRDeclaration;

    MIRGlobalRef(&mut this, declaration: *MIRDeclaration) : MIRValue(MIRValueKind::GlobalRef, analyzer->type_manager.Pointer(declaration->_type, declaration->kind == MIRDeclarationKind::Static ? ((declaration as *MIRLinkableDeclaration) as *MIRStatic)->mutable : false)) {
        this.declaration = declaration;
    }

    pub fn ToString(&this) -> String {
        return '@' + this.declaration->name;
    }
}

class MIRParameter : MIRValue {
    pub name: String,
    pub index: u32;

    MIRParameter(&mut this, name: String, index: u32, _type: *SemanticType) : MIRValue(MIRValueKind::Parameter, _type) {
        (this.name, this.index) = (name, index);
    }

    pub fn ToString(&this) -> String {
        return '%' + this.name;
    }
}

enum MIRInstructionKind: u8 {
    Alloca, Load, Store, Return, Branch, CondBranch, Unreachable
}

class MIRInstruction : MIRValue {
    pub kind: MIRInstructionKind,
    pub name: String;

    MIRInstruction(&mut this, kind: MIRInstructionKind) : MIRValue(MIRValueKind::Instruction, analyzer->type_manager.Void()) {
        (this.kind, this.name) = (kind, "".ToString());
    }

    MIRInstruction(&mut this, kind: MIRInstructionKind, name: String, _type: *SemanticType) : MIRValue(MIRValueKind::Instruction, _type) {
        (this.kind, this.name) = (kind, name);
    }

    pub fn ToString(&this) -> String {
        if this->kind == MIRInstructionKind::Alloca {
            return (this as *MIRAlloca)->ToString();
        } else if this->kind == MIRInstructionKind::Load {
            return (this as *MIRLoad)->ToString();
        } else if this->kind == MIRInstructionKind::Store {
            return (this as *MIRStore)->ToString();
        } else if this->kind == MIRInstructionKind::Return {
            return (this as *MIRReturn)->ToString();
        } else if this->kind == MIRInstructionKind::Branch {
            return (this as *MIRBranch)->ToString();
        } else if this->kind == MIRInstructionKind::CondBranch {
            return (this as *MIRCondBranch)->ToString();
        } else if this->kind == MIRInstructionKind::Unreachable {
            return (this as *MIRUnreachable)->ToString();
        } else {
            return "<invalid instruction>".ToString();
        }
    }
}

class MIRAlloca : MIRInstruction {
    pub _type: *SemanticType;

    MIRAlloca(&mut this, name: String, _type: *SemanticType) : MIRInstruction(MIRInstructionKind::Alloca, name, analyzer->type_manager.Pointer(_type, true)) {
        this._type = _type;
    }

    pub fn ToString(&this) -> String {
        return "alloca " + this._type->ToString();
    }
}

class MIRLoad : MIRInstruction {
    pub pointer: *MIRValue;

    MIRLoad(&mut this, name: String, pointer: *MIRValue) : MIRInstruction(MIRInstructionKind::Load, name, pointer->_type->Pointee()) {
        this.pointer = pointer;
    }

    pub fn ToString(&this) -> String {
        return "load " + this.pointer->ToString();
    }
}

class MIRStore : MIRInstruction {
    pub pointer: *MIRValue,
    pub value: *MIRValue;

    MIRStore(&mut this, pointer: *MIRValue, value: *MIRValue) : MIRInstruction(MIRInstructionKind::Store) {
        (this.pointer, this.value) = (pointer, value);
    }

    pub fn ToString(&this) -> String {
        return "store " + this.pointer->ToString() + ", " + this.value->ToString();
    }
}

class MIRReturn : MIRInstruction {
    pub value: *MIRValue;

    MIRReturn(&mut this, value: *MIRValue) : MIRInstruction(MIRInstructionKind::Return) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        let mut result = "return".ToString();

        if this.value != null {
            result += ' ' + this.value->ToString();
        } return result;
    }
}

class MIRBranch : MIRInstruction {
    pub target: *MIRBlock;

    MIRBranch(&mut this, target: *MIRBlock) : MIRInstruction(MIRInstructionKind::Branch) {
        this.target = target;
    }

    pub fn ToString(&this) -> String {
        return "branch %" + this.target->name;
    }
}

class MIRCondBranch : MIRInstruction {
    pub condition: *MIRValue,
    pub then_target: *MIRBlock,
    pub else_target: *MIRBlock;

    MIRCondBranch(&mut this, condition: *MIRValue, then_target: *MIRBlock, else_target: *MIRBlock) : MIRInstruction(MIRInstructionKind::CondBranch) {
        (this.condition, this.then_target, this.else_target) = (condition, then_target, else_target);
    }

    pub fn ToString(&this) -> String {
        return "branch " + this.condition->ToString() + ", %" + this.then_target->name + ", %" + this.else_target->name;
    }
}

class MIRUnreachable : MIRInstruction {
    MIRUnreachable(&mut this) : MIRInstruction(MIRInstructionKind::Unreachable) {}

    pub fn ToString(&this) -> String {
        return "unreachable".ToString();
    }
}

class MIRBlock {
    pub name: String,
    pub instructions: Vector<*MIRInstruction>,
    pub terminator: *MIRInstruction = null;

    MIRBlock(&mut this, name: String) {
        this.name = name;
    }
}

enum MIRDeclarationKind: u8 {
    Type, Constant, Function, Static
}

class MIRDeclaration {
    pub kind: MIRDeclarationKind,
    pub name: String,
    pub _type: *SemanticType;

    MIRDeclaration(&mut this, kind: MIRDeclarationKind, name: String, _type: *SemanticType) {
        (this.kind, this.name, this._type) = (kind, name, _type);
    }

    pub fn ToString(&this) -> String {
        if this->kind == MIRDeclarationKind::Type {
            return (this as *MIRType)->ToString();
        } else if this->kind == MIRDeclarationKind::Constant {
            return (this as *MIRConstant)->ToString();
        } else if this->kind == MIRDeclarationKind::Function {
            return ((this as *MIRLinkableDeclaration) as *MIRFunction)->ToString();
        } else if this->kind == MIRDeclarationKind::Static {
            return ((this as *MIRLinkableDeclaration) as *MIRStatic)->ToString();
        } else {
            return "<invalid declaration>".ToString();
        }
    }
}

class MIRType : MIRDeclaration {
    MIRType(&mut this, name: String, _type: *SemanticType) : MIRDeclaration(MIRDeclarationKind::Type, name, _type) {}

    pub fn ToString(&this) -> String {
        let declaration = this as *MIRDeclaration;
        return "type %" + declaration->name + " = " + declaration->_type->ToString();
    }
}

class MIRConstant : MIRDeclaration {
    pub initializer: *MIRValue;

    MIRConstant(&mut this, name: String, _type: *SemanticType, initializer: *MIRValue) : MIRDeclaration(MIRDeclarationKind::Constant, name, _type) {
        this.initializer = initializer;
    }

    pub fn ToString(&this) -> String {
        let declaration = this as *MIRDeclaration;
        return "const @" + declaration->name + ": " + declaration->_type->ToString() + " = " + this.initializer->ToString();
    }
}

enum MIRDeclarationLinkage: u8 {
    Internal, External
}

class MIRLinkableDeclaration : MIRDeclaration {
    pub linkage: MIRDeclarationLinkage;

    MIRLinkableDeclaration(&mut this, kind: MIRDeclarationKind, name: String, _type: *SemanticType, linkage: MIRDeclarationLinkage) : MIRDeclaration(kind, name, _type) {
        this.linkage = linkage;
    }
}

class MIRFunction : MIRLinkableDeclaration {
    pub parameters: Vector<*MIRParameter>,
    pub blocks: Vector<*MIRBlock>;

    MIRFunction(&mut this, name: String, _type: *SemanticType, linkage: MIRDeclarationLinkage) : MIRLinkableDeclaration(MIRDeclarationKind::Function, name, _type, linkage) {}

    pub fn ToString(&this) -> String {
        let declaration = (this as *MIRLinkableDeclaration) as *MIRDeclaration;
        let mut result = "fn @\"" + declaration->name + "\"(";

        for i in 0..this.parameters.Size() {
            if i != 0 { result += ", "; }
            let parameter: *MIRParameter = this.parameters[i];
            result += '%' + parameter->name + ": " + (parameter as *MIRValue)->_type->ToString();
        } result += ')';

        if !declaration->_type->Return().IsVoid() {
            result += " -> " + declaration->_type->Return().ToString();
        }

        if !this.blocks.Empty() {
            result += " {\n";

            for block in this.blocks {
                result += block->name + ":\n";
            } result += "}";
        } return result;
    }
}

class MIRStatic : MIRLinkableDeclaration {
    pub initializer: *MIRValue,
    pub mutable: bool;

    MIRStatic(&mut this, name: String, _type: *SemanticType, mutable: bool, initializer: *MIRValue, linkage: MIRDeclarationLinkage) : MIRLinkableDeclaration(MIRDeclarationKind::Static, name, _type, linkage) {
        (this.initializer, this.mutable) = (initializer, mutable);
    }

    pub fn ToString(&this) -> String {
        let declaration = (this as *MIRLinkableDeclaration) as *MIRDeclaration;
        let mut result = "static @" + declaration->name + ": " + declaration->_type->ToString();

        if this.initializer != null {
            result += " = " + this.initializer->ToString();
        } return result;
    }
}

class MIRModule {
    pub declarations: Vector<*MIRDeclaration>;

    MIRModule(&mut this) {}

    pub fn ToString(&this) -> String {
        let mut result = String();

        for declaration in this.declarations {
            if !result.Empty() { result += "\n"; }
            result += declaration->ToString();
        } return result;
    }
}
