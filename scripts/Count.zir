#[include "std/io", "std/file", "std/str", "std/map", "std/arena" : *]

class Stats {
    pub library_counts: Map<String, usize>,
    pub compiler_counts: Map<String, usize>,
    pub other_counts: Map<String, usize>
}

func GetLineCount(path: &String) -> usize {
    let content = _ReadFile(path);
    if content.Empty() { ret 0; }
    let lines = content.Count('\n');

    if content[content.Length() - 1] != '\n' {
        ret lines + 1;
    } ret lines;
}

func ProcessDirectory(directory: &String, stats: &mut Stats) {
    let mut find_data: WIN32_FIND_DATAA;
    let find_handle = FindFirstFileA((directory + "\\*").Data(), &mut find_data);
    if find_handle == INVALID_HANDLE_VALUE { ret; }

    loop {
        let file_name = String(find_data.cFileName);

        if file_name != "." && file_name != ".." {
            let path = JoinPath(directory, file_name);

            if (find_data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0 {
                ProcessDirectory(path, stats);
            } else if file_name.EndsWith(".zir") {
                let lines = GetLineCount(path);

                if path.Contains("include") {
                    let library = SplitPath(path).left;

                    if stats.library_counts.Has(library) {
                        stats.library_counts[library] += lines;
                    } else {
                        stats.library_counts[library] = lines;
                    }
                } else if path.Contains("src") {
                    stats.compiler_counts[path] = lines;
                } else {
                    stats.other_counts[path] = lines;
                }
            }
        }

        if FindNextFileA(find_handle, &mut find_data) == 0 {
            break;
        }
    }

    FindClose(find_handle);
}

func PrintMap(title: *const i8, map: Map<String, usize>) -> usize {
    let mut total: usize = 0;
    WriteLine("--- " + title.ToString() + " ---");

    for pair in map {
        WriteLine(pair.left + ": " + String::FromInteger(pair.right as u64) + " lines");
        total += pair.right;
    }

    WriteLine("Subtotal: " + String::FromInteger(total as u64) + " lines\n");
    ret total;
}

func main(args: &mut Vector<String>) -> i32 {
    let mut stats: Stats;
    ProcessDirectory(".".ToString(), &mut stats);
    let library_total = PrintMap("Libraries", stats.library_counts);
    let compiler_total = PrintMap("Compiler", stats.compiler_counts);
    let other_total = PrintMap("Other", stats.other_counts);
    let total = library_total + compiler_total + other_total;
    WriteLine("==========================================");
    WriteLine("TOTAL LINES:  " + String::FromInteger(total as u64) + " lines");
    WriteLine("==========================================");
    ret 0;
}
