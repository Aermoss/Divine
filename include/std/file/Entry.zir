#[include "std/io", "std/std", "std/str", "std/pair" : *]

#[if WINDOWS]
const PATH_SEPERATOR: i8 = '\\';
const MAX_PATH: usize = 260;

class FILETIME {
    pub dwLowDateTime: u32,
    pub dwHighDateTime: u32
}

type LPFILETIME = *mut FILETIME;

class WIN32_FIND_DATAA {
    pub dwFileAttributes: u32,
    pub ftCreationTime: FILETIME,
    pub ftLastAccessTime: FILETIME,
    pub ftLastWriteTime: FILETIME,
    pub nFileSizeHigh: u32,
    pub nFileSizeLow: u32,
    pub dwReserved0: u32,
    pub dwReserved1: u32,
    pub cFileName[MAX_PATH]: i8,
    pub cAlternateFileName[14]: i8,
    pub dwFileType: u32,
    pub dwCreatorType: u32,
    pub wFinderFlags: u16
}

type LPWIN32_FIND_DATAA = *mut WIN32_FIND_DATAA;

extern "C" {
    fn GetFileAttributesA(lpFileName: *i8) -> u32;

    fn FindFirstFileA(lpFileName: *i8, lpFindFileData: LPWIN32_FIND_DATAA) -> *mut void;
    fn FindNextFileA(hFindFile: *mut void, lpFindFileData: LPWIN32_FIND_DATAA) -> i32;
    fn FindClose(hFindFile: *mut void) -> i32;

    fn GetTempPathA(nBufferLength: u32, lpBuffer: *mut i8) -> u32;
    fn GetFullPathNameA(lpFileName: *i8, nBufferLength: u32, lpBuffer: *mut i8, lpFilePart: *mut *mut i8) -> u32;

    fn CreateFileA(lpFileName: *i8, dwDesiredAccess: u32, dwShareMode: u32, lpSecurityAttributes: *mut void, dwCreationDisposition: u32, dwFlagsAndAttributes: u32, hTemplateFile: *mut void) -> *mut void;
    fn DeleteFileA(lpFileName: *i8) -> i32;

    fn GetFileSize(hFile: *mut void, lpFileSizeHigh: *mut u32) -> u32;
    fn CloseHandle(hObject: *mut void) -> i32;
}

const GENERIC_READ: u32 = 0x80000000;
const FILE_SHARE_READ: u32 = 0x00000001;
const OPEN_EXISTING: u32 = 0x00000003;

const GENERIC_WRITE: u32 = 0x40000000;
const FILE_SHARE_NONE: u32 = 0x00000000;
const CREATE_ALWAYS: u32 = 0x00000002;

const FILE_ATTRIBUTE_NORMAL: u32 = 0x00000080;
const FILE_ATTRIBUTE_DIRECTORY: u32 = 0x00000010;
const INVALID_FILE_ATTRIBUTES: u32 = 0xFFFFFFFF;

const INVALID_HANDLE_VALUE: *mut void = -1 as *mut void;

fn _ReadFile(path: &String) -> String {
    let mut content = String();
    let handle = CreateFileA(path.Data(), GENERIC_READ, FILE_SHARE_READ, null, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, null);

    if handle == INVALID_HANDLE_VALUE {
        WriteLine("\x1b[31mFailed to open file for reading: '" + path + "'.\x1b[0m");
        return content;
    }

    let size = GetFileSize(handle, null);

    if size > 0 {
        let string = new i8[size as usize + 1];
        let mut bytesRead: u32 = 0;

        if ReadFile(handle, string, size, &mut bytesRead, null) != 0 {
            string[size as usize] = 0;
            content += string;
        }
    }

    CloseHandle(handle);
    return content;
}

fn _WriteFile(path: &String, content: &String) -> bool {
    let handle = CreateFileA(path.Data(), GENERIC_WRITE, FILE_SHARE_NONE, null, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, null);

    if handle == INVALID_HANDLE_VALUE {
        WriteLine("\x1b[31mFailed to open file for writing: '" + path + "'.\x1b[0m");
        return false;
    }

    let mut written: u32 = 0;
    let success = WriteFile(handle, content.Data(), content.Length() as u32, &mut written, null);
    CloseHandle(handle);
    return success != 0;
}

fn GetTemporaryPath() -> String {
    let mut buffer[256]: i8;
    let length = GetTempPathA(sizeof(buffer) as u32, buffer);

    if length > 0 && length < sizeof(buffer) as u32 {
        return String(buffer, 0, length as usize);
    } else {
        WriteLine("\x1b[31mFailed to get temporary path.\x1b[0m");
        return String();
    }
}

fn AbsolutePath(path: &String) -> String {
    let mut buffer[MAX_PATH]: i8;
    let mut filePart: *mut i8 = null;
    let length = GetFullPathNameA(path.Data(), MAX_PATH as u32, buffer, &mut filePart);

    if length > 0 && length < MAX_PATH as u32 {
        return String(buffer, 0, length as usize);
    } return path;
}

fn PathExists(path: &String) -> bool {
    return GetFileAttributesA(path.Data()) != INVALID_FILE_ATTRIBUTES;
}

fn FileExists(path: &String) -> bool {
    let attributes = GetFileAttributesA(path.Data());

    if attributes != INVALID_FILE_ATTRIBUTES {
        return (attributes & FILE_ATTRIBUTE_DIRECTORY) == 0;
    } else {
        return false;
    }
}

fn FolderExists(path: &String) -> bool {
    let attributes = GetFileAttributesA(path.Data());

    if attributes != INVALID_FILE_ATTRIBUTES {
        return (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
    } else {
        return false;
    }
}

fn RemoveFile(path: &String) -> bool {
    return DeleteFileA(path.Data()) != 0;
}
#[else]
const PATH_SEPERATOR: i8 = '/';
const PATH_MAX: usize = 4096;

const O_RDONLY: i32 = 0;
const O_WRONLY: i32 = 1;

#[if DARWIN]
const O_CREAT: i32 = 512;
const O_TRUNC: i32 = 1024;
#[else]
const O_CREAT: i32 = 64;
const O_TRUNC: i32 = 512;
#[endif]

const S_IRUSR: u32 = 256;
const S_IWUSR: u32 = 128;
const S_IRGRP: u32 = 32;
const S_IWGRP: u32 = 16;

const S_IFMT: u32 = 0xF000;
const S_IFDIR: u32 = 0x4000;
const S_IFREG: u32 = 0x8000;

const SEEK_SET: i32 = 0;
const SEEK_END: i32 = 2;
const F_OK: i32 = 0;

class _stat {
#[if DARWIN]
    pub st_dev: i32,
    pub st_mode: u16,
    pub st_nlink: u16,
    pub st_ino: u64,
    pub st_uid: u32,
    pub st_gid: u32,
    pub st_rdev: i32,
    pub pad0: i32,
    pub st_atime_sec: i64,
    pub st_atime_nsec: i64,
    pub st_mtime_sec: i64,
    pub st_mtime_nsec: i64,
    pub st_ctime_sec: i64,
    pub st_ctime_nsec: i64,
    pub st_btime_sec: i64,
    pub st_btime_nsec: i64,
    pub st_size: i64,
    pub st_blocks: i64,
    pub st_blksize: i32,
    pub st_flags: u32,
    pub st_gen: u32,
    pub st_lspare: i32,
    pub st_qspare0: i64,
    pub st_qspare1: i64
#[else]
    pub st_dev: u64,
    pub st_ino: u64,
    pub st_nlink: u64,
    pub st_mode: u32,
    pub st_uid: u32,
    pub st_gid: u32,
    pub pad0: u32,
    pub st_rdev: u64,
    pub st_size: i64,
    pub rest[88]: i8
#[endif]
}

extern "C" {
    fn open(pathname: *i8, flags: i32, mode: u32) -> i32 #[if DARWIN] ; #[else] {
        let mut result = 0;

        volatile asm : rax(2), rdi(pathname), rsi(flags as i64), rdx(mode as i64) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        return result as i32;
    } #[endif]

    fn read(fd: i32, buf: *mut i8, count: usize) -> isize #[if DARWIN] ; #[else] {
        let mut result: i64 = 0;

        volatile asm : rax(0), rdi(fd as i64), rsi(buf), rdx(count as i64) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        return result as isize;
    } #[endif]

    fn close(fd: i32) #[if DARWIN] ; #[else] {
        volatile asm : rax(3), rdi(fd as i64) -> {
            syscall
        } : memory, rcx, r11, rax;
    } #[endif]

    fn lseek(fd: i32, offset: i64, whence: i32) -> i64 #[if DARWIN] ; #[else] {
        let mut result = 0;

        volatile asm : rax(8), rdi(fd as i64), rsi(offset), rdx(whence as i64) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        return result;
    } #[endif]

    fn stat(pathname: *i8, statbuf: *mut _stat) -> i32 #[if DARWIN] ; #[else] {
        let mut result = 0;

        volatile asm : rax(4), rdi(pathname), rsi(statbuf) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        return result as i32;
    } #[endif]

    fn unlink(pathname: *i8) -> i32 #[if DARWIN] ; #[else] {
        let mut result = 0;

        volatile asm : rax(87), rdi(pathname) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        return result as i32;
    } #[endif]

    fn access(pathname: *i8, mode: i32) -> i32 #[if DARWIN] ; #[else] {
        let mut result = 0;

        volatile asm : rax(21), rdi(pathname), rsi(mode as i64) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        return result as i32;
    } #[endif]

    fn realpath(path: *i8, resolved_path: *mut i8) -> *mut i8;
}

fn _ReadFile(path: &String) -> String {
    let mut content = String();
    let fd = open(path.Data(), O_RDONLY, 0);

    if fd < 0 {
        WriteLine("\x1b[31mFailed to open file for reading: '" + path + "'.\x1b[0m");
        return content;
    }

    let size = lseek(fd, 0, SEEK_END);

    if size > 0 {
        lseek(fd, 0, SEEK_SET);
        let buffer = new i8[size as usize + 1];
        let bytes_read = read(fd, buffer, size as usize);

        if bytes_read > 0 {
            buffer[bytes_read as usize] = 0;
            content = buffer;
        }

        delete[] buffer;
    }

    close(fd);
    return content;
}

fn _WriteFile(path: &String, content: &String) -> bool {
    let mode = S_IRUSR | S_IWUSR | S_IRGRP | S_IWGRP;
    let fd = open(path.Data(), O_WRONLY | O_CREAT | O_TRUNC, mode);

    if fd < 0 {
        WriteLine("\x1b[31mFailed to open file for writing: '" + path + "'.\x1b[0m");
        return false;
    }

    write(fd, content.Data(), content.Length());
    close(fd);
    return true;
}

fn GetTemporaryPath() -> String {
    return String("/tmp/");
}

fn AbsolutePath(path: &String) -> String {
    let buffer[PATH_MAX]: i8;
    let result = realpath(path.Data(), buffer);

    if result != null {
        return String(buffer);
    } return path;
}

fn PathExists(path: &String) -> bool {
    return access(path.Data(), F_OK) == 0;
}

fn FileExists(path: &String) -> bool {
    let mut st: _stat;

    if stat(path.Data(), &mut st) != 0 {
        return false;
    }

#[if DARWIN]
    return (st.st_mode as u32 & S_IFMT) == S_IFREG;
#[else]
    return (st.st_mode & S_IFMT) == S_IFREG;
#[endif]
}

fn FolderExists(path: &String) -> bool {
    let mut st: _stat;

    if stat(path.Data(), &mut st) != 0 {
        return false;
    }

#[if DARWIN]
    return (st.st_mode as u32 & S_IFMT) == S_IFDIR;
#[else]
    return (st.st_mode & S_IFMT) == S_IFDIR;
#[endif]
}

fn RemoveFile(path: &String) -> bool {
    return unlink(path.Data()) == 0;
}
#[endif]

fn JoinPath(directory: &String, file: &String) -> String {
    if directory.Empty() {
        return file;
    }

    if directory[directory.Length() - 1] == '\\' || directory[directory.Length() - 1] == '/' {
        return directory + file;
    } else {
        return directory + PATH_SEPERATOR + file;
    }
}

fn SplitExtension(path: &String) -> Pair<String, String> {
    let mut i = path.Length();
    let mut index = path.Length();

    while i > 0 {
        i -= 1;

        if path[i] == '\\' || path[i] == '/' {
            break;
        }

        if path[i] == '.' {
            index = i;
            break;
        }
    }

    if index == path.Length() {
        return Pair<String, String>(path, String());
    }

    let name = String(path, 0, index);
    let extension = String(path, index, path.Length());
    return Pair<String, String>(name, extension);
}

fn SplitPath(path: &String) -> Pair<String, String> {
    let mut i = path.Length();
    let mut index = path.Length();

    while i > 0 {
        i -= 1;

        if path[i] == '\\' || path[i] == '/' {
            index = i;
            break;
        }
    }

    if index == path.Length() {
        return Pair<String, String>(String(), path);
    }

    let directory = String(path, 0, index);
    let file = String(path, index + 1, path.Length());
    return Pair<String, String>(directory, file);
}