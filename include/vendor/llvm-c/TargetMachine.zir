#[include "vendor/llvm-c/Target.zir", "vendor/llvm-c/Types.zir" : *]

class LLVMOpaqueTargetMachineOptions {}

type LLVMTargetMachineOptionsRef = *mut LLVMOpaqueTargetMachineOptions;

class LLVMOpaqueTargetMachine {}

type LLVMTargetMachineRef = *mut LLVMOpaqueTargetMachine;

class LLVMTarget {}

type LLVMTargetRef = *mut LLVMTarget;

enum LLVMCodeGenOptLevel: i32 {
    LLVMCodeGenLevelNone = 0,
    LLVMCodeGenLevelLess = 1,
    LLVMCodeGenLevelDefault = 2,
    LLVMCodeGenLevelAggressive = 3
}

enum LLVMRelocMode: i32 {
    LLVMRelocDefault = 0,
    LLVMRelocStatic = 1,
    LLVMRelocPIC = 2,
    LLVMRelocDynamicNoPic = 3,
    LLVMRelocROPI = 4,
    LLVMRelocRWPI = 5,
    LLVMRelocROPI_RWPI = 6
}

enum LLVMCodeModel: i32 {
    LLVMCodeModelDefault = 0,
    LLVMCodeModelJITDefault = 1,
    LLVMCodeModelTiny = 2,
    LLVMCodeModelSmall = 3,
    LLVMCodeModelKernel = 4,
    LLVMCodeModelMedium = 5,
    LLVMCodeModelLarge = 6
}

enum LLVMCodeGenFileType: i32 {
    LLVMAssemblyFile = 0,
    LLVMObjectFile = 1
}

enum LLVMGlobalISelAbortMode: i32 {
    LLVMGlobalISelAbortEnable = 0,
    LLVMGlobalISelAbortDisable = 1,
    LLVMGlobalISelAbortDisableWithDiag = 2
}

extern "C" {
    fn LLVMGetFirstTarget() -> LLVMTargetRef;
    fn LLVMGetNextTarget(T: LLVMTargetRef) -> LLVMTargetRef;
    fn LLVMGetTargetFromName(Name: *i8) -> LLVMTargetRef;
    fn LLVMGetTargetFromTriple(Triple: *i8, T: *mut LLVMTargetRef, ErrorMessage: *mut *mut i8) -> LLVMBool;
    fn LLVMGetTargetName(T: LLVMTargetRef) -> *i8;
    fn LLVMGetTargetDescription(T: LLVMTargetRef) -> *i8;
    fn LLVMTargetHasJIT(T: LLVMTargetRef) -> LLVMBool;
    fn LLVMTargetHasTargetMachine(T: LLVMTargetRef) -> LLVMBool;
    fn LLVMTargetHasAsmBackend(T: LLVMTargetRef) -> LLVMBool;
    fn LLVMCreateTargetMachineOptions() -> LLVMTargetMachineOptionsRef;
    fn LLVMDisposeTargetMachineOptions(Options: LLVMTargetMachineOptionsRef);
    fn LLVMTargetMachineOptionsSetCPU(Options: LLVMTargetMachineOptionsRef, CPU: *i8);
    fn LLVMTargetMachineOptionsSetFeatures(Options: LLVMTargetMachineOptionsRef, Features: *i8);
    fn LLVMTargetMachineOptionsSetABI(Options: LLVMTargetMachineOptionsRef, ABI: *i8);
    fn LLVMTargetMachineOptionsSetCodeGenOptLevel(Options: LLVMTargetMachineOptionsRef, Level: LLVMCodeGenOptLevel);
    fn LLVMTargetMachineOptionsSetRelocMode(Options: LLVMTargetMachineOptionsRef, Reloc: LLVMRelocMode);
    fn LLVMTargetMachineOptionsSetCodeModel(Options: LLVMTargetMachineOptionsRef, CodeModel: LLVMCodeModel);
    fn LLVMCreateTargetMachineWithOptions(T: LLVMTargetRef, Triple: *i8, Options: LLVMTargetMachineOptionsRef) -> LLVMTargetMachineRef;
    fn LLVMCreateTargetMachine(T: LLVMTargetRef, Triple: *i8, CPU: *i8, Features: *i8, Level: LLVMCodeGenOptLevel, Reloc: LLVMRelocMode, CodeModel: LLVMCodeModel) -> LLVMTargetMachineRef;
    fn LLVMDisposeTargetMachine(T: LLVMTargetMachineRef);
    fn LLVMGetTargetMachineTarget(T: LLVMTargetMachineRef) -> LLVMTargetRef;
    fn LLVMGetTargetMachineTriple(T: LLVMTargetMachineRef) -> *mut i8;
    fn LLVMGetTargetMachineCPU(T: LLVMTargetMachineRef) -> *mut i8;
    fn LLVMGetTargetMachineFeatureString(T: LLVMTargetMachineRef) -> *mut i8;
    fn LLVMCreateTargetDataLayout(T: LLVMTargetMachineRef) -> LLVMTargetDataRef;
    fn LLVMSetTargetMachineAsmVerbosity(T: LLVMTargetMachineRef, VerboseAsm: LLVMBool);
    fn LLVMSetTargetMachineFastISel(T: LLVMTargetMachineRef, Enable: LLVMBool);
    fn LLVMSetTargetMachineGlobalISel(T: LLVMTargetMachineRef, Enable: LLVMBool);
    fn LLVMSetTargetMachineGlobalISelAbort(T: LLVMTargetMachineRef, Mode: LLVMGlobalISelAbortMode);
    fn LLVMSetTargetMachineMachineOutliner(T: LLVMTargetMachineRef, Enable: LLVMBool);
    fn LLVMTargetMachineEmitToFile(T: LLVMTargetMachineRef, M: LLVMModuleRef, Filename: *i8, codegen: LLVMCodeGenFileType, ErrorMessage: *mut *mut i8) -> LLVMBool;
    fn LLVMTargetMachineEmitToMemoryBuffer(T: LLVMTargetMachineRef, M: LLVMModuleRef, codegen: LLVMCodeGenFileType, ErrorMessage: *mut *mut i8, OutMemBuf: *mut LLVMMemoryBufferRef) -> LLVMBool;
    fn LLVMGetDefaultTargetTriple() -> *mut i8;
    fn LLVMNormalizeTargetTriple(triple: *i8) -> *mut i8;
    fn LLVMGetHostCPUName() -> *mut i8;
    fn LLVMGetHostCPUFeatures() -> *mut i8;
    fn LLVMAddAnalysisPasses(T: LLVMTargetMachineRef, PM: LLVMPassManagerRef);
}
