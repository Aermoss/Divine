        glCopyTexImage1D = load("glCopyTexImage1D") as PFNGLCOPYTEXIMAGE1DPROC;
        glCopyTexImage2D = load("glCopyTexImage2D") as PFNGLCOPYTEXIMAGE2DPROC;
        glCopyTexSubImage1D = load("glCopyTexSubImage1D") as PFNGLCOPYTEXSUBIMAGE1DPROC;
