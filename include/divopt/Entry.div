include "divstd", "divio" : *;

enum Option<T> {
    Some(T),
    None
} impl {
    pub IsSome(this: &Option<T>) -> bool {
        match this {
            Option::Some(_) => ret true,
            Option::None => ret false
        }
    }

    pub IsNone(this: &Option<T>) -> bool {
        match this {
            Option::Some(_) => ret false,
            Option::None => ret true
        }
    }

    pub Unwrap(this: &Option<T>) -> T {
        match this {
            Option::Some(value) => ret value,
            Option::None => {
                WriteLine(String("Panicked: called Unwrap() on a None value."));
                Exit(1i32);
                loop {}
            }
        }
    }

    pub UnwrapOr(this: &Option<T>, default: T) -> T {
        match this {
            Option::Some(value) => ret value,
            Option::None => ret default
        }
    }
};
