#[include "std/mem", "std/vec" : *]

extern "C" {
    func strlen(str: *i8) -> usize {
        let mut i: usize = 0;

        loop {
            if str[i] == 0 {
                ret i;
            } else {
                i += 1;
            }
        } ret 0;
    }

    func strcmp(s1: *i8, s2: *i8) -> i32 {
        let mut i: usize = 0;

        while s1[i] == s2[i] {
            if s1[i] == 0 {
                ret 0;
            } i += 1;
        }

        ret (s1[i] as i32) - (s2[i] as i32);
    }

    func strncmp(s1: *i8, s2: *i8, n: usize) -> i32 {
        for i in 0..n {
            if s1[i] != s2[i] {
                ret (s1[i] as i32) - (s2[i] as i32);
            }

            if s1[i] == 0 {
                break;
            }
        } ret 0;
    }
}

class String {
    priv data: *mut i8 = null,
    priv length: usize = 0;

    String(&mut this) {
        this.Allocate(0);
    }

    String(&mut this, character: i8) {
        this.Allocate(1);
        this.data[0] = character;
    }

    String(&mut this, string: *i8) {
        let other_length = strlen(string);

        if string == null {
            this.Allocate(0);
            ret;
        }

        this.Allocate(other_length);
        memcpy(this.data, string, other_length);
    }

    String(&mut this, other: &String) {
        if other.data == null {
            this.Allocate(0);
            ret;
        }

        this.Allocate(other.length);
        memcpy(this.data, other.data, other.length);
    }

    String(&mut this, string: *i8, mut length: usize) {
        let other_length = strlen(string);

        if string == null || length == 0 {
            this.Allocate(0);
            ret;
        }

        if length > other_length {
            length = other_length;
        }

        this.Allocate(length);
        memcpy(this.data, string, length);
    }

    String(&mut this, other: &String, mut length: usize) {
        if other.data == null || length == 0 {
            this.Allocate(0);
            ret;
        }

        if length > other.length {
            length = other.length;
        }

        this.Allocate(length);
        memcpy(this.data, other.data, length);
    }

    String(&mut this, string: *i8, start: usize, mut length: usize) {
        let other_length = strlen(string);

        if string == null || start >= other_length || length == 0 {
            this.Allocate(0);
            ret;
        }

        if start + length > other_length {
            length = other_length - start;
        }

        this.Allocate(length);
        memcpy(this.data, (string + start), length);
    }

    String(&mut this, other: &String, start: usize, mut length: usize) {
        if other.data == null || start >= other.length || length == 0 {
            this.Allocate(0);
            ret;
        }

        if start + length > other.length {
            length = other.length - start;
        }

        this.Allocate(length);
        memcpy(this.data, (other.data + start), length);
    }

    ~String(&mut this) {
        this.Release();
    }

    pub Data(&this) -> *i8 { ret this.data; }
    pub Empty(&this) -> bool { ret this.length == 0; }
    pub Size(&this) -> usize { ret this.length + 1; }
    pub Length(&this) -> usize { ret this.length; }

    priv Allocate(&mut this, length: usize) {
        (this.data, this.length) = (new i8[length + 1], length);
        this.data[length] = '\0';
    }

    priv Release(&mut this) {
        if this.data != null { del[] this.data; }
        (this.data, this.length) = (null, 0);
    }

    pub Clear(&mut this) {
        this.Release();
        this.Allocate(0);
    }

    pub FromInteger(mut value: u64, base: u64) -> String {
        if base < 2 || base > 36 { ret String(); }
        else if value == 0 { ret String("0"); }
        else {
            let mut result = String();

            while value > 0 {
                result += "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"[(value % base) as usize];
                value /= base;
            }

            ret result.Reverse();
        }
    }

    pub FromInteger(value: u64) -> String {
        ret String::FromInteger(value, 10);
    }

    pub FromInteger(value: i64, base: i64) -> String {
        if base < 2 || base > 36 {
            ret String();
        } else if value >= 0 {
            ret String::FromInteger(value as u64, base as u64);
        } else if base != 10 {
            ret String::FromInteger((!value + 1) as u64, base as u64);
        } else {
            ret '-' + String::FromInteger((!value + 1) as u64, base as u64);
        }
    }

    pub FromInteger(value: i64) -> String {
        ret String::FromInteger(value, 10);
    }

    pub FromFloat(mut value: f64, precision: usize) -> String {
        if value != value { ret "nan".ToString(); }
        else if value == (1.0 / 0.0) { ret "inf".ToString(); }
        else if value == (-1.0 / 0.0) { ret "-inf".ToString(); }
        else if value == 0.0 { ret "0.0".ToString(); }
        else if value < 0.0 {
            ret '-' + String::FromFloat(-value, precision);
        } else {
            let mut exponent: i64 = 0;

            if value >= 1e9 {
                while value >= 10.0 {
                    value /= 10.0;
                    exponent += 1;
                }
            } else if value < 1e-4 {
                while value < 1.0 {
                    value *= 10.0;
                    exponent -= 1;
                }
            }

            let mut integer = value as u64;
            let mut fraction = value - (integer as f64);
            let mut round = 0.5;

            for _ in 0..precision {
                round /= 10.0;
            }

            fraction += round;

            if fraction >= 1.0 {
                fraction -= 1.0;
                integer += 1;
            }

            let result = String::FromInteger(integer);

            if precision != 0 {
                result += '.';
            }

            for i in 0..precision {
                fraction *= 10.0;
                let digit = fraction as i8;
                fraction -= digit as f64;
                result += '0' + digit;
            }

            if exponent != 0 {
                result += 'e';

                if exponent < 0 {
                    result += '-' + String::FromInteger(-exponent);
                } else {
                    result += '+' + String::FromInteger(exponent);
                }
            } ret result;
        }
    }

    pub FromFloat(mut value: f64) -> String {
        ret String::FromFloat(value, 6);
    }

    priv ParseUnsigned(&this, base: u64, negative: &mut bool) -> u64 {
        if this.length == 0 { ret 0; }
        if base < 2 || base > 36 { ret 0; }
        let mut result: u64 = 0;
        let mut i: usize = 0;

        if this.data[0] == '-' {
            negative = true;
            i = 1;
        } else if this.data[0] == '+' {
            negative = false;
            i = 1;
        }

        while i < this.length {
            let c: i8 = this.data[i];
            let mut value: u64 = 0;

            if c >= '0' && c <= '9' {
                value = (c - '0') as u64;
            } else if c >= 'A' && c <= 'Z' {
                value = (c - 'A' + 10) as u64;
            } else if c >= 'a' && c <= 'z' {
                value = (c - 'a' + 10) as u64;
            } else {
                break;
            }

            if value >= base { break; }
            result = result * base + value;
            i += 1;
        } ret result;
    }

    pub ToUnsignedInteger(&this, base: u64) -> u64 {
        let mut negative = false;
        let value = this.ParseUnsigned(base, negative);

        if negative {
            ret !value + 1;
        } ret value;
    }

    pub ToUnsignedInteger(&this) -> u64 {
        ret this.ToUnsignedInteger(10);
    }

    pub ToInteger(&this, base: i64) -> i64 {
        let mut negative = false;
        let value = this.ParseUnsigned(base as u64, negative);

        if negative {
            ret -(value as i64);
        } ret value as i64;
    }

    pub ToInteger(&this) -> i64 {
        ret this.ToInteger(10);
    }

    pub ToFloat(&this) -> f64 {
        if this.length == 0 { ret 0.0; }
        if this == "nan" { ret 0.0 / 0.0; }
        if this == "inf" || this == "+inf" { ret 1.0 / 0.0; }
        if this == "-inf" { ret -1.0 / 0.0; }
        let (mut value, mut negative) = (0.0, false);
        let mut i: usize = 0;

        if this.data[0] == '-' {
            negative = true;
            i = 1;
        } else if this.data[0] == '+' {
            i = 1;
        }

        while i < this.length {
            let c: i8 = this.data[i];
            if c < '0' || c > '9' { break; }
            value *= 10.0;
            value += (c - '0') as f64;
            i += 1;
        }

        if i < this.length && this.data[i] == '.' {
            i += 1;
            let mut divisor = 10.0;

            while i < this.length {
                let c: i8 = this.data[i];
                if c < '0' || c > '9' { break; }
                value += (c - '0') as f64 / divisor;
                divisor *= 10.0;
                i += 1;
            }
        }

        if i < this.length && (this.data[i] == 'e' || this.data[i] == 'E') {
            i += 1;
            let mut negative = false;

            if i < this.length {
                if this.data[i] == '-' {
                    negative = true;
                    i += 1;
                } else if this.data[i] == '+' {
                    i += 1;
                }
            }

            let mut exponent: i64 = 0;

            while i < this.length {
                let c: i8 = this.data[i];
                if c < '0' || c > '9' { break; }
                exponent *= 10;
                exponent += (c - '0') as i64;
                i += 1;
            }

            while exponent > 0 {
                if negative {
                    value /= 10.0;
                } else {
                    value *= 10.0;
                } exponent -= 1;
            }
        }

        if negative {
            ret -value;
        } ret value;
    }

    pub ToLower(&this) -> String {
        let mut result: String;
        result.Allocate(this.length);

        for i in 0..this.length {
            let mut c: i8 = this.data[i];
            if c >= 'A' && c <= 'Z' { c += 32; }
            result.data[i] = c;
        } ret result;
    }

    pub ToUpper(&this) -> String {
        let mut result: String;
        result.Allocate(this.length);

        for i in 0..this.length {
            let mut c: i8 = this.data[i];
            if c >= 'a' && c <= 'z' { c -= 32; }
            result.data[i] = c;
        } ret result;
    }

    pub Reverse(&this) -> String {
        let mut result: String;
        result.Allocate(this.length);

        for i in 0..this.length {
            result.data[i] = this.data[this.length - 1 - i];
        } ret result;
    }

    pub Escape(&this) -> String {
        let mut result: String;

        for i in 0..this.length {
            if this.data[i] == '\a' {
                result += "\\a";
            } else if this.data[i] == '\b' {
                result += "\\b";
            } else if this.data[i] == '\f' {
                result += "\\f";
            } else if this.data[i] == '\n' {
                result += "\\n";
            } else if this.data[i] == '\r' {
                result += "\\r";
            } else if this.data[i] == '\t' {
                result += "\\t";
            } else if this.data[i] == '\v' {
                result += "\\v";
            } else {
                result += this.data[i];
            }
        } ret result;
    }

    pub Replace(&this, from: &String, to: &String) -> String {
        ret this.Replace(from.data, to.data, from.length);
    }

    pub Replace(&this, from: *i8, to: &String) -> String {
        ret this.Replace(from, to.data, strlen(from));
    }

    pub Replace(&this, from: &String, to: *i8) -> String {
        ret this.Replace(from.data, to, from.length);
    }

    pub Replace(&this, from: *i8, to: *i8) -> String {
        ret this.Replace(from, to, strlen(from));
    }

    priv Replace(&this, from: *i8, to: *i8, length: usize) -> String {
        let mut result: String;
        let mut i: usize = 0;

        if length == 0 {
            result += this.data;
            ret result;
        }

        while i < this.length {
            let mut _match = true;

            for j in 0..length {
                if i + j >= this.length || this.data[i + j] != from[j] {
                    _match = false;
                    break;
                }
            }

            if _match {
                result += to;
                i += length;
            } else {
                result += this.data[i];
                i += 1;
            }
        } ret result;
    }

    pub SubString(&this, start: usize) -> String {
        if start < this.length {
            ret String(this.data + start);
        } else {
            ret String("");
        }
    }

    pub SubString(&this, start: usize, mut length: usize) -> String {
        if start < this.length {
            let mut result: String;

            if start + length > this.length {
                length = this.length - start;
            }

            for i in 0..length {
                result += this.data[start + i];
            } ret result;
        } else {
            ret String("");
        }
    }

    pub Contains(&this, substring: &String) -> bool {
        ret this.Contains(substring.data, substring.length);
    }

    pub Contains(&this, substring: *i8) -> bool {
        ret this.Contains(substring, strlen(substring));
    }

    priv Contains(&this, substring: *i8, length: usize) -> bool {
        ret this.Find(substring, length) != -1;
    }

    pub Contains(&this, character: i8) -> bool {
        ret this.Find(character) != -1;
    }

    pub StartsWith(&this, prefix: &String) -> bool {
        ret this.StartsWith(prefix.data, prefix.length);
    }

    pub StartsWith(&this, prefix: *i8) -> bool {
        ret this.StartsWith(prefix, strlen(prefix));
    }

    priv StartsWith(&this, prefix: *i8, length: usize) -> bool {
        if prefix == null { ret false; }
        if length == 0 { ret true; }
        if length > this.length { ret false; }

        for i in 0..length {
            if this.data[i] != prefix[i] {
                ret false;
            }
        } ret true;
    }

    pub EndsWith(&this, suffix: &String) -> bool {
        ret this.EndsWith(suffix.data, suffix.length);
    }

    pub EndsWith(&this, suffix: *i8) -> bool {
        ret this.EndsWith(suffix, strlen(suffix));
    }

    priv EndsWith(&this, suffix: *i8, length: usize) -> bool {
        if suffix == null { ret false; }
        if length == 0 { ret true; }
        if length > this.length { ret false; }
        let start = this.length - length;

        for i in 0..length {
            if this.data[start + i] != suffix[i] {
                ret false;
            }
        } ret true;
    }

    pub Split(&this, delimiter: i8) -> Vector<String> {
        let mut result: Vector<String>;
        let mut current: String;

        for i in 0..this.length {
            if this.data[i] != delimiter {
                current += this.data[i];
            } else {
                result.PushBack(current);
                current = "";
            }
        }

        if !current.Empty() {
            result.PushBack(current);
        } ret result;
    }

    pub Split(&this, delimiter: &String) -> Vector<String> {
        ret this.Split(delimiter.data, delimiter.length);
    }

    pub Split(&this, delimiter: *i8) -> Vector<String> {
        ret this.Split(delimiter, strlen(delimiter));
    }

    priv Split(&this, delimiter: *i8, length: usize) -> Vector<String> {
        let mut result: Vector<String>;

        if length == 0 {
            result.PushBack(String(this.data));
            ret result;
        }

        if length == 1 {
            ret this.Split(delimiter[0]);
        }

        let mut current: String;
        let mut i: usize = 0;

        while i < this.length {
            let mut found = true;

            if i + length <= this.length {
                for j in 0..length {
                    if this.data[i + j] != delimiter[j] {
                        found = false;
                        break;
                    }
                }
            } else {
                found = false;
            }

            if found {
                result.PushBack(current);
                current = String("");
                i += length;
            } else {
                current += this.data[i];
                i += 1;
            }
        }

        if !current.Empty() {
            result.PushBack(current);
        } ret result;
    }

    pub Count(&this, substring: &String) -> usize {
        ret this.Count(substring.data, substring.length);
    }

    pub Count(&this, substring: *i8) -> usize {
        ret this.Count(substring, strlen(substring));
    }

    priv Count(&this, substring: *i8, length: usize) -> usize {
        if substring == null { ret 0; }
        if length == 0 { ret 0; }
        if length > this.length { ret 0; }
        let mut count: usize = 0;
        let mut i: usize = 0;

        while i <= this.length - length {
            let mut found = true;

            for j in 0..length {
                if this.data[i + j] != substring[j] {
                    found = false;
                    break;
                }
            }

            if found {
                count += 1;
                i += length;
            } else {
                i += 1;
            }
        } ret count;
    }

    pub Count(&this, character: i8) -> usize {
        let mut count: usize = 0;

        for i in 0..this.length {
            if this.data[i] == character {
                count += 1;
            }
        } ret count;
    }

    pub Find(&this, substring: &String) -> isize {
        ret this.Find(substring.data, substring.length);
    }

    pub Find(&this, substring: *i8) -> isize {
        ret this.Find(substring, strlen(substring));
    }

    priv Find(&this, substring: *i8, length: usize) -> isize {
        if substring == null { ret -1; }
        if length == 0 { ret 0; }
        if length > this.length { ret -1; }

        for i in 0..=(this.length - length) {
            let mut found = true;

            for j in 0..length {
                if this.data[i + j] != substring[j] {
                    found = false;
                    break;
                }
            }

            if found {
                ret i as isize;
            }
        } ret -1;
    }

    pub Find(&this, character: i8) -> isize {
        for i in 0..this.length {
            if this.data[i] == character {
                ret i as isize;
            }
        } ret -1;
    }

    pub Strip(&this) -> String {
        let mut start: usize = 0;

        while start < this.length && (this.data[start] == ' ' || this.data[start] == '\t') {
            start += 1;
        }

        let mut end = this.length;

        while end > start && (this.data[end - 1] == ' ' || this.data[end - 1] == '\t' || this.data[end - 1] == '\n' || this.data[end - 1] == '\r') {
            end -= 1;
        }

        ret this.SubString(start, end - start);
    }

    pub Hash(&this) -> u64 {
        let mut hash: u64 = 0xcbf29ce484222325;

        for i in 0..this.length {
            let character: i8 = this.data[i];
            hash = hash ^ (character as u64 & 0xFF);
            hash = hash * 0x100000001b3;
        } ret hash;
    }

    pub op=(&mut this, other: &String) -> &mut String {
        ret this.op=(other.data);
    }

    pub op=(&mut this, string: *i8) -> &mut String {
        this.Release();

        if string == null {
            this.Allocate(0);
            ret this;
        }

        this.Allocate(strlen(string));
        memcpy(this.data, string, this.length);
        ret this;
    }

    pub op=(&mut this, character: i8) -> &mut String {
        this.Release();
        this.Allocate(1);
        this.data[0] = character;
        ret this;
    }

    pub op+=(&mut this, other: &String) -> &mut String {
        ret this.op+=(other.data);
    }

    pub op+=(&mut this, string: *i8) -> &mut String {
        if string == null { ret this; }
        let string_length = strlen(string);
        let (data, length) = (this.data, this.length);
        this.Allocate(length + string_length);

        if data != null {
            memcpy(this.data, data, length);
            del[] data;
        }

        memcpy((this.data + length), string, string_length);
        ret this;
    }

    pub op+=(&mut this, character: i8) -> &mut String {
        let (data, length) = (this.data, this.length);
        this.Allocate(length + 1);

        if data != null {
            memcpy(this.data, data, length);
            del[] data;
        }

        this.data[length] = character;
        ret this;
    }

    pub op+(&this, other: &String) -> String {
        ret this.op+(other.data);
    }

    pub op+(&this, string: *i8) -> String {
        let mut result = String(this.data);
        result += string;
        ret result;
    }

    pub op+(&this, character: i8) -> String {
        let mut result = String(this.data);
        result += character;
        ret result;
    }

    pub op*=(&mut this, count: usize) -> &mut String {
        if count <= 0 {
            this.Release();
            this.Allocate(0);
            ret this;
        } else {
            let temp = String(this.data);

            for i in 0..(count - 1) {
                this.op+=(temp.data);
            } ret this;
        }
    }

    pub op*(&this, count: usize) -> String {
        let mut result = String(this.data);
        result *= count;
        ret result;
    }

    pub op==(&this, other: &String) -> bool {
        if this.length != other.length { ret false; }
        if this.data == null || other.data == null { ret false; }
        ret strcmp(this.data, other.data) == 0;
    }

    pub op==(&this, string: *i8) -> bool {
        if this.length != strlen(string) { ret false; }
        if this.data == null || string == null { ret false; }
        ret strcmp(this.data, string) == 0;
    }

    pub op==(&this, character: i8) -> bool {
        if this.length != 1 { ret false; }
        if this.data == null { ret false; }
        ret this.data[0] == character;
    }

    pub op!=(&this, other: &String) -> bool {
        ret !(this == other);
    }

    pub op!=(&this, string: *i8) -> bool {
        ret !(this == string);
    }

    pub op!=(&this, character: i8) -> bool {
        ret !(this == character);
    }

    pub op[](&this, index: usize) -> &mut i8 {
        ret this.data[index];
    }

    pub Begin(&this) -> *i8 {
        ret this.data;
    }

    pub End(&this) -> *i8 {
        ret this.data + this.length;
    }
}

func ToString(value: i8) -> String {
    ret String(value);
}

func ToString(value: *i8) -> String {
    ret String(value);
}

func op+(value: i8, string: &String) -> String {
    ret String(value) + string;
}

func op+(value: *i8, string: &String) -> String {
    ret String(value) + string;
}

func op*(value: i8, count: usize) -> String {
    ret String(value) * count;
}

func op*(value: *i8, count: usize) -> String {
    ret String(value) * count;
}
