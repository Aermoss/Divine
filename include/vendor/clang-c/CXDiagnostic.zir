include "vendor/clang-c/CXSourceLocation.zir", "vendor/clang-c/CXString.zir" : *;

enum CXDiagnosticSeverity: i32 {
    CXDiagnostic_Ignored = 0i32,
    CXDiagnostic_Note = 1i32,
    CXDiagnostic_Warning = 2i32,
    CXDiagnostic_Error = 3i32,
    CXDiagnostic_Fatal = 4i32,
}

type CXDiagnostic = *mut void;
type CXDiagnosticSet = *mut void;

enum CXLoadDiag_Error: i32 {
    CXLoadDiag_None = 0i32,
    CXLoadDiag_Unknown = 1i32,
    CXLoadDiag_CannotLoad = 2i32,
    CXLoadDiag_InvalidFile = 3i32,
}

enum CXDiagnosticDisplayOptions: i32 {
    CXDiagnostic_DisplaySourceLocation = 1i32,
    CXDiagnostic_DisplayColumn = 2i32,
    CXDiagnostic_DisplaySourceRanges = 4i32,
    CXDiagnostic_DisplayOption = 8i32,
    CXDiagnostic_DisplayCategoryId = 16i32,
    CXDiagnostic_DisplayCategoryName = 32i32,
}

extern "C" {
    func clang_getNumDiagnosticsInSet(Diags: CXDiagnosticSet) -> u32;
    func clang_getDiagnosticInSet(Diags: CXDiagnosticSet, Index: u32) -> CXDiagnostic;
    func clang_loadDiagnostics(file: *const i8, error: *mut CXLoadDiag_Error, errorString: *mut CXString) -> CXDiagnosticSet;
    func clang_disposeDiagnosticSet(Diags: CXDiagnosticSet);
    func clang_getChildDiagnostics(D: CXDiagnostic) -> CXDiagnosticSet;
    func clang_disposeDiagnostic(Diagnostic: CXDiagnostic);
    func clang_formatDiagnostic(Diagnostic: CXDiagnostic, Options: u32) -> CXString;
    func clang_defaultDiagnosticDisplayOptions() -> u32;
    func clang_getDiagnosticSeverity(_p0: CXDiagnostic) -> CXDiagnosticSeverity;
    func clang_getDiagnosticLocation(_p0: CXDiagnostic) -> CXSourceLocation;
    func clang_getDiagnosticSpelling(_p0: CXDiagnostic) -> CXString;
    func clang_getDiagnosticOption(Diag: CXDiagnostic, Disable: *mut CXString) -> CXString;
    func clang_getDiagnosticCategory(_p0: CXDiagnostic) -> u32;
    func clang_getDiagnosticCategoryName(Category: u32) -> CXString;
    func clang_getDiagnosticCategoryText(_p0: CXDiagnostic) -> CXString;
    func clang_getDiagnosticNumRanges(_p0: CXDiagnostic) -> u32;
    func clang_getDiagnosticRange(Diagnostic: CXDiagnostic, Range: u32) -> CXSourceRange;
    func clang_getDiagnosticNumFixIts(Diagnostic: CXDiagnostic) -> u32;
    func clang_getDiagnosticFixIt(Diagnostic: CXDiagnostic, FixIt: u32, ReplacementRange: *mut CXSourceRange) -> CXString;
}
