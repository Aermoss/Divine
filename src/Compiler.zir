#[include "std/io", "std/str", "std/vec", "std/map", "std/pair", "vendor/llvm",
    "src/Logger.zir", "src/Context.zir", "src/Target.zir", "src/Mangler.zir", "src/Generic.zir", "src/TypeManager.zir", "src/Types.zir",
        "src/ScopeManager.zir", "src/Scope.zir", "src/Symbol.zir", "src/Value.zir", "src/Tokens.zir", "src/Nodes.zir" : *]

fn LLVMPositionBuilderAtStart(builder: LLVMBuilderRef, block: LLVMBasicBlockRef) {
    let instruction = LLVMGetFirstInstruction(block);

    if instruction != null {
        LLVMPositionBuilderBefore(builder, instruction);
    } else {
        LLVMPositionBuilderAtEnd(builder, block);
    }
}

class Forward {
    pub _class: *QualifiedType,
    pub generic: *Generic = null,
    pub types: Vector<*QualifiedType>,
    pub pack_types: Vector<*QualifiedType>,
    pub declaration: *FunctionNode,
    pub _type: *QualifiedType,
    pub value: LLVMValueRef;

    Forward(&mut this, declaration: *FunctionNode, _type: *QualifiedType, value: LLVMValueRef, _class: *QualifiedType) {
        (this.declaration, this._type, this.value, this._class) = (declaration, _type, value, _class);
    }

    Forward(&mut this, declaration: *FunctionNode, _type: *QualifiedType, value: LLVMValueRef, _class: *QualifiedType, types: &Vector<*QualifiedType>, generic: *Generic) {
        (this.declaration, this._type, this.value, this._class, this.types, this.generic) = (declaration, _type, value, _class, types, generic);
    }

    ~Forward(&this) {}
}

class Compiler {
    pack_specializing: bool = false,
    pack_types: Vector<*QualifiedType>,
    current_pack_name: String,
    current_pack_values: Vector<QualifiedValue>,

    pub scope_manager: ScopeManager,
    pub type_manager: TypeManager,

    pub generics: Vector<*Generic>,
    pub generic: *mut Generic = null,
    pub function: *QualifiedType = null,
    pub function_ref: LLVMValueRef = null,
    pub _class: *QualifiedType = null,

    pub mangling: bool = true,
    pub _unsafe: bool = false,

    loop_blocks: Vector<Pair<LLVMBasicBlockRef, LLVMBasicBlockRef>>,
    loop_scopes: Vector<*mut Scope>,

    forwards: Vector<Forward>,
    pass_cache: Map<*Node, Pair<*mut QualifiedType, *mut Scope>>,
    enum_pass_cache: Map<*Node, *QualifiedType>,

    module: LLVMModuleRef = null,
    pub builder: LLVMBuilderRef = null,
    pub context: LLVMContextRef,
    pub target: *Target,

    freestanding: bool,
    no_red_zone: bool,
    systemv: bool;

    Compiler(&mut this, context: &Context, target: &Target, freestanding: bool, no_red_zone: bool) {
        if compiler != null {
            Logger::Log("Another instance of 'Compiler' already exists!", LogSeverity::Fatal);
        }

        (compiler, this.context) = (this, context.context);
        (this.systemv, this.target) = (!target.triple.Contains("windows"), target);
        (this.freestanding, this.no_red_zone) = (freestanding, no_red_zone);
    }

    ~Compiler(&mut this) {
        if this.builder != null {
            LLVMDisposeBuilder(this.builder);
            this.builder = null;
        }

        if this.module != null {
            LLVMDisposeModule(this.module);
            this.module = null;
        }

        compiler = null;
    }

    pub fn Compile(&mut this, node: *RootNode, file_name: &String) -> LLVMModuleRef {
        if this.builder != null {
            LLVMDisposeBuilder(this.builder);
            this.builder = null;
        }

        if this.module != null {
            LLVMDisposeModule(this.module);
            this.module = null;
        }

        this.module = LLVMModuleCreateWithNameInContext("zircon", this.context);
        this.builder = LLVMCreateBuilderInContext(this.context);
        this.scope_manager.builder = this.builder;
        LLVMSetSourceFileName(this.module, file_name.Data(), file_name.Length());
        LLVMSetModuleDataLayout(this.module, this.target->layout);
        LLVMSetTarget(this.module, this.target->triple.Data());
        let mut declared = Map<*Node, bool>();

        for declaration in node->declarations {
            declared[declaration] = false;
            declared[declaration] |= this.CompileDeclarationFirstPass(declaration);
        }

        for declaration in node->declarations {
            declared[declaration] |= this.CompileDeclarationSecondPass(declaration);
        }

        for declaration in node->declarations {
            declared[declaration] |= this.CompileDeclarationThirdPass(declaration);

            if !declared[declaration] {
                Logger::Log("Unknown declaration '" + declaration->_type.ToString() + "'.", declaration, LogSeverity::Error);
            }
        }

        this.pass_cache.Clear();
        this.CompileForwardDeclarations();
        this.scope_manager.builder = null;

        for generic in this.generics {
            delete generic;
        }

        this.generics.Clear();
        this.forwards.Clear();

        if !Logger::HasError() {
            let message: *i8 = null;

            if LLVMVerifyModule(this.module, LLVMVerifierFailureAction::LLVMReturnStatusAction, &message) != 0 {
                let final_message = message != null ? message : "Unknown reason.";
                Logger::Log(file_name, "Module verification failed: " + final_message.ToString(), LogSeverity::Error);
            }

            if message != null {
                LLVMDisposeMessage(message);
            } return this.module;
        } return null;
    }

    fn CompileForwardDeclarations(&mut this) {
        let mut i: usize = 0;

        while i < this.forwards.Size() {
            let forward: Forward = this.forwards[i];
            let prev_scope = this.scope_manager.current;
            (this.function, this.function_ref) = (forward._type, forward.value);
            let has_instance = forward.declaration->_type->instance_kind != InstanceKind::None;
            let params = this.function->Parameters();
            this._class = forward._class;

            if forward.generic != null {
                this.scope_manager.current = forward.generic->scope;
            }

            let mut index: usize = 0;
            let mut symbols = Vector<*Symbol>();

            for _type in forward.types {
                symbols.PushBack(forward.generic->scope->Set(forward.generic->type_names[index], SymbolKind::Type, QualifiedValue(null, _type), false, forward.declaration));
                index += 1;
            }

            this.scope_manager.PushScope(forward.declaration->name, false);
            let entry = LLVMAppendBasicBlockInContext(this.context, this.function_ref, "");
            LLVMPositionBuilderAtEnd(this.builder, entry);
            let mut j: usize = 0;

            while (has_instance && j == 0) || j < forward.declaration->_type->parameters.Size() + (has_instance ? 1 : 0) {
                let (mut name: String, mut mutable: bool);

                if has_instance && j == 0 {
                    (name, mutable) = ("this", false);
                } else {
                    let index = has_instance ? j - 1 : j;
                    let param = forward.declaration->_type->parameters[index];
                    (name, mutable) = (param->name, param->mutable);
                }

                let index = params[0].sret != null ? j + 1 : j;
                let mut _type = params[index]._type;

                if params[index].byval != null && _type->IsPointer() {
                    _type = this.type_manager.Pointer(params[index].byval, mutable);
                    let instance = QualifiedValue(LLVMGetParam(this.function_ref, index as u32), _type, true);
                    this.scope_manager.Set(name, SymbolKind::Parameter, instance, false, forward.declaration);
                    if _type->Pointee().HasFields() { this.scope_manager.RegisterInstance(instance); }
                } else {
                    if params[index].byval != null { _type = params[index].byval; }
                    let current = LLVMGetInsertBlock(this.builder);
                    LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
                    let pointer = LLVMBuildAlloca(this.builder, _type->Value(), "");

                    LLVMPositionBuilderAtEnd(this.builder, current);
                    LLVMBuildStore(this.builder, LLVMGetParam(this.function_ref, index as u32), pointer);
                    let instance = QualifiedValue(pointer, this.type_manager.Pointer(_type, mutable), true);
                    if params[index].byval != null && _type->HasFields() { this.scope_manager.RegisterInstance(instance); }
                    this.scope_manager.Set(name, SymbolKind::Parameter, instance, false, forward.declaration);
                } j += 1;
            }

            let (prev_pack_name, prev_pack_values) = (this.current_pack_name, this.current_pack_values);
            this.current_pack_name = forward.declaration->_type->pack_name;
            this.current_pack_values.Clear();

            if this.current_pack_name != "" {
                let offset: usize = !params.Empty() && params[0].sret != null ? 1 : 0;

                while j + offset < params.Size() {
                    let index = j + offset;
                    let mut _type = params[index]._type;

                    if params[index].byval != null && _type->IsPointer() {
                        _type = this.type_manager.Pointer(params[index].byval, false);
                        let instance = QualifiedValue(LLVMGetParam(this.function_ref, index as u32), _type, true);
                        if _type->Pointee().HasFields() { this.scope_manager.RegisterInstance(instance); }
                        this.current_pack_values.PushBack(instance);
                    } else {
                        if params[index].byval != null { _type = params[index].byval; }
                        let current = LLVMGetInsertBlock(this.builder);
                        LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
                        let pointer = LLVMBuildAlloca(this.builder, _type->Value(), "");

                        LLVMPositionBuilderAtEnd(this.builder, current);
                        LLVMBuildStore(this.builder, LLVMGetParam(this.function_ref, index as u32), pointer);
                        let instance = QualifiedValue(pointer, this.type_manager.Pointer(_type, false), true);
                        if params[index].byval != null && _type->HasFields() { this.scope_manager.RegisterInstance(instance); }
                        this.current_pack_values.PushBack(instance);
                    } j += 1;
                }
            }

            for constructor in forward.declaration->constructors {
                let _class = this.CompileType(constructor->expression);
                let mut values = Vector<QualifiedValue>();

                for argument in constructor->arguments {
                    if !this.CompileArgument(argument, &mut values) {
                        return;
                    }
                }

                let index: usize = params[0].sret != null ? 1 : 0;
                let instance = QualifiedValue(LLVMGetParam(this.function_ref, index as u32), params[index]._type);
                this.CompileConstructor(_class, this.CompileResolvedCast(instance, this.type_manager.Pointer(_class, true), forward.declaration), values, forward.declaration);
            }

            this.CompileBlock(forward.declaration->body);
            (this.current_pack_name, this.current_pack_values) = (prev_pack_name, prev_pack_values);
            this.scope_manager.PopScope();

            if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
                let mut state = true;

                if this.function->Return()._type->IsVoid() {
                    if !params.Empty() {
                        state = params[0].sret != null;
                    } else {
                        state = false;
                    }
                }

                if !state {
                    LLVMBuildRetVoid(this.builder);
                } else {
                    Logger::Log("Function '" + forward.declaration->name + "' must return a value.", forward.declaration, LogSeverity::Error);
                    return;
                }
            }

            for symbol in symbols {
                let index = forward.generic->scope->symbols.Index(symbol);

                if index != -1 {
                    forward.generic->scope->symbols.RemoveAt(index as usize);
                    delete symbol;
                }
            }

            if forward.generic != null {
                this.scope_manager.current = prev_scope;
            } i += 1;
        }
    }

    fn CompileDeclarationFirstPass(&mut this, declaration: *Node) -> bool {
        if declaration->_type == NodeType::CLASS {
            let _class = declaration as *ClassNode;
            let cache = this.CompileClassFirstPass(_class, null);
            if !_class->generic && cache.left != null && cache.right != null { this.pass_cache[declaration] = cache; }
        } else if declaration->_type == NodeType::STRUCTURE {
            let _struct = declaration as *StructureNode;
            let cache = this.CompileStructureFirstPass(_struct, null);
            if !_struct->generic && cache.left != null && cache.right != null { this.pass_cache[declaration] = cache; }
        } else if declaration->_type == NodeType::ENUMERATION {
            let _enum = declaration as *EnumNode;

            if _enum->variant {
                let cache = this.CompileVariantFirstPass(_enum, null);
                if !_enum->generic && cache.left != null && cache.right != null { this.pass_cache[declaration] = cache; }
            } else {
                let cache = this.CompileEnumerationFirstPass(_enum);
                if cache != null { this.enum_pass_cache[declaration] = cache; }
            }
        } else {
            return false;
        } return true;
    }

    fn CompileDeclarationSecondPass(&mut this, declaration: *Node) -> bool {
        if declaration->_type == NodeType::CONSTANT {
            this.CompileConstant(declaration as *ConstantNode);
        } else if declaration->_type == NodeType::CLASS {
            let _class = declaration as *ClassNode;

            if !_class->generic && this.pass_cache.Has(declaration) {
                let cache = this.pass_cache[declaration];
                this.CompileClassSecondPass(cache.left, _class, cache.right);
            }
        } else if declaration->_type == NodeType::STRUCTURE {
            let _struct = declaration as *StructureNode;

            if !_struct->generic && this.pass_cache.Has(declaration) {
                let cache = this.pass_cache[declaration];
                this.CompileStructureSecondPass(cache.left, _struct, cache.right);
            }
        } else if declaration->_type == NodeType::ENUMERATION {
            let _enum = declaration as *EnumNode;

            if _enum->variant {
                if !_enum->generic && this.pass_cache.Has(declaration) {
                    let cache = this.pass_cache[declaration];
                    this.CompileVariantSecondPass(cache.left, _enum, cache.right);
                }
            } else {
                if this.enum_pass_cache.Has(declaration) {
                    this.CompileEnumerationSecondPass(_enum, this.enum_pass_cache[declaration]);
                }
            }
        } else if declaration->_type == NodeType::TYPE_DEFINITION {
            this.CompileTypeDefinition(declaration as *TypeDefinitionNode);
        } else {
            return false;
        } return true;
    }

    fn CompileTypeDefinition(&mut this, type_definition: *TypeDefinitionNode) {
        this.scope_manager.Set(type_definition->name, SymbolKind::Type, QualifiedValue(null, this.CompileType(type_definition->_type)), false, type_definition);
    }

    fn CompileDeclarationThirdPass(&mut this, declaration: *Node) -> bool {
        if declaration->_type == NodeType::STATIC {
            this.CompileStatic(declaration as *StaticNode);
        } else if declaration->_type == NodeType::FUNCTION {
            this.CompileFunction(declaration as *FunctionNode, null);
        } else if declaration->_type == NodeType::CLASS {
            let _class = declaration as *ClassNode;

            if !_class->generic && this.pass_cache.Has(declaration) {
                let cache = this.pass_cache[declaration];
                this.CompileClassThirdPass(cache.left, _class, cache.right);
            }
        } else if declaration->_type == NodeType::STRUCTURE {
            let _struct = declaration as *StructureNode;

            if !_struct->generic && this.pass_cache.Has(declaration) {
                let cache = this.pass_cache[declaration];
                this.CompileStructureThirdPass(cache.left, _struct, cache.right);
            }
        } else if declaration->_type == NodeType::ENUMERATION {
            let _enum = declaration as *EnumNode;

            if _enum->variant && !_enum->generic && this.pass_cache.Has(declaration) {
                let cache = this.pass_cache[declaration];
                this.CompileVariantThirdPass(cache.left, _enum, cache.right);
            }
        } else if declaration->_type == NodeType::EXTERN {
            this.CompileExtern(declaration as *ExternNode);
        } else if declaration->_type == NodeType::ASSEMBLY {
            this.CompileAssembly(declaration as *AssemblyNode);
        } else {
            return false;
        } return true;
    }

    fn CompileConstant(&mut this, constant: *ConstantNode) {
        let mut initializer: QualifiedValue;
        let mut _type = this.CompileType(constant->_type);
        let mut has_error = false;

        if constant->initializer->_type != NodeType::INITIALIZER_LIST {
            initializer = this.CompileExpression(constant->initializer).MaterializeWithFallback(_type).ToRValue();
            if initializer.Null() { has_error = true; }
        } else {
            let mut values = Vector<LLVMValueRef>();
            let initializer_list = constant->initializer as *InitializerListNode;

            if _type->IsPointer() {
                _type = this.type_manager.Array(_type->Pointee(), initializer_list->expressions.Size(), _type->IsMutable());
            }

            if _type->HasFields() {
                let mut index: usize = 0;

                for field in _type->Fields() {
                    if index < initializer_list->expressions.Size() {
                        let value = this.CompileExpression(initializer_list->expressions[index]).MaterializeWithFallback(field.right._type).ToRValue();

                        if !value.Null() {
                            values.PushBack(value.Value());
                        } else {
                            has_error = true;
                            break;
                        }
                    } else {
                        if field.right.initializer != null {
                            let value = this.CompileExpression(field.right.initializer).MaterializeWithFallback(field.right._type).ToRValue();

                            if !value.Null() {
                                values.PushBack(value.Value());
                            } else {
                                has_error = true;
                                break;
                            }
                        } else {
                            Logger::Log("Missing initializer for field '" + field.left + "'.", constant, LogSeverity::Error);
                            has_error = true;
                            break;
                        }
                    } index += 1;
                }

                if !has_error {
                    initializer = QualifiedValue(LLVMConstNamedStruct(_type->Value(), values.Data(), values.Size() as u32), _type);
                }
            } else if _type->IsArray() {
                if initializer_list->expressions.Size() != _type->Length() {
                    Logger::Log("Incompatible initializer list size. ('" + String::FromInteger(_type->Length() as u64) + "' != '" + String::FromInteger(initializer_list->expressions.Size() as u64) + "').", constant, LogSeverity::Error);
                    has_error = true;
                }

                if !has_error {
                    for expression in initializer_list->expressions {
                        let value = this.CompileExpression(expression).MaterializeWithFallback(_type->Element()).ToRValue();

                        if value.Null() {
                            has_error = true;
                            break;
                        }

                        if !_type->Element().IsCompatible(value.Type()) {
                            Logger::Log("Incompatible initializer list element types. ('" + value.Type().ToString() + "' != '" + _type->Element().ToString() + "').", constant, LogSeverity::Error);
                            has_error = true;
                            break;
                        }

                        if !_type->Element().IsMutabilityCompatible(value.Type()) {
                            Logger::Log("Cannot assign immutable pointer to mutable pointer.", constant, LogSeverity::Error);
                            has_error = true;
                            break;
                        }

                        values.PushBack(value.MakeCompatible(_type->Element()).Value());
                    }
                }

                if !has_error {
                    initializer = QualifiedValue(LLVMConstArray2(_type->Value(), values.Data(), values.Size() as u64), _type);
                }
            } else {
                Logger::Log("Invalid type '" + _type->ToString() + "' for initializer list.", constant, LogSeverity::Error);
                has_error = true;
            }
        }

        if has_error {
            this.scope_manager.Set(constant->name, SymbolKind::GlobalVariable, QualifiedValue(null, null), false, constant);
            return;
        }

        if !_type->IsCompatible(initializer.Type()) {
            Logger::Log("Incompatible constant initialization types. ('" + _type->ToString() + "' != '" + initializer.Type().ToString() + "').", constant, LogSeverity::Error);
            return;
        }

        if !_type->IsMutabilityCompatible(initializer.Type()) {
            Logger::Log("Cannot assign immutable pointer to mutable pointer.", constant, LogSeverity::Error);
            return;
        }

        let global = LLVMAddGlobal(this.module, _type->Value(), constant->name.Data());
        this.scope_manager.Set(constant->name, SymbolKind::GlobalVariable, QualifiedValue(global, this.type_manager.Pointer(_type, false), true), false, constant);
        LLVMSetLinkage(global, LLVMLinkage::LLVMPrivateLinkage);
        LLVMSetInitializer(global, initializer.MakeCompatible(_type).Value());
        LLVMSetGlobalConstant(global, 1);
    }

    fn CompileStatic(&mut this, _static: *StaticNode) {
        let mut initializer: QualifiedValue;
        let mut _type = this.CompileType(_static->_type);
        let mut has_error = false;

        if _static->initializer != null {
            if _static->initializer->_type != NodeType::INITIALIZER_LIST {
                initializer = this.CompileExpression(_static->initializer).MaterializeWithFallback(_type).ToRValue();
                if initializer.Null() { has_error = true; }
            } else {
                let mut values = Vector<LLVMValueRef>();
                let initializer_list = _static->initializer as *InitializerListNode;

                if _type->IsPointer() {
                    _type = this.type_manager.Array(_type->Pointee(), initializer_list->expressions.Size(), _type->IsMutable());
                }

                if _type->HasFields() {
                    let mut index: usize = 0;

                    for field in _type->Fields() {
                        if index < initializer_list->expressions.Size() {
                            let value = this.CompileExpression(initializer_list->expressions[index]).MaterializeWithFallback(field.right._type).ToRValue();

                            if !value.Null() {
                                values.PushBack(value.Value());
                            } else {
                                has_error = true;
                                break;
                            }
                        } else {
                            if field.right.initializer != null {
                                let value = this.CompileExpression(field.right.initializer).MaterializeWithFallback(field.right._type).ToRValue();

                                if !value.Null() {
                                    values.PushBack(value.Value());
                                } else {
                                    has_error = true;
                                    break;
                                }
                            } else {
                                Logger::Log("Missing initializer for field '" + field.left + "'.", _static, LogSeverity::Error);
                                has_error = true;
                                break;
                            }
                        } index += 1;
                    }

                    if !has_error {
                        initializer = QualifiedValue(LLVMConstNamedStruct(_type->Value(), values.Data(), values.Size() as u32), _type);
                    }
                } else if _type->IsArray() {
                    if initializer_list->expressions.Size() != _type->Length() {
                        Logger::Log("Incompatible initializer list size. ('" + String::FromInteger(_type->Length() as u64) + "' != '" + String::FromInteger(initializer_list->expressions.Size() as u64) + "').", _static, LogSeverity::Error);
                        has_error = true;
                    }

                    if !has_error {
                        for expression in initializer_list->expressions {
                            let value = this.CompileExpression(expression).MaterializeWithFallback(_type->Element()).ToRValue();

                            if value.Null() {
                                has_error = true;
                                break;
                            }

                            if !_type->Element().IsCompatible(value.Type()) {
                                Logger::Log("Incompatible initializer list element types. ('" + value.Type().ToString() + "' != '" + _type->Element().ToString() + "').", _static, LogSeverity::Error);
                                has_error = true;
                                break;
                            }

                            if !_type->Element().IsMutabilityCompatible(value.Type()) {
                                Logger::Log("Cannot assign immutable pointer to mutable pointer.", _static, LogSeverity::Error);
                                has_error = true;
                                break;
                            }

                            values.PushBack(value.MakeCompatible(_type->Element()).Value());
                        }
                    }

                    if !has_error {
                        initializer = QualifiedValue(LLVMConstArray2(_type->Value(), values.Data(), values.Size() as u64), _type);
                    }
                } else {
                    Logger::Log("Invalid type '" + _type->ToString() + "' for initializer list.", _static, LogSeverity::Error);
                    has_error = true;
                }
            }

            if !has_error {
                if _type->IsCompatible(initializer.Type()) {
                    if _type->IsMutabilityCompatible(initializer.Type()) {
                        initializer = initializer.MakeCompatible(_type);
                    } else {
                        Logger::Log("Cannot assign immutable pointer to mutable pointer.", _static, LogSeverity::Error);
                        has_error = true;
                    }
                } else {
                    Logger::Log("Incompatible static initialization types. ('" + _type->ToString() + "' != '" + initializer.Type().ToString() + "').", _static, LogSeverity::Error);
                    has_error = true;
                }
            }
        } else if _static->zero_initializer {
            initializer = QualifiedValue(LLVMConstNull(_type->Value()), _type);
        }

        if has_error {
            this.scope_manager.Set(_static->name, SymbolKind::Variable, QualifiedValue(null, null), false, _static);
            return;
        }

        let global = LLVMAddGlobal(this.module, _type->Value(), _static->name.Data());
        this.scope_manager.Set(_static->name, SymbolKind::Variable, QualifiedValue(global, this.type_manager.Pointer(_type, _static->mutable), true), false, _static);
        LLVMSetLinkage(global, this.mangling ? LLVMLinkage::LLVMInternalLinkage : LLVMLinkage::LLVMExternalLinkage);
        LLVMSetGlobalConstant(global, _static->mutable ? 0 : 1);

        if !initializer.Null() {
            LLVMSetInitializer(global, initializer.Value());
        }

        if _static->alignment != null {
            let alignment = this.CompileExpression(_static->alignment).MaterializeWithFallback(this.type_manager.IntegerPointer(false)).ToRValue();

            if alignment.Null() {
                return;
            }

            if !alignment.Type().IsIntegerPointer() || alignment.Type().IsSigned() {
                Logger::Log("Static alignment must be of type 'usize'.", _static, LogSeverity::Error);
                return;
            }

            LLVMSetAlignment(global, LLVMConstIntGetZExtValue(alignment.Value()) as u32);
        }
    }

    fn ProcessType(&mut this, _type: *QualifiedType) -> *QualifiedType {
        if !_type->HasFields() {
            return _type;
        } else {
            let size = LLVMABISizeOfType(this.target->layout, _type->Value());

            if size > 8 || !_type->IsTrivial() {
                return this.type_manager.Pointer(_type, _type->IsMutable());
            } else {
                if size > 4 {
                    return this.type_manager.Integer(64, true);
                } else if size > 2 {
                    return this.type_manager.Integer(32, true);
                } else if size > 1 {
                    return this.type_manager.Integer(16, true);
                } else {
                    return this.type_manager.Integer(8, true);
                }
            }
        }
    }

    fn AddAttributes(&mut this, function: LLVMValueRef) {
        if this.freestanding || true {
            let attribute = LLVMCreateStringAttribute(this.context, "no-stack-arg-probe", 18, "", 0);
            LLVMAddAttributeAtIndex(function, LLVMAttributeIndex::LLVMAttributeFunctionIndex, attribute);
        }

        if this.no_red_zone {
            let noredzone_kind = LLVMGetEnumAttributeKindForName("noredzone", 9);
            LLVMAddAttributeAtIndex(function, LLVMAttributeIndex::LLVMAttributeFunctionIndex, LLVMCreateEnumAttribute(this.context, noredzone_kind, 0));
        }

        /* let align_attr = LLVMCreateStringAttribute(this.context, "align-stack", 11, "16", 2);
        LLVMAddAttributeAtIndex(function, LLVMAttributeIndex::LLVMAttributeFunctionIndex, align_attr); */

        if !this.target->features.Empty() {
            let attribute = LLVMCreateStringAttribute(this.context, "target-features", 15, this.target->features.Data(), this.target->features.Length() as u32);
            LLVMAddAttributeAtIndex(function, LLVMAttributeIndex::LLVMAttributeFunctionIndex, attribute);
        }
    }

    pub fn CompileFunction(&mut this, function: *FunctionNode, generic: *mut Generic) -> QualifiedValue {
        if function->generic && generic == null && !this.pack_specializing {
            let _generic = new Generic(function);
            this.scope_manager.Set(function->name, SymbolKind::Generic, _generic, false, function);
            return QualifiedValue(null, null);
        }

        let mut return_type = ReturnType(this.CompileType(function->_type->return_type));

        if return_type._type == null {
            return QualifiedValue(null, null);
        }

        let mut params = Vector<ParameterType>();
        let mut param_types = Vector<LLVMTypeRef>();
        let mut attributes = Vector<LLVMTypeRef>();
        let mut sret = false;

        if return_type._type->HasFields() {
            let processed_type = this.ProcessType(return_type._type);

            if !processed_type->IsPointer() {
                (return_type.sret, return_type._type) = (return_type._type, processed_type);
            } else {
                let mut param_type = ParameterType(processed_type);
                (param_type.sret, sret) = (return_type._type, true);
                return_type._type = this.type_manager.Void();
                attributes.PushBack(return_type._type->Value());
                param_types.PushBack(processed_type->Value());
                params.PushBack(param_type);
            }
        }

        let mut instance_type: *QualifiedType = null;

        if function->_type->instance_kind != InstanceKind::None {
            if this._class == null {
                Logger::Log("Instance parameters are only allowed in class and enum methods.", function, LogSeverity::Error);
                return QualifiedValue(null, null);
            }

            if function->_type->instance_kind == InstanceKind::ConstRef || function->_type->instance_kind == InstanceKind::MutRef {
                instance_type = this.type_manager.Reference(this._class, function->_type->instance_kind == InstanceKind::MutRef);
            } else if function->_type->instance_kind == InstanceKind::Copy {
                instance_type = this._class;
            }
        }

        let mut i: usize = 0;

        while instance_type != null || i < function->_type->parameters.Size() {
            let mut real_type: *QualifiedType;

            if instance_type != null {
                (real_type, instance_type) = (instance_type, null);
            } else {
                real_type = this.CompileType(function->_type->parameters[i]->_type);
                i += 1;
            }

            let mut param_type = ParameterType(this.ProcessType(real_type));

            if *real_type != *param_type._type {
                attributes.PushBack(param_type._type->IsPointer() && !this.mangling ? real_type->Value() : null);
                param_type.byval = real_type;
            } else {
                attributes.PushBack(null);
            }

            param_types.PushBack(param_type._type->Value());
            params.PushBack(param_type);
        }

        if function->_type->pack_name != "" && this.pack_specializing {
            for real_type in this.pack_types {
                let mut param_type = ParameterType(this.ProcessType(real_type));

                if *real_type != *param_type._type {
                    attributes.PushBack(param_type._type->IsPointer() && !this.mangling ? real_type->Value() : null);
                    param_type.byval = real_type;
                } else {
                    attributes.PushBack(null);
                }

                param_types.PushBack(param_type._type->Value());
                params.PushBack(param_type);
            }
        }

        let mut name = function->name;
        let type_ref = LLVMFunctionType(return_type._type->Value(), param_types.Data(), param_types.Size() as u32, function->_type->var_arg ? 1 : 0);
        let mut _type: *mut QualifiedType;

        if this.pack_specializing {
            _type = this.type_manager.PackSpecializedFunction(type_ref, params, return_type, function, this.scope_manager.current);
        } else {
            _type = this.type_manager.Function(type_ref, params, return_type, function, this.scope_manager.current);
        }

        if this.generic != null {
            (_type->pack_generic, _type->pack_generic_types) = (this.generic, this.generic->types);
        }

        if function->no_mangle {
            if !this.mangling {
                Logger::Log("Mangling was already disabled.", function, LogSeverity::Error);
            }
        } else if this.mangling {
            let mut types = Vector<*QualifiedType>();
            if generic != null { types += generic->types; }
            name = Mangler::MangleFunction(function->name, _type, types);
        }

        let value_ref = LLVMAddFunction(this.module, name.Data(), _type->Value());
        let value = QualifiedValue(value_ref, this.type_manager.Pointer(_type, false));

        if this.mangling {
            LLVMSetFunctionCallConv(value_ref, LLVMCallConv::LLVMFastCallConv as u32);
        } else {
            LLVMSetFunctionCallConv(value_ref, LLVMCallConv::LLVMCCallConv as u32);
        }

        this.AddAttributes(value_ref);

        if generic != null {
            generic->Set(value);
        } else {
            this.scope_manager.Set(function->name, SymbolKind::Function, value, this.mangling && !function->no_mangle, function);
        }

        for j in 0..attributes.Size() {
            if attributes[j] != null {
                let attribute_kind = sret && j == 0 ? LLVMGetEnumAttributeKindForName("sret", 4) : LLVMGetEnumAttributeKindForName("byval", 5);
                LLVMAddAttributeAtIndex(value_ref, (j + 1) as LLVMAttributeIndex, LLVMCreateTypeAttribute(this.context, attribute_kind, attributes[j]));
            }
        }

        if this._class == null && !function->constructors.Empty() {
            Logger::Log("Constructors can only be declared inside classes.", function, LogSeverity::Error);
            return value;
        }

        for constructor in function->constructors {
            unsafe {
                let _class = this.CompileType(constructor->expression) as *mut QualifiedType;
            }

            if _class == null {
                return value;
            }

            if !_class->IsClass() {
                Logger::Log("Constructor type must be a class.", function, LogSeverity::Error);
                return value;
            }

            _class->constructed.PushBack(this._class);
        }

        if function->body != null && (function->_type->pack_name == "" || this.pack_specializing) {
            if this.generic != null {
                this.forwards.PushBack(Forward(function, _type, value_ref, this._class, this.generic->types, this.generic));
            } else {
                this.forwards.PushBack(Forward(function, _type, value_ref, this._class));
            } this.forwards[this.forwards.Size() - 1].pack_types = this.pack_types;
        } return value;
    }

    fn ValueToType(&mut this, values: &Vector<QualifiedValue>) -> Vector<*QualifiedType> {
        let mut result = Vector<*QualifiedType>();

        for value in values {
            result.PushBack(value.ToRValueType());
        } return result;
    }

    fn CompileArgument(&mut this, argument: *Node, values: &mut Vector<QualifiedValue>) -> bool {
        if argument->_type == NodeType::PACK_SPLAT {
            let splat = argument as *PackSplatNode;

            if splat->expression->_type != NodeType::IDENTIFIER {
                Logger::Log("Pack splat expression must be a pack name.", argument, LogSeverity::Error);
                return false;
            }

            let identifier = splat->expression as *IdentifierNode;

            if identifier->name != this.current_pack_name {
                Logger::Log("Pack '" + identifier->name + "' not found.", argument, LogSeverity::Error);
                return false;
            }

            for value in this.current_pack_values {
                if value.Type().IsPointer() {
                    value = QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
                } values.PushBack(value);
            } return true;
        } else {
            let value = this.CompileExpression(argument);

            if !value.Null() {
                values.PushBack(value);
                return true;
            } return false;
        }
    }

    fn CompileConstructor(&mut this, _class: &QualifiedType, pointer: QualifiedValue, params: &Vector<QualifiedValue>, node: *Node) {
        let mut need_copy = false;

        if params.Size() == 1 {
            let param_type = params[0].Type();

            if param_type.IsPointer() {
                need_copy = param_type.Pointee() == _class;
            }
        }

        let param_types = this.ValueToType(params);
        let has_constructor = _class.Has(_class.name, param_types);
        let mut is_constructed = false;

        if this._class != null {
            for constructed in _class.constructed {
                if *this._class == constructed {
                    is_constructed = true;
                    break;
                }
            }
        }

        let mut j: usize = 0;

        for field in _class.Fields() {
            let mut value: QualifiedValue;

            if !(has_constructor && !is_constructed) && j < params.Size() {
                value = params[j];
            } else {
                if field.right.initializer != null {
                    if field.right.initializer->_type != NodeType::INITIALIZER_LIST {
                        value = this.CompileExpression(field.right.initializer);
                        if value.Null() { return; }
                    }
                }
            }

            if need_copy && !(has_constructor && !is_constructed) {
                value = QualifiedValue(LLVMBuildStructGEP2(this.builder, params[0].Type().Pointee().Value(), params[0].Value(), _class.Index(field.left) as u32, ""), this.type_manager.Pointer(field.right._type, true), true);
            }

            if field.right._type->HasFields() {
                let mut _params = Vector<QualifiedValue>();
                if !value.Null() { _params.PushBack(value); }
                this.CompileConstructor(field.right._type, QualifiedValue(LLVMBuildStructGEP2(this.builder, pointer.Type().Pointee().Value(), pointer.Value(), _class.Index(field.left) as u32, ""), this.type_manager.Pointer(field.right._type, true), true), _params, node);
            } else if !value.Null() {
                if value.Type().IsPointer() {
                    let pointee = value.Type().Pointee();

                    if pointee == *field.right._type {
                        value = QualifiedValue(LLVMBuildLoad2(this.builder, pointee.Value(), value.Value(), ""), pointee);
                    }
                }

                this.CompileResolvedAssignment(value, QualifiedValue(LLVMBuildStructGEP2(this.builder, pointer.Type().Pointee().Value(), pointer.Value(), _class.Index(field.left) as u32, ""), this.type_manager.Pointer(field.right._type, true), true), TokenType::ASSIGN, true, node);
            } j += 1;
        }

        if has_constructor && !is_constructed {
            let method = _class.Get(_class.name, param_types, node);
            this.CompileResolvedCall(QualifiedValue(method->left.value, method->right, pointer), params, true, node);
        } else {
            if params.Size() > _class.Fields().Size() {
                Logger::Log("Too many parameters.", node, LogSeverity::Error);
            }
        }
    }

    pub fn CompileDestructor(&mut this, _class: &QualifiedType, pointer: QualifiedValue, node: *Node) {
        let mut params_types = Vector<*QualifiedType>();
        let mut params = Vector<QualifiedValue>();

        if _class.Has("~" + _class.name, params_types) {
            let method = _class.Get("~" + _class.name, params_types, node);
            this.CompileResolvedCall(QualifiedValue(method->left.value, method->right, pointer), params, true, node);
        }

        for field in _class.Fields() {
            if field.right._type->HasFields() {
                this.CompileDestructor(field.right._type, QualifiedValue(LLVMBuildStructGEP2(this.builder, pointer.Type().Pointee().Value(), pointer.Value(), _class.Index(field.left) as u32, ""), this.type_manager.Pointer(field.right._type, true)), node);
            }
        }
    }

    fn CompileClassFirstPass(&mut this, _class: *ClassNode, generic: *mut Generic) -> Pair<*mut QualifiedType, *mut Scope> {
        if _class->generic && generic == null {
            let _generic = new Generic(_class);
            this.scope_manager.Set(_class->name, SymbolKind::Generic, _generic, false, _class);
            return Pair<*mut QualifiedType, *mut Scope>(null, null);
        }

        let struct_name = generic != null ? generic->current.Data() : _class->name.Data();
        let _type = this.type_manager.Class(LLVMStructCreateNamed(this.context, struct_name), _class->name);

        if generic != null {
            this.scope_manager.PushScope(generic->current, true);
            generic->Set(QualifiedValue(null, _type));
        } else {
            this.scope_manager.Set(_class->name, SymbolKind::Class, QualifiedValue(null, _type), false, _class);
            this.scope_manager.PushScope(_class->name, true);
        }

        _type->pack_scope = this.scope_manager.current;
        this.scope_manager.PopScope();
        return Pair<*mut QualifiedType, *mut Scope>(_type, _type->pack_scope);
    }

    fn CompileClassSecondPass(&mut this, _type: *mut QualifiedType, _class: *ClassNode, scope: *mut Scope) {
        let (prev_class, prev_scope) = (this._class, this.scope_manager.current);
        (this._class, this.scope_manager.current) = (_type, scope);
        let mut field_types = Vector<LLVMTypeRef>();

        for parent in _class->parents {
            let parent_type = this.CompileType(parent);
            if parent_type == null { continue; }
            _type->fields[parent_type->name] = Field(parent_type, null, false, field_types.Size());
            field_types.PushBack(parent_type->Value());
        }

        for field in _class->fields {
            let field_type = this.CompileType(field.right->_type);
            if field_type == null { continue; }
            _type->fields[field.right->name] = Field(field_type, field.right->initializer, field.left, field_types.Size());
            field_types.PushBack(field_type->Value());
        }

        if !field_types.Empty() {
            LLVMStructSetBody(_type->Value(), field_types.Data(), field_types.Size() as u32, 0);
        }

        (this._class, this.scope_manager.current) = (prev_class, prev_scope);
    }

    fn CompileClassThirdPass(&mut this, _type: *mut QualifiedType, _class: *ClassNode, scope: *mut Scope) {
        let (prev_class, prev_scope) = (this._class, this.scope_manager.current);
        (this._class, this.scope_manager.current) = (_type, scope);

        for constructor in _class->constructors {
            let function = this.CompileFunction(constructor, null);
            _type->methods.PushBack(Pair<Method, *QualifiedType>(Method(constructor->name, function.Value(), true), function.Type()));
        }

        if _class->destructor != null {
            let function = this.CompileFunction(_class->destructor, null);
            _type->methods.PushBack(Pair<Method, *QualifiedType>(Method(_class->destructor->name, function.Value(), true), function.Type()));
        }

        for method in _class->methods {
            let function = this.CompileFunction(method.right, null);

            if !method.right->generic {
                _type->methods.PushBack(Pair<Method, *QualifiedType>(Method(method.right->name, function.Value(), method.left), function.Type()));
            }
        }

        (this._class, this.scope_manager.current) = (prev_class, prev_scope);
    }

    pub fn CompileClass(&mut this, _class: *ClassNode, generic: *mut Generic) -> *QualifiedType {
        let cache = this.CompileClassFirstPass(_class, generic);

        if cache.left != null {
            this.CompileClassSecondPass(cache.left, _class, cache.right);
            this.CompileClassThirdPass(cache.left, _class, cache.right);
        } return cache.left;
    }

    fn CompileStructureFirstPass(&mut this, _struct: *StructureNode, generic: *mut Generic) -> Pair<*mut QualifiedType, *mut Scope> {
        if _struct->generic && generic == null {
            let _generic = new Generic(_struct);
            this.scope_manager.Set(_struct->name, SymbolKind::Generic, _generic, false, _struct);
            return Pair<*mut QualifiedType, *mut Scope>(null, null);
        }

        let struct_name = generic != null ? generic->current.Data() : _struct->name.Data();
        let _type = this.type_manager.Structure(LLVMStructCreateNamed(this.context, struct_name), _struct->name);

        if generic != null {
            this.scope_manager.PushScope(generic->current, true);
            generic->Set(QualifiedValue(null, _type));
        } else {
            this.scope_manager.Set(_struct->name, SymbolKind::Class, QualifiedValue(null, _type), false, _struct);
            this.scope_manager.PushScope(_struct->name, true);
        }

        _type->pack_scope = this.scope_manager.current;
        this.scope_manager.PopScope();
        return Pair<*mut QualifiedType, *mut Scope>(_type, _type->pack_scope);
    }

    fn CompileStructureSecondPass(&mut this, _type: *mut QualifiedType, _struct: *StructureNode, scope: *mut Scope) {
        let (prev_class, prev_scope) = (this._class, this.scope_manager.current);
        (this._class, this.scope_manager.current) = (_type, scope);
        let mut field_types = Vector<LLVMTypeRef>();

        for field in _struct->fields {
            let field_type = this.CompileType(field.right->_type);
            if field_type == null { continue; }
            _type->fields[field.right->name] = Field(field_type, field.right->initializer, field.left, field_types.Size());
            field_types.PushBack(field_type->Value());
        }

        if !field_types.Empty() {
            LLVMStructSetBody(_type->Value(), field_types.Data(), field_types.Size() as u32, 0);
        }

        (this._class, this.scope_manager.current) = (prev_class, prev_scope);
    }

    fn CompileStructureThirdPass(&mut this, _type: *mut QualifiedType, _struct: *StructureNode, scope: *mut Scope) {
        let (prev_class, prev_scope) = (this._class, this.scope_manager.current);
        (this._class, this.scope_manager.current) = (_type, scope);

        for method in _struct->methods {
            let function = this.CompileFunction(method.right, null);

            if !method.right->generic {
                _type->methods.PushBack(Pair<Method, *QualifiedType>(Method(method.right->name, function.Value(), method.left), function.Type()));
            }
        }

        (this._class, this.scope_manager.current) = (prev_class, prev_scope);
    }

    pub fn CompileStructure(&mut this, _struct: *StructureNode, generic: *mut Generic) -> *QualifiedType {
        let cache = this.CompileStructureFirstPass(_struct, generic);

        if cache.left != null {
            this.CompileStructureSecondPass(cache.left, _struct, cache.right);
            this.CompileStructureThirdPass(cache.left, _struct, cache.right);
        } return cache.left;
    }

    fn CompileEnumerationFirstPass(&mut this, _enum: *EnumNode) -> *QualifiedType {
        let underlying_type = this.CompileType(_enum->underlying_type);

        if underlying_type == null {
            return null;
        }

        if !underlying_type->IsInteger() {
            Logger::Log("Expected an integer type.", _enum, LogSeverity::Error);
            return null;
        }

        let _type = this.type_manager.Enumeration(underlying_type, _enum->name);
        this.scope_manager.Set(_enum->name, SymbolKind::Type, QualifiedValue(null, _type), false, _enum);
        return _type;
    }

    fn CompileEnumerationSecondPass(&mut this, _enum: *EnumNode, _type: *QualifiedType) {
        this.scope_manager.PushScope(_enum->name, true);
        let mut value = LLVMConstInt(_type->Value(), 0, _type->IsSigned() ? 1 : 0);
        let underlying_type = _type->UnderlyingType();
        let mut has_error = false;

        for variant in _enum->variants {
            if variant->value != null {
                let _value = this.CompileExpression(variant->value).MaterializeWithFallback(underlying_type).ToRValue();

                if !_value.Null() {
                    if _value.Type() == *_type || _value.Type() == underlying_type {
                        value = _value.Value();
                    } else {
                        Logger::Log("Incompatible enum value types. ('" + _value.Type().ToString() + "' != '" + underlying_type.ToString() + "').", _enum, LogSeverity::Error);
                        has_error = true;
                    }
                } else {
                    has_error = true;
                }
            }

            if !has_error {
                this.scope_manager.Set(variant->name, SymbolKind::Constant, QualifiedValue(value, _type), false, _enum);
                value = LLVMConstAdd(value, LLVMConstInt(_type->Value(), 1, _type->IsSigned() ? 1 : 0));
            } else {
                this.scope_manager.Set(variant->name, SymbolKind::Constant, QualifiedValue(null, null), false, _enum);
            }
        }

        this.scope_manager.PopScope();
    }

    fn CompileVariantFirstPass(&mut this, _enum: *EnumNode, generic: *mut Generic) -> Pair<*mut QualifiedType, *mut Scope> {
        if _enum->generic && generic == null {
            let _generic = new Generic(_enum);
            this.scope_manager.Set(_enum->name, SymbolKind::Generic, _generic, false, _enum);
            return Pair<*mut QualifiedType, *mut Scope>(null, null);
        }

        let struct_name = generic != null ? generic->current.Data() : _enum->name.Data();
        let _type = this.type_manager.Variant(LLVMStructCreateNamed(this.context, struct_name), _enum->name);

        if generic != null {
            this.scope_manager.PushScope(generic->current, true);
            generic->Set(QualifiedValue(null, _type));
        } else {
            this.scope_manager.Set(_enum->name, SymbolKind::Class, QualifiedValue(null, _type), false, _enum);
            this.scope_manager.PushScope(_enum->name, true);
        }

        _type->pack_scope = this.scope_manager.current;
        this.scope_manager.PopScope();
        return Pair<*mut QualifiedType, *mut Scope>(_type, _type->pack_scope);
    }

    fn CompileVariantSecondPass(&mut this, _type: *mut QualifiedType, _enum: *EnumNode, scope: *mut Scope) {
        let (prev_class, prev_scope) = (this._class, this.scope_manager.current);
        (this._class, this.scope_manager.current) = (_type, scope);
        let mut max_size: u64 = 0;

        for variant in _enum->variants {
            let mut types = Vector<*QualifiedType>();

            for _type in variant->types {
                types.PushBack(this.CompileType(_type));
            }

            _type->variants.PushBack(Pair<String, Vector<*QualifiedType>>(variant->name, types));
            this.scope_manager.Set(variant->name, SymbolKind::Variant, QualifiedValue(LLVMConstInt(LLVMInt32TypeInContext(this.context), _type->variants.Size() as u64 - 1, 0), _type), false, variant);
            let current_size = LLVMABISizeOfType(this.target->layout, this.CreateVariantPayloadType(types));

            if current_size > max_size {
                max_size = current_size;
            }
        }

        let tag_type = LLVMInt32TypeInContext(this.context);
        let data_type = LLVMArrayType(LLVMInt8TypeInContext(this.context), max_size as u32);
        let elements[]: LLVMTypeRef = { tag_type, data_type };
        LLVMStructSetBody(_type->Value(), elements, 2, 0);

        for variant in _enum->variants {
            _type->variant_field_names.PushBack(variant->field_names);
        }

        (this._class, this.scope_manager.current) = (prev_class, prev_scope);
    }

    fn CompileVariantThirdPass(&mut this, _type: *mut QualifiedType, _enum: *EnumNode, scope: *mut Scope) {
        let (prev_class, prev_scope) = (this._class, this.scope_manager.current);
        (this._class, this.scope_manager.current) = (_type, scope);

        for method in _enum->methods {
            let function = this.CompileFunction(method.right, null);

            if !method.right->generic {
                _type->methods.PushBack(Pair<Method, *QualifiedType>(Method(method.right->name, function.Value(), method.left), function.Type()));
            }
        }

        (this._class, this.scope_manager.current) = (prev_class, prev_scope);
    }

    pub fn CompileVariant(&mut this, _enum: *EnumNode, generic: *mut Generic) -> *QualifiedType {
        let cache = this.CompileVariantFirstPass(_enum, generic);

        if cache.left != null {
            this.CompileVariantSecondPass(cache.left, _enum, cache.right);
            this.CompileVariantThirdPass(cache.left, _enum, cache.right);
        } return cache.left;
    }

    fn CreateVariantPayloadType(&mut this, types: &Vector<*QualifiedType>) -> LLVMTypeRef {
        if types.Empty() {
            return LLVMStructTypeInContext(this.context, null, 0, 0);
        }

        let mut elements = Vector<LLVMTypeRef>();

        for _type in types {
            elements.PushBack(_type->Value());
        }

        return LLVMStructTypeInContext(this.context, elements.Data(), elements.Size() as u32, 0);
    }

    fn VariantIndex(&this, _type: *QualifiedType, name: &String) -> isize {
        let mut index: usize = 0;

        for variant in _type->variants {
            if variant.left == name {
                return index as isize;
            } index += 1;
        } return -1;
    }

    fn VariantFieldIndex(&this, _type: *QualifiedType, variant_index: usize, name: &String) -> isize {
        let mut index: usize = 0;

        for field_name in _type->variant_field_names[variant_index] {
            if field_name == name {
                return index as isize;
            } index += 1;
        } return -1;
    }

    fn PatternIsWildcard(&this, pattern: *Node) -> bool {
        if pattern->_type != NodeType::IDENTIFIER { return false; }
        return (pattern as *IdentifierNode)->name == "_";
    }

    fn BuildPayloadFieldPointer(&mut this, pointer: LLVMValueRef, _type: *QualifiedType, variant_index: usize, field_index: usize) -> LLVMValueRef {
        let mut payload_pointer = LLVMBuildStructGEP2(this.builder, _type->Value(), pointer, 1, "");
        let payload_type = this.CreateVariantPayloadType(_type->variants[variant_index].right);
        payload_pointer = LLVMBuildBitCast(this.builder, payload_pointer, LLVMPointerType(payload_type, 0), "");
        return LLVMBuildStructGEP2(this.builder, payload_type, payload_pointer, field_index as u32, "");
    }

    fn BuildPatternCondition(&mut this, pattern: *Node, pointer: LLVMValueRef, _type: *QualifiedType) -> LLVMValueRef {
        if this.PatternIsWildcard(pattern) {
            return LLVMConstInt(LLVMInt1TypeInContext(this.context), 1, 0);
        }

        if pattern->_type == NodeType::OR_PATTERN {
            let or_pattern = pattern as *OrPatternNode;
            let left = this.BuildPatternCondition(or_pattern->left, pointer, _type);
            let right = this.BuildPatternCondition(or_pattern->right, pointer, _type);
            return LLVMBuildOr(this.builder, left, right, "");
        }

        if _type->IsVariant() {
            let mut variant_name: String;
            let mut is_struct_pattern = false;
            let mut struct_field_names = Vector<String>();
            let mut arguments = Vector<*Node>();

            if pattern->_type == NodeType::CALL {
                let call = pattern as *CallNode;
                arguments = call->arguments;

                if call->expression->_type == NodeType::IDENTIFIER {
                    variant_name = (call->expression as *IdentifierNode)->name;
                } else if call->expression->_type == NodeType::SCOPE_RESOLUTION {
                    variant_name = (call->expression as *ScopeResolutionNode)->identifier->name;
                } else {
                    Logger::Log("Invalid enum pattern.", pattern, LogSeverity::Error);
                    return null;
                }
            } else if pattern->_type == NodeType::STRUCT_INIT {
                let struct_init = pattern as *StructInitNode;
                is_struct_pattern = true;
                struct_field_names = struct_init->field_names;
                arguments = struct_init->field_values;

                if struct_init->expression->_type == NodeType::IDENTIFIER {
                    variant_name = (struct_init->expression as *IdentifierNode)->name;
                } else if struct_init->expression->_type == NodeType::SCOPE_RESOLUTION {
                    variant_name = (struct_init->expression as *ScopeResolutionNode)->identifier->name;
                } else {
                    Logger::Log("Invalid enum struct pattern.", pattern, LogSeverity::Error);
                    return null;
                }
            } else if pattern->_type == NodeType::IDENTIFIER {
                variant_name = (pattern as *IdentifierNode)->name;
            } else if pattern->_type == NodeType::SCOPE_RESOLUTION {
                variant_name = (pattern as *ScopeResolutionNode)->identifier->name;
            } else {
                Logger::Log("Invalid enum pattern.", pattern, LogSeverity::Error);
                return null;
            }

            let variant_index = this.VariantIndex(_type, variant_name);

            if variant_index == -1 {
                Logger::Log("Unknown enum variant '" + variant_name + "'.", pattern, LogSeverity::Error);
                return null;
            }

            let variant_types = _type->variants[variant_index as usize].right;

            if !is_struct_pattern && arguments.Size() != variant_types.Size() {
                Logger::Log("Pattern argument count does not match enum variant.", pattern, LogSeverity::Error);
                return null;
            }

            let tag_pointer = LLVMBuildStructGEP2(this.builder, _type->Value(), pointer, 0, "");
            let tag = LLVMBuildLoad2(this.builder, LLVMInt32TypeInContext(this.context), tag_pointer, "");
            let mut result = LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntEQ, tag, LLVMConstInt(LLVMInt32TypeInContext(this.context), variant_index as u64, 0), "");
            let mut index: usize = 0;

            for argument in arguments {
                let mut field_index = index;

                if is_struct_pattern {
                    let new_field_index = this.VariantFieldIndex(_type, variant_index as usize, struct_field_names[index]);

                    if new_field_index != -1 {
                        field_index = new_field_index as usize;
                    } else {
                        Logger::Log("Unknown field '" + struct_field_names[index] + "' in pattern for variant '" + variant_name + "'.", pattern, LogSeverity::Error);
                        return null;
                    }
                }

                let field_pointer = this.BuildPayloadFieldPointer(pointer, _type, variant_index as usize, field_index);
                let field_result = this.BuildPatternCondition(argument, field_pointer, variant_types[field_index]);
                result = LLVMBuildAnd(this.builder, result, field_result, "");
                index += 1;
            } return result;
        }

        if pattern->_type == NodeType::IDENTIFIER {
            return LLVMConstInt(LLVMInt1TypeInContext(this.context), 1, 0);
        }

        let value = QualifiedValue(pointer, this.type_manager.Pointer(_type, false));

        if pattern->_type == NodeType::SCOPE_RESOLUTION {
            let constant = this.CompileExpression(pattern).MaterializeWithFallback(_type);

            if !constant.Null() {
                return this.CompileResolvedBinary(value, constant, TokenType::EQUAL, pattern).ToRValue().Value();
            } else {
                return null;
            }
        }

        if pattern->_type == NodeType::LITERAL {
            let constant = this.CompileExpression(pattern);

            if !constant.Null() {
                return this.CompileResolvedBinary(value, constant, TokenType::EQUAL, pattern).ToRValue().Value();
            } else {
                return null;
            }
        }

        Logger::Log("Invalid match pattern.", pattern, LogSeverity::Error);
        return null;
    }

    fn BindPattern(&mut this, pattern: *Node, pointer: LLVMValueRef, _type: *QualifiedType) {
        if this.PatternIsWildcard(pattern) {
            return;
        }

        if pattern->_type == NodeType::OR_PATTERN {
            this.BindPattern((pattern as *OrPatternNode)->left, pointer, _type);
            return;
        }

        if _type->IsVariant() {
            if pattern->_type == NodeType::CALL {
                let call = pattern as *CallNode;
                let mut variant_name: String;

                if call->expression->_type == NodeType::IDENTIFIER {
                    variant_name = (call->expression as *IdentifierNode)->name;
                } else {
                    variant_name = (call->expression as *ScopeResolutionNode)->identifier->name;
                }

                let variant_index = this.VariantIndex(_type, variant_name);
                let mut index: usize = 0;

                for variant_type in _type->variants[variant_index as usize].right {
                    let field_pointer = this.BuildPayloadFieldPointer(pointer, _type, variant_index as usize, index);
                    this.BindPattern(call->arguments[index], field_pointer, variant_type);
                    index += 1;
                } return;
            }

            if pattern->_type == NodeType::STRUCT_INIT {
                let struct_init = pattern as *StructInitNode;
                let mut variant_name: String;

                if struct_init->expression->_type == NodeType::IDENTIFIER {
                    variant_name = (struct_init->expression as *IdentifierNode)->name;
                } else {
                    variant_name = (struct_init->expression as *ScopeResolutionNode)->identifier->name;
                }

                let variant_index = this.VariantIndex(_type, &variant_name);
                let mut index: usize = 0;

                for field_name in struct_init->field_names {
                    let field_index = this.VariantFieldIndex(_type, variant_index as usize, field_name);

                    if field_index == -1 {
                        Logger::Log("Unknown field '" + field_name + "' in pattern.", pattern, LogSeverity::Error);
                        return;
                    }

                    let field_pointer = this.BuildPayloadFieldPointer(pointer, _type, variant_index as usize, field_index as usize);
                    this.BindPattern(struct_init->field_values[index], field_pointer, _type->variants[variant_index as usize].right[field_index as usize]);
                    index += 1;
                } return;
            }

            if pattern->_type == NodeType::IDENTIFIER {
                let identifier = pattern as *IdentifierNode;
                if this.VariantIndex(_type, &identifier->name) != -1 { return; }
            } else if pattern->_type == NodeType::SCOPE_RESOLUTION {
                return;
            }
        }

        if pattern->_type == NodeType::IDENTIFIER {
            let value = QualifiedValue(pointer, this.type_manager.Pointer(_type, false), true);
            this.scope_manager.Set((pattern as *IdentifierNode)->name, SymbolKind::Variable, value, false, pattern);
        }
    }

    fn CompileMatch(&mut this, _match: *MatchNode) {
        let mut expression = this.CompileExpression(_match->expression).Materialize().ToRValue();
        if expression.Null() { return; }

        let function = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
        let end_block = LLVMAppendBasicBlockInContext(this.context, function, "");
        let mut default_block = end_block;
        let mut any_arm_branches_to_end = false;

        if _match->default != null {
            default_block = LLVMAppendBasicBlockInContext(this.context, function, "");
        }

        let mut match_pointer = null;

        if expression.Type().IsReference() {
            if expression.Type().Pointee().IsVariant() {
                match_pointer = expression.Value();
                expression = QualifiedValue(LLVMBuildLoad2(this.builder, expression.Type().Pointee().Value(), expression.Value(), ""), expression.Type().Pointee());
            } else {
                expression = QualifiedValue(LLVMBuildLoad2(this.builder, expression.Type().Pointee().Value(), expression.Value(), ""), expression.Type().Pointee());
            }
        }

        if match_pointer == null && expression.Type().IsVariant() {
            match_pointer = LLVMBuildAlloca(this.builder, expression.Type().Value(), "");
            LLVMBuildStore(this.builder, expression.Value(), match_pointer);
        }

        let mut current_block = LLVMGetInsertBlock(this.builder);
        let mut index: usize = 0;

        for case in _match->cases {
            let body_block = LLVMAppendBasicBlockInContext(this.context, function, "");
            let mut next_block = default_block;

            if index + 1 < _match->cases.Size() {
                next_block = LLVMAppendBasicBlockInContext(this.context, function, "");
            }

            LLVMPositionBuilderAtEnd(this.builder, current_block);
            let mut condition: LLVMValueRef = null;

            if expression.Type().IsVariant() {
                condition = this.BuildPatternCondition(case->pattern, match_pointer, expression.Type());
            } else {
                let value = this.CompileExpression(case->pattern).MaterializeWithFallback(expression.Type());

                if !value.Null() {
                    condition = this.CompileResolvedBinary(expression, value, TokenType::EQUAL, case->pattern).ToRValue().Value();
                } else {
                    return;
                }
            }

            if case->guard != null {
                let guard_block = LLVMAppendBasicBlockInContext(this.context, function, "");
                let guard_fail = LLVMAppendBasicBlockInContext(this.context, function, "");
                LLVMBuildCondBr(this.builder, condition, guard_block, next_block);

                LLVMPositionBuilderAtEnd(this.builder, guard_block);
                this.scope_manager.PushScope(String("guard"), false);
                if expression.Type().IsVariant() { this.BindPattern(case->pattern, match_pointer, expression.Type()); }
                let guard_cond = this.CompileExpression(case->guard).Materialize().ToRValue().Value();
                if guard_cond == null { return; }
                LLVMBuildCondBr(this.builder, guard_cond, body_block, guard_fail);

                LLVMPositionBuilderAtEnd(this.builder, guard_fail);
                this.scope_manager.PopScope();
                LLVMBuildBr(this.builder, next_block);

                LLVMPositionBuilderAtEnd(this.builder, body_block);
                this.scope_manager.PushScope(String("case"), false);
                if expression.Type().IsVariant() { this.BindPattern(case->pattern, match_pointer, expression.Type()); }
            } else {
                LLVMBuildCondBr(this.builder, condition, body_block, next_block);

                LLVMPositionBuilderAtEnd(this.builder, body_block);
                this.scope_manager.PushScope(String("case"), false);
                if expression.Type().IsVariant() { this.BindPattern(case->pattern, match_pointer, expression.Type()); }
            }

            this.CompileStatement(case->body);
            this.scope_manager.PopScope();

            if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
                if LLVMGetFirstUse(LLVMBasicBlockAsValue(LLVMGetInsertBlock(this.builder))) == null {
                    LLVMBuildUnreachable(this.builder);
                } else {
                    LLVMBuildBr(this.builder, end_block);
                    any_arm_branches_to_end = true;
                }
            }

            current_block = next_block;
            index += 1;
        }

        if _match->default != null {
            LLVMPositionBuilderAtEnd(this.builder, default_block);
            this.scope_manager.PushScope(String("default"), false);
            this.CompileStatement(_match->default->body);
            this.scope_manager.PopScope();

            if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
                if LLVMGetFirstUse(LLVMBasicBlockAsValue(LLVMGetInsertBlock(this.builder))) == null {
                    LLVMBuildUnreachable(this.builder);
                } else {
                    LLVMBuildBr(this.builder, end_block);
                    any_arm_branches_to_end = true;
                }
            }
        } else if current_block != end_block {
            LLVMPositionBuilderAtEnd(this.builder, current_block);

            if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
                LLVMBuildBr(this.builder, end_block);
                any_arm_branches_to_end = true;
            }
        }

        if !any_arm_branches_to_end && LLVMGetBasicBlockTerminator(end_block) == null {
            LLVMPositionBuilderAtEnd(this.builder, end_block);
            LLVMBuildUnreachable(this.builder);
        } else {
            LLVMPositionBuilderAtEnd(this.builder, end_block);
        }
    }

    fn CompileExtern(&mut this, _extern: *ExternNode) {
        if !this.mangling {
            Logger::Log("Already in a extern block.", _extern, LogSeverity::Error);
            return;
        }

        if _extern->linkage != "C" {
            Logger::Log("Unknown linkage '" + _extern->linkage + "'.", _extern, LogSeverity::Error);
            return;
        }

        this.mangling = false;

        for declaration in _extern->declarations {
            this.CompileDeclarationThirdPass(declaration);
        }

        this.mangling = true;
    }

    fn CompileBlock(&mut this, block: *BlockNode) {
        for statement in block->statements {
            this.CompileStatement(statement);
        }
    }

    fn CompileStatement(&mut this, statement: *Node) {
        if statement->_type == NodeType::RETURN {
            this.CompileReturn(statement as *ReturnNode);
        } else if statement->_type == NodeType::EXPRESSION {
            this.CompileExpression((statement as *ExpressionNode)->expression);
        } else if statement->_type == NodeType::IF {
            this.CompileIf(statement as *IfNode);
        } else if statement->_type == NodeType::IF_LET {
            this.CompileIfLet(statement as *IfLetNode);
        } else if statement->_type == NodeType::WHILE {
            this.CompileWhile(statement as *WhileNode);
        } else if statement->_type == NodeType::WHILE_LET {
            this.CompileWhileLet(statement as *WhileLetNode);
        } else if statement->_type == NodeType::FOR {
            this.CompileFor(statement as *ForNode);
        } else if statement->_type == NodeType::LOOP {
            this.CompileLoop(statement as *LoopNode);
        } else if statement->_type == NodeType::MATCH {
            this.CompileMatch(statement as *MatchNode);
        } else if statement->_type == NodeType::UNSAFE {
            this.CompileUnsafe(statement as *UnsafeNode);
        } else if statement->_type == NodeType::BLOCK {
            this.CompileBlock(statement as *BlockNode);
        } else if statement->_type == NodeType::CONTINUE {
            this.CompileContinue(statement as *ContinueNode);
        } else if statement->_type == NodeType::BREAK {
            this.CompileBreak(statement as *BreakNode);
        } else if statement->_type == NodeType::VARIABLE {
            this.CompileVariable(statement as *VariableNode);
        } else if statement->_type == NodeType::ASSIGNMENT {
            this.CompileAssignment(statement as *AssignmentNode);
        } else if statement->_type == NodeType::ASSEMBLY {
            this.CompileAssembly(statement as *AssemblyNode);
        } else {
            Logger::Log("Unknown statement '" + statement->_type.ToString() + "'.", statement, LogSeverity::Error);
        }
    }

    fn CompileUnsafe(&mut this, _unsafe: *UnsafeNode) {
        if this._unsafe {
            Logger::Log("Already in an unsafe statement.", _unsafe, LogSeverity::Error);
            return;
        }

        this._unsafe = true;
        this.CompileBlock(_unsafe->body);
        this._unsafe = false;
    }

    fn CompileReturn(&mut this, _return: *ReturnNode) {
        if _return->expression != null {
            let return_type = this.function->Return();
            let param_types = this.function->Parameters();
            let mut state = false;

            if !param_types.Empty() {
                state = param_types[0].sret != null;
            }

            if return_type.sret != null || state {
                let mut value = this.CompileExpression(_return->expression);

                if value.Null() {
                    return;
                }

                if value.Type().Pointee().IsReference() {
                    value = value.Load(value.IsLValue());
                }

                if return_type._type->IsInteger() {
                    if *return_type.sret != value.Type().Pointee() {
                        Logger::Log("Incompatible return types. ('" + return_type.sret->ToString() + "' != '" + value.Type().Pointee().ToString() + "').", _return, LogSeverity::Error);
                        return;
                    }

                    let return_value = LLVMBuildLoad2(this.builder, return_type._type->Value(), value.Value(), "");
                    this.scope_manager.InvokeDestructors(value);
                    LLVMBuildRet(this.builder, return_value);
                } else {
                    if *param_types[0].sret != value.Type().Pointee() {
                        Logger::Log("Incompatible return types. ('" + param_types[0].sret->ToString() + "' != '" + value.Type().Pointee().ToString() + "').", _return, LogSeverity::Error);
                        return;
                    }

                    let mut _params = Vector<QualifiedValue>();
                    _params.PushBack(value);
                    this.CompileConstructor(value.Type().Pointee(), QualifiedValue(LLVMGetParam(this.function_ref, 0), param_types[0]._type, true), _params, _return);
                    this.scope_manager.InvokeDestructors(value);
                    LLVMBuildRetVoid(this.builder);
                }
            } else {
                let mut value = this.CompileExpression(_return->expression).MaterializeWithFallback(return_type._type);

                if value.Null() {
                    return;
                }

                let mut state = false;

                if return_type._type->IsReference() {
                    if return_type._type->Pointee().IsCompatible(value.ToRValueType()) {
                        state = true;
                    }
                }

                if !state {
                    value = value.ToRValue();
                }

                if value.Type().IsReference() {
                    if *return_type._type == value.Type().Pointee() {
                        value = value.Load();
                    }
                }

                if !return_type._type->IsCompatible(value.Type()) {
                    Logger::Log("Incompatible return types. ('" + return_type._type->ToString() + "' != '" + value.Type().ToString() + "').", _return, LogSeverity::Error);
                    return;
                }

                if !return_type._type->IsMutabilityCompatible(value.Type()) {
                    Logger::Log("Cannot assign immutable pointer to mutable pointer.", _return, LogSeverity::Error);
                    return;
                }

                this.scope_manager.InvokeDestructors();
                LLVMBuildRet(this.builder, value.MakeCompatible(return_type._type).Value());
            }
        } else {
            this.scope_manager.InvokeDestructors();
            LLVMBuildRetVoid(this.builder);
        }
    }

    fn CompileCondition(&mut this, condition: *Node) -> LLVMValueRef {
        let mut value = this.CompileExpression(condition).Materialize().ToRValue();

        if value.Null() {
            return null;
        }

        if value.Type().IsReference() {
            value = QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
        }

        if !value.Type().IsBoolean() {
            Logger::Log("Invalid condition type '" + value.Type().ToString() + "'.", condition, LogSeverity::Error);
        }

        return value.Value();
    }

    fn CompileIf(&mut this, _if: *IfNode) {
        let function = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
        let then_block = LLVMAppendBasicBlockInContext(this.context, function, "");
        let (mut else_block: LLVMBasicBlockRef, mut end_block: LLVMBasicBlockRef) = (null, null);

        if _if->_else != null {
            else_block = LLVMAppendBasicBlockInContext(this.context, function, "");
        } else {
            if end_block == null {
                end_block = LLVMAppendBasicBlockInContext(this.context, function, "");
            } else_block = end_block;
        }

        let condition = this.CompileCondition(_if->condition);

        if condition != null {
            LLVMBuildCondBr(this.builder, condition, then_block, else_block);
        } else {
            return;
        }

        LLVMPositionBuilderAtEnd(this.builder, then_block);
        this.scope_manager.PushScope(String("then"), false);
        this.CompileBlock(_if->body as *BlockNode);
        this.scope_manager.PopScope();

        if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
            if end_block == null {
                end_block = LLVMAppendBasicBlockInContext(this.context, function, "");
            } LLVMBuildBr(this.builder, end_block);
        }

        if _if->_else != null {
            LLVMPositionBuilderAtEnd(this.builder, else_block);
            this.scope_manager.PushScope(String("else"), false);

            if _if->_else->_type == NodeType::IF_LET {
                this.CompileIfLet(_if->_else as *IfLetNode);
            } else if _if->_else->_type == NodeType::IF {
                this.CompileIf(_if->_else as *IfNode);
            } else {
                this.CompileBlock(_if->_else as *BlockNode);
            }

            this.scope_manager.PopScope();

            if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
                if end_block == null {
                    end_block = LLVMAppendBasicBlockInContext(this.context, function, "");
                } LLVMBuildBr(this.builder, end_block);
            }
        }

        if end_block != null {
            LLVMPositionBuilderAtEnd(this.builder, end_block);
        }
    }

    fn CompileIfLet(&mut this, if_let: *IfLetNode) {
        let function = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
        let then_block = LLVMAppendBasicBlockInContext(this.context, function, "");
        let (mut else_block: LLVMBasicBlockRef, mut end_block: LLVMBasicBlockRef) = (null, null);

        if if_let->_else != null {
            else_block = LLVMAppendBasicBlockInContext(this.context, function, "");
        } else {
            if end_block == null {
                end_block = LLVMAppendBasicBlockInContext(this.context, function, "");
            } else_block = end_block;
        }

        let mut expression = this.CompileExpression(if_let->expression).Materialize().ToRValue();

        if expression.Null() {
            return;
        }

        if expression.Type().IsReference() {
            expression = QualifiedValue(LLVMBuildLoad2(this.builder, expression.Type().Pointee().Value(), expression.Value(), ""), expression.Type().Pointee());
        }

        let current = LLVMGetInsertBlock(this.builder);
        LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(function));
        let mut match_pointer = LLVMBuildAlloca(this.builder, expression.Type().Value(), "");
        LLVMPositionBuilderAtEnd(this.builder, current);
        LLVMBuildStore(this.builder, expression.Value(), match_pointer);
        let condition = this.BuildPatternCondition(if_let->pattern, match_pointer, &expression.Type());
        LLVMBuildCondBr(this.builder, condition, then_block, else_block);

        LLVMPositionBuilderAtEnd(this.builder, then_block);
        this.scope_manager.PushScope(String("then"), false);
        this.BindPattern(if_let->pattern, match_pointer, &expression.Type());
        this.CompileStatement(if_let->body);
        this.scope_manager.PopScope();

        if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
            if end_block == null {
                end_block = LLVMAppendBasicBlockInContext(this.context, function, "");
            } LLVMBuildBr(this.builder, end_block);
        }

        if if_let->_else != null {
            LLVMPositionBuilderAtEnd(this.builder, else_block);
            this.scope_manager.PushScope(String("else"), false);

            if if_let->_else->_type == NodeType::IF_LET {
                this.CompileIfLet(if_let->_else as *IfLetNode);
            } else if if_let->_else->_type == NodeType::IF {
                this.CompileIf(if_let->_else as *IfNode);
            } else {
                this.CompileBlock(if_let->_else as *BlockNode);
            }

            this.scope_manager.PopScope();

            if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
                if end_block == null {
                    end_block = LLVMAppendBasicBlockInContext(this.context, function, "");
                } LLVMBuildBr(this.builder, end_block);
            }
        }

        if end_block != null {
            LLVMPositionBuilderAtEnd(this.builder, end_block);
        }
    }

    fn CompileWhileLet(&mut this, while_let: *WhileLetNode) {
        let function = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
        let compare_block = LLVMAppendBasicBlockInContext(this.context, function, "");
        let loop_block = LLVMAppendBasicBlockInContext(this.context, function, "");
        let end_block = LLVMAppendBasicBlockInContext(this.context, function, "");

        LLVMBuildBr(this.builder, compare_block);
        LLVMPositionBuilderAtEnd(this.builder, compare_block);

        let mut expression = this.CompileExpression(while_let->expression).Materialize().ToRValue();

        if expression.Null() {
            return;
        }

        if expression.Type().IsReference() {
            expression = QualifiedValue(LLVMBuildLoad2(this.builder, expression.Type().Pointee().Value(), expression.Value(), ""), expression.Type().Pointee());
        }

        let current = LLVMGetInsertBlock(this.builder);
        LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(function));
        let mut match_pointer = LLVMBuildAlloca(this.builder, expression.Type().Value(), "");
        LLVMPositionBuilderAtEnd(this.builder, current);
        LLVMBuildStore(this.builder, expression.Value(), match_pointer);
        let condition = this.BuildPatternCondition(while_let->pattern, match_pointer, &expression.Type());
        LLVMBuildCondBr(this.builder, condition, loop_block, end_block);

        LLVMPositionBuilderAtEnd(this.builder, loop_block);
        this.loop_blocks.PushBack(Pair<LLVMBasicBlockRef, LLVMBasicBlockRef>(compare_block, end_block));
        this.scope_manager.PushScope(String("while"), false);
        this.loop_scopes.PushBack(this.scope_manager.current);
        this.BindPattern(while_let->pattern, match_pointer, &expression.Type());
        this.CompileStatement(while_let->body);
        this.loop_scopes.PopBack();
        this.scope_manager.PopScope();
        this.loop_blocks.PopBack();

        if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
            LLVMBuildBr(this.builder, compare_block);
        }

        LLVMPositionBuilderAtEnd(this.builder, end_block);
    }

    fn CompileWhile(&mut this, _while: *WhileNode) {
        let function = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
        let compare_block = LLVMAppendBasicBlockInContext(this.context, function, "");
        let loop_block = LLVMAppendBasicBlockInContext(this.context, function, "");
        let end_block = LLVMAppendBasicBlockInContext(this.context, function, "");

        if _while->_else != null {
            let else_block = LLVMAppendBasicBlockInContext(this.context, function, "");
            let condition = this.CompileCondition(_while->condition);

            if condition != null {
                LLVMBuildCondBr(this.builder, condition, loop_block, else_block);
            } else {
                return;
            }

            LLVMPositionBuilderAtStart(this.builder, else_block);
            this.scope_manager.PushScope(String("else"), false);
            this.CompileBlock(_while->_else as *BlockNode);
            this.scope_manager.PopScope();

            if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
                LLVMBuildBr(this.builder, end_block);
            }
        } else {
            LLVMBuildBr(this.builder, compare_block);
        }

        LLVMPositionBuilderAtStart(this.builder, compare_block);
        let condition = this.CompileCondition(_while->condition);

        if condition != null {
            LLVMBuildCondBr(this.builder, condition, loop_block, end_block);
        } else {
            return;
        }

        LLVMPositionBuilderAtStart(this.builder, loop_block);
        this.loop_blocks.PushBack(Pair<LLVMBasicBlockRef, LLVMBasicBlockRef>(compare_block, end_block));
        this.scope_manager.PushScope(String("while"), false);
        this.loop_scopes.PushBack(this.scope_manager.current);
        this.CompileBlock(_while->body as *BlockNode);
        this.loop_scopes.PopBack();
        this.scope_manager.PopScope();
        this.loop_blocks.PopBack();

        if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
            LLVMBuildBr(this.builder, compare_block);
        }

        LLVMPositionBuilderAtStart(this.builder, end_block);
    }

    fn CompileFor(&mut this, _for: *ForNode) {
        let (mut start: QualifiedValue, mut end: QualifiedValue);
        let (mut is_range, mut is_inclusive) = (false, false);

        if _for->iterable->_type == NodeType::RANGE {
            let range = _for->iterable as *RangeNode;
            (is_range, is_inclusive) = (true, range->inclusive);

            start = this.CompileExpression(range->start);
            if start.Null() { return; }

            end = this.CompileExpression(range->end);
            if end.Null() { return; }

            if start.Type().IsLiteral() {
                let end_type = end.ToRValueType();

                if !end_type.IsLiteral() && (end_type.IsInteger() || end_type.IsFloat()) {
                    start = start.Materialize(end_type);
                }
            } else if end.Type().IsLiteral() {
                let start_type = start.ToRValueType();

                if start_type.IsInteger() || start_type.IsFloat() {
                    end = end.Materialize(start_type);
                }
            }

            start = start.Materialize().ToRValue();
            end = end.Materialize().ToRValue();
        } else {
            let mut iterable = this.CompileExpression(_for->iterable);
            if iterable.Null() { return; }

            if iterable.Type().IsPointer() {
                if iterable.Type().Pointee().IsReference() {
                    iterable = QualifiedValue(LLVMBuildLoad2(this.builder, iterable.Type().Pointee().Value(), iterable.Value(), ""), iterable.Type().Pointee(), false, iterable.IsLValue());
                }
            }

            if iterable.Type().IsPointer() {
                let _type = iterable.Type().Pointee();

                if _type.HasMethods() {
                    if _type.Has(String("Begin")) && _type.Has(String("End")) {
                        let begin_method = _type.Get(String("Begin"), _for);
                        if begin_method == null { return; }

                        let end_method = _type.Get(String("End"), _for);
                        if end_method == null { return; }

                        let values = Vector<QualifiedValue>();
                        start = this.CompileResolvedCall(QualifiedValue(begin_method->left.value, begin_method->right, iterable), values, false, _for).ToRValue();
                        if start.Null() { return; }

                        end = this.CompileResolvedCall(QualifiedValue(end_method->left.value, end_method->right, iterable), values, false, _for).ToRValue();
                        if end.Null() { return; }
                    } 
                }
            }

            if start.Null() || end.Null() {
                Logger::Log("For loop only supports range expressions or classes with '.Begin()' and '.End()' methods.", _for, LogSeverity::Error);
                return;
            }
        }

        if start.Type() != end.Type() {
            Logger::Log("Start and end expressions of a for loop must have the same type.", _for, LogSeverity::Error);
            return;
        }

        let function = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
        let compare_block = LLVMAppendBasicBlockInContext(this.context, function, "");
        let loop_block = LLVMAppendBasicBlockInContext(this.context, function, "");
        let step_block = LLVMAppendBasicBlockInContext(this.context, function, "");
        let end_block = LLVMAppendBasicBlockInContext(this.context, function, "");

        let _type = start.Type();
        let current = LLVMGetInsertBlock(this.builder);
        LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(function));
        let pointer = LLVMBuildAlloca(this.builder, _type.Value(), "");
        LLVMPositionBuilderAtEnd(this.builder, current);
        LLVMBuildStore(this.builder, start.Value(), pointer);
        LLVMBuildBr(this.builder, compare_block);
        LLVMPositionBuilderAtStart(this.builder, compare_block);
        let value = LLVMBuildLoad2(this.builder, _type.Value(), pointer, "");
        let mut condition = null;

        if is_range {
            if _type.IsFloat() {
                if is_inclusive {
                    condition = LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOLE, value, end.Value(), "");
                } else {
                    condition = LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOLT, value, end.Value(), "");
                }
            } else if _type.IsInteger() {
                if is_inclusive {
                    condition = LLVMBuildICmp(this.builder, _type.IsSigned() ? LLVMIntPredicate::LLVMIntSLE : LLVMIntPredicate::LLVMIntULE, value, end.Value(), "");
                } else {
                    condition = LLVMBuildICmp(this.builder, _type.IsSigned() ? LLVMIntPredicate::LLVMIntSLT : LLVMIntPredicate::LLVMIntULT, value, end.Value(), "");
                }
            } else {
                Logger::Log("For loop only supports range expressions of integer or floating point types.", _for, LogSeverity::Error);
                return;
            }
        } else {
            if _type.IsPointer() {
                condition = LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntNE, value, end.Value(), "");
            } else if _type.HasMethods() && _type.Has(String("operator!=")) {
                let mut values = Vector<QualifiedValue>();
                values.PushBack(end);
                let instance = QualifiedValue(pointer, this.type_manager.Pointer(_type, true), true);
                let method = _type.Get(String("operator!="), _for);
                condition = this.CompileResolvedCall(QualifiedValue(method->left.value, method->right, instance), values, false, _for).ToRValue().Value();
            } else {
                Logger::Log("For loop only supports pointer iterators or classes with '!=' operator.", _for, LogSeverity::Error);
                return;
            }
        }

        LLVMBuildCondBr(this.builder, condition, loop_block, end_block);
        LLVMPositionBuilderAtStart(this.builder, loop_block);
        this.loop_blocks.PushBack(Pair<LLVMBasicBlockRef, LLVMBasicBlockRef>(step_block, end_block));
        this.scope_manager.PushScope(String("for"), false);
        this.loop_scopes.PushBack(this.scope_manager.current);

        if is_range {
            let result = QualifiedValue(pointer, this.type_manager.Pointer(_type, false), true);
            this.scope_manager.Set(_for->variable, SymbolKind::Variable, result, false, _for);
        } else {
            if _type.IsPointer() {
                let result = QualifiedValue(value, _type, true);
                this.scope_manager.Set(_for->variable, SymbolKind::Variable, result, false, _for);
            } else if _type.HasMethods() && _type.Has(String("operator*")) {
                let mut values = Vector<QualifiedValue>();
                let instance = QualifiedValue(pointer, this.type_manager.Pointer(_type, true), true);
                let method = _type.Get(String("operator*"), _for);
                let result = this.CompileResolvedCall(QualifiedValue(method->left.value, method->right, instance), values, false, _for).ToRValue();
                this.scope_manager.Set(_for->variable, SymbolKind::Variable, result, false, _for);
            } else {
                Logger::Log("For loop only supports pointer iterators or classes with 'operator*' operator.", _for, LogSeverity::Error);
                return;
            }
        }

        this.CompileBlock(_for->body as *BlockNode);
        this.loop_scopes.PopBack();
        this.scope_manager.PopScope();
        this.loop_blocks.PopBack();

        if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
            LLVMBuildBr(this.builder, step_block);
        }

        LLVMPositionBuilderAtStart(this.builder, step_block);
        let current_value = LLVMBuildLoad2(this.builder, _type.Value(), pointer, "");
        let mut new_value = null;

        if is_range {
            if _type.IsFloat() {
                new_value = LLVMBuildFAdd(this.builder, current_value, LLVMConstReal(_type.Value(), 1.0), "");
            } else if _type.IsInteger() {
                new_value = LLVMBuildAdd(this.builder, current_value, LLVMConstInt(_type.Value(), 1, 0), "");
            } else {
                Logger::Log("For loop only supports range expressions of integer or floating point types.", _for, LogSeverity::Error);
                return;
            }
        } else {
            if _type.IsPointer() {
                let indices[]: LLVMValueRef = { LLVMConstInt(LLVMIntPtrTypeInContext(this.context, this.target->layout), 1, 0) };
                new_value = LLVMBuildGEP2(this.builder, _type.Pointee().Value(), current_value, indices, 1, "");
            } else if _type.HasMethods() && _type.Has(String("operator+=")) {
                let mut values = Vector<QualifiedValue>();
                let param_type = this.type_manager.IntegerPointer(false);
                values.PushBack(QualifiedValue(LLVMConstInt(param_type->Value(), 1, 0), param_type));
                let instance = QualifiedValue(pointer, this.type_manager.Pointer(_type, true), true);
                let method = _type.Get(String("operator+="), _for);
                this.CompileResolvedCall(QualifiedValue(method->left.value, method->right, instance), values, false, _for);
                new_value = LLVMBuildLoad2(this.builder, _type.Value(), pointer, "");
            } else {
                Logger::Log("For loop only supports pointer iterators or classes with '+=' operator.", _for, LogSeverity::Error);
                return;
            }
        }

        LLVMBuildStore(this.builder, new_value, pointer);
        LLVMBuildBr(this.builder, compare_block);
        LLVMPositionBuilderAtStart(this.builder, end_block);
    }

    fn CompileLoop(&mut this, _loop: *LoopNode) {
        let function = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
        let loop_block = LLVMAppendBasicBlockInContext(this.context, function, "");
        let end_block = LLVMAppendBasicBlockInContext(this.context, function, "");
        this.loop_blocks.PushBack(Pair<LLVMBasicBlockRef, LLVMBasicBlockRef>(loop_block, end_block));

        LLVMBuildBr(this.builder, loop_block);
        LLVMPositionBuilderAtStart(this.builder, loop_block);
        this.scope_manager.PushScope(String("loop"), false);
        this.loop_scopes.PushBack(this.scope_manager.current);
        this.CompileBlock(_loop->body as *BlockNode);
        this.loop_scopes.PopBack();
        this.scope_manager.PopScope();

        if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
            LLVMBuildBr(this.builder, loop_block);
        }

        LLVMPositionBuilderAtStart(this.builder, end_block);
        this.loop_blocks.PopBack();
    }

    fn CompileContinue(&this, _continue: *ContinueNode) {
        if this.loop_blocks.Empty() {
            Logger::Log("Continue statement outside of loop.", _continue, LogSeverity::Error);
            return;
        }

        this.scope_manager.InvokeDestructorsUntil(this.loop_scopes.Back());
        LLVMBuildBr(this.builder, this.loop_blocks.Back().left);
    }

    fn CompileBreak(&this, _break: *BreakNode) {
        if this.loop_blocks.Empty() {
            Logger::Log("Break statement outside of loop.", _break, LogSeverity::Error);
            return;
        }

        this.scope_manager.InvokeDestructorsUntil(this.loop_scopes.Back());
        LLVMBuildBr(this.builder, this.loop_blocks.Back().right);
    }

    fn LiteralNeedsExplicitType(&mut this, expression: *Node, target: *QualifiedType) -> bool {
        let _type = this.IsDeferrableExpression(expression);

        if _type == null {
            return false;
        } else if _type->IsInteger() {
            return target->IsInteger() && !target->IsSame(this.type_manager.Integer(32, true));
        } else if _type->IsFloat() {
            return target->IsFloat() && !target->IsSame(this.type_manager.Float(64));
        } else {
            return false;
        }
    }

    fn CompileVariable(&mut this, variable: *VariableNode) {
        if variable->_type != null {
            let mut _type = this.CompileType(variable->_type);
            if _type == null { return; }

            if _type->HasFields() {
                let (mut has_error, mut skip) = (true, false);
                let mut params = Vector<QualifiedValue>();

                if variable->initializer != null {
                    let mut value = this.CompileExpression(variable->initializer).MaterializeWithFallback(_type);

                    if !value.Null() {
                        let mut value_type: *QualifiedType = value.ToRValueType();
                        let same = _type->IsSame(value_type);

                        if value_type->IsReference() {
                            value_type = value_type->Pointee();
                        }

                        if *_type == value_type {
                            has_error = false;

                            if !value._return {
                                params.PushBack(value);
                            } else {
                                this.scope_manager.Set(variable->name, SymbolKind::Variable, value, false, variable);
                                skip = true;
                            }

                            if same && !this.LiteralNeedsExplicitType(variable->initializer, _type) {
                                Logger::Log("Unnecessary type annotation, type can be inferred from initializer.", variable, LogSeverity::Warning);
                            }
                        } else {
                            Logger::Log("Incompatible variable initialization types. ('" + _type->ToString() + "' != '" + value_type->ToString() + "').", variable, LogSeverity::Error);
                        }
                    }
                } else {
                    has_error = false;
                }

                if !skip {
                    let mut instance = QualifiedValue(null, null);

                    if !has_error {
                        let current = LLVMGetInsertBlock(this.builder);
                        LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
                        instance = QualifiedValue(LLVMBuildAlloca(this.builder, _type->Value(), ""), this.type_manager.Pointer(_type, variable->mutable), true);
                        LLVMPositionBuilderAtEnd(this.builder, current);
                        this.CompileConstructor(_type, instance, params, variable);
                        this.scope_manager.RegisterInstance(instance);
                    }

                    this.scope_manager.Set(variable->name, SymbolKind::Variable, instance, false, variable);
                }
            } else {
                if variable->initializer != null {
                    if variable->initializer->_type == NodeType::INITIALIZER_LIST {
                        let initializer_list = variable->initializer as *InitializerListNode;

                        if variable->_type->_type == NodeType::ARRAY_TYPE {
                            let array = variable->_type as *ArrayTypeNode;

                            if array->size == null && !initializer_list->expressions.Empty() {
                                _type = this.type_manager.Array(_type->Pointee(), initializer_list->expressions.Size(), _type->IsMutable());
                            }
                        }
                    }
                }

                let current = LLVMGetInsertBlock(this.builder);
                LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
                let pointer = QualifiedValue(LLVMBuildAlloca(this.builder, _type->Value(), ""), this.type_manager.Pointer(_type, variable->mutable), true);
                LLVMPositionBuilderAtEnd(this.builder, current);

                if variable->initializer != null {
                    if variable->initializer->_type != NodeType::INITIALIZER_LIST {
                        let mut initializer = this.CompileExpression(variable->initializer).MaterializeWithFallback(_type);

                        if !initializer.Null() {
                            let same = _type->IsSame(initializer.ToRValueType());
                            let mut state = false;

                            if _type->IsReference() {
                                if _type->Pointee().IsCompatible(initializer.ToRValueType()) {
                                    state = true;
                                }
                            }

                            if !state {
                                initializer = initializer.ToRValue();
                            }

                            if initializer.Type().IsReference() {
                                if *_type == initializer.Type().Pointee() {
                                    initializer = QualifiedValue(LLVMBuildLoad2(this.builder, initializer.Type().Pointee().Value(), initializer.Value(), ""), initializer.Type().Pointee());
                                }
                            }

                            if _type->IsCompatible(initializer.Type()) {
                                if _type->IsMutabilityCompatible(initializer.Type()) {
                                    if same && !this.LiteralNeedsExplicitType(variable->initializer, _type) {
                                        Logger::Log("Unnecessary type annotation, type can be inferred from initializer.", variable, LogSeverity::Warning);
                                    }

                                    LLVMBuildStore(this.builder, initializer.MakeCompatible(_type).Value(), pointer.Value());
                                } else {
                                    Logger::Log("Cannot assign immutable pointer to mutable pointer.", variable, LogSeverity::Error);
                                }
                            } else {
                                Logger::Log("Incompatible variable initialization types. ('" + _type->ToString() + "' != '" + initializer.Type().ToString() + "').", variable, LogSeverity::Error);
                            }
                        }
                    } else {
                        let mut index: u64 = 0;

                        for expression in (variable->initializer as *InitializerListNode)->expressions {
                            let value = this.CompileExpression(expression).MaterializeWithFallback(_type->Element()).ToRValue();

                            if value.Null() {
                                break;
                            }

                            let indices[]: LLVMValueRef = { LLVMConstInt(LLVMIntPtrTypeInContext(this.context, this.target->layout), index, 0) };
                            LLVMBuildStore(this.builder, value.Value(), LLVMBuildGEP2(this.builder, _type->Element().Value(), pointer.Value(), indices, 1, ""));
                            let increment: u64 = 1;
                            index += increment;
                        }
                    }
                }

                this.scope_manager.Set(variable->name, SymbolKind::Variable, pointer, false, variable);
            }
        } else {
            let (mut value: QualifiedValue, mut pointer: QualifiedValue);

            if variable->initializer != null {
                value = this.CompileExpression(variable->initializer).Materialize();
            } else {
                Logger::Log("Type annotation required for variable '" + variable->name + "' without initializer.", variable, LogSeverity::Error);
            }

            if !value.Null() {
                let _type = value.ToRValueType();

                if !value._return {
                    let current = LLVMGetInsertBlock(this.builder);
                    LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
                    pointer = QualifiedValue(LLVMBuildAlloca(this.builder, _type.Value(), ""), this.type_manager.Pointer(_type, variable->mutable), true);
                    LLVMPositionBuilderAtEnd(this.builder, current);

                    if _type.HasFields() {
                        let mut params = Vector<QualifiedValue>();
                        params.PushBack(value);
                        this.CompileConstructor(_type, pointer, params, variable);
                        this.scope_manager.RegisterInstance(pointer);
                    } else {
                        LLVMBuildStore(this.builder, value.ToRValue().Value(), pointer.Value());
                    }
                } else {
                    pointer = value;
                }
            }

            this.scope_manager.Set(variable->name, SymbolKind::Variable, pointer, false, variable);
        }

        if variable->next != null {
            this.CompileVariable(variable->next);
        }
    }

    fn CompileAssignment(&mut this, assignment: *AssignmentNode) -> QualifiedValue {
        let pointer = this.CompileExpression(assignment->left);

        if pointer.Null() {
            return QualifiedValue(null, null);
        }

        let mut target: *QualifiedType = null;

        if pointer.Type().IsPointer() {
            if pointer.Type().Pointee().IsPointer() && (assignment->_operator == TokenType::PLUS_ASSIGN || assignment->_operator == TokenType::MINUS_ASSIGN) {
                target = this.type_manager.IntegerPointer(false);
            } else {
                target = pointer.Type().Pointee();
            }
        }

        let mut value = this.CompileExpression(assignment->right).MaterializeWithFallback(target);

        if value.Null() {
            return QualifiedValue(null, null);
        }

        value = this.CompileResolvedAssignment(value, pointer, assignment->_operator, false, assignment);

        if assignment->next != null {
            this.CompileAssignment(assignment->next);
            return QualifiedValue(null, null);
        } else {
            return value;
        }
    }

    fn CompileResolvedAssignment(&mut this, mut value: QualifiedValue, mut pointer: QualifiedValue, _operator: TokenType, ignore: bool, node: *Node) -> QualifiedValue {
        if pointer.Type().Pointee().IsReference() {
            pointer = QualifiedValue(LLVMBuildLoad2(this.builder, pointer.Type().Pointee().Value(), pointer.Value(), ""), pointer.Type().Pointee());
        }

        if pointer.Type().Pointee().HasMethods() {
            let mut params = Vector<QualifiedValue>();
            params.PushBack(value);

            let mut method_name = "operator".ToString();
            method_name += _operator.ToAssignmentOperatorString();
            let param_types = this.ValueToType(params);
            let _type = pointer.Type().Pointee();

            if _type.Has(method_name, param_types) {
                let method = _type.Get(method_name, param_types, node);
                return this.CompileResolvedCall(QualifiedValue(method->left.value, method->right, pointer), params, false, node);
            }

            if !pointer.Type().IsMutable() && !ignore {
                Logger::Log("Cannot assign to immutable variable.", node, LogSeverity::Error);
                return QualifiedValue(null, null);
            }

            if value.Type().Pointee().IsReference() {
                if value.Type().Pointee().Pointee() == _type {
                    value = value.Load(value.IsLValue());
                }
            }

            if value.Type().Pointee() == _type {
                if _operator != TokenType::ASSIGN {
                    Logger::Log("Invalid class assignment operation '" + _operator.ToString() + "' for type '" + _type.ToString() + "'.", node, LogSeverity::Error);
                    return QualifiedValue(null, null);
                }

                for field in _type.Fields() {
                    let mut field_type = field.right._type;

                    if field_type->IsPointer() {
                        field_type = this.type_manager.Copy(field_type, true);
                    }

                    let _value = QualifiedValue(LLVMBuildStructGEP2(this.builder, value.Type().Pointee().Value(), value.Value(), _type.Index(field.left) as u32, ""), this.type_manager.Pointer(field_type, true), true);
                    let _pointer = QualifiedValue(LLVMBuildStructGEP2(this.builder, pointer.Type().Pointee().Value(), pointer.Value(), _type.Index(field.left) as u32, ""), this.type_manager.Pointer(field_type, true), true);
                    this.CompileResolvedAssignment(_value, _pointer, _operator, ignore, node);
                }
            } else {
                Logger::Log("Incompatible class assignment types. ('" + _type.ToString() + "' != '" + value.Type().Pointee().ToString() + "').", node, LogSeverity::Error);
                return QualifiedValue(null, null);
            }
        } else {
            value = value.Materialize(pointer.Type().Pointee()).ToRValue();

            if _operator != TokenType::ASSIGN {
                let current = QualifiedValue(LLVMBuildLoad2(this.builder, pointer.Type().Pointee().Value(), pointer.Value(), ""), pointer.Type().Pointee());

                if current.Type().IsBoolean() && value.Type().IsBoolean() {
                    if _operator == TokenType::AND_ASSIGN {
                        value = QualifiedValue(LLVMBuildAnd(this.builder, current.Value(), value.Value(), ""), value.Type());
                    } else if _operator == TokenType::OR_ASSIGN {
                        value = QualifiedValue(LLVMBuildOr(this.builder, current.Value(), value.Value(), ""), value.Type());
                    } else if _operator == TokenType::XOR_ASSIGN {
                        value = QualifiedValue(LLVMBuildXor(this.builder, current.Value(), value.Value(), ""), value.Type());
                    } else {
                        Logger::Log("Invalid assignment operation '" + _operator.ToString() + "' for type '" + value.Type().ToString() + "'.", node, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }
                } else if current.Type().IsInteger() && value.Type().IsInteger() {
                    if value.Type() != current.Type() {
                        Logger::Log("Incompatible assignment operation types. ('" + value.Type().ToString() + "' != '" + current.Type().ToString() + "').", node, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }

                    if _operator == TokenType::PLUS_ASSIGN {
                        value = QualifiedValue(LLVMBuildAdd(this.builder, current.Value(), value.Value(), ""), value.Type());
                    } else if _operator == TokenType::MINUS_ASSIGN {
                        value = QualifiedValue(LLVMBuildSub(this.builder, current.Value(), value.Value(), ""), value.Type());
                    } else if _operator == TokenType::MUL_ASSIGN {
                        value = QualifiedValue(LLVMBuildMul(this.builder, current.Value(), value.Value(), ""), value.Type());
                    } else if _operator == TokenType::DIV_ASSIGN {
                        if value.Type().IsSigned() {
                            value = QualifiedValue(LLVMBuildSDiv(this.builder, current.Value(), value.Value(), ""), value.Type());
                        } else {
                            value = QualifiedValue(LLVMBuildUDiv(this.builder, current.Value(), value.Value(), ""), value.Type());
                        }
                    } else if _operator == TokenType::MOD_ASSIGN {
                        if value.Type().IsSigned() {
                            value = QualifiedValue(LLVMBuildSRem(this.builder, current.Value(), value.Value(), ""), value.Type());
                        } else {
                            value = QualifiedValue(LLVMBuildURem(this.builder, current.Value(), value.Value(), ""), value.Type());
                        }
                    } else if _operator == TokenType::AND_ASSIGN {
                        value = QualifiedValue(LLVMBuildAnd(this.builder, current.Value(), value.Value(), ""), value.Type());
                    } else if _operator == TokenType::OR_ASSIGN {
                        value = QualifiedValue(LLVMBuildOr(this.builder, current.Value(), value.Value(), ""), value.Type());
                    } else if _operator == TokenType::XOR_ASSIGN {
                        value = QualifiedValue(LLVMBuildXor(this.builder, current.Value(), value.Value(), ""), value.Type());
                    } else if _operator == TokenType::LSHIFT_ASSIGN {
                        value = QualifiedValue(LLVMBuildShl(this.builder, current.Value(), value.Value(), ""), value.Type());
                    } else if _operator == TokenType::RSHIFT_ASSIGN {
                        if value.Type().IsSigned() {
                            value = QualifiedValue(LLVMBuildAShr(this.builder, current.Value(), value.Value(), ""), value.Type());
                        } else {
                            value = QualifiedValue(LLVMBuildLShr(this.builder, current.Value(), value.Value(), ""), value.Type());
                        }
                    } else {
                        Logger::Log("Invalid assignment operation '" + _operator.ToString() + "' for type '" + value.Type().ToString() + "'.", node, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }
                } else if current.Type().IsFloat() && value.Type().IsFloat() {
                    if value.Type() != current.Type() {
                        Logger::Log("Incompatible assignment operation types. ('" + value.Type().ToString() + "' != '" + current.Type().ToString() + "').", node, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }

                    if _operator == TokenType::PLUS_ASSIGN {
                        value = QualifiedValue(LLVMBuildFAdd(this.builder, current.Value(), value.Value(), ""), value.Type());
                    } else if _operator == TokenType::MINUS_ASSIGN {
                        value = QualifiedValue(LLVMBuildFSub(this.builder, current.Value(), value.Value(), ""), value.Type());
                    } else if _operator == TokenType::MUL_ASSIGN {
                        value = QualifiedValue(LLVMBuildFMul(this.builder, current.Value(), value.Value(), ""), value.Type());
                    } else if _operator == TokenType::DIV_ASSIGN {
                        value = QualifiedValue(LLVMBuildFDiv(this.builder, current.Value(), value.Value(), ""), value.Type());
                    } else if _operator == TokenType::MOD_ASSIGN {
                        value = QualifiedValue(LLVMBuildFRem(this.builder, current.Value(), value.Value(), ""), value.Type());
                    } else {
                        Logger::Log("Invalid assignment operation '" + _operator.ToString() + "' for type '" + value.Type().ToString() + "'.", node, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }
                } else if current.Type().IsPointer() && value.Type().IsInteger() {
                    if !value.Type().IsIntegerPointer() {
                        Logger::Log("Pointer arithmetic requires an operand of pointer-sized type.", node, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }

                    if _operator == TokenType::PLUS_ASSIGN {
                        let indices[]: LLVMValueRef = { value.Value() };
                        value = QualifiedValue(LLVMBuildGEP2(this.builder, current.Type().Pointee().Value(), current.Value(), indices, 1, ""), current.Type());
                    } else if _operator == TokenType::MINUS_ASSIGN {
                        let indices[]: LLVMValueRef = { LLVMBuildNeg(this.builder, value.Value(), "") };
                        value = QualifiedValue(LLVMBuildGEP2(this.builder, current.Type().Pointee().Value(), current.Value(), indices, 1, ""), current.Type());
                    } else {
                        Logger::Log("Invalid pointer assignment operation '" + _operator.ToString() + "' for type '" + current.Type().ToString() + "'.", node, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }
                } else if current.Type().IsEnumeration() && value.Type().IsEnumeration() {
                    if value.Type() != current.Type() {
                        Logger::Log("Incompatible assignment operation types. ('" + value.Type().ToString() + "' != '" + current.Type().ToString() + "').", node, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }

                    if _operator == TokenType::AND_ASSIGN {
                        value = QualifiedValue(LLVMBuildAnd(this.builder, current.Value(), value.Value(), ""), value.Type());
                    } else if _operator == TokenType::OR_ASSIGN {
                        value = QualifiedValue(LLVMBuildOr(this.builder, current.Value(), value.Value(), ""), value.Type());
                    } else if _operator == TokenType::XOR_ASSIGN {
                        value = QualifiedValue(LLVMBuildXor(this.builder, current.Value(), value.Value(), ""), value.Type());
                    } else {
                        Logger::Log("Invalid assignment operation '" + _operator.ToString() + "' for type '" + value.Type().ToString() + "'.", node, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }
                } else {
                    Logger::Log("Invalid type '" + value.Type().ToString() + "' for assignment operation '" + _operator.ToString() + "'.", node, LogSeverity::Error);
                    return QualifiedValue(null, null);
                }
            }

            if !pointer.Type().IsMutable() && !ignore {
                Logger::Log("Cannot assign to immutable variable.", node, LogSeverity::Error);
                return QualifiedValue(null, null);
            }

            if value.Type().IsReference() {
                if pointer.Type().Pointee().IsCompatible(value.Type().Pointee()) {
                    value = QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
                }
            }

            if pointer.Type().Pointee().IsCompatible(value.Type()) {
                if pointer.Type().Pointee().IsMutabilityCompatible(value.Type()) {
                    LLVMBuildStore(this.builder, value.MakeCompatible(pointer.Type().Pointee()).Value(), pointer.Value());
                } else {
                    Logger::Log("Cannot assign immutable pointer to mutable pointer.", node, LogSeverity::Error);
                }
            } else {
                Logger::Log("Incompatible assignment types. ('" + pointer.Type().Pointee().ToString() + "' != '" + value.Type().ToString() + "').", node, LogSeverity::Error);
            }
        } return pointer;
    }

    fn IsDeferrableExpression(&mut this, node: *Node) -> *QualifiedType {
        if node->_type == NodeType::LITERAL {
            let literal = node as *LiteralNode;

            if literal->_type == TokenType::INTEGER && !literal->value.Contains('u') && !literal->value.Contains('i') {
                return this.type_manager.IntegerLiteral();
            } else if literal->_type == TokenType::FLOAT && !literal->value.Contains('f') {
                return this.type_manager.FloatLiteral();
            } else {
                return null;
            }
        } else if node->_type == NodeType::TERNARY {
            let ternary = node as *TernaryNode;
            let then_type = this.IsDeferrableExpression(ternary->then);
            if then_type == null { return null; }
            let else_type = this.IsDeferrableExpression(ternary->_else);
            if else_type == null { return null; }

            if *then_type == *else_type {
                return then_type;
            } else {
                return null;
            }
        } else if node->_type == NodeType::BINARY {
            let binary = node as *BinaryNode;

            if binary->_operator == TokenType::EQUAL || binary->_operator == TokenType::NOT_EQUAL || binary->_operator == TokenType::GREATER || binary->_operator == TokenType::LESS || binary->_operator == TokenType::GREATER_EQUAL || binary->_operator == TokenType::LESS_EQUAL || binary->_operator == TokenType::AND || binary->_operator == TokenType::OR {
                return null;
            }

            let left_type = this.IsDeferrableExpression(binary->left);
            if left_type == null { return null; }
            let right_type = this.IsDeferrableExpression(binary->right);
            if right_type == null { return null; }

            if *left_type == *right_type {
                return left_type;
            } else {
                return null;
            }
        } else if node->_type == NodeType::UNARY {
            let unary = node as *UnaryNode;

            if unary->_operator == TokenType::MINUS || unary->_operator == TokenType::NOT {
                return this.IsDeferrableExpression(unary->operand);
            } else {
                return null;
            }
        } else {
            return null;
        }
    }

    fn CompileExpression(&mut this, expression: *Node) -> QualifiedValue {
        return this.CompileExpression(expression, null, false);
    }

    pub fn CompileExpression(&mut this, expression: *Node, target: *QualifiedType, deferred: bool) -> QualifiedValue {
        if !deferred && (expression->_type == NodeType::UNARY || expression->_type == NodeType::BINARY || expression->_type == NodeType::TERNARY) {
            let deferred_type = this.IsDeferrableExpression(expression);

            if deferred_type != null {
                return QualifiedValue(deferred_type, expression);
            }
        }

        if expression->_type == NodeType::LITERAL {
            return this.CompileLiteral(expression as *LiteralNode);
        } else if expression->_type == NodeType::CALL {
            return this.CompileCall(expression as *CallNode);
        } else if expression->_type == NodeType::IDENTIFIER || expression->_type == NodeType::SCOPE_RESOLUTION {
            let symbol = this.scope_manager.Resolve(expression, false);

            if symbol == null {
                return QualifiedValue(null, null);
            }

            if symbol->value.Null() {
                return QualifiedValue(null, null);
            }

            if symbol->kind == SymbolKind::Variant {
                let enum_type = symbol->value.Type();
                let variant_index = LLVMConstIntGetZExtValue(symbol->value.Value());
                let variant_types = enum_type->variants[variant_index as usize].right;

                if variant_types.Size() != 0 {
                    Logger::Log("Variant '" + symbol->name + "' argument count mismatch.", expression, LogSeverity::Error);
                    return QualifiedValue(null, null);
                }

                let current = LLVMGetInsertBlock(this.builder);
                LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
                let pointer = LLVMBuildAlloca(this.builder, enum_type->Value(), "");
                LLVMPositionBuilderAtEnd(this.builder, current);

                let tag_pointer = LLVMBuildStructGEP2(this.builder, enum_type->Value(), pointer, 0, "");
                LLVMBuildStore(this.builder, LLVMConstInt(LLVMInt32TypeInContext(this.context), variant_index, 0), tag_pointer);
                return QualifiedValue(pointer, this.type_manager.Pointer(enum_type, true), true, true);
            } else {
                return symbol->value;
            }
        } else if expression->_type == NodeType::NEW {
            return this.CompileNew(expression as *NewNode);
        } else if expression->_type == NodeType::DELETE {
            return this.CompileDelete(expression as *DeleteNode);
        } else if expression->_type == NodeType::CAST {
            return this.CompileCast(expression as *CastNode);
        } else if expression->_type == NodeType::INDEX_ACCESS {
            return this.CompileIndexAccess(expression as *IndexAccessNode);
        } else if expression->_type == NodeType::MEMBER_ACCESS {
            return this.CompileMemberAccess(expression as *MemberAccessNode);
        } else if expression->_type == NodeType::UNARY {
            return this.CompileUnary(expression as *UnaryNode, target);
        } else if expression->_type == NodeType::BINARY {
            return this.CompileBinary(expression as *BinaryNode, target);
        } else if expression->_type == NodeType::TERNARY {
            return this.CompileTernary(expression as *TernaryNode, target);
        } else if expression->_type == NodeType::STRUCT_INIT {
            return this.CompileStructInit(expression as *StructInitNode);
        } else if expression->_type == NodeType::TYPE_APPLICATION {
            return this.CompileTypeApplication(expression as *TypeApplicationNode);
        } else {
            Logger::Log("Unknown expression '" + expression->_type.ToString() + "'.", expression, LogSeverity::Error);
            return QualifiedValue(null, null);
        }
    }

    fn CompileTypeApplication(&mut this, node: *TypeApplicationNode) -> QualifiedValue {
        let mut types = Vector<*QualifiedType>();

        for _type in node->types {
            types.PushBack(this.CompileType(_type));
        }

        let mut name: String;

        if node->expression->_type == NodeType::IDENTIFIER {
            name = (node->expression as *IdentifierNode)->name;
        } else if node->expression->_type == NodeType::PRIMITIVE_TYPE {
            name = (node->expression as *PrimitiveTypeNode)->name;
        } else {
            Logger::Log("Invalid type application expression.", node, LogSeverity::Error);
            return QualifiedValue(null, null);
        }

        if node->expression->_type == NodeType::IDENTIFIER || node->expression->_type == NodeType::PRIMITIVE_TYPE {
            if this.scope_manager.Has(name, SymbolKind::Generic) {
                let generic = this.scope_manager.Get(name, SymbolKind::Generic)->pointer as *mut Generic;

                if generic->node->_type == NodeType::FUNCTION {
                    return generic->Get(types).left;
                } else {
                    Logger::Log("Generic '" + name + "' is not a function.", node, LogSeverity::Error);
                    return QualifiedValue(null, null);
                }
            } else {
                if this.scope_manager.Has(name) {
                    Logger::Log("Symbol '" + name + "' is not generic.", node, LogSeverity::Error);
                } else {
                    Logger::Log("Symbol '" + name + "' not found.", node, LogSeverity::Error);
                }
                return QualifiedValue(null, null);
            }
        } else if node->expression->_type == NodeType::SCOPE_RESOLUTION {
            let resolution = node->expression as *ScopeResolutionNode;
            let scope = this.scope_manager.ResolveScopeHalf(resolution, true);

            if scope != null {
                let symbol = scope->Get(resolution->identifier->name, SymbolKind::Generic);

                if symbol != null {
                    return (symbol->pointer as *mut Generic)->Get(types).left;
                } else {
                    return QualifiedValue(null, null);
                }
            } else {
                return QualifiedValue(null, null);
            }
        } else {
            Logger::Log("Invalid type application.", node, LogSeverity::Error);
            return QualifiedValue(null, null);
        }
    }

    fn CompileStructInit(&mut this, node: *StructInitNode) -> QualifiedValue {
        let mut variant_name: String;

        if node->expression->_type == NodeType::IDENTIFIER {
            variant_name = (node->expression as *IdentifierNode)->name;
        } else if node->expression->_type == NodeType::SCOPE_RESOLUTION {
            variant_name = (node->expression as *ScopeResolutionNode)->identifier->name;
        } else {
            Logger::Log("Invalid struct init expression.", node, LogSeverity::Error);
            return QualifiedValue(null, null);
        }

        let variant_symbol = this.scope_manager.Resolve(node->expression, false);

        if variant_symbol == null {
            Logger::Log("Unknown variant '" + variant_name + "'.", node, LogSeverity::Error);
            return QualifiedValue(null, null);
        }

        let mut enum_type: *QualifiedType = null;

        if variant_symbol->value.Type().IsPointer() {
            enum_type = variant_symbol->value.Type().Pointee().Return()._type;
        } else {
            enum_type = variant_symbol->value.Type().Pointee();
        }

        let variant_index = this.VariantIndex(enum_type, &variant_name);

        if variant_index == -1 {
            Logger::Log("Unknown enum variant '" + variant_name + "'.", node, LogSeverity::Error);
            return QualifiedValue(null, null);
        }

        let variant_types = enum_type->variants[variant_index as usize].right;

        if node->field_names.Size() != variant_types.Size() {
            Logger::Log("Struct init field count does not match enum variant.", node, LogSeverity::Error);
            return QualifiedValue(null, null);
        }

        let mut ordered_args = Vector<QualifiedValue>();

        for _ in variant_types {
            ordered_args.PushBack(QualifiedValue(null, null));
        }

        let mut index: usize = 0;

        for field_name in node->field_names {
            let field_index = this.VariantFieldIndex(enum_type, variant_index as usize, field_name);

            if field_index == -1 {
                Logger::Log("Unknown field '" + field_name + "' for variant '" + variant_name + "'.", node, LogSeverity::Error);
                return QualifiedValue(null, null);
            }

            let value = this.CompileExpression(node->field_values[index]).MaterializeWithFallback(variant_types[field_index as usize]).ToRValue();

            if !value.Null() {
                ordered_args[field_index as usize] = value;
            } else {
                return QualifiedValue(null, null);
            } index += 1;
        } index = 0;

        let tag_type = LLVMInt32TypeInContext(this.context);
        let struct_type = enum_type->Value();
        let data_type = LLVMStructGetTypeAtIndex(struct_type, 1);
        let mut alloca = LLVMBuildAlloca(this.builder, struct_type, "");
        let tag_pointer = LLVMBuildStructGEP2(this.builder, struct_type, alloca, 0, "");
        LLVMBuildStore(this.builder, LLVMConstInt(tag_type, variant_index as u64, 0), tag_pointer);

        let data_pointer = LLVMBuildStructGEP2(this.builder, struct_type, alloca, 1, "");
        let payload_type = this.CreateVariantPayloadType(variant_types);
        let payload_pointer = LLVMBuildBitCast(this.builder, data_pointer, LLVMPointerType(payload_type, 0), "");

        for _ in variant_types {
            let element_pointer = LLVMBuildStructGEP2(this.builder, payload_type, payload_pointer, index as u32, "");
            LLVMBuildStore(this.builder, ordered_args[index].Value(), element_pointer);
            index += 1;
        }

        return QualifiedValue(LLVMBuildLoad2(this.builder, struct_type, alloca, ""), enum_type);
    }

    fn CompileLiteral(&mut this, literal: *LiteralNode) -> QualifiedValue {
        if literal->_type == TokenType::INTEGER {
            let (mut signed, mut base: u64) = (false, 10);
            let (mut value, mut suffix) = (String(), String());
            let negative = literal->value[0] == '-';
            let mut i: usize = (negative ? 1 : 0);
            let mut state = false;

            while i < literal->value.Length() {
                if !state {
                    if i == (negative ? 1 : 0) && literal->value[i] == '0' && (literal->value[i + 1] == 'x' || literal->value[i + 1] == 'o' || literal->value[i + 1] == 'b') {
                        if base == 10 {
                            base = literal->value[i + 1] == 'x' ? 16 : (literal->value[i + 1] == 'o' ? 8 : 2);
                        } else {
                            Logger::Log("Invalid integer literal '" + literal->value + "'.", literal, LogSeverity::Error);
                            return QualifiedValue(null, null);
                        } i += 1;
                    } else if literal->value[i] == 'u' || literal->value[i] == 'i' {
                        (state, signed) = (true, literal->value[i] == 'i');
                    } else {
                        value += literal->value[i];
                    }
                } else {
                    suffix += literal->value[i];
                } i += 1;
            }

            let result = QualifiedValue(this.type_manager.IntegerLiteral(), value.ToUnsignedInteger(base), negative, base != 10);

            if state {
                if suffix == "size" {
                    return result.Materialize(this.type_manager.IntegerPointer(signed));
                } else {
                    let width = suffix.ToInteger() as u32;

                    if width == 128 || width == 64 || width == 32 || width == 16 || width == 8 {
                        return result.Materialize(this.type_manager.Integer(width, signed));
                    } else {
                        Logger::Log("Invalid integer suffix '" + (signed ? 'u' : 'i').ToString() + suffix +  "'.", literal, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }
                }
            } else {
                return result;
            }
        } else if literal->_type == TokenType::FLOAT {
            let mut value = String();
            let mut suffix = String();
            let mut state = false;

            for character in literal->value {
                if !state {
                    if character == 'f' {
                        state = true;
                    } else {
                        value += character;
                    }
                } else {
                    suffix += character;
                }
            }

            let result = QualifiedValue(this.type_manager.FloatLiteral(), value.ToFloat());

            if state {
                let width = suffix.ToInteger() as u32;

                if width == 64 || width == 32 {
                    return result.Materialize(this.type_manager.Float(width));
                } else {
                    Logger::Log("Invalid float suffix 'f" + suffix +  "'.", literal, LogSeverity::Error);
                    return QualifiedValue(null, null);
                }
            } else {
                return result;
            }
        } else if literal->_type == TokenType::TRUE || literal->_type == TokenType::FALSE {
            let _type = this.type_manager.Boolean();
            return QualifiedValue(LLVMConstInt(_type->Value(), literal->_type == TokenType::TRUE ? 1 : 0, 0), _type);
        } else if literal->_type == TokenType::STRING {
            let value = LLVMBuildGlobalStringPtr(this.builder, literal->value.Data(), "");
            return QualifiedValue(value, this.type_manager.Pointer(this.type_manager.Integer(8, true), false));
        } else if literal->_type == TokenType::CHAR {
            if (literal->value.Size() == 2 && literal->value[1] == '\0') || (literal->value.Size() == 1 && literal->value[0] == '\0') {
                let character: i8 = literal->value[0];
                let _type = this.type_manager.Integer(8, true);
                return QualifiedValue(LLVMConstInt(_type->Value(), character as u64, 0), _type);
            } else {
                Logger::Log("Invalid character literal '" + literal->value + "'.", literal, LogSeverity::Error);
                return QualifiedValue(null, null);
            }
        } else if literal->_type == TokenType::NULL {
            let _type = this.type_manager.NullPointer();
            return QualifiedValue(LLVMConstNull(_type->Value()), _type);
        } else {
            Logger::Log("Unknown literal type '" + literal->_type.ToString() + "'.", literal, LogSeverity::Error);
            return QualifiedValue(null, null);
        }
    }

    fn CompileCall(&mut this, call: *CallNode) -> QualifiedValue {
        if call->expression->_type == NodeType::IDENTIFIER {
            let identifier = call->expression as *IdentifierNode;

            if identifier->name == "sizeof" || identifier->name == "alignof" {
                if call->arguments.Size() != 1 {
                    Logger::Log("Invalid number of arguments for '" + identifier->name + "'.", call, LogSeverity::Error);
                    return QualifiedValue(null, null);
                }

                let mut _type: *QualifiedType;
                let arg = call->arguments[0];

                if arg->_type == NodeType::IDENTIFIER || arg->_type == NodeType::SCOPE_RESOLUTION {
                    let symbol = this.scope_manager.Resolve(arg, false);

                    if symbol->kind == SymbolKind::Variable || symbol->kind == SymbolKind::GlobalVariable || symbol->kind == SymbolKind::Constant || symbol->kind == SymbolKind::Parameter {
                        if symbol->kind == SymbolKind::Constant {
                            _type = symbol->value.Type();
                        } else {
                            _type = symbol->value.Type().Pointee();
                        }
                    } else if symbol->kind == SymbolKind::Function {
                        _type = symbol->value.Type();
                    } else {
                        Logger::Log("Invalid symbol kind '" + symbol->kind.ToString() + "'.", arg, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }
                } else {
                    _type = this.CompileType(arg);
                }

                let mut value: u64;

                if identifier->name == "sizeof" {
                    value = LLVMABISizeOfType(this.target->layout, _type->Value());
                } else {
                    value = LLVMABIAlignmentOfType(this.target->layout, _type->Value()) as u64;
                }

                let result_type = this.type_manager.IntegerPointer(false);
                return QualifiedValue(LLVMConstInt(result_type->Value(), value, 0), result_type);
            } else if identifier->name == "construct" {
                if call->arguments.Size() == 0 {
                    Logger::Log("Invalid number of arguments for 'construct'.", call, LogSeverity::Error);
                    return QualifiedValue(null, null);
                }

                let mut target_pointer = this.CompileExpression(call->arguments[0]).ToRValue();

                if target_pointer.Null() {
                    return QualifiedValue(null, null);
                }

                if target_pointer.Type().IsReference() {
                    target_pointer = QualifiedValue(LLVMBuildLoad2(this.builder, target_pointer.Type().Pointee().Value(), target_pointer.Value(), ""), target_pointer.Type().Pointee());
                }

                if !target_pointer.Type().IsPointer() {
                    Logger::Log("Construct target must be a pointer.", call, LogSeverity::Error);
                    return QualifiedValue(null, null);
                }

                let target = target_pointer.Type().Pointee();
                let mut values = Vector<QualifiedValue>();

                for i in 1..call->arguments.Size() {
                    if !this.CompileArgument(call->arguments[i], &mut values) {
                        return QualifiedValue(null, null);
                    }
                }

                if target.HasFields() {
                    this.CompileConstructor(target, target_pointer, values, call);
                } else {
                    if values.Size() > 1 {
                        Logger::Log("Primitive type initialization accepts at most 1 argument.", call, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }

                    if values.Size() != 0 {
                        let mut value = values[0];

                        if value.Type().IsReference() {
                            if value.Type().Pointee() == target {
                                value = QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
                            }
                        }

                        if target.IsCompatible(value.Type()) {
                            if target.IsMutabilityCompatible(value.Type()) {
                                LLVMBuildStore(this.builder, value.MakeCompatible(target).Value(), target_pointer.Value());
                            } else {
                                Logger::Log("Cannot assign immutable pointer to mutable pointer.", call, LogSeverity::Error);
                                return QualifiedValue(null, null);
                            }
                        } else {
                            Logger::Log("Incompatible primitive type initialization types. ('" + target.ToString() + "' != '" + value.Type().ToString() + "').", call, LogSeverity::Error);
                            return QualifiedValue(null, null);
                        }
                    }
                } return target_pointer;
            } else if identifier->name == "destruct" {
                if call->arguments.Size() != 1 {
                    Logger::Log("Invalid number of arguments for 'destruct'.", call, LogSeverity::Error);
                    return QualifiedValue(null, null);
                }

                let mut target_pointer = this.CompileExpression(call->arguments[0]).ToRValue();

                if target_pointer.Null() {
                    return QualifiedValue(null, null);
                }

                if target_pointer.Type().IsReference() {
                    target_pointer = QualifiedValue(LLVMBuildLoad2(this.builder, target_pointer.Type().Pointee().Value(), target_pointer.Value(), ""), target_pointer.Type().Pointee());
                }

                if !target_pointer.Type().IsPointer() {
                    Logger::Log("Destruct target must be a pointer.", call, LogSeverity::Error);
                    return QualifiedValue(null, null);
                }

                if target_pointer.Type().Pointee().HasFields() {
                    this.CompileDestructor(target_pointer.Type().Pointee(), target_pointer, call);
                }

                return QualifiedValue(null, null);
            }
        }

        let mut values = Vector<QualifiedValue>();

        for argument in call->arguments {
            if !this.CompileArgument(argument, &mut values) {
                return QualifiedValue(null, null);
            }
        }

        if call->expression->_type == NodeType::MEMBER_ACCESS {
            let member_access = call->expression as *MemberAccessNode;
            let mut instance = this.CompileExpression(member_access->expression);
            if instance.Null() { return QualifiedValue(null, null); }
            let mut state = false;

            if instance.Type().IsPointer() {
                if instance.Type().Pointee().IsReference() {
                    instance = QualifiedValue(LLVMBuildLoad2(this.builder, instance.Type().Pointee().Value(), instance.Value(), ""), instance.Type().Pointee(), false, instance.IsLValue());
                }

                if member_access->arrow && instance.Type().Pointee().HasMethods() {
                    let method_name = "operator->".ToString();
                    let param_types = Vector<*QualifiedType>();
                    let values = Vector<QualifiedValue>();

                    if instance.Type().Pointee().Has(method_name, param_types) {
                        let method = instance.Type().Pointee().Get(method_name, param_types, member_access);
                        instance = this.CompileResolvedCall(QualifiedValue(method->left.value, method->right, instance), values, false, member_access);
                    }
                } else if instance.IsLValue() || instance.Type().IsReference() {
                    if member_access->arrow {
                        instance = QualifiedValue(LLVMBuildLoad2(this.builder, instance.Type().Pointee().Value(), instance.Value(), ""), instance.Type().Pointee(), false, instance.IsLValue());
                    }
                } else {
                    if !member_access->arrow && !instance._return && instance.Type().IsPointer() && (instance.Type().Pointee().HasFields() || instance.Type().Pointee().HasMethods()) {
                        Logger::Log("Expected an arrow operator.", call, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }
                }

                if !instance.Type().IsPointer() {
                    state = true;
                } else {
                    if !instance.Type().Pointee().HasFields() && !instance.Type().Pointee().HasMethods() {
                        state = true;
                    }
                }
            } else {
                state = true;
            }

            if state {
                if member_access->arrow {
                    Logger::Log("Expected a dot operator.", call, LogSeverity::Error);
                    return QualifiedValue(null, null);
                }

                values.Insert(0, instance);
                let symbol = this.scope_manager.Resolve(member_access->member, this.ValueToType(values), call, false);

                if symbol != null {
                    return this.CompileResolvedCall(symbol->value, values, false, call);
                } else {
                    return QualifiedValue(null, null);
                }
            } else {
                let mut _state = true;
                let index = instance.Type().Pointee().HasFields() ? instance.Type().Pointee().Index(member_access->member) : -1;
                if this._class != null { _state = *this._class != instance.Type().Pointee(); }

                if index != -1 {
                    let field = instance.Type().Pointee().Fields()[member_access->member];

                    if !field.public && _state {
                        Logger::Log("Field '" + member_access->member + "' is private.", call, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }

                    let field_pointer = LLVMBuildStructGEP2(this.builder, instance.Type().Pointee().Value(), instance.Value(), index as u32, "");
                    return this.CompileResolvedCall(QualifiedValue(LLVMBuildLoad2(this.builder, field._type->Value(), field_pointer, ""), field._type), values, false, call);
                } else {
                    let method = instance.Type().Pointee().Get(member_access->member, this.ValueToType(values), call);

                    if method != null {
                        return this.CompileResolvedCall(QualifiedValue(method->left.value, method->right, instance), values, false, call);
                    } else {
                        return QualifiedValue(null, null);
                    }
                }
            }
        } else if call->expression->_type == NodeType::TYPE_APPLICATION || call->expression->_type == NodeType::PRIMITIVE_TYPE {
            if call->expression->_type == NodeType::TYPE_APPLICATION {
                let type_application = call->expression as *TypeApplicationNode;
                let mut types = Vector<*QualifiedType>();

                for _type in type_application->types {
                    types.PushBack(this.CompileType(_type));
                }

                if type_application->expression->_type == NodeType::PRIMITIVE_TYPE {
                    let primitive_type = type_application->expression as *PrimitiveTypeNode;

                    if this.scope_manager.Has(primitive_type->name, SymbolKind::Generic) {
                        let generic = this.scope_manager.Get(primitive_type->name, SymbolKind::Generic)->pointer as *mut Generic;

                        if generic->node->_type == NodeType::FUNCTION {
                            return this.CompileResolvedCall(generic->Get(types).left, values, false, call);
                        }
                    } else {
                        if this.scope_manager.Has(primitive_type->name) {
                            Logger::Log("Function '" + primitive_type->name + "' is not generic.", call, LogSeverity::Error);
                        } else {
                            Logger::Log("Function '" + primitive_type->name + "' not found.", call, LogSeverity::Error);
                        } return QualifiedValue(null, null);
                    }
                } else if type_application->expression->_type == NodeType::MEMBER_ACCESS {
                    let member_access = type_application->expression as *MemberAccessNode;
                    let mut instance = this.CompileExpression(member_access->expression);
                    if instance.Null() { return QualifiedValue(null, null); }

                    if instance.Type().IsPointer() {
                        if instance.Type().Pointee().IsReference() {
                            instance = QualifiedValue(LLVMBuildLoad2(this.builder, instance.Type().Pointee().Value(), instance.Value(), ""), instance.Type().Pointee(), false, instance.IsLValue());
                        }
                    }

                    if !instance.Type().IsPointer() {
                        Logger::Log("Member access value must be a pointer.", member_access, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }

                    let _class: *QualifiedType = instance.Type().Pointee();

                    if _class->pack_scope != null {
                        let symbol = _class->pack_scope->Get(member_access->member, SymbolKind::Generic);

                        if symbol != null {
                            let mut method = (symbol->pointer as *mut Generic)->Get(types).left;
                            (method.instance, method.instance_type) = (instance.Value(), instance.Type());
                            return this.CompileResolvedCall(method, values, false, call);
                        } else {
                            return QualifiedValue(null, null);
                        }
                    }
                } else if type_application->expression->_type == NodeType::SCOPE_RESOLUTION {
                    let resolution = type_application->expression as *ScopeResolutionNode;
                    let scope = this.scope_manager.ResolveScopeHalf(resolution, true);

                    if scope != null {
                        let symbol = scope->Get(resolution->identifier->name, SymbolKind::Generic);

                        if symbol != null {
                            return this.CompileResolvedCall((symbol->pointer as *mut Generic)->Get(types).left, values, false, call);
                        } else {
                            return QualifiedValue(null, null);
                        }
                    } else {
                        return QualifiedValue(null, null);
                    }
                }
            }

            let _class = this.CompileType(call->expression);
            if _class == null { return QualifiedValue(null, null); }
            let current = LLVMGetInsertBlock(this.builder);
            LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
            let instance = QualifiedValue(LLVMBuildAlloca(this.builder, _class->Value(), ""), this.type_manager.Pointer(_class, true), true, true);
            LLVMPositionBuilderAtEnd(this.builder, current);
            this.CompileConstructor(_class, instance, values, call);
            this.scope_manager.RegisterInstance(instance);
            return instance;
        } else {
            let mut symbol: *Symbol = null;
            let mut state = false;

            if call->expression->_type == NodeType::IDENTIFIER {
                let identifier = call->expression as *IdentifierNode;

                if this.scope_manager.Has(identifier->name, SymbolKind::Variant) {
                    symbol = this.scope_manager.Get(identifier->name, SymbolKind::Variant);
                } else {
                    state = this.scope_manager.Has(identifier->name, SymbolKind::Variable)
                        || this.scope_manager.Has(identifier->name, SymbolKind::Parameter);
                }
            } else if call->expression->_type == NodeType::SCOPE_RESOLUTION {
                let resolution = call->expression as *ScopeResolutionNode;
                let scope = this.scope_manager.ResolveScopeHalf(resolution, false);
                if scope == null { return QualifiedValue(null, null); }

                if scope->Has(resolution->identifier->name, SymbolKind::Variant) {
                    symbol = scope->Get(resolution->identifier->name, SymbolKind::Variant);
                } else {
                    state = scope->Has(resolution->identifier->name, SymbolKind::Variable);
                }
            }

            if !state {
                if symbol != null {
                    let enum_type = symbol->value.Type();
                    let variant_index = LLVMConstIntGetZExtValue(symbol->value.Value());
                    let variant_types = enum_type->variants[variant_index as usize].right;

                    if values.Size() != variant_types.Size() {
                        Logger::Log("Variant '" + symbol->name + "' argument count mismatch.", call, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }

                    for i in 0..values.Size() {
                        if !variant_types[i]->IsCompatible(values[i].ToRValueType()) {
                            Logger::Log("Incompatible argument types for variant '" + symbol->name + "'. ('" + variant_types[i]->ToString() + "' != '" + values[i].ToRValueType().ToString() + "').", call, LogSeverity::Error);
                            return QualifiedValue(null, null);
                        }
                    }

                    let current = LLVMGetInsertBlock(this.builder);
                    LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
                    let pointer = LLVMBuildAlloca(this.builder, enum_type->Value(), "");
                    LLVMPositionBuilderAtEnd(this.builder, current);

                    let tag_pointer = LLVMBuildStructGEP2(this.builder, enum_type->Value(), pointer, 0, "");
                    LLVMBuildStore(this.builder, LLVMConstInt(LLVMInt32TypeInContext(this.context), variant_index, 0), tag_pointer);

                    let payload_type = this.CreateVariantPayloadType(variant_types);
                    let mut payload_pointer = LLVMBuildStructGEP2(this.builder, enum_type->Value(), pointer, 1, "");
                    payload_pointer = LLVMBuildBitCast(this.builder, payload_pointer, LLVMPointerType(payload_type, 0), "");

                    for i in 0..values.Size() {
                        let element_pointer = LLVMBuildStructGEP2(this.builder, payload_type, payload_pointer, i as u32, "");
                        LLVMBuildStore(this.builder, values[i].ToRValue().Value(), element_pointer);
                    }

                    return QualifiedValue(pointer, this.type_manager.Pointer(enum_type, true), true, true);
                } else {
                    symbol = this.scope_manager.Resolve(call->expression, this.ValueToType(values), false);

                    if symbol != null {
                        return this.CompileResolvedCall(symbol->value, values, false, call);
                    } else {
                        return QualifiedValue(null, null);
                    }
                }
            } else {
                let value = this.CompileExpression(call->expression).ToRValue();

                if !value.Null() {
                    return this.CompileResolvedCall(value, values, false, call);
                } else {
                    return QualifiedValue(null, null);
                }
            }
        }
    }

    fn CompilePackSpecialization(&mut this, _func: &QualifiedValue, values: &Vector<QualifiedValue>, node: *Node) -> QualifiedValue {
        let function_type: *QualifiedType = _func.Type().Pointee();
        let declaration = function_type->declaration;

        if declaration == null {
            Logger::Log("Pack function is missing its declaration.", node, LogSeverity::Error);
            return QualifiedValue(null, null);
        }

        let mut pack_generic: *mut Generic = null;
        let mut prev_generic_types = Vector<*QualifiedType>();
        let (prev_specializing, prev_pack_types) = (this.pack_specializing, this.pack_types);
        let (prev_scope, prev_generic, prev_class) = (this.scope_manager.current, this.generic, this._class);
        let mut symbols = Vector<*Symbol>();
        this.pack_types.Clear();

        let mut fixed_count: usize = 0;
        let params = function_type->Parameters();

        if !params.Empty() {
            fixed_count = params.Size();
            if params[0].sret != null { fixed_count -= 1; }
            if _func.instance != null { fixed_count -= 1; }
        }

        for i in fixed_count..values.Size() {
            this.pack_types.PushBack(values[i].ToRValueType());
        }

        if function_type->pack_generic != null {
            pack_generic = function_type->pack_generic;
            pack_generic->types = function_type->pack_generic_types;
            prev_generic_types = pack_generic->types;
            (this.scope_manager.current, this.generic) = (pack_generic->scope, pack_generic);
            let mut index: usize = 0;

            for _type in function_type->pack_generic_types {
                symbols.PushBack(pack_generic->scope->Set(pack_generic->type_names[index], SymbolKind::Type, QualifiedValue(null, _type), false, declaration));
                index += 1;
            }
        } else if function_type->pack_scope != null {
            this.scope_manager.current = function_type->pack_scope;
        }

        if _func.instance_type != null && _func.instance_type->IsPointer() {
            this._class = _func.instance_type->Pointee();
        }

        this.pack_specializing = true;
        let result = this.CompileFunction(declaration, null);
        this.pack_specializing = prev_specializing;
        this.pack_types = prev_pack_types;

        for symbol in symbols {
            let index = pack_generic->scope->symbols.Index(symbol);

            if index != -1 {
                pack_generic->scope->symbols.RemoveAt(index as usize);
                delete symbol;
            }
        }

        if pack_generic != null {
            pack_generic->types = prev_generic_types;
        }

        (this.scope_manager.current, this.generic, this._class) = (prev_scope, prev_generic, prev_class);

        if _func.instance != null {
            return QualifiedValue(result.Value(), result.Type(), QualifiedValue(_func.instance, _func.instance_type));
        } return result;
    }

    fn CompileResolvedCall(&mut this, mut _func: QualifiedValue, values: &Vector<QualifiedValue>, ignore: bool, node: *Node) -> QualifiedValue {
        if _func.Type().Pointee().IsPointer() {
            if _func.Type().Pointee().Pointee().IsFunction() {
                _func = QualifiedValue(LLVMBuildLoad2(this.builder, _func.Type().Pointee().Value(), _func.Value(), ""), _func.Type().Pointee());
            }
        }

        if _func.Type().Pointee().pack_name != "" && !_func.Type().Pointee().IsPackSpecializedFunction() {
            _func = this.CompilePackSpecialization(&_func, values, node);
            if _func.Null() { return QualifiedValue(null, null); }
        }

        let mut args = Vector<LLVMValueRef>();
        let ret_type = _func.Type().Pointee().Return();
        let params = _func.Type().Pointee().Parameters();
        let mut _return: QualifiedValue;

        if !params.Empty() {
            if params[0].sret != null {
                let current = LLVMGetInsertBlock(this.builder);
                LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
                let _pointer = LLVMBuildAlloca(this.builder, params[0].sret->Value(), "");
                _return = QualifiedValue(_pointer, this.type_manager.Pointer(params[0].sret, true), true, true);
                LLVMPositionBuilderAtEnd(this.builder, current);
                args.PushBack(_return.Value());

                if params[0].sret->HasFields() {
                    this.scope_manager.RegisterInstance(_return);
                }
            }
        }

        if _func.instance != null {
            let mut param = params[params[0].sret != null ? 1 : 0]._type;

            if param->IsMutable() && !_func.instance_type->IsMutable() && !ignore {
                Logger::Log("Cannot call mutable method '" + _func.Type().Pointee().name + "' on immutable instance.", node, LogSeverity::Error);
                return QualifiedValue(null, null);
            } else {
                args.PushBack(_func.instance);
            }
        }

        let mut i: usize = 0;

        while i < values.Size() {
            let mut value = values[i];
            let mut index = params[0].sret != null ? i + 1 : i;

            if _func.instance != null {
                index += 1;
            }

            if index < params.Size() {
                let param: &ParameterType = params[index];

                if param.byval != null {
                    value = value.Materialize(param.byval);

                    if value.ToRValueType().IsReference() {
                        if value.ToRValueType().Pointee() == *param.byval {
                            value = value.Load(value.IsLValue());
                        }
                    }

                    if !param.byval->IsCompatible(value.ToRValueType()) {
                        Logger::Log("Incompatible argument types for function '" + _func.Type().Pointee().name + "'. ('" + param.byval->ToString() + "' != '" + value.ToRValueType().ToString() + "').", node, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }

                    let mut source = value;

                    if !value._return {
                        value = value.ToRValue();
                        let source_current = LLVMGetInsertBlock(this.builder);
                        LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(source_current)));
                        let source_pointer = LLVMBuildAlloca(this.builder, value.Type().Value(), "");
                        LLVMPositionBuilderAtEnd(this.builder, source_current);
                        LLVMBuildStore(this.builder, value.Value(), source_pointer);
                        source = QualifiedValue(source_pointer, this.type_manager.Pointer(value.Type(), value.Type().IsMutable()), true);
                    }

                    let mut _params = Vector<QualifiedValue>();
                    _params.PushBack(source);
                    let current = LLVMGetInsertBlock(this.builder);
                    LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
                    let pointer = LLVMBuildAlloca(this.builder, source.Type().Pointee().Value(), "");
                    LLVMPositionBuilderAtEnd(this.builder, current);
                    value = QualifiedValue(pointer, source.Type());

                    if value.Type().Pointee().HasFields() {
                        this.CompileConstructor(value.Type().Pointee(), value, _params, node);
                    } else {
                        LLVMBuildStore(this.builder, LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), _params[0].Value(), ""), value.Value());
                    }

                    if !param._type->IsPointer() {
                        args.PushBack(LLVMBuildLoad2(this.builder, param._type->Value(), value.Value(), ""));
                    } else {
                        args.PushBack(value.Value());
                    }
                } else {
                    value = value.Materialize(param._type);
                    let mut state = false;

                    if param._type->IsReference() {
                        if param._type->Pointee().IsCompatible(value.ToRValueType()) {
                            state = true;
                        }
                    }

                    if !state {
                        value = value.ToRValue();
                    }

                    if value.Type().IsReference() {
                        if *param._type == value.Type().Pointee() {
                            value = value.Load();
                        }
                    }

                    if !param._type->IsCompatible(value.Type()) {
                        Logger::Log("Incompatible argument types for function '" + _func.Type().Pointee().name + "'. ('" + param._type->ToString() + "' != '" + value.Type().ToString() + "').", node, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }

                    if !param._type->IsMutabilityCompatible(value.Type()) {
                        Logger::Log("Cannot assign immutable pointer to mutable pointer.", node, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }

                    args.PushBack(value.MakeCompatible(param._type).Value());
                }
            } else {
                value = value.ToRValue();

                if value.Type().IsReference() {
                    value = value.Load();
                } args.PushBack(value.Value());
            } i += 1;
        }

        let value = LLVMBuildCall2(this.builder, _func.Type().Pointee().Value(), _func.Value(), args.Data(), args.Size() as u32, "");
        LLVMSetInstructionCallConv(value, LLVMGetFunctionCallConv(_func.Value()));

        if ret_type.sret != null {
            let current = LLVMGetInsertBlock(this.builder);
            LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
            let _pointer = LLVMBuildAlloca(this.builder, ret_type.sret->Value(), "");
            _return = QualifiedValue(_pointer, this.type_manager.Pointer(ret_type.sret, true), true, true);
            LLVMPositionBuilderAtEnd(this.builder, current);
            LLVMBuildStore(this.builder, value, LLVMBuildBitCast(this.builder, _pointer, LLVMPointerType(ret_type._type->Value(), 0), ""));

            if ret_type.sret->HasFields() {
                this.scope_manager.RegisterInstance(_return);
            }
        }

        if _return.Null() {
            return QualifiedValue(value, ret_type._type);
        } else {
            return _return;
        }
    }

    fn CompileIndexAccess(&mut this, index_access: *IndexAccessNode) -> QualifiedValue {
        let mut value = this.CompileExpression(index_access->expression).ToRValue();

        if value.Null() {
            return QualifiedValue(null, null);
        }

        if value.Type().IsReference() {
            value = QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
        }

        if value.Type().HasMethods() {
            let mut index = this.CompileExpression(index_access->index);

            if index.Null() {
                return QualifiedValue(null, null);
            }

            let mut params = Vector<QualifiedValue>();
            params.PushBack(index);

            value = this.CompileExpression(index_access->expression);

            if value.Null() {
                return QualifiedValue(null, null);
            }

            if value.Type().Pointee().IsReference() {
                value = QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
            }

            let method = value.Type().Pointee().Get(String("operator[]"), this.ValueToType(params), index_access);

            if method != null {
                return this.CompileResolvedCall(QualifiedValue(method->left.value, method->right, value), params, false, index_access);
            } else {
                return QualifiedValue(null, null);
            }
        }

        let mut index = this.CompileExpression(index_access->index).MaterializeWithFallback(this.type_manager.IntegerPointer(false));

        if index.Null() {
            return QualifiedValue(null, null);
        }

        if !value.Type().IsPointer() {
            Logger::Log("Indexed value must be a pointer.", index_access, LogSeverity::Error);
            return QualifiedValue(null, null);
        }

        index = index.ToRValue();

        if !index.Type().IsIntegerPointer() || index.Type().IsSigned() {
            Logger::Log("Index must be of type 'usize'.", index_access, LogSeverity::Error);
            return QualifiedValue(null, null);
        }

        let indices[]: LLVMValueRef = { index.Value() };
        let target_pointer = LLVMBuildGEP2(this.builder, value.Type().Pointee().Value(), value.Value(), indices, 1, "");
        return QualifiedValue(target_pointer, this.type_manager.Reference(value.Type().Pointee(), value.Type().IsMutable()));
    }

    fn CompileMemberAccess(&mut this, member_access: *MemberAccessNode) -> QualifiedValue {
        let mut instance = this.CompileExpression(member_access->expression);

        if instance.Null() {
            return QualifiedValue(null, null);
        }

        if instance.Type().IsPointer() {
            if instance.Type().Pointee().IsReference() {
                instance = QualifiedValue(LLVMBuildLoad2(this.builder, instance.Type().Pointee().Value(), instance.Value(), ""), instance.Type().Pointee(), false, instance.IsLValue());
            }

            if member_access->arrow && instance.Type().Pointee().HasMethods() {
                let method_name = "operator->".ToString();
                let param_types = Vector<*QualifiedType>();
                let values = Vector<QualifiedValue>();

                if instance.Type().Pointee().Has(method_name, param_types) {
                    let method = instance.Type().Pointee().Get(method_name, param_types, member_access);
                    instance = this.CompileResolvedCall(QualifiedValue(method->left.value, method->right, instance), values, false, member_access);
                }
            } else if instance.IsLValue() || instance.Type().IsReference() {
                if member_access->arrow {
                    instance = QualifiedValue(LLVMBuildLoad2(this.builder, instance.Type().Pointee().Value(), instance.Value(), ""), instance.Type().Pointee(), false, instance.IsLValue());
                }
            } else {
                if !member_access->arrow && !instance._return {
                    Logger::Log("Expected an arrow operator.", member_access, LogSeverity::Error);
                    return QualifiedValue(null, null);
                }
            }
        }

        if !instance.Type().IsPointer() {
            Logger::Log("Member access value must be a pointer.", member_access, LogSeverity::Error);
            return QualifiedValue(null, null);
        }

        if !instance.Type().Pointee().HasFields() && !instance.Type().Pointee().HasMethods() {
            Logger::Log("Cannot access member '" + member_access->member + "' of non-class type.", member_access, LogSeverity::Error);
            return QualifiedValue(null, null);
        }

        let mut state = true;
        let index = instance.Type().Pointee().HasFields() ? instance.Type().Pointee().Index(member_access->member) : -1;
        if this._class != null { state = *this._class != instance.Type().Pointee(); }

        if index != -1 {
            let field = instance.Type().Pointee().Fields()[member_access->member];

            if !field.public && state {
                Logger::Log("Field '" + member_access->member + "' is private.", member_access, LogSeverity::Error);
                return QualifiedValue(null, null);
            }

            let field_pointer = LLVMBuildStructGEP2(this.builder, instance.Type().Pointee().Value(), instance.Value(), index as u32, "");
            return QualifiedValue(field_pointer, this.type_manager.Pointer(field._type, instance.Type().IsMutable()), true);
        } else {
            let method = instance.Type().Pointee().Get(member_access->member, member_access);

            if method != null {
                return QualifiedValue(method->left.value, method->right, instance);
            } else {
                return QualifiedValue(null, null);
            }
        }
    }

    fn CompileNew(&mut this, _new: *NewNode) -> QualifiedValue {
        let _type = this.CompileType(_new->_type);
        if _type == null { return QualifiedValue(null, null); }
        let mut pointer: LLVMValueRef = null;

        if _new->size != null {
            let size = this.CompileExpression(_new->size).MaterializeWithFallback(this.type_manager.IntegerPointer(false)).ToRValue();

            if size.Null() {
                return QualifiedValue(null, null);
            }

            if !size.Type().IsIntegerPointer() || size.Type().IsSigned() {
                Logger::Log("Array size must be of type 'usize'.", _new, LogSeverity::Error);
                return QualifiedValue(null, null);
            }

            let size_type = LLVMIntPtrTypeInContext(this.context, this.target->layout);
            let mut _size = LLVMConstInt(size_type, LLVMABISizeOfType(this.target->layout, _type->Value()), 0);
            _size = LLVMBuildAdd(this.builder, LLVMBuildMul(this.builder, _size, size.Value(), ""), LLVMConstInt(size_type, 8, 0), "");
            pointer = LLVMBuildArrayMalloc(this.builder, LLVMInt8TypeInContext(this.context), _size, "");
            LLVMBuildStore(this.builder, size.Value(), LLVMBuildBitCast(this.builder, pointer, LLVMPointerType(size_type, 0), ""));

            let indices[]: LLVMValueRef = { LLVMConstInt(size_type, 8, 0) };
            pointer = LLVMBuildGEP2(this.builder, LLVMInt8TypeInContext(this.context), pointer, indices, 1, "");
            pointer = LLVMBuildBitCast(this.builder, pointer, LLVMPointerType(_type->Value(), 0), "");

            if _type->HasFields() {
                let value = LLVMBuildAlloca(this.builder, size_type, "");
                LLVMBuildStore(this.builder, LLVMConstInt(size_type, 0, 0), value);

                let function = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
                let compare_block = LLVMAppendBasicBlockInContext(this.context, function, "");
                let loop_block = LLVMAppendBasicBlockInContext(this.context, function, "");
                let end_block = LLVMAppendBasicBlockInContext(this.context, function, "");

                LLVMBuildBr(this.builder, compare_block);
                LLVMPositionBuilderAtStart(this.builder, compare_block);
                let index = LLVMBuildLoad2(this.builder, size_type, value, "");
                LLVMBuildCondBr(this.builder, LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntULT, index, size.Value(), ""), loop_block, end_block);

                let params = Vector<QualifiedValue>();
                let indices[]: LLVMValueRef = { index };
                LLVMPositionBuilderAtStart(this.builder, loop_block);
                this.CompileConstructor(_type, QualifiedValue(LLVMBuildGEP2(this.builder, _type->Value(), pointer, indices, 1, ""), this.type_manager.Pointer(_type, true)), params, _new);
                LLVMBuildStore(this.builder, LLVMBuildAdd(this.builder, index, LLVMConstInt(size_type, 1, 0), ""), value);
                LLVMBuildBr(this.builder, compare_block);
                LLVMPositionBuilderAtStart(this.builder, end_block);
            }
        } else {
            pointer = LLVMBuildMalloc(this.builder, _type->Value(), "");

            if _new->initialized {
                let mut values = Vector<QualifiedValue>();

                for argument in _new->arguments {
                    if !this.CompileArgument(argument, &mut values) {
                        return QualifiedValue(null, null);
                    }
                }

                if _type->HasFields() {
                    this.CompileConstructor(_type, QualifiedValue(pointer, this.type_manager.Pointer(_type, true)), values, _new);
                } else {
                    if values.Size() != 1 {
                        Logger::Log("Primitive type initialization requires exactly 1 argument.", _new, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }

                    let value = values[0];

                    if _type->IsCompatible(value.Type()) {
                        if _type->IsMutabilityCompatible(value.Type()) {
                            LLVMBuildStore(this.builder, value.MakeCompatible(_type).Value(), pointer);
                        } else {
                            Logger::Log("Cannot assign immutable pointer to mutable pointer.", _new, LogSeverity::Error);
                            return QualifiedValue(null, null);
                        }
                    } else {
                        Logger::Log("Incompatible primitive type initialization types. ('" + _type->ToString() + "' != '" + value.Type().ToString() + "').", _new, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }
                }
            }
        }

        return QualifiedValue(pointer, this.type_manager.Pointer(_type, true));
    }

    fn CompileDelete(&mut this, _delete: *DeleteNode) -> QualifiedValue {
        let mut pointer = this.CompileExpression(_delete->expression).ToRValue();

        if pointer.Null() {
            return QualifiedValue(null, null);
        }

        if pointer.Type().IsReference() {
            pointer = QualifiedValue(LLVMBuildLoad2(this.builder, pointer.Type().Pointee().Value(), pointer.Value(), ""), pointer.Type().Pointee());
        }

        if !pointer.Type().IsPointer() {
            Logger::Log("Delete value must be a pointer.", _delete, LogSeverity::Error);
            return QualifiedValue(null, null);
        }

        let mut _pointer = pointer.Value();

        if !pointer.Type().Pointee().IsInteger() || pointer.Type().Pointee().Width() != 8 {
            _pointer = LLVMBuildBitCast(this.builder, _pointer, LLVMPointerType(LLVMInt8TypeInContext(this.context), 0), "");
        }

        if _delete->array {
            let size_type = LLVMIntPtrTypeInContext(this.context, this.target->layout);
            let indices[]: LLVMValueRef = { LLVMConstInt(size_type, -8 as u64, 0) };
            _pointer = LLVMBuildGEP2(this.builder, LLVMInt8TypeInContext(this.context), _pointer, indices, 1, "");

            if pointer.Type().Pointee().HasFields() {
                let count = LLVMBuildLoad2(this.builder, size_type, LLVMBuildBitCast(this.builder, _pointer, LLVMPointerType(size_type, 0), ""), "");

                let value = LLVMBuildAlloca(this.builder, size_type, "");
                LLVMBuildStore(this.builder, LLVMConstInt(size_type, 0, 0), value);

                let function = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
                let compare_block = LLVMAppendBasicBlockInContext(this.context, function, "");
                let loop_block = LLVMAppendBasicBlockInContext(this.context, function, "");
                let end_block = LLVMAppendBasicBlockInContext(this.context, function, "");

                LLVMBuildBr(this.builder, compare_block);
                LLVMPositionBuilderAtStart(this.builder, compare_block);
                let index = LLVMBuildLoad2(this.builder, size_type, value, "");
                LLVMBuildCondBr(this.builder, LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntULT, index, count, ""), loop_block, end_block);

                let indices[]: LLVMValueRef = { index };
                LLVMPositionBuilderAtStart(this.builder, loop_block);
                this.CompileDestructor(pointer.Type().Pointee(), QualifiedValue(LLVMBuildGEP2(this.builder, pointer.Type().Pointee().Value(), pointer.Value(), indices, 1, ""), pointer.Type()), _delete);
                LLVMBuildStore(this.builder, LLVMBuildAdd(this.builder, index, LLVMConstInt(size_type, 1, 0), ""), value);
                LLVMBuildBr(this.builder, compare_block);
                LLVMPositionBuilderAtStart(this.builder, end_block);
            }
        } else {
            if pointer.Type().Pointee().HasFields() {
                this.CompileDestructor(pointer.Type().Pointee(), pointer, _delete);
            }
        }

        LLVMBuildFree(this.builder, _pointer);
        return QualifiedValue(null, null);
    }

    fn CompileCast(&mut this, cast: *CastNode) -> QualifiedValue {
        let mut target = this.CompileType(cast->target_type);

        if target == null {
            return QualifiedValue(null, null);
        }

        let value = this.CompileExpression(cast->expression).MaterializeWithFallback(target).ToRValue();

        if value.Null() {
            return QualifiedValue(null, null);
        }

        if value.Type() == *target && this.LiteralNeedsExplicitType(cast->expression, target) {
            return value;
        }

        return this.CompileResolvedCast(value, target, cast);
    }

    fn CompileResolvedCast(&mut this, mut value: QualifiedValue, target: &QualifiedType, node: *Node) -> QualifiedValue {
        if value.Type().IsReference() && !target.IsPointer() {
            value = QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
        }

        let mut left: *QualifiedType = target;
        let mut right: *QualifiedType = value.Type();
        let (mut state, mut failed) = (false, false);

        while left->IsPointer() && right->IsPointer() {
            if left->IsMutable() != right->IsMutable() {
                if left->IsMutable() && !right->IsNullPointer() {
                    failed = true;
                } state = true;
            }

            (left, right) = (left->Pointee(), right->Pointee());
        }

        if value.Type() == target {
            if !state {
                Logger::Log("Redundant cast. ('" + value.Type().ToString() + "' to '" + target.ToString() + "')", node, LogSeverity::Warning);
            } else {
                if !failed || this._unsafe {
                    return QualifiedValue(value.Value(), target);
                } else {
                    Logger::Log("Cannot cast immutable pointer to mutable pointer.", node, LogSeverity::Error);
                    return QualifiedValue(null, null);
                }
            }
        }

        if value.Type().IsBoolean() {
            if target.IsInteger() {
                return QualifiedValue(LLVMBuildZExt(this.builder, value.Value(), target.Value(), ""), target);
            }
        } else if value.Type().IsCharacter() {
            if target.IsInteger() {
                if value.Type().Width() < target.Width() {
                    return QualifiedValue(LLVMBuildZExt(this.builder, value.Value(), target.Value(), ""), target);
                } else if value.Type().Width() > target.Width() {
                    return QualifiedValue(LLVMBuildTrunc(this.builder, value.Value(), target.Value(), ""), target);
                } else {
                    return QualifiedValue(value.Value(), target);
                }
            }
        } else if value.Type().IsInteger() {
            if target.IsCharacter() {
                if value.Type().Width() == 8 && !value.Type().IsSigned() {
                    return QualifiedValue(LLVMBuildZExt(this.builder, value.Value(), target.Value(), ""), target);
                }
            }

            if target.IsInteger() || target.IsEnumeration() {
                if value.Type().Width() < target.Width() {
                    if value.Type().IsSigned() {
                        return QualifiedValue(LLVMBuildSExt(this.builder, value.Value(), target.Value(), ""), target);
                    } else {
                        return QualifiedValue(LLVMBuildZExt(this.builder, value.Value(), target.Value(), ""), target);
                    }
                } else if value.Type().Width() > target.Width() {
                    return QualifiedValue(LLVMBuildTrunc(this.builder, value.Value(), target.Value(), ""), target);
                } else {
                    return QualifiedValue(value.Value(), target);
                }
            }

            if target.IsFloat() {
                if value.Type().IsSigned() {
                    return QualifiedValue(LLVMBuildSIToFP(this.builder, value.Value(), target.Value(), ""), target);
                } else {
                    return QualifiedValue(LLVMBuildUIToFP(this.builder, value.Value(), target.Value(), ""), target);
                }
            }

            if target.IsPointer() {
                return QualifiedValue(LLVMBuildIntToPtr(this.builder, value.Value(), target.Value(), ""), target);
            }
        } else if value.Type().IsFloat() {
            if target.IsInteger() {
                if target.IsSigned() {
                    return QualifiedValue(LLVMBuildFPToSI(this.builder, value.Value(), target.Value(), ""), target);
                } else {
                    return QualifiedValue(LLVMBuildFPToUI(this.builder, value.Value(), target.Value(), ""), target);
                }
            }

            if target.IsFloat() {
                if value.Type().Width() < target.Width() {
                    return QualifiedValue(LLVMBuildFPExt(this.builder, value.Value(), target.Value(), ""), target);
                } else if value.Type().Width() > target.Width() {
                    return QualifiedValue(LLVMBuildFPTrunc(this.builder, value.Value(), target.Value(), ""), target);
                }
            }
        } else if value.Type().IsPointer() {
            if target.IsInteger() {
                return QualifiedValue(LLVMBuildPtrToInt(this.builder, value.Value(), target.Value(), ""), target);
            }
        } else if value.Type().IsEnumeration() {
            if target.IsInteger() {
                if value.Type().Width() < target.Width() {
                    if value.Type().IsSigned() {
                        return QualifiedValue(LLVMBuildSExt(this.builder, value.Value(), target.Value(), ""), target);
                    } else {
                        return QualifiedValue(LLVMBuildZExt(this.builder, value.Value(), target.Value(), ""), target);
                    }
                } else if value.Type().Width() > target.Width() {
                    return QualifiedValue(LLVMBuildTrunc(this.builder, value.Value(), target.Value(), ""), target);
                } else {
                    return QualifiedValue(value.Value(), target);
                }
            }
        }

        if value.Type().IsPointer() && target.IsPointer() {
            let mut pointer = value.Value();

            if value.Type().Pointee().IsClass() && target.Pointee().IsClass() {
                let (value_class, target_class) = (value.Type().Pointee(), target.Pointee());
                let (value_fields, target_fields) = (value_class.Fields(), target_class.Fields());
                let (mut related, mut index: u32, mut i: usize, mut j: usize) = (false, 0, 0, 0);

                while value_fields.Size() > i && !related {
                    if value_fields[i].left == target_class.name {
                        (related, index) = (true, i as u32);
                        break;
                    } i += 1;
                }

                while target_fields.Size() > j && !related {
                    if target_fields[j].left == value_class.name {
                        (related, index) = (true, -(j as isize) as u32);
                        break;
                    } j += 1;
                }

                if !related {
                    Logger::Log("Cannot cast class '" + value_class.name + "' to unrelated class '" + target_class.name + "'.", node, LogSeverity::Error);
                    return QualifiedValue(null, null);
                }

                if index != 0 {
                    pointer = LLVMBuildStructGEP2(this.builder, value.Type().Pointee().Value(), value.Value(), index, "");
                }
            }

            return QualifiedValue(LLVMBuildBitCast(this.builder, pointer, target.Value(), ""), target, false, value.IsLValue());
        } else {
            Logger::Log("Cannot cast '" + value.Type().ToString() + "' to '" + target.ToString() + "'.", node, LogSeverity::Error);
            return QualifiedValue(null, null);
        }
    }

    fn CompileUnary(&mut this, unary: *UnaryNode, target: *QualifiedType) -> QualifiedValue {
        if unary->_operator == TokenType::BITWISE_AND {
            let pointer = this.CompileExpression(unary->operand);

            if pointer.Null() {
                return QualifiedValue(null, null);
            }

            let mut method_name = "operator".ToString();
            method_name += unary->_operator.ToUnaryOperatorString();

            let mut values = Vector<QualifiedValue>();
            values.PushBack(pointer);

            let symbol = this.scope_manager.Resolve(method_name, this.ValueToType(values), unary, true);

            if symbol != null {
                return this.CompileResolvedCall(symbol->value, values, false, unary);
            }

            if pointer.Type().Pointee().HasMethods() {
                let param_types = Vector<*QualifiedType>();
                let values = Vector<QualifiedValue>();

                if pointer.Type().Pointee().Has(method_name, param_types) {
                    let method = pointer.Type().Pointee().Get(method_name, param_types, unary);
                    return this.CompileResolvedCall(QualifiedValue(method->left.value, method->right, pointer), values, false, unary);
                }
            }

            if unary->mutable && !pointer.Type().IsMutable() {
                Logger::Log("Cannot take mutable reference to immutable value of type '" + pointer.Type().Pointee().ToString() + "'.", unary, LogSeverity::Error);
                return QualifiedValue(null, null);
            }

            return QualifiedValue(pointer.Value(), this.type_manager.Copy(pointer.Type(), unary->mutable));
        } else {
            let mut operand_target: *QualifiedType = null;

            if target != null {
                if unary->_operator == TokenType::MINUS {
                    if target->IsFloat() || (target->IsInteger() && target->IsSigned()) {
                        operand_target = target;
                    }
                } else if unary->_operator == TokenType::TILDE || unary->_operator == TokenType::NOT {
                    operand_target = target;
                }
            }

            let mut value = this.CompileExpression(unary->operand);

            if operand_target != null {
                value = value.MaterializeWithFallback(operand_target);
            } else {
                value = value.Materialize();
            }

            if value.Null() {
                return QualifiedValue(null, null);
            }

            if value.IsLValue() {
                if value.Type().Pointee().IsReference() {
                    value = value.Load(true);
                }

                let mut method_name = "operator".ToString();
                method_name += unary->_operator.ToUnaryOperatorString();

                let mut values = Vector<QualifiedValue>();
                values.PushBack(value);

                let symbol = this.scope_manager.Resolve(method_name, this.ValueToType(values), unary, true);

                if symbol != null {
                    return this.CompileResolvedCall(symbol->value, values, false, unary);
                }

                if value.Type().Pointee().HasMethods() {
                    let param_types = Vector<*QualifiedType>();
                    let values = Vector<QualifiedValue>();

                    if value.Type().Pointee().Has(method_name, param_types) {
                        let method = value.Type().Pointee().Get(method_name, param_types, unary);
                        return this.CompileResolvedCall(QualifiedValue(method->left.value, method->right, value), values, false, unary);
                    }
                }
            } else if value.Type().IsReference() {
                value = value.Load();
            }

            if unary->_operator == TokenType::MUL {
                if value.Type().IsPointer() {
                    if value.IsLValue() {
                        return value.Load(true);
                    } else {
                        return value.MakeLValue();
                    }
                } else {
                    Logger::Log("Cannot dereference non-pointer type '" + value.Type().ToString() + "'.", unary, LogSeverity::Error);
                    return QualifiedValue(null, null);
                }
            }

            value = value.ToRValue();

            if value.Type().IsReference() {
                value = value.Load();
            }

            if unary->_operator == TokenType::MINUS {
                if value.Type().IsInteger() {
                    if value.Type().IsSigned() {
                        return QualifiedValue(LLVMBuildNeg(this.builder, value.Value(), ""), value.Type());
                    } else {
                        Logger::Log("Cannot negate unsigned type '" + value.Type().ToString() + "'.", unary, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }
                } else if value.Type().IsFloat() {
                    return QualifiedValue(LLVMBuildFNeg(this.builder, value.Value(), ""), value.Type());
                } else {
                    Logger::Log("Cannot negate type '" + value.Type().ToString() + "'.", unary, LogSeverity::Error);
                    return QualifiedValue(null, null);
                }
            } else if unary->_operator == TokenType::NOT {
                if value.Type().IsInteger() || value.Type().IsBoolean() {
                    return QualifiedValue(LLVMBuildNot(this.builder, value.Value(), ""), value.Type());
                } else {
                    Logger::Log("Cannot invert type '" + value.Type().ToString() + "'.", unary, LogSeverity::Error);
                    return QualifiedValue(null, null);
                }
            } else {
                Logger::Log("Invalid unary operation '" + unary->_operator.ToString() + "'.", unary, LogSeverity::Error);
                return QualifiedValue(null, null);
            }
        }
    }

    fn CompileBinary(&mut this, binary: *BinaryNode, target: *QualifiedType) -> QualifiedValue {
        let mut operand_target: *QualifiedType = null;

        if target != null && binary->_operator != TokenType::EQUAL && binary->_operator != TokenType::NOT_EQUAL && binary->_operator != TokenType::GREATER && binary->_operator != TokenType::LESS && binary->_operator != TokenType::GREATER_EQUAL && binary->_operator != TokenType::LESS_EQUAL && binary->_operator != TokenType::AND && binary->_operator != TokenType::OR {
            if target->IsInteger() || target->IsFloat() || target->IsBoolean() {
                operand_target = target;
            }
        }

        let mut left = this.CompileExpression(binary->left);

        if operand_target != null {
            left = left.Materialize(operand_target);
        }
        
        if left.Null() {
            return QualifiedValue(null, null);
        }

        if binary->_operator == TokenType::AND || binary->_operator == TokenType::OR {
            left = left.Materialize().ToRValue();

            if !left.Type().IsBoolean() {
                Logger::Log("Invalid type '" + left.Type().ToString() + "' for binary operation '" + binary->_operator.ToString() + "'.", binary, LogSeverity::Error);
                return QualifiedValue(null, null);
            }

            let function = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
            let mut right_block = LLVMAppendBasicBlockInContext(this.context, function, "");
            let merge_block = LLVMAppendBasicBlockInContext(this.context, function, "");
            let left_block = LLVMGetInsertBlock(this.builder);

            if binary->_operator == TokenType::AND {
                LLVMBuildCondBr(this.builder, left.Value(), right_block, merge_block);
            } else {
                LLVMBuildCondBr(this.builder, left.Value(), merge_block, right_block);
            }

            LLVMPositionBuilderAtEnd(this.builder, right_block);
            this.scope_manager.PushScope(String("short circuit"), false);
            let right = this.CompileExpression(binary->right).Materialize().ToRValue();
            this.scope_manager.PopScope();
            if right.Null() { return QualifiedValue(null, null); }
            right_block = LLVMGetInsertBlock(this.builder);
            LLVMBuildBr(this.builder, merge_block);

            if !right.Type().IsBoolean() {
                Logger::Log("Invalid type '" + right.Type().ToString() + "' for binary operation '" + binary->_operator.ToString() + "'.", binary, LogSeverity::Error);
                return QualifiedValue(null, null);
            }

            LLVMPositionBuilderAtEnd(this.builder, merge_block);
            let phi = LLVMBuildPhi(this.builder, left.Type().Value(), "");
            let incoming_values[]: LLVMValueRef = { left.Value(), right.Value() };
            let incoming_blocks[]: LLVMBasicBlockRef = { left_block, right_block };
            LLVMAddIncoming(phi, incoming_values, incoming_blocks, 2);
            return QualifiedValue(phi, left.Type());
        }

        let mut right: QualifiedValue;
        let mut has_right = false;

        if !left.Type().IsLiteral() {
            right = this.CompileExpression(binary->right).Materialize(left.ToRValueType());
            has_right = true;
        } else if target != null {
            if target->IsInteger() || target->IsFloat() || target->IsBoolean() {
                right = this.CompileExpression(binary->right).Materialize(target);
                has_right = true;
            }
        }

        if !has_right {
            right = this.CompileExpression(binary->right);
        }

        if right.Null() {
            return QualifiedValue(null, null);
        }

        return this.CompileResolvedBinary(left, right, binary->_operator, binary);
    }

    fn CompileResolvedBinary(&mut this, mut left: QualifiedValue, mut right: QualifiedValue, _operator: TokenType, node: *Node) -> QualifiedValue {
        let mut method_name = "operator".ToString();
        method_name += _operator.ToBinaryOperatorString();

        let mut values = Vector<QualifiedValue>();
        values.PushBack(left);
        values.PushBack(right);

        let symbol = this.scope_manager.Resolve(method_name, this.ValueToType(values), node, true);

        if symbol != null {
            return this.CompileResolvedCall(symbol->value, values, false, node);
        } else if left.Type().IsPointer() || right.Type().IsPointer() {
            let (mut left_state, mut right_state) = (false, false);

            if left.IsLValue() {
                if left.Type().Pointee().IsReference() {
                    if left.Type().Pointee().Pointee().HasFields() {
                        left = left.Load(true);
                        left_state = true;
                    }
                } else {
                    left_state = left.Type().Pointee().HasFields();
                }
            } else if left.Type().IsReference() {
                left_state = left.Type().Pointee().HasFields();
            }

            if right.IsLValue() {
                if right.Type().Pointee().IsReference() {
                    if right.Type().Pointee().Pointee().HasFields() {
                        right = right.Load(true);
                        right_state = true;
                    }
                } else {
                    right_state = right.Type().Pointee().HasFields();
                }
            } else if right.Type().IsReference() {
                right_state = right.Type().Pointee().HasFields();
            }

            if left_state || right_state {
                let instance = left_state ? left : right;
                let value = left_state ? right : left;

                let mut values = Vector<QualifiedValue>();
                values.PushBack(value);

                let param_types = this.ValueToType(values);
                let _type = instance.Type().Pointee();

                if _type.Has(method_name, param_types) {
                    let method = _type.Get(method_name, param_types, node);
                    return this.CompileResolvedCall(QualifiedValue(method->left.value, method->right, instance), values, false, node);
                }

                if left.Type() == right.Type() {
                    if _operator != TokenType::EQUAL && _operator != TokenType::NOT_EQUAL {
                        Logger::Log("Invalid binary operation '" + _operator.ToString() + "' for type '" + _type.ToString() + "'.", node, LogSeverity::Error);
                        return QualifiedValue(null, null);
                    }

                    let mut result: LLVMValueRef = null;

                    for field in _type.Fields() {
                        let _left = QualifiedValue(LLVMBuildStructGEP2(this.builder, left.Type().Pointee().Value(), left.Value(), _type.Index(field.left) as u32, ""), this.type_manager.Pointer(field.right._type, left.Type().IsMutable()), true);
                        let _right = QualifiedValue(LLVMBuildStructGEP2(this.builder, right.Type().Pointee().Value(), right.Value(), _type.Index(field.left) as u32, ""), this.type_manager.Pointer(field.right._type, right.Type().IsMutable()), true);
                        let _result = this.CompileResolvedBinary(_left, _right, _operator, node).ToRValue().Value();

                        if result != null {
                            result = LLVMBuildAnd(this.builder, result, _result, "");
                        } else {
                            result = _result;
                        }
                    }

                    if _operator == TokenType::NOT_EQUAL {
                        result = LLVMBuildNot(this.builder, result, "");
                    }

                    return QualifiedValue(result, this.type_manager.Boolean());
                } else {
                    Logger::Log("Incompatible binary operation types. ('" + _type.ToString() + "' != '" + value.Type().ToString() + "').", node, LogSeverity::Error);
                    return QualifiedValue(null, null);
                }
            }
        }

        (left, right) = (left.ToRValue(), right.ToRValue());

        if left.Type().IsReference() {
            left = left.Load();
        }

        if right.Type().IsReference() {
            right = right.Load();
        }

        if left.Type().IsPointer() && right.Type().kind == TypeKind::IntegerLiteral {
            right = right.Materialize(this.type_manager.IntegerPointer(false));
        } else if right.Type().IsPointer() && left.Type().kind == TypeKind::IntegerLiteral {
            left = left.Materialize(this.type_manager.IntegerPointer(false));
        }

        if left.Type().IsLiteral() {
            if !right.Type().IsLiteral() && (right.Type().IsInteger() || right.Type().IsFloat()) {
                left = left.Materialize(right.Type());
            } else {
                left = left.Materialize();
            }
        }

        if right.Type().IsLiteral() {
            if !left.Type().IsLiteral() && (left.Type().IsInteger() || left.Type().IsFloat()) {
                right = right.Materialize(left.Type());
            } else {
                right = right.Materialize();
            }
        }

        if left.Type().IsBoolean() && right.Type().IsBoolean() {
            if _operator == TokenType::AND || _operator == TokenType::BITWISE_AND {
                return QualifiedValue(LLVMBuildAnd(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if _operator == TokenType::OR || _operator == TokenType::BITWISE_OR {
                return QualifiedValue(LLVMBuildOr(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if _operator == TokenType::BITWISE_XOR {
                return QualifiedValue(LLVMBuildXor(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if _operator == TokenType::EQUAL {
                return QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntEQ, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::NOT_EQUAL {
                return QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntNE, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else {
                Logger::Log("Invalid binary operation '" + _operator.ToString() + "' for type '" + left.Type().ToString() + "'.", node, LogSeverity::Error);
                return QualifiedValue(null, null);
            }
        } else if left.Type().IsCharacter() && right.Type().IsCharacter() {
            if _operator == TokenType::EQUAL {
                return QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntEQ, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::NOT_EQUAL {
                return QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntNE, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::GREATER {
                return QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntUGT, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::GREATER_EQUAL {
                return QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntUGE, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::LESS {
                return QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntULT, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::LESS_EQUAL {
                return QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntULE, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else {
                Logger::Log("Invalid binary operation '" + _operator.ToString() + "' for type '" + left.Type().ToString() + "'.", node, LogSeverity::Error);
                return QualifiedValue(null, null);
            }
        } else if left.Type().IsInteger() && right.Type().IsInteger() {
            if left.Type() != right.Type() {
                Logger::Log("Incompatible binary operation types. ('" + left.Type().ToString() + "' != '" + right.Type().ToString() + "').", node, LogSeverity::Error);
                return QualifiedValue(null, null);
            }

            if _operator == TokenType::PLUS {
                return QualifiedValue(LLVMBuildAdd(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if _operator == TokenType::MINUS {
                return QualifiedValue(LLVMBuildSub(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if _operator == TokenType::MUL {
                return QualifiedValue(LLVMBuildMul(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if _operator == TokenType::DIV {
                if left.Type().IsSigned() {
                    return QualifiedValue(LLVMBuildSDiv(this.builder, left.Value(), right.Value(), ""), left.Type());
                } else {
                    return QualifiedValue(LLVMBuildUDiv(this.builder, left.Value(), right.Value(), ""), left.Type());
                }
            } else if _operator == TokenType::MOD {
                if left.Type().IsSigned() {
                    return QualifiedValue(LLVMBuildSRem(this.builder, left.Value(), right.Value(), ""), left.Type());
                } else {
                    return QualifiedValue(LLVMBuildURem(this.builder, left.Value(), right.Value(), ""), left.Type());
                }
            } else if _operator == TokenType::EQUAL {
                return QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntEQ, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::NOT_EQUAL {
                return QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntNE, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::GREATER {
                return QualifiedValue(LLVMBuildICmp(this.builder, left.Type().IsSigned() ? LLVMIntPredicate::LLVMIntSGT : LLVMIntPredicate::LLVMIntUGT, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::GREATER_EQUAL {
                return QualifiedValue(LLVMBuildICmp(this.builder, left.Type().IsSigned() ? LLVMIntPredicate::LLVMIntSGE : LLVMIntPredicate::LLVMIntUGE, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::LESS {
                return QualifiedValue(LLVMBuildICmp(this.builder, left.Type().IsSigned() ? LLVMIntPredicate::LLVMIntSLT : LLVMIntPredicate::LLVMIntULT, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::LESS_EQUAL {
                return QualifiedValue(LLVMBuildICmp(this.builder, left.Type().IsSigned() ? LLVMIntPredicate::LLVMIntSLE : LLVMIntPredicate::LLVMIntULE, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::BITWISE_AND {
                return QualifiedValue(LLVMBuildAnd(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if _operator == TokenType::BITWISE_OR {
                return QualifiedValue(LLVMBuildOr(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if _operator == TokenType::BITWISE_XOR {
                return QualifiedValue(LLVMBuildXor(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if _operator == TokenType::LSHIFT {
                return QualifiedValue(LLVMBuildShl(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if _operator == TokenType::RSHIFT {
                if left.Type().IsSigned() {
                    return QualifiedValue(LLVMBuildAShr(this.builder, left.Value(), right.Value(), ""), left.Type());
                } else {
                    return QualifiedValue(LLVMBuildLShr(this.builder, left.Value(), right.Value(), ""), left.Type());
                }
            } else {
                Logger::Log("Invalid binary operation '" + _operator.ToString() + "' for type '" + left.Type().ToString() + "'.", node, LogSeverity::Error);
                return QualifiedValue(null, null);
            }
        } else if left.Type().IsFloat() && right.Type().IsFloat() {
            if left.Type() != right.Type() {
                Logger::Log("Incompatible binary operation types. ('" + left.Type().ToString() + "' != '" + right.Type().ToString() + "').", node, LogSeverity::Error);
                return QualifiedValue(null, null);
            }

            if _operator == TokenType::PLUS {
                return QualifiedValue(LLVMBuildFAdd(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if _operator == TokenType::MINUS {
                return QualifiedValue(LLVMBuildFSub(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if _operator == TokenType::MUL {
                return QualifiedValue(LLVMBuildFMul(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if _operator == TokenType::DIV {
                return QualifiedValue(LLVMBuildFDiv(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if _operator == TokenType::MOD {
                return QualifiedValue(LLVMBuildFRem(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if _operator == TokenType::EQUAL {
                return QualifiedValue(LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOEQ, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::NOT_EQUAL {
                return QualifiedValue(LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealONE, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::GREATER {
                return QualifiedValue(LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOGT, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::GREATER_EQUAL {
                return QualifiedValue(LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOGE, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::LESS {
                return QualifiedValue(LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOLT, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::LESS_EQUAL {
                return QualifiedValue(LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOLE, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else {
                Logger::Log("Invalid binary operation '" + _operator.ToString() + "' for type '" + left.Type().ToString() + "'.", node, LogSeverity::Error);
                return QualifiedValue(null, null);
            }
        } else if left.Type().IsPointer() && right.Type().IsPointer() {
            if left.Type() != right.Type() && !(left.Type().IsNullPointer() || right.Type().IsNullPointer()) {
                Logger::Log("Incompatible binary operation types. ('" + left.Type().ToString() + "' != '" + right.Type().ToString() + "').", node, LogSeverity::Error);
                return QualifiedValue(null, null);
            }

            if left.Type().IsNullPointer() {
                left = QualifiedValue(LLVMBuildPointerCast(this.builder, left.Value(), right.Type().Value(), ""), right.Type());
            } else if right.Type().IsNullPointer() {
                right = QualifiedValue(LLVMBuildPointerCast(this.builder, right.Value(), left.Type().Value(), ""), left.Type());
            }

            if _operator == TokenType::MINUS {
                return QualifiedValue(LLVMBuildPtrDiff2(this.builder, left.Type().Pointee().Value(), left.Value(), right.Value(), ""), this.type_manager.IntegerPointer(false));
            } else if _operator == TokenType::EQUAL {
                return QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntEQ, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::NOT_EQUAL {
                return QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntNE, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::GREATER {
                return QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntUGT, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::GREATER_EQUAL {
                return QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntUGE, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::LESS {
                return QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntULT, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::LESS_EQUAL {
                return QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntULE, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else {
                Logger::Log("Invalid pointer binary operation '" + _operator.ToString() + "' for type '" + left.Type().ToString() + "'.", node, LogSeverity::Error);
                return QualifiedValue(null, null);
            }
        } else if (left.Type().IsPointer() && right.Type().IsInteger()) || (left.Type().IsInteger() && right.Type().IsPointer()) {
            let pointer = left.Type().IsPointer() ? left : right;
            let index = left.Type().IsPointer() ? right : left;

            if !index.Type().IsIntegerPointer() {
                Logger::Log("Pointer arithmetic requires an operand of pointer-sized type.", node, LogSeverity::Error);
                return QualifiedValue(null, null);
            }

            if _operator == TokenType::PLUS {
                let indices[]: LLVMValueRef = { index.Value() };
                return QualifiedValue(LLVMBuildGEP2(this.builder, pointer.Type().Pointee().Value(), pointer.Value(), indices, 1, ""), pointer.Type());
            } else if _operator == TokenType::MINUS {
                if left.Type().IsInteger() {
                    Logger::Log("Cannot subtract a pointer from an integer.", node, LogSeverity::Error);
                    return QualifiedValue(null, null);
                }

                let indices[]: LLVMValueRef = { LLVMBuildNeg(this.builder, index.Value(), "") };
                return QualifiedValue(LLVMBuildGEP2(this.builder, pointer.Type().Pointee().Value(), pointer.Value(), indices, 1, ""), pointer.Type());
            } else {
                Logger::Log("Invalid pointer binary operation '" + _operator.ToString() + "' for type '" + left.Type().ToString() + "'.", node, LogSeverity::Error);
                return QualifiedValue(null, null);
            }
        } else if left.Type().IsEnumeration() && right.Type().IsEnumeration() {
            if left.Type() != right.Type() {
                Logger::Log("Incompatible binary operation types. ('" + left.Type().ToString() + "' != '" + right.Type().ToString() + "').", node, LogSeverity::Error);
                return QualifiedValue(null, null);
            }

            if _operator == TokenType::EQUAL {
                return QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntEQ, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::NOT_EQUAL {
                return QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntNE, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::GREATER {
                return QualifiedValue(LLVMBuildICmp(this.builder, left.Type().IsSigned() ? LLVMIntPredicate::LLVMIntSGT : LLVMIntPredicate::LLVMIntUGT, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::GREATER_EQUAL {
                return QualifiedValue(LLVMBuildICmp(this.builder, left.Type().IsSigned() ? LLVMIntPredicate::LLVMIntSGE : LLVMIntPredicate::LLVMIntUGE, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::LESS {
                return QualifiedValue(LLVMBuildICmp(this.builder, left.Type().IsSigned() ? LLVMIntPredicate::LLVMIntSLT : LLVMIntPredicate::LLVMIntULT, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::LESS_EQUAL {
                return QualifiedValue(LLVMBuildICmp(this.builder, left.Type().IsSigned() ? LLVMIntPredicate::LLVMIntSLE : LLVMIntPredicate::LLVMIntULE, left.Value(), right.Value(), ""), this.type_manager.Boolean());
            } else if _operator == TokenType::BITWISE_AND {
                return QualifiedValue(LLVMBuildAnd(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if _operator == TokenType::BITWISE_OR {
                return QualifiedValue(LLVMBuildOr(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if _operator == TokenType::BITWISE_XOR {
                return QualifiedValue(LLVMBuildXor(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else {
                Logger::Log("Invalid binary operation '" + _operator.ToString() + "' for type '" + left.Type().ToString() + "'.", node, LogSeverity::Error);
                return QualifiedValue(null, null);
            }
        } else {
            Logger::Log("Invalid type '" + left.Type().ToString() + "' for binary operation '" + _operator.ToString() + "'.", node, LogSeverity::Error);
            return QualifiedValue(null, null);
        }
    }

    fn CompileTernary(&mut this, ternary: *TernaryNode, target: *QualifiedType) -> QualifiedValue {
        let function = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
        let mut then_block = LLVMAppendBasicBlockInContext(this.context, function, "");
        let mut else_block = LLVMAppendBasicBlockInContext(this.context, function, "");
        let merge_block = LLVMAppendBasicBlockInContext(this.context, function, "");
        let condition = this.CompileCondition(ternary->condition);

        if condition != null {
            LLVMBuildCondBr(this.builder, condition, then_block, else_block);
        } else { return QualifiedValue(null, null); }

        LLVMPositionBuilderAtEnd(this.builder, then_block);
        let mut then_value = target != null ? this.CompileExpression(ternary->then).Materialize(target) : this.CompileExpression(ternary->then);
        if then_value.Null() { return QualifiedValue(null, null); }
        then_block = LLVMGetInsertBlock(this.builder);

        LLVMPositionBuilderAtEnd(this.builder, else_block);
        let mut else_value = target != null ? this.CompileExpression(ternary->_else).Materialize(target) : this.CompileExpression(ternary->_else);
        if else_value.Null() { return QualifiedValue(null, null); }
        else_block = LLVMGetInsertBlock(this.builder);

        if target == null {
            if then_value.Type().IsLiteral() {
                let else_type = else_value.ToRValueType();

                if !else_type->IsLiteral() && (else_type->IsInteger() || else_type->IsFloat()) {
                    LLVMPositionBuilderAtEnd(this.builder, then_block);
                    then_value = then_value.Materialize(else_type);
                    then_block = LLVMGetInsertBlock(this.builder);
                }
            } else if else_value.Type().IsLiteral() {
                let then_type = then_value.ToRValueType();

                if then_type->IsInteger() || then_type->IsFloat() {
                    LLVMPositionBuilderAtEnd(this.builder, else_block);
                    else_value = else_value.Materialize(then_type);
                    else_block = LLVMGetInsertBlock(this.builder);
                }
            }
        }

        LLVMPositionBuilderAtEnd(this.builder, else_block);
        else_value = else_value.Materialize();
        if then_value.IsRValue() { else_value = else_value.ToRValue(); }
        else_block = LLVMGetInsertBlock(this.builder);
        LLVMBuildBr(this.builder, merge_block);

        LLVMPositionBuilderAtEnd(this.builder, then_block);
        then_value = then_value.Materialize();
        if else_value.IsRValue() { then_value = then_value.ToRValue(); }
        then_block = LLVMGetInsertBlock(this.builder);
        LLVMBuildBr(this.builder, merge_block);
        let mut state = false;

        if then_value.Type().IsPointer() && else_value.Type().IsPointer() {
            if then_value.Type().IsNullPointer() || else_value.Type().IsNullPointer() {
                state = true;
            }
        }

        if then_value.Type() != else_value.Type() && !state {
            Logger::Log("Incompatible ternary types. ('" + then_value.Type().ToString() + "' != '" + else_value.Type().ToString() + "').", ternary, LogSeverity::Error);
            return QualifiedValue(null, null);
        }

        LLVMPositionBuilderAtEnd(this.builder, merge_block);
        let phi = LLVMBuildPhi(this.builder, then_value.Type().Value(), "");
        let incoming_blocks[]: LLVMBasicBlockRef = { then_block, else_block };
        let incoming_values[]: LLVMValueRef = { then_value.Value(), else_value.Value() };
        LLVMAddIncoming(phi, incoming_values, incoming_blocks, 2);
        return QualifiedValue(phi, then_value.Type(), then_value.IsLValue());
    }

    fn CompileAssembly(&mut this, assembly: *AssemblyNode) {
        if this.scope_manager.current->global {
            if !assembly->inputs.Empty() {
                Logger::Log("Cannot set inputs on module inline assembly.", assembly, LogSeverity::Error);
            }

            if !assembly->outputs.Empty() {
                Logger::Log("Cannot set outputs on module inline assembly.", assembly, LogSeverity::Error);
            }

            if !assembly->clobbers.Empty() {
                Logger::Log("Cannot set clobbers on module inline assembly.", assembly, LogSeverity::Error);
            }

            LLVMSetModuleInlineAsm(this.module, assembly->code.Data());
        } else {
            let mut constraints = String();
            let mut types = Vector<LLVMTypeRef>();
            let mut values = Vector<LLVMValueRef>();
            let mut output: QualifiedValue;

            for _output in assembly->outputs {
                if !constraints.Empty() { constraints += ","; }
                constraints += "={";
                constraints += _output.left;
                constraints += "}";

                if !output.Null() {
                    Logger::Log("Output already set.", _output.right, LogSeverity::Error);
                }

                output = this.CompileExpression(_output.right);
                if output.Null() { return; }
            }


            for input in assembly->inputs {
                if !constraints.Empty() { constraints += ","; }
                constraints += "{";
                constraints += input.left;
                constraints += "}";
                let value = this.CompileExpression(input.right).Materialize().ToRValue();
                if value.Null() { return; }
                types.PushBack(value.Type().Value());
                values.PushBack(value.Value());
            }

            for clobber in assembly->clobbers {
                if !constraints.Empty() { constraints += ","; }
                constraints += "~{";
                constraints += clobber;
                constraints += "}";
            }

            let function_type = LLVMFunctionType(!output.Null() ? output.Type().Pointee().Value() : LLVMVoidTypeInContext(this.context), types.Empty() ? null : types.Data(), types.Size() as u32, 0);
            let inline_asm = LLVMGetInlineAsm(function_type, assembly->code.Data(), assembly->code.Length(), constraints.Data(), constraints.Length(), assembly->_volatile as i32, 0, LLVMInlineAsmDialect::LLVMInlineAsmDialectATT, 0);
            let result = LLVMBuildCall2(this.builder, function_type, inline_asm, values.Empty() ? null : values.Data(), values.Size() as u32, "");

            if !output.Null() {
                LLVMBuildStore(this.builder, result, output.Value());
            }
        }
    }

    pub fn CompileType(&mut this, _type: *Node) -> *QualifiedType {
        if _type->_type == NodeType::PRIMITIVE_TYPE {
            let primitive_type = _type as *PrimitiveTypeNode;

            if primitive_type->name == "void" {
                return this.type_manager.Void();
            } else if primitive_type->name == "bool" {
                return this.type_manager.Boolean();
            } else if primitive_type->name == "char" {
                return this.type_manager.Character();
            } else if primitive_type->name.StartsWith('i') || primitive_type->name.StartsWith('u') {
                let specifier = primitive_type->name.SubString(1);
                let signed = primitive_type->name[0] != 'u';

                if specifier == "size" {
                    return this.type_manager.IntegerPointer(signed);
                } else {
                    let width = specifier.ToUnsignedInteger() as u32;

                    if width != 8 && width != 16 && width != 32 && width != 64 && width != 128 {
                        Logger::Log("Invalid integer type '" + primitive_type->name + "'.", _type, LogSeverity::Error);
                        return null;
                    }

                    return this.type_manager.Integer(width, signed);
                }
            } else if primitive_type->name.StartsWith('f') {
                let width = primitive_type->name.SubString(1).ToUnsignedInteger() as u32;

                if width != 32 && width != 64 {
                    Logger::Log("Invalid float type '" + primitive_type->name + "'.", _type, LogSeverity::Error);
                    return null;
                }

                return this.type_manager.Float(width);
            } else {
                if this.scope_manager.Has(primitive_type->name, SymbolKind::Type) {
                    return this.scope_manager.Get(primitive_type->name, SymbolKind::Type)->value.Type();
                } else if this.scope_manager.Has(primitive_type->name, SymbolKind::Class) {
                    return this.scope_manager.Get(primitive_type->name, SymbolKind::Class)->value.Type();
                } else if this.scope_manager.Has(primitive_type->name, SymbolKind::Generic) {
                    Logger::Log("Generic type '" + primitive_type->name + "' requires parameters.", _type, LogSeverity::Error);
                } else {
                    Logger::Log("Type '" + primitive_type->name + "' not found.", _type, LogSeverity::Error);
                } return null;
            }
        } else if _type->_type == NodeType::TYPE_APPLICATION {
            let type_application = _type as *TypeApplicationNode;
            let mut types = Vector<*QualifiedType>();

            for type_ in type_application->types {
                let __type = this.CompileType(type_);
                if __type == null { return null; }
                types.PushBack(__type);
            }

            if type_application->expression->_type == NodeType::PRIMITIVE_TYPE {
                let primitive_type = type_application->expression as *PrimitiveTypeNode;

                if this.scope_manager.Has(primitive_type->name, SymbolKind::Generic) {
                    return (this.scope_manager.Get(primitive_type->name, SymbolKind::Generic)->pointer as *mut Generic)->Get(types).left.Type();
                } else {
                    if this.scope_manager.Has(primitive_type->name) {
                        Logger::Log("Type '" + primitive_type->name + "' is not generic.", _type, LogSeverity::Error);
                    } else {
                        Logger::Log("Type '" + primitive_type->name + "' not found.", _type, LogSeverity::Error);
                    } return null;
                }
            } else {
                Logger::Log("Invalid type application.", _type, LogSeverity::Error);
                return null;
            }
        } else if _type->_type == NodeType::POINTER_TYPE {
            let pointer_type = _type as *PointerTypeNode;
            let base_type = this.CompileType(pointer_type->base_type);
            if base_type == null { return null; }
            return this.type_manager.Pointer(base_type, pointer_type->mutable);
        } else if _type->_type == NodeType::REFERENCE_TYPE {
            let reference_type = _type as *ReferenceTypeNode;
            let base_type = this.CompileType(reference_type->base_type);
            if base_type == null { return null; }
            return this.type_manager.Reference(base_type, reference_type->mutable);
        } else if _type->_type == NodeType::ARRAY_TYPE {
            let array_type = _type as *ArrayTypeNode;
            let element_type = this.CompileType(array_type->element_type);
            if element_type == null { return null; }

            if array_type->size == null {
                return this.type_manager.Pointer(element_type, element_type->IsMutable());
            } else {
                let size = this.CompileExpression(array_type->size).MaterializeWithFallback(this.type_manager.IntegerPointer(false)).ToRValue();

                if size.Null() {
                    return null;
                }

                if !size.Type().IsIntegerPointer() || size.Type().IsSigned() {
                    Logger::Log("Array size must be of type 'usize'.", _type, LogSeverity::Error);
                    return null;
                }

                return this.type_manager.Array(element_type, LLVMConstIntGetZExtValue(size.Value()) as usize, element_type->IsMutable());
            }
        } else if _type->_type == NodeType::FUNCTION_TYPE {
            let function_type = _type as *FunctionTypeNode;
            let mut return_type = ReturnType(this.CompileType(function_type->return_type));
            if return_type._type == null { return null; }
            let mut param_types = Vector<LLVMTypeRef>();
            let mut params = Vector<ParameterType>();

            if return_type._type->HasFields() {
                let processed_type = this.ProcessType(return_type._type);

                if !processed_type->IsPointer() {
                    (return_type.sret, return_type._type) = (return_type._type, processed_type);
                } else {
                    let mut param_type = ParameterType(processed_type);
                    param_type.sret = return_type._type;
                    return_type._type = this.type_manager.Void();
                    param_types.PushBack(processed_type->Value());
                    params.PushBack(param_type);
                }
            }

            for parameter in function_type->parameters {
                let real_type = this.CompileType(parameter->_type);
                if real_type == null { return null; }
                let mut param_type = ParameterType(this.ProcessType(real_type));
                if real_type != *param_type._type { param_type.byval = real_type; }
                param_types.PushBack(param_type._type->Value());
                params.PushBack(param_type);
            }

            return this.type_manager.Pointer(this.type_manager.Function(LLVMFunctionType(return_type._type->Value(), param_types.Data(), param_types.Size() as u32, function_type->var_arg ? 1 : 0), params, return_type), false);
        } else {
            Logger::Log("Unknown type '" + _type->_type.ToString() + "'.", _type, LogSeverity::Error);
            return null;
        }
    }
}

static mut compiler: *mut Compiler = null;
