#[include "vendor/llvm-c/Types.zir" : *]

enum LLVMVerifierFailureAction: i32 {
    LLVMAbortProcessAction = 0,
    LLVMPrintMessageAction = 1,
    LLVMReturnStatusAction = 2
}

extern "C" {
    fn LLVMVerifyModule(M: LLVMModuleRef, Action: LLVMVerifierFailureAction, OutMessage: *mut *mut i8) -> LLVMBool;
    fn LLVMVerifyFunction(Fn: LLVMValueRef, Action: LLVMVerifierFailureAction) -> LLVMBool;
    fn LLVMViewFunctionCFG(Fn: LLVMValueRef);
    fn LLVMViewFunctionCFGOnly(Fn: LLVMValueRef);
}
