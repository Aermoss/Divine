    VariableDeclNode(this: &mut VariableDeclNode, name: String, _type: *const ASTNode, initializer: *const ASTNode, mutable: bool, row: u64, column: u64, file: String) : ASTNode(ASTNodeType::VARIABLE_DECL, row, column, file) {
