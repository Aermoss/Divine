include "divio", "divstr", "divvec", "divmap", "divfile", "divstd" : *;

class Preprocessor {
    pub include_paths: Vector<String>,
    priv included_paths: Vector<String>,
    priv current_file: String
} impl {
    priv IsDigit(this: &Preprocessor, character: i8) -> bool {
        ret character >= '0' && character <= '9';
    }

    priv IsHexDigit(this: &Preprocessor, character: i8) -> bool {
        ret (character >= '0' && character <= '9') || (character >= 'a' && character <= 'f') || (character >= 'A' && character <= 'F');
    }

    priv IsBinDigit(this: &Preprocessor, character: i8) -> bool {
        ret character == '0' || character == '1';
    }

    priv IsOctDigit(this: &Preprocessor, character: i8) -> bool {
        ret character >= '0' && character <= '7';
    }

    priv IsAlpha(this: &Preprocessor, character: i8) -> bool {
        ret (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') || character == '_';
    }

    priv IsAlphaNum(this: &Preprocessor, character: i8) -> bool {
        ret this.IsAlpha(character) || this.IsDigit(character);
    }

    pub Process(this: &mut Preprocessor, source: String, file: String) -> String {
        let lines: Vector<String> = source.Split('\n');
        let (mut output: String, mut i: u64) = ("", 0u64);
        this.current_file = file;

        while i < lines.Size() {
            let trimmed: String = lines[i].Trim();

            if trimmed.Size() > 1u64 && trimmed[0u64] == '#' {
                let (bracket_start: i64, bracket_end: i64) = (trimmed.Find('['), trimmed.Find(']'));

                if bracket_start == -1i64 || bracket_end == -1i64 {
                    this.Error((String("Failed to parse directive: '") + trimmed + "'.").Data(), i + 1u64, 0u64);
                }

                let (mut directive: String, mut j: u64) = ("", (bracket_start as u64) + 1u64);

                while j < trimmed.Size() {
                    if !this.IsAlpha(trimmed[j]) {
                        break;
                    } else {
                        directive += trimmed[j];
                    } j += 1u64;
                }

                if directive == "include" {
                    let content: String = trimmed.SubString((bracket_start as u64) + 8u64, (bracket_end - bracket_start - 8i64) as u64);
                    let modules: Vector<String> = content.Trim().Split(',');
                    let mut k: u64 = 0u64;

                    while k < modules.Size() {
                        let (mut found: bool, mut l: u64) = (false, 0u64);
                        let mut module: String = modules[k].Trim();

                        if module.Size() > 2u64 && module[0u64] == '"' && module[module.Size() - 2u64] == '"' {
                            module = module.SubString(1u64, module.Size() - 3u64);
                        } else {
                            this.Error((String("Failed to parse module string: '") + module + "'.").Data(), i + 1u64, 0u64);
                        }

                        while l < this.include_paths.Size() {
                            let mut path: String = this.include_paths[l] + "\\" + module;
                            let mut attributes: DWORD = GetFileAttributesA(path.Data());
                            l += 1u64;

                            if attributes != INVALID_FILE_ATTRIBUTES {
                                found = true;
                            } else {
                                continue;
                            }

                            if (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0u32 {
                                path += "\\Entry.div";
                                attributes = GetFileAttributesA(path.Data());

                                if attributes == INVALID_FILE_ATTRIBUTES || (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0u32 {
                                    this.Error((String("Module '") + module + "' entry point not found.").Data(), i + 1u64, 0u64);
                                }
                            }

                            if this.included_paths.Index(path) != -1i64 {
                                break;
                            }

                            let source: String = ReadFile(path.Data());
                            let previous_file: String = this.current_file;
                            this.current_file = path;
                            output += this.Process(source, path) + "\n";
                            this.current_file = previous_file;
                            this.included_paths.PushBack(path);
                            break;
                        }

                        if found {
                            k += 1u64;
                        } else {
                            this.Error((String("Module '") + module + "' not found.").Data(), i + 1u64, 0u64);
                        }
                    }
                } else {
                    this.Error((String("Unknown directive: '") + directive + "'.").Data(), i + 1u64, 0u64);
                }
            } else {
                output += lines[i] + "\n";
            } i += 1u64;
        } ret output;
    }

    priv Error(this: &mut Preprocessor, message: *const i8, row: u64, column: u64) {
        printf("%s:%llu:%llu: \x1b[31mError:\x1b[0m %s\n", this.current_file.Data(), row, column, message);
        exit(1i32);
    }
};