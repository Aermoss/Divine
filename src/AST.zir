    ASTBinary(&mut this, left: *ASTNode, right: *ASTNode, _operator: TokenType, start: Token) : ASTNode(ASTNodeKind::BINARY, start) {
        (this.left, this.right, this._operator) = (left, right, _operator);
    }
}

class ASTTernary : ASTNode {
    pub condition: *ASTNode,
    pub then: *ASTNode,
    pub _else: *ASTNode;

    ASTTernary(&mut this, condition: *ASTNode, then: *ASTNode, _else: *ASTNode, start: Token) : ASTNode(ASTNodeKind::TERNARY, start) {
        (this.condition, this.then, this._else) = (condition, then, _else);
    }
}

class ASTCall : ASTNode {
    pub expression: *ASTNode,
