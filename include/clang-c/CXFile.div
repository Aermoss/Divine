include "clang-c/CXString.div" : *;

type CXFile = *mut void;

class CXFileUniqueID {
    pub data[3u64]: u64,
};

extern "C" {
    func clang_getFileName(SFile: CXFile) -> CXString;
    func clang_getFileTime(SFile: CXFile) -> i64;
    func clang_getFileUniqueID(file: CXFile, outID: *mut CXFileUniqueID) -> i32;
    func clang_File_isEqual(file1: CXFile, file2: CXFile) -> i32;
    func clang_File_tryGetRealPathName(file: CXFile) -> CXString;
}
