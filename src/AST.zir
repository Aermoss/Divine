    ASTAssignment(&mut this, left: *ASTNode, right: *ASTNode, _operator: TokenType, start: Token) : ASTNode(ASTNodeKind::ASSIGNMENT, start) {
        (this.left, this.right, this._operator) = (left, right, _operator);
    }
}

