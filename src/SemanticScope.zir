#[include "std/str", "std/vec", "src/SemanticSymbol.zir", "src/Value.zir" : *]

class SemanticScope {
    pub parent: *mut SemanticScope,
    pub children: Vector<*SemanticScope>,
    pub symbols: Vector<*SemanticSymbol>,
    pub name: String, pub global: bool;

    SemanticScope(&mut this, parent: *mut SemanticScope, name: &String, global: bool) {
        (this.parent, this.name, this.global) = (parent, name, global);
    }

    ~SemanticScope(&this) {
        for symbol in this.symbols {
            delete symbol;
        }
    }

    pub fn Has(&this, name: &String) -> bool {
        for symbol in this.symbols {
            if symbol->name == name {
                return true;
            }
        } return false;
    }
    
    pub fn Has(&this, name: &String, kind: SemanticSymbolKind) -> bool {
        for symbol in this.symbols {
            if symbol->name == name && symbol->kind == kind {
                return true;
            }
        } return false;
    }

    pub fn Set(&mut this, name: &String, kind: SemanticSymbolKind, value: &SemanticValue, overload: bool, node: *Node) -> *SemanticSymbol {
        if this.Has(name) && !overload {
            Logger::Log("Symbol '" + name + "' already exists.", node, LogSeverity::Error);
            return null;
        } else {
            let symbol: *SemanticSymbol = new SemanticSymbol(name, kind, value);
            this.symbols.PushBack(symbol);
            return symbol;
        }
    }

    pub fn Set(&mut this, name: &String, kind: SemanticSymbolKind, _type: *SemanticType, node: *Node) -> *SemanticSymbol {
        if this.Has(name) {
            Logger::Log("Symbol '" + name + "' already exists.", node, LogSeverity::Error);
            return null;
        } else {
            let symbol: *SemanticSymbol = new SemanticSymbol(name, kind, SemanticValue(_type));
            this.symbols.PushBack(symbol);
            return symbol;
        }
    }

    pub fn Set(&mut this, name: &String, kind: SemanticSymbolKind, generic: *mut SemanticGeneric, node: *Node) -> *SemanticSymbol {
        if this.Has(name) {
            Logger::Log("Symbol '" + name + "' already exists.", node, LogSeverity::Error);
            return null;
        } else {
            let symbol: *SemanticSymbol = new SemanticSymbol(name, kind, generic);
            this.symbols.PushBack(symbol);
            return symbol;
        }
    }

    pub fn Get(&this, name: &String) -> *SemanticSymbol {
        for symbol in this.symbols {
            if symbol->name == name {
                return symbol;
            }
        } return null;
    }

    pub fn Get(&this, name: &String, kind: SemanticSymbolKind) -> *SemanticSymbol {
        for symbol in this.symbols {
            if symbol->name == name && symbol->kind == kind {
                return symbol;
            }
        } return null;
    }

    pub fn GetAll(&this, name: &String) -> Vector<*SemanticSymbol> {
        let mut result = Vector<*SemanticSymbol>();

        for symbol in this.symbols {
            if symbol->name == name {
                result.PushBack(symbol);
            }
        } return result;
    }

    pub fn GetAll(&this, name: &String, kind: SemanticSymbolKind) -> Vector<*SemanticSymbol> {
        let mut result = Vector<*SemanticSymbol>();

        for symbol in this.symbols {
            if symbol->name == name && symbol->kind == kind {
                result.PushBack(symbol);
            }
        } return result;
    }
}
