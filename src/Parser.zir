#[include "std/str", "std/vec", "std/map", "std/pair", "std/arena",
    "src/Logger.zir", "src/Lexer.zir", "src/Preprocessor.zir", "src/Nodes.zir" : *]

class Parser {
    arena: Arena,
    types: Vector<String>,
    tokens: Vector<Token>,
    index: usize;

    fn Current(&this) -> Token {
        if this.index >= this.tokens.Size() {
            return this.tokens[this.tokens.Size() - 1];
        } else {
            return this.tokens[this.index];
        }
    }

    fn Peek(&this, offset: usize) -> Token {
        let index = this.index + offset;

        if index >= this.tokens.Size() {
            return this.tokens[this.tokens.Size() - 1];
        } else {
            return this.tokens[index];
        }
    }

    fn PeekBack(&this, offset: usize) -> Token {
        if offset > this.index {
            return this.tokens[0];
        } else {
            return this.tokens[this.index - offset];
        }
    }

    fn Advance(&mut this) -> Token {
        let token = this.Current();

        if this.index < this.tokens.Size() {
            this.index += 1;
        } return token;
    }

    fn Match(&mut this, _type: TokenType) -> bool {
        if this.Current()._type == _type {
            this.Advance();
            return true;
        } else {
            return false;
        }
    }

    fn Expect(&mut this, _type: TokenType) -> Token {
        let token = this.Current();

        if token._type == _type {
            return this.Advance();
        }

        Logger::Log("Expected '" + _type.ToString() + "' but got '" + token._type.ToString() + "'.", token, LogSeverity::Error);

        let mut error: Token;
        (error._type, error.row, error.column, error.file) = (TokenType::UNKNOWN, token.row, token.column, token.file);
        return error;
    }

    fn ExpectSuccess(&mut this, _type: TokenType) -> bool {
        let token = this.Current();

        if token._type == _type {
            this.Advance();
            return true;
        }

        Logger::Log("Expected '" + _type.ToString() + "' but got '" + token._type.ToString() + "'.", token, LogSeverity::Error);
        return false;
    }

    fn GetBinaryOperatorPrecedence(&this, _type: TokenType) -> i32 {
        if _type == TokenType::OR { return 1; }
        else if _type == TokenType::AND { return 2; }
        else if _type == TokenType::BITWISE_OR { return 3; }
        else if _type == TokenType::BITWISE_XOR { return 4; }
        else if _type == TokenType::BITWISE_AND { return 5; }
        else if _type == TokenType::EQUAL || _type == TokenType::NOT_EQUAL { return 6; }
        else if _type == TokenType::LESS || _type == TokenType::LESS_EQUAL || _type == TokenType::GREATER || _type == TokenType::GREATER_EQUAL { return 7; }
        else if _type == TokenType::LSHIFT || _type == TokenType::RSHIFT { return 8; }
        else if _type == TokenType::PLUS || _type == TokenType::MINUS { return 9; }
        else if _type == TokenType::MUL || _type == TokenType::DIV || _type == TokenType::MOD { return 10; }
        else if _type == TokenType::AS { return 11; }
        else { return -1; }
    }

    fn IsBinaryOperator(&this, _type: TokenType) -> bool {
        let precedence = this.GetBinaryOperatorPrecedence(_type);
        return precedence >= 0 && precedence != 11;
    }

    fn IsUnaryOperator(&this, _type: TokenType) -> bool {
        return _type == TokenType::NOT || _type == TokenType::MINUS || _type == TokenType::BITWISE_AND || _type == TokenType::MUL;
    }

    fn IsStructInit(&this, _type: NodeType) -> bool {
        let after_brace = this.Peek(1);

        if _type == NodeType::SCOPE_RESOLUTION {
            if after_brace._type == TokenType::RBRACE { return true; }
            if after_brace._type == TokenType::TWO_DOT { return true; }
        }

        if after_brace._type == TokenType::IDENTIFIER {
            let after_name = this.Peek(2);
            if after_name._type == TokenType::COLON { return true; }

            if _type == NodeType::SCOPE_RESOLUTION {
                return after_name._type == TokenType::COMMA || after_name._type == TokenType::RBRACE;
            }
        } return false;
    }

    fn IsTypeApplication(&this) -> bool {
        if this.Current()._type != TokenType::LESS { return false; }
        let mut index: usize = 1;
        let mut depth: u64 = 1;

        loop {
            let token = this.Peek(index);
            if token._type == TokenType::EOF { return false; }
            let _type = token._type;
            index += 1;

            if _type == TokenType::LESS {
                let increment: u64 = 1;
                depth += increment;
            } else if _type == TokenType::GREATER {
                if depth >= 1 {
                    let decrement: u64 = 1;
                    depth -= decrement;
                } else {
                    return false;
                }
            } else if _type == TokenType::SEMICOLON || _type == TokenType::LBRACE || _type == TokenType::RBRACE {
                return false;
            } else {
                if _type != TokenType::IDENTIFIER && _type != TokenType::COLON && _type != TokenType::DOUBLE_COLON && _type != TokenType::LPAREN && _type != TokenType::RPAREN
                    && _type != TokenType::MUL && _type != TokenType::BITWISE_AND && _type != TokenType::MUT && _type != TokenType::CONST && _type != TokenType::LBRACKET && _type != TokenType::RBRACKET
                        && _type != TokenType::FUNCTION && _type != TokenType::THREE_DOT && _type != TokenType::ARROW && _type != TokenType::INTEGER && _type != TokenType::COMMA { return false; }

                if _type == TokenType::IDENTIFIER {
                    if !this.types.Contains(token.value) {
                        return false;
                    }
                }
            }

            if depth == 0 {
                let next = this.Peek(index);

                return next._type != TokenType::IDENTIFIER && next._type != TokenType::INTEGER && next._type != TokenType::FLOAT && next._type != TokenType::STRING
                    && next._type != TokenType::CHAR && next._type != TokenType::TRUE && next._type != TokenType::FALSE && next._type != TokenType::NULL;
            }
        } return false;
    }

    fn IsAssignmentOperator(&this, _type: TokenType) -> bool {
        return _type == TokenType::ASSIGN || _type == TokenType::PLUS_ASSIGN || _type == TokenType::MINUS_ASSIGN || _type == TokenType::MUL_ASSIGN || _type == TokenType::DIV_ASSIGN || _type == TokenType::MOD_ASSIGN
           || _type == TokenType::LSHIFT_ASSIGN || _type == TokenType::RSHIFT_ASSIGN || _type == TokenType::AND_ASSIGN || _type == TokenType::OR_ASSIGN || _type == TokenType::XOR_ASSIGN;
    }

    fn ParsePrimary(&mut this) -> *Node {
        let token = this.Current();

        if token._type == TokenType::INTEGER || token._type == TokenType::FLOAT || token._type == TokenType::STRING || token._type == TokenType::CHAR || token._type == TokenType::TRUE || token._type == TokenType::FALSE || token._type == TokenType::NULL {
            this.Advance();
            return this.arena.New<LiteralNode>(token.value, token._type, token);
        } else if token._type == TokenType::IDENTIFIER || token._type == TokenType::THIS || token._type == TokenType::OPERATOR || token._type == TokenType::DOUBLE_COLON {
            let mut node = null;

            if token._type != TokenType::DOUBLE_COLON {
                if this.types.Contains(token.value) {
                    node = this.ParseType();
                    if node == null { return null; }
                } else {
                    if this.Match(TokenType::OPERATOR) {
                        let mut identifier = "operator".ToString();

                        while this.Current()._type != TokenType::LPAREN && this.Current()._type != TokenType::LESS {
                            identifier += this.Current().value;
                            this.Advance();
                        }

                        node = this.arena.New<IdentifierNode>(identifier, token);
                    } else {
                        let identifier = this.Expect(this.Current()._type != TokenType::THIS ? TokenType::IDENTIFIER : TokenType::THIS);
                        if identifier._type == TokenType::UNKNOWN { return null; }
                        node = this.arena.New<IdentifierNode>(identifier.value, token);
                    }
                }
            }

            while this.Match(TokenType::DOUBLE_COLON) {
                let mut identifier: *IdentifierNode = null;

                if this.Match(TokenType::OPERATOR) {
                    let mut _identifier = "operator".ToString();

                    while this.Current()._type != TokenType::LPAREN && this.Current()._type != TokenType::LESS {
                        _identifier += this.Current().value;
                        this.Advance();
                    }

                    identifier = this.arena.New<IdentifierNode>(_identifier, token);
                } else {
                    let _identifier = this.Expect(this.Current()._type != TokenType::THIS ? TokenType::IDENTIFIER : TokenType::THIS);
                    if _identifier._type == TokenType::UNKNOWN { return null; }
                    identifier = this.arena.New<IdentifierNode>(_identifier.value, token);
                } node = this.arena.New<ScopeResolutionNode>(node, identifier, token);
            } return node;
        } else if token._type == TokenType::LBRACE {
            this.Advance();
            let initializer_list = this.arena.New<InitializerListNode>(token);

            if !this.Match(TokenType::RBRACE) {
                let expression = this.ParseExpression();
                if expression == null { return null; }
                initializer_list->expressions.PushBack(expression);

                while this.Match(TokenType::COMMA) {
                    let expression = this.ParseExpression();
                    if expression == null { return null; }
                    initializer_list->expressions.PushBack(expression);
                }

                if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
            } return initializer_list;
        } else if token._type == TokenType::LPAREN {
            this.Advance();
            let mut expression = this.ParseExpression();
            if expression == null { return null; }

            if this.Match(TokenType::COMMA) {
                let tuple = this.arena.New<TupleNode>(token);
                tuple->values.PushBack(expression);

                if !this.Match(TokenType::RPAREN) {
                    while this.Current()._type != TokenType::RPAREN && this.Current()._type != TokenType::EOF {
                        let expression = this.ParseExpression();
                        if expression == null { return null; }
                        tuple->values.PushBack(expression);

                        if !this.Match(TokenType::COMMA) {
                            break;
                        }
                    }
                } expression = tuple;
            }

            if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
            return expression;
        } else {
            this.Advance();
            Logger::Log("Unexpected token '" + token.value + "'.", token, LogSeverity::Error);
            return null;
        }
    }

    fn ParsePostfix(&mut this) -> *Node {
        let mut expression = this.ParsePrimary();
        if expression == null { return null; }

        loop {
            let token = this.Current();

            if token._type == TokenType::LPAREN {
                this.Advance();
                let call = this.arena.New<CallNode>(expression, token);

                if !this.Match(TokenType::RPAREN) {
                    while this.Current()._type != TokenType::RPAREN && this.Current()._type != TokenType::EOF {
                        let expression = this.ParseExpression();
                        if expression == null { return null; }
                        call->arguments.PushBack(expression);

                        if !this.Match(TokenType::COMMA) {
                            break;
                        }
                    }

                    if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
                } expression = call;
            } else if token._type == TokenType::DOT || token._type == TokenType::ARROW {
                this.Advance();
                let member_access = this.arena.New<MemberAccessNode>(expression, token._type == TokenType::ARROW, token);

                if this.Match(TokenType::OPERATOR) {
                    member_access->member += "operator";

                    while this.Current()._type != TokenType::LPAREN && this.Current()._type != TokenType::LESS {
                        member_access->member += this.Current().value;
                        this.Advance();
                    }
                } else {
                    let identifier = this.Expect(TokenType::IDENTIFIER);
                    if identifier._type == TokenType::UNKNOWN { return null; }
                    member_access->member += identifier.value;
                } expression = member_access;
            } else if token._type == TokenType::LBRACKET {
                this.Advance();
                let _expression = this.ParseExpression();
                if _expression == null { return null; }
                expression = this.arena.New<IndexAccessNode>(expression, _expression, token);
                if !this.ExpectSuccess(TokenType::RBRACKET) { return null; }
            } else if token._type == TokenType::LBRACE && (expression->_type == NodeType::SCOPE_RESOLUTION || expression->_type == NodeType::IDENTIFIER) && this.IsStructInit(expression->_type) {
                this.Advance();
                let struct_init = this.arena.New<StructInitNode>(expression, token);

                while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                    if this.Current()._type == TokenType::TWO_DOT {
                        this.Advance();
                        break;
                    }

                    let field_name = this.Expect(TokenType::IDENTIFIER);
                    if field_name._type == TokenType::UNKNOWN { return null; }

                    if this.Match(TokenType::COLON) {
                        let expression = this.ParseExpression();
                        if expression == null { return null; }
                        struct_init->field_values.PushBack(expression);
                    } else {
                        struct_init->field_values.PushBack(this.arena.New<IdentifierNode>(field_name.value, field_name));
                    }

                    struct_init->field_names.PushBack(field_name.value);
                    if !this.Match(TokenType::COMMA) { break; }
                }

                if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
                expression = struct_init;
            } else if token._type == TokenType::THREE_DOT {
                this.Advance();
                expression = this.arena.New<PackSplatNode>(expression, token);
            } else if this.IsTypeApplication() {
                this.Advance();
                let type_application = this.arena.New<TypeApplicationNode>(expression, token);

                while this.Current()._type != TokenType::GREATER {
                    let _type = this.ParseType();
                    if _type == null { return null; }
                    type_application->types.PushBack(_type);
                    if !this.Match(TokenType::COMMA) { break; }
                }

                if !this.ExpectSuccess(TokenType::GREATER) { return null; }
                expression = type_application;
            } else {
                break;
            }
        } return expression;
    }

    fn ParseUnary(&mut this) -> *Node {
        let token = this.Current();
        let mut mutable = false;

        if this.IsUnaryOperator(token._type) {
            this.Advance();

            if token._type == TokenType::BITWISE_AND {
                mutable = this.Match(TokenType::MUT);
            }

            let expression = this.ParseUnary();
            if expression == null { return null; }
            return this.arena.New<UnaryNode>(expression, token._type, mutable, token);
        } else if token._type == TokenType::NEW {
            this.Advance();
            let _type = this.ParseType();
            if _type == null { return null; }
            let _new = this.arena.New<NewNode>(_type, token);

            if this.Match(TokenType::LBRACKET) {
                _new->size = this.ParseExpression();

                if _new->size == null || !this.ExpectSuccess(TokenType::RBRACKET) {
                    return null;
                }
            } else if this.Match(TokenType::LPAREN) {
                _new->initialized = true;

                if !this.Match(TokenType::RPAREN) {
                    while this.Current()._type != TokenType::RPAREN {
                        let argument = this.ParseExpression();
                        if argument == null { return null; }
                        _new->arguments.PushBack(argument);
                        if !this.Match(TokenType::COMMA) { break; }
                    }

                    if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
                }
            } return _new;
        } else if token._type == TokenType::DELETE {
            this.Advance();
            let _delete = this.arena.New<DeleteNode>(token);

            if this.Match(TokenType::LBRACKET) {
                if !this.ExpectSuccess(TokenType::RBRACKET) { return null; }
                _delete->array = true;
            }

            _delete->expression = this.ParseExpression();
            if _delete->expression == null { return null; }
            return _delete;
        } else if token._type == TokenType::AWAIT {
            this.Advance();
            let expression = this.ParseUnary();
            if expression == null { return null; }
            return this.arena.New<AwaitNode>(expression, token);
        } else {
            return this.ParsePostfix();
        }
    }

    fn ParseBinary(&mut this, min_precedence: i32) -> *Node {
        let mut left = this.ParseUnary();
        if left == null { return null; }

        loop {
            let mut token = this.Current();

            if this.Peek(1)._type == token._type {
                if token._type == TokenType::GREATER {
                    token._type = TokenType::RSHIFT;
                    this.Advance();
                }

                if token._type == TokenType::LESS {
                    token._type = TokenType::LSHIFT;
                    this.Advance();
                }
            }

            let precedence = this.GetBinaryOperatorPrecedence(token._type);
            if precedence < min_precedence { break; }
            this.Advance();

            if token._type == TokenType::AS {
                let _type = this.ParseType();
                if _type == null { return null; }
                left = this.arena.New<CastNode>(left, _type, token);
            } else {
                let right = this.ParseBinary(precedence + 1);
                if right == null { return null; }
                left = this.arena.New<BinaryNode>(left, right, token._type, token);
            }
        } return left;
    }

    fn ParseExpression(&mut this) -> *Node {
        let mut expression = this.ParseBinary(0);
        if expression == null { return null; }
        let token = this.Current();

        if token._type == TokenType::QUESTION_MARK {
            this.Advance();
            let then = this.ParseExpression();
            if then == null || !this.ExpectSuccess(TokenType::COLON) { return null; }
            let _else = this.ParseExpression();
            if _else == null { return null; }
            expression = this.arena.New<TernaryNode>(expression, then, _else, token);
        } return expression;
    }

    fn ParseType(&mut this) -> *Node {
        let mut references: Vector<bool>;

        if this.Match(TokenType::BITWISE_AND) {
            references.PushBack(this.Match(TokenType::MUT));
        }

        let mut pointers: Vector<bool>;

        while this.Match(TokenType::MUL) {
            if this.Match(TokenType::MUT) {
                pointers.PushBack(true);
            } else {
                pointers.PushBack(false);
            }
        }

        let token = this.Current();
        let mut node = null;

        if this.Match(TokenType::FUNCTION) {
            if !this.ExpectSuccess(TokenType::LPAREN) { return null; }
            let function_type = this.arena.New<FunctionTypeNode>(token);

            if this.Current()._type != TokenType::RPAREN {
                while this.Current()._type != TokenType::EOF {
                    if this.Peek(1)._type == TokenType::THREE_DOT {
                        let pack_name = this.Expect(TokenType::IDENTIFIER);
                        if pack_name._type == TokenType::UNKNOWN { return null; }
                        function_type->pack_name = pack_name.value;
                        this.Advance();
                        break;
                    }

                    if this.Match(TokenType::THREE_DOT) {
                        function_type->var_arg = true;
                        break;
                    }

                    if (this.Peek(1)._type == TokenType::COLON || this.Peek(1)._type == TokenType::LBRACKET) || (this.Peek(1)._type == TokenType::MUT && (this.Peek(2)._type == TokenType::COLON || this.Peek(2)._type == TokenType::LBRACKET)) {
                        let param = this.ParseParameter();
                        if param == null { return null; }
                        function_type->parameters.PushBack(param);
                    } else {
                        let token = this.Current();
                        let _type = this.ParseType();
                        if _type == null { return null; }
                        function_type->parameters.PushBack(this.arena.New<ParameterNode>(String(""), _type, false, token));
                    }

                    if !this.Match(TokenType::COMMA) {
                        break;
                    }
                }
            }

            if !this.ExpectSuccess(TokenType::RPAREN) { return null; }

            if this.Match(TokenType::ARROW) {
                function_type->return_type = this.ParseType();
                if function_type->return_type == null { return null; }
            } else {
                function_type->return_type = this.arena.New<PrimitiveTypeNode>(String("void"), token);
            } node = function_type;
        } else {
            if token._type != TokenType::IDENTIFIER {
                Logger::Log("Expected type name.", token, LogSeverity::Error);
                return null;
            }

            node = this.arena.New<PrimitiveTypeNode>(token.value, token);
            this.Advance();

            loop {
                if this.Match(TokenType::DOUBLE_COLON) {
                    let identifier = this.Expect(TokenType::IDENTIFIER);
                    if identifier._type == TokenType::UNKNOWN { return null; }
                    node = this.arena.New<ScopeResolutionNode>(node, this.arena.New<IdentifierNode>(identifier.value, identifier), token);
                } else if this.IsTypeApplication() {
                    this.Advance();
                    let type_application = this.arena.New<TypeApplicationNode>(node, token);

                    while this.Current()._type != TokenType::GREATER {
                        let _type = this.ParseType();
                        if _type == null { return null; }
                        type_application->types.PushBack(_type);
                        if !this.Match(TokenType::COMMA) { break; }
                    }

                    if !this.ExpectSuccess(TokenType::GREATER) { return null; }
                    node = type_application;
                } else {
                    break;
                }
            }
        }

        while !pointers.Empty() {
            node = this.arena.New<PointerTypeNode>(node, pointers.PopBack(), token);
        }

        if !references.Empty() {
            node = this.arena.New<ReferenceTypeNode>(node, references[0], token);
        } return node;
    }

    fn ParseStatement(&mut this, expression: bool) -> *Node {
        let token = this.Current();

        if token._type == TokenType::LET && !expression {
            return this.ParseVariable();
        } else if token._type == TokenType::IF && !expression {
            return this.ParseIf();
        } else if token._type == TokenType::WHILE && !expression {
            return this.ParseWhile();
        } else if token._type == TokenType::FOR && !expression {
            return this.ParseFor();
        } else if token._type == TokenType::LOOP && !expression {
            return this.ParseLoop();
        } else if token._type == TokenType::MATCH && !expression {
            return this.ParseMatch();
        } else if token._type == TokenType::UNSAFE && !expression {
            return this.ParseUnsafe();
        } else if (token._type == TokenType::ASSEMBLY || token._type == TokenType::VOLATILE) && !expression {
            return this.ParseAssembly();
        } else if token._type == TokenType::RETURN {
            return this.ParseReturn(expression);
        } else if token._type == TokenType::BREAK {
            return this.ParseBreak(expression);
        } else if token._type == TokenType::CONTINUE {
            return this.ParseContinue(expression);
        } else {
            let index = this.index;

            if this.Match(TokenType::LPAREN) {
                let mut current: *mut AssignmentNode = null;
                let mut root: *mut AssignmentNode = null;

                while root == null || this.Match(TokenType::COMMA) {
                    let _expression = this.ParseExpression();
                    if _expression == null { return null; }
                    let assignment = this.arena.New<AssignmentNode>(_expression, null, TokenType::ASSIGN, token);

                    if root != null {
                        current->next = assignment;
                    } else {
                        root = assignment;
                    } current = assignment;
                }

                if root->next != null {
                    if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
                    if !this.ExpectSuccess(TokenType::ASSIGN) { return null; }
                    if !this.ExpectSuccess(TokenType::LPAREN) { return null; }
                    current = root;

                    while current != null {
                        current->right = this.ParseExpression();
                        if current->right == null { return null; }

                        if current->next != null {
                            if !this.ExpectSuccess(TokenType::COMMA) { return null; }
                        } current = current->next;
                    }

                    if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
                    if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
                    return root;
                } else {
                    this.index = index;
                }
            }

            let left = this.ParseExpression();

            if this.IsAssignmentOperator(this.Current()._type) {
                let token = this.Advance();
                let right = this.ParseExpression();
                if right == null { return null; }
                let assignment = this.arena.New<AssignmentNode>(left, right, token._type, token);

                if !expression {
                    if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
                } return assignment;
            } else {
                if !expression {
                    if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
                }

                return this.arena.New<ExpressionNode>(left, token);
            }
        }
    }

    fn ParseVariable(&mut this) -> *Node {
        let token = this.Expect(TokenType::LET);
        if token._type == TokenType::UNKNOWN { return null; }
        let multiple = this.Match(TokenType::LPAREN);
        let mut current: *mut VariableNode = null;
        let mut root: *mut VariableNode = null;

        while root == null || (multiple && root != null && this.Match(TokenType::COMMA)) {
            let mutable = this.Match(TokenType::MUT);
            let identifier = this.Expect(TokenType::IDENTIFIER);
            if identifier._type == TokenType::UNKNOWN { return null; }
            let mut sizes: Vector<*Node>;

            while this.Match(TokenType::LBRACKET) {
                if this.Match(TokenType::RBRACKET) {
                    sizes.PushBack(null);
                } else {
                    let expression = this.ParseExpression();
                    if expression == null || !this.ExpectSuccess(TokenType::RBRACKET) { return null; }
                    sizes.PushBack(expression);
                }
            }

            let mut _type = null;

            if this.Match(TokenType::COLON) {
                _type = this.ParseType();
                if _type == null { return null; }

                for size in sizes {
                    _type = this.arena.New<ArrayTypeNode>(_type, size, token);
                }
            } else if !sizes.Empty() {
                Logger::Log("Array size specified but type is missing.", token, LogSeverity::Error);
                return null;
            }

            let declaration = this.arena.New<VariableNode>(identifier.value, _type, null, mutable, token);

            if root != null {
                current->next = declaration;
            } else {
                root = declaration;
            } current = declaration;
        }

        if multiple {
            if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
        }

        if this.Match(TokenType::ASSIGN) {
            if multiple {
                if !this.ExpectSuccess(TokenType::LPAREN) { return null; }
            } current = root;

            while current != null {
                current->initializer = this.ParseExpression();
                if current->initializer == null { return null; }

                if current->initializer->_type == NodeType::INITIALIZER_LIST {
                    let list = current->initializer as *InitializerListNode;

                    if current->_type->_type == NodeType::ARRAY_TYPE {
                        let array_type = current->_type as *mut ArrayTypeNode;

                        if array_type->size == null {
                            array_type->size = this.arena.New<LiteralNode>(String::FromInteger(list->expressions.Size() as u64) + "usize", TokenType::INTEGER, token);
                        }
                    }
                }

                if current->next != null {
                    if !this.ExpectSuccess(TokenType::COMMA) { return null; }
                } current = current->next;
            }

            if multiple {
                if !this.ExpectSuccess(TokenType::RPAREN) { return null; }
            }
        }

        if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        return root;
    }

    fn ParseIf(&mut this) -> *Node {
        let token = this.Expect(TokenType::IF);
        if token._type == TokenType::UNKNOWN { return null; }

        if this.Current()._type == TokenType::LET {
            this.Advance();
            let pattern = this.ParsePattern();
            if pattern == null || !this.ExpectSuccess(TokenType::ASSIGN) { return null; }
            let expression = this.ParseExpression();
            if expression == null { return null; }
            let then = this.ParseBlock();
            if then == null { return null; }
            let if_let = this.arena.New<IfLetNode>(pattern, expression, then, token);

            if this.Match(TokenType::ELSE) {
                if this.Current()._type == TokenType::IF {
                    if_let->_else = this.ParseIf();
                } else {
                    if_let->_else = this.ParseBlock();
                }
            } return if_let;
        }

        let condition = this.ParseExpression();
        if condition == null { return null; }
        let then = this.ParseBlock();
        if then == null { return null; }
        let mut _else = null;

        if this.Match(TokenType::ELSE) {
            if this.Current()._type == TokenType::IF {
                _else = this.ParseIf();
            } else {
                _else = this.ParseBlock();
            }
        }

        return this.arena.New<IfNode>(condition, then, _else, token);
    }

    fn ParseWhile(&mut this) -> *Node {
        let token = this.Expect(TokenType::WHILE);
        if token._type == TokenType::UNKNOWN { return null; }

        if this.Current()._type == TokenType::LET {
            this.Advance();
            let pattern = this.ParsePattern();
            if pattern == null || !this.ExpectSuccess(TokenType::ASSIGN) { return null; }
            let expression = this.ParseExpression();
            if expression == null { return null; }
            let _loop = this.ParseBlock();
            if _loop == null { return null; }
            return this.arena.New<WhileLetNode>(pattern, expression, _loop, token);
        }

        let expression = this.ParseExpression();
        if expression == null { return null; }
        let _loop = this.ParseBlock();
        if _loop == null { return null; }
        let mut _else = null;

        if this.Match(TokenType::ELSE) {
            _else = this.ParseBlock();
        }

        return this.arena.New<WhileNode>(expression, _loop, _else, token);
    }

    fn ParseFor(&mut this) -> *Node {
        let token = this.Expect(TokenType::FOR);
        if token._type == TokenType::UNKNOWN { return null; }
        let name = this.Expect(TokenType::IDENTIFIER);
        if name._type == TokenType::UNKNOWN { return null; }
        if !this.ExpectSuccess(TokenType::IN) { return null; }
        let iterable = this.ParseForIterable();
        if iterable == null { return null; }
        let _loop = this.ParseBlock();
        if _loop == null { return null; }
        return this.arena.New<ForNode>(name.value, iterable, _loop, token);
    }

    fn ParseForIterable(&mut this) -> *Node {
        let left = this.ParseBinary(0);
        if left == null { return null; }

        if this.Current()._type == TokenType::TWO_DOT {
            let token = this.Advance();
            let inclusive = this.Match(TokenType::ASSIGN);
            let right = this.ParseBinary(0);
            if right == null { return null; }
            let range = this.arena.New<RangeNode>(left, right, token);
            range->inclusive = inclusive;
            return range;
        } return left;
    }

    fn ParseLoop(&mut this) -> *Node {
        let token = this.Expect(TokenType::LOOP);
        if token._type == TokenType::UNKNOWN { return null; }
        let _loop = this.ParseBlock();
        if _loop == null { return null; }
        return this.arena.New<LoopNode>(_loop, token);
    }

    fn ConvertBitwiseToPattern(&mut this, node: *Node) -> *Node {
        if node->_type != NodeType::BINARY { return node; }
        let binary = node as *BinaryNode;
        if binary->_operator != TokenType::BITWISE_OR { return node; }
        let left = this.ConvertBitwiseToPattern(binary->left);
        let right = this.ConvertBitwiseToPattern(binary->right);
        return this.arena.New<OrPatternNode>(left, right, node->start);
    }

    fn ParsePattern(&mut this) -> *Node {
        return this.ParseSinglePattern();
    }

    fn ParseSinglePattern(&mut this) -> *Node {
        if this.Current()._type == TokenType::IDENTIFIER && this.Current().value == "_" {
            let token = this.Current();
            this.Advance();
            return this.arena.New<IdentifierNode>(String("_"), token);
        }

        let expression = this.ParseExpression();
        if expression == null { return null; }
        let converted = this.ConvertBitwiseToPattern(expression);
        if converted != expression { return converted; }

        if this.Current()._type == TokenType::LBRACE && (expression->_type == NodeType::IDENTIFIER || expression->_type == NodeType::SCOPE_RESOLUTION) {
            let brace_token = this.Current();
            this.Advance();
            let struct_pattern = this.arena.New<StructInitNode>(expression, brace_token);

            while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                if this.Current()._type == TokenType::TWO_DOT {
                    this.Advance();
                    break;
                }

                let field_name = this.Expect(TokenType::IDENTIFIER);
                if field_name._type == TokenType::UNKNOWN { return null; }

                if this.Match(TokenType::COLON) {
                    let pattern = this.ParsePattern();
                    if pattern == null { return null; }
                    struct_pattern->field_values.PushBack(pattern);
                } else {
                    struct_pattern->field_values.PushBack(this.arena.New<IdentifierNode>(field_name.value, field_name));
                }

                struct_pattern->field_names.PushBack(field_name.value);
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
            return struct_pattern;
        } return expression;
    }

    fn ParseMatch(&mut this) -> *Node {
        let token = this.Expect(TokenType::MATCH);
        if token._type == TokenType::UNKNOWN { return null; }
        let expression = this.ParseExpression();
        if expression == null { return null; }
        let match_node = this.arena.New<MatchNode>(expression, token);
        if !this.ExpectSuccess(TokenType::LBRACE) { return null; }

        while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
            let mut pattern = null;

            if this.Current()._type == TokenType::IDENTIFIER && this.Current().value == "_" && this.Peek(1)._type == TokenType::FAT_ARROW {
                this.Advance();
            } else {
                pattern = this.ParsePattern();
                if pattern == null { return null; }
            }

            let mut guard = null;

            if pattern != null && this.Current()._type == TokenType::IF {
                this.Advance();
                guard = this.ParseExpression();
                if guard == null { return null; }
            }

            if !this.ExpectSuccess(TokenType::FAT_ARROW) { break; }
            let mut body = null;

            if this.Current()._type == TokenType::LBRACE {
                body = this.ParseBlock();
                if body == null { return null; }
            } else {
                body = this.ParseStatement(true);
                if body == null { return null; }
            }

            if pattern == null {
                match_node->default = this.arena.New<DefaultNode>(body, token);
            } else {
                match_node->cases.PushBack(this.arena.New<CaseNode>(pattern, body, guard, token));
            }

            if !this.Match(TokenType::COMMA) {
                break;
            }
        }

        if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
        return match_node;
    }

    fn ParseUnsafe(&mut this) -> *Node {
        let token = this.Expect(TokenType::UNSAFE);
        if token._type == TokenType::UNKNOWN { return null; }
        let body = this.ParseBlock();
        if body == null { return null; }
        return this.arena.New<UnsafeNode>(body as *BlockNode, token);
    }

    fn ParseAssembly(&mut this) -> *Node {
        let _volatile = this.Match(TokenType::VOLATILE);
        let token = this.Expect(TokenType::ASSEMBLY);
        if token._type == TokenType::UNKNOWN { return null; }
        let node = this.arena.New<AssemblyNode>(_volatile, token);

        if this.Match(TokenType::COLON) {
            while this.Current()._type == TokenType::IDENTIFIER {
                let register = this.Advance().value;
                if !this.ExpectSuccess(TokenType::LPAREN) { return null; }
                let expression = this.ParseExpression();
                if expression == null || !this.ExpectSuccess(TokenType::RPAREN) { return null; }
                node->inputs.PushBack(Pair<String, *Node>(register, expression));
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.ExpectSuccess(TokenType::ARROW) { return null; }
        }

        let code = this.Expect(TokenType::ASSEMBLY_CODE);
        if code._type == TokenType::UNKNOWN { return null; }
        node->code = code.value;

        if this.Match(TokenType::ARROW) {
            while this.Current()._type == TokenType::IDENTIFIER {
                let register = this.Advance().value;
                if !this.ExpectSuccess(TokenType::LPAREN) { return null; }
                let expression = this.ParseExpression();
                if expression == null || !this.ExpectSuccess(TokenType::RPAREN) { return null; }
                node->outputs.PushBack(Pair<String, *Node>(register, expression));
                if !this.Match(TokenType::COMMA) { break; }
            }
        }

        if this.Match(TokenType::COLON) {
            while this.Current()._type == TokenType::IDENTIFIER {
                node->clobbers.PushBack(this.Advance().value);
                if !this.Match(TokenType::COMMA) { break; }
            }
        }

        if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        return node;
    }

    fn ParseReturn(&mut this, expression: bool) -> *Node {
        let token = this.Expect(TokenType::RETURN);
        if token._type == TokenType::UNKNOWN { return null; }
        let mut value = null;

        if this.Current()._type != TokenType::SEMICOLON {
            value = this.ParseExpression();
            if value == null { return null; }
        }

        if !expression {
            if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        }

        return this.arena.New<ReturnNode>(value, token);
    }

    fn ParseBreak(&mut this, expression: bool) -> *Node {
        let token = this.Expect(TokenType::BREAK);
        if token._type == TokenType::UNKNOWN { return null; }

        if !expression {
            if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        }

        return this.arena.New<BreakNode>(token);
    }

    fn ParseContinue(&mut this, expression: bool) -> *Node {
        let token = this.Expect(TokenType::CONTINUE);
        if token._type == TokenType::UNKNOWN { return null; }

        if !expression {
            if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        }

        return this.arena.New<ContinueNode>(token);
    }

    fn ParseBlock(&mut this) -> *Node {
        let token = this.Expect(TokenType::LBRACE);
        if token._type == TokenType::UNKNOWN { return null; }
        let block = this.arena.New<BlockNode>(token);

        while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
            let statement = this.ParseStatement(false);

            if statement != null {
                block->statements.PushBack(statement);
            } else {
                while this.Current()._type != TokenType::EOF && this.Current()._type != TokenType::RBRACE {
                    let _type = this.Current()._type;

                    if _type == TokenType::SEMICOLON {
                        this.Advance();
                        break;
                    }

                    if _type == TokenType::LET || _type == TokenType::IF || _type == TokenType::WHILE || _type == TokenType::FOR || _type == TokenType::LOOP || _type == TokenType::MATCH || _type == TokenType::RETURN || _type == TokenType::BREAK || _type == TokenType::CONTINUE || _type == TokenType::ASSEMBLY || _type == TokenType::VOLATILE {
                        break;
                    }

                    this.Advance();
                }
            }
        }

        if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
        return block;
    }

    fn SynchronizeDeclaration(&mut this) {
        while this.Current()._type != TokenType::EOF {
            let _type = this.Current()._type;

            if _type == TokenType::FUNCTION || _type == TokenType::CLASS || _type == TokenType::ENUM || _type == TokenType::EXTERN || _type == TokenType::INCLUDE || _type == TokenType::CONST || _type == TokenType::STATIC || _type == TokenType::TYPE || _type == TokenType::ASSEMBLY || _type == TokenType::VOLATILE || _type == TokenType::AT {
                break;
            }

            this.Advance();
        }
    }

    fn ParseAttributes(&mut this) -> Vector<Pair<String, Vector<*Node>>> {
        let mut attributes: Vector<Pair<String, Vector<*Node>>>;

        while this.Match(TokenType::AT) {
            let mut pair: Pair<String, Vector<*Node>>;
            let identifier = this.Expect(TokenType::IDENTIFIER);
            if identifier._type == TokenType::UNKNOWN { return attributes; }
            pair.left = identifier.value;

            if this.Match(TokenType::LPAREN) {
                if !this.Match(TokenType::RPAREN) {
                    while this.Current()._type != TokenType::RPAREN && this.Current()._type != TokenType::EOF {
                        let expression = this.ParseExpression();
                        if expression == null { return attributes; }
                        pair.right.PushBack(expression);

                        if !this.Match(TokenType::COMMA) {
                            break;
                        }
                    }

                    if !this.ExpectSuccess(TokenType::RPAREN) { return attributes; }
                }
            }

            attributes.PushBack(pair);
        } return attributes;
    }

    fn ParseDeclaration(&mut this) -> *Node {
        let attributes = this.ParseAttributes();
        let token = this.Current();

        if token._type == TokenType::FUNCTION {
            return this.ParseFunction(attributes, false);
        } else if token._type == TokenType::CLASS {
            return this.ParseClass(attributes);
        } else if token._type == TokenType::ENUM {
            return this.ParseEnum(attributes);
        } else if token._type == TokenType::EXTERN {
            return this.ParseExtern();
        } else if token._type == TokenType::CONST {
            return this.ParseConstant();
        } else if token._type == TokenType::STATIC {
            return this.ParseStatic(attributes);
        } else if token._type == TokenType::TYPE {
            return this.ParseTypeDefinition();
        } else if token._type == TokenType::ASSEMBLY || token._type == TokenType::VOLATILE {
            return this.ParseAssembly();
        } else {
            this.Advance();
            Logger::Log("Expected declaration.", token, LogSeverity::Error);
            return null;
        }
    }

    fn ParseFunction(&mut this, attributes: &Vector<Pair<String, Vector<*Node>>>, _class: bool) -> *Node {
        let token = this.Current();
        let mut no_mangle = false;

        for attribute in attributes {
            if attribute.left == "nomangle" {
                if attribute.right.Size() != 0 {
                    Logger::Log("Invalid number of arguments for attribute '" + attribute.left + "'.", token, LogSeverity::Error);
                    return null;
                }

                if no_mangle {
                    Logger::Log("Attribute '" + attribute.left + "' already set.", token, LogSeverity::Error);
                    return null;
                }

                no_mangle = true;
            } else {
                Logger::Log("Invalid attribute '" + attribute.left + "'.", token, LogSeverity::Error);
                return null;
            }
        }

        let mut name = String();

        if !_class {
            if !this.ExpectSuccess(TokenType::FUNCTION) { return null; }
        } else {
            if this.Match(TokenType::TILDE) {
                name += token.value;
                let identifier = this.Expect(TokenType::IDENTIFIER);
                if identifier._type == TokenType::UNKNOWN { return null; }
                name += identifier.value;
            } else if this.Match(TokenType::IDENTIFIER) {
                name += token.value;
            } else if !this.ExpectSuccess(TokenType::FUNCTION) {
                return null;
            }
        }

        if name.Empty() {
            if this.Match(TokenType::OPERATOR) {
                name += "operator";

                while this.Current()._type != TokenType::LPAREN {
                    name += this.Current().value;
                    this.Advance();
                }
            } else {
                let identifier = this.Expect(TokenType::IDENTIFIER);
                if identifier._type == TokenType::UNKNOWN { return null; }
                name += identifier.value;
            }
        }

        let function_type = this.arena.New<FunctionTypeNode>(token);
        let function = this.arena.New<FunctionNode>(name, function_type, no_mangle, token);
        let types = this.types;

        if this.Match(TokenType::LESS) {
            function->generic = true;

            while this.Current()._type != TokenType::GREATER {
                let type_name = this.Expect(TokenType::IDENTIFIER);

                if type_name._type == TokenType::UNKNOWN {
                    this.types = types;
                    return null;
                }

                function->types.PushBack(type_name.value);
                this.types.PushBack(type_name.value);
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.ExpectSuccess(TokenType::GREATER) {
                this.types = types;
                return null;
            }
        }

        if !this.ExpectSuccess(TokenType::LPAREN) {
            this.types = types;
            return null;
        }

        if this.Current()._type != TokenType::RPAREN {
            let mut has_instance = true;

            if this.Match(TokenType::BITWISE_AND) {
                let mutable = this.Match(TokenType::MUT);
                if !this.ExpectSuccess(TokenType::THIS) { this.types = types; return null; }
                function_type->instance_kind = mutable ? InstanceKind::MutRef : InstanceKind::ConstRef;
            } else if this.Match(TokenType::THIS) {
                function_type->instance_kind = InstanceKind::Copy;
            } else {
                has_instance = false;
            }

            if !has_instance || this.Match(TokenType::COMMA) {
                while this.Current()._type != TokenType::EOF {
                    if this.Peek(1)._type == TokenType::THREE_DOT {
                        let pack_name = this.Expect(TokenType::IDENTIFIER);

                        if pack_name._type == TokenType::UNKNOWN {
                            this.types = types;
                            return null;
                        }

                        function_type->pack_name = pack_name.value;
                        this.Advance();
                        break;
                    }

                    if this.Match(TokenType::THREE_DOT) {
                        function_type->var_arg = true;
                        break;
                    }

                    let param = this.ParseParameter();
                    if param == null { this.types = types; return null; }
                    function_type->parameters.PushBack(param);

                    if !this.Match(TokenType::COMMA) {
                        break;
                    }
                }
            }
        }

        if !this.ExpectSuccess(TokenType::RPAREN) {
            this.types = types;
            return null;
        }

        if this.Match(TokenType::ASYNC) {
            function->_async = true;
        }

        if this.Match(TokenType::ARROW) {
            function_type->return_type = this.ParseType();

            if function_type->return_type == null {
                this.types = types;
                return null;
            }
        } else {
            function_type->return_type = this.arena.New<PrimitiveTypeNode>(String("void"), token);

            if token._type != TokenType::FUNCTION && token._type != TokenType::PUBLIC {
                while (this.Match(TokenType::COLON) && function->constructors.Empty()) || (this.Match(TokenType::COMMA) && !function->constructors.Empty()) {
                    let expression = this.ParseExpression();

                    if expression == null {
                        this.types = types;
                        return null;
                    }

                    if expression->_type == NodeType::CALL {
                        function->constructors.PushBack(expression as *CallNode);
                    } else {
                        Logger::Log("Expected a function call.", token, LogSeverity::Error);
                        break;
                    }
                }
            }
        }

        if this.Current()._type == TokenType::LBRACE {
            let body = this.ParseBlock();
            this.types = types;
            if body == null { return null; }
            function->body = body as *BlockNode;
        } else {
            this.types = types;
            if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        } return function;
    }

    fn ParseParameter(&mut this) -> *ParameterNode {
        let mutable = this.Match(TokenType::MUT);
        let token = this.Expect(TokenType::IDENTIFIER);
        if token._type == TokenType::UNKNOWN { return null; }
        let mut sizes: Vector<*Node>;

        while this.Match(TokenType::LBRACKET) {
            if this.Match(TokenType::RBRACKET) {
                sizes.PushBack(null);
            } else {
                let expression = this.ParseExpression();
                if expression == null || !this.ExpectSuccess(TokenType::RBRACKET) { return null; }
                sizes.PushBack(expression);
            }
        }

        if !this.ExpectSuccess(TokenType::COLON) { return null; }
        let mut _type = this.ParseType();
        if _type == null { return null; }

        for size in sizes {
            _type = this.arena.New<ArrayTypeNode>(_type, size, token);
        }

        return this.arena.New<ParameterNode>(token.value, _type, mutable, token);
    }

    fn ParseClass(&mut this, attributes: &Vector<Pair<String, Vector<*Node>>>) -> *Node {
        let token = this.Expect(TokenType::CLASS);
        if token._type == TokenType::UNKNOWN { return null; }

        for attribute in attributes {
            Logger::Log("Invalid attribute '" + attribute.left + "'.", token, LogSeverity::Error);
            return null;
        }

        let identifier = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { return null; }
        let class_node = this.arena.New<ClassNode>(identifier.value, token);
        let types = this.types;

        if this.Match(TokenType::LESS) {
            class_node->generic = true;

            while this.Current()._type != TokenType::GREATER {
                let type_name = this.Expect(TokenType::IDENTIFIER);

                if type_name._type == TokenType::UNKNOWN {
                    this.types = types;
                    return null;
                }

                class_node->types.PushBack(type_name.value);
                this.types.PushBack(type_name.value);
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.ExpectSuccess(TokenType::GREATER) {
                this.types = types;
                return null;
            }
        }

        if this.Match(TokenType::COLON) {
            let _type = this.ParseType();
            if _type == null { this.types = types; return null; }
            class_node->parents.PushBack(_type);

            while this.Match(TokenType::COMMA) {
                let _type = this.ParseType();
                if _type == null { this.types = types; return null; }
                class_node->parents.PushBack(_type);
            }
        }

        if !this.ExpectSuccess(TokenType::LBRACE) {
            this.types = types;
            return null;
        }

        let mut state = false;

        if this.Current()._type == TokenType::PUBLIC && this.Peek(1)._type == TokenType::IDENTIFIER && (this.Peek(2)._type == TokenType::COLON || this.Peek(2)._type == TokenType::LBRACKET) {
            state = true;
        }

        if this.Current()._type == TokenType::IDENTIFIER && (this.Peek(1)._type == TokenType::COLON || this.Peek(1)._type == TokenType::LBRACKET) {
            state = true;
        }

        if state {
            while this.Current()._type != TokenType::SEMICOLON && this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                let public = this.Match(TokenType::PUBLIC);
                let field = this.ParseField();
                if field == null { this.types = types; return null; }
                class_node->fields.PushBack(Pair<bool, *FieldNode>(public, field));

                if !this.Match(TokenType::COMMA) {
                    break;
                }
            }
        }

        if !state || this.Match(TokenType::SEMICOLON) {
            while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                let attributes = this.ParseAttributes();
                let public = this.Match(TokenType::PUBLIC);
                let token = this.Current();
                let function = this.ParseFunction(attributes, true);
                if function == null { this.types = types; return null; }

                if token._type == TokenType::FUNCTION {
                    class_node->methods.PushBack(Pair<bool, *FunctionNode>(public, function as *FunctionNode));
                } else if token._type != TokenType::TILDE {
                    class_node->constructors.PushBack(function as *FunctionNode);
                } else {
                    if class_node->destructor != null {
                        Logger::Log("Multiple destructor declarations are not allowed.", token, LogSeverity::Error);
                        this.types = types;
                        return null;
                    }

                    class_node->destructor = function as *FunctionNode;
                }
            }
        }

        this.types = types;
        if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
        return class_node;
    }

    fn ParseField(&mut this) -> *FieldNode {
        let token = this.Expect(TokenType::IDENTIFIER);
        if token._type == TokenType::UNKNOWN { return null; }
        let mut sizes: Vector<*Node>;

        while this.Match(TokenType::LBRACKET) {
            if this.Match(TokenType::RBRACKET) {
                sizes.PushBack(null);
            } else {
                let expression = this.ParseExpression();
                if expression == null || !this.ExpectSuccess(TokenType::RBRACKET) { return null; }
                sizes.PushBack(expression);
            }
        }

        if !this.ExpectSuccess(TokenType::COLON) { return null; }
        let mut _type = this.ParseType();
        if _type == null { return null; }
        let mut initializer = null;

        for size in sizes {
            _type = this.arena.New<ArrayTypeNode>(_type, size, token);
        }

        if this.Match(TokenType::ASSIGN) {
            initializer = this.ParseExpression();
            if initializer == null { return null; }
        }

        return this.arena.New<FieldNode>(token.value, _type, initializer, token);
    }

    fn ParseEnum(&mut this, attributes: &Vector<Pair<String, Vector<*Node>>>) -> *Node {
        let token = this.Expect(TokenType::ENUM);
        if token._type == TokenType::UNKNOWN { return null; }

        for attribute in attributes {
            Logger::Log("Invalid attribute '" + attribute.left + "'.", token, LogSeverity::Error);
            return null;
        }

        let identifier = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { return null; }
        let enum_node = this.arena.New<EnumNode>(identifier.value, token);
        let types = this.types;

        if this.Match(TokenType::LESS) {
            enum_node->generic = true;

            while this.Current()._type != TokenType::GREATER {
                let type_name = this.Expect(TokenType::IDENTIFIER);

                if type_name._type == TokenType::UNKNOWN {
                    this.types = types;
                    return null;
                }

                enum_node->types.PushBack(type_name.value);
                this.types.PushBack(type_name.value);
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.ExpectSuccess(TokenType::GREATER) {
                this.types = types;
                return null;
            }
        }

        if this.Match(TokenType::COLON) {
            enum_node->underlying_type = this.ParseType();

            if enum_node->underlying_type == null {
                this.types = types;
                return null;
            }
        } else {
            enum_node->variant = true;
        }

        if !this.ExpectSuccess(TokenType::LBRACE) {
            this.types = types;
            return null;
        }

        while this.Current()._type != TokenType::SEMICOLON && this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
            let variant_identifier = this.Expect(TokenType::IDENTIFIER);
            if variant_identifier._type == TokenType::UNKNOWN { this.types = types; return null; }
            let variant = this.arena.New<VariantNode>(variant_identifier.value, variant_identifier);

            if this.Match(TokenType::LBRACE) {
                while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                    let field_name = this.Expect(TokenType::IDENTIFIER);
                    if field_name._type == TokenType::UNKNOWN { this.types = types; return null; }
                    if !this.ExpectSuccess(TokenType::COLON) { this.types = types; return null; }
                    variant->field_names.PushBack(field_name.value);
                    let _type = this.ParseType();
                    if _type == null { this.types = types; return null; }
                    variant->types.PushBack(_type);
                    if !this.Match(TokenType::COMMA) { break; }
                }

                if !this.ExpectSuccess(TokenType::RBRACE) {
                    this.types = types;
                    return null;
                }
            } else if this.Match(TokenType::LPAREN) {
                let variant_type = this.ParseType();
                if variant_type == null { this.types = types; return null; }
                variant->types.PushBack(variant_type);

                while this.Match(TokenType::COMMA) {
                    let variant_type = this.ParseType();
                    if variant_type == null { this.types = types; return null; }
                    variant->types.PushBack(variant_type);
                }

                if !this.ExpectSuccess(TokenType::RPAREN) {
                    this.types = types;
                    return null;
                }
            } else if this.Match(TokenType::ASSIGN) {
                if enum_node->variant {
                    Logger::Log("Explicit value assignment is not allowed for variant enums.", variant_identifier, LogSeverity::Error);
                    this.types = types;
                    return null;
                }

                variant->value = this.ParseExpression();

                if variant->value == null {
                    this.types = types;
                    return null;
                }
            }

            if !enum_node->variant && !variant->types.Empty() {
                Logger::Log("Data fields are only allowed in variant enums.", variant_identifier, LogSeverity::Error);
                this.types = types;
                return null;
            }

            enum_node->variants.PushBack(variant);

            if !this.Match(TokenType::COMMA) {
                break;
            }
        }

        if this.Match(TokenType::SEMICOLON) {
            while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                let attributes = this.ParseAttributes();
                let public = this.Match(TokenType::PUBLIC);
                let function = this.ParseFunction(attributes, false);
                if function == null { this.types = types; return null; }
                enum_node->methods.PushBack(Pair<bool, *FunctionNode>(public, function as *FunctionNode));
            }
        }

        this.types = types;
        if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
        return enum_node;
    }

    fn ParseExtern(&mut this) -> *Node {
        let extern_token = this.Expect(TokenType::EXTERN);
        if extern_token._type == TokenType::UNKNOWN { return null; }
        let linkage_token = this.Expect(TokenType::STRING);
        if linkage_token._type == TokenType::UNKNOWN { return null; }
        let extern_block = this.arena.New<ExternNode>(linkage_token.value, extern_token);
        if !this.ExpectSuccess(TokenType::LBRACE) { return null; }

        while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
            let attributes = this.ParseAttributes();

            if this.Current()._type == TokenType::FUNCTION {
                let function = this.ParseFunction(attributes, false);

                if function == null {
                    this.SynchronizeDeclaration();
                    continue;
                }

                extern_block->declarations.PushBack(function);
            } else if this.Current()._type == TokenType::STATIC {
                let _static = this.ParseStatic(attributes);

                if _static == null {
                    this.SynchronizeDeclaration();
                    continue;
                }

                extern_block->declarations.PushBack(_static);
            } else {
                Logger::Log("Only function and static declarations allowed in extern block.", this.Current(), LogSeverity::Error);
                this.Advance();
                this.SynchronizeDeclaration();
            }
        }

        if !this.ExpectSuccess(TokenType::RBRACE) { return null; }
        return extern_block;
    }

    fn ParseConstant(&mut this) -> *Node {
        let token = this.Expect(TokenType::CONST);
        if token._type == TokenType::UNKNOWN { return null; }
        let identifier = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { return null; }
        let mut sizes: Vector<*Node>;

        while this.Match(TokenType::LBRACKET) {
            if this.Match(TokenType::RBRACKET) {
                sizes.PushBack(null);
            } else {
                let expression = this.ParseExpression();
                if expression == null || !this.ExpectSuccess(TokenType::RBRACKET) { return null; }
                sizes.PushBack(expression);
            }
        }

        if !this.ExpectSuccess(TokenType::COLON) { return null; }
        let mut _type = this.ParseType();
        if _type == null { return null; }

        for size in sizes {
            _type = this.arena.New<ArrayTypeNode>(_type, size, token);
        }

        if !this.ExpectSuccess(TokenType::ASSIGN) { return null; }
        let initializer = this.ParseExpression();
        if initializer == null || !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        return this.arena.New<ConstantNode>(identifier.value, _type, initializer, token);
    }

    fn ParseStatic(&mut this, attributes: &Vector<Pair<String, Vector<*Node>>>) -> *Node {
        let token = this.Expect(TokenType::STATIC);
        if token._type == TokenType::UNKNOWN { return null; }
        let mut alignment = null;

        for attribute in attributes {
            if attribute.left == "align" {
                if attribute.right.Size() != 1 {
                    Logger::Log("Invalid number of arguments for attribute '" + attribute.left + "'.", token, LogSeverity::Error);
                    return null;
                }

                if alignment != null {
                    Logger::Log("Attribute '" + attribute.left + "' already set.", token, LogSeverity::Error);
                    return null;
                }

                alignment = attribute.right[0];
            } else {
                Logger::Log("Invalid attribute '" + attribute.left + "'.", token, LogSeverity::Error);
                return null;
            }
        }

        let mutable = this.Match(TokenType::MUT);
        let identifier = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { return null; }
        let mut sizes: Vector<*Node>;

        while this.Match(TokenType::LBRACKET) {
            if this.Match(TokenType::RBRACKET) {
                sizes.PushBack(null);
            } else {
                let expression = this.ParseExpression();
                if expression == null || !this.ExpectSuccess(TokenType::RBRACKET) { return null; }
                sizes.PushBack(expression);
            }
        }

        if !this.ExpectSuccess(TokenType::COLON) { return null; }
        let mut _type = this.ParseType();
        if _type == null { return null; }

        for size in sizes {
            _type = this.arena.New<ArrayTypeNode>(_type, size, token);
        }

        let _static = this.arena.New<StaticNode>(identifier.value, _type, mutable, alignment, token);

        if this.Match(TokenType::ASSIGN) {
            if this.Match(TokenType::ZERO) {
                _static->zero_initializer = true;
            } else {
                _static->initializer = this.ParseExpression();
                if _static->initializer == null { return null; }
            }
        }

        if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        return _static;
    }

    fn ParseTypeDefinition(&mut this) -> *Node {
        let token = this.Expect(TokenType::TYPE);
        if token._type == TokenType::UNKNOWN { return null; }
        let identifier = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { return null; }
        if !this.ExpectSuccess(TokenType::ASSIGN) { return null; }
        let _type = this.ParseType();
        if _type == null { return null; }
        let type_definition = this.arena.New<TypeDefinitionNode>(identifier.value, _type, token);
        if !this.ExpectSuccess(TokenType::SEMICOLON) { return null; }
        return type_definition;
    }

    pub fn Parse(&mut this, tokens: &Vector<Token>) -> *RootNode {
        (this.tokens, this.index) = (tokens, 0);

        this.types.Clear();
        this.types.PushBack(String("bool"));
        this.types.PushBack(String("char"));
        this.types.PushBack(String("i8"));
        this.types.PushBack(String("i16"));
        this.types.PushBack(String("i32"));
        this.types.PushBack(String("i64"));
        this.types.PushBack(String("i128"));
        this.types.PushBack(String("isize"));
        this.types.PushBack(String("u8"));
        this.types.PushBack(String("u16"));
        this.types.PushBack(String("u32"));
        this.types.PushBack(String("u64"));
        this.types.PushBack(String("u128"));
        this.types.PushBack(String("usize"));
        this.types.PushBack(String("f32"));
        this.types.PushBack(String("f64"));
        this.types.PushBack(String("void"));
        this.arena.Clear();

        loop {
            let token = this.Advance();

            if token._type == TokenType::CLASS || token._type == TokenType::ENUM || token._type == TokenType::TYPE {
                let identifier = this.Expect(TokenType::IDENTIFIER);
                if identifier._type == TokenType::UNKNOWN { continue; }

                if this.types.Contains(identifier.value) {
                    Logger::Log("Type '" + identifier.value + "' is overloaded.", identifier, LogSeverity::Error);
                } else {
                    this.types.PushBack(identifier.value);
                }
            } else if token._type == TokenType::EOF {
                this.index = 0;
                break;
            }
        }

        let root = this.arena.New<RootNode>();

        while this.Current()._type != TokenType::EOF {
            let declaration = this.ParseDeclaration();

            if declaration != null {
                root->declarations.PushBack(declaration);
            } else {
                this.SynchronizeDeclaration();
            }
        } return root;
    }
}
