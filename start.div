#[if WINDOWS]
extern "C" {
    func GetCommandLineA() -> *mut i8;
    func GetProcessHeap() -> *mut void;
    func HeapAlloc(hHeap: *mut void, dwFlags: u32, dwBytes: u64) -> *mut void;
    func HeapFree(hHeap: *mut void, dwFlags: u32, lpMem: *mut void) -> i32;
    func ExitProcess(uExitCode: u32);

    func main(argc: i32, argv[]: *const i8) -> i32;

    func _start() {
        let raw_cmd: *mut i8 = GetCommandLineA();
        let heap: *mut void = GetProcessHeap();

        let mut argc: i32 = 0i32;
        let mut ptr: *mut i8 = raw_cmd;
        let mut in_arg: bool = false;
        let mut in_quotes: bool = false;

        while ptr[0u64] != 0i8 {
            let character: i8 = ptr[0u64];

            if character == '\"' {
                in_quotes = !in_quotes;

                if !in_arg {
                    in_arg = true;
                    argc += 1i32;
                }
            } else if character == ' ' && !in_quotes {
                in_arg = false;
            } else if !in_arg {
                in_arg = true;
                argc += 1i32;
            }

            ptr = (ptr as u64 + 1u64) as *mut i8;
        }

        let argv: *mut *mut i8 = HeapAlloc(heap, 0u32, (argc as u64) * 8u64) as *mut *mut i8;

        ptr = raw_cmd;
        let mut current_arg: i32 = 0i32;
        in_arg = false;
        in_quotes = false;

        while ptr[0u64] != 0i8 {
            let character: i8 = ptr[0u64];

            if character == '\"' {
                in_quotes = !in_quotes;

                if !in_arg {
                    in_arg = true;
                    argv[current_arg as u64] = (ptr as u64 + 1u64) as *mut i8;
                    current_arg += 1i32;
                } ptr[0u64] = '\0';
            } else if character == ' ' && !in_quotes {
                in_arg = false;
                ptr[0u64] = '\0';
            } else if !in_arg {
                in_arg = true;
                argv[current_arg as u64] = ptr;
                current_arg += 1i32;
            }

            ptr = (ptr as u64 + 1u64) as *mut i8;
        }

        let exit_code: i32 = main(argc, argv);
        HeapFree(heap, 0u32, argv as *mut void);
        ExitProcess(exit_code as u32);
    }

    static mut _fltused: i32 = 0i32;
}
#[elif LINUX]
asm {
    .globl _start

_start:
    xorq %rbp, %rbp
    popq %rdi
    movq %rsp, %rsi
    andq $-16, %rsp
    call main
    movq %rax, %rdi
    movq $60, %rax
    syscall
};
#[elif DARWIN]
asm {
    .globl _start

_start:
    xorq %rbp, %rbp
    popq %rdi
    movq %rsp, %rsi
    andq $-16, %rsp
    call _main
    movq %rax, %rdi
    movq $0x2000001, %rax
    syscall
};
#[endif]