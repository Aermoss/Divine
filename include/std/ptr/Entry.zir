#[include "std/atom" : *]

class SharedControlBlock<T> {
    pub ptr: *mut T = null,
    pub strong: u64 = 1,
    pub weak: u64 = 1;

    SharedControlBlock(&mut this, ptr: *mut T) {
        this.ptr = ptr;
    }
}

class Shared<T> {
    pub control: *mut SharedControlBlock<T> = null;

    Shared(&mut this) {}

    Shared(&mut this, args...) {
        this.control = new SharedControlBlock<T>(new T(args...));
    }

    Shared(&mut this, other: &Shared<T>) {
        if other.control == null { ret; }
        let mut count = AtomicLoad64(&other.control->strong);

        loop {
            if count == 0 { ret; }

            if AtomicCompareExchangeBool64(&mut other.control->strong, count, count + 1) {
                this.control = other.control;
                break;
            }

            count = AtomicLoad64(&other.control->strong);
            AtomicPause();
        }
    }

    ~Shared(&mut this) {
        this.Release();
    }

    func Release(&mut this) {
        if this.control == null { ret; }

        if AtomicFetchSub64(&mut this.control->strong, 1) == 1 {
            del this.control->ptr;
            this.control->ptr = null;

            if AtomicFetchSub64(&mut this.control->weak, 1) == 1 {
                del this.control;
            }
        }

        this.control = null;
    }

    pub Clear(&mut this) {
        this.Release();
    }

    pub Ptr(&this) -> *mut T {
        if this.control == null { ret null; }
        ret this.control->ptr;
    }

    pub StrongCount(&this) -> u64 {
        if this.control == null { ret 0; }
        ret AtomicLoad64(&this.control->strong);
    }

    pub WeakCount(&this) -> u64 {
        if this.control == null { ret 0; }
        let weak = AtomicLoad64(&this.control->weak);
        ret weak > 0 ? weak - 1 : 0;
    }

    pub Valid(&this) -> bool {
        ret this.Ptr() != null;
    }

    pub op->(&this) -> *mut T {
        ret this.Ptr();
    }

    pub op*(&this) -> &mut T {
        ret *this.Ptr();
    }

    pub op=(&mut this, other: &Shared<T>) -> &mut Shared<T> {
        if &this == &other { ret this; }
        if this.control == other.control { ret this; }
        this.Release();

        if other.control == null { ret this; }
        let mut count = AtomicLoad64(&other.control->strong);

        loop {
            if count == 0 { ret this; }

            if AtomicCompareExchangeBool64(&mut other.control->strong, count, count + 1) {
                this.control = other.control;
                break;
            }

            count = AtomicLoad64(&other.control->strong);
            AtomicPause();
        } ret this;
    }

    pub op!=(&this, other: &Shared<T>) -> bool {
        ret this.Ptr() != other.Ptr();
    }

    pub op==(&this, other: &Shared<T>) -> bool {
        ret this.Ptr() == other.Ptr();
    }

    pub op!=(&this, other: *T) -> bool {
        ret this.Ptr() != other;
    }

    pub op==(&this, other: *T) -> bool {
        ret this.Ptr() == other;
    }

    pub ToWeak(&this) -> Weak<T> {
        let mut result: Weak<T>;
        if this.control == null { ret result; }
        AtomicFetchAdd64(&mut this.control->weak, 1);
        result.control = this.control;
        ret result;
    }
}

class Weak<T> {
    pub control: *mut SharedControlBlock<T> = null;

    Weak(&mut this) {}

    Weak(&mut this, shared: &Shared<T>) {
        if shared.control == null { ret; }
        AtomicFetchAdd64(&mut shared.control->weak, 1);
        this.control = shared.control;
    }

    Weak(&mut this, other: &Weak<T>) {
        if other.control == null { ret; }
        AtomicFetchAdd64(&mut other.control->weak, 1);
        this.control = other.control;
    }

    ~Weak(&mut this) {
        this.Release();
    }

    func Release(&mut this) {
        if this.control == null { ret; }

        if AtomicFetchSub64(&mut this.control->weak, 1) == 1 {
            del this.control;
        }

        this.control = null;
    }

    pub Clear(&mut this) {
        this.Release();
    }

    pub Expired(&this) -> bool {
        if this.control == null { ret true; }
        ret AtomicLoad64(&this.control->strong) == 0;
    }

    pub Lock(&this) -> Shared<T> {
        let mut result: Shared<T>;
        if this.control == null { ret result; }
        let mut count = AtomicLoad64(&this.control->strong);

        loop {
            if count == 0 {
                ret result;
            }

            if AtomicCompareExchangeBool64(&mut this.control->strong, count, count + 1) {
                result.control = this.control;
                break;
            }

            count = AtomicLoad64(&this.control->strong);
            AtomicPause();
        } ret result;
    }

    pub StrongCount(&this) -> u64 {
        if this.control == null { ret 0; }
        ret AtomicLoad64(&this.control->strong);
    }

    pub WeakCount(&this) -> u64 {
        if this.control == null { ret 0; }
        let weak = AtomicLoad64(&this.control->weak);
        ret weak > 0 ? weak - 1 : 0;
    }

    pub op=(&mut this, shared: &Shared<T>) -> &mut Weak<T> {
        if this.control == shared.control { ret this; }
        this.Release();
        if shared.control == null { ret this; }
        AtomicFetchAdd64(&mut shared.control->weak, 1);
        this.control = shared.control;
        ret this;
    }

    pub op=(&mut this, other: &Weak<T>) -> &mut Weak<T> {
        if &this == &other { ret this; }
        this.Release();
        if other.control == null { ret this; }
        AtomicFetchAdd64(&mut other.control->weak, 1);
        this.control = other.control;
        ret this;
    }
}
