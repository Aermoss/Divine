#[include "std/str", "std/vec", "std/map", "std/pair",
    "src/Logger.zir", "src/Lexer.zir", "src/Preprocessor.zir", "src/Nodes.zir" : *]

class Parser {
    priv types: Vector<String>,
    priv tokens: Vector<Token>,
    priv index: u64;

    priv Current(&this) -> Token {
        if this.index >= this.tokens.Size() {
            ret this.tokens[this.tokens.Size() - 1u64];
        } else {
            ret this.tokens[this.index];
        }
    }

    priv Peek(&this, offset: u64) -> Token {
        let index: u64 = this.index + offset;

        if index >= this.tokens.Size() {
            ret this.tokens[this.tokens.Size() - 1u64];
        } else {
            ret this.tokens[index];
        }
    }

    priv PeekBack(&this, offset: u64) -> Token {
        if offset > this.index {
            ret this.tokens[0u64];
        } else {
            ret this.tokens[this.index - offset];
        }
    }

    priv Advance(&mut this) -> Token {
        let token: Token = this.Current();

        if this.index < this.tokens.Size() {
            this.index += 1u64;
        } ret token;
    }

    priv Match(&mut this, _type: TokenType) -> bool {
        if this.Current()._type == _type {
            this.Advance();
            ret true;
        } else {
            ret false;
        }
    }

    priv Expect(&mut this, _type: TokenType) -> Token {
        let token: Token = this.Current();

        if token._type == _type {
            ret this.Advance();
        }

        Logger::Log("Expected '" + _type.ToString() + "' but got '" + token._type.ToString() + "'.", token, LogSeverity::Error);

        let mut error: Token;
        (error._type, error.row, error.column, error.file) = (TokenType::UNKNOWN, token.row, token.column, token.file);
        ret error;
    }

    priv Expect2(&mut this, _type: TokenType) -> bool {
        let token: Token = this.Current();

        if token._type == _type {
            this.Advance();
            ret true;
        }

        Logger::Log("Expected '" + _type.ToString() + "' but got '" + token._type.ToString() + "'.", token, LogSeverity::Error);
        ret false;
    }

    priv GetBinaryOperatorPrecedence(&this, _type: TokenType) -> i32 {
        if _type == TokenType::OR { ret 1i32; }
        else if _type == TokenType::AND { ret 2i32; }
        else if _type == TokenType::BITWISE_OR { ret 3i32; }
        else if _type == TokenType::BITWISE_XOR { ret 4i32; }
        else if _type == TokenType::BITWISE_AND { ret 5i32; }
        else if _type == TokenType::EQUAL || _type == TokenType::NOT_EQUAL { ret 6i32; }
        else if _type == TokenType::LESS || _type == TokenType::LESS_EQUAL || _type == TokenType::GREATER || _type == TokenType::GREATER_EQUAL { ret 7i32; }
        else if _type == TokenType::LSHIFT || _type == TokenType::RSHIFT { ret 8i32; }
        else if _type == TokenType::PLUS || _type == TokenType::MINUS { ret 9i32; }
        else if _type == TokenType::MUL || _type == TokenType::DIV || _type == TokenType::MOD { ret 10i32; }
        else if _type == TokenType::AS { ret 11i32; }
        else { ret -1i32; }
    }

    priv IsBinaryOperator(&this, _type: TokenType) -> bool {
        let precedence: i32 = this.GetBinaryOperatorPrecedence(_type);
        ret precedence >= 0i32 && precedence != 11i32;
    }

    priv IsUnaryOperator(&this, _type: TokenType) -> bool {
        ret _type == TokenType::NOT || _type == TokenType::MINUS || _type == TokenType::BITWISE_AND || _type == TokenType::MUL;
    }

    priv IsStructInit(&this, _type: NodeType) -> bool {
        let after_brace: Token = this.Peek(1u64);

        if _type == NodeType::SCOPE_RESOLUTION {
            if after_brace._type == TokenType::RBRACE { ret true; }
            if after_brace._type == TokenType::TWO_DOT { ret true; }
        }

        if after_brace._type == TokenType::IDENTIFIER {
            let after_name: Token = this.Peek(2u64);
            if after_name._type == TokenType::COLON { ret true; }

            if _type == NodeType::SCOPE_RESOLUTION {
                ret after_name._type == TokenType::COMMA || after_name._type == TokenType::RBRACE;
            }
        } ret false;
    }

    priv IsTypeApplication(&this) -> bool {
        if this.Current()._type != TokenType::LESS { ret false; }
        let (mut index: u64, mut depth: u64) = (1u64, 1u64);

        loop {
            let token: Token = this.Peek(index);
            if token._type == TokenType::EOF { ret false; }
            let _type: TokenType = token._type;
            index += 1u64;

            if _type == TokenType::LESS {
                depth += 1u64;
            } else if _type == TokenType::GREATER {
                if depth >= 1u64 {
                    depth -= 1u64;
                } else {
                    ret false;
                }
            } else if _type == TokenType::SEMICOLON || _type == TokenType::LBRACE || _type == TokenType::RBRACE {
                ret false;
            } else {
                if _type != TokenType::IDENTIFIER && _type != TokenType::COLON && _type != TokenType::DOUBLE_COLON && _type != TokenType::LPAREN && _type != TokenType::RPAREN
                    && _type != TokenType::MUL && _type != TokenType::BITWISE_AND && _type != TokenType::MUT && _type != TokenType::CONST && _type != TokenType::LBRACKET && _type != TokenType::RBRACKET
                        && _type != TokenType::FUNC && _type != TokenType::THREE_DOT && _type != TokenType::ARROW && _type != TokenType::INTEGER && _type != TokenType::COMMA { ret false; }

                if _type == TokenType::IDENTIFIER {
                    if this.types.Index(token.value) == -1i64 {
                        ret false;
                    }
                }
            }

            if depth == 0u64 {
                let next: Token = this.Peek(index);

                ret next._type != TokenType::IDENTIFIER && next._type != TokenType::INTEGER && next._type != TokenType::FLOAT && next._type != TokenType::STRING
                    && next._type != TokenType::CHAR && next._type != TokenType::TRUE && next._type != TokenType::FALSE && next._type != TokenType::NULL;
            }
        } ret false;
    }

    priv IsAssignmentOperator(&this, _type: TokenType) -> bool {
        ret _type == TokenType::ASSIGN || _type == TokenType::PLUS_ASSIGN || _type == TokenType::MINUS_ASSIGN || _type == TokenType::MUL_ASSIGN || _type == TokenType::DIV_ASSIGN || _type == TokenType::MOD_ASSIGN
           || _type == TokenType::LSHIFT_ASSIGN || _type == TokenType::RSHIFT_ASSIGN || _type == TokenType::AND_ASSIGN || _type == TokenType::OR_ASSIGN || _type == TokenType::XOR_ASSIGN;
    }

    priv ParsePrimary(&mut this) -> *const Node {
        let token: Token = this.Current();

        if token._type == TokenType::INTEGER || token._type == TokenType::FLOAT || token._type == TokenType::STRING || token._type == TokenType::CHAR || token._type == TokenType::TRUE || token._type == TokenType::FALSE || token._type == TokenType::NULL {
            this.Advance();
            ret new LiteralNode(token.value, token._type, token) as *const Node;
        } else if token._type == TokenType::IDENTIFIER || token._type == TokenType::THIS || token._type == TokenType::OPERATOR || token._type == TokenType::DOUBLE_COLON {
            let mut node: *const Node = null;

            if token._type != TokenType::DOUBLE_COLON {
                if this.types.Index(token.value) != -1i64 {
                    node = this.ParseType();
                    if node == null { ret null; }
                } else {
                    if this.Match(TokenType::OPERATOR) {
                        let mut identifier: String = "op";

                        while this.Current()._type != TokenType::LPAREN && this.Current()._type != TokenType::LESS {
                            identifier += this.Current().value;
                            this.Advance();
                        }

                        node = new IdentifierNode(identifier, token);
                    } else {
                        let identifier: Token = this.Expect(this.Current()._type != TokenType::THIS ? TokenType::IDENTIFIER : TokenType::THIS);
                        if identifier._type == TokenType::UNKNOWN { ret null; }
                        node = new IdentifierNode(identifier.value, token);
                    }
                }
            }

            while this.Match(TokenType::DOUBLE_COLON) {
                let mut identifier: *const IdentifierNode = null;

                if this.Match(TokenType::OPERATOR) {
                    let mut _identifier: String = "op";

                    while this.Current()._type != TokenType::LPAREN && this.Current()._type != TokenType::LESS {
                        _identifier += this.Current().value;
                        this.Advance();
                    }

                    identifier = new IdentifierNode(_identifier, token);
                } else {
                    let _identifier: Token = this.Expect(this.Current()._type != TokenType::THIS ? TokenType::IDENTIFIER : TokenType::THIS);
                    if _identifier._type == TokenType::UNKNOWN { ret null; }
                    identifier = new IdentifierNode(_identifier.value, token);
                } node = new ScopeResolutionNode(node, identifier, token);
            } ret node;
        } else if token._type == TokenType::LBRACE {
            this.Advance();
            let initializer_list: *mut InitializerListNode = new InitializerListNode(token);

            if !this.Match(TokenType::RBRACE) {
                let expression: *const Node = this.ParseExpression();
                if expression == null { ret null; }
                initializer_list->expressions.PushBack(expression);

                while this.Match(TokenType::COMMA) {
                    let expression: *const Node = this.ParseExpression();
                    if expression == null { ret null; }
                    initializer_list->expressions.PushBack(expression);
                }

                if !this.Expect2(TokenType::RBRACE) { ret null; }
            } ret initializer_list as *const Node;
        } else if token._type == TokenType::LPAREN {
            this.Advance();
            let expression: *const Node = this.ParseExpression();
            if expression == null || !this.Expect2(TokenType::RPAREN) { ret null; }
            ret expression;
        } else {
            this.Advance();
            Logger::Log("Unexpected token '" + token.value + "'.", token, LogSeverity::Error);
            ret null;
        }
    }

    priv ParsePostfix(&mut this) -> *const Node {
        let mut expression: *const Node = this.ParsePrimary();
        if expression == null { ret null; }

        loop {
            let token: Token = this.Current();

            if token._type == TokenType::LPAREN {
                this.Advance();
                let call: *mut CallNode = new CallNode(expression, token);

                if !this.Match(TokenType::RPAREN) {
                    while this.Current()._type != TokenType::RPAREN && this.Current()._type != TokenType::EOF {
                        let expression: *const Node = this.ParseExpression();
                        if expression == null { ret null; }
                        call->arguments.PushBack(expression);

                        if !this.Match(TokenType::COMMA) {
                            break;
                        }
                    }

                    if !this.Expect2(TokenType::RPAREN) { ret null; }
                } expression = call;
            } else if token._type == TokenType::DOT || token._type == TokenType::ARROW {
                this.Advance();
                let member_access: *mut MemberAccessNode = new MemberAccessNode(expression, token._type == TokenType::ARROW, token);

                if this.Match(TokenType::OPERATOR) {
                    member_access->member += "op";

                    while this.Current()._type != TokenType::LPAREN && this.Current()._type != TokenType::LESS {
                        member_access->member += this.Current().value;
                        this.Advance();
                    }
                } else {
                    let identifier: Token = this.Expect(TokenType::IDENTIFIER);
                    if identifier._type == TokenType::UNKNOWN { ret null; }
                    member_access->member += identifier.value;
                } expression = member_access;
            } else if token._type == TokenType::LBRACKET {
                this.Advance();
                let _expression: *const Node = this.ParseExpression();
                if _expression == null { ret null; }
                expression = new IndexAccessNode(expression, _expression, token);
                if !this.Expect2(TokenType::RBRACKET) { ret null; }
            } else if token._type == TokenType::LBRACE && (expression->_type == NodeType::SCOPE_RESOLUTION || expression->_type == NodeType::IDENTIFIER) && this.IsStructInit(expression->_type) {
                this.Advance();
                let struct_init: *mut StructInitNode = new StructInitNode(expression, token);

                while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                    if this.Current()._type == TokenType::TWO_DOT {
                        this.Advance();
                        break;
                    }

                    let field_name: Token = this.Expect(TokenType::IDENTIFIER);
                    if field_name._type == TokenType::UNKNOWN { ret null; }

                    if this.Match(TokenType::COLON) {
                        let expression: *const Node = this.ParseExpression();
                        if expression == null { ret null; }
                        struct_init->field_values.PushBack(expression);
                    } else {
                        struct_init->field_values.PushBack(new IdentifierNode(field_name.value, field_name) as *const Node);
                    }

                    struct_init->field_names.PushBack(field_name.value);
                    if !this.Match(TokenType::COMMA) { break; }
                }

                if !this.Expect2(TokenType::RBRACE) { ret null; }
                expression = struct_init;
            } else if token._type == TokenType::THREE_DOT {
                this.Advance();
                expression = new PackSplatNode(expression, token);
            } else if this.IsTypeApplication() {
                this.Advance();
                let type_application: *mut TypeApplicationNode = new TypeApplicationNode(expression, token);

                while this.Current()._type != TokenType::GREATER {
                    let _type: *const Node = this.ParseType();
                    if _type == null { ret null; }
                    type_application->types.PushBack(_type);
                    if !this.Match(TokenType::COMMA) { break; }
                }

                if !this.Expect2(TokenType::GREATER) { ret null; }
                expression = type_application;
            } else {
                break;
            }
        } ret expression;
    }

    priv ParseUnary(&mut this) -> *const Node {
        let token: Token = this.Current();
        let mut mutable: bool = false;

        if this.IsUnaryOperator(token._type) {
            this.Advance();

            if token._type == TokenType::BITWISE_AND {
                mutable = this.Match(TokenType::MUT);
            }

            let expression: *const Node = this.ParseUnary();
            if expression == null { ret null; }
            ret new UnaryOperationNode(expression, token._type, mutable, token) as *const Node;
        } else if token._type == TokenType::NEW {
            this.Advance();
            let _type: *const Node = this.ParseType();
            if _type == null { ret null; }
            let _new: *mut NewNode = new NewNode(_type, token);

            if this.Match(TokenType::LBRACKET) {
                _new->size = this.ParseExpression();

                if _new->size == null || !this.Expect2(TokenType::RBRACKET) {
                    ret null;
                }
            } else if this.Match(TokenType::LPAREN) {
                _new->initialized = true;

                if !this.Match(TokenType::RPAREN) {
                    while this.Current()._type != TokenType::RPAREN {
                        let argument: *const Node = this.ParseExpression();
                        if argument == null { ret null; }
                        _new->arguments.PushBack(argument);
                        if !this.Match(TokenType::COMMA) { break; }
                    }

                    if !this.Expect2(TokenType::RPAREN) { ret null; }
                }
            } ret _new as *const Node;
        } else if token._type == TokenType::DELETE {
            this.Advance();
            let delete: *mut DeleteNode = new DeleteNode(token);

            if this.Match(TokenType::LBRACKET) {
                if !this.Expect2(TokenType::RBRACKET) { ret null; }
                delete->array = true;
            }

            delete->expression = this.ParseExpression();
            if delete->expression == null { ret null; }
            ret delete as *const Node;
        } else if token._type == TokenType::AWAIT {
            this.Advance();
            let expression: *const Node = this.ParseUnary();
            if expression == null { ret null; }
            ret new AwaitNode(expression, token) as *const Node;
        } else {
            ret this.ParsePostfix();
        }
    }

    priv ParseBinary(&mut this, min_precedence: i32) -> *const Node {
        let mut left: *const Node = this.ParseUnary();
        if left == null { ret null; }

        loop {
            let mut token: Token = this.Current();

            if this.Peek(1u64)._type == token._type {
                if token._type == TokenType::GREATER {
                    token._type = TokenType::RSHIFT;
                    this.Advance();
                }

                if token._type == TokenType::LESS {
                    token._type = TokenType::LSHIFT;
                    this.Advance();
                }
            }

            let precedence: i32 = this.GetBinaryOperatorPrecedence(token._type);
            if precedence < min_precedence { break; }
            this.Advance();

            if token._type == TokenType::AS {
                let _type: *const Node = this.ParseType();
                if _type == null { ret null; }
                left = new CastNode(left, _type, token);
            } else {
                let right: *const Node = this.ParseBinary(precedence + 1i32);
                if right == null { ret null; }
                left = new BinaryOperationNode(left, right, token._type, token);
            }
        } ret left;
    }

    priv ParseExpression(&mut this) -> *const Node {
        let mut expression: *const Node = this.ParseBinary(0i32);
        if expression == null { ret null; }
        let token: Token = this.Current();

        if token._type == TokenType::QUESTION_MARK {
            this.Advance();
            let then: *const Node = this.ParseExpression();
            if then == null || !this.Expect2(TokenType::COLON) { ret null; }
            let _else: *const Node = this.ParseExpression();
            if _else == null { ret null; }
            expression = new TernaryNode(expression, then, _else, token);
        } ret expression;
    }

    priv ParseType(&mut this) -> *const Node {
        let mut references: Vector<bool>;

        if this.Match(TokenType::BITWISE_AND) {
            references.PushBack(this.Match(TokenType::MUT));
        }

        let mut pointers: Vector<bool>;

        while this.Match(TokenType::MUL) {
            if this.Match(TokenType::MUT) {
                pointers.PushBack(true);
            } else {
                if !this.Expect2(TokenType::CONST) { ret null; }
                pointers.PushBack(false);
            }
        }

        let token: Token = this.Current();
        let mut node: *const Node = null;

        if this.Match(TokenType::FUNC) {
            if !this.Expect2(TokenType::LPAREN) { ret null; }
            let function_type: *mut FunctionTypeNode = new FunctionTypeNode(token);

            if this.Current()._type != TokenType::RPAREN {
                while this.Current()._type != TokenType::EOF {
                    if this.Peek(1u64)._type == TokenType::THREE_DOT {
                        let pack_name: Token = this.Expect(TokenType::IDENTIFIER);
                        if pack_name._type == TokenType::UNKNOWN { ret null; }
                        function_type->pack_name = pack_name.value;
                        this.Advance();
                        break;
                    }

                    if this.Match(TokenType::THREE_DOT) {
                        function_type->var_arg = true;
                        break;
                    }

                    if (this.Peek(1u64)._type == TokenType::COLON || this.Peek(1u64)._type == TokenType::LBRACKET) || (this.Peek(1u64)._type == TokenType::MUT && (this.Peek(2u64)._type == TokenType::COLON || this.Peek(2u64)._type == TokenType::LBRACKET)) {
                        let param: *const ParameterNode = this.ParseParameter();
                        if param == null { ret null; }
                        function_type->parameters.PushBack(param);
                    } else {
                        let token: Token = this.Current();
                        let _type: *const Node = this.ParseType();
                        if _type == null { ret null; }
                        function_type->parameters.PushBack(new ParameterNode(String(""), _type, false, token));
                    }

                    if !this.Match(TokenType::COMMA) {
                        break;
                    }
                }
            }

            if !this.Expect2(TokenType::RPAREN) { ret null; }

            if this.Match(TokenType::ARROW) {
                function_type->return_type = this.ParseType();
                if function_type->return_type == null { ret null; }
            } else {
                function_type->return_type = new PrimitiveTypeNode({ "void" } as String, token);
            } node = function_type;
        } else {
            if token._type != TokenType::IDENTIFIER {
                Logger::Log("Expected type name.", token, LogSeverity::Error);
                ret null;
            }

            node = new PrimitiveTypeNode(token.value, token);
            this.Advance();

            loop {
                if this.Match(TokenType::DOUBLE_COLON) {
                    let identifier: Token = this.Expect(TokenType::IDENTIFIER);
                    if identifier._type == TokenType::UNKNOWN { ret null; }
                    node = new ScopeResolutionNode(node, new IdentifierNode(identifier.value, identifier), token);
                } else if this.IsTypeApplication() {
                    this.Advance();
                    let type_application: *mut TypeApplicationNode = new TypeApplicationNode(node, token);

                    while this.Current()._type != TokenType::GREATER {
                        let _type: *const Node = this.ParseType();
                        if _type == null { ret null; }
                        type_application->types.PushBack(_type);
                        if !this.Match(TokenType::COMMA) { break; }
                    }

                    if !this.Expect2(TokenType::GREATER) { ret null; }
                    node = type_application;
                } else {
                    break;
                }
            }
        }

        while !pointers.Empty() {
            node = new PointerTypeNode(node, pointers.PopBack(), token);
        }

        if !references.Empty() {
            node = new ReferenceTypeNode(node, references[0u64], token);
        } ret node;
    }

    priv ParseStatement(&mut this, expression: bool) -> *const Node {
        let token: Token = this.Current();

        if token._type == TokenType::LET && !expression {
            ret this.ParseVariable();
        } else if token._type == TokenType::IF && !expression {
            ret this.ParseIf();
        } else if token._type == TokenType::WHILE && !expression {
            ret this.ParseWhile();
        } else if token._type == TokenType::FOR && !expression {
            ret this.ParseFor();
        } else if token._type == TokenType::LOOP && !expression {
            ret this.ParseLoop();
        } else if token._type == TokenType::MATCH && !expression {
            ret this.ParseMatch();
        } else if token._type == TokenType::UNSAFE && !expression {
            ret this.ParseUnsafe();
        } else if (token._type == TokenType::ASSEMBLY || token._type == TokenType::VOLATILE) && !expression {
            ret this.ParseAssembly();
        } else if token._type == TokenType::RETURN {
            ret this.ParseReturn(expression);
        } else if token._type == TokenType::BREAK {
            ret this.ParseBreak(expression);
        } else if token._type == TokenType::CONTINUE {
            ret this.ParseContinue(expression);
        } else {
            let index: u64 = this.index;

            if this.Match(TokenType::LPAREN) {
                let mut current: *mut AssignmentNode = null;
                let mut root: *mut AssignmentNode = null;

                while root == null || this.Match(TokenType::COMMA) {
                    let _expression: *const Node = this.ParseExpression();
                    if _expression == null { ret null; }
                    let assignment: *mut AssignmentNode = new AssignmentNode(_expression, null, TokenType::ASSIGN, token);

                    if root != null {
                        current->next = assignment;
                    } else {
                        root = assignment;
                    } current = assignment;
                }

                if root->next != null {
                    if !this.Expect2(TokenType::RPAREN) { ret null; }
                    if !this.Expect2(TokenType::ASSIGN) { ret null; }
                    if !this.Expect2(TokenType::LPAREN) { ret null; }
                    current = root;

                    while current != null {
                        current->right = this.ParseExpression();
                        if current->right == null { ret null; }

                        if current->next != null {
                            if !this.Expect2(TokenType::COMMA) { ret null; }
                        } current = current->next;
                    }

                    if !this.Expect2(TokenType::RPAREN) { ret null; }
                    if !this.Expect2(TokenType::SEMICOLON) { ret null; }
                    ret root as *const Node;
                } else {
                    this.index = index;
                }
            }

            let left: *const Node = this.ParseExpression();

            if this.IsAssignmentOperator(this.Current()._type) {
                let token: Token = this.Advance();
                let right: *const Node = this.ParseExpression();
                if right == null { ret null; }
                let assignment: *const AssignmentNode = new AssignmentNode(left, right, token._type, token);

                if !expression {
                    if !this.Expect2(TokenType::SEMICOLON) { ret null; }
                } ret assignment as *const Node;
            } else {
                if !expression {
                    if !this.Expect2(TokenType::SEMICOLON) { ret null; }
                }

                ret new ExpressionNode(left, token) as *const Node;
            }
        }
    }

    priv ParseVariable(&mut this) -> *const Node {
        let token: Token = this.Expect(TokenType::LET);
        if token._type == TokenType::UNKNOWN { ret null; }
        let multiple: bool = this.Match(TokenType::LPAREN);
        let mut current: *mut VariableNode = null;
        let mut root: *mut VariableNode = null;

        while root == null || (multiple && root != null && this.Match(TokenType::COMMA)) {
            let mutable: bool = this.Match(TokenType::MUT);
            let identifier: Token = this.Expect(TokenType::IDENTIFIER);
            if identifier._type == TokenType::UNKNOWN { ret null; }
            let mut sizes: Vector<*const Node>;

            while this.Match(TokenType::LBRACKET) {
                if this.Match(TokenType::RBRACKET) {
                    sizes.PushBack(null);
                } else {
                    let expression: *const Node = this.ParseExpression();
                    if expression == null || !this.Expect2(TokenType::RBRACKET) { ret null; }
                    sizes.PushBack(expression);
                }
            }

            if !this.Expect2(TokenType::COLON) { ret null; }
            let mut _type: *const Node = this.ParseType();
            if _type == null { ret null; }

            for size in sizes {
                _type = new ArrayTypeNode(_type, size, token);
            }

            let declaration: *mut VariableNode = new VariableNode(identifier.value, _type, null, mutable, token);

            if root != null {
                current->next = declaration;
            } else {
                root = declaration;
            } current = declaration;
        }

        if multiple {
            if !this.Expect2(TokenType::RPAREN) { ret null; }
        }

        if this.Match(TokenType::ASSIGN) {
            if multiple {
                if !this.Expect2(TokenType::LPAREN) { ret null; }
            } current = root;

            while current != null {
                current->initializer = this.ParseExpression();
                if current->initializer == null { ret null; }

                if current->initializer->_type == NodeType::INITIALIZER_LIST {
                    let list: *const InitializerListNode = current->initializer as *const InitializerListNode;

                    if current->_type->_type == NodeType::ARRAY_TYPE {
                        let array_type: *mut ArrayTypeNode = current->_type as *mut ArrayTypeNode;

                        if array_type->size == null {
                            array_type->size = new LiteralNode(String(list->expressions.Size() as i64) + "u64", TokenType::INTEGER, token);
                        }
                    }
                }

                if current->next != null {
                    if !this.Expect2(TokenType::COMMA) { ret null; }
                } current = current->next;
            }

            if multiple {
                if !this.Expect2(TokenType::RPAREN) { ret null; }
            }
        }

        if !this.Expect2(TokenType::SEMICOLON) { ret null; }
        ret root as *const Node;
    }

    priv ParseIf(&mut this) -> *const Node {
        let token: Token = this.Expect(TokenType::IF);
        if token._type == TokenType::UNKNOWN { ret null; }

        if this.Current()._type == TokenType::LET {
            this.Advance();
            let pattern: *const Node = this.ParsePattern();
            if pattern == null || !this.Expect2(TokenType::ASSIGN) { ret null; }
            let expression: *const Node = this.ParseExpression();
            if expression == null { ret null; }
            let then: *const Node = this.ParseBlock();
            if then == null { ret null; }
            let if_let: *mut IfLetNode = new IfLetNode(pattern, expression, then, token);

            if this.Match(TokenType::ELSE) {
                if this.Current()._type == TokenType::IF {
                    if_let->_else = this.ParseIf();
                } else {
                    if_let->_else = this.ParseBlock();
                }
            } ret if_let as *const Node;
        }

        let condition: *const Node = this.ParseExpression();
        if condition == null { ret null; }
        let then: *const Node = this.ParseBlock();
        if then == null { ret null; }
        let mut _else: *const Node = null;

        if this.Match(TokenType::ELSE) {
            if this.Current()._type == TokenType::IF {
                _else = this.ParseIf();
            } else {
                _else = this.ParseBlock();
            }
        }

        ret new IfNode(condition, then, _else, token) as *const Node;
    }

    priv ParseWhile(&mut this) -> *const Node {
        let token: Token = this.Expect(TokenType::WHILE);
        if token._type == TokenType::UNKNOWN { ret null; }

        if this.Current()._type == TokenType::LET {
            this.Advance();
            let pattern: *const Node = this.ParsePattern();
            if pattern == null || !this.Expect2(TokenType::ASSIGN) { ret null; }
            let expression: *const Node = this.ParseExpression();
            if expression == null { ret null; }
            let _loop: *const Node = this.ParseBlock();
            if _loop == null { ret null; }
            ret new WhileLetNode(pattern, expression, _loop, token) as *const Node;
        }

        let expression: *const Node = this.ParseExpression();
        if expression == null { ret null; }
        let _loop: *const Node = this.ParseBlock();
        if _loop == null { ret null; }
        let mut _else: *const Node = null;

        if this.Match(TokenType::ELSE) {
            _else = this.ParseBlock();
        }

        ret new WhileNode(expression, _loop, _else, token) as *const Node;
    }

    priv ParseFor(&mut this) -> *const Node {
        let token: Token = this.Expect(TokenType::FOR);
        if token._type == TokenType::UNKNOWN { ret null; }
        let name: Token = this.Expect(TokenType::IDENTIFIER);
        if name._type == TokenType::UNKNOWN { ret null; }
        if !this.Expect2(TokenType::IN) { ret null; }
        let iterable: *const Node = this.ParseForIterable();
        if iterable == null { ret null; }
        let _loop: *const Node = this.ParseBlock();
        if _loop == null { ret null; }
        ret new ForNode(name.value, iterable, _loop, token) as *const Node;
    }

    priv ParseForIterable(&mut this) -> *const Node {
        let left: *const Node = this.ParseBinary(0i32);
        if left == null { ret null; }

        if this.Current()._type == TokenType::TWO_DOT {
            let token: Token = this.Advance();
            let inclusive: bool = this.Match(TokenType::ASSIGN);
            let right: *const Node = this.ParseBinary(0i32);
            if right == null { ret null; }
            let range: *mut RangeNode = new RangeNode(left, right, token);
            range->inclusive = inclusive;
            ret range as *const Node;
        } ret left;
    }

    priv ParseLoop(&mut this) -> *const Node {
        let token: Token = this.Expect(TokenType::LOOP);
        if token._type == TokenType::UNKNOWN { ret null; }
        let _loop: *const Node = this.ParseBlock();
        if _loop == null { ret null; }
        ret new LoopNode(_loop, token) as *const Node;
    }

    priv ConvertBitwiseToPattern(&mut this, node: *const Node) -> *const Node {
        if node->_type != NodeType::BINARY_OPERATION { ret node; }
        let binary_operation: *const BinaryOperationNode = node as *const BinaryOperationNode;
        if binary_operation->operator != TokenType::BITWISE_OR { ret node; }
        let left: *const Node = this.ConvertBitwiseToPattern(binary_operation->left);
        let right: *const Node = this.ConvertBitwiseToPattern(binary_operation->right);
        ret new OrPatternNode(left, right, node->start) as *const Node;
    }

    priv ParsePattern(&mut this) -> *const Node {
        ret this.ParseSinglePattern();
    }

    priv ParseSinglePattern(&mut this) -> *const Node {
        if this.Current()._type == TokenType::IDENTIFIER && this.Current().value == "_" {
            let token: Token = this.Current();
            this.Advance();
            ret new IdentifierNode({ "_" } as String, token) as *const Node;
        }

        let expression: *const Node = this.ParseExpression();
        if expression == null { ret null; }
        let converted: *const Node = this.ConvertBitwiseToPattern(expression);
        if converted != expression { ret converted; }

        if this.Current()._type == TokenType::LBRACE && (expression->_type == NodeType::IDENTIFIER || expression->_type == NodeType::SCOPE_RESOLUTION) {
            let brace_token: Token = this.Current();
            this.Advance();
            let struct_pattern: *mut StructInitNode = new StructInitNode(expression, brace_token);

            while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                if this.Current()._type == TokenType::TWO_DOT {
                    this.Advance();
                    break;
                }

                let field_name: Token = this.Expect(TokenType::IDENTIFIER);
                if field_name._type == TokenType::UNKNOWN { ret null; }

                if this.Match(TokenType::COLON) {
                    let pattern: *const Node = this.ParsePattern();
                    if pattern == null { ret null; }
                    struct_pattern->field_values.PushBack(pattern);
                } else {
                    struct_pattern->field_values.PushBack(new IdentifierNode(field_name.value, field_name) as *const Node);
                }

                struct_pattern->field_names.PushBack(field_name.value);
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.Expect2(TokenType::RBRACE) { ret null; }
            ret struct_pattern as *const Node;
        } ret expression;
    }

    priv ParseMatch(&mut this) -> *const Node {
        let token: Token = this.Expect(TokenType::MATCH);
        if token._type == TokenType::UNKNOWN { ret null; }
        let expression: *const Node = this.ParseExpression();
        if expression == null { ret null; }
        let match_node: *mut MatchNode = new MatchNode(expression, token);
        if !this.Expect2(TokenType::LBRACE) { ret null; }

        while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
            let mut pattern: *const Node = null;

            if this.Current()._type == TokenType::IDENTIFIER && this.Current().value == "_" && this.Peek(1u64)._type == TokenType::FAT_ARROW {
                this.Advance();
            } else {
                pattern = this.ParsePattern();
                if pattern == null { ret null; }
            }

            let mut guard: *const Node = null;

            if pattern != null && this.Current()._type == TokenType::IF {
                this.Advance();
                guard = this.ParseExpression();
                if guard == null { ret null; }
            }

            if !this.Expect2(TokenType::FAT_ARROW) { break; }
            let mut body: *const Node = null;

            if this.Current()._type == TokenType::LBRACE {
                body = this.ParseBlock();
                if body == null { ret null; }
            } else {
                body = this.ParseStatement(true);
                if body == null { ret null; }
            }

            if pattern == null {
                match_node->default = new DefaultNode(body, token);
            } else {
                match_node->cases.PushBack(new CaseNode(pattern, body, guard, token));
            }

            if !this.Match(TokenType::COMMA) {
                break;
            }
        }

        if !this.Expect2(TokenType::RBRACE) { ret null; }
        ret match_node as *const Node;
    }

    priv ParseUnsafe(&mut this) -> *const Node {
        let token: Token = this.Expect(TokenType::UNSAFE);
        if token._type == TokenType::UNKNOWN { ret null; }
        let body: *const Node = this.ParseBlock();
        if body == null { ret null; }
        ret new UnsafeNode(body as *const BlockNode, token) as *const Node;
    }

    priv ParseAssembly(&mut this) -> *const Node {
        let _volatile: bool = this.Match(TokenType::VOLATILE);
        let token: Token = this.Expect(TokenType::ASSEMBLY);
        if token._type == TokenType::UNKNOWN { ret null; }
        let node: *mut AssemblyNode = new AssemblyNode(_volatile, token);

        if this.Match(TokenType::COLON) {
            while this.Current()._type == TokenType::IDENTIFIER {
                let register: String = this.Advance().value;
                if !this.Expect2(TokenType::LPAREN) { ret null; }
                let expression: *const Node = this.ParseExpression();
                if expression == null || !this.Expect2(TokenType::RPAREN) { ret null; }
                node->inputs.PushBack(Pair<String, *const Node>(register, expression));
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.Expect2(TokenType::ARROW) { ret null; }
        }

        let code: Token = this.Expect(TokenType::ASM_CODE);
        if code._type == TokenType::UNKNOWN { ret null; }
        node->code = code.value;

        if this.Match(TokenType::ARROW) {
            while this.Current()._type == TokenType::IDENTIFIER {
                let register: String = this.Advance().value;
                if !this.Expect2(TokenType::LPAREN) { ret null; }
                let expression: *const Node = this.ParseExpression();
                if expression == null || !this.Expect2(TokenType::RPAREN) { ret null; }
                node->outputs.PushBack(Pair<String, *const Node>(register, expression));
                if !this.Match(TokenType::COMMA) { break; }
            }
        }

        if this.Match(TokenType::COLON) {
            while this.Current()._type == TokenType::IDENTIFIER {
                node->clobbers.PushBack(this.Advance().value);
                if !this.Match(TokenType::COMMA) { break; }
            }
        }

        if !this.Expect2(TokenType::SEMICOLON) { ret null; }
        ret node as *const Node;
    }

    priv ParseReturn(&mut this, expression: bool) -> *const Node {
        let token: Token = this.Expect(TokenType::RETURN);
        if token._type == TokenType::UNKNOWN { ret null; }
        let mut value: *const Node = null;

        if this.Current()._type != TokenType::SEMICOLON {
            value = this.ParseExpression();
            if value == null { ret null; }
        }

        if !expression {
            if !this.Expect2(TokenType::SEMICOLON) { ret null; }
        }

        ret new ReturnNode(value, token) as *const Node;
    }

    priv ParseBreak(&mut this, expression: bool) -> *const Node {
        let token: Token = this.Expect(TokenType::BREAK);
        if token._type == TokenType::UNKNOWN { ret null; }

        if !expression {
            if !this.Expect2(TokenType::SEMICOLON) { ret null; }
        }

        ret new BreakNode(token) as *const Node;
    }

    priv ParseContinue(&mut this, expression: bool) -> *const Node {
        let token: Token = this.Expect(TokenType::CONTINUE);
        if token._type == TokenType::UNKNOWN { ret null; }

        if !expression {
            if !this.Expect2(TokenType::SEMICOLON) { ret null; }
        }

        ret new ContinueNode(token) as *const Node;
    }

    priv ParseBlock(&mut this) -> *const Node {
        let token: Token = this.Expect(TokenType::LBRACE);
        if token._type == TokenType::UNKNOWN { ret null; }
        let block: *mut BlockNode = new BlockNode(token);

        while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
            let statement: *const Node = this.ParseStatement(false);

            if statement != null {
                block->statements.PushBack(statement);
            } else {
                while this.Current()._type != TokenType::EOF && this.Current()._type != TokenType::RBRACE {
                    let _type: TokenType = this.Current()._type;

                    if _type == TokenType::SEMICOLON {
                        this.Advance();
                        break;
                    }

                    if _type == TokenType::LET || _type == TokenType::IF || _type == TokenType::WHILE || _type == TokenType::FOR || _type == TokenType::LOOP || _type == TokenType::MATCH || _type == TokenType::RETURN || _type == TokenType::BREAK || _type == TokenType::CONTINUE || _type == TokenType::ASSEMBLY || _type == TokenType::VOLATILE {
                        break;
                    }

                    this.Advance();
                }
            }
        }

        if !this.Expect2(TokenType::RBRACE) { ret null; }
        ret block as *const Node;
    }

    priv SynchronizeDeclaration(&mut this) {
        while this.Current()._type != TokenType::EOF {
            let _type: TokenType = this.Current()._type;

            if _type == TokenType::FUNC || _type == TokenType::CLASS || _type == TokenType::ENUM || _type == TokenType::EXTERN || _type == TokenType::INCLUDE || _type == TokenType::CONST || _type == TokenType::STATIC || _type == TokenType::TYPE || _type == TokenType::ASSEMBLY || _type == TokenType::VOLATILE || _type == TokenType::AT {
                break;
            }

            this.Advance();
        }
    }

    priv ParseAttributes(&mut this) -> Vector<Pair<String, Vector<*const Node>>> {
        let mut attributes: Vector<Pair<String, Vector<*const Node>>>;

        while this.Match(TokenType::AT) {
            let mut pair: Pair<String, Vector<*const Node>>;
            let identifier: Token = this.Expect(TokenType::IDENTIFIER);
            if identifier._type == TokenType::UNKNOWN { ret attributes; }
            pair.left = identifier.value;

            if this.Match(TokenType::LPAREN) {
                if !this.Match(TokenType::RPAREN) {
                    while this.Current()._type != TokenType::RPAREN && this.Current()._type != TokenType::EOF {
                        let expression: *const Node = this.ParseExpression();
                        if expression == null { ret attributes; }
                        pair.right.PushBack(expression);

                        if !this.Match(TokenType::COMMA) {
                            break;
                        }
                    }

                    if !this.Expect2(TokenType::RPAREN) { ret attributes; }
                }
            }

            attributes.PushBack(pair);
        } ret attributes;
    }

    priv ParseDeclaration(&mut this) -> *const Node {
        let attributes: Vector<Pair<String, Vector<*const Node>>> = this.ParseAttributes();
        let token: Token = this.Current();

        if token._type == TokenType::FUNC {
            ret this.ParseFunction(attributes);
        } else if token._type == TokenType::CLASS {
            ret this.ParseClass(attributes);
        } else if token._type == TokenType::ENUM {
            ret this.ParseEnum(attributes);
        } else if token._type == TokenType::EXTERN {
            ret this.ParseExtern();
        } else if token._type == TokenType::CONST {
            ret this.ParseConstant();
        } else if token._type == TokenType::STATIC {
            ret this.ParseStatic(attributes);
        } else if token._type == TokenType::TYPE {
            ret this.ParseTypeDefinition();
        } else if token._type == TokenType::ASSEMBLY || token._type == TokenType::VOLATILE {
            ret this.ParseAssembly();
        } else {
            this.Advance();
            Logger::Log("Expected declaration.", token, LogSeverity::Error);
            ret null;
        }
    }

    priv ParseFunction(&mut this, attributes: &Vector<Pair<String, Vector<*const Node>>>) -> *const Node {
        let token: Token = this.Current();
        let mut no_mangle: bool = false;

        for attribute in attributes {
            if attribute.left == "nomangle" {
                if attribute.right.Size() != 0u64 {
                    Logger::Log("Invalid number of arguments for attribute '" + attribute.left + "'.", token, LogSeverity::Error);
                    ret null;
                }

                if no_mangle {
                    Logger::Log("Attribute '" + attribute.left + "' already set.", token, LogSeverity::Error);
                    ret null;
                }

                no_mangle = true;
            } else {
                Logger::Log("Invalid attribute '" + attribute.left + "'.", token, LogSeverity::Error);
                ret null;
            }
        }

        let mut name: String;

        if token._type == TokenType::TILDE || token._type == TokenType::FUNC || token._type == TokenType::PUBLIC || token._type == TokenType::PRIVATE {
            this.Advance();

            if token._type == TokenType::TILDE {
                name += token.value;
            }
        }

        if this.Match(TokenType::OPERATOR) {
            name += "op";

            while this.Current()._type != TokenType::LPAREN {
                name += this.Current().value;
                this.Advance();
            }
        } else {
            let identifier: Token = this.Expect(TokenType::IDENTIFIER);
            if identifier._type == TokenType::UNKNOWN { ret null; }
            name += identifier.value;
        }

        let function_type: *mut FunctionTypeNode = new FunctionTypeNode(token);
        let function: *mut FunctionNode = new FunctionNode(name, function_type, no_mangle, token);
        let types: Vector<String> = this.types;

        if this.Match(TokenType::LESS) {
            function->generic = true;

            while this.Current()._type != TokenType::GREATER {
                let type_name: Token = this.Expect(TokenType::IDENTIFIER);

                if type_name._type == TokenType::UNKNOWN {
                    this.types = types;
                    ret null;
                }

                function->types.PushBack(type_name.value);
                this.types.PushBack(type_name.value);
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.Expect2(TokenType::GREATER) {
                this.types = types;
                ret null;
            }
        }

        if !this.Expect2(TokenType::LPAREN) {
            this.types = types;
            ret null;
        }

        if this.Current()._type != TokenType::RPAREN {
            let mut has_instance: bool = true;

            if this.Match(TokenType::BITWISE_AND) {
                let mutable: bool = this.Match(TokenType::MUT);
                if !this.Expect2(TokenType::THIS) { this.types = types; ret null; }
                function_type->instance_kind = mutable ? InstanceKind::MutRef : InstanceKind::ConstRef;
            } else if this.Match(TokenType::THIS) {
                function_type->instance_kind = InstanceKind::Copy;
            } else {
                has_instance = false;
            }

            if !has_instance || this.Match(TokenType::COMMA) {
                while this.Current()._type != TokenType::EOF {
                    if this.Peek(1u64)._type == TokenType::THREE_DOT {
                        let pack_name: Token = this.Expect(TokenType::IDENTIFIER);

                        if pack_name._type == TokenType::UNKNOWN {
                            this.types = types;
                            ret null;
                        }

                        function_type->pack_name = pack_name.value;
                        this.Advance();
                        break;
                    }

                    if this.Match(TokenType::THREE_DOT) {
                        function_type->var_arg = true;
                        break;
                    }

                    let param: *const ParameterNode = this.ParseParameter();
                    if param == null { this.types = types; ret null; }
                    function_type->parameters.PushBack(param);

                    if !this.Match(TokenType::COMMA) {
                        break;
                    }
                }
            }
        }

        if !this.Expect2(TokenType::RPAREN) {
            this.types = types;
            ret null;
        }

        if this.Match(TokenType::ASYNC) {
            function->_async = true;
        }

        if this.Match(TokenType::ARROW) {
            function_type->return_type = this.ParseType();

            if function_type->return_type == null {
                this.types = types;
                ret null;
            }
        } else {
            function_type->return_type = new PrimitiveTypeNode({ "void" } as String, token);

            if token._type != TokenType::FUNC && token._type != TokenType::PUBLIC && token._type != TokenType::PRIVATE {
                while (this.Match(TokenType::COLON) && function->constructors.Empty()) || (this.Match(TokenType::COMMA) && !function->constructors.Empty()) {
                    let expression: *const Node = this.ParseExpression();

                    if expression == null {
                        this.types = types;
                        ret null;
                    }

                    if expression->_type == NodeType::CALL {
                        function->constructors.PushBack(expression as *const CallNode);
                    } else {
                        Logger::Log("Expected a function call.", token, LogSeverity::Error);
                        break;
                    }
                }
            }
        }

        if this.Current()._type == TokenType::LBRACE {
            let body: *const Node = this.ParseBlock();
            this.types = types;
            if body == null { ret null; }
            function->body = body as *const BlockNode;
        } else {
            this.types = types;
            if !this.Expect2(TokenType::SEMICOLON) { ret null; }
        } ret function as *const Node;
    }

    priv ParseParameter(&mut this) -> *const ParameterNode {
        let mutable: bool = this.Match(TokenType::MUT);
        let token: Token = this.Expect(TokenType::IDENTIFIER);
        if token._type == TokenType::UNKNOWN { ret null; }
        let mut sizes: Vector<*const Node>;

        while this.Match(TokenType::LBRACKET) {
            if this.Match(TokenType::RBRACKET) {
                sizes.PushBack(null);
            } else {
                let expression: *const Node = this.ParseExpression();
                if expression == null || !this.Expect2(TokenType::RBRACKET) { ret null; }
                sizes.PushBack(expression);
            }
        }

        if !this.Expect2(TokenType::COLON) { ret null; }
        let mut _type: *const Node = this.ParseType();
        if _type == null { ret null; }

        for size in sizes {
            _type = new ArrayTypeNode(_type, size, token);
        }

        ret new ParameterNode(token.value, _type, mutable, token);
    }

    priv ParseClass(&mut this, attributes: &Vector<Pair<String, Vector<*const Node>>>) -> *const Node {
        let token: Token = this.Expect(TokenType::CLASS);
        if token._type == TokenType::UNKNOWN { ret null; }

        for attribute in attributes {
            Logger::Log("Invalid attribute '" + attribute.left + "'.", token, LogSeverity::Error);
            ret null;
        }

        let identifier: Token = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { ret null; }
        let class_node: *mut ClassNode = new ClassNode(identifier.value, token);
        let types: Vector<String> = this.types;

        if this.Match(TokenType::LESS) {
            class_node->generic = true;

            while this.Current()._type != TokenType::GREATER {
                let type_name: Token = this.Expect(TokenType::IDENTIFIER);

                if type_name._type == TokenType::UNKNOWN {
                    this.types = types;
                    ret null;
                }

                class_node->types.PushBack(type_name.value);
                this.types.PushBack(type_name.value);
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.Expect2(TokenType::GREATER) {
                this.types = types;
                ret null;
            }
        }

        if this.Match(TokenType::COLON) {
            let _type: *const Node = this.ParseType();
            if _type == null { this.types = types; ret null; }
            class_node->parents.PushBack(_type);

            while this.Match(TokenType::COMMA) {
                let _type: *const Node = this.ParseType();
                if _type == null { this.types = types; ret null; }
                class_node->parents.PushBack(_type);
            }
        }

        if !this.Expect2(TokenType::LBRACE) {
            this.types = types;
            ret null;
        }

        let mut state: bool = false;

        if this.Current()._type == TokenType::PUBLIC || this.Current()._type == TokenType::PRIVATE {
            if this.Peek(1u64)._type == TokenType::IDENTIFIER {
                if this.Peek(2u64)._type == TokenType::COLON || this.Peek(2u64)._type == TokenType::LBRACKET {
                    state = true;
                }
            }
        }

        if state {
            while this.Current()._type != TokenType::SEMICOLON && this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                let visibility: Token = this.Current();

                if visibility._type == TokenType::PUBLIC || visibility._type == TokenType::PRIVATE {
                    this.Advance();
                } else {
                    Logger::Log("Expected visibility modifier.", visibility, LogSeverity::Error);
                    this.types = types;
                    ret null;
                }

                if this.Current()._type == TokenType::IDENTIFIER {
                    let field: *const FieldNode = this.ParseField();
                    if field == null { this.types = types; ret null; }
                    class_node->fields.PushBack(Pair<TokenType, *const FieldNode>(visibility._type, field));
                } else {
                    Logger::Log("Expected field declaration.", this.Current(), LogSeverity::Error);
                    this.types = types;
                    ret null;
                }

                if !this.Match(TokenType::COMMA) {
                    break;
                }
            }
        }

        if !state || this.Match(TokenType::SEMICOLON) {
            while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                let attributes: Vector<Pair<String, Vector<*const Node>>> = this.ParseAttributes();
                let visibility: Token = this.Current();

                if visibility._type == TokenType::PUBLIC || visibility._type == TokenType::PRIVATE {
                    let function: *const Node = this.ParseFunction(attributes);
                    if function == null { this.types = types; ret null; }
                    class_node->methods.PushBack(Pair<TokenType, *const FunctionNode>(visibility._type, function as *const FunctionNode));
                } else {
                    if this.Current()._type == TokenType::TILDE {
                        if class_node->destructor != null {
                            Logger::Log("Multiple destructor declarations are not allowed.", visibility, LogSeverity::Error);
                            this.types = types;
                            ret null;
                        }

                        let function: *const Node = this.ParseFunction(attributes);
                        if function == null { this.types = types; ret null; }
                        class_node->destructor = function as *const FunctionNode;
                    } else {
                        let function: *const Node = this.ParseFunction(attributes);
                        if function == null { this.types = types; ret null; }
                        class_node->constructors.PushBack(function as *const FunctionNode);
                    }
                }
            }
        }

        this.types = types;
        if !this.Expect2(TokenType::RBRACE) { ret null; }
        ret class_node as *const Node;
    }

    priv ParseField(&mut this) -> *const FieldNode {
        let token: Token = this.Expect(TokenType::IDENTIFIER);
        if token._type == TokenType::UNKNOWN { ret null; }
        let mut sizes: Vector<*const Node>;

        while this.Match(TokenType::LBRACKET) {
            if this.Match(TokenType::RBRACKET) {
                sizes.PushBack(null);
            } else {
                let expression: *const Node = this.ParseExpression();
                if expression == null || !this.Expect2(TokenType::RBRACKET) { ret null; }
                sizes.PushBack(expression);
            }
        }

        if !this.Expect2(TokenType::COLON) { ret null; }
        let mut _type: *const Node = this.ParseType();
        if _type == null { ret null; }
        let mut initializer: *const Node = null;

        for size in sizes {
            _type = new ArrayTypeNode(_type, size, token);
        }

        if this.Match(TokenType::ASSIGN) {
            initializer = this.ParseExpression();
            if initializer == null { ret null; }
        }

        ret new FieldNode(token.value, _type, initializer, token);
    }

    priv ParseEnum(&mut this, attributes: &Vector<Pair<String, Vector<*const Node>>>) -> *const Node {
        let token: Token = this.Expect(TokenType::ENUM);
        if token._type == TokenType::UNKNOWN { ret null; }

        for attribute in attributes {
            Logger::Log("Invalid attribute '" + attribute.left + "'.", token, LogSeverity::Error);
            ret null;
        }

        let identifier: Token = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { ret null; }
        let enum_node: *mut EnumNode = new EnumNode(identifier.value, token);
        let types: Vector<String> = this.types;

        if this.Match(TokenType::LESS) {
            enum_node->generic = true;

            while this.Current()._type != TokenType::GREATER {
                let type_name: Token = this.Expect(TokenType::IDENTIFIER);

                if type_name._type == TokenType::UNKNOWN {
                    this.types = types;
                    ret null;
                }

                enum_node->types.PushBack(type_name.value);
                this.types.PushBack(type_name.value);
                if !this.Match(TokenType::COMMA) { break; }
            }

            if !this.Expect2(TokenType::GREATER) {
                this.types = types;
                ret null;
            }
        }

        if this.Match(TokenType::COLON) {
            enum_node->underlying_type = this.ParseType();

            if enum_node->underlying_type == null {
                this.types = types;
                ret null;
            }
        } else {
            enum_node->variant = true;
        }

        if !this.Expect2(TokenType::LBRACE) {
            this.types = types;
            ret null;
        }

        while this.Current()._type != TokenType::SEMICOLON && this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
            let variant_identifier: Token = this.Expect(TokenType::IDENTIFIER);
            if variant_identifier._type == TokenType::UNKNOWN { this.types = types; ret null; }
            let variant: *mut VariantNode = new VariantNode(variant_identifier.value, variant_identifier);

            if this.Match(TokenType::LBRACE) {
                while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                    let field_name: Token = this.Expect(TokenType::IDENTIFIER);
                    if field_name._type == TokenType::UNKNOWN { this.types = types; ret null; }
                    if !this.Expect2(TokenType::COLON) { this.types = types; ret null; }
                    variant->field_names.PushBack(field_name.value);
                    let _type: *const Node = this.ParseType();
                    if _type == null { this.types = types; ret null; }
                    variant->types.PushBack(_type);
                    if !this.Match(TokenType::COMMA) { break; }
                }

                if !this.Expect2(TokenType::RBRACE) {
                    this.types = types;
                    ret null;
                }
            } else if this.Match(TokenType::LPAREN) {
                let variant_type: *const Node = this.ParseType();
                if variant_type == null { this.types = types; ret null; }
                variant->types.PushBack(variant_type);

                while this.Match(TokenType::COMMA) {
                    let variant_type: *const Node = this.ParseType();
                    if variant_type == null { this.types = types; ret null; }
                    variant->types.PushBack(variant_type);
                }

                if !this.Expect2(TokenType::RPAREN) {
                    this.types = types;
                    ret null;
                }
            } else if this.Match(TokenType::ASSIGN) {
                if enum_node->variant {
                    Logger::Log("Explicit value assignment is not allowed for variant enums.", variant_identifier, LogSeverity::Error);
                    this.types = types;
                    ret null;
                }

                variant->value = this.ParseExpression();

                if variant->value == null {
                    this.types = types;
                    ret null;
                }
            }

            if !enum_node->variant && !variant->types.Empty() {
                Logger::Log("Data fields are only allowed in variant enums.", variant_identifier, LogSeverity::Error);
                this.types = types;
                ret null;
            }

            enum_node->variants.PushBack(variant);

            if !this.Match(TokenType::COMMA) {
                break;
            }
        }

        if this.Match(TokenType::SEMICOLON) {
            while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
                let attributes: Vector<Pair<String, Vector<*const Node>>> = this.ParseAttributes();
                let visibility: Token = this.Current();

                if visibility._type == TokenType::PUBLIC || visibility._type == TokenType::PRIVATE {
                    let function: *const Node = this.ParseFunction(attributes);
                    if function == null { this.types = types; ret null; }
                    enum_node->methods.PushBack(Pair<TokenType, *const FunctionNode>(visibility._type, function as *const FunctionNode));
                } else {
                    Logger::Log("Expected visibility modifier.", visibility, LogSeverity::Error);
                    this.types = types;
                    ret null;
                }
            }
        }

        this.types = types;
        if !this.Expect2(TokenType::RBRACE) { ret null; }
        ret enum_node as *const Node;
    }

    priv ParseExtern(&mut this) -> *const Node {
        let extern_token: Token = this.Expect(TokenType::EXTERN);
        if extern_token._type == TokenType::UNKNOWN { ret null; }
        let linkage_token: Token = this.Expect(TokenType::STRING);
        if linkage_token._type == TokenType::UNKNOWN { ret null; }
        let extern_block: *mut ExternNode = new ExternNode(linkage_token.value, extern_token);
        if !this.Expect2(TokenType::LBRACE) { ret null; }

        while this.Current()._type != TokenType::RBRACE && this.Current()._type != TokenType::EOF {
            let attributes: Vector<Pair<String, Vector<*const Node>>> = this.ParseAttributes();

            if this.Current()._type == TokenType::FUNC {
                let function: *const Node = this.ParseFunction(attributes);

                if function == null {
                    this.SynchronizeDeclaration();
                    continue;
                }

                extern_block->declarations.PushBack(function);
            } else if this.Current()._type == TokenType::STATIC {
                let _static: *const Node = this.ParseStatic(attributes);

                if _static == null {
                    this.SynchronizeDeclaration();
                    continue;
                }

                extern_block->declarations.PushBack(_static);
            } else {
                Logger::Log("Only function and static declarations allowed in extern block.", this.Current(), LogSeverity::Error);
                this.Advance();
                this.SynchronizeDeclaration();
            }
        }

        if !this.Expect2(TokenType::RBRACE) { ret null; }
        ret extern_block as *const Node;
    }

    priv ParseConstant(&mut this) -> *const Node {
        let token: Token = this.Expect(TokenType::CONST);
        if token._type == TokenType::UNKNOWN { ret null; }
        let identifier: Token = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { ret null; }
        let mut sizes: Vector<*const Node>;

        while this.Match(TokenType::LBRACKET) {
            if this.Match(TokenType::RBRACKET) {
                sizes.PushBack(null);
            } else {
                let expression: *const Node = this.ParseExpression();
                if expression == null || !this.Expect2(TokenType::RBRACKET) { ret null; }
                sizes.PushBack(expression);
            }
        }

        if !this.Expect2(TokenType::COLON) { ret null; }
        let mut _type: *const Node = this.ParseType();
        if _type == null { ret null; }

        for size in sizes {
            _type = new ArrayTypeNode(_type, size, token);
        }

        if !this.Expect2(TokenType::ASSIGN) { ret null; }
        let initializer: *const Node = this.ParseExpression();
        if initializer == null || !this.Expect2(TokenType::SEMICOLON) { ret null; }
        ret new ConstantNode(identifier.value, _type, initializer, token) as *const Node;
    }

    priv ParseStatic(&mut this, attributes: &Vector<Pair<String, Vector<*const Node>>>) -> *const Node {
        let token: Token = this.Expect(TokenType::STATIC);
        if token._type == TokenType::UNKNOWN { ret null; }
        let mut alignment: *const Node = null;

        for attribute in attributes {
            if attribute.left == "align" {
                if attribute.right.Size() != 1u64 {
                    Logger::Log("Invalid number of arguments for attribute '" + attribute.left + "'.", token, LogSeverity::Error);
                    ret null;
                }

                if alignment != null {
                    Logger::Log("Attribute '" + attribute.left + "' already set.", token, LogSeverity::Error);
                    ret null;
                }

                alignment = attribute.right[0u64];
            } else {
                Logger::Log("Invalid attribute '" + attribute.left + "'.", token, LogSeverity::Error);
                ret null;
            }
        }

        let mutable: bool = this.Match(TokenType::MUT);
        let identifier: Token = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { ret null; }
        let mut sizes: Vector<*const Node>;

        while this.Match(TokenType::LBRACKET) {
            if this.Match(TokenType::RBRACKET) {
                sizes.PushBack(null);
            } else {
                let expression: *const Node = this.ParseExpression();
                if expression == null || !this.Expect2(TokenType::RBRACKET) { ret null; }
                sizes.PushBack(expression);
            }
        }

        if !this.Expect2(TokenType::COLON) { ret null; }
        let mut _type: *const Node = this.ParseType();
        if _type == null { ret null; }

        for size in sizes {
            _type = new ArrayTypeNode(_type, size, token);
        }

        let _static: *mut StaticNode = new StaticNode(identifier.value, _type, mutable, alignment, token);

        if this.Match(TokenType::ASSIGN) {
            if this.Match(TokenType::ZERO) {
                _static->zero_initializer = true;
            } else {
                _static->initializer = this.ParseExpression();
                if _static->initializer == null { ret null; }
            }
        }

        if !this.Expect2(TokenType::SEMICOLON) { ret null; }
        ret _static as *const Node;
    }

    priv ParseTypeDefinition(&mut this) -> *const Node {
        let token: Token = this.Expect(TokenType::TYPE);
        if token._type == TokenType::UNKNOWN { ret null; }
        let identifier: Token = this.Expect(TokenType::IDENTIFIER);
        if identifier._type == TokenType::UNKNOWN { ret null; }
        if !this.Expect2(TokenType::ASSIGN) { ret null; }
        let _type: *const Node = this.ParseType();
        if _type == null { ret null; }
        let type_definition: *const TypeDefinitionNode = new TypeDefinitionNode(identifier.value, _type, token);
        if !this.Expect2(TokenType::SEMICOLON) { ret null; }
        ret type_definition as *const Node;
    }

    pub Parse(&mut this, tokens: &Vector<Token>) -> *const RootNode {
        (this.tokens, this.index) = (tokens, 0u64);
        let root: *mut RootNode = new RootNode();

        this.types.Clear();
        this.types.PushBack(String("bool"));
        this.types.PushBack(String("i8"));
        this.types.PushBack(String("i16"));
        this.types.PushBack(String("i32"));
        this.types.PushBack(String("i64"));
        this.types.PushBack(String("i128"));
        this.types.PushBack(String("u8"));
        this.types.PushBack(String("u16"));
        this.types.PushBack(String("u32"));
        this.types.PushBack(String("u64"));
        this.types.PushBack(String("u128"));
        this.types.PushBack(String("f32"));
        this.types.PushBack(String("f64"));
        this.types.PushBack(String("void"));

        loop {
            let token: Token = this.Advance();

            if token._type == TokenType::CLASS || token._type == TokenType::ENUM || token._type == TokenType::TYPE {
                let identifier: Token = this.Expect(TokenType::IDENTIFIER);
                if identifier._type == TokenType::UNKNOWN { continue; }

                if this.types.Index(identifier.value) != -1i64 {
                    Logger::Log("Type '" + identifier.value + "' is overloaded.", identifier, LogSeverity::Error);
                } else {
                    this.types.PushBack(identifier.value);
                }
            } else if token._type == TokenType::EOF {
                this.index = 0u64;
                break;
            }
        }

        while this.Current()._type != TokenType::EOF {
            let declaration: *const Node = this.ParseDeclaration();

            if declaration != null {
                root->declarations.PushBack(declaration);
            } else {
                this.SynchronizeDeclaration();
            }
        } ret root;
    }
}
