func AtomicMemoryFence() {
    volatile asm {
        mfence
    } : memory;
}

func AtomicLoadFence() {
    volatile asm {
        lfence
    } : memory;
}

func AtomicStoreFence() {
    volatile asm {
        sfence
    } : memory;
}

func AtomicPause() {
    volatile asm {
        pause
    };
}

class Atomic<T> {
    priv value: T;

    pub Atomic(&mut this) {}

    pub Atomic(&mut this, value: T) {
        this.value = value;
    }

    pub Load(&this) -> T {
        if sizeof(T) == 1u64 {
            ret AtomicLoad8(&this.value as *const u8) as T;
        } else if sizeof(T) == 2u64 {
            ret AtomicLoad16(&this.value as *const i16) as T;
        } else if sizeof(T) == 4u64 {
            ret AtomicLoad32(&this.value as *const u32) as T;
        } else if sizeof(T) == 8u64 {
            ret AtomicLoad64(&this.value as *const u64) as T;
        } else {
            AtomicLoadFence();
            let value: T = this.value;
            AtomicLoadFence();
            ret value;
        }
    }

    pub Store(&mut this, value: T) {
        if sizeof(T) == 1u64 {
            AtomicExchange8(&this.value as *mut u8, value as u8);
        } else if sizeof(T) == 2u64 {
            AtomicExchange16(&this.value as *mut i16, value as i16);
        } else if sizeof(T) == 4u64 {
            AtomicExchange32(&this.value as *mut u32, value as u32);
        } else if sizeof(T) == 8u64 {
            AtomicExchange64(&this.value as *mut u64, value as u64);
        } else {
            AtomicStoreFence();
            this.value = value;
            AtomicStoreFence();
        }
    }

    pub Exchange(&mut this, value: T) -> T {
        if sizeof(T) == 1u64 {
            ret AtomicExchange8(&this.value as *mut u8, value as u8) as T;
        } else if sizeof(T) == 2u64 {
            ret AtomicExchange16(&this.value as *mut i16, value as i16) as T;
        } else if sizeof(T) == 4u64 {
            ret AtomicExchange32(&this.value as *mut u32, value as u32) as T;
        } else if sizeof(T) == 8u64 {
            ret AtomicExchange64(&this.value as *mut u64, value as u64) as T;
        } else {
            AtomicStoreFence();
            let mut old: T = this.value;
            this.value = value;
            AtomicStoreFence();
            ret old;
        }
    }

    pub CompareExchange(&mut this, expected: T, desired: T) -> bool {
        if sizeof(T) == 1u64 {
            ret AtomicCompareExchangeBool8(&this.value as *mut u8, expected as u8, desired as u8);
        } else if sizeof(T) == 2u64 {
            ret AtomicCompareExchangeBool16(&this.value as *mut i16, expected as i16, desired as i16);
        } else if sizeof(T) == 4u64 {
            ret AtomicCompareExchangeBool32(&this.value as *mut u32, expected as u32, desired as u32);
        } else if sizeof(T) == 8u64 {
            ret AtomicCompareExchangeBool64(&this.value as *mut u64, expected as u64, desired as u64);
        } else {
            AtomicMemoryFence();

            if this.value == expected {
                this.value = desired;
                AtomicMemoryFence();
                ret true;
            } else {
                AtomicMemoryFence();
                ret false;
            }
        }
    }

    pub op==(&this, other: T) -> bool {
        ret this.Load() == other;
    }

    pub op!=(&this, other: T) -> bool {
        ret this.Load() != other;
    }

    pub op==(&this, other: &Atomic<T>) -> bool {
        ret this.Load() == other.Load();
    }

    pub op!=(&this, other: &Atomic<T>) -> bool {
        ret this.Load() != other.Load();
    }

    pub op=(&mut this, value: T) -> &mut Atomic<T> {
        this.Store(value);
        ret this;
    }
}
