func AtomicIncrement8(target: *mut u8) {
    volatile asm : rdi(target) -> {
        lock incb (%rdi)
    } : memory;
}

func AtomicIncrement16(target: *mut i16) {
    volatile asm : rdi(target) -> {
        lock incw (%rdi)
    } : memory;
}

func AtomicIncrement32(target: *mut u32) {
    volatile asm : rdi(target) -> {
        lock incl (%rdi)
    } : memory;
}

func AtomicIncrement64(target: *mut u64) {
    volatile asm : rdi(target) -> {
        lock incq (%rdi)
    } : memory;
}

func AtomicDecrement8(target: *mut u8) {
    volatile asm : rdi(target) -> {
        lock decb (%rdi)
    } : memory;
}

func AtomicDecrement16(target: *mut i16) {
    volatile asm : rdi(target) -> {
        lock decw (%rdi)
    } : memory;
}

func AtomicDecrement32(target: *mut u32) {
    volatile asm : rdi(target) -> {
        lock decl (%rdi)
    } : memory;
}

func AtomicDecrement64(target: *mut u64) {
    volatile asm : rdi(target) -> {
        lock decq (%rdi)
    } : memory;
}

func AtomicBitTestAndSet32(target: *mut u32, bit: u8) -> bool {
    let result: u8 = 0u8;

    volatile asm : rdi(target), sil(bit) -> {
        lock btsl %esi, (%rdi)
        setc %al
    } -> al(result) : memory;

    ret result != 0u8;
}

func AtomicBitTestAndSet64(target: *mut u64, bit: u8) -> bool {
    let result: u8 = 0u8;

    volatile asm : rdi(target), sil(bit) -> {
        lock btsq %rsi, (%rdi)
        setc %al
    } -> al(result) : memory;

    ret result != 0u8;
}

func AtomicBitTestAndReset32(target: *mut u32, bit: u8) -> bool {
    let result: u8 = 0u8;

    volatile asm : rdi(target), sil(bit) -> {
        lock btrl %esi, (%rdi)
        setc %al
    } -> al(result) : memory;

    ret result != 0u8;
}

func AtomicBitTestAndReset64(target: *mut u64, bit: u8) -> bool {
    let result: u8 = 0u8;

    volatile asm : rdi(target), sil(bit) -> {
        lock btrq %rsi, (%rdi)
        setc %al
    } -> al(result) : memory;

    ret result != 0u8;
}

