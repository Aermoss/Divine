#[include "std/io", "std/str", "std/opt", "std/res" : *]

func Divide(a: f64, b: f64) -> Result<f64, *const i8> {
    if b == 0.0 {
        ret Result<f64, *const i8>::Err("division by zero");
    }

    ret Result<f64, *const i8>::Ok(a / b);
}

func Find(haystack: *const i8, needle: i8) -> Option<usize> {
    let mut i: usize = 0;

    while haystack[i] != '\0' {
        if haystack[i] == needle {
            ret Option<usize>::Some(i);
        } i += 1;
    }

    ret Option<usize>::None;
}

func main(args: &mut Vector<String>) -> i32 {
    let result = Divide(10.0, 3.0);

    match result {
        Result::Ok(value) => WriteLine("10 / 3 = " + String(value)),
        Result::Err(message) => WriteLine("Error: " + message.ToString())
    }

    let error = Divide(1.0, 0.0);

    match error {
        Result::Ok(value) => WriteLine("Result: " + String(value)),
        Result::Err(message) => WriteLine("Error: " + message.ToString() + " (expected)")
    }

    let found = Find("hello", 'l');

    match found {
        Option::Some(index) => WriteLine("Found at index: " + String(index as u64)),
        Option::None => WriteLine("Not found")
    }

    let missing = Find("hello", 'z');

    if let Option::Some(index) = missing {
        WriteLine("Found at: " + String(index as u64));
    } else {
        WriteLine("Not found (expected)");
    }

    ret 0;
}
