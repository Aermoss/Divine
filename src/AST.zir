#[include "std/str", "std/vec", "std/map", "std/pair", "src/Tokens.zir" : *]

enum ASTNodeKind: i32 {
    Path, Declaration, Statement, Expression, Type
}

fn ToString(kind: ASTNodeKind) -> String {
    if kind == ASTNodeKind::Path { return "Path".ToString(); }
    else if kind == ASTNodeKind::Declaration { return "Declaration".ToString(); }
    else if kind == ASTNodeKind::Statement { return "Statement".ToString(); }
    else if kind == ASTNodeKind::Expression { return "Expression".ToString(); }
    else if kind == ASTNodeKind::Type { return "Type".ToString(); }
    else { return "Unknown".ToString(); }
}

class ASTNode {
    pub kind: ASTNodeKind,
    pub start: Token,
    pub end: Token;

    ASTNode(&mut this, kind: ASTNodeKind, start: Token) {
        (this.kind, this.start) = (kind, start);
    }
}

class ASTPathSegment {
    pub name: String,
    pub types: Vector<*ASTType>;

    ASTPathSegment(&mut this, name: String) {
        this.name = name;
    }
}

class ASTPath : ASTNode {
    pub segments: Vector<ASTPathSegment>,
    pub absolute: bool;

    ASTPath(&mut this, absolute: bool, start: Token) : ASTNode(ASTNodeKind::Path, start) {
        this.absolute = absolute;
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        if this.absolute {
            result += "::";
        }

        for i in 0..this.segments.Size() {
            let segment = this.segments[i];
            result += segment.name;

            if !segment.types.Empty() {
                result += "<";

                for j in 0..segment.types.Size() {
                    let _type = segment.types[j];
                    result += _type->kind.ToString();

                    if j < segment.types.Size() - 1 {
                        result += ", ";
                    }
                }

                result += ">";
            }

            if i < this.segments.Size() - 1 {
                result += "::";
            }
        } return result;
    }
}

enum ASTTypeKind: u8 {
    Path, Pointer, Reference, Array, Function
}

fn ToString(kind: ASTTypeKind) -> String {
    if kind == ASTTypeKind::Path { return "Path".ToString(); }
    else if kind == ASTTypeKind::Pointer { return "Pointer".ToString(); }
    else if kind == ASTTypeKind::Reference { return "Reference".ToString(); }
    else if kind == ASTTypeKind::Array { return "Array".ToString(); }
    else if kind == ASTTypeKind::Function { return "Function".ToString(); }
    else { return "Unknown".ToString(); }
}

class ASTType : ASTNode {
    pub kind: ASTTypeKind;

    ASTType(&mut this, kind: ASTTypeKind, start: Token) : ASTNode(ASTNodeKind::Type, start) {
        this.kind = kind;
    }
}

class ASTPathType : ASTType {
    pub path: *ASTPath;

    ASTPathType(&mut this, path: *ASTPath, start: Token) : ASTType(ASTTypeKind::Path, start) {
        this.path = path;
    }
}

class ASTPointerType : ASTType {
    pub base_type: *ASTType,
    pub mutable: bool;

    ASTPointerType(&mut this, base_type: *ASTType, mutable: bool, start: Token) : ASTType(ASTTypeKind::Pointer, start) {
        (this.base_type, this.mutable) = (base_type, mutable);
    }
}

class ASTReferenceType : ASTType {
    pub base_type: *ASTType,
    pub mutable: bool;

    ASTReferenceType(&mut this, base_type: *ASTType, mutable: bool, start: Token) : ASTType(ASTTypeKind::Reference, start) {
        (this.base_type, this.mutable) = (base_type, mutable);
    }
}

class ASTArrayType : ASTType {
    pub element_type: *ASTType,
    pub size: *ASTNode;

    ASTArrayType(&mut this, element_type: *ASTType, size: *ASTNode, start: Token) : ASTType(ASTTypeKind::Array, start) {
        (this.element_type, this.size) = (element_type, size);
    }
}

enum ASTInstanceKind: i32 {
    None, Copy, ConstRef, MutRef
}

class ASTFunctionType : ASTType {
    pub parameters: Vector<*ASTParameterDeclaration>,
    pub instance_kind: ASTInstanceKind = ::ASTInstanceKind::None,
    pub pack_name: String, pub var_arg: bool = false,
    pub return_type: *ASTType = null;

    ASTFunctionType(&mut this, start: Token) : ASTType(ASTTypeKind::Function, start) {}
}

enum ASTExpressionKind: u8 {
    Literal, InitializerList, StructureInitializer, Path, Unary, Binary, Ternary, Call,
    PackSplat, MemberAccess, IndexAccess, Cast, New, Delete, Assignment, Await, Tuple, Range
}

fn ToString(kind: ASTExpressionKind) -> String {
    if kind == ASTExpressionKind::Literal { return "Literal".ToString(); }
    else if kind == ASTExpressionKind::InitializerList { return "InitializerList".ToString(); }
    else if kind == ASTExpressionKind::StructureInitializer { return "StructureInitializer".ToString(); }
    else if kind == ASTExpressionKind::Path { return "Path".ToString(); }
    else if kind == ASTExpressionKind::Unary { return "Unary".ToString(); }
    else if kind == ASTExpressionKind::Binary { return "Binary".ToString(); }
    else if kind == ASTExpressionKind::Ternary { return "Ternary".ToString(); }
    else if kind == ASTExpressionKind::Call { return "Call".ToString(); }
    else if kind == ASTExpressionKind::PackSplat { return "PackSplat".ToString(); }
    else if kind == ASTExpressionKind::MemberAccess { return "MemberAccess".ToString(); }
    else if kind == ASTExpressionKind::IndexAccess { return "IndexAccess".ToString(); }
    else if kind == ASTExpressionKind::Cast { return "Cast".ToString(); }
    else if kind == ASTExpressionKind::New { return "New".ToString(); }
    else if kind == ASTExpressionKind::Delete { return "Delete".ToString(); }
    else if kind == ASTExpressionKind::Assignment { return "Assignment".ToString(); }
    else if kind == ASTExpressionKind::Await { return "Await".ToString(); }
    else if kind == ASTExpressionKind::Tuple { return "Tuple".ToString(); }
    else if kind == ASTExpressionKind::Range { return "Range".ToString(); }
    else { return "Unknown".ToString(); }
}

class ASTExpression : ASTNode {
    pub kind: ASTExpressionKind;

    ASTExpression(&mut this, kind: ASTExpressionKind, start: Token) : ASTNode(ASTNodeKind::Expression, start) {
        this.kind = kind;
    }
}

