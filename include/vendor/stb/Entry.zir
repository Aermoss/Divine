#[include "std/io" : *]

const STBI_VERSION: u64 = 1;

const STBI_default: i32 = 0;
const STBI_grey: i32 = 1;
const STBI_grey_alpha: i32 = 2;
const STBI_rgb: i32 = 3;
const STBI_rgb_alpha: i32 = 4;

type stbi_uc = u8;
type stbi_us = u16;

class stbi_io_callbacks {
    pub read: fn(user: *mut void, data: *mut i8, size: i32) -> i32,
    pub skip: fn(user: *mut void, n: i32) -> void,
    pub eof: fn(user: *mut void) -> i32
}

extern "C" {
    fn stbi_load_from_memory(buffer: *stbi_uc, len: i32, x: *mut i32, y: *mut i32, channels_in_file: *mut i32, desired_channels: i32) -> *mut stbi_uc;
    fn stbi_load_from_callbacks(clbk: *stbi_io_callbacks, user: *mut void, x: *mut i32, y: *mut i32, channels_in_file: *mut i32, desired_channels: i32) -> *mut stbi_uc;

    fn stbi_load(filename: *i8, x: *mut i32, y: *mut i32, channels_in_file: *mut i32, desired_channels: i32) -> *mut stbi_uc;
    fn stbi_load_from_file(f: *mut void, x: *mut i32, y: *mut i32, channels_in_file: *mut i32, desired_channels: i32) -> *mut stbi_uc;

    fn stbi_load_gif_from_memory(buffer: *stbi_uc, len: i32, delays: *mut *mut i32, x: *mut i32, y: *mut i32, z: *mut i32, comp: *mut i32, req_comp: i32) -> *mut stbi_uc;

    fn stbi_convert_wchar_to_utf8(buffer: *mut i8, bufferlen: u64, input: *u16) -> i32;

    fn stbi_load_16_from_memory(buffer: *stbi_uc, len: i32, x: *mut i32, y: *mut i32, channels_in_file: *mut i32, desired_channels: i32) -> *mut stbi_us;
    fn stbi_load_16_from_callbacks(clbk: *stbi_io_callbacks, user: *mut void, x: *mut i32, y: *mut i32, channels_in_file: *mut i32, desired_channels: i32) -> *mut stbi_us;

    fn stbi_load_16(filename: *i8, x: *mut i32, y: *mut i32, channels_in_file: *mut i32, desired_channels: i32) -> *mut stbi_us;
    fn stbi_load_from_file_16(f: *mut void, x: *mut i32, y: *mut i32, channels_in_file: *mut i32, desired_channels: i32) -> *mut stbi_us;

    fn stbi_loadf_from_memory(buffer: *stbi_uc, len: i32, x: *mut i32, y: *mut i32, channels_in_file: *mut i32, desired_channels: i32) -> *mut f32;
    fn stbi_loadf_from_callbacks(clbk: *stbi_io_callbacks, user: *mut void, x: *mut i32, y: *mut i32, channels_in_file: *mut i32, desired_channels: i32) -> *mut f32;

    fn stbi_loadf(filename: *i8, x: *mut i32, y: *mut i32, channels_in_file: *mut i32, desired_channels: i32) -> *mut f32;
    fn stbi_loadf_from_file(f: *mut void, x: *mut i32, y: *mut i32, channels_in_file: *mut i32, desired_channels: i32) -> *mut f32;

    fn stbi_hdr_to_ldr_gamma(gamma: f32);
    fn stbi_hdr_to_ldr_scale(scale: f32);

    fn stbi_ldr_to_hdr_gamma(gamma: f32);
    fn stbi_ldr_to_hdr_scale(scale: f32);

    fn stbi_is_hdr_from_callbacks(clbk: *stbi_io_callbacks, user: *mut void) -> i32;
    fn stbi_is_hdr_from_memory(buffer: *stbi_uc, len: i32) -> i32;

    fn stbi_is_hdr(filename: *i8) -> i32;
    fn stbi_is_hdr_from_file(f: *mut void) -> i32;

    fn stbi_failure_reason() -> *i8;

    fn stbi_image_free(retval_from_stbi_load: *mut stbi_uc);

    fn stbi_info_from_memory(buffer: *stbi_uc, len: i32, x: *mut i32, y: *mut i32, comp: *mut i32) -> i32;
    fn stbi_info_from_callbacks(clbk: *stbi_io_callbacks, user: *mut void, x: *mut i32, y: *mut i32, comp: *mut i32) -> i32;

    fn stbi_is_16_bit_from_memory(buffer: *stbi_uc, len: i32) -> i32;
    fn stbi_is_16_bit_from_callbacks(clbk: *stbi_io_callbacks, user: *mut void) -> i32;

    fn stbi_info(filename: *i8, x: *mut i32, y: *mut i32, comp: *mut i32) -> i32;
    fn stbi_info_from_file(f: *mut void, x: *mut i32, y: *mut i32, comp: *mut i32) -> i32;

    fn stbi_is_16_bit(filename: *i8) -> i32;
    fn stbi_is_16_bit_from_file(f: *mut void) -> i32;

    fn stbi_set_unpremultiply_on_load(flag_true_if_should_unpremultiply: i32);
    fn stbi_convert_iphone_png_to_rgb(flag_true_if_should_convert: i32);
    fn stbi_set_flip_vertically_on_load(flag_true_if_should_flip: i32);

    fn stbi_set_unpremultiply_on_load_thread(flag_true_if_should_unpremultiply: i32);
    fn stbi_convert_iphone_png_to_rgb_thread(flag_true_if_should_convert: i32);
    fn stbi_set_flip_vertically_on_load_thread(flag_true_if_should_flip: i32);

    fn stbi_zlib_decode_malloc_guesssize(buffer: *i8, len: i32, initial_size: i32, outlen: *mut i32) -> *mut i8;
    fn stbi_zlib_decode_malloc_guesssize_headerflag(buffer: *i8, len: i32, initial_size: i32, outlen: *mut i32, parse_header: i32) -> *mut i8;
    fn stbi_zlib_decode_malloc(buffer: *i8, len: i32, outlen: *mut i32) -> *mut i8;
    fn stbi_zlib_decode_buffer(obuffer: *mut i8, olen: i32, ibuffer: *i8, ilen: i32) -> i32;

    fn stbi_zlib_decode_noheader_malloc(buffer: *i8, len: i32, outlen: *mut i32) -> *mut i8;
    fn stbi_zlib_decode_noheader_buffer(obuffer: *mut i8, olen: i32, ibuffer: *i8, ilen: i32) -> i32;
}