    pub name: String, pub parents: Vector<*ASTType>,
    pub fields: Vector<Pair<bool, *ASTFieldDeclaration>>,
    pub constructors: Vector<*ASTFunctionDeclaration>,
    pub destructor: *ASTFunctionDeclaration = null,
    pub methods: Vector<Pair<bool, *ASTFunctionDeclaration>>,
    pub types: Vector<String>, pub generic: bool = false;

    ASTClassDeclaration(&mut this, name: String, start: Token) : ASTDeclaration(ASTDeclarationKind::Class, start) {
        this.name = name;
    }
}

