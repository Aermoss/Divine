#[include "std/str", "std/vec", "std/map", "src/Types.zir" : *]

class Mangler {
    pub IsMangled(name: &String) -> bool {
        ret name.StartsWith("$z");
    }

    priv MangleType(_type: *const QualifiedType) -> String {
        let mut result: String;
        if _type->IsMutable() { result += "M"; }
        let kind = LLVMGetTypeKind(_type->Value());

        if kind == LLVMTypeKind::LLVMVoidTypeKind {
            result += "v";
        } else if kind == LLVMTypeKind::LLVMPointerTypeKind {
            result += (_type->IsReference() ? "R" : "P") + Mangler::MangleType(_type->Pointee());
        } else if kind == LLVMTypeKind::LLVMFunctionTypeKind {
            result += "F";
            let return = _type->Return();
            result += Mangler::MangleType(return.sret != null ? return.sret : return._type);

            for param in _type->Parameters() {
                result += Mangler::MangleType(param.sret != null ? param.sret : param.byval != null ? param.byval : param._type);
            }
        } else if kind == LLVMTypeKind::LLVMStructTypeKind {
            let mut name = LLVMGetStructName(_type->Value()).ToString();

            if !Mangler::IsMangled(name) {
                name = Mangler::MangleName(name);
            }
            
            let (mut start: usize, mut end) = (2, name.Length() - 1);

            while name[start] == 'N' && name[end] == 'E' {
                (start, end) = (start + 1, end - 1);
            }

            result += name.SubString(start, end - start + 1);
        } else if kind == LLVMTypeKind::LLVMIntegerTypeKind {
            let width = LLVMGetIntTypeWidth(_type->Value());
            result += width == 1 ? "b" : (width == 8 ? "c" : (width == 16 ? "s" : (width == 32 ? "i" : "l")));
        } else if kind == LLVMTypeKind::LLVMDoubleTypeKind {
            result += "d";
        } else if kind == LLVMTypeKind::LLVMFloatTypeKind {
            result += "f";
        } else {
            Logger::Log("Mangler", "Unknown type '" + _type->ToString() + "'.", LogSeverity::Error);
        } ret result;
    }

    priv MangleTypeSubstituted(_type: *const QualifiedType, substitution_table: &mut Map<*const QualifiedType, String>) -> String {
        for i in 0..substitution_table.Size() {
            let pair = substitution_table[i];

            if *_type == *pair.left {
                let mut left = _type;
                let mut right = pair.left;
                let mut equal = true;

                while left->IsPointer() {
                    if left->IsMutable() != right->IsMutable() { equal = false; }
                    (left, right) = (left->Pointee(), right->Pointee());
                }

                if equal {
                    ret "S" + String::FromInteger(i as u64) + "_";
                }
            }
        }

        let result = Mangler::MangleType(_type);

        if result.Length() >= String::FromInteger(substitution_table.Size() as u64).Length() + 2 {
            substitution_table[_type] = result;
        } ret result;
    }

    priv MangleName(name: String) -> String {
        let mut result = "$z".ToString();
        let mut names = compiler->scope_manager.Namespaces();
        names.PushBack(name);

        let mut name_result: String;
        let mut has_namespace = false;

        for name in names {
            if Mangler::IsMangled(name) {
                let (mut start: usize, mut end) = (2, name.Length() - 1);

                while name[start] == 'N' && name[end] == 'E' {
                    (start, end) = (start + 1, end - 1);
                }

                name_result += name.SubString(start, end - start + 1);
                has_namespace = true;
            } else {
                name_result += String::FromInteger(name.Length() as u64) + name;
            }
        }

        if names.Size() > 1 || has_namespace {
            result += "N";
        }

        result += name_result;

        if names.Size() > 1 || has_namespace {
            result += "E";
        } ret result;
    }

    pub MangleFunction(name: String, _type: *const QualifiedType, types: Vector<*const QualifiedType>) -> String {
        let mut result = "$z".ToString();
        let mut names = compiler->scope_manager.Namespaces();
        names.PushBack(name);

        let mut name_result: String;
        let mut has_namespace = false;

        for name in names {
            if Mangler::IsMangled(name) {
                let (mut start: usize, mut end) = (2, name.Length() - 1);

                while name[start] == 'N' && name[end] == 'E' {
                    (start, end) = (start + 1, end - 1);
                }

                name_result += name.SubString(start, end - start + 1);
                has_namespace = true;
            } else {
                name_result += String::FromInteger(name.Length() as u64) + name;
            }
        }

        if names.Size() > 1 || !types.Empty() || has_namespace {
            result += "N";
        }

        result += name_result;

        if !types.Empty() {
            result += "I";

            for _type in types {
                result += Mangler::MangleType(_type);
            } result += "E";
        }

        if names.Size() > 1 || !types.Empty() || has_namespace {
            result += "E";
        }

        let mut substitution_table: Map<*const QualifiedType, String>;

        for param in _type->Parameters() {
            result += Mangler::MangleTypeSubstituted(param.sret != null ? param.sret : param.byval != null ? param.byval : param._type, substitution_table);
        } ret result;
    }

    pub MangleClass(name: String, types: Vector<*const QualifiedType>) -> String {
        let mut result = "$z".ToString();
        let mut names = compiler->scope_manager.Namespaces();
        names.PushBack(name);

        let mut name_result: String;
        let mut has_namespace = false;

        for name in names {
            if Mangler::IsMangled(name) {
                let (mut start: usize, mut end) = (2, name.Length() - 1);

                while name[start] == 'N' && name[end] == 'E' {
                    (start, end) = (start + 1, end - 1);
                }

                name_result += name.SubString(start, end - start + 1);
                has_namespace = true;
            } else {
                name_result += String::FromInteger(name.Length() as u64) + name;
            }
        }

        if names.Size() > 1 || !types.Empty() || has_namespace {
            result += "N";
        }

        result += name_result;

        if !types.Empty() {
            result += "I";

            for _type in types {
                result += Mangler::MangleType(_type);
            } result += "E";
        }

        if names.Size() > 1 || !types.Empty() || has_namespace {
            result += "E";
        } ret result;
    }
}

#[include "src/Compiler.zir" : *]
