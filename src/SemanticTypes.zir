#[include "std/str", "std/vec", "std/map", "src/Nodes.zir", "src/HIR.zir",
    "src/SemanticGeneric.zir", "src/SemanticScope.zir", "src/Logger.zir" : *]

class SemanticField {
    pub index: usize,
    pub _type: *SemanticType,
    pub initializer: *Node,
    pub public: bool;

    SemanticField(&mut this, index: usize, _type: *SemanticType, initializer: *Node, public: bool) {
        (this.index, this._type, this.initializer, this.public) = (index, _type, initializer, public);
    }
}

class SemanticMethod {
    pub name: String,
    pub function: *HIRFunction,
    pub _static: bool,
    pub public: bool;

    SemanticMethod(&mut this, name: &String, function: *HIRFunction, _static: bool, public: bool) {
        (this.name, this.function, this._static, this.public) = (name, function, _static, public);
    }
}

enum SemanticTypeKind: u8 {
    Void, Boolean, Character,
    Integer, IntegerLiteral, Float, FloatLiteral,
    Pointer, Reference, Array,
    Function, Class, Structure,
    Enumeration, Variant
}

class SemanticType {
    pub kind: SemanticTypeKind,
    pub signed: bool = false,
    pub mutable: bool = false,
    pub width: u32 = 0,
    pub length: usize = 0,
    pub name: String,

    pub pointee: *SemanticType = null,

    pub fields: Map<String, SemanticField>,
    pub methods: Vector<SemanticMethod>,

    pub variants: Vector<Pair<String, Vector<*SemanticType>>>,
    pub variant_field_names: Vector<Vector<String>>,

    pub params: Vector<*SemanticType>,
    pub _return: *SemanticType = null;

    SemanticType(&mut this, kind: SemanticTypeKind) {
        this.kind = kind;
    }

    pub fn IsMutable(&this) -> bool { return this.mutable; }
    pub fn IsLiteral(&this) -> bool { return this.kind == SemanticTypeKind::IntegerLiteral || this.kind == SemanticTypeKind::FloatLiteral; }
    pub fn IsSigned(&this) -> bool { return this.signed; }

    pub fn IsVoid(&this) -> bool { return this.kind == SemanticTypeKind::Void; }
    pub fn IsBoolean(&this) -> bool { return this.kind == SemanticTypeKind::Boolean; }
    pub fn IsCharacter(&this) -> bool { return this.kind == SemanticTypeKind::Character; }
    pub fn IsInteger(&this) -> bool { return this.kind == SemanticTypeKind::Integer || this.kind == SemanticTypeKind::IntegerLiteral; }
    pub fn IsIntegerPointer(&this) -> bool { return this.kind == SemanticTypeKind::Integer && this.width == 0; }
    pub fn IsIntegerLiteral(&this) -> bool { return this.kind == SemanticTypeKind::IntegerLiteral; }
    pub fn IsFloat(&this) -> bool { return this.kind == SemanticTypeKind::Float || this.kind == SemanticTypeKind::FloatLiteral; }
    pub fn IsFloatLiteral(&this) -> bool { return this.kind == SemanticTypeKind::FloatLiteral; }
    pub fn IsPointer(&this) -> bool { return this.kind == SemanticTypeKind::Pointer || this.kind == SemanticTypeKind::Reference; }
    pub fn IsNullPointer(&this) -> bool { return this.kind == SemanticTypeKind::Pointer && this.pointee->kind == SemanticTypeKind::Void; }
    pub fn IsReference(&this) -> bool { return this.kind == SemanticTypeKind::Reference; }
    pub fn IsArray(&this) -> bool { return this.kind == SemanticTypeKind::Array; }
    pub fn IsFunction(&this) -> bool { return this.kind == SemanticTypeKind::Function; }
    pub fn IsClass(&this) -> bool { return this.kind == SemanticTypeKind::Class; }
    pub fn IsStructure(&this) -> bool { return this.kind == SemanticTypeKind::Structure; }
    pub fn IsEnumeration(&this) -> bool { return this.kind == SemanticTypeKind::Enumeration; }
    pub fn IsVariant(&this) -> bool { return this.kind == SemanticTypeKind::Variant; }

    pub fn IsTrivial(&this) -> bool {
        if this.IsBoolean() || this.IsCharacter() || this.IsInteger() || this.IsFloat() || this.IsPointer() {
            return true;
        }

        if this.IsArray() {
            return this.pointee->IsTrivial();
        }

        if this.IsFunction() {
            return false;
        }

        if this.HasFields() {
            for field in this.Fields() {
                if !field.right._type->IsTrivial() {
                    return false;
                }
            }
        }

        if this.HasMethods() {
            if !this.methods.Empty() {
                return false;
            }
        }

        if this.IsClass() || this.IsStructure() || this.IsEnumeration() {
            return true;
        }

        if this.IsVariant() {
            for variant in this.variants {
                for variant_field in variant.right {
                    if !variant_field->IsTrivial() {
                        return false;
                    }
                }
            } return true;
        } return false;
    }

    pub fn IsDerivedFrom(&this, other: &SemanticType) -> bool {
        for field in other.Fields() {
            if field.left == this.name {
                return true;
            }
        } return false;
    }

    pub fn IsCompatible(&this, other: &SemanticType) -> bool {
        if this.IsPointer() && other.IsPointer() {
            if this.Pointee().IsVoid() || other.IsNullPointer() {
                return true;
            } else if this.Pointee().IsClass() && other.Pointee().IsClass() {
                if this.Pointee().IsDerivedFrom(other.Pointee()) {
                    return true;
                }
            }
        } return this == other;
    }

    pub fn IsMutabilityCompatible(&this, other: &SemanticType) -> bool {
        let mut left: *SemanticType = this;
        let mut right: *SemanticType = other;

        while left->IsPointer() && right->IsPointer() {
            if left->IsMutable() && !right->IsMutable() && !right->IsNullPointer() {
                return false;
            }

            (left, right) = (left->Pointee(), right->Pointee());
        } return true;
    }

    pub fn IsSame(&this, other: &SemanticType) -> bool {
        let mut left: *SemanticType = this;
        let mut right: *SemanticType = other;

        while left->IsPointer() && right->IsPointer() {
            if left->IsMutable() != right->IsMutable() || left->IsReference() != right->IsReference() || right->IsNullPointer() {
                return false;
            }

            (left, right) = (left->Pointee(), right->Pointee());
        } return this == other;
    }

    pub fn ScorePointer(&this, other: &SemanticType, base: u64) -> u64 {
        let mut reference_mismatch = false;
        let mut mutability_mismatch = false;
        let mut left: *SemanticType = this;
        let mut right: *SemanticType = other;
        let mut score = base;

        while left->IsPointer() && right->IsPointer() {
            if left->IsMutable() && !right->IsMutable() && !right->IsNullPointer() {
                return 0;
            }

            mutability_mismatch |= left->IsMutable() != right->IsMutable();
            reference_mismatch |= left->IsReference() != right->IsReference();
            (left, right) = (left->Pointee(), right->Pointee());
        }

        if reference_mismatch { score -= 10; }
        if mutability_mismatch { score -= 1; }
        return score;
    }

    pub fn ScoreParameter(&this, other: &SemanticType) -> u64 {
        if other.IsLiteral() {
            if this.IsInteger() && other.IsInteger() {
                if this.width == other.width && this.signed == other.signed {
                    return 100;
                } return 1;
            } else if this.IsFloat() && other.IsFloat() {
                if this.width == other.width {
                    return 100;
                } return 1;
            } return 0;
        }

        if this == other {
            return this.ScorePointer(other, 100);
        }

        if this.IsReference() {
            let score = this.Pointee().ScoreParameter(other);
            if score != 0 { return score - 3; }
        }

        if other.IsReference() {
            let score = this.ScoreParameter(other.Pointee());
            if score != 0 { return score - 3; }
        }

        if this.IsPointer() && other.IsPointer() {
            if this.Pointee().IsVoid() || other.IsNullPointer() {
                return this.ScorePointer(other, 30);
            } else if this.Pointee().IsClass() && other.Pointee().IsClass() {
                if this.Pointee().IsDerivedFrom(other.Pointee()) {
                    return this.ScorePointer(other, 70);
                }
            }
        } return 0;
    }

    pub fn AsReference(&this) -> &SemanticType {
        if !this.IsPointer() {
            Logger::Log("SemanticType", "Not a pointer!", LogSeverity::Fatal);
        } return analyzer->type_manager.Reference(this.Pointee(), this.IsMutable());
    }

    pub fn Pointee(&this) -> &SemanticType {
        if !this.IsPointer() {
            Logger::Log("SemanticType", "Not a pointer!", LogSeverity::Fatal);
        } return this.pointee;
    }

    pub fn Width(&this) -> u32 {
        if !this.IsBoolean() && !this.IsCharacter() && !this.IsInteger() && !this.IsFloat() && !this.IsEnumeration() {
            Logger::Log("SemanticType", "Not a boolean, character, integer, float or enumeration!", LogSeverity::Fatal);
        } return this.width;
    }

    pub fn Length(&this) -> usize {
        if !this.IsArray() {
            Logger::Log("SemanticType", "Not an array!", LogSeverity::Fatal);
        } return this.length;
    }

    pub fn Element(&this) -> &SemanticType {
        if !this.IsArray() {
            Logger::Log("SemanticType", "Not an array!", LogSeverity::Fatal);
        } return this.pointee;
    }

    pub fn Parameters(&this) -> &Vector<*SemanticType> {
        if !this.IsFunction() {
            Logger::Log("SemanticType", "Not a function!", LogSeverity::Fatal);
        } return this.params;
    }

    pub fn Return(&this) -> &SemanticType {
        if !this.IsFunction() {
            Logger::Log("SemanticType", "Not a function!", LogSeverity::Fatal);
        } return this._return;
    }

    pub fn Fields(&this) -> &mut Map<String, SemanticField> {
        if !this.HasFields() {
            Logger::Log("SemanticType", "Not a class or structure!", LogSeverity::Fatal);
        }

        unsafe {
            return (this as &mut SemanticType).fields;
        }
    }

    pub fn HasFields(&this) -> bool {
        return this.IsClass() || this.IsStructure();
    }

    pub fn Index(&this, name: &String) -> isize {
        for field in this.Fields() {
            if field.left == name {
                return field.right.index as isize;
            }
        } return -1;
    }

    pub fn Methods(&this) -> &Vector<SemanticMethod> {
        if !this.HasMethods() {
            Logger::Log("SemanticType", "Not a class, structure or variant!", LogSeverity::Fatal);
        } return this.methods;
    }

    pub fn HasMethods(&this) -> bool {
        return this.IsClass() || this.IsStructure() || this.IsVariant();
    }

    pub fn Has(&this, name: &String) -> bool {
        for method in this.Methods() {
            if method.name == name {
                if method.public {
                    return true;
                }

                if analyzer->current_class != null {
                    if *analyzer->current_class == this {
                        return true;
                    }
                }
            }
        } return false;
    }

    pub fn Has(&this, name: &String, values: &Vector<SemanticValue>) -> bool {
        for method in this.Methods() {
            if method.name == name {
                let mut state = false;

                if analyzer->current_class != null {
                    state = *analyzer->current_class == this;
                }

                if method.public || state {
                    let params = method.function->_type->Parameters();
                    if values.Size() != params.Size() { continue; }
                    let mut _match = true;

                    for j in 0..params.Size() {
                        if params[j]->ScoreParameter(values[j].Type()) == 0 {
                            _match = false;
                            break;
                        }
                    }

                    if _match {
                        return true;
                    }
                }
            }
        } return false;
    }

    pub fn Get(&this, name: &String, node: *Node) -> *SemanticMethod {
        let mut state = 0;

        for method in this.Methods() {
            if method.name == name {
                let mut _state = false;

                if analyzer->current_class != null {
                    _state = *analyzer->current_class == this;
                }

                if !method.public && !_state {
                    if state < 1 { state = 1; }
                } else {
                    return &method;
                }
            }
        }

        if state == 0 {
            Logger::Log("Class '" + this.name + "' doesn't contain any member named '" + name + "'.", node, LogSeverity::Error);
            return null;
        } else {
            Logger::Log("Function '" + name + "' is not accessible.", node, LogSeverity::Error);
            return null;
        }
    }

    pub fn Get(&this, name: &String, values: &Vector<SemanticValue>, node: *Node) -> *SemanticMethod {
        let methods = this.Methods();
        let mut index: usize = 0;
        let mut best: u64 = 0;
        let mut state = 0;

        for i in 0..methods.Size() {
            let method = methods[i];

            if method.name == name {
                let mut _state = false;

                if analyzer->current_class != null {
                    _state = *analyzer->current_class == this;
                }

                if !method.public && !_state {
                    if state < 1 { state = 1; }
                } else {
                    let params = method.function->_type->Parameters();
                    if values.Size() != params.Size() { continue; }
                    let (mut _match, mut score: u64) = (true, 1);

                    for j in 0..params.Size() {
                        let param_score = params[j]->ScoreParameter(values[j].Type());

                        if param_score != 0 {
                            score += param_score;
                        } else {
                            _match = false;
                            break;
                        }
                    }

                    if !_match {
                        state = 2;
                    } else if score > best {
                        (index, best) = (i, score);
                    }
                }
            }
        }

        if best != 0 {
            return methods[index];
        } else {
            if state == 0 {
                if name == this.name {
                    Logger::Log("Class '" + this.name + "' does not define a constructor method.", node, LogSeverity::Error);
                } else {
                    Logger::Log("Class '" + this.name + "' doesn't contain any method named '" + name + "'.", node, LogSeverity::Error);
                } return null;
            } else if state == 1 {
                Logger::Log("Function '" + name + "' is not accessible.", node, LogSeverity::Error);
                return null;
            } else {
                Logger::Log("Invalid arguments for: '" + name + "'.", node, LogSeverity::Error);
                return null;
            }
        }
    }

    pub fn operator==(&this, other: &SemanticType) -> bool {
        if this.IsInteger() && other.IsInteger() {
            return this.signed == other.signed && this.width == other.width;
        } else if this.IsFloat() && other.IsFloat() {
            return this.width == other.width;
        } else if (this.IsPointer() || this.IsArray()) && (other.IsPointer() || other.IsArray()) {
            if this.pointee == other.pointee { return true; }
            return *this.pointee == *other.pointee;
        } else if this.IsFunction() && other.IsFunction() {
            if this.params.Size() != other.params.Size() {
                return false;
            }

            for i in 0..this.params.Size() {
                let (left, right) = (this.params[i], other.params[i]);

                if left != right {
                    if left == null || right == null { return false; }
                    if *left != *right { return false; }
                }
            }

            let (left, right) = (this._return, other._return);

            if left != right {
                if left == null || right == null { return false; }
                if *left != *right { return false; }
            } return true;
        } else {
            return this.kind == other.kind && this.name == other.name;
        }
    }

    pub fn operator!=(&this, other: &SemanticType) -> bool {
        return !(this == other);
    }

    pub fn ToString(&this) -> String {
        if this.IsVoid() {
            return "void".ToString();
        } else if this.IsBoolean() {
            return "bool".ToString();
        } else if this.IsCharacter() {
            return "char".ToString();
        } else if this.IsInteger() {
            if this.IsLiteral() {
                return "(integer literal)".ToString();
            } else if this.width != 0 {
                return (this.signed ? 'i' : 'u') + String::FromInteger(this.width as u64);
            } else {
                return (this.signed ? "isize" : "usize").ToString();
            }
        } else if this.IsFloat() {
            if this.IsLiteral() {
                return "(float literal)".ToString();
            } else {
                return 'f' + String::FromInteger(this.width as u64);
            }
        } else if this.IsPointer() {
            if this.IsReference() {
                return (this.mutable ? "&mut " : "&") + this.pointee->ToString();
            } else {
                return (this.mutable ? "*mut " : "*") + this.pointee->ToString();
            }
        } else if this.IsArray() {
            return '[' + this.pointee->ToString() + "; " + String::FromInteger(this.length as u64) + ']';
        } else if this.IsFunction() {
            let mut result = "fn(".ToString();
            let mut first = true;

            for param in this.params {
                if !first {
                    result += ", ";
                } else {
                    first = false;
                }

                result += param->ToString();
            } result += ')';

            if this._return->kind != SemanticTypeKind::Void {
                result += " -> " + this._return->ToString();
            } return result;
        } else {
            return this.name;
        }
    }
}

#[include "src/SemanticAnalyzer.zir" : *]
