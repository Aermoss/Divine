#[include "std/io", "std/str", "std/vec", "std/map", "std/pair", "std/std", "vendor/llvm",
    "src/Logger.zir", "src/Context.zir", "src/Target.zir", "src/Mangler.zir", "src/Generic.zir", "src/TypeManager.zir", "src/Types.zir",
        "src/ScopeManager.zir", "src/Scope.zir", "src/Symbol.zir", "src/Value.zir", "src/Tokens.zir", "src/Nodes.zir" : *]

func LLVMPositionBuilderAtStart(builder: LLVMBuilderRef, block: LLVMBasicBlockRef) {
    let first_instr: LLVMValueRef = LLVMGetFirstInstruction(block);

    if first_instr != null {
        LLVMPositionBuilderBefore(builder, first_instr);
    } else {
        LLVMPositionBuilderAtEnd(builder, block);
    }
}

func LLVMAddressOf(value: LLVMValueRef, builder: LLVMBuilderRef) -> LLVMValueRef {
    if LLVMGetInstructionOpcode(value) == LLVMOpcode::LLVMLoad {
        let operand: LLVMValueRef = LLVMGetOperand(value, 0u32);
        LLVMInstructionEraseFromParent(value);
        ret operand;
    } else if LLVMGetInstructionOpcode(value) == LLVMOpcode::LLVMPHI {
        let count: u32 = LLVMCountIncoming(value);
        let current: LLVMBasicBlockRef = LLVMGetInsertBlock(builder);
        LLVMPositionBuilderBefore(builder, value);
        let phi: LLVMValueRef = LLVMBuildPhi(builder, LLVMPointerType(LLVMTypeOf(value), 0u32), "");
        let mut i: u32 = 0u32;

        while i < count {
            let block: LLVMBasicBlockRef = LLVMGetIncomingBlock(value, i);
            let value: LLVMValueRef = LLVMAddressOf(LLVMGetIncomingValue(value, i), builder);
            LLVMAddIncoming(phi, &value, &block, 1u32);
            i += 1u32;
        }

        LLVMInstructionEraseFromParent(value);
        LLVMPositionBuilderAtEnd(builder, current);
        ret phi;
    } else {
        let string: *const i8 = LLVMPrintValueToString(value);
        WriteLine("\x1b[31mFailed to get address of '" + string.ToString() + "'.\x1b[0m");
        LLVMDisposeMessage(string);
        ret null;
    }
}

class Forward {
    pub _class: *const QualifiedType,
    pub generic: *const Generic = null,
    pub types: Vector<*const QualifiedType>,
    pub pack_types: Vector<*const QualifiedType>,
    pub declaration: *const FunctionNode,
    pub _type: *const QualifiedType,
    pub value: LLVMValueRef;

    Forward(&mut this, declaration: *const FunctionNode, _type: *const QualifiedType, value: LLVMValueRef, _class: *const QualifiedType) {
        (this.declaration, this._type, this.value, this._class) = (declaration, _type, value, _class);
    }

    Forward(&mut this, declaration: *const FunctionNode, _type: *const QualifiedType, value: LLVMValueRef, _class: *const QualifiedType, types: &Vector<*const QualifiedType>, generic: *const Generic) {
        (this.declaration, this._type, this.value, this._class, this.types, this.generic) = (declaration, _type, value, _class, types, generic);
    }

    ~Forward(&this) {}
}

class Compiler {
    priv pack_specializing: bool = false,
    priv pack_types: Vector<*const QualifiedType>,
    priv current_pack_name: String,
    priv current_pack_values: Vector<QualifiedValue>,

    pub scope_manager: ScopeManager,
    priv type_manager: TypeManager,

    pub generics: Vector<*const Generic>,
    pub generic: *mut Generic = null,
    pub _class: *const QualifiedType = null,
    pub function: *const QualifiedType = null,
    pub function_ref: LLVMValueRef = null,
    pub mangling: bool = true, pub _unsafe: bool = false,
    priv blocks: Vector<Pair<LLVMBasicBlockRef, LLVMBasicBlockRef>>,
    priv pass_cache: Map<*const Node, Pair<*mut QualifiedType, *mut Scope>>,
    priv enum_pass_cache: Map<*const Node, *const QualifiedType>,
    priv forwards: Vector<Forward>,

    priv context: LLVMContextRef, priv target: *const Target,
    priv module: LLVMModuleRef = null, priv builder: LLVMBuilderRef = null,
    priv freestanding: bool, priv no_red_zone: bool, priv systemv: bool;

    Compiler(&mut this, context: &Context, target: &Target, freestanding: bool, no_red_zone: bool) {
        if compiler != null {
            WriteLine("\x1b[31mDetected an another instance of compiler.\x1b[0m");
            Exit(1i32);
        }

        (compiler, this.context) = (this, context.context);
        (this.systemv, this.target) = (!target.triple.Contains("windows"), target);
        (this.freestanding, this.no_red_zone) = (freestanding, no_red_zone);
    }

    ~Compiler(&mut this) {
        if this.builder != null {
            LLVMDisposeBuilder(this.builder);
            this.builder = null;
        }

        if this.module != null {
            LLVMDisposeModule(this.module);
            this.module = null;
        }

        compiler = null;
    }

    pub Compile(&mut this, node: *const RootNode, file_name: &String) -> LLVMModuleRef {
        if this.builder != null {
            LLVMDisposeBuilder(this.builder);
            this.builder = null;
        }

        if this.module != null {
            LLVMDisposeModule(this.module);
            this.module = null;
        }

        this.module = LLVMModuleCreateWithNameInContext("zircon", this.context);
        this.builder = LLVMCreateBuilderInContext(this.context);
        this.scope_manager.builder = this.builder;
        LLVMSetSourceFileName(this.module, file_name.Data(), file_name.Length());
        LLVMSetModuleDataLayout(this.module, this.target->layout);
        LLVMSetTarget(this.module, this.target->triple.Data());

        let mut i: u64 = 0u64;
        let mut declared: Map<*const Node, bool>;

        while i < node->declarations.Size() {
            let declaration: *const Node = node->declarations[i];
            declared[declaration] = false;
            declared[declaration] |= this.CompileDeclarationFirstPass(declaration);
            i += 1u64;
        } i = 0u64;

        while i < node->declarations.Size() {
            let declaration: *const Node = node->declarations[i];
            declared[declaration] |= this.CompileDeclarationSecondPass(declaration);
            i += 1u64;
        } i = 0u64;

        while i < node->declarations.Size() {
            let declaration: *const Node = node->declarations[i];
            declared[declaration] |= this.CompileDeclarationThirdPass(declaration);

            if !declared[declaration] {
                Logger::Log("Unknown declaration '" + declaration->_type.ToString() + "'.", declaration, LogSeverity::Error);
            } i += 1u64;
        }

        this.pass_cache.Clear();
        this.CompileForwardDeclarations();
        this.scope_manager.builder = null;
        let mut j: u64 = 0u64;

        while j < this.generics.Size() {
            del this.generics[j];
            j += 1u64;
        }

        this.generics.Clear();
        this.forwards.Clear();

        if !Logger::HasError() {
            let message: *const i8 = null;

            if LLVMVerifyModule(this.module, LLVMVerifierFailureAction::LLVMReturnStatusAction, &message) != 0i32 {
                let final_message: *const i8 = message != null ? message : "Unknown reason.";
                Logger::Log(file_name, "Module verification failed: " + final_message.ToString(), LogSeverity::Error);
                if message != null { LLVMDisposeMessage(message); }
                ret null;
            }

            if message != null {
                LLVMDisposeMessage(message);
            } ret this.module;
        } ret null;
    }

    priv CompileForwardDeclarations(&mut this) {
        let mut i: u64 = 0u64;

        while i < this.forwards.Size() {
            let forward: Forward = this.forwards[i];
            (this.function, this.function_ref) = (forward._type, forward.value);
            let has_instance: bool = forward.declaration->_type->instance_kind != InstanceKind::None;
            let params: &Vector<ParameterType> = this.function->Parameters();
            let scope: *mut Scope = this.scope_manager.current;
            this._class = forward._class;

            if forward.generic != null {
                this.scope_manager.current = forward.generic->scope;
            }

            let mut j: u64 = 0u64;
            let mut symbols: Vector<*const Symbol>;

            while j < forward.types.Size() {
                symbols.PushBack(forward.generic->scope->Set(forward.generic->type_names[j], SymbolKind::Type, QualifiedValue(null, forward.types[j]), false, forward.declaration as *const Node));
                j += 1u64;
            }

            this.scope_manager.PushScope(forward.declaration->name, false);
            let entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, this.function_ref, "");
            LLVMPositionBuilderAtEnd(this.builder, entry);
            let mut k: u64 = 0u64;

            while (has_instance && k == 0u64) || k < forward.declaration->_type->parameters.Size() + (has_instance ? 1u64 : 0u64) {
                let (mut name: String, mut mutable: bool);

                if has_instance && k == 0u64 {
                    (name, mutable) = ("this", false);
                } else {
                    let index: u64 = has_instance ? k - 1u64 : k;
                    let param: *const ParameterNode = forward.declaration->_type->parameters[index];
                    (name, mutable) = (param->name, param->mutable);
                }

                let index: u64 = params[0u64].sret != null ? k + 1u64 : k;
                let mut _type: *const QualifiedType = params[index]._type;

                if params[index].byval != null && LLVMGetTypeKind(_type->Value()) == LLVMTypeKind::LLVMPointerTypeKind {
                    _type = this.type_manager.Pointer(params[index].byval, mutable);
                    let instance: QualifiedValue = QualifiedValue(LLVMGetParam(this.function_ref, index as u32), _type, false, true);
                    this.scope_manager.Set(name, SymbolKind::Parameter, instance, false, forward.declaration as *const Node);
                    if _type->Pointee().IsClass() { this.scope_manager.RegisterInstance(instance); }
                } else {
                    if params[index].byval != null { _type = params[index].byval; }
                    let current: LLVMBasicBlockRef = LLVMGetInsertBlock(this.builder);
                    LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
                    let pointer: LLVMValueRef = LLVMBuildAlloca(this.builder, _type->Value(), "");

                    LLVMPositionBuilderAtEnd(this.builder, current);
                    LLVMBuildStore(this.builder, LLVMGetParam(this.function_ref, index as u32), pointer);
                    let instance: QualifiedValue = QualifiedValue(pointer, this.type_manager.Pointer(_type, mutable), false, true);
                    if params[index].byval != null && _type->IsClass() { this.scope_manager.RegisterInstance(instance); }
                    this.scope_manager.Set(name, SymbolKind::Parameter, instance, false, forward.declaration as *const Node);
                } k += 1u64;
            }

            let (prev_pack_name: String, prev_pack_values: Vector<QualifiedValue>) = (this.current_pack_name, this.current_pack_values);
            this.current_pack_name = forward.declaration->_type->pack_name;
            this.current_pack_values.Clear();

            if this.current_pack_name != "" {
                let offset: u64 = !params.Empty() && params[0u64].sret != null ? 1u64 : 0u64;

                while k + offset < params.Size() {
                    let index: u64 = k + offset;
                    let mut _type: *const QualifiedType = params[index]._type;

                    if params[index].byval != null && LLVMGetTypeKind(_type->Value()) == LLVMTypeKind::LLVMPointerTypeKind {
                        _type = this.type_manager.Pointer(params[index].byval, false);
                        let instance: QualifiedValue = QualifiedValue(LLVMGetParam(this.function_ref, index as u32), _type, false, true);
                        if _type->Pointee().IsClass() { this.scope_manager.RegisterInstance(instance); }
                        this.current_pack_values.PushBack(instance);
                    } else {
                        if params[index].byval != null { _type = params[index].byval; }
                        let current: LLVMBasicBlockRef = LLVMGetInsertBlock(this.builder);
                        LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
                        let pointer: LLVMValueRef = LLVMBuildAlloca(this.builder, _type->Value(), "");

                        LLVMPositionBuilderAtEnd(this.builder, current);
                        LLVMBuildStore(this.builder, LLVMGetParam(this.function_ref, index as u32), pointer);
                        let instance: QualifiedValue = QualifiedValue(pointer, this.type_manager.Pointer(_type, false), false, true);
                        if params[index].byval != null && _type->IsClass() { this.scope_manager.RegisterInstance(instance); }
                        this.current_pack_values.PushBack(instance);
                    } k += 1u64;
                }
            }

            let mut l: u64 = 0u64;

            while forward.declaration->constructors.Size() > l {
                let _class: &QualifiedType = this.CompileType(forward.declaration->constructors[l]->expression);

                if !_class.IsClass() {
                    Logger::Log("Constructor type must be a class.", forward.declaration as *const Node, LogSeverity::Error);
                    ret;
                }

                let mut values: Vector<QualifiedValue>;
                let mut m: u64 = 0u64;

                while forward.declaration->constructors[l]->arguments.Size() > m {
                    if !this.CompileArgument(forward.declaration->constructors[l]->arguments[m], &values) {
                        ret;
                    } m += 1u64;
                }

                let index: u64 = params[0u64].sret != null ? 1u64 : 0u64;
                let instance: QualifiedValue = QualifiedValue(LLVMGetParam(this.function_ref, index as u32), params[index]._type);
                this.CompileConstructor(_class, this.CompileCast2(instance, this.type_manager.Pointer(_class, true), forward.declaration as *const Node), values, forward.declaration as *const Node);
                l += 1u64;
            }

            this.CompileBlock(forward.declaration->body);
            (this.current_pack_name, this.current_pack_values) = (prev_pack_name, prev_pack_values);
            this.scope_manager.PopScope();

            if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
                let mut state: bool = true;

                if LLVMGetTypeKind(this.function->Return()._type->Value()) == LLVMTypeKind::LLVMVoidTypeKind {
                    if !params.Empty() {
                        state = params[0u64].sret != null;
                    } else {
                        state = false;
                    }
                }

                if !state {
                    LLVMBuildRetVoid(this.builder);
                } else {
                    Logger::Log("Function '" + forward.declaration->name + "' must return a value.", forward.declaration as *const Node, LogSeverity::Error);
                    ret;
                }
            }

            let mut m: u64 = 0u64;

            while m < symbols.Size() {
                let index: i64 = forward.generic->scope->symbols.Index(symbols[m]);

                if index != -1i64 {
                    forward.generic->scope->symbols.RemoveAt(index as u64);
                    del symbols[m];
                } m += 1u64;
            }

            if forward.generic != null {
                this.scope_manager.current = scope;
            }

            this.function = null;
            this.function_ref = null;
            this._class = null;
            i += 1u64;
        }
    }

    priv CompileDeclarationFirstPass(&mut this, declaration: *const Node) -> bool {
        if declaration->_type == NodeType::CLASS {
            let _class: *const ClassNode = declaration as *const ClassNode;
            let cache: Pair<*mut QualifiedType, *mut Scope> = this.CompileClassFirstPass(_class, null);
            if !_class->generic && cache.left != null && cache.right != null { this.pass_cache[declaration] = cache; }
        } else if declaration->_type == NodeType::ENUM {
            let _enum: *const EnumNode = declaration as *const EnumNode;

            if _enum->variant {
                let cache: Pair<*mut QualifiedType, *mut Scope> = this.CompileVariantFirstPass(_enum, null);
                if !_enum->generic && cache.left != null && cache.right != null { this.pass_cache[declaration] = cache; }
            } else {
                let cache: *const QualifiedType = this.CompileEnumerationFirstPass(_enum);
                if cache != null { this.enum_pass_cache[declaration] = cache; }
            }
        } else if declaration->_type == NodeType::TYPE_DEFINITION {
            this.CompileTypeDefinition(declaration as *const TypeDefinitionNode);
        } else {
            ret false;
        } ret true;
    }

    priv CompileTypeDefinition(&mut this, type_definition: *const TypeDefinitionNode) {
        this.scope_manager.Set(type_definition->name, SymbolKind::Type, QualifiedValue(null, this.CompileType(type_definition->_type)), false, type_definition as *const Node);
    }

    priv CompileDeclarationSecondPass(&mut this, declaration: *const Node) -> bool {
        if declaration->_type == NodeType::CONSTANT {
            this.CompileConstant(declaration as *const ConstantNode);
        } else if declaration->_type == NodeType::CLASS {
            let _class: *const ClassNode = declaration as *const ClassNode;

            if !_class->generic && this.pass_cache.Has(declaration) {
                let cache: Pair<*mut QualifiedType, *mut Scope> = this.pass_cache[declaration];
                this.CompileClassSecondPass(cache.left, _class, cache.right);
            }
        } else if declaration->_type == NodeType::ENUM {
            let _enum: *const EnumNode = declaration as *const EnumNode;

            if _enum->variant {
                if !_enum->generic && this.pass_cache.Has(declaration) {
                    let cache: Pair<*mut QualifiedType, *mut Scope> = this.pass_cache[declaration];
                    this.CompileVariantSecondPass(cache.left, _enum, cache.right);
                }
            } else {
                if this.enum_pass_cache.Has(declaration) {
                    this.CompileEnumerationSecondPass(_enum, this.enum_pass_cache[declaration]);
                }
            }
        } else {
            ret false;
        } ret true;
    }

    priv CompileDeclarationThirdPass(&mut this, declaration: *const Node) -> bool {
        if declaration->_type == NodeType::STATIC {
            this.CompileStatic(declaration as *const StaticNode);
        } else if declaration->_type == NodeType::FUNCTION {
            this.CompileFunction(declaration as *const FunctionNode, null);
        } else if declaration->_type == NodeType::CLASS {
            let _class: *const ClassNode = declaration as *const ClassNode;

            if !_class->generic && this.pass_cache.Has(declaration) {
                let cache: Pair<*mut QualifiedType, *mut Scope> = this.pass_cache[declaration];
                this.CompileClassThirdPass(cache.left, _class, cache.right);
            }
        } else if declaration->_type == NodeType::ENUM {
            let _enum: *const EnumNode = declaration as *const EnumNode;

            if _enum->variant && !_enum->generic && this.pass_cache.Has(declaration) {
                let cache: Pair<*mut QualifiedType, *mut Scope> = this.pass_cache[declaration];
                this.CompileVariantThirdPass(cache.left, _enum, cache.right);
            }
        } else if declaration->_type == NodeType::EXTERN {
            this.CompileExtern(declaration as *const ExternNode);
        } else if declaration->_type == NodeType::ASSEMBLY {
            this.CompileAssembly(declaration as *const AssemblyNode);
        } else {
            ret false;
        } ret true;
    }

    priv CompileConstant(&mut this, constant: *const ConstantNode) {
        let mut initializer: QualifiedValue;
        let mut _type: *const QualifiedType = this.CompileType(constant->_type);
        let mut has_error: bool = false;

        if constant->initializer->_type != NodeType::INITIALIZER_LIST {
            initializer = this.CompileExpression(constant->initializer, false);
            if initializer.Null() { has_error = true; }
        } else {
            let mut values: Vector<LLVMValueRef>;
            let initializer_list: *const InitializerListNode = constant->initializer as *const InitializerListNode;

            if _type->IsPointer() {
                _type = this.type_manager.Array(_type->Pointee(), initializer_list->expressions.Size(), _type->IsMutable());
            }

            if _type->IsClass() {
                let fields: &Map<String, Pair<Field, *const QualifiedType>> = _type->Fields();
                let mut i: u64 = 0u64;

                while i < fields.Size() {
                    if i < initializer_list->expressions.Size() {
                        let value: QualifiedValue = this.CompileExpression(initializer_list->expressions[i], false);

                        if !value.Null() {
                            values.PushBack(value.Value());
                        } else {
                            has_error = true;
                            break;
                        }
                    } else {
                        if fields[i].right.left.initializer != null {
                            let value: QualifiedValue = this.CompileExpression(fields[i].right.left.initializer, false);

                            if !value.Null() {
                                values.PushBack(value.Value());
                            } else {
                                has_error = true;
                                break;
                            }
                        } else {
                            Logger::Log("Missing initializer for field '" + fields[i].left + "'.", constant as *const Node, LogSeverity::Error);
                            has_error = true;
                            break;
                        }
                    } i += 1u64;
                }

                if !has_error {
                    initializer = QualifiedValue(LLVMConstNamedStruct(_type->Value(), values.Data(), values.Size() as u32), _type);
                }
            } else if _type->IsArray() {
                if initializer_list->expressions.Size() != _type->Size() {
                    Logger::Log("Incompatible initializer list size. ('" + String(_type->Size() as i64) + "' != '" + String(initializer_list->expressions.Size() as i64) + "').", constant as *const Node, LogSeverity::Error);
                    has_error = true;
                }

                let mut i: u64 = 0u64;

                while i < initializer_list->expressions.Size() && !has_error {
                    let value: QualifiedValue = this.CompileExpression(initializer_list->expressions[i], false);

                    if value.Null() {
                        has_error = true;
                        break;
                    }

                    let mut state: bool = false;

                    if _type->Element().IsPointer() && value.Type().IsPointer() {
                        if LLVMGetTypeKind(_type->Element().Pointee().Value()) == LLVMTypeKind::LLVMVoidTypeKind || value.Type().IsNullPointer() {
                            state = true;
                        }
                    }

                    if value.Type() != _type->Element() && !state {
                        Logger::Log("Incompatible initializer list element types. ('" + value.Type().ToString() + "' != '" + _type->Element().ToString() + "').", constant as *const Node, LogSeverity::Error);
                        has_error = true;
                        break;
                    }

                    values.PushBack(value.Value());
                    i += 1u64;
                }

                if !has_error {
                    initializer = QualifiedValue(LLVMConstArray2(_type->Value(), values.Data(), values.Size()), _type);
                }
            } else {
                Logger::Log("Invalid type '" + _type->ToString() + "' for initializer list.", constant as *const Node, LogSeverity::Error);
                has_error = true;
            }
        }

        if has_error {
            this.scope_manager.Set(constant->name, SymbolKind::GlobalVariable, QualifiedValue(null, null), false, constant as *const Node);
            ret;
        }

        let mut state: bool = false;

        if _type->IsPointer() && initializer.Type().IsPointer() {
            if LLVMGetTypeKind(_type->Pointee().Value()) == LLVMTypeKind::LLVMVoidTypeKind || initializer.Type().IsNullPointer() {
                state = true;
            }
        }

        if initializer.Type() != *_type && !state {
            Logger::Log("Incompatible constant initialization types. ('" + _type->ToString() + "' != '" + initializer.Type().ToString() + "').", constant as *const Node, LogSeverity::Error);
            ret;
        }

        let global: LLVMValueRef = LLVMAddGlobal(this.module, _type->Value(), constant->name.Data());
        this.scope_manager.Set(constant->name, SymbolKind::GlobalVariable, QualifiedValue(global, this.type_manager.Pointer(_type, false), false, true), false, constant as *const Node);
        LLVMSetLinkage(global, LLVMLinkage::LLVMPrivateLinkage);
        LLVMSetInitializer(global, initializer.Value());
        LLVMSetGlobalConstant(global, 1i32);
    }

    priv CompileStatic(&mut this, _static: *const StaticNode) {
        let mut initializer: QualifiedValue;
        let mut _type: *const QualifiedType = this.CompileType(_static->_type);
        let mut has_error: bool = false;

        if _static->initializer != null {
            if _static->initializer->_type != NodeType::INITIALIZER_LIST {
                initializer = this.CompileExpression(_static->initializer, false);
                if initializer.Null() { has_error = true; }
            } else {
                let mut values: Vector<LLVMValueRef>;
                let initializer_list: *const InitializerListNode = _static->initializer as *const InitializerListNode;

                if _type->IsPointer() {
                    _type = this.type_manager.Array(_type->Pointee(), initializer_list->expressions.Size(), _type->IsMutable());
                }

                if _type->IsClass() {
                    let fields: &Map<String, Pair<Field, *const QualifiedType>> = _type->Fields();
                    let mut i: u64 = 0u64;

                    while i < fields.Size() {
                        if i < initializer_list->expressions.Size() {
                            let value: QualifiedValue = this.CompileExpression(initializer_list->expressions[i], false);

                            if !value.Null() {
                                values.PushBack(value.Value());
                            } else {
                                has_error = true;
                                break;
                            }
                        } else {
                            if fields[i].right.left.initializer != null {
                                let value: QualifiedValue = this.CompileExpression(fields[i].right.left.initializer, false);

                                if !value.Null() {
                                    values.PushBack(value.Value());
                                } else {
                                    has_error = true;
                                    break;
                                }
                            } else {
                                Logger::Log("Missing initializer for field '" + fields[i].left + "'.", _static as *const Node, LogSeverity::Error);
                                has_error = true;
                                break;
                            }
                        } i += 1u64;
                    }

                    if !has_error {
                        initializer = QualifiedValue(LLVMConstNamedStruct(_type->Value(), values.Data(), values.Size() as u32), _type);
                    }
                } else if _type->IsArray() {
                    if initializer_list->expressions.Size() != _type->Size() {
                        Logger::Log("Incompatible initializer list size. ('" + String(_type->Size() as i64) + "' != '" + String(initializer_list->expressions.Size() as i64) + "').", _static as *const Node, LogSeverity::Error);
                        has_error = true;
                    }

                    let mut i: u64 = 0u64;

                    while i < initializer_list->expressions.Size() && !has_error {
                        let value: QualifiedValue = this.CompileExpression(initializer_list->expressions[i], false);

                        if value.Null() {
                            has_error = true;
                            break;
                        }

                        let mut state: bool = false;

                        if _type->Element().IsPointer() && value.Type().IsPointer() {
                            if LLVMGetTypeKind(_type->Element().Pointee().Value()) == LLVMTypeKind::LLVMVoidTypeKind || value.Type().IsNullPointer() {
                                state = true;
                            }
                        }

                        if value.Type() != _type->Element() && !state {
                            Logger::Log("Incompatible initializer list element types. ('" + value.Type().ToString() + "' != '" + _type->Element().ToString() + "').", _static as *const Node, LogSeverity::Error);
                            has_error = true;
                            break;
                        }

                        values.PushBack(value.Value());
                        i += 1u64;
                    }

                    if !has_error {
                        initializer = QualifiedValue(LLVMConstArray2(_type->Value(), values.Data(), values.Size()), _type);
                    }
                } else {
                    Logger::Log("Invalid type '" + _type->ToString() + "' for initializer list.", _static as *const Node, LogSeverity::Error);
                    has_error = true;
                }
            }

            if !has_error {
                let mut state: bool = false;

                if _type->IsPointer() && initializer.Type().IsPointer() {
                    if LLVMGetTypeKind(_type->Pointee().Value()) == LLVMTypeKind::LLVMVoidTypeKind || initializer.Type().IsNullPointer() {
                        state = true;
                    }
                }

                if initializer.Type() != *_type && !state {
                    Logger::Log("Incompatible constant initialization types. ('" + _type->ToString() + "' != '" + initializer.Type().ToString() + "').", _static as *const Node, LogSeverity::Error);
                    has_error = true;
                }
            }
        } else if _static->zero_initializer {
            initializer = QualifiedValue(LLVMConstNull(_type->Value()), _type);
        }

        if has_error {
            this.scope_manager.Set(_static->name, SymbolKind::Variable, QualifiedValue(null, null), false, _static as *const Node);
            ret;
        }

        let global: LLVMValueRef = LLVMAddGlobal(this.module, _type->Value(), _static->name.Data());
        this.scope_manager.Set(_static->name, SymbolKind::Variable, QualifiedValue(global, this.type_manager.Pointer(_type, _static->mutable), false, true), false, _static as *const Node);
        LLVMSetLinkage(global, this.mangling ? LLVMLinkage::LLVMInternalLinkage : LLVMLinkage::LLVMExternalLinkage);
        LLVMSetGlobalConstant(global, _static->mutable ? 0i32 : 1i32);

        if !initializer.Null() {
            LLVMSetInitializer(global, initializer.Value());
        }

        if _static->alignment != null {
            let alignment: QualifiedValue = this.CompileExpression(_static->alignment, false);

            if alignment.Null() {
                ret;
            }

            if LLVMGetTypeKind(alignment.Type().Value()) != LLVMTypeKind::LLVMIntegerTypeKind || LLVMGetIntTypeWidth(alignment.Type().Value()) != 64u32 || alignment.Type().IsSigned() {
                Logger::Log("Static alignment must be of type 'u64'.", _static as *const Node, LogSeverity::Error);
                ret;
            }

            LLVMSetAlignment(global, LLVMConstIntGetZExtValue(alignment.Value()) as u32);
        }
    }

    priv ProcessType(&mut this, _type: *const QualifiedType) -> *const QualifiedType {
        if LLVMGetTypeKind(_type->Value()) != LLVMTypeKind::LLVMStructTypeKind {
            ret _type;
        } else {
            let size: u64 = LLVMABISizeOfType(this.target->layout, _type->Value());

            if size > 8u64 {
                ret this.type_manager.Pointer(_type, _type->IsMutable());
            } else {
                if size > 4u64 {
                    ret this.type_manager.Primitive(LLVMInt64TypeInContext(this.context), true);
                } else if size > 2u64 {
                    ret this.type_manager.Primitive(LLVMInt32TypeInContext(this.context), true);
                } else if size > 1u64 {
                    ret this.type_manager.Primitive(LLVMInt16TypeInContext(this.context), true);
                } else {
                    ret this.type_manager.Primitive(LLVMInt8TypeInContext(this.context), true);
                }
            }
        }
    }

    priv AddAttributes(&mut this, function: LLVMValueRef) {
        if this.freestanding || true {
            let attribute: LLVMAttributeRef = LLVMCreateStringAttribute(this.context, "no-stack-arg-probe", 18u32, "", 0u32);
            LLVMAddAttributeAtIndex(function, LLVMAttributeIndex::LLVMAttributeFunctionIndex, attribute);
        }

        if this.no_red_zone {
            let noredzone_kind: u32 = LLVMGetEnumAttributeKindForName("noredzone", 9u64);
            LLVMAddAttributeAtIndex(function, LLVMAttributeIndex::LLVMAttributeFunctionIndex, LLVMCreateEnumAttribute(this.context, noredzone_kind, 0u64));
        }

        /* let align_attr: LLVMAttributeRef = LLVMCreateStringAttribute(this.context, "align-stack", 11u32, "16", 2u32);
        LLVMAddAttributeAtIndex(function, LLVMAttributeIndex::LLVMAttributeFunctionIndex, align_attr); */

        if !this.target->features.Empty() {
            let attribute: LLVMAttributeRef = LLVMCreateStringAttribute(this.context, "target-features", 15u32, this.target->features.Data(), this.target->features.Length() as u32);
            LLVMAddAttributeAtIndex(function, LLVMAttributeIndex::LLVMAttributeFunctionIndex, attribute);
        }
    }

    pub CompileFunction(&mut this, function: *const FunctionNode, generic: *mut Generic) -> QualifiedValue {
        if function->generic && generic == null && !this.pack_specializing {
            let _generic: *mut Generic = new Generic(function as *const Node);
            this.scope_manager.Set(function->name, SymbolKind::Generic, _generic as *const void, false, function as *const Node);
            ret QualifiedValue(null, null);
        }

        let (mut params: Vector<ParameterType>, mut param_types: Vector<LLVMTypeRef>);
        let mut return_type: ReturnType = this.CompileType(function->_type->return_type);
        let mut attributes: Vector<LLVMTypeRef>;
        let mut sret: bool = false;

        if LLVMGetTypeKind(return_type._type->Value()) == LLVMTypeKind::LLVMStructTypeKind && !return_type._type->IsEnum() {
            let processed_type: *const QualifiedType = this.ProcessType(return_type._type);

            if LLVMGetTypeKind(processed_type->Value()) != LLVMTypeKind::LLVMPointerTypeKind {
                (return_type.sret, return_type._type) = (return_type._type, processed_type);
            } else {
                let mut param_type: ParameterType = processed_type;
                (param_type.sret, sret) = (return_type._type, true);
                return_type._type = this.type_manager.Primitive(LLVMVoidTypeInContext(this.context), false);
                attributes.PushBack(return_type._type->Value());
                param_types.PushBack(processed_type->Value());
                params.PushBack(param_type);
            }
        }

        let mut instance_type: *const QualifiedType = null;

        if function->_type->instance_kind != InstanceKind::None {
            if this._class == null {
                Logger::Log("Instance parameters are only allowed in class and enum methods.", function as *const Node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }

            if function->_type->instance_kind == InstanceKind::ConstRef || function->_type->instance_kind == InstanceKind::MutRef {
                instance_type = this.type_manager.Reference(this._class, function->_type->instance_kind == InstanceKind::MutRef);
            } else if function->_type->instance_kind == InstanceKind::Copy {
                instance_type = this._class;
            }
        }

        let mut i: u64 = 0u64;

        while instance_type != null || i < function->_type->parameters.Size() {
            let mut real_type: *const QualifiedType;

            if instance_type != null {
                (real_type, instance_type) = (instance_type, null);
            } else {
                real_type = this.CompileType(function->_type->parameters[i]->_type);
                i += 1u64;
            }

            let mut param_type: ParameterType = real_type->IsEnum() ? real_type : this.ProcessType(real_type);

            if *real_type != *param_type._type {
                attributes.PushBack(LLVMGetTypeKind(param_type._type->Value()) == LLVMTypeKind::LLVMPointerTypeKind ? real_type->Value() : null);
                param_type.byval = real_type;
            } else {
                attributes.PushBack(null);
            }

            param_types.PushBack(param_type._type->Value());
            params.PushBack(param_type);
        }

        if function->_type->pack_name != "" && this.pack_specializing {
            let mut p: u64 = 0u64;

            while p < this.pack_types.Size() {
                let real_type: *const QualifiedType = this.pack_types[p];
                let mut param_type: ParameterType = real_type->IsEnum() ? real_type : this.ProcessType(real_type);

                if *real_type != *param_type._type {
                    attributes.PushBack(LLVMGetTypeKind(param_type._type->Value()) == LLVMTypeKind::LLVMPointerTypeKind ? real_type->Value() : null);
                    param_type.byval = real_type;
                } else {
                    attributes.PushBack(null);
                }

                param_types.PushBack(param_type._type->Value());
                params.PushBack(param_type);
                p += 1u64;
            }
        }

        let mut name: String = function->name;
        let type_ref: LLVMTypeRef = LLVMFunctionType(return_type._type->Value(), param_types.Data(), param_types.Size() as u32, function->_type->var_arg ? 1i32 : 0i32);
        let mut _type: *mut QualifiedType;

        if this.pack_specializing {
            _type = this.type_manager.PackSpecializedFunction(type_ref, params, return_type, function, this.scope_manager.current);
        } else {
            _type = this.type_manager.Function(type_ref, params, return_type, function, this.scope_manager.current);
        }

        if this.generic != null {
            (_type->pack_generic, _type->pack_generic_types) = (this.generic, this.generic->types);
        }

        if function->no_mangle {
            if !this.mangling {
                Logger::Log("Mangling was already disabled.", function as *const Node, LogSeverity::Error);
            }
        } else if this.mangling {
            let mut types: Vector<*const QualifiedType>;
            if generic != null { types += generic->types; }
            name = Mangler::MangleFunction(function->name, _type, types);
        }

        let value_ref: LLVMValueRef = LLVMAddFunction(this.module, name.Data(), _type->Value());
        let value: QualifiedValue = QualifiedValue(value_ref, this.type_manager.Pointer(_type, false));
        this.AddAttributes(value_ref);

        if generic != null {
            generic->Set(value);
        } else {
            this.scope_manager.Set(function->name, SymbolKind::Function, value, this.mangling && !function->no_mangle, function as *const Node);
        }

        let mut j: u64 = 0u64;

        while j < attributes.Size() {
            if attributes[j] != null {
                let attribute_kind: u32 = sret && j == 0u64 ? LLVMGetEnumAttributeKindForName("sret", 4u64) : LLVMGetEnumAttributeKindForName("byval", 5u64);
                LLVMAddAttributeAtIndex(value_ref, (j + 1u64) as u32, LLVMCreateTypeAttribute(this.context, attribute_kind, attributes[j]));
            } j += 1u64;
        }

        if this._class == null && !function->constructors.Empty() {
            Logger::Log("Constructors can only be declared inside classes.", function as *const Node, LogSeverity::Error);
            ret value;
        }

        let mut k: u64 = 0u64;

        while function->constructors.Size() > k {
            let _class: &mut QualifiedType = this.CompileType(function->constructors[k]->expression);

            if !_class.IsClass() {
                Logger::Log("Constructor type must be a class.", function as *const Node, LogSeverity::Error);
                ret value;
            }

            _class.constructed.PushBack(this._class);
            k += 1u64;
        }

        if function->body != null && (function->_type->pack_name == "" || this.pack_specializing) {
            if this.generic != null {
                this.forwards.PushBack(Forward(function, _type, value_ref, this._class, this.generic->types, this.generic));
            } else {
                this.forwards.PushBack(Forward(function, _type, value_ref, this._class));
            } this.forwards[this.forwards.Size() - 1u64].pack_types = this.pack_types;
        } ret value;
    }

    priv ValueToType(&mut this, values: Vector<QualifiedValue>) -> Vector<*const QualifiedType> {
        let mut result: Vector<*const QualifiedType>;
        let mut i: u64 = 0u64;

        while i < values.Size() {
            result.PushBack(values[i].Type());
            i += 1u64;
        } ret result;
    }

    priv CompileArgument(&mut this, argument: *const Node, values: &mut Vector<QualifiedValue>) -> bool {
        if argument->_type == NodeType::PACK_SPLAT {
            let splat: *const PackSplatNode = argument as *const PackSplatNode;

            if splat->expression->_type != NodeType::IDENTIFIER {
                Logger::Log("Pack splat expression must be a pack name.", argument, LogSeverity::Error);
                ret false;
            }

            let identifier: *const IdentifierNode = splat->expression as *const IdentifierNode;

            if identifier->name != this.current_pack_name {
                Logger::Log("Pack '" + identifier->name + "' not found.", argument, LogSeverity::Error);
                ret false;
            }

            let mut i: u64 = 0u64;

            while i < this.current_pack_values.Size() {
                let mut value: QualifiedValue = this.current_pack_values[i];

                if value.Type().IsPointer() {
                    value = QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
                }

                values.PushBack(value);
                i += 1u64;
            } ret true;
        } else {
            let value: QualifiedValue = this.CompileExpression(argument, false);

            if !value.Null() {
                values.PushBack(value);
                ret true;
            } ret false;
        }
    }

    priv CompileConstructor(&mut this, _class: &QualifiedType, pointer: QualifiedValue, params: Vector<QualifiedValue>, node: *const Node) {
        let mut need_copy: bool = false;

        if params.Size() == 1u64 {
            if params[0u64].Type().IsPointer() {
                need_copy = params[0u64].Type().Pointee() == _class;
            }
        }

        let param_types: Vector<*const QualifiedType> = this.ValueToType(params);
        let has_constructor: bool = _class.Has(_class.name, param_types);
        let (mut is_constructed: bool, mut i: u64) = (false, 0u64);

        while i < _class.constructed.Size() && this._class != null {
            let constructed: &QualifiedType = _class.constructed[i];

            if *this._class != constructed {
                i += 1u64;
            } else {
                is_constructed = true;
                break;
            }
        }

        let mut j: u64 = 0u64;
        let fields: &Map<String, Pair<Field, *const QualifiedType>> = _class.Fields();

        while j < fields.Size() {
            let field: &mut Pair<String, Pair<Field, *const QualifiedType>> = fields[j];
            let mut value: QualifiedValue = QualifiedValue(null, field.right.right);

            if !(has_constructor && !is_constructed) && j < params.Size() {
                value = params[j];
            } else {
                if field.right.left.initializer != null {
                    if field.right.left.initializer->_type != NodeType::INITIALIZER_LIST {
                        value = this.CompileExpression(field.right.left.initializer, false);
                        if value.Null() { ret; }
                    }
                }
            }

            if need_copy && !(has_constructor && !is_constructed) {
                value = QualifiedValue(LLVMBuildStructGEP2(this.builder, params[0u64].Type().Pointee().Value(), params[0u64].Value(), _class.Index(field.left) as u32, ""), this.type_manager.Pointer(field.right.right, true));
            }

            if field.right.right->IsClass() {
                let mut _params: Vector<QualifiedValue>;

                if !value.Null() {
                    if value.Type().IsClass() {
                        value = QualifiedValue(LLVMAddressOf(value.Value(), this.builder), this.type_manager.Pointer(value.Type(), true));
                    } _params.PushBack(value);
                } else {
                    if field.right.left.initializer != null {
                        if field.right.left.initializer->_type == NodeType::INITIALIZER_LIST {
                            let initializer_list: *const InitializerListNode = field.right.left.initializer as *const InitializerListNode;
                            let mut i: u64 = 0u64;

                            while i < initializer_list->expressions.Size() {
                                let value: QualifiedValue = this.CompileExpression(initializer_list->expressions[i], false);
                                if value.Null() { ret; }
                                _params.PushBack(value);
                                i += 1u64;
                            }
                        }
                    }
                }

                this.CompileConstructor(field.right.right, QualifiedValue(LLVMBuildStructGEP2(this.builder, pointer.Type().Pointee().Value(), pointer.Value(), _class.Index(field.left) as u32, ""), this.type_manager.Pointer(field.right.right, true)), _params, node);
            } else if !value.Null() {
                if value.Type().IsPointer() {
                    let pointee: &QualifiedType = value.Type().Pointee();

                    if pointee == field.right.right {
                        value = QualifiedValue(LLVMBuildLoad2(this.builder, pointee.Value(), value.Value(), ""), pointee);
                    }
                }

                this.CompileAssignment2(value, QualifiedValue(LLVMBuildStructGEP2(this.builder, pointer.Type().Pointee().Value(), pointer.Value(), _class.Index(field.left) as u32, ""), this.type_manager.Pointer(field.right.right, true)), TokenType::ASSIGN, true, node);
            } j += 1u64;
        }

        if has_constructor && !is_constructed {
            let param_types: Vector<*const QualifiedType> = this.ValueToType(params);

            if _class.Has(_class.name, param_types) {
                let method: &Pair<Method, *const QualifiedType> = _class.Get(_class.name, param_types, node);
                this.CompileCall2(QualifiedValue(method.left.value, method.right, pointer), params, false, true, node);
            } else {
                Logger::Log("Class doesn't have compatible constructor.", node, LogSeverity::Error);
            }
        } else {
            if params.Size() > fields.Size() {
                Logger::Log("Too many parameters.", node, LogSeverity::Error);
            }
        }
    }

    pub CompileDestructor(&mut this, _class: &QualifiedType, pointer: QualifiedValue, node: *const Node) {
        let (params: Vector<QualifiedValue>, params_types: Vector<*const QualifiedType>);

        if _class.Has("~" + _class.name, params_types) {
            let method: &Pair<Method, *const QualifiedType> = _class.Get("~" + _class.name, params_types, node);
            this.CompileCall2(QualifiedValue(method.left.value, method.right, pointer), params, false, true, node);
        }

        let fields: &Map<String, Pair<Field, *const QualifiedType>> = _class.Fields();
        let mut i: u64 = 0u64;

        while i < fields.Size() {
            let field: &mut Pair<String, Pair<Field, *const QualifiedType>> = fields[i];

            if field.right.right->IsClass() {
                this.CompileDestructor(field.right.right, QualifiedValue(LLVMBuildStructGEP2(this.builder, pointer.Type().Pointee().Value(), pointer.Value(), _class.Index(field.left) as u32, ""), this.type_manager.Pointer(field.right.right, true)), node);
            } i += 1u64;
        }
    }

    priv CompileClassFirstPass(&mut this, _class: *const ClassNode, generic: *mut Generic) -> Pair<*mut QualifiedType, *mut Scope> {
        if _class->generic && generic == null {
            let _generic: *mut Generic = new Generic(_class as *const Node);
            this.scope_manager.Set(_class->name, SymbolKind::Generic, _generic as *const void, false, _class as *const Node);
            ret Pair<*mut QualifiedType, *mut Scope>(null, null);
        }

        let struct_name: *const i8 = generic != null ? generic->current.Data() : _class->name.Data();
        let _type: *mut QualifiedType = this.type_manager.Class(LLVMStructCreateNamed(this.context, struct_name), _class->name);

        if generic != null {
            this.scope_manager.PushScope(generic->current, true);
            generic->Set(QualifiedValue(null, _type));
        } else {
            this.scope_manager.Set(_class->name, SymbolKind::Class, QualifiedValue(null, _type), false, _class as *const Node);
            this.scope_manager.PushScope(_class->name, true);
        }

        _type->pack_scope = this.scope_manager.current;
        this.scope_manager.PopScope();
        ret Pair<*mut QualifiedType, *mut Scope>(_type, _type->pack_scope);
    }

    priv CompileClassSecondPass(&mut this, _type: *mut QualifiedType, _class: *const ClassNode, scope: *mut Scope) {
        let prev_class: *const QualifiedType = this._class;
        let prev_scope: *mut Scope = this.scope_manager.current;
        (this._class, this.scope_manager.current) = (_type, scope);
        let (mut i: u64, mut j: u64) = (0u64, 0u64);
        let mut field_types: Vector<LLVMTypeRef>;

        while i < _class->parents.Size() {
            let parent_type: &QualifiedType = this.CompileType(_class->parents[i]);
            _type->fields[parent_type.name] = Pair<Field, *const QualifiedType>(Field(null, TokenType::PRIVATE, i), parent_type);
            field_types.PushBack(parent_type.Value());
            i += 1u64;
        }

        while j < _class->fields.Size() {
            let field: &Pair<TokenType, *const FieldNode> = _class->fields[j];
            let field_type: &QualifiedType = this.CompileType(field.right->_type);
            _type->fields[field.right->name] = Pair<Field, *const QualifiedType>(Field(field.right->initializer, field.left, i + j), field_type);
            field_types.PushBack(field_type.Value());
            j += 1u64;
        }

        if !field_types.Empty() {
            LLVMStructSetBody(_type->Value(), field_types.Data(), field_types.Size() as u32, 0i32);
        }

        (this._class, this.scope_manager.current) = (prev_class, prev_scope);
    }

    priv CompileClassThirdPass(&mut this, _type: *mut QualifiedType, _class: *const ClassNode, scope: *mut Scope) {
        let prev_class: *const QualifiedType = this._class;
        let prev_scope: *mut Scope = this.scope_manager.current;
        (this._class, this.scope_manager.current) = (_type, scope);
        let (mut i: u64, mut j: u64) = (0u64, 0u64);

        while i < _class->constructors.Size() {
            let method: QualifiedValue = this.CompileFunction(_class->constructors[i], null);
            _type->methods.PushBack(Pair<Method, *const QualifiedType>(Method(_class->constructors[i]->name, method.Value(), TokenType::PUBLIC), method.Type()));
            i += 1u64;
        }

        if _class->destructor != null {
            let method: QualifiedValue = this.CompileFunction(_class->destructor, null);
            _type->methods.PushBack(Pair<Method, *const QualifiedType>(Method(_class->destructor->name, method.Value(), TokenType::PUBLIC), method.Type()));
        }

        while j < _class->methods.Size() {
            let method: QualifiedValue = this.CompileFunction(_class->methods[j].right, null);

            if !_class->methods[j].right->generic {
                _type->methods.PushBack(Pair<Method, *const QualifiedType>(Method(_class->methods[j].right->name, method.Value(), _class->methods[j].left), method.Type()));
            } j += 1u64;
        }

        (this._class, this.scope_manager.current) = (prev_class, prev_scope);
    }

    pub CompileClass(&mut this, _class: *const ClassNode, generic: *mut Generic) -> *const QualifiedType {
        let cache: Pair<*mut QualifiedType, *mut Scope> = this.CompileClassFirstPass(_class, generic);

        if cache.left != null {
            this.CompileClassSecondPass(cache.left, _class, cache.right);
            this.CompileClassThirdPass(cache.left, _class, cache.right);
        } ret cache.left;
    }

    priv CompileEnumerationFirstPass(&mut this, _enum: *mut EnumNode) -> *const QualifiedType {
        let underlying_type: *const QualifiedType = this.CompileType(_enum->underlying_type);

        if underlying_type == null {
            ret null;
        }

        if LLVMGetTypeKind(underlying_type->Value()) != LLVMTypeKind::LLVMIntegerTypeKind {
            Logger::Log("Expected an integer type.", _enum as *const Node, LogSeverity::Error);
            ret null;
        }

        this.scope_manager.Set(_enum->name, SymbolKind::Type, QualifiedValue(null, underlying_type), false, _enum as *const Node);
        ret underlying_type;
    }

    priv CompileEnumerationSecondPass(&mut this, _enum: *mut EnumNode, underlying_type: *const QualifiedType) {
        this.scope_manager.PushScope(_enum->name, true);
        let mut value: LLVMValueRef = LLVMConstInt(underlying_type->Value(), 0u64, underlying_type->IsSigned() ? 1i32 : 0i32);
        let (mut has_error: bool, mut i: u64) = (false, 0u64);

        while i < _enum->variants.Size() {
            if _enum->variants[i]->value != null {
                let _value: QualifiedValue = this.CompileExpression(_enum->variants[i]->value, false);

                if !_value.Null() {
                    if _value.Type() == *underlying_type {
                        value = _value.Value();
                    } else {
                        Logger::Log("Incompatible enum value types. ('" + _value.Type().ToString() + "' != '" + underlying_type->ToString() + "').", _enum as *const Node, LogSeverity::Error);
                        has_error = true;
                    }
                } else {
                    has_error = true;
                }
            }

            if !has_error {
                this.scope_manager.Set(_enum->variants[i]->name, SymbolKind::Constant, QualifiedValue(value, underlying_type), false, _enum as *const Node);
                value = LLVMConstAdd(value, LLVMConstInt(underlying_type->Value(), 1u64, underlying_type->IsSigned() ? 1i32 : 0i32));
            } else {
                this.scope_manager.Set(_enum->variants[i]->name, SymbolKind::Constant, QualifiedValue(null, null), false, _enum as *const Node);
            } i += 1u64;
        }

        this.scope_manager.PopScope();
    }

    priv CompileVariantFirstPass(&mut this, _enum: *mut EnumNode, generic: *mut Generic) -> Pair<*mut QualifiedType, *mut Scope> {
        if _enum->generic && generic == null {
            let _generic: *mut Generic = new Generic(_enum as *const Node);
            this.scope_manager.Set(_enum->name, SymbolKind::Generic, _generic as *const void, false, _enum as *const Node);
            ret Pair<*mut QualifiedType, *mut Scope>(null, null);
        }

        let struct_name: *const i8 = generic != null ? generic->current.Data() : _enum->name.Data();
        let _type: *mut QualifiedType = this.type_manager.Enum(LLVMStructCreateNamed(this.context, struct_name), _enum->name);

        if generic != null {
            this.scope_manager.PushScope(generic->current, true);
            generic->Set(QualifiedValue(null, _type));
        } else {
            this.scope_manager.Set(_enum->name, SymbolKind::Class, QualifiedValue(null, _type), false, _enum as *const Node);
            this.scope_manager.PushScope(_enum->name, true);
        }

        _type->pack_scope = this.scope_manager.current;
        this.scope_manager.PopScope();
        ret Pair<*mut QualifiedType, *mut Scope>(_type, _type->pack_scope);
    }

    priv CompileVariantSecondPass(&mut this, _type: *mut QualifiedType, _enum: *mut EnumNode, scope: *mut Scope) {
        let prev_class: *const QualifiedType = this._class;
        let prev_scope: *mut Scope = this.scope_manager.current;
        (this._class, this.scope_manager.current) = (_type, scope);

        let mut max_size: u64 = 0u64;
        let mut variant_types: Vector<Pair<String, Vector<*const QualifiedType>>>;
        let mut i: u64 = 0u64;

        while i < _enum->variants.Size() {
            let mut types: Vector<*const QualifiedType>;
            let mut j: u64 = 0u64;

            while j < _enum->variants[i]->types.Size() {
                types.PushBack(this.CompileType(_enum->variants[i]->types[j]));
                j += 1u64;
            }

            variant_types.PushBack(Pair<String, Vector<*const QualifiedType>>(_enum->variants[i]->name, types));
            let current_size: u64 = LLVMABISizeOfType(this.target->layout, this.CreateVariantPayloadType(types));

            if current_size > max_size {
                max_size = current_size;
            } i += 1u64;
        }

        _type->variants = variant_types;
        let tag_type: LLVMTypeRef = LLVMInt32TypeInContext(this.context);
        let data_type: LLVMTypeRef = LLVMArrayType(LLVMInt8TypeInContext(this.context), max_size as u32);
        let elements[]: LLVMTypeRef = { tag_type, data_type };
        LLVMStructSetBody(_type->Value(), elements, 2u32, 0i32);
        let mut j: u64 = 0u64;

        while j < _enum->variants.Size() {
            _type->variant_field_names.PushBack(_enum->variants[j]->field_names);
            j += 1u64;
        }

        (this._class, this.scope_manager.current) = (prev_class, prev_scope);
    }

    priv CompileVariantThirdPass(&mut this, _type: *mut QualifiedType, _enum: *mut EnumNode, scope: *mut Scope) {
        let prev_class: *const QualifiedType = this._class;
        let prev_scope: *mut Scope = this.scope_manager.current;
        (this._class, this.scope_manager.current) = (_type, scope);

        let tag_type: LLVMTypeRef = LLVMInt32TypeInContext(this.context);
        let struct_type: LLVMTypeRef = _type->Value();
        let data_type: LLVMTypeRef = LLVMStructGetTypeAtIndex(struct_type, 1u32);
        let mut k: u64 = 0u64;

        while k < _enum->variants.Size() {
            let variant: *const VariantNode = _enum->variants[k];
            let current_variant_types: Vector<*const QualifiedType> = _type->variants[k].right;

            if current_variant_types.Empty() {
                let tag_value: LLVMValueRef = LLVMConstInt(tag_type, k, 0i32);
                let data_value: LLVMValueRef = LLVMConstNull(data_type);
                let values[]: LLVMValueRef = { tag_value, data_value };
                let const_val: LLVMValueRef = LLVMConstNamedStruct(struct_type, values, 2u32);
                this.scope_manager.Set(variant->name, SymbolKind::Constant, QualifiedValue(const_val, _type), false, _enum as *const Node);
            } else {
                let mut params: Vector<ParameterType>;
                let mut param_types: Vector<LLVMTypeRef>;
                let mut l: u64 = 0u64;

                while l < current_variant_types.Size() {
                    param_types.PushBack(current_variant_types[l]->Value());
                    params.PushBack(ParameterType(current_variant_types[l]));
                    l += 1u64;
                }

                let function_type: LLVMTypeRef = LLVMFunctionType(struct_type, param_types.Data(), param_types.Size() as u32, 0i32);
                let types: Vector<*const QualifiedType>;
                let func_name: String = Mangler::MangleFunction(variant->name, this.type_manager.Function(function_type, params, ReturnType(_type)), types);
                let function: LLVMValueRef = LLVMAddFunction(this.module, func_name.Data(), function_type);
                this.AddAttributes(function);

                let entry: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "entry");
                let temp_builder: LLVMBuilderRef = LLVMCreateBuilderInContext(this.context);
                LLVMPositionBuilderAtEnd(temp_builder, entry);

                let mut alloca: LLVMValueRef = LLVMBuildAlloca(temp_builder, struct_type, "adt");
                let tag_ptr: LLVMValueRef = LLVMBuildStructGEP2(temp_builder, struct_type, alloca, 0u32, "tag_ptr");
                LLVMBuildStore(temp_builder, LLVMConstInt(tag_type, k, 0i32), tag_ptr);

                let data_ptr: LLVMValueRef = LLVMBuildStructGEP2(temp_builder, struct_type, alloca, 1u32, "data_ptr");
                let payload_type: LLVMTypeRef = this.CreateVariantPayloadType(current_variant_types);
                let payload_ptr: LLVMValueRef = LLVMBuildBitCast(temp_builder, data_ptr, LLVMPointerType(payload_type, 0u32), "payload_ptr");
                let mut m: u64 = 0u64;

                while m < current_variant_types.Size() {
                    let param: LLVMValueRef = LLVMGetParam(function, m as u32);
                    let elem_ptr: LLVMValueRef = LLVMBuildStructGEP2(temp_builder, payload_type, payload_ptr, m as u32, "");
                    LLVMBuildStore(temp_builder, param, elem_ptr);
                    m += 1u64;
                }

                LLVMBuildRet(temp_builder, LLVMBuildLoad2(temp_builder, struct_type, alloca, ""));
                LLVMDisposeBuilder(temp_builder);

                this.scope_manager.Set(variant->name, SymbolKind::Function, QualifiedValue(function, this.type_manager.Pointer(this.type_manager.Function(function_type, params, ReturnType(_type)), false)), false, _enum as *const Node);
            } k += 1u64;
        }

        let mut l: u64 = 0u64;

        while l < _enum->methods.Size() {
            let method: QualifiedValue = this.CompileFunction(_enum->methods[l].right, null);
            _type->methods.PushBack(Pair<Method, *const QualifiedType>(Method(_enum->methods[l].right->name, method.Value(), _enum->methods[l].left), method.Type()));
            l += 1u64;
        }

        (this._class, this.scope_manager.current) = (prev_class, prev_scope);
    }

    pub CompileVariant(&mut this, _enum: *mut EnumNode, generic: *mut Generic) -> *const QualifiedType {
        let cache: Pair<*mut QualifiedType, *mut Scope> = this.CompileVariantFirstPass(_enum, generic);

        if cache.left != null {
            this.CompileVariantSecondPass(cache.left, _enum, cache.right);
            this.CompileVariantThirdPass(cache.left, _enum, cache.right);
        } ret cache.left;
    }

    priv CreateVariantPayloadType(&mut this, types: Vector<*const QualifiedType>) -> LLVMTypeRef {
        if types.Empty() {
            ret LLVMStructTypeInContext(this.context, null, 0u32, 0i32);
        }

        let mut elements: *mut LLVMTypeRef = new LLVMTypeRef[types.Size()];
        let mut i: u64 = 0u64;

        while i < types.Size() {
            elements[i] = types[i]->Value();
            i += 1u64;
        }

        let payload_type: LLVMTypeRef = LLVMStructTypeInContext(this.context, elements, types.Size() as u32, 0i32);
        del[] elements;
        ret payload_type;
    }

    priv VariantIndex(&this, _type: *const QualifiedType, name: &String) -> i64 {
        let mut i: u64 = 0u64;

        while i < _type->variants.Size() {
            if _type->variants[i].left == name {
                ret i as i64;
            } i += 1u64;
        } ret -1i64;
    }

    priv VariantFieldIndex(&this, _type: *const QualifiedType, variant_index: u64, name: &String) -> i64 {
        let mut i: u64 = 0u64;
        let names: &Vector<String> = _type->variant_field_names[variant_index];

        while i < names.Size() {
            if names[i] == name {
                ret i as i64;
            } i += 1u64;
        } ret -1i64;
    }

    priv PatternIsWildcard(&this, pattern: *const Node) -> bool {
        if pattern == null || pattern->_type != NodeType::IDENTIFIER {
            ret false;
        }

        ret (pattern as *const IdentifierNode)->name == "_";
    }

    priv BuildEnumTagPointer(&mut this, pointer: LLVMValueRef, _type: *const QualifiedType) -> LLVMValueRef {
        ret LLVMBuildStructGEP2(this.builder, _type->Value(), pointer, 0u32, "tag_ptr");
    }

    priv BuildPayloadFieldPointer(&mut this, pointer: LLVMValueRef, _type: *const QualifiedType, variant_index: u64, field_index: u64) -> LLVMValueRef {
        let data_ptr: LLVMValueRef = LLVMBuildStructGEP2(this.builder, _type->Value(), pointer, 1u32, "data_ptr");
        let payload_type: LLVMTypeRef = this.CreateVariantPayloadType(_type->variants[variant_index].right);
        let payload_ptr: LLVMValueRef = LLVMBuildBitCast(this.builder, data_ptr, LLVMPointerType(payload_type, 0u32), "payload_ptr");
        ret LLVMBuildStructGEP2(this.builder, payload_type, payload_ptr, field_index as u32, "payload_field_ptr");
    }

    priv BuildPatternCondition(&mut this, pattern: *const Node, pointer: LLVMValueRef, _type: *const QualifiedType) -> LLVMValueRef {
        if this.PatternIsWildcard(pattern) {
            ret LLVMConstInt(LLVMInt1TypeInContext(this.context), 1u64, 0i32);
        }

        if pattern->_type == NodeType::OR_PATTERN {
            let or_pattern: *const OrPatternNode = pattern as *const OrPatternNode;
            let left: LLVMValueRef = this.BuildPatternCondition(or_pattern->left, pointer, _type);
            let right: LLVMValueRef = this.BuildPatternCondition(or_pattern->right, pointer, _type);
            ret LLVMBuildOr(this.builder, left, right, "or_pattern");
        }

        if _type->IsEnum() {
            let mut variant_name: String;
            let mut arguments: Vector<*const Node>;
            let mut is_struct_pattern: bool = false;
            let mut struct_field_names: Vector<String>;

            if pattern->_type == NodeType::CALL {
                let call: *const CallNode = pattern as *const CallNode;
                arguments = call->arguments;

                if call->expression->_type == NodeType::IDENTIFIER {
                    variant_name = (call->expression as *const IdentifierNode)->name;
                } else if call->expression->_type == NodeType::SCOPE_RESOLUTION {
                    variant_name = (call->expression as *const ScopeResolutionNode)->identifier->name;
                } else {
                    Logger::Log("Invalid enum pattern.", pattern, LogSeverity::Error);
                    ret null;
                }
            } else if pattern->_type == NodeType::STRUCT_INIT {
                let si: *const StructInitNode = pattern as *const StructInitNode;
                is_struct_pattern = true;
                struct_field_names = si->field_names;
                arguments = si->field_values;

                if si->expression->_type == NodeType::IDENTIFIER {
                    variant_name = (si->expression as *const IdentifierNode)->name;
                } else if si->expression->_type == NodeType::SCOPE_RESOLUTION {
                    variant_name = (si->expression as *const ScopeResolutionNode)->identifier->name;
                } else {
                    Logger::Log("Invalid enum struct pattern.", pattern, LogSeverity::Error);
                    ret null;
                }
            } else if pattern->_type == NodeType::IDENTIFIER {
                variant_name = (pattern as *const IdentifierNode)->name;
            } else if pattern->_type == NodeType::SCOPE_RESOLUTION {
                variant_name = (pattern as *const ScopeResolutionNode)->identifier->name;
            } else {
                Logger::Log("Invalid enum pattern.", pattern, LogSeverity::Error);
                ret null;
            }

            let variant_index: i64 = this.VariantIndex(_type, &variant_name);

            if variant_index == -1i64 {
                Logger::Log("Unknown enum variant '" + variant_name + "'.", pattern, LogSeverity::Error);
                ret null;
            }

            let variant_types: Vector<*const QualifiedType> = _type->variants[variant_index as u64].right;

            if !is_struct_pattern && arguments.Size() != variant_types.Size() {
                Logger::Log("Pattern argument count does not match enum variant.", pattern, LogSeverity::Error);
                ret null;
            }

            let tag: LLVMValueRef = LLVMBuildLoad2(this.builder, LLVMInt32TypeInContext(this.context), this.BuildEnumTagPointer(pointer, _type), "tag");
            let mut result: LLVMValueRef = LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntEQ, tag, LLVMConstInt(LLVMInt32TypeInContext(this.context), variant_index as u64, 0i32), "match_tag");
            let mut i: u64 = 0u64;

            while i < arguments.Size() {
                let mut field_index: u64 = i;

                if is_struct_pattern {
                    let index: i64 = this.VariantFieldIndex(_type, variant_index as u64, &struct_field_names[i]);

                    if index == -1i64 {
                        Logger::Log("Unknown field '" + struct_field_names[i] + "' in pattern for variant '" + variant_name + "'.", pattern, LogSeverity::Error);
                        ret null;
                    }

                    field_index = index as u64;
                }

                let field_ptr: LLVMValueRef = this.BuildPayloadFieldPointer(pointer, _type, variant_index as u64, field_index);
                let field_result: LLVMValueRef = this.BuildPatternCondition(arguments[i], field_ptr, variant_types[field_index]);
                result = LLVMBuildAnd(this.builder, result, field_result, "match_pattern");
                i += 1u64;
            } ret result;
        }

        if pattern->_type == NodeType::IDENTIFIER {
            ret LLVMConstInt(LLVMInt1TypeInContext(this.context), 1u64, 0i32);
        }

        let value: QualifiedValue = QualifiedValue(LLVMBuildLoad2(this.builder, _type->Value(), pointer, "match_value"), _type);

        if pattern->_type == NodeType::SCOPE_RESOLUTION {
            let constant: QualifiedValue = this.CompileExpression(pattern, false);

            if !constant.Null() {
                ret this.CompileBinaryOperation2(value, constant, TokenType::EQUAL, false, pattern).Value();
            } else {
                ret null;
            }
        }

        if pattern->_type == NodeType::LITERAL {
            let constant: QualifiedValue = this.CompileExpression(pattern, false);

            if !constant.Null() {
                ret this.CompileBinaryOperation2(value, constant, TokenType::EQUAL, false, pattern).Value();
            } else {
                ret null;
            }
        }

        Logger::Log("Invalid match pattern.", pattern, LogSeverity::Error);
        ret null;
    }

    priv BindPattern(&mut this, pattern: *const Node, pointer: LLVMValueRef, _type: *const QualifiedType) {
        if this.PatternIsWildcard(pattern) {
            ret;
        }

        if pattern->_type == NodeType::OR_PATTERN {
            this.BindPattern((pattern as *const OrPatternNode)->left, pointer, _type);
            ret;
        }

        if _type->IsEnum() {
            if pattern->_type == NodeType::CALL {
                let call: *const CallNode = pattern as *const CallNode;
                let mut variant_name: String;

                if call->expression->_type == NodeType::IDENTIFIER {
                    variant_name = (call->expression as *const IdentifierNode)->name;
                } else {
                    variant_name = (call->expression as *const ScopeResolutionNode)->identifier->name;
                }

                let variant_index: i64 = this.VariantIndex(_type, &variant_name);
                let mut i: u64 = 0u64;

                while i < _type->variants[variant_index as u64].right.Size() {
                    let field_ptr: LLVMValueRef = this.BuildPayloadFieldPointer(pointer, _type, variant_index as u64, i);
                    this.BindPattern(call->arguments[i], field_ptr, _type->variants[variant_index as u64].right[i]);
                    i += 1u64;
                } ret;
            }

            if pattern->_type == NodeType::STRUCT_INIT {
                let struct_init: *const StructInitNode = pattern as *const StructInitNode;
                let mut variant_name: String;

                if struct_init->expression->_type == NodeType::IDENTIFIER {
                    variant_name = (struct_init->expression as *const IdentifierNode)->name;
                } else {
                    variant_name = (struct_init->expression as *const ScopeResolutionNode)->identifier->name;
                }

                let variant_index: i64 = this.VariantIndex(_type, &variant_name);
                let mut i: u64 = 0u64;

                while i < struct_init->field_names.Size() {
                    let index: i64 = this.VariantFieldIndex(_type, variant_index as u64, &struct_init->field_names[i]);

                    if index == -1i64 {
                        Logger::Log("Unknown field '" + struct_init->field_names[i] + "' in pattern.", pattern, LogSeverity::Error);
                        ret;
                    }

                    let field_ptr: LLVMValueRef = this.BuildPayloadFieldPointer(pointer, _type, variant_index as u64, index as u64);
                    this.BindPattern(struct_init->field_values[i], field_ptr, _type->variants[variant_index as u64].right[index as u64]);
                    i += 1u64;
                } ret;
            }

            if pattern->_type == NodeType::IDENTIFIER {
                let identifier: *const IdentifierNode = pattern as *const IdentifierNode;
                if this.VariantIndex(_type, &identifier->name) != -1i64 { ret; }
            } else if pattern->_type == NodeType::SCOPE_RESOLUTION {
                ret;
            }
        }

        if pattern->_type == NodeType::IDENTIFIER {
            let value: QualifiedValue = QualifiedValue(pointer, this.type_manager.Pointer(_type, false), false, true);
            this.scope_manager.Set((pattern as *const IdentifierNode)->name, SymbolKind::Variable, value, false, pattern);
        }
    }

    priv CompileMatch(&mut this, _match: *const MatchNode) {
        let mut expression: QualifiedValue = this.CompileExpression(_match->expression, false);
        if expression.Null() { ret; }

        let function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
        let end_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "match_end");
        let mut default_block: LLVMBasicBlockRef = end_block;
        let mut any_arm_branches_to_end: bool = false;

        if _match->default != null {
            default_block = LLVMAppendBasicBlockInContext(this.context, function, "match_default");
        }

        let mut match_pointer: LLVMValueRef = null;

        if expression.Type().IsReference() {
            if expression.Type().Pointee().IsEnum() {
                match_pointer = expression.Value();
                expression = QualifiedValue(LLVMBuildLoad2(this.builder, expression.Type().Pointee().Value(), expression.Value(), ""), expression.Type().Pointee());
            } else {
                expression = QualifiedValue(LLVMBuildLoad2(this.builder, expression.Type().Pointee().Value(), expression.Value(), ""), expression.Type().Pointee());
            }
        }

        if match_pointer == null && expression.Type().IsEnum() {
            match_pointer = LLVMBuildAlloca(this.builder, expression.Type().Value(), "match_value");
            LLVMBuildStore(this.builder, expression.Value(), match_pointer);
        }

        let mut current_block: LLVMBasicBlockRef = LLVMGetInsertBlock(this.builder);
        let mut i: u64 = 0u64;

        while i < _match->cases.Size() {
            let case: *const CaseNode = _match->cases[i];
            let body_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "match_case");
            let mut next_block: LLVMBasicBlockRef = default_block;

            if i + 1u64 < _match->cases.Size() {
                next_block = LLVMAppendBasicBlockInContext(this.context, function, "match_next");
            }

            LLVMPositionBuilderAtEnd(this.builder, current_block);
            let mut condition: LLVMValueRef = null;

            if expression.Type().IsEnum() {
                condition = this.BuildPatternCondition(case->pattern, match_pointer, &expression.Type());
            } else {
                let value: QualifiedValue = this.CompileExpression(case->pattern, false);

                if !value.Null() {
                    condition = this.CompileBinaryOperation2(expression, value, TokenType::EQUAL, false, case->pattern).Value();
                } else {
                    ret;
                }
            }

            if case->guard != null {
                let guard_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "match_guard");
                let guard_fail: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "match_guard_fail");
                LLVMBuildCondBr(this.builder, condition, guard_block, next_block);

                LLVMPositionBuilderAtEnd(this.builder, guard_block);
                this.scope_manager.PushScope(String("guard"), false);
                if expression.Type().IsEnum() { this.BindPattern(case->pattern, match_pointer, &expression.Type()); }
                let guard_cond: LLVMValueRef = this.CompileExpression(case->guard, false).Value();
                if guard_cond == null { ret; }
                LLVMBuildCondBr(this.builder, guard_cond, body_block, guard_fail);

                LLVMPositionBuilderAtEnd(this.builder, guard_fail);
                this.scope_manager.PopScope();
                LLVMBuildBr(this.builder, next_block);

                LLVMPositionBuilderAtEnd(this.builder, body_block);
                this.scope_manager.PushScope(String("case"), false);
                if expression.Type().IsEnum() { this.BindPattern(case->pattern, match_pointer, &expression.Type()); }
            } else {
                LLVMBuildCondBr(this.builder, condition, body_block, next_block);

                LLVMPositionBuilderAtEnd(this.builder, body_block);
                this.scope_manager.PushScope(String("case"), false);
                if expression.Type().IsEnum() { this.BindPattern(case->pattern, match_pointer, &expression.Type()); }
            }

            this.CompileStatement(case->body);
            this.scope_manager.PopScope();

            if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
                if LLVMGetFirstUse(LLVMBasicBlockAsValue(LLVMGetInsertBlock(this.builder))) == null {
                    LLVMBuildUnreachable(this.builder);
                } else {
                    LLVMBuildBr(this.builder, end_block);
                    any_arm_branches_to_end = true;
                }
            }

            current_block = next_block;
            i += 1u64;
        }

        if _match->default != null {
            LLVMPositionBuilderAtEnd(this.builder, default_block);
            this.scope_manager.PushScope(String("default"), false);
            this.CompileStatement(_match->default->body);
            this.scope_manager.PopScope();

            if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
                if LLVMGetFirstUse(LLVMBasicBlockAsValue(LLVMGetInsertBlock(this.builder))) == null {
                    LLVMBuildUnreachable(this.builder);
                } else {
                    LLVMBuildBr(this.builder, end_block);
                    any_arm_branches_to_end = true;
                }
            }
        } else if current_block != end_block {
            LLVMPositionBuilderAtEnd(this.builder, current_block);

            if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
                LLVMBuildBr(this.builder, end_block);
                any_arm_branches_to_end = true;
            }
        }

        if !any_arm_branches_to_end && LLVMGetBasicBlockTerminator(end_block) == null {
            LLVMPositionBuilderAtEnd(this.builder, end_block);
            LLVMBuildUnreachable(this.builder);
        } else {
            LLVMPositionBuilderAtEnd(this.builder, end_block);
        }
    }

    priv CompileExtern(&mut this, _extern: *const ExternNode) {
        if !this.mangling {
            Logger::Log("Already in a extern block.", _extern as *const Node, LogSeverity::Error);
            ret;
        }

        if _extern->linkage != "C" {
            Logger::Log("Unknown linkage '" + _extern->linkage + "'.", _extern as *const Node, LogSeverity::Error);
            ret;
        }

        this.mangling = false;
        let mut i: u64 = 0u64;

        while i < _extern->declarations.Size() {
            this.CompileDeclarationThirdPass(_extern->declarations[i]);
            i += 1u64;
        }

        this.mangling = true;
    }

    priv CompileBlock(&mut this, block: *const BlockNode) {
        let mut i: u64 = 0u64;

        while i < block->statements.Size() {
            let statement: *const Node = block->statements[i];
            this.CompileStatement(statement);
            i += 1u64;
        }
    }

    priv CompileStatement(&mut this, statement: *const Node) {
        if statement->_type == NodeType::RETURN {
            this.CompileReturn(statement as *const ReturnNode);
        } else if statement->_type == NodeType::EXPRESSION {
            this.CompileExpression((statement as *const ExpressionNode)->expression, false);
        } else if statement->_type == NodeType::IF {
            this.CompileIf(statement as *const IfNode);
        } else if statement->_type == NodeType::IF_LET {
            this.CompileIfLet(statement as *const IfLetNode);
        } else if statement->_type == NodeType::WHILE {
            this.CompileWhile(statement as *const WhileNode);
        } else if statement->_type == NodeType::WHILE_LET {
            this.CompileWhileLet(statement as *const WhileLetNode);
        } else if statement->_type == NodeType::FOR {
            this.CompileFor(statement as *const ForNode);
        } else if statement->_type == NodeType::LOOP {
            this.CompileLoop(statement as *const LoopNode);
        } else if statement->_type == NodeType::MATCH {
            this.CompileMatch(statement as *const MatchNode);
        } else if statement->_type == NodeType::UNSAFE {
            this.CompileUnsafe(statement as *const UnsafeNode);
        } else if statement->_type == NodeType::BLOCK {
            this.CompileBlock(statement as *const BlockNode);
        } else if statement->_type == NodeType::CONTINUE {
            this.CompileContinue(statement as *const ContinueNode);
        } else if statement->_type == NodeType::BREAK {
            this.CompileBreak(statement as *const BreakNode);
        } else if statement->_type == NodeType::VARIABLE {
            this.CompileVariable(statement as *const VariableNode);
        } else if statement->_type == NodeType::ASSIGNMENT {
            this.CompileAssignment(statement as *const AssignmentNode);
        } else if statement->_type == NodeType::ASSEMBLY {
            this.CompileAssembly(statement as *const AssemblyNode);
        } else {
            Logger::Log("Unknown statement '" + statement->_type.ToString() + "'.", statement, LogSeverity::Error);
        }
    }

    priv CompileUnsafe(&mut this, _unsafe: *const UnsafeNode) {
        if this._unsafe {
            Logger::Log("Already in an unsafe statement.", _unsafe as *const Node, LogSeverity::Error);
            ret;
        }

        this._unsafe = true;
        this.CompileBlock(_unsafe->body);
        this._unsafe = false;
    }

    priv CompileReturn(&mut this, return: *const ReturnNode) {
        if return->expression != null {
            let return_type: &ReturnType = this.function->Return();
            let param_types: &Vector<ParameterType> = this.function->Parameters();
            let mut state: bool = false;

            if !param_types.Empty() {
                state = param_types[0u64].sret != null;
            }

            if return_type.sret != null || state {
                let mut value: QualifiedValue = this.CompileExpression(return->expression, true);

                if value.Null() {
                    ret;
                }

                if value.Type().Pointee().IsReference() {
                    value = QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
                }

                if LLVMGetTypeKind(return_type._type->Value()) == LLVMTypeKind::LLVMIntegerTypeKind {
                    if *return_type.sret != value.Type().Pointee() {
                        Logger::Log("Incompatible return types. ('" + return_type.sret->ToString() + "' != '" + value.Type().Pointee().ToString() + "').", return as *const Node, LogSeverity::Error);
                        ret;
                    }

                    let return_value: LLVMValueRef = LLVMBuildLoad2(this.builder, return_type._type->Value(), value.Value(), "");
                    this.scope_manager.InvokeDestructors(value);
                    LLVMBuildRet(this.builder, return_value);
                } else {
                    if *param_types[0u64].sret != value.Type().Pointee() {
                        Logger::Log("Incompatible return types. ('" + param_types[0u64].sret->ToString() + "' != '" + value.Type().Pointee().ToString() + "').", return as *const Node, LogSeverity::Error);
                        ret;
                    }

                    let mut _params: Vector<QualifiedValue>;
                    _params.PushBack(value);
                    this.CompileConstructor(value.Type().Pointee(), QualifiedValue(LLVMGetParam(this.function_ref, 0u32), param_types[0u64]._type), _params, return as *const Node);
                    this.scope_manager.InvokeDestructors(value);
                    LLVMBuildRetVoid(this.builder);
                }
            } else {
                let mut value: QualifiedValue = this.CompileExpression(return->expression, false);

                if value.Null() {
                    ret;
                }

                if value.Type().IsReference() {
                    if *return_type._type == value.Type().Pointee() {
                        value = QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
                    }
                }

                if return_type._type->IsReference() {
                    if return_type._type->Pointee() == value.Type() {
                        value = QualifiedValue(LLVMAddressOf(value.Value(), this.builder), this.type_manager.Pointer(value.Type(), value.Type().IsMutable()));
                    }
                }

                let mut state: bool = false;

                if return_type._type->IsPointer() && value.Type().IsPointer() {
                    if LLVMGetTypeKind(return_type._type->Pointee().Value()) == LLVMTypeKind::LLVMVoidTypeKind || value.Type().IsNullPointer() {
                        state = true;
                    }
                }

                if *return_type._type != value.Type() && !state {
                    Logger::Log("Incompatible return types. ('" + return_type._type->ToString() + "' != '" + value.Type().ToString() + "').", return as *const Node, LogSeverity::Error);
                    ret;
                }

                this.scope_manager.InvokeDestructors();
                LLVMBuildRet(this.builder, value.Value());
            }
        } else {
            this.scope_manager.InvokeDestructors();
            LLVMBuildRetVoid(this.builder);
        }
    }

    priv CompileCondition(&mut this, condition: *const Node) -> LLVMValueRef {
        let mut value: QualifiedValue = this.CompileExpression(condition, false);

        if value.Null() {
            ret null;
        }

        if value.Type().IsReference() {
            value = QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
        }

        if LLVMGetTypeKind(value.Type().Value()) != LLVMTypeKind::LLVMIntegerTypeKind || LLVMGetIntTypeWidth(value.Type().Value()) != 1u32 {
            Logger::Log("Invalid condition type '" + value.Type().ToString() + "'.", condition, LogSeverity::Error);
        }

        ret value.Value();
    }

    priv CompileIf(&mut this, _if: *const IfNode) {
        let function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
        let then_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
        let (mut else_block: LLVMBasicBlockRef, mut end_block: LLVMBasicBlockRef) = (null, null);

        if _if->_else != null {
            else_block = LLVMAppendBasicBlockInContext(this.context, function, "");
        } else {
            if end_block == null {
                end_block = LLVMAppendBasicBlockInContext(this.context, function, "");
            } else_block = end_block;
        }

        let condition: LLVMValueRef = this.CompileCondition(_if->condition);

        if condition != null {
            LLVMBuildCondBr(this.builder, condition, then_block, else_block);
        } else {
            ret;
        }

        LLVMPositionBuilderAtEnd(this.builder, then_block);
        this.scope_manager.PushScope(String("then"), false);
        this.CompileBlock(_if->body as *const BlockNode);
        this.scope_manager.PopScope();

        if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
            if end_block == null {
                end_block = LLVMAppendBasicBlockInContext(this.context, function, "");
            } LLVMBuildBr(this.builder, end_block);
        }

        if _if->_else != null {
            LLVMPositionBuilderAtEnd(this.builder, else_block);
            this.scope_manager.PushScope(String("else"), false);

            if _if->_else->_type == NodeType::IF_LET {
                this.CompileIfLet(_if->_else as *const IfLetNode);
            } else if _if->_else->_type == NodeType::IF {
                this.CompileIf(_if->_else as *const IfNode);
            } else {
                this.CompileBlock(_if->_else as *const BlockNode);
            }

            this.scope_manager.PopScope();

            if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
                if end_block == null {
                    end_block = LLVMAppendBasicBlockInContext(this.context, function, "");
                } LLVMBuildBr(this.builder, end_block);
            }
        }

        if end_block != null {
            LLVMPositionBuilderAtEnd(this.builder, end_block);
        }
    }

    priv CompileIfLet(&mut this, if_let: *const IfLetNode) {
        let function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
        let then_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
        let (mut else_block: LLVMBasicBlockRef, mut end_block: LLVMBasicBlockRef) = (null, null);

        if if_let->_else != null {
            else_block = LLVMAppendBasicBlockInContext(this.context, function, "");
        } else {
            if end_block == null {
                end_block = LLVMAppendBasicBlockInContext(this.context, function, "");
            } else_block = end_block;
        }

        let mut expression: QualifiedValue = this.CompileExpression(if_let->expression, false);

        if expression.Null() {
            ret;
        }

        if expression.Type().IsReference() {
            expression = QualifiedValue(LLVMBuildLoad2(this.builder, expression.Type().Pointee().Value(), expression.Value(), ""), expression.Type().Pointee());
        }

        let current: LLVMBasicBlockRef = LLVMGetInsertBlock(this.builder);
        LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(function));
        let mut match_pointer: LLVMValueRef = LLVMBuildAlloca(this.builder, expression.Type().Value(), "");
        LLVMPositionBuilderAtEnd(this.builder, current);
        LLVMBuildStore(this.builder, expression.Value(), match_pointer);
        let condition: LLVMValueRef = this.BuildPatternCondition(if_let->pattern, match_pointer, &expression.Type());
        LLVMBuildCondBr(this.builder, condition, then_block, else_block);

        LLVMPositionBuilderAtEnd(this.builder, then_block);
        this.scope_manager.PushScope(String("then"), false);
        this.BindPattern(if_let->pattern, match_pointer, &expression.Type());
        this.CompileStatement(if_let->body);
        this.scope_manager.PopScope();

        if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
            if end_block == null {
                end_block = LLVMAppendBasicBlockInContext(this.context, function, "");
            } LLVMBuildBr(this.builder, end_block);
        }

        if if_let->_else != null {
            LLVMPositionBuilderAtEnd(this.builder, else_block);
            this.scope_manager.PushScope(String("else"), false);

            if if_let->_else->_type == NodeType::IF_LET {
                this.CompileIfLet(if_let->_else as *const IfLetNode);
            } else if if_let->_else->_type == NodeType::IF {
                this.CompileIf(if_let->_else as *const IfNode);
            } else {
                this.CompileBlock(if_let->_else as *const BlockNode);
            }

            this.scope_manager.PopScope();

            if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
                if end_block == null {
                    end_block = LLVMAppendBasicBlockInContext(this.context, function, "");
                } LLVMBuildBr(this.builder, end_block);
            }
        }

        if end_block != null {
            LLVMPositionBuilderAtEnd(this.builder, end_block);
        }
    }

    priv CompileWhileLet(&mut this, while_let: *const WhileLetNode) {
        let function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
        let compare_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
        let loop_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
        let end_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");

        LLVMBuildBr(this.builder, compare_block);
        LLVMPositionBuilderAtEnd(this.builder, compare_block);

        let mut expression: QualifiedValue = this.CompileExpression(while_let->expression, false);

        if expression.Null() {
            ret;
        }

        if expression.Type().IsReference() {
            expression = QualifiedValue(LLVMBuildLoad2(this.builder, expression.Type().Pointee().Value(), expression.Value(), ""), expression.Type().Pointee());
        }

        let current: LLVMBasicBlockRef = LLVMGetInsertBlock(this.builder);
        LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(function));
        let mut match_pointer: LLVMValueRef = LLVMBuildAlloca(this.builder, expression.Type().Value(), "");
        LLVMPositionBuilderAtEnd(this.builder, current);
        LLVMBuildStore(this.builder, expression.Value(), match_pointer);
        let condition: LLVMValueRef = this.BuildPatternCondition(while_let->pattern, match_pointer, &expression.Type());
        LLVMBuildCondBr(this.builder, condition, loop_block, end_block);

        LLVMPositionBuilderAtEnd(this.builder, loop_block);
        this.blocks.PushBack(Pair<LLVMBasicBlockRef, LLVMBasicBlockRef>(compare_block, end_block));
        this.scope_manager.PushScope(String("while"), false);
        this.BindPattern(while_let->pattern, match_pointer, &expression.Type());
        this.CompileStatement(while_let->body);
        this.scope_manager.PopScope();
        this.blocks.PopBack();

        if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
            LLVMBuildBr(this.builder, compare_block);
        }

        LLVMPositionBuilderAtEnd(this.builder, end_block);
    }

    priv CompileWhile(&mut this, _while: *const WhileNode) {
        let function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
        let compare_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
        let loop_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
        let end_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");

        if _while->_else != null {
            let else_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
            let condition: LLVMValueRef = this.CompileCondition(_while->condition);

            if condition != null {
                LLVMBuildCondBr(this.builder, condition, loop_block, else_block);
            } else {
                ret;
            }

            LLVMPositionBuilderAtStart(this.builder, else_block);
            this.scope_manager.PushScope(String("else"), false);
            this.CompileBlock(_while->_else as *const BlockNode);
            this.scope_manager.PopScope();

            if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
                LLVMBuildBr(this.builder, end_block);
            }
        } else {
            LLVMBuildBr(this.builder, compare_block);
        }

        LLVMPositionBuilderAtStart(this.builder, compare_block);
        let condition: LLVMValueRef = this.CompileCondition(_while->condition);

        if condition != null {
            LLVMBuildCondBr(this.builder, condition, loop_block, end_block);
        } else {
            ret;
        }

        LLVMPositionBuilderAtStart(this.builder, loop_block);
        this.blocks.PushBack(Pair<LLVMBasicBlockRef, LLVMBasicBlockRef>(compare_block, end_block));
        this.scope_manager.PushScope(String("while"), false);
        this.CompileBlock(_while->body as *const BlockNode);
        this.scope_manager.PopScope();
        this.blocks.PopBack();

        if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
            LLVMBuildBr(this.builder, compare_block);
        }

        LLVMPositionBuilderAtStart(this.builder, end_block);
    }

    priv CompileFor(&mut this, _for: *const ForNode) {
        if _for->iterable->_type != NodeType::RANGE {
            Logger::Log("For loop currently only supports range expressions.", _for as *const Node, LogSeverity::Error);
            ret;
        }

        let range: *const RangeNode = _for->iterable as *const RangeNode;
        let start_val: QualifiedValue = this.CompileExpression(range->start, false);

        if start_val.Null() {
            ret;
        }

        let end_val: QualifiedValue = this.CompileExpression(range->end, false);

        if end_val.Null() {
            ret;
        }

        let iter_type: *const QualifiedType = &start_val.Type();

        let current: LLVMBasicBlockRef = LLVMGetInsertBlock(this.builder);
        LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
        let iter_alloca: LLVMValueRef = LLVMBuildAlloca(this.builder, iter_type->Value(), "");
        LLVMPositionBuilderAtEnd(this.builder, current);
        LLVMBuildStore(this.builder, start_val.Value(), iter_alloca);

        let function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
        let compare_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
        let loop_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
        let step_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
        let end_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");

        LLVMBuildBr(this.builder, compare_block);
        LLVMPositionBuilderAtStart(this.builder, compare_block);

        let iter_val: LLVMValueRef = LLVMBuildLoad2(this.builder, iter_type->Value(), iter_alloca, "");
        let mut condition: LLVMValueRef = null;
        let type_kind: LLVMTypeKind = LLVMGetTypeKind(iter_type->Value());

        if type_kind == LLVMTypeKind::LLVMFloatTypeKind || type_kind == LLVMTypeKind::LLVMDoubleTypeKind {
            if range->inclusive {
                condition = LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOLE, iter_val, end_val.Value(), "");
            } else {
                condition = LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOLT, iter_val, end_val.Value(), "");
            }
        } else {
            if range->inclusive {
                condition = LLVMBuildICmp(this.builder, iter_type->IsSigned() ? LLVMIntPredicate::LLVMIntSLE : LLVMIntPredicate::LLVMIntULE, iter_val, end_val.Value(), "");
            } else {
                condition = LLVMBuildICmp(this.builder, iter_type->IsSigned() ? LLVMIntPredicate::LLVMIntSLT : LLVMIntPredicate::LLVMIntULT, iter_val, end_val.Value(), "");
            }
        }

        LLVMBuildCondBr(this.builder, condition, loop_block, end_block);

        LLVMPositionBuilderAtStart(this.builder, loop_block);
        this.blocks.PushBack(Pair<LLVMBasicBlockRef, LLVMBasicBlockRef>(step_block, end_block));
        this.scope_manager.PushScope(String("for"), false);

        let iter_ptr: QualifiedValue = QualifiedValue(iter_alloca, this.type_manager.Pointer(iter_type, false), false, true);
        this.scope_manager.Set(_for->variable, SymbolKind::Variable, iter_ptr, false, _for as *const Node);

        this.CompileBlock(_for->body as *const BlockNode);
        this.scope_manager.PopScope();
        this.blocks.PopBack();

        if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
            LLVMBuildBr(this.builder, step_block);
        }

        LLVMPositionBuilderAtStart(this.builder, step_block);
        let current_val: LLVMValueRef = LLVMBuildLoad2(this.builder, iter_type->Value(), iter_alloca, "");
        let mut next_val: LLVMValueRef = null;

        if type_kind == LLVMTypeKind::LLVMFloatTypeKind || type_kind == LLVMTypeKind::LLVMDoubleTypeKind {
            next_val = LLVMBuildFAdd(this.builder, current_val, LLVMConstReal(iter_type->Value(), 1.0f64), "");
        } else {
            next_val = LLVMBuildAdd(this.builder, current_val, LLVMConstInt(iter_type->Value(), 1u64, 0i32), "");
        }

        LLVMBuildStore(this.builder, next_val, iter_alloca);
        LLVMBuildBr(this.builder, compare_block);

        LLVMPositionBuilderAtStart(this.builder, end_block);
    }

    priv CompileLoop(&mut this, _loop: *const LoopNode) {
        let function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
        let loop_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
        let end_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
        this.blocks.PushBack(Pair<LLVMBasicBlockRef, LLVMBasicBlockRef>(loop_block, end_block));

        LLVMBuildBr(this.builder, loop_block);
        LLVMPositionBuilderAtStart(this.builder, loop_block);
        this.scope_manager.PushScope(String("loop"), false);
        this.CompileBlock(_loop->body as *const BlockNode);
        this.scope_manager.PopScope();

        if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
            LLVMBuildBr(this.builder, loop_block);
        }

        LLVMPositionBuilderAtStart(this.builder, end_block);
        this.blocks.PopBack();
    }

    priv CompileContinue(&this, _continue: *const ContinueNode) {
        if this.blocks.Empty() {
            Logger::Log("Continue statement outside of loop.", _continue as *const Node, LogSeverity::Error);
            ret;
        }

        // this.scope_manager.InvokeDestructors();
        LLVMBuildBr(this.builder, this.blocks[this.blocks.Size() - 1u64].left);
    }

    priv CompileBreak(&this, _break: *const BreakNode) {
        if this.blocks.Empty() {
            Logger::Log("Break statement outside of loop.", _break as *const Node, LogSeverity::Error);
            ret;
        }

        // this.scope_manager.InvokeDestructors();
        LLVMBuildBr(this.builder, this.blocks[this.blocks.Size() - 1u64].right);
    }

    priv CompileVariable(&mut this, variable: *const VariableNode) {
        let mut _type: *const QualifiedType = this.CompileType(variable->_type);

        if _type->IsClass() {
            let mut params: Vector<QualifiedValue>;
            let mut has_error: bool = false;
            let mut skip: bool = false;

            if variable->initializer != null {
                if variable->initializer->_type != NodeType::INITIALIZER_LIST {
                    let mut value: QualifiedValue = this.CompileExpression(variable->initializer, false);

                    if !value.Null() {
                        if !value.return {
                            if value.Type() == *_type {
                                value = QualifiedValue(LLVMAddressOf(value.Value(), this.builder), this.type_manager.Pointer(value.Type(), true));
                            } params.PushBack(value);
                        } else {
                            if *_type == value.Type() {
                                this.scope_manager.Set(variable->name, SymbolKind::Variable, QualifiedValue(LLVMAddressOf(value.Value(), this.builder), this.type_manager.Pointer(_type, variable->mutable), false, true), false, variable as *const Node);
                                skip = true;
                            } else {
                                Logger::Log("Incompatible variable initialization types. ('" + _type->ToString() + "' != '" + value.Type().ToString() + "').", variable as *const Node, LogSeverity::Error);
                                has_error = true;
                            }
                        }
                    } else {
                        has_error = true;
                    }
                } else {
                    let initializer_list: *const InitializerListNode = variable->initializer as *const InitializerListNode;
                    let mut i: u64 = 0u64;

                    while i < initializer_list->expressions.Size() {
                        let value: QualifiedValue = this.CompileExpression(initializer_list->expressions[i], false);

                        if value.Null() {
                            has_error = true;
                            break;
                        }

                        params.PushBack(value);
                        i += 1u64;
                    }
                }
            }

            if !skip {
                if !has_error {
                    let current: LLVMBasicBlockRef = LLVMGetInsertBlock(this.builder);
                    LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
                    let instance: QualifiedValue = QualifiedValue(LLVMBuildAlloca(this.builder, _type->Value(), ""), this.type_manager.Pointer(_type, variable->mutable), false, true);
                    LLVMPositionBuilderAtEnd(this.builder, current);

                    this.CompileConstructor(_type, instance, params, variable as *const Node);
                    this.scope_manager.Set(variable->name, SymbolKind::Variable, instance, false, variable as *const Node);
                    this.scope_manager.RegisterInstance(instance);
                } else {
                    this.scope_manager.Set(variable->name, SymbolKind::Variable, QualifiedValue(null, null), false, variable as *const Node);
                }
            }
        } else {
            if variable->initializer != null {
                if variable->initializer->_type == NodeType::INITIALIZER_LIST {
                    let list: *const InitializerListNode = variable->initializer as *const InitializerListNode;

                    if variable->_type->_type == NodeType::ARRAY_TYPE {
                        let array: *const ArrayTypeNode = variable->_type as *const ArrayTypeNode;

                        if array->size == null && !list->expressions.Empty() {
                            _type = this.type_manager.Array(_type->Pointee(), list->expressions.Size(), _type->IsMutable());
                        }
                    }
                }
            }

            let current: LLVMBasicBlockRef = LLVMGetInsertBlock(this.builder);
            LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
            let pointer: QualifiedValue = QualifiedValue(LLVMBuildAlloca(this.builder, _type->Value(), ""), this.type_manager.Pointer(_type, variable->mutable), false, true);
            LLVMPositionBuilderAtEnd(this.builder, current);

            if variable->initializer != null {
                if variable->initializer->_type != NodeType::INITIALIZER_LIST {
                    let mut initializer: QualifiedValue = this.CompileExpression(variable->initializer, false);

                    if !initializer.Null() {
                        if initializer.Type().IsReference() {
                            if *_type == initializer.Type().Pointee() {
                                initializer = QualifiedValue(LLVMBuildLoad2(this.builder, initializer.Type().Pointee().Value(), initializer.Value(), ""), initializer.Type().Pointee());
                            }
                        }

                        if _type->IsReference() {
                            if _type->Pointee() == initializer.Type() {
                                initializer = QualifiedValue(LLVMAddressOf(initializer.Value(), this.builder), this.type_manager.Pointer(initializer.Type(), initializer.Type().IsMutable()));
                            }
                        }

                        let mut left: *const QualifiedType = _type;
                        let mut right: *const QualifiedType = initializer.Type();
                        let mut failed: bool = false;

                        while left->IsPointer() && right->IsPointer() {
                            if left->IsMutable() && !right->IsMutable() && !right->IsNullPointer() {
                                Logger::Log("Cannot assign immutable pointer to mutable pointer.", variable as *const Node, LogSeverity::Error);
                                failed = true;
                                break;
                            }

                            (left, right) = (left->Pointee(), right->Pointee());
                        }

                        if !failed {
                            let mut state: bool = false;

                            if _type->IsPointer() && initializer.Type().IsPointer() {
                                if LLVMGetTypeKind(_type->Pointee().Value()) == LLVMTypeKind::LLVMVoidTypeKind || initializer.Type().IsNullPointer() {
                                    state = true;
                                }
                            }

                            if *_type == initializer.Type() || state {
                                LLVMBuildStore(this.builder, initializer.Value(), pointer.Value());
                            } else {
                                Logger::Log("Incompatible variable initialization types. ('" + _type->ToString() + "' != '" + initializer.Type().ToString() + "').", variable as *const Node, LogSeverity::Error);
                            }
                        }
                    }
                } else {
                    let initializer_list: *const InitializerListNode = variable->initializer as *const InitializerListNode;
                    let mut i: u64 = 0u64;

                    while i < initializer_list->expressions.Size() {
                        let value: QualifiedValue = this.CompileExpression(initializer_list->expressions[i], false);

                        if value.Null() {
                            break;
                        }

                        let indices[]: LLVMValueRef = { LLVMConstInt(LLVMInt32TypeInContext(this.context), i, 0i32) };
                        LLVMBuildStore(this.builder, value.Value(), LLVMBuildGEP2(this.builder, _type->Element().Value(), pointer.Value(), indices, 1u32, ""));
                        i += 1u64;
                    }
                }
            }

            this.scope_manager.Set(variable->name, SymbolKind::Variable, pointer, false, variable as *const Node);
        }

        if variable->next != null {
            this.CompileVariable(variable->next);
        }
    }

    priv CompileAssignment(&mut this, assignment: *const AssignmentNode) -> QualifiedValue {
        let pointer: QualifiedValue = this.CompileExpression(assignment->left, true);

        if pointer.Null() {
            ret QualifiedValue(null, null);
        }

        let mut value: QualifiedValue = this.CompileExpression(assignment->right, false);

        if value.Null() {
            ret QualifiedValue(null, null);
        }

        value = this.CompileAssignment2(value, pointer, assignment->operator, false, assignment as *const Node);

        if assignment->next != null {
            this.CompileAssignment(assignment->next);
            ret QualifiedValue(null, null);
        } else {
            ret value;
        }
    }

    priv CompileAssignment2(&mut this, mut value: QualifiedValue, mut pointer: QualifiedValue, operator: TokenType, ignore: bool, node: *const Node) -> QualifiedValue {
        if pointer.Type().Pointee().IsReference() {
            pointer = QualifiedValue(LLVMBuildLoad2(this.builder, pointer.Type().Pointee().Value(), pointer.Value(), ""), pointer.Type().Pointee());
        }

        if pointer.Type().Pointee().IsClass() {
            let mut params: Vector<QualifiedValue>;
            params.PushBack(value);

            let mut method_name: String = "op";
            method_name += operator.ToAssignmentOperatorString();
            let param_types: Vector<*const QualifiedType> = this.ValueToType(params);
            let _class: &QualifiedType = pointer.Type().Pointee();

            if _class.Has(method_name, param_types) {
                let method: &Pair<Method, *const QualifiedType> = _class.Get(method_name, param_types, node);
                ret this.CompileCall2(QualifiedValue(method.left.value, method.right, pointer), params, false, false, node);
            }

            if !pointer.Type().IsMutable() && !ignore {
                Logger::Log("Cannot assign to immutable variable.", node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }

            if value.Type().IsReference() {
                if value.Type().Pointee() == _class {
                    value = QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
                }
            }

            if value.Type() == _class {
                if operator != TokenType::ASSIGN {
                    Logger::Log("Invalid class assignment operation '" + operator.ToString() + "' for type '" + _class.ToString() + "'.", node, LogSeverity::Error);
                    ret QualifiedValue(null, null);
                }

                let fields: &Map<String, Pair<Field, *const QualifiedType>> = _class.Fields();
                value = QualifiedValue(LLVMAddressOf(value.Value(), this.builder), this.type_manager.Pointer(value.Type(), true));
                let mut i: u64 = 0u64;

                while i < fields.Size() {
                    let field: &mut Pair<String, Pair<Field, *const QualifiedType>> = fields[i];
                    let mut _type: *const QualifiedType = field.right.right;

                    if _type->IsPointer() {
                        _type = this.type_manager.Copy(_type, true);
                    }

                    let _value: QualifiedValue = QualifiedValue(LLVMBuildLoad2(this.builder, _type->Value(), LLVMBuildStructGEP2(this.builder, value.Type().Pointee().Value(), value.Value(), _class.Index(field.left) as u32, ""), ""), _type);
                    let _pointer: QualifiedValue = QualifiedValue(LLVMBuildStructGEP2(this.builder, pointer.Type().Pointee().Value(), pointer.Value(), _class.Index(field.left) as u32, ""), this.type_manager.Pointer(_type, true));
                    this.CompileAssignment2(_value, _pointer, operator, ignore, node);
                    i += 1u64;
                }
            } else {
                Logger::Log("Incompatible class assignment types. ('" + _class.ToString() + "' != '" + value.Type().ToString() + "').", node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }
        } else {
            if operator != TokenType::ASSIGN {
                let other: QualifiedValue = QualifiedValue(LLVMBuildLoad2(this.builder, pointer.Type().Pointee().Value(), pointer.Value(), ""), pointer.Type().Pointee());
                let (value_kind: LLVMTypeKind, other_kind: LLVMTypeKind) = (LLVMGetTypeKind(pointer.Type().Pointee().Value()), LLVMGetTypeKind(value.Type().Value()));

                if value.Type().IsPointer() && other.Type().IsPointer() {
                    if operator == TokenType::MINUS_ASSIGN {
                        let _type: &QualifiedType = this.type_manager.Primitive(LLVMInt64TypeInContext(this.context), false);
                        value = QualifiedValue(LLVMBuildSub(this.builder, LLVMBuildPtrToInt(this.builder, other.Value(), _type.Value(), ""), LLVMBuildPtrToInt(this.builder, value.Value(), _type.Value(), ""), ""), _type);
                    } else {
                        Logger::Log("Invalid pointer assignment operation '" + operator.ToString() + "' for type '" + value.Type().ToString() + "'.", node, LogSeverity::Error);
                        ret QualifiedValue(null, null);
                    }
                } else if (value.Type().IsPointer() && other_kind == LLVMTypeKind::LLVMIntegerTypeKind) || (value_kind == LLVMTypeKind::LLVMIntegerTypeKind && other.Type().IsPointer()) {
                    let ptr: &QualifiedValue = value.Type().IsPointer() ? &value : &other;
                    let index: &QualifiedValue = value.Type().IsPointer() ? &other : &value;
                    let width: u32 = LLVMGetIntTypeWidth(index.Type().Value());

                    if width == 64u32 {
                        if operator == TokenType::PLUS_ASSIGN {
                            let indices[]: LLVMValueRef = { index.Value() };
                            value = QualifiedValue(LLVMBuildGEP2(this.builder, ptr.Type().Pointee().Value(), ptr.Value(), indices, 1u32, ""), ptr.Type());
                        } else if operator == TokenType::MINUS_ASSIGN {
                            let indices[]: LLVMValueRef = { LLVMBuildNeg(this.builder, index.Value(), "") };
                            value = QualifiedValue(LLVMBuildGEP2(this.builder, ptr.Type().Pointee().Value(), ptr.Value(), indices, 1u32, ""), ptr.Type());
                        } else {
                            Logger::Log("Invalid pointer assignment operation '" + operator.ToString() + "' for type '" + ptr.Type().ToString() + "'.", node, LogSeverity::Error);
                            ret QualifiedValue(null, null);
                        }
                    } else {
                        Logger::Log("Invalid index type '" + index.Type().ToString() + "'.", node, LogSeverity::Error);
                        ret QualifiedValue(null, null);
                    }
                } else if value_kind == LLVMTypeKind::LLVMIntegerTypeKind && other_kind == LLVMTypeKind::LLVMIntegerTypeKind {
                    if value.Type() != other.Type() {
                        Logger::Log("Incompatible assignment operation types. ('" + value.Type().ToString() + "' != '" + other.Type().ToString() + "').", node, LogSeverity::Error);
                        ret QualifiedValue(null, null);
                    }

                    if operator == TokenType::PLUS_ASSIGN {
                        value = QualifiedValue(LLVMBuildAdd(this.builder, other.Value(), value.Value(), ""), value.Type());
                    } else if operator == TokenType::MINUS_ASSIGN {
                        value = QualifiedValue(LLVMBuildSub(this.builder, other.Value(), value.Value(), ""), value.Type());
                    } else if operator == TokenType::MUL_ASSIGN {
                        value = QualifiedValue(LLVMBuildMul(this.builder, other.Value(), value.Value(), ""), value.Type());
                    } else if operator == TokenType::DIV_ASSIGN {
                        if value.Type().IsSigned() {
                            value = QualifiedValue(LLVMBuildSDiv(this.builder, other.Value(), value.Value(), ""), value.Type());
                        } else {
                            value = QualifiedValue(LLVMBuildUDiv(this.builder, other.Value(), value.Value(), ""), value.Type());
                        }
                    } else if operator == TokenType::MOD_ASSIGN {
                        if value.Type().IsSigned() {
                            value = QualifiedValue(LLVMBuildSRem(this.builder, other.Value(), value.Value(), ""), value.Type());
                        } else {
                            value = QualifiedValue(LLVMBuildURem(this.builder, other.Value(), value.Value(), ""), value.Type());
                        }
                    } else if operator == TokenType::AND_ASSIGN {
                        value = QualifiedValue(LLVMBuildAnd(this.builder, other.Value(), value.Value(), ""), value.Type());
                    } else if operator == TokenType::OR_ASSIGN {
                        value = QualifiedValue(LLVMBuildOr(this.builder, other.Value(), value.Value(), ""), value.Type());
                    } else if operator == TokenType::XOR_ASSIGN {
                        value = QualifiedValue(LLVMBuildXor(this.builder, other.Value(), value.Value(), ""), value.Type());
                    } else if operator == TokenType::LSHIFT_ASSIGN {
                        value = QualifiedValue(LLVMBuildShl(this.builder, other.Value(), value.Value(), ""), value.Type());
                    } else if operator == TokenType::RSHIFT_ASSIGN {
                        if value.Type().IsSigned() {
                            value = QualifiedValue(LLVMBuildAShr(this.builder, other.Value(), value.Value(), ""), value.Type());
                        } else {
                            value = QualifiedValue(LLVMBuildLShr(this.builder, other.Value(), value.Value(), ""), value.Type());
                        }
                    } else {
                        Logger::Log("Invalid assignment operation '" + operator.ToString() + "' for type '" + value.Type().ToString() + "'.", node, LogSeverity::Error);
                        ret QualifiedValue(null, null);
                    }
                } else if (value_kind == LLVMTypeKind::LLVMFloatTypeKind || value_kind == LLVMTypeKind::LLVMDoubleTypeKind) && (other_kind == LLVMTypeKind::LLVMFloatTypeKind || other_kind == LLVMTypeKind::LLVMDoubleTypeKind) {
                    if value.Type() != other.Type() {
                        Logger::Log("Incompatible assignment operation types. ('" + value.Type().ToString() + "' != '" + other.Type().ToString() + "').", node, LogSeverity::Error);
                        ret QualifiedValue(null, null);
                    }

                    if operator == TokenType::PLUS_ASSIGN {
                        value = QualifiedValue(LLVMBuildFAdd(this.builder, other.Value(), value.Value(), ""), value.Type());
                    } else if operator == TokenType::MINUS_ASSIGN {
                        value = QualifiedValue(LLVMBuildFSub(this.builder, other.Value(), value.Value(), ""), value.Type());
                    } else if operator == TokenType::MUL_ASSIGN {
                        value = QualifiedValue(LLVMBuildFMul(this.builder, other.Value(), value.Value(), ""), value.Type());
                    } else if operator == TokenType::DIV_ASSIGN {
                        value = QualifiedValue(LLVMBuildFDiv(this.builder, other.Value(), value.Value(), ""), value.Type());
                    } else if operator == TokenType::MOD_ASSIGN {
                        value = QualifiedValue(LLVMBuildFRem(this.builder, other.Value(), value.Value(), ""), value.Type());
                    } else {
                        Logger::Log("Invalid assignment operation '" + operator.ToString() + "' for type '" + value.Type().ToString() + "'.", node, LogSeverity::Error);
                        ret QualifiedValue(null, null);
                    }
                } else {
                    Logger::Log("Invalid type '" + value.Type().ToString() + "' for assignment operation '" + operator.ToString() + "'.", node, LogSeverity::Error);
                    ret QualifiedValue(null, null);
                }
            }

            if !pointer.Type().IsMutable() && !ignore {
                Logger::Log("Cannot assign to immutable variable.", node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }

            if value.Type().IsReference() {
                if pointer.Type().Pointee() == value.Type().Pointee() {
                    value = QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
                }
            }

            let mut failed: bool = false;
            let mut left: *const QualifiedType = pointer.Type().Pointee();
            let mut right: *const QualifiedType = value.Type();

            while left->IsPointer() && right->IsPointer() {
                if left->IsMutable() && !right->IsMutable() && !right->IsNullPointer() {
                    Logger::Log("Cannot assign immutable pointer to mutable pointer.", node, LogSeverity::Error);
                    failed = true;
                    break;
                }

                (left, right) = (left->Pointee(), right->Pointee());
            }

            if !failed {
                let mut state: bool = false;

                if pointer.Type().Pointee().IsPointer() && value.Type().IsPointer() {
                    if LLVMGetTypeKind(pointer.Type().Pointee().Pointee().Value()) == LLVMTypeKind::LLVMVoidTypeKind || value.Type().IsNullPointer() {
                        state = true;
                    }
                }

                if value.Type() == pointer.Type().Pointee() || state {
                    LLVMBuildStore(this.builder, value.Value(), pointer.Value());
                } else {
                    Logger::Log("Incompatible assignment types. ('" + pointer.Type().Pointee().ToString() + "' != '" + value.Type().ToString() + "').", node, LogSeverity::Error);
                }
            }
        } ret pointer;
    }

    priv CompileExpression(&mut this, expression: *const Node, pointer: bool) -> QualifiedValue {
        if expression->_type == NodeType::LITERAL {
            ret this.CompileLiteral(expression as *const LiteralNode);
        } else if expression->_type == NodeType::CALL {
            ret this.CompileCall(expression as *const CallNode, pointer);
        } else if expression->_type == NodeType::TERNARY {
            ret this.CompileTernary(expression as *const TernaryNode, pointer);
        } else if expression->_type == NodeType::IDENTIFIER || expression->_type == NodeType::SCOPE_RESOLUTION {
            let symbol: *const Symbol = this.scope_manager.Resolve(expression, false);

            if symbol == null {
                ret QualifiedValue(null, null);
            }

            if symbol->value.Null() {
                ret QualifiedValue(null, null);
            }

            if (symbol->kind == SymbolKind::Variable || symbol->kind == SymbolKind::GlobalVariable || symbol->kind == SymbolKind::Constant || symbol->kind == SymbolKind::Parameter) && !pointer {
                if symbol->value.Type().IsPointer() {
                    if symbol->value.Type().Pointee().IsArray() {
                        let _type: &QualifiedType = this.type_manager.Pointer(symbol->value.Type().Pointee().Element(), symbol->value.Type().IsMutable());
                        ret QualifiedValue(LLVMBuildBitCast(this.builder, symbol->value.Value(), _type.Value(), ""), _type);
                    }
                }

                if symbol->kind == SymbolKind::Constant {
                    ret symbol->value;
                } else if symbol->kind == SymbolKind::GlobalVariable && !symbol->value.Type().Pointee().IsClass() && !symbol->value.Type().Pointee().IsPointer() {
                    ret QualifiedValue(LLVMGetInitializer(symbol->value.Value()), symbol->value.Type().Pointee());
                } else {
                    ret QualifiedValue(LLVMBuildLoad2(this.builder, symbol->value.Type().Pointee().Value(), symbol->value.Value(), ""), symbol->value.Type().Pointee());
                }
            } else if symbol->kind == SymbolKind::Function || pointer {
                ret symbol->value;
            } else {
                Logger::Log("Invalid symbol kind '" + symbol->kind.ToString() + "'.", expression, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }
        } else if expression->_type == NodeType::NEW {
            ret this.CompileNew(expression as *const NewNode);
        } else if expression->_type == NodeType::DELETE {
            ret this.CompileDelete(expression as *const DeleteNode);
        } else if expression->_type == NodeType::CAST {
            let value: QualifiedValue = this.CompileCast(expression as *const CastNode, pointer);

            if !pointer || (pointer && value.Type().IsPointer()) {
                ret value;
            } else {
                Logger::Log("Invalid pointer cast expression.", expression, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }
        } else if expression->_type == NodeType::INDEX_ACCESS {
            ret this.CompileIndexAccess(expression as *const IndexAccessNode, pointer);
        } else if expression->_type == NodeType::MEMBER_ACCESS {
            ret this.CompileMemberAccess(expression as *const MemberAccessNode, pointer);
        } else if expression->_type == NodeType::UNARY_OPERATION {
            ret this.CompileUnaryOperation(expression as *const UnaryOperationNode, pointer);
        } else if expression->_type == NodeType::BINARY_OPERATION {
            ret this.CompileBinaryOperation(expression as *const BinaryOperationNode, pointer);
        } else if expression->_type == NodeType::STRUCT_INIT {
            ret this.CompileStructInit(expression as *const StructInitNode);
        } else if expression->_type == NodeType::TYPE_APPLICATION {
            ret this.CompileTypeApplication(expression as *const TypeApplicationNode);
        } else {
            Logger::Log("Unknown expression '" + expression->_type.ToString() + "'.", expression, LogSeverity::Error);
            ret QualifiedValue(null, null);
        }
    }

    priv CompileTypeApplication(&mut this, node: *const TypeApplicationNode) -> QualifiedValue {
        let mut types: Vector<*const QualifiedType>;
        let mut i: u64 = 0u64;

        while i < node->types.Size() {
            types.PushBack(this.CompileType(node->types[i]));
            i += 1u64;
        }

        let mut name: String;

        if node->expression->_type == NodeType::IDENTIFIER {
            name = (node->expression as *const IdentifierNode)->name;
        } else if node->expression->_type == NodeType::PRIMITIVE_TYPE {
            name = (node->expression as *const PrimitiveTypeNode)->name;
        }

        if node->expression->_type == NodeType::IDENTIFIER || node->expression->_type == NodeType::PRIMITIVE_TYPE {
            if this.scope_manager.Has(name, SymbolKind::Generic) {
                let generic: *mut Generic = this.scope_manager.Get(name, SymbolKind::Generic)->pointer as *mut Generic;

                if generic->node->_type == NodeType::FUNCTION {
                    ret generic->Get(types).left;
                } else {
                    Logger::Log("Generic '" + name + "' is not a function.", node as *const Node, LogSeverity::Error);
                    ret QualifiedValue(null, null);
                }
            } else {
                if this.scope_manager.Has(name) {
                    Logger::Log("Symbol '" + name + "' is not generic.", node as *const Node, LogSeverity::Error);
                } else {
                    Logger::Log("Symbol '" + name + "' not found.", node as *const Node, LogSeverity::Error);
                }
                ret QualifiedValue(null, null);
            }
        } else if node->expression->_type == NodeType::SCOPE_RESOLUTION {
            let resolution: *const ScopeResolutionNode = node->expression as *const ScopeResolutionNode;
            let scope: *const Scope = this.scope_manager.ResolveScopeHalf(resolution, true);

            if scope != null {
                let symbol: *const Symbol = scope->Get(resolution->identifier->name, SymbolKind::Generic);

                if symbol != null {
                    ret (symbol->pointer as *mut Generic)->Get(types).left;
                } else {
                    ret QualifiedValue(null, null);
                }
            } else {
                ret QualifiedValue(null, null);
            }
        } else {
            Logger::Log("Invalid type application.", node as *const Node, LogSeverity::Error);
            ret QualifiedValue(null, null);
        }
    }

    priv CompileStructInit(&mut this, node: *const StructInitNode) -> QualifiedValue {
        let mut variant_name: String;

        if node->expression->_type == NodeType::IDENTIFIER {
            variant_name = (node->expression as *const IdentifierNode)->name;
        } else if node->expression->_type == NodeType::SCOPE_RESOLUTION {
            variant_name = (node->expression as *const ScopeResolutionNode)->identifier->name;
        } else {
            Logger::Log("Invalid struct init expression.", node as *const Node, LogSeverity::Error);
            ret QualifiedValue(null, null);
        }

        let variant_symbol: *const Symbol = this.scope_manager.Resolve(node->expression, false);

        if variant_symbol == null {
            Logger::Log("Unknown variant '" + variant_name + "'.", node as *const Node, LogSeverity::Error);
            ret QualifiedValue(null, null);
        }

        let mut enum_type: *const QualifiedType = null;

        if variant_symbol->value.Type().IsPointer() {
            enum_type = variant_symbol->value.Type().Pointee().Return()._type;
        } else {
            enum_type = variant_symbol->value.Type().Pointee();
        }

        let variant_index: i64 = this.VariantIndex(enum_type, &variant_name);

        if variant_index == -1i64 {
            Logger::Log("Unknown enum variant '" + variant_name + "'.", node as *const Node, LogSeverity::Error);
            ret QualifiedValue(null, null);
        }

        let variant_types: Vector<*const QualifiedType> = enum_type->variants[variant_index as u64].right;

        if node->field_names.Size() != variant_types.Size() {
            Logger::Log("Struct init field count does not match enum variant.", node as *const Node, LogSeverity::Error);
            ret QualifiedValue(null, null);
        }

        let mut ordered_args: Vector<QualifiedValue>;
        let mut i: u64 = 0u64;

        while i < variant_types.Size() {
            ordered_args.PushBack(QualifiedValue(null, null));
            i += 1u64;
        }

        let mut j: u64 = 0u64;

        while j < node->field_names.Size() {
            let field_index: i64 = this.VariantFieldIndex(enum_type, variant_index as u64, &node->field_names[j]);

            if field_index == -1i64 {
                Logger::Log("Unknown field '" + node->field_names[j] + "' for variant '" + variant_name + "'.", node as *const Node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }

            let value: QualifiedValue = this.CompileExpression(node->field_values[j], false);

            if !value.Null() {
                ordered_args[field_index as u64] = value;
            } else {
                ret QualifiedValue(null, null);
            } j += 1u64;
        }

        let tag_type: LLVMTypeRef = LLVMInt32TypeInContext(this.context);
        let struct_type: LLVMTypeRef = enum_type->Value();
        let data_type: LLVMTypeRef = LLVMStructGetTypeAtIndex(struct_type, 1u32);
        let mut alloca: LLVMValueRef = LLVMBuildAlloca(this.builder, struct_type, "struct_init");
        let tag_ptr: LLVMValueRef = LLVMBuildStructGEP2(this.builder, struct_type, alloca, 0u32, "tag_ptr");
        LLVMBuildStore(this.builder, LLVMConstInt(tag_type, variant_index as u64, 0i32), tag_ptr);

        let data_ptr: LLVMValueRef = LLVMBuildStructGEP2(this.builder, struct_type, alloca, 1u32, "data_ptr");
        let payload_type: LLVMTypeRef = this.CreateVariantPayloadType(variant_types);
        let payload_ptr: LLVMValueRef = LLVMBuildBitCast(this.builder, data_ptr, LLVMPointerType(payload_type, 0u32), "payload_ptr");
        let mut k: u64 = 0u64;

        while k < variant_types.Size() {
            let elem_ptr: LLVMValueRef = LLVMBuildStructGEP2(this.builder, payload_type, payload_ptr, k as u32, "");
            LLVMBuildStore(this.builder, ordered_args[k].Value(), elem_ptr);
            k += 1u64;
        }

        ret QualifiedValue(LLVMBuildLoad2(this.builder, struct_type, alloca, ""), enum_type);
    }

    priv CompileLiteral(&mut this, literal: *const LiteralNode) -> QualifiedValue {
        if literal->_type == TokenType::INTEGER {
            let (mut state: bool, mut base: i64) = (false, 10i64);
            let (mut signed: bool, mut width: u64) = (true, 32u64);
            let (mut value: String, mut size: String);
            let mut i: u64 = 0u64;

            while i < literal->value.Size() {
                if !state {
                    if i == 0u64 && literal->value[i] == '0' && (literal->value[i + 1u64] == 'x' || literal->value[i + 1u64] == 'o' || literal->value[i + 1u64] == 'b') {
                        if base != 10i64 {
                            Logger::Log("Invalid integer literal '" + literal->value + "'.", literal as *const Node, LogSeverity::Error);
                            ret QualifiedValue(null, null);
                        } else {
                            base = literal->value[i + 1u64] == 'x' ? 16i64 : (literal->value[i + 1u64] == 'o' ? 8i64 : 2i64);
                        } i += 1u64;
                    } else if literal->value[i] == 'u' {
                        (signed, state) = (false, true);
                    } else if literal->value[i] == 'i' {
                        (signed, state) = (true, true);
                    } else {
                        value += literal->value[i];
                    }
                } else {
                    size += literal->value[i];
                } i += 1u64;
            }

            let mut _type: LLVMTypeRef;
            width = size.ToInteger() as u64;

            if width == 128u64 {
                _type = LLVMInt128TypeInContext(this.context);
            } else if width == 64u64 {
                _type = LLVMInt64TypeInContext(this.context);
            } else if width == 32u64 {
                _type = LLVMInt32TypeInContext(this.context);
            } else if width == 16u64 {
                _type = LLVMInt16TypeInContext(this.context);
            } else if width == 8u64 {
                _type = LLVMInt8TypeInContext(this.context);
            } else {
                Logger::Log("Invalid integer size '" + size +  "'.", literal as *const Node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }

            ret QualifiedValue(LLVMConstInt(_type, value.ToInteger(base) as u64, signed ? 1i32 : 0i32), this.type_manager.Primitive(_type, signed));
        } else if literal->_type == TokenType::FLOAT {
            let (mut state: bool, mut i: u64) = (false, 0u64);
            let (mut value: String, mut size: String);
            let mut width: u64 = 32u64;

            while i < literal->value.Size() {
                if !state {
                    if literal->value[i] == 'f' {
                        state = true;
                    } else {
                        value += literal->value[i];
                    }
                } else {
                    size += literal->value[i];
                } i += 1u64;
            }

            let mut _type: LLVMTypeRef;
            width = size.ToInteger() as u64;

            if width == 64u64 {
                _type = LLVMDoubleTypeInContext(this.context);
            } else if width == 32u64 {
                _type = LLVMFloatTypeInContext(this.context);
            } else {
                Logger::Log("Invalid float size '" + size +  "'.", literal as *const Node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }

            ret QualifiedValue(LLVMConstReal(_type, value.ToFloat()), this.type_manager.Primitive(_type, false));
        } else if literal->_type == TokenType::TRUE || literal->_type == TokenType::FALSE {
            let _type: &QualifiedType = this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false);
            ret QualifiedValue(LLVMConstInt(_type.Value(), literal->_type == TokenType::TRUE ? 1u64 : 0u64, 0i32), _type);
        } else if literal->_type == TokenType::STRING {
            let value: LLVMValueRef = LLVMBuildGlobalStringPtr(this.builder, literal->value.Data(), "");
            ret QualifiedValue(value, this.type_manager.Pointer(this.type_manager.Primitive(LLVMInt8TypeInContext(this.context), true), false));
        } else if literal->_type == TokenType::CHAR {
            if (literal->value.Size() == 2u64 && literal->value[1u64] == '\0') || (literal->value.Size() == 1u64 && literal->value[0u64] == '\0') {
                let character: i8 = literal->value[0u64];
                let _type: &QualifiedType = this.type_manager.Primitive(LLVMInt8TypeInContext(this.context), true);
                ret QualifiedValue(LLVMConstInt(_type.Value(), character as u64, 0i32), _type);
            } else {
                Logger::Log("Invalid character literal '" + literal->value + "'.", literal as *const Node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }
        } else if literal->_type == TokenType::NULL {
            let _type: &QualifiedType = this.type_manager.NullPointer(LLVMVoidTypeInContext(this.context));
            ret QualifiedValue(LLVMConstNull(_type.Value()), _type);
        } else {
            Logger::Log("Unknown literal type '" + literal->_type.ToString() + "'.", literal as *const Node, LogSeverity::Error);
            ret QualifiedValue(null, null);
        }
    }

    priv CompileCall(&mut this, call: *const CallNode, pointer: bool) -> QualifiedValue {
        if call->expression->_type == NodeType::IDENTIFIER {
            let identifier: *const IdentifierNode = call->expression as *const IdentifierNode;

            if identifier->name == "sizeof" {
                if call->arguments.Size() != 1u64 {
                    Logger::Log("Invalid number of arguments for 'sizeof'.", call as *const Node, LogSeverity::Error);
                    ret QualifiedValue(null, null);
                }

                let mut _type: *const QualifiedType;
                let arg: *const Node = call->arguments[0u64];

                if arg->_type == NodeType::IDENTIFIER || arg->_type == NodeType::SCOPE_RESOLUTION {
                    let symbol: *const Symbol = this.scope_manager.Resolve(arg, false);

                    if symbol->kind == SymbolKind::Variable || symbol->kind == SymbolKind::GlobalVariable || symbol->kind == SymbolKind::Constant || symbol->kind == SymbolKind::Parameter {
                        if symbol->kind == SymbolKind::Constant {
                            _type = symbol->value.Type();
                        } else {
                            _type = symbol->value.Type().Pointee();
                        }
                    } else if symbol->kind == SymbolKind::Function {
                        _type = symbol->value.Type();
                    } else {
                        Logger::Log("Invalid symbol kind '" + symbol->kind.ToString() + "'.", arg, LogSeverity::Error);
                        ret QualifiedValue(null, null);
                    }
                } else {
                    _type = this.CompileType(arg);
                }

                let size: u64 = LLVMStoreSizeOfType(this.target->layout, _type->Value());
                let size_type: &QualifiedType = this.type_manager.Primitive(LLVMInt64TypeInContext(this.context), false);
                ret QualifiedValue(LLVMConstInt(size_type.Value(), size, 0i32), size_type);
            }
        }

        let mut values: Vector<QualifiedValue>;
        let mut i: u64 = 0u64;

        while i < call->arguments.Size() {
            if !this.CompileArgument(call->arguments[i], &values) {
                ret QualifiedValue(null, null);
            } i += 1u64;
        }

        if call->expression->_type == NodeType::MEMBER_ACCESS {
            let member_access: *const MemberAccessNode = call->expression as *const MemberAccessNode;
            let mut instance: QualifiedValue = this.CompileExpression(member_access->expression, true);
            if instance.Null() { ret QualifiedValue(null, null); }
            let mut state: bool = false;

            if instance.Type().IsPointer() {
                if instance.Type().Pointee().IsReference() {
                    instance = QualifiedValue(LLVMBuildLoad2(this.builder, instance.Type().Pointee().Value(), instance.Value(), ""), instance.Type().Pointee(), false, instance.binding);
                }

                if member_access->arrow && instance.Type().Pointee().IsClass() {
                    let values: Vector<QualifiedValue>;
                    let param_types: Vector<*const QualifiedType>;
                    let _class: &QualifiedType = instance.Type().Pointee();
                    let method_name: String = "op->";

                    if _class.Has(method_name, param_types) {
                        let method: &Pair<Method, *const QualifiedType> = _class.Get(method_name, param_types, member_access as *const Node);
                        instance = this.CompileCall2(QualifiedValue(method.left.value, method.right, instance), values, pointer, false, member_access as *const Node);
                    }
                } else if instance.binding || instance.Type().IsReference() {
                    if member_access->arrow {
                        instance = QualifiedValue(LLVMBuildLoad2(this.builder, instance.Type().Pointee().Value(), instance.Value(), ""), instance.Type().Pointee(), false, instance.binding);
                    }
                } else {
                    if !member_access->arrow && !instance.return && instance.Type().IsPointer() && (instance.Type().Pointee().IsClass() || instance.Type().Pointee().IsEnum()) {
                        Logger::Log("Expected an arrow operator.", call as *const Node, LogSeverity::Error);
                        ret QualifiedValue(null, null);
                    }
                }

                if !instance.Type().IsPointer() {
                    state = true;
                } else {
                    if !instance.Type().Pointee().IsClass() && !instance.Type().Pointee().IsEnum() {
                        state = true;
                    }
                }
            } else {
                state = true;
            }

            if state {
                if member_access->arrow {
                    Logger::Log("Expected a dot operator.", call as *const Node, LogSeverity::Error);
                    ret QualifiedValue(null, null);
                }

                if instance.Type().IsPointer() && instance.binding {
                    instance = QualifiedValue(LLVMBuildLoad2(this.builder, instance.Type().Pointee().Value(), instance.Value(), ""), instance.Type().Pointee());
                }

                values.Insert(0u64, instance);
                let symbol: *const Symbol = this.scope_manager.Resolve(member_access->member, this.ValueToType(values), call as *const Node, false);

                if symbol != null {
                    ret this.CompileCall2(symbol->value, values, pointer, false, call as *const Node);
                } else {
                    ret QualifiedValue(null, null);
                }
            } else {
                let mut _state: bool = true;
                let index: i64 = instance.Type().Pointee().IsClass() ? instance.Type().Pointee().Index(member_access->member) : -1i64;
                if this._class != null { _state = *this._class != instance.Type().Pointee(); }

                if index != -1i64 {
                    let field: &Pair<Field, *const QualifiedType> = instance.Type().Pointee().Fields()[member_access->member];

                    if field.left.visibility != TokenType::PUBLIC && _state {
                        Logger::Log("Field '" + member_access->member + "' is private.", call as *const Node, LogSeverity::Error);
                        ret QualifiedValue(null, null);
                    }

                    let field_pointer: LLVMValueRef = LLVMBuildStructGEP2(this.builder, instance.Type().Pointee().Value(), instance.Value(), index as u32, "");
                    ret this.CompileCall2(QualifiedValue(LLVMBuildLoad2(this.builder, field.right->Value(), field_pointer, ""), field.right), values, pointer, false, call as *const Node);
                } else {
                    let method: *const Pair<Method, *const QualifiedType> = instance.Type().Pointee().Get(member_access->member, this.ValueToType(values), call as *const Node);

                    if method != null {
                        ret this.CompileCall2(QualifiedValue(method->left.value, method->right, instance), values, pointer, false, call as *const Node);
                    } else {
                        ret QualifiedValue(null, null);
                    }
                }
            }
        } else if call->expression->_type == NodeType::TYPE_APPLICATION || call->expression->_type == NodeType::PRIMITIVE_TYPE {
            if call->expression->_type == NodeType::TYPE_APPLICATION {
                let type_application: *const TypeApplicationNode = call->expression as *const TypeApplicationNode;
                let mut types: Vector<*const QualifiedType>;
                let mut i: u64 = 0u64;

                while i < type_application->types.Size() {
                    types.PushBack(this.CompileType(type_application->types[i]));
                    i += 1u64;
                }

                if type_application->expression->_type == NodeType::PRIMITIVE_TYPE {
                    let primitive_type: *const PrimitiveTypeNode = type_application->expression as *const PrimitiveTypeNode;

                    if this.scope_manager.Has(primitive_type->name, SymbolKind::Generic) {
                        let generic: *mut Generic = this.scope_manager.Get(primitive_type->name, SymbolKind::Generic)->pointer as *mut Generic;

                        if generic->node->_type == NodeType::FUNCTION {
                            ret this.CompileCall2(generic->Get(types).left, values, pointer, false, call as *const Node);
                        }
                    } else {
                        if this.scope_manager.Has(primitive_type->name) {
                            Logger::Log("Function '" + primitive_type->name + "' is not generic.", call as *const Node, LogSeverity::Error);
                        } else {
                            Logger::Log("Function '" + primitive_type->name + "' not found.", call as *const Node, LogSeverity::Error);
                        } ret QualifiedValue(null, null);
                    }
                } else if type_application->expression->_type == NodeType::MEMBER_ACCESS {
                    let member_access: *const MemberAccessNode = type_application->expression as *const MemberAccessNode;
                    let mut instance: QualifiedValue = this.CompileExpression(member_access->expression, true);
                    if instance.Null() { ret QualifiedValue(null, null); }

                    if instance.Type().IsPointer() {
                        if instance.Type().Pointee().IsReference() {
                            instance = QualifiedValue(LLVMBuildLoad2(this.builder, instance.Type().Pointee().Value(), instance.Value(), ""), instance.Type().Pointee(), false, instance.binding);
                        }
                    }

                    if !instance.Type().IsPointer() {
                        Logger::Log("Member access value must be a pointer.", member_access as *const Node, LogSeverity::Error);
                        ret QualifiedValue(null, null);
                    }

                    let _class: *const QualifiedType = instance.Type().Pointee();

                    if _class->pack_scope != null {
                        let symbol: *const Symbol = _class->pack_scope->Get(member_access->member, SymbolKind::Generic);

                        if symbol != null {
                            let mut method: QualifiedValue = (symbol->pointer as *mut Generic)->Get(types).left;
                            (method.instance, method.instance_type) = (instance.Value(), instance.Type());
                            ret this.CompileCall2(method, values, pointer, false, call as *const Node);
                        } else {
                            ret QualifiedValue(null, null);
                        }
                    }
                } else if type_application->expression->_type == NodeType::SCOPE_RESOLUTION {
                    let resolution: *const ScopeResolutionNode = type_application->expression as *const ScopeResolutionNode;
                    let scope: *const Scope = this.scope_manager.ResolveScopeHalf(resolution, true);

                    if scope != null {
                        let symbol: *const Symbol = scope->Get(resolution->identifier->name, SymbolKind::Generic);

                        if symbol != null {
                            ret this.CompileCall2((symbol->pointer as *mut Generic)->Get(types).left, values, pointer, false, call as *const Node);
                        } else {
                            ret QualifiedValue(null, null);
                        }
                    } else {
                        ret QualifiedValue(null, null);
                    }
                }
            }

            let _class: &QualifiedType = this.CompileType(call->expression);
            let current: LLVMBasicBlockRef = LLVMGetInsertBlock(this.builder);
            LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
            let instance: QualifiedValue = QualifiedValue(LLVMBuildAlloca(this.builder, _class.Value(), ""), this.type_manager.Pointer(_class, true), false, true);
            LLVMPositionBuilderAtEnd(this.builder, current);
            this.CompileConstructor(_class, instance, values, call as *const Node);
            this.scope_manager.RegisterInstance(instance);

            if !pointer {
                ret QualifiedValue(LLVMBuildLoad2(this.builder, _class.Value(), instance.Value(), ""), _class);
            } else {
                ret instance;
            }
        } else {
            let mut state: bool = false;

            if call->expression->_type == NodeType::IDENTIFIER {
                let identifier: *const IdentifierNode = call->expression as *const IdentifierNode;
                state = !this.scope_manager.Has(identifier->name, SymbolKind::Variable) && !this.scope_manager.Has(identifier->name, SymbolKind::Parameter);
            } else if call->expression->_type == NodeType::SCOPE_RESOLUTION {
                let resolution: *const ScopeResolutionNode = call->expression as *const ScopeResolutionNode;
                let scope: *const Scope = this.scope_manager.ResolveScopeHalf(resolution, false);

                if scope != null {
                    state = !scope->Has(resolution->identifier->name, SymbolKind::Variable);
                } else {
                    ret QualifiedValue(null, null);
                }
            }

            if state {
                let symbol: *const Symbol = this.scope_manager.Resolve(call->expression, this.ValueToType(values), false);

                if symbol != null {
                    ret this.CompileCall2(symbol->value, values, pointer, false, call as *const Node);
                } else {
                    ret QualifiedValue(null, null);
                }
            } else {
                let value: QualifiedValue = this.CompileExpression(call->expression, false);

                if !value.Null() {
                    ret this.CompileCall2(value, values, pointer, false, call as *const Node);
                } else {
                    ret QualifiedValue(null, null);
                }
            }
        }
    }

    priv CompilePackSpecialization(&mut this, _func: &QualifiedValue, values: &Vector<QualifiedValue>, node: *const Node) -> QualifiedValue {
        let function_type: *const QualifiedType = _func.Type().Pointee();
        let declaration: *const FunctionNode = function_type->declaration;

        if declaration == null {
            Logger::Log("Pack function is missing its declaration.", node, LogSeverity::Error);
            ret QualifiedValue(null, null);
        }

        let mut pack_generic: *mut Generic = null;
        let mut prev_generic_types: Vector<*const QualifiedType>;
        let (prev_specializing: bool, prev_pack_types: Vector<*const QualifiedType>) = (this.pack_specializing, this.pack_types);
        let (prev_scope: *mut Scope, prev_generic: *mut Generic, prev_class: *const QualifiedType) = (this.scope_manager.current, this.generic, this._class);
        let mut symbols: Vector<*const Symbol>;
        this.pack_types.Clear();

        let mut fixed_count: u64 = 0u64;
        let params: &Vector<ParameterType> = function_type->Parameters();

        if !params.Empty() {
            fixed_count = params.Size();
            if params[0u64].sret != null { fixed_count -= 1u64; }
            if _func.instance != null { fixed_count -= 1u64; }
        }

        let mut i: u64 = fixed_count;

        while i < values.Size() {
            this.pack_types.PushBack(values[i].Type());
            i += 1u64;
        }

        if function_type->pack_generic != null {
            pack_generic = function_type->pack_generic;
            pack_generic->types = function_type->pack_generic_types;
            prev_generic_types = pack_generic->types;
            (this.scope_manager.current, this.generic) = (pack_generic->scope, pack_generic);
            let mut j: u64 = 0u64;

            while j < function_type->pack_generic_types.Size() {
                symbols.PushBack(pack_generic->scope->Set(pack_generic->type_names[j], SymbolKind::Type, QualifiedValue(null, function_type->pack_generic_types[j]), false, declaration as *const Node));
                j += 1u64;
            }
        } else if function_type->pack_scope != null {
            this.scope_manager.current = function_type->pack_scope;
        }

        if _func.instance_type != null && _func.instance_type->IsPointer() {
            this._class = _func.instance_type->Pointee();
        }

        this.pack_specializing = true;
        let result: QualifiedValue = this.CompileFunction(declaration, null);
        this.pack_specializing = prev_specializing;
        this.pack_types = prev_pack_types;
        let mut k: u64 = 0u64;

        while k < symbols.Size() {
            let index: i64 = pack_generic->scope->symbols.Index(symbols[k]);

            if index != -1i64 {
                pack_generic->scope->symbols.RemoveAt(index as u64);
                del symbols[k];
            } k += 1u64;
        }

        if pack_generic != null {
            pack_generic->types = prev_generic_types;
        }

        (this.scope_manager.current, this.generic, this._class) = (prev_scope, prev_generic, prev_class);

        if _func.instance != null {
            ret QualifiedValue(result.Value(), result.Type(), QualifiedValue(_func.instance, _func.instance_type));
        } ret result;
    }

    priv CompileCall2(&mut this, mut _func: QualifiedValue, values: &Vector<QualifiedValue>, pointer: bool, ignore: bool, node: *const Node) -> QualifiedValue {
        if _func.Type().Pointee().IsPointer() {
            if _func.Type().Pointee().Pointee().IsFunction() {
                _func = QualifiedValue(LLVMBuildLoad2(this.builder, _func.Type().Pointee().Value(), _func.Value(), ""), _func.Type().Pointee());
            }
        }

        if _func.Type().Pointee().pack_name != "" && !_func.Type().Pointee().IsPackSpecializedFunction() {
            _func = this.CompilePackSpecialization(&_func, values, node);
            if _func.Null() { ret QualifiedValue(null, null); }
        }

        let mut args: Vector<LLVMValueRef>;
        let ret_type: &ReturnType = _func.Type().Pointee().Return();
        let params: &Vector<ParameterType> = _func.Type().Pointee().Parameters();
        let mut return: QualifiedValue = QualifiedValue(null, null);
        let mut i: u64 = 0u64;

        if !params.Empty() {
            if params[0u64].sret != null {
                let current: LLVMBasicBlockRef = LLVMGetInsertBlock(this.builder);
                LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
                let _pointer: LLVMValueRef = LLVMBuildAlloca(this.builder, params[0u64].sret->Value(), "");
                return = QualifiedValue(_pointer, this.type_manager.Pointer(params[0u64].sret, true), true, true);
                LLVMPositionBuilderAtEnd(this.builder, current);
                args.PushBack(return.Value());

                if params[0u64].sret->IsClass() {
                    this.scope_manager.RegisterInstance(return);
                }
            }
        }

        if _func.instance != null {
            let mut param: *const QualifiedType = params[params[0u64].sret != null ? 1u64 : 0u64]._type;

            if param->IsMutable() && !_func.instance_type->IsMutable() && !ignore {
                Logger::Log("Cannot call mutable method '" + _func.Type().Pointee().name + "' on immutable instance.", node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            } else {
                args.PushBack(_func.instance);
            }
        }

        while i < values.Size() {
            let mut value: QualifiedValue = values[i];
            let mut index: u64 = params[0u64].sret != null ? i + 1u64 : i;

            if _func.instance != null {
                index += 1u64;
            }

            if index < params.Size() {
                let param: &ParameterType = params[index];

                if param.byval != null {
                    if value.Type().IsReference() {
                        value = QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
                    }

                    let mut state: bool = false;

                    if param.byval->IsPointer() && value.Type().IsPointer() {
                        if LLVMGetTypeKind(param.byval->Pointee().Value()) == LLVMTypeKind::LLVMVoidTypeKind || value.Type().IsNullPointer() {
                            state = true;
                        }
                    }

                    if *param.byval != value.Type() && !state {
                        Logger::Log("Incompatible argument types for function '" + _func.Type().Pointee().name + "'. ('" + param.byval->ToString() + "' != '" + value.Type().ToString() + "').", node, LogSeverity::Error);
                        ret QualifiedValue(null, null);
                    }

                    let mut source: QualifiedValue = value;

                    if value.return {
                        source = QualifiedValue(LLVMAddressOf(value.Value(), this.builder), this.type_manager.Pointer(value.Type(), value.Type().IsMutable()));
                    } else {
                        let source_current: LLVMBasicBlockRef = LLVMGetInsertBlock(this.builder);
                        LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(source_current)));
                        let source_pointer: LLVMValueRef = LLVMBuildAlloca(this.builder, value.Type().Value(), "");
                        LLVMPositionBuilderAtEnd(this.builder, source_current);
                        LLVMBuildStore(this.builder, value.Value(), source_pointer);
                        source = QualifiedValue(source_pointer, this.type_manager.Pointer(value.Type(), value.Type().IsMutable()), false, true);
                    }

                    let mut _params: Vector<QualifiedValue>;
                    _params.PushBack(source);
                    let current: LLVMBasicBlockRef = LLVMGetInsertBlock(this.builder);
                    LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
                    let pointer: LLVMValueRef = LLVMBuildAlloca(this.builder, source.Type().Pointee().Value(), "");
                    LLVMPositionBuilderAtEnd(this.builder, current);
                    value = QualifiedValue(pointer, source.Type());

                    if value.Type().Pointee().IsClass() {
                        this.CompileConstructor(value.Type().Pointee(), value, _params, node);
                    } else {
                        LLVMBuildStore(this.builder, LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), _params[0u64].Value(), ""), value.Value());
                    }

                    if LLVMGetTypeKind(param._type->Value()) != LLVMTypeKind::LLVMPointerTypeKind {
                        args.PushBack(LLVMBuildLoad2(this.builder, param._type->Value(), value.Value(), ""));
                    } else {
                        args.PushBack(value.Value());
                    }
                } else {
                    if value.Type().IsReference() {
                        if *param._type == value.Type().Pointee() {
                            value = QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
                        }
                    }

                    if param._type->IsReference() {
                        if param._type->Pointee() == value.Type() {
                            value = QualifiedValue(LLVMAddressOf(value.Value(), this.builder), this.type_manager.Pointer(value.Type(), value.Type().IsMutable()));
                        }
                    }

                    let mut state: bool = false;

                    if param._type->IsPointer() && value.Type().IsPointer() {
                        if LLVMGetTypeKind(param._type->Pointee().Value()) == LLVMTypeKind::LLVMVoidTypeKind || value.Type().IsNullPointer() {
                            state = true;
                        }
                    }

                    if *param._type != value.Type() && !state {
                        Logger::Log("Incompatible argument types for function '" + _func.Type().Pointee().name + "'. ('" + param._type->ToString() + "' != '" + value.Type().ToString() + "').", node, LogSeverity::Error);
                        ret QualifiedValue(null, null);
                    }

                    args.PushBack(value.Value());
                }
            } else {
                if value.Type().IsReference() {
                    value = QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
                } args.PushBack(value.Value());
            } i += 1u64;
        }

        let value: LLVMValueRef = LLVMBuildCall2(this.builder, _func.Type().Pointee().Value(), _func.Value(), args.Data(), args.Size() as u32, "");

        if ret_type.sret != null {
            let current: LLVMBasicBlockRef = LLVMGetInsertBlock(this.builder);
            LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
            let _pointer: LLVMValueRef = LLVMBuildAlloca(this.builder, ret_type.sret->Value(), "");
            return = QualifiedValue(_pointer, this.type_manager.Pointer(ret_type.sret, true), true, true);
            LLVMPositionBuilderAtEnd(this.builder, current);
            LLVMBuildStore(this.builder, value, LLVMBuildBitCast(this.builder, _pointer, LLVMPointerType(ret_type._type->Value(), 0u32), ""));

            if ret_type.sret->IsClass() {
                this.scope_manager.RegisterInstance(return);
            }
        }

        if return.Null() {
            ret QualifiedValue(value, ret_type._type);
        } else {
            if !pointer {
                ret QualifiedValue(LLVMBuildLoad2(this.builder, return.Type().Pointee().Value(), return.Value(), ""), return.Type().Pointee(), true);
            } else {
                ret return;
            }
        }
    }

    priv CompileTernary(&mut this, ternary: *const TernaryNode, pointer: bool) -> QualifiedValue {
        let function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
        let mut then_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
        let mut else_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
        let merge_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
        let condition: LLVMValueRef = this.CompileCondition(ternary->condition);

        if condition != null {
            LLVMBuildCondBr(this.builder, condition, then_block, else_block);
        } else { ret; }

        LLVMPositionBuilderAtEnd(this.builder, then_block);
        let then_value: QualifiedValue = this.CompileExpression(ternary->then, pointer);
        if then_value.Null() { ret QualifiedValue(null, null); }
        then_block = LLVMGetInsertBlock(this.builder);
        LLVMBuildBr(this.builder, merge_block);

        LLVMPositionBuilderAtEnd(this.builder, else_block);
        let else_value: QualifiedValue = this.CompileExpression(ternary->_else, pointer);
        if else_value.Null() { ret QualifiedValue(null, null); }
        else_block = LLVMGetInsertBlock(this.builder);
        LLVMBuildBr(this.builder, merge_block);
        let mut state: bool = false;

        if then_value.Type().IsPointer() && else_value.Type().IsPointer() {
            if then_value.Type().IsNullPointer() || else_value.Type().IsNullPointer() {
                state = true;
            }
        }

        if then_value.Type() != else_value.Type() && !state {
            Logger::Log("Incompatible ternary types. ('" + then_value.Type().ToString() + "' != '" + else_value.Type().ToString() + "').", ternary as *const Node, LogSeverity::Error);
            ret QualifiedValue(null, null);
        }

        LLVMPositionBuilderAtEnd(this.builder, merge_block);
        let phi: LLVMValueRef = LLVMBuildPhi(this.builder, then_value.Type().Value(), "");
        let incoming_blocks[]: LLVMBasicBlockRef = { then_block, else_block };
        let incoming_values[]: LLVMValueRef = { then_value.Value(), else_value.Value() };
        LLVMAddIncoming(phi, incoming_values, incoming_blocks, 2u32);
        ret QualifiedValue(phi, then_value.Type());
    }

    priv CompileIndexAccess(&mut this, index_access: *const IndexAccessNode, pointer: bool) -> QualifiedValue {
        let mut value: QualifiedValue = this.CompileExpression(index_access->expression, false);

        if value.Null() {
            ret QualifiedValue(null, null);
        }

        let index: QualifiedValue = this.CompileExpression(index_access->index, false);

        if index.Null() {
            ret QualifiedValue(null, null);
        }

        if value.Type().IsReference() {
            value = QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
        }

        if value.Type().IsClass() {
            let mut params: Vector<QualifiedValue>;
            params.PushBack(index);

            // value = QualifiedValue(LLVMAddressOf(value.Value(), this.builder), this.type_manager.Pointer(value.Type(), value.Type().IsMutable()));
            value = this.CompileExpression(index_access->expression, true);

            if value.Null() {
                ret QualifiedValue(null, null);
            }

            if value.Type().Pointee().IsReference() {
                value = QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
            }

            let method: *const Pair<Method, *const QualifiedType> = value.Type().Pointee().Get(String("op[]"), this.ValueToType(params), index_access as *const Node);

            if method != null {
                ret this.CompileCall2(QualifiedValue(method->left.value, method->right, value), params, pointer, false, index_access as *const Node);
            } else {
                ret QualifiedValue(null, null);
            }
        }

        if !value.Type().IsPointer() {
            Logger::Log("Index access value must be a pointer.", index_access as *const Node, LogSeverity::Error);
            ret QualifiedValue(null, null);
        }

        let indices[]: LLVMValueRef = { index.Value() };
        let target_pointer: LLVMValueRef = LLVMBuildGEP2(this.builder, value.Type().Pointee().Value(), value.Value(), indices, 1u32, "");
        ret QualifiedValue(target_pointer, this.type_manager.Reference(value.Type().Pointee(), value.Type().IsMutable()));
    }

    priv CompileMemberAccess(&mut this, member_access: *const MemberAccessNode, pointer: bool) -> QualifiedValue {
        let mut instance: QualifiedValue = this.CompileExpression(member_access->expression, true);

        if instance.Null() {
            ret QualifiedValue(null, null);
        }

        if instance.Type().IsPointer() {
            if instance.Type().Pointee().IsReference() {
                instance = QualifiedValue(LLVMBuildLoad2(this.builder, instance.Type().Pointee().Value(), instance.Value(), ""), instance.Type().Pointee(), false, instance.binding);
            }

            if member_access->arrow && instance.Type().Pointee().IsClass() {
                let values: Vector<QualifiedValue>;
                let param_types: Vector<*const QualifiedType>;
                let _class: &QualifiedType = instance.Type().Pointee();
                let method_name: String = "op->";

                if _class.Has(method_name, param_types) {
                    let method: &Pair<Method, *const QualifiedType> = _class.Get(method_name, param_types, member_access as *const Node);
                    instance = this.CompileCall2(QualifiedValue(method.left.value, method.right, instance), values, pointer, false, member_access as *const Node);
                }
            } else if instance.binding || instance.Type().IsReference() {
                if member_access->arrow {
                    instance = QualifiedValue(LLVMBuildLoad2(this.builder, instance.Type().Pointee().Value(), instance.Value(), ""), instance.Type().Pointee(), false, instance.binding);
                }
            } else {
                if !member_access->arrow && !instance.return {
                    Logger::Log("Expected an arrow operator.", member_access as *const Node, LogSeverity::Error);
                    ret QualifiedValue(null, null);
                }
            }
        }

        if !instance.Type().IsPointer() {
            Logger::Log("Member access value must be a pointer.", member_access as *const Node, LogSeverity::Error);
            ret QualifiedValue(null, null);
        }

        if !instance.Type().Pointee().IsClass() && !instance.Type().Pointee().IsEnum() {
            Logger::Log("Cannot access member '" + member_access->member + "' of non-class type.", member_access as *const Node, LogSeverity::Error);
            ret QualifiedValue(null, null);
        }

        let mut state: bool = true;
        let index: i64 = instance.Type().Pointee().IsClass() ? instance.Type().Pointee().Index(member_access->member) : -1i64;
        if this._class != null { state = *this._class != instance.Type().Pointee(); }

        if index != -1i64 {
            let field: &Pair<Field, *const QualifiedType> = instance.Type().Pointee().Fields()[member_access->member];

            if field.left.visibility != TokenType::PUBLIC && state {
                Logger::Log("Field '" + member_access->member + "' is private.", member_access as *const Node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }

            let field_pointer: LLVMValueRef = LLVMBuildStructGEP2(this.builder, instance.Type().Pointee().Value(), instance.Value(), index as u32, "");

            if !pointer {
                if field.right->IsArray() {
                    let _type: &QualifiedType = this.type_manager.Pointer(field.right->Element(), instance.Type().IsMutable());
                    ret QualifiedValue(LLVMBuildBitCast(this.builder, field_pointer, _type.Value(), ""), _type);
                } else {
                    ret QualifiedValue(LLVMBuildLoad2(this.builder, field.right->Value(), field_pointer, ""), field.right);
                }
            } else {
                ret QualifiedValue(field_pointer, this.type_manager.Pointer(field.right, instance.Type().IsMutable()), false, true);
            }
        } else {
            let method: *const Pair<Method, *const QualifiedType> = instance.Type().Pointee().Get(member_access->member, member_access as *const Node);

            if method != null {
                ret QualifiedValue(method->left.value, method->right, instance);
            } else {
                ret QualifiedValue(null, null);
            }
        }
    }

    priv CompileNew(&mut this, _new: *const NewNode) -> QualifiedValue {
        let _type: &QualifiedType = this.CompileType(_new->_type);
        let mut pointer: LLVMValueRef = null;

        if _new->size != null {
            let size: QualifiedValue = this.CompileExpression(_new->size, false);

            if size.Null() {
                ret QualifiedValue(null, null);
            }

            if LLVMGetTypeKind(size.Type().Value()) != LLVMTypeKind::LLVMIntegerTypeKind || LLVMGetIntTypeWidth(size.Type().Value()) != 64u32 || size.Type().IsSigned() {
                Logger::Log("Array size must be of type 'u64'.", _new as *const Node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }

            let mut _size: LLVMValueRef = LLVMConstInt(LLVMInt64TypeInContext(this.context), LLVMABISizeOfType(this.target->layout, _type.Value()), 0i32);
            _size = LLVMBuildAdd(this.builder, LLVMBuildMul(this.builder, _size, size.Value(), ""), LLVMConstInt(LLVMInt64TypeInContext(this.context), 8u64, 0i32), "");
            pointer = LLVMBuildArrayMalloc(this.builder, LLVMInt8TypeInContext(this.context), _size, "");
            LLVMBuildStore(this.builder, size.Value(), LLVMBuildBitCast(this.builder, pointer, LLVMPointerType(LLVMInt64TypeInContext(this.context), 0u32), ""));

            let indices[]: LLVMValueRef = { LLVMConstInt(LLVMInt64TypeInContext(this.context), 8u64, 0i32) };
            pointer = LLVMBuildGEP2(this.builder, LLVMInt8TypeInContext(this.context), pointer, indices, 1u32, "");
            pointer = LLVMBuildBitCast(this.builder, pointer, LLVMPointerType(_type.Value(), 0u32), "");

            if _type.IsClass() {
                let value: LLVMValueRef = LLVMBuildAlloca(this.builder, LLVMInt64TypeInContext(this.context), "");
                LLVMBuildStore(this.builder, LLVMConstInt(LLVMInt64TypeInContext(this.context), 0u64, 0i32), value);

                let function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
                let compare_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
                let loop_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
                let end_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");

                LLVMBuildBr(this.builder, compare_block);
                LLVMPositionBuilderAtStart(this.builder, compare_block);
                let index: LLVMValueRef = LLVMBuildLoad2(this.builder, LLVMInt64TypeInContext(this.context), value, "");
                LLVMBuildCondBr(this.builder, LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntULT, index, size.Value(), ""), loop_block, end_block);

                let params: Vector<QualifiedValue>;
                let indices[]: LLVMValueRef = { index };
                LLVMPositionBuilderAtStart(this.builder, loop_block);
                this.CompileConstructor(_type, QualifiedValue(LLVMBuildGEP2(this.builder, _type.Value(), pointer, indices, 1u32, ""), this.type_manager.Pointer(_type, true)), params, _new as *const Node);
                LLVMBuildStore(this.builder, LLVMBuildAdd(this.builder, index, LLVMConstInt(LLVMInt64TypeInContext(this.context), 1u64, 0i32), ""), value);
                LLVMBuildBr(this.builder, compare_block);
                LLVMPositionBuilderAtStart(this.builder, end_block);
            }
        } else {
            pointer = LLVMBuildMalloc(this.builder, _type.Value(), "");

            if _new->initialized {
                let mut values: Vector<QualifiedValue>;
                let mut i: u64 = 0u64;

                while _new->arguments.Size() > i {
                    if !this.CompileArgument(_new->arguments[i], &values) {
                        ret QualifiedValue(null, null);
                    } i += 1u64;
                }

                if _type.IsClass() {
                    this.CompileConstructor(_type, QualifiedValue(pointer, this.type_manager.Pointer(_type, true)), values, _new as *const Node);
                } else {
                    if values.Size() != 1u64 {
                        Logger::Log("Primitive type initialization requires exactly 1 argument.", _new as *const Node, LogSeverity::Error);
                        ret QualifiedValue(null, null);
                    }

                    let mut state: bool = false;
                    let value: &QualifiedValue = values[0u64];

                    if _type.IsPointer() && value.Type().IsPointer() {
                        if LLVMGetTypeKind(_type.Pointee().Value()) == LLVMTypeKind::LLVMVoidTypeKind || value.Type().IsNullPointer() {
                            state = true;
                        }
                    }

                    if value.Type() == _type || state {
                        LLVMBuildStore(this.builder, value.Value(), pointer);
                    } else {
                        Logger::Log("Incompatible primitive type initialization types. ('" + _type.ToString() + "' != '" + value.Type().ToString() + "').", _new as *const Node, LogSeverity::Error);
                        ret QualifiedValue(null, null);
                    }
                }
            }
        }

        ret QualifiedValue(pointer, this.type_manager.Pointer(_type, true));
    }

    priv CompileDelete(&mut this, delete: *const DeleteNode) -> QualifiedValue {
        let mut pointer: QualifiedValue = this.CompileExpression(delete->expression, false);

        if pointer.Null() {
            ret QualifiedValue(null, null);
        }

        if pointer.Type().IsReference() {
            pointer = QualifiedValue(LLVMBuildLoad2(this.builder, pointer.Type().Pointee().Value(), pointer.Value(), ""), pointer.Type().Pointee());
        }

        if !pointer.Type().IsPointer() {
            Logger::Log("Delete value must be a pointer.", delete as *const Node, LogSeverity::Error);
            ret QualifiedValue(null, null);
        }

        let mut _pointer: LLVMValueRef = pointer.Value();

        if LLVMGetTypeKind(pointer.Type().Pointee().Value()) != LLVMTypeKind::LLVMIntegerTypeKind || LLVMGetIntTypeWidth(pointer.Type().Pointee().Value()) != 8u32 {
            _pointer = LLVMBuildBitCast(this.builder, _pointer, LLVMPointerType(LLVMInt8TypeInContext(this.context), 0u32), "");
        }

        if delete->array {
            let indices[]: LLVMValueRef = { LLVMConstInt(LLVMInt64TypeInContext(this.context), -8i64 as u64, 0i32) };
            _pointer = LLVMBuildGEP2(this.builder, LLVMInt8TypeInContext(this.context), _pointer, indices, 1u32, "");

            if pointer.Type().Pointee().IsClass() {
                let count: LLVMValueRef = LLVMBuildLoad2(this.builder, LLVMInt64TypeInContext(this.context), LLVMBuildBitCast(this.builder, _pointer, LLVMPointerType(LLVMInt64TypeInContext(this.context), 0u32), ""), "");

                let value: LLVMValueRef = LLVMBuildAlloca(this.builder, LLVMInt64TypeInContext(this.context), "");
                LLVMBuildStore(this.builder, LLVMConstInt(LLVMInt64TypeInContext(this.context), 0u64, 0i32), value);

                let function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
                let compare_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
                let loop_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
                let end_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");

                LLVMBuildBr(this.builder, compare_block);
                LLVMPositionBuilderAtStart(this.builder, compare_block);
                let index: LLVMValueRef = LLVMBuildLoad2(this.builder, LLVMInt64TypeInContext(this.context), value, "");
                LLVMBuildCondBr(this.builder, LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntULT, index, count, ""), loop_block, end_block);

                let indices[]: LLVMValueRef = { index };
                LLVMPositionBuilderAtStart(this.builder, loop_block);
                this.CompileDestructor(pointer.Type().Pointee(), QualifiedValue(LLVMBuildGEP2(this.builder, pointer.Type().Pointee().Value(), pointer.Value(), indices, 1u32, ""), pointer.Type()), delete as *const Node);
                LLVMBuildStore(this.builder, LLVMBuildAdd(this.builder, index, LLVMConstInt(LLVMInt64TypeInContext(this.context), 1u64, 0i32), ""), value);
                LLVMBuildBr(this.builder, compare_block);
                LLVMPositionBuilderAtStart(this.builder, end_block);
            }
        } else {
            if pointer.Type().Pointee().IsClass() {
                this.CompileDestructor(pointer.Type().Pointee(), pointer, delete as *const Node);
            }
        }

        LLVMBuildFree(this.builder, _pointer);
        ret QualifiedValue(null, null);
    }

    priv CompileCast(&mut this, cast: *const CastNode, pointer: bool) -> QualifiedValue {
        let mut target: *const QualifiedType = this.CompileType(cast->target_type);

        if cast->expression->_type != NodeType::INITIALIZER_LIST {
            if pointer {
                target = this.type_manager.Pointer(target, target->IsMutable());
            }

            let value: QualifiedValue = this.CompileExpression(cast->expression, pointer);

            if !value.Null() {
                ret this.CompileCast2(value, target, cast as *const Node);
            } else {
                ret QualifiedValue(null, null);
            }
        } else {
            if !target->IsClass() {
                Logger::Log("Expected a class.", cast as *const Node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }

            let mut params: Vector<QualifiedValue>;
            let initializer_list: *const InitializerListNode = cast->expression as *const InitializerListNode;
            let mut i: u64 = 0u64;

            while i < initializer_list->expressions.Size() {
                let value: QualifiedValue = this.CompileExpression(initializer_list->expressions[i], false);

                if !value.Null() {
                    params.PushBack(value);
                } else {
                    ret QualifiedValue(null, null);
                } i += 1u64;
            }

            let current: LLVMBasicBlockRef = LLVMGetInsertBlock(this.builder);
            LLVMPositionBuilderAtStart(this.builder, LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(current)));
            let _pointer: LLVMValueRef = LLVMBuildAlloca(this.builder, target->Value(), "");
            LLVMPositionBuilderAtEnd(this.builder, current);
            let instance: QualifiedValue = QualifiedValue(_pointer, this.type_manager.Pointer(target, false), false, true);
            this.CompileConstructor(target, instance, params, cast as *const Node);
            this.scope_manager.RegisterInstance(instance);

            if !pointer {
                ret QualifiedValue(LLVMBuildLoad2(this.builder, target->Value(), instance.Value(), ""), target);
            } else {
                ret instance;
            }
        }
    }

    priv CompileCast2(&mut this, mut value: QualifiedValue, target: &QualifiedType, node: *const Node) -> QualifiedValue {
        if value.Type().IsReference() && !target.IsPointer() {
            value = QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
        }

        let mut left: *const QualifiedType = target;
        let mut right: *const QualifiedType = value.Type();
        let (mut state: bool, mut failed: bool) = (false, false);

        while left->IsPointer() && right->IsPointer() {
            if left->IsMutable() != right->IsMutable() {
                if left->IsMutable() && !right->IsNullPointer() {
                    failed = true;
                } state = true;
            }

            (left, right) = (left->Pointee(), right->Pointee());
        }

        if value.Type() == target {
            if state {
                if !failed || this._unsafe {
                    ret QualifiedValue(value.Value(), target);
                } else {
                    Logger::Log("Cannot cast immutable pointer to mutable pointer.", node, LogSeverity::Error);
                    ret QualifiedValue(null, null);
                }
            } else {
                Logger::Log("Redundant cast. ('" + value.Type().ToString() + "' to '" + target.ToString() + "')", node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }
        }

        let target_kind: LLVMTypeKind = LLVMGetTypeKind(target.Value());
        let value_kind: LLVMTypeKind = LLVMGetTypeKind(value.Type().Value());

        if value.Type().IsPointer() && target_kind == LLVMTypeKind::LLVMIntegerTypeKind {
            ret QualifiedValue(LLVMBuildPtrToInt(this.builder, value.Value(), target.Value(), ""), target);
        } else if value_kind == LLVMTypeKind::LLVMFloatTypeKind {
            if target_kind == LLVMTypeKind::LLVMIntegerTypeKind {
                if target.IsSigned() {
                    ret QualifiedValue(LLVMBuildFPToSI(this.builder, value.Value(), target.Value(), ""), target);
                } else {
                    ret QualifiedValue(LLVMBuildFPToUI(this.builder, value.Value(), target.Value(), ""), target);
                }
            }

            if target_kind == LLVMTypeKind::LLVMDoubleTypeKind {
                ret QualifiedValue(LLVMBuildFPExt(this.builder, value.Value(), target.Value(), ""), target);
            }
        } else if value_kind == LLVMTypeKind::LLVMDoubleTypeKind {
            if target_kind == LLVMTypeKind::LLVMIntegerTypeKind {
                if target.IsSigned() {
                    ret QualifiedValue(LLVMBuildFPToSI(this.builder, value.Value(), target.Value(), ""), target);
                } else {
                    ret QualifiedValue(LLVMBuildFPToUI(this.builder, value.Value(), target.Value(), ""), target);
                }
            }
            
            if target_kind == LLVMTypeKind::LLVMFloatTypeKind {
                ret QualifiedValue(LLVMBuildFPTrunc(this.builder, value.Value(), target.Value(), ""), target);
            }
        } else if value_kind == LLVMTypeKind::LLVMIntegerTypeKind {
            if target.IsPointer() {
                ret QualifiedValue(LLVMBuildIntToPtr(this.builder, value.Value(), target.Value(), ""), target);
            }

            if target_kind == LLVMTypeKind::LLVMFloatTypeKind || target_kind == LLVMTypeKind::LLVMDoubleTypeKind {
                if value.Type().IsSigned() {
                    ret QualifiedValue(LLVMBuildSIToFP(this.builder, value.Value(), target.Value(), ""), target);
                } else {
                    ret QualifiedValue(LLVMBuildUIToFP(this.builder, value.Value(), target.Value(), ""), target);
                }
            }

            if target_kind == LLVMTypeKind::LLVMIntegerTypeKind {
                let value_width: u32 = LLVMGetIntTypeWidth(value.Type().Value());
                let target_width: u32 = LLVMGetIntTypeWidth(target.Value());

                if target_width > value_width {
                    if value.Type().IsSigned() {
                        ret QualifiedValue(LLVMBuildSExt(this.builder, value.Value(), target.Value(), ""), target);
                    } else {
                        ret QualifiedValue(LLVMBuildZExt(this.builder, value.Value(), target.Value(), ""), target);
                    }
                } else if target_width < value_width {
                    ret QualifiedValue(LLVMBuildTrunc(this.builder, value.Value(), target.Value(), ""), target);
                } else {
                    ret QualifiedValue(value.Value(), target);
                }
            }
        }

        if value.Type().IsPointer() && target.IsPointer() {
            let mut pointer: LLVMValueRef = value.Value();

            if value.Type().Pointee().IsClass() && target.Pointee().IsClass() {
                let value_class: &QualifiedType = value.Type().Pointee();
                let target_class: &QualifiedType = target.Pointee();

                let value_fields: &Map<String, Pair<Field, *const QualifiedType>> = value_class.Fields();
                let target_fields: &Map<String, Pair<Field, *const QualifiedType>> = target_class.Fields();
                let (mut related: bool, mut index: u32) = (false, 0u32);
                let (mut i: u64, mut j: u64) = (0u64, 0u64);

                while value_fields.Size() > i && !related {
                    if value_fields[i].left == target_class.name {
                        (related, index) = (true, i as u32);
                        break;
                    } i += 1u64;
                }

                while target_fields.Size() > j && !related {
                    if target_fields[j].left == value_class.name {
                        (related, index) = (true, -(j as i64) as u32);
                        break;
                    } j += 1u64;
                }

                if !related {
                    Logger::Log("Cannot cast class '" + value_class.name + "' to unrelated class '" + target_class.name + "'.", node, LogSeverity::Error);
                    ret QualifiedValue(null, null);
                }

                if index != 0u32 {
                    pointer = LLVMBuildStructGEP2(this.builder, value.Type().Pointee().Value(), value.Value(), index, "");
                }
            }

            ret QualifiedValue(LLVMBuildBitCast(this.builder, pointer, target.Value(), ""), target, false, value.binding);
        } else {
            Logger::Log("Cannot cast '" + value.Type().ToString() + "' to '" + target.ToString() + "'.", node, LogSeverity::Error);
            ret QualifiedValue(null, null);
        }
    }

    priv CompileUnaryOperation(&mut this, unary: *const UnaryOperationNode, pointer: bool) -> QualifiedValue {
        if unary->operator == TokenType::BITWISE_AND {
            let _pointer: QualifiedValue = this.CompileExpression(unary->operand, true);

            if _pointer.Null() {
                ret QualifiedValue(null, null);
            }

            let mut method_name: String = "op";
            method_name += unary->operator.ToUnaryOperatorString();

            let mut param_types: Vector<*const QualifiedType>;
            param_types.PushBack(_pointer.Type().Pointee());

            let symbol: *const Symbol = this.scope_manager.Resolve(method_name, param_types, unary as *const Node, true);

            if symbol != null {
                let mut values: Vector<QualifiedValue>;
                values.PushBack(QualifiedValue(LLVMBuildLoad2(this.builder, _pointer.Type().Pointee().Value(), _pointer.Value(), ""), _pointer.Type().Pointee()));
                ret this.CompileCall2(symbol->value, values, pointer, false, unary as *const Node);
            }

            if _pointer.Type().Pointee().IsClass() {
                let values: Vector<QualifiedValue>;
                let _class: &QualifiedType = _pointer.Type().Pointee();
                let param_types: Vector<*const QualifiedType>;

                if _class.Has(method_name, param_types) {
                    let method: &Pair<Method, *const QualifiedType> = _class.Get(method_name, param_types, unary as *const Node);
                    ret this.CompileCall2(QualifiedValue(method.left.value, method.right, _pointer), values, pointer, false, unary as *const Node);
                }
            }

            if unary->mutable && !_pointer.Type().IsMutable() {
                Logger::Log("Cannot take mutable reference to immutable value of type '" + _pointer.Type().Pointee().ToString() + "'.", unary as *const Node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }

            ret QualifiedValue(_pointer.Value(), this.type_manager.Copy(_pointer.Type(), unary->mutable));
        } else {
            let mut value: QualifiedValue = this.CompileExpression(unary->operand, false);

            if value.Null() {
                ret QualifiedValue(null, null);
            }

            if value.Type().IsReference() {
                value = QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
            }

            let mut method_name: String = "op";
            method_name += unary->operator.ToUnaryOperatorString();

            let mut values: Vector<QualifiedValue>;
            values.PushBack(value);

            let symbol: *const Symbol = this.scope_manager.Resolve(method_name, this.ValueToType(values), unary as *const Node, true);

            if symbol != null {
                ret this.CompileCall2(symbol->value, values, pointer, false, unary as *const Node);
            }

            if value.Type().IsClass() {
                let values: Vector<QualifiedValue>;
                let param_types: Vector<*const QualifiedType>;
                let _class: &QualifiedType = value.Type();

                if _class.Has(method_name, param_types) {
                    let method: &Pair<Method, *const QualifiedType> = _class.Get(method_name, param_types, unary as *const Node);
                    let _instance: QualifiedValue = QualifiedValue(LLVMAddressOf(value.Value(), this.builder), this.type_manager.Pointer(_class, true));
                    ret this.CompileCall2(QualifiedValue(method.left.value, method.right, _instance), values, pointer, false, unary as *const Node);
                }
            }

            let kind: LLVMTypeKind = LLVMGetTypeKind(value.Type().Value());

            if unary->operator == TokenType::MUL {
                if value.Type().IsPointer() {
                    if !pointer {
                        ret QualifiedValue(LLVMBuildLoad2(this.builder, value.Type().Pointee().Value(), value.Value(), ""), value.Type().Pointee());
                    } else {
                        ret value;
                    }
                } else {
                    Logger::Log("Cannot dereference non-pointer type '" + value.Type().ToString() + "'.", unary as *const Node, LogSeverity::Error);
                    ret QualifiedValue(null, null);
                }
            } else if unary->operator == TokenType::MINUS {
                if kind == LLVMTypeKind::LLVMIntegerTypeKind {
                    if value.Type().IsSigned() {
                        ret QualifiedValue(LLVMBuildNeg(this.builder, value.Value(), ""), value.Type());
                    } else {
                        Logger::Log("Cannot negate unsigned type '" + value.Type().ToString() + "'.", unary as *const Node, LogSeverity::Error);
                        ret QualifiedValue(null, null);
                    }
                } else if kind == LLVMTypeKind::LLVMFloatTypeKind || kind == LLVMTypeKind::LLVMDoubleTypeKind {
                    ret QualifiedValue(LLVMBuildFNeg(this.builder, value.Value(), ""), value.Type());
                } else {
                    Logger::Log("Cannot negate type '" + value.Type().ToString() + "'.", unary as *const Node, LogSeverity::Error);
                    ret QualifiedValue(null, null);
                }
            } else if unary->operator == TokenType::NOT {
                if kind == LLVMTypeKind::LLVMIntegerTypeKind {
                    ret QualifiedValue(LLVMBuildNot(this.builder, value.Value(), ""), value.Type());
                } else {
                    Logger::Log("Cannot invert type '" + value.Type().ToString() + "'.", unary as *const Node, LogSeverity::Error);
                    ret QualifiedValue(null, null);
                }
            } else {
                Logger::Log("Invalid unary operation '" + unary->operator.ToString() + "'.", unary as *const Node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }
        }
    }

    priv CompileBinaryOperation(&mut this, binary: *const BinaryOperationNode, pointer: bool) -> QualifiedValue {
        let left: QualifiedValue = this.CompileExpression(binary->left, false);
        
        if left.Null() {
            ret QualifiedValue(null, null);
        }

#[if SHORT_CIRCUIT]
        if binary->operator == TokenType::AND || binary->operator == TokenType::OR {
            if LLVMGetTypeKind(left.Type().Value()) != LLVMTypeKind::LLVMIntegerTypeKind || LLVMGetIntTypeWidth(left.Type().Value()) != 1u32 {
                Logger::Log("Invalid type '" + left.Type().ToString() + "' for binary operation '" + binary->operator.ToString() + "'.", binary as *const Node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }

            let function: LLVMValueRef = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
            let mut right_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
            let merge_block: LLVMBasicBlockRef = LLVMAppendBasicBlockInContext(this.context, function, "");
            let left_block: LLVMBasicBlockRef = LLVMGetInsertBlock(this.builder);

            if binary->operator == TokenType::AND {
                LLVMBuildCondBr(this.builder, left.Value(), right_block, merge_block);
            } else {
                LLVMBuildCondBr(this.builder, left.Value(), merge_block, right_block);
            }

            LLVMPositionBuilderAtEnd(this.builder, right_block);
            let right: QualifiedValue = this.CompileExpression(binary->right, false);
            if right.Null() { ret QualifiedValue(null, null); }
            right_block = LLVMGetInsertBlock(this.builder);
            LLVMBuildBr(this.builder, merge_block);

            if LLVMGetTypeKind(right.Type().Value()) != LLVMTypeKind::LLVMIntegerTypeKind || LLVMGetIntTypeWidth(right.Type().Value()) != 1u32 {
                Logger::Log("Invalid type '" + right.Type().ToString() + "' for binary operation '" + binary->operator.ToString() + "'.", binary as *const Node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }

            LLVMPositionBuilderAtEnd(this.builder, merge_block);
            let phi: LLVMValueRef = LLVMBuildPhi(this.builder, left.Type().Value(), "");
            let incoming_values[]: LLVMValueRef = { left.Value(), right.Value() };
            let incoming_blocks[]: LLVMBasicBlockRef = { left_block, right_block };
            LLVMAddIncoming(phi, incoming_values, incoming_blocks, 2u32);
            ret QualifiedValue(phi, left.Type());
        }
#[endif]

        let right: QualifiedValue = this.CompileExpression(binary->right, false);

        if right.Null() {
            ret QualifiedValue(null, null);
        }

        ret this.CompileBinaryOperation2(left, right, binary->operator, pointer, binary as *const Node);
    }

    priv CompileBinaryOperation2(&mut this, mut left: QualifiedValue, mut right: QualifiedValue, operator: TokenType, pointer: bool, node: *const Node) -> QualifiedValue {
        if left.Type().IsReference() {
            left = QualifiedValue(LLVMBuildLoad2(this.builder, left.Type().Pointee().Value(), left.Value(), ""), left.Type().Pointee());
        }

        if right.Type().IsReference() {
            right = QualifiedValue(LLVMBuildLoad2(this.builder, right.Type().Pointee().Value(), right.Value(), ""), right.Type().Pointee());
        }

        let mut method_name: String = "op";
        method_name += operator.ToBinaryOperatorString();

        let mut values: Vector<QualifiedValue>;
        values.PushBack(left);
        values.PushBack(right);

        let symbol: *const Symbol = this.scope_manager.Resolve(method_name, this.ValueToType(values), node, true);

        if symbol != null {
            ret this.CompileCall2(symbol->value, values, pointer, false, node);
        }

        if left.Type().IsClass() || right.Type().IsClass() {
            let value: &QualifiedValue = left.Type().IsClass() ? &right : &left;
            let instance: &QualifiedValue = left.Type().IsClass() ? &left : &right;

            let mut values: Vector<QualifiedValue>;
            values.PushBack(value);

            let param_types: Vector<*const QualifiedType> = this.ValueToType(values);
            let _class: &QualifiedType = instance.Type();

            if _class.Has(method_name, param_types) {
                let method: &Pair<Method, *const QualifiedType> = _class.Get(method_name, param_types, node);
                let _instance: QualifiedValue = QualifiedValue(LLVMAddressOf(instance.Value(), this.builder), this.type_manager.Pointer(instance.Type(), instance.Type().IsMutable()));
                ret this.CompileCall2(QualifiedValue(method.left.value, method.right, _instance), values, pointer, false, node);
            }

            if left.Type() == right.Type() {
                if operator != TokenType::EQUAL && operator != TokenType::NOT_EQUAL {
                    Logger::Log("Invalid class binary operation '" + operator.ToString() + "' for type '" + _class.ToString() + "'.", node, LogSeverity::Error);
                    ret QualifiedValue(null, null);
                }

                let fields: &Map<String, Pair<Field, *const QualifiedType>> = _class.Fields();
                left = QualifiedValue(LLVMAddressOf(left.Value(), this.builder), this.type_manager.Pointer(left.Type(), true));
                right = QualifiedValue(LLVMAddressOf(right.Value(), this.builder), this.type_manager.Pointer(right.Type(), true));
                let mut result: LLVMValueRef = null;
                let mut i: u64 = 0u64;

                while i < fields.Size() {
                    let field: &mut Pair<String, Pair<Field, *const QualifiedType>> = fields[i];
                    let left: QualifiedValue = QualifiedValue(LLVMBuildLoad2(this.builder, field.right.right->Value(), LLVMBuildStructGEP2(this.builder, left.Type().Pointee().Value(), left.Value(), _class.Index(field.left) as u32, ""), ""), field.right.right);
                    let right: QualifiedValue = QualifiedValue(LLVMBuildLoad2(this.builder, field.right.right->Value(), LLVMBuildStructGEP2(this.builder, right.Type().Pointee().Value(), right.Value(), _class.Index(field.left) as u32, ""), ""), field.right.right);
                    let _result: LLVMValueRef = this.CompileBinaryOperation2(left, right, operator, pointer, node).Value();

                    if result != null {
                        result = LLVMBuildAnd(this.builder, result, _result, "");
                    } else {
                        result = _result;
                    } i += 1u64;
                }

                if operator == TokenType::NOT_EQUAL {
                    result = LLVMBuildNot(this.builder, result, "");
                }

                ret QualifiedValue(result, this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false));
            } else {
                Logger::Log("Incompatible class binary operation types. ('" + _class.ToString() + "' != '" + value.Type().ToString() + "').", node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }
        }

        let (left_kind: LLVMTypeKind, right_kind: LLVMTypeKind) = (LLVMGetTypeKind(left.Type().Value()), LLVMGetTypeKind(right.Type().Value()));

        if left.Type().IsPointer() && right.Type().IsPointer() {
            if operator == TokenType::MINUS {
                let _type: &QualifiedType = this.type_manager.Primitive(LLVMInt64TypeInContext(this.context), false);
                ret QualifiedValue(LLVMBuildSub(this.builder, LLVMBuildPtrToInt(this.builder, left.Value(), _type.Value(), ""), LLVMBuildPtrToInt(this.builder, right.Value(), _type.Value(), ""), ""), _type);
            } else if operator == TokenType::EQUAL {
                ret QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntEQ, left.Value(), right.Value(), ""), this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false));
            } else if operator == TokenType::NOT_EQUAL {
                ret QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntNE, left.Value(), right.Value(), ""), this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false));
            } else if operator == TokenType::GREATER {
                ret QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntUGT, left.Value(), right.Value(), ""), this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false));
            } else if operator == TokenType::GREATER_EQUAL {
                ret QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntUGE, left.Value(), right.Value(), ""), this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false));
            } else if operator == TokenType::LESS {
                ret QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntULT, left.Value(), right.Value(), ""), this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false));
            } else if operator == TokenType::LESS_EQUAL {
                ret QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntULE, left.Value(), right.Value(), ""), this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false));
            } else {
                Logger::Log("Invalid pointer binary operation '" + operator.ToString() + "' for type '" + left.Type().ToString() + "'.", node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }
        } else if (left.Type().IsPointer() && right_kind == LLVMTypeKind::LLVMIntegerTypeKind) || (left_kind == LLVMTypeKind::LLVMIntegerTypeKind && right.Type().IsPointer()) {
            let ptr: &QualifiedValue = left.Type().IsPointer() ? &left : &right;
            let index: &QualifiedValue = left.Type().IsPointer() ? &right : &left;
            let width: u32 = LLVMGetIntTypeWidth(index.Type().Value());

            if width == 64u32 {
                if operator == TokenType::PLUS {
                    let indices[]: LLVMValueRef = { index.Value() };
                    ret QualifiedValue(LLVMBuildGEP2(this.builder, ptr.Type().Pointee().Value(), ptr.Value(), indices, 1u32, ""), ptr.Type());
                } else if operator == TokenType::MINUS {
                    let indices[]: LLVMValueRef = { LLVMBuildNeg(this.builder, index.Value(), "") };
                    ret QualifiedValue(LLVMBuildGEP2(this.builder, ptr.Type().Pointee().Value(), ptr.Value(), indices, 1u32, ""), ptr.Type());
                } else {
                    Logger::Log("Invalid pointer binary operation '" + operator.ToString() + "' for type '" + left.Type().ToString() + "'.", node, LogSeverity::Error);
                    ret QualifiedValue(null, null);
                }
            } else {
                Logger::Log("Invalid index type '" + index.Type().ToString() + "'.", node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }
        } else if left_kind == LLVMTypeKind::LLVMIntegerTypeKind && right_kind == LLVMTypeKind::LLVMIntegerTypeKind {
            if left.Type() != right.Type() {
                Logger::Log("Incompatible binary operation types. ('" + left.Type().ToString() + "' != '" + right.Type().ToString() + "').", node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }

            if operator == TokenType::PLUS {
                ret QualifiedValue(LLVMBuildAdd(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if operator == TokenType::MINUS {
                ret QualifiedValue(LLVMBuildSub(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if operator == TokenType::MUL {
                ret QualifiedValue(LLVMBuildMul(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if operator == TokenType::DIV {
                if left.Type().IsSigned() {
                    ret QualifiedValue(LLVMBuildSDiv(this.builder, left.Value(), right.Value(), ""), left.Type());
                } else {
                    ret QualifiedValue(LLVMBuildUDiv(this.builder, left.Value(), right.Value(), ""), left.Type());
                }
            } else if operator == TokenType::MOD {
                if left.Type().IsSigned() {
                    ret QualifiedValue(LLVMBuildSRem(this.builder, left.Value(), right.Value(), ""), left.Type());
                } else {
                    ret QualifiedValue(LLVMBuildURem(this.builder, left.Value(), right.Value(), ""), left.Type());
                }
            } else if operator == TokenType::EQUAL {
                ret QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntEQ, left.Value(), right.Value(), ""), this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false));
            } else if operator == TokenType::NOT_EQUAL {
                ret QualifiedValue(LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntNE, left.Value(), right.Value(), ""), this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false));
            } else if operator == TokenType::GREATER {
                ret QualifiedValue(LLVMBuildICmp(this.builder, left.Type().IsSigned() ? LLVMIntPredicate::LLVMIntSGT : LLVMIntPredicate::LLVMIntUGT, left.Value(), right.Value(), ""), this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false));
            } else if operator == TokenType::GREATER_EQUAL {
                ret QualifiedValue(LLVMBuildICmp(this.builder, left.Type().IsSigned() ? LLVMIntPredicate::LLVMIntSGE : LLVMIntPredicate::LLVMIntUGE, left.Value(), right.Value(), ""), this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false));
            } else if operator == TokenType::LESS {
                ret QualifiedValue(LLVMBuildICmp(this.builder, left.Type().IsSigned() ? LLVMIntPredicate::LLVMIntSLT : LLVMIntPredicate::LLVMIntULT, left.Value(), right.Value(), ""), this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false));
            } else if operator == TokenType::LESS_EQUAL {
                ret QualifiedValue(LLVMBuildICmp(this.builder, left.Type().IsSigned() ? LLVMIntPredicate::LLVMIntSLE : LLVMIntPredicate::LLVMIntULE, left.Value(), right.Value(), ""), this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false));
            } else if operator == TokenType::AND || operator == TokenType::BITWISE_AND {
                if LLVMGetIntTypeWidth(left.Type().Value()) != 1u32 && operator == TokenType::AND {
                    Logger::Log("Invalid type '" + left.Type().ToString() + "' for binary operation '" + operator.ToString() + "'.", node, LogSeverity::Error);
                    ret QualifiedValue(null, null);
                } else {
                    ret QualifiedValue(LLVMBuildAnd(this.builder, left.Value(), right.Value(), ""), left.Type());
                }
            } else if operator == TokenType::OR || operator == TokenType::BITWISE_OR {
                if LLVMGetIntTypeWidth(left.Type().Value()) != 1u32 && operator == TokenType::OR {
                    Logger::Log("Invalid type '" + left.Type().ToString() + "' for binary operation '" + operator.ToString() + "'.", node, LogSeverity::Error);
                    ret QualifiedValue(null, null);
                } else {
                    ret QualifiedValue(LLVMBuildOr(this.builder, left.Value(), right.Value(), ""), left.Type());
                }
            } else if operator == TokenType::BITWISE_XOR {
                ret QualifiedValue(LLVMBuildXor(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if operator == TokenType::LSHIFT {
                ret QualifiedValue(LLVMBuildShl(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if operator == TokenType::RSHIFT {
                if left.Type().IsSigned() {
                    ret QualifiedValue(LLVMBuildAShr(this.builder, left.Value(), right.Value(), ""), left.Type());
                } else {
                    ret QualifiedValue(LLVMBuildLShr(this.builder, left.Value(), right.Value(), ""), left.Type());
                }
            } else {
                Logger::Log("Invalid binary operation '" + operator.ToString() + "' for type '" + left.Type().ToString() + "'.", node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }
        } else if (left_kind == LLVMTypeKind::LLVMFloatTypeKind || left_kind == LLVMTypeKind::LLVMDoubleTypeKind) && (right_kind == LLVMTypeKind::LLVMFloatTypeKind || right_kind == LLVMTypeKind::LLVMDoubleTypeKind) {
            if left.Type() != right.Type() {
                Logger::Log("Incompatible binary operation types. ('" + left.Type().ToString() + "' != '" + right.Type().ToString() + "').", node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }

            if operator == TokenType::PLUS {
                ret QualifiedValue(LLVMBuildFAdd(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if operator == TokenType::MINUS {
                ret QualifiedValue(LLVMBuildFSub(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if operator == TokenType::MUL {
                ret QualifiedValue(LLVMBuildFMul(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if operator == TokenType::DIV {
                ret QualifiedValue(LLVMBuildFDiv(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if operator == TokenType::MOD {
                ret QualifiedValue(LLVMBuildFRem(this.builder, left.Value(), right.Value(), ""), left.Type());
            } else if operator == TokenType::EQUAL {
                ret QualifiedValue(LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOEQ, left.Value(), right.Value(), ""), this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false));
            } else if operator == TokenType::NOT_EQUAL {
                ret QualifiedValue(LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealONE, left.Value(), right.Value(), ""), this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false));
            } else if operator == TokenType::GREATER {
                ret QualifiedValue(LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOGT, left.Value(), right.Value(), ""), this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false));
            } else if operator == TokenType::GREATER_EQUAL {
                ret QualifiedValue(LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOGE, left.Value(), right.Value(), ""), this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false));
            } else if operator == TokenType::LESS {
                ret QualifiedValue(LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOLT, left.Value(), right.Value(), ""), this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false));
            } else if operator == TokenType::LESS_EQUAL {
                ret QualifiedValue(LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOLE, left.Value(), right.Value(), ""), this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false));
            } else {
                Logger::Log("Invalid binary operation '" + operator.ToString() + "' for type '" + left.Type().ToString() + "'.", node, LogSeverity::Error);
                ret QualifiedValue(null, null);
            }
        } else {
            Logger::Log("Invalid type '" + left.Type().ToString() + "' for binary operation '" + operator.ToString() + "'.", node, LogSeverity::Error);
            ret QualifiedValue(null, null);
        }
    }

    priv CompileAssembly(&mut this, assembly: *const AssemblyNode) {
        if this.scope_manager.current->global {
            if !assembly->inputs.Empty() {
                Logger::Log("Cannot set inputs on module inline assembly.", assembly as *const Node, LogSeverity::Error);
            }

            if !assembly->outputs.Empty() {
                Logger::Log("Cannot set outputs on module inline assembly.", assembly as *const Node, LogSeverity::Error);
            }

            if !assembly->clobbers.Empty() {
                Logger::Log("Cannot set clobbers on module inline assembly.", assembly as *const Node, LogSeverity::Error);
            }

            LLVMSetModuleInlineAsm(this.module, assembly->code.Data());
        } else {
            let mut types: Vector<LLVMTypeRef>;
            let mut values: Vector<LLVMValueRef>;
            let mut output: QualifiedValue;
            let mut constraints: String;
            let mut i: u64 = 0u64;

            while i < assembly->outputs.Size() {
                if !constraints.Empty() { constraints += ","; }
                constraints += "={";
                constraints += assembly->outputs[i].left;
                constraints += "}";

                if !output.Null() {
                    Logger::Log("Output already set.", assembly->outputs[i].right, LogSeverity::Error);
                }

                output = this.CompileExpression(assembly->outputs[i].right, true);
                if output.Null() { ret; }
                i += 1u64;
            }

            let mut j: u64 = 0u64;

            while j < assembly->inputs.Size() {
                if !constraints.Empty() { constraints += ","; }
                constraints += "{";
                constraints += assembly->inputs[j].left;
                constraints += "}";
                let value: QualifiedValue = this.CompileExpression(assembly->inputs[j].right, false);
                if value.Null() { ret; }
                types.PushBack(value.Type().Value());
                values.PushBack(value.Value());
                j += 1u64;
            }

            let mut k: u64 = 0u64;

            while k < assembly->clobbers.Size() {
                if !constraints.Empty() { constraints += ","; }
                constraints += "~{";
                constraints += assembly->clobbers[k];
                constraints += "}";
                k += 1u64;
            }

            let function_type: LLVMTypeRef = LLVMFunctionType(!output.Null() ? output.Type().Pointee().Value() : LLVMVoidTypeInContext(this.context), types.Empty() ? null : types.Data(), types.Size() as u32, 0i32);
            let inline_asm: LLVMValueRef = LLVMGetInlineAsm(function_type, assembly->code.Data(), assembly->code.Length(), constraints.Data(), constraints.Length(), assembly->_volatile as i32, 0i32, LLVMInlineAsmDialect::LLVMInlineAsmDialectATT, 0i32);
            let result: LLVMValueRef = LLVMBuildCall2(this.builder, function_type, inline_asm, values.Empty() ? null : values.Data(), values.Size() as u32, "");

            if !output.Null() {
                LLVMBuildStore(this.builder, result, output.Value());
            }
        }
    }

    pub CompileType(&mut this, _type: *const Node) -> &mut QualifiedType {
        if _type->_type == NodeType::PRIMITIVE_TYPE {
            let primitive_type: *const PrimitiveTypeNode = _type as *const PrimitiveTypeNode;

            if primitive_type->name == "bool" {
                ret this.type_manager.Primitive(LLVMInt1TypeInContext(this.context), false);
            } else if primitive_type->name == "i8" || primitive_type->name == "u8" {
                ret this.type_manager.Primitive(LLVMInt8TypeInContext(this.context), primitive_type->name[0u64] != 'u' ? true : false);
            } else if primitive_type->name == "i16" || primitive_type->name == "u16" {
                ret this.type_manager.Primitive(LLVMInt16TypeInContext(this.context), primitive_type->name[0u64] != 'u' ? true : false);
            } else if primitive_type->name == "i32" || primitive_type->name == "u32" || primitive_type->name == "char" {
                ret this.type_manager.Primitive(LLVMInt32TypeInContext(this.context), primitive_type->name[0u64] != 'u' ? true : false);
            } else if primitive_type->name == "i64" || primitive_type->name == "u64" {
                ret this.type_manager.Primitive(LLVMInt64TypeInContext(this.context), primitive_type->name[0u64] != 'u' ? true : false);
            } else if primitive_type->name == "i128" || primitive_type->name == "u128" {
                ret this.type_manager.Primitive(LLVMInt128TypeInContext(this.context), primitive_type->name[0u64] != 'u' ? true : false);
            } else if primitive_type->name == "f32" {
                ret this.type_manager.Primitive(LLVMFloatTypeInContext(this.context), false);
            } else if primitive_type->name == "f64" {
                ret this.type_manager.Primitive(LLVMDoubleTypeInContext(this.context), false);
            } else if primitive_type->name == "void" {
                ret this.type_manager.Primitive(LLVMVoidTypeInContext(this.context), false);
            } else {
                if this.scope_manager.Has(primitive_type->name, SymbolKind::Type) {
                    ret this.scope_manager.Get(primitive_type->name, SymbolKind::Type)->value.Type();
                } else if this.scope_manager.Has(primitive_type->name, SymbolKind::Class) {
                    ret this.scope_manager.Get(primitive_type->name, SymbolKind::Class)->value.Type();
                } else if this.scope_manager.Has(primitive_type->name, SymbolKind::Generic) {
                    Logger::Log("Generic type '" + primitive_type->name + "' requires parameters.", _type, LogSeverity::Error);
                } else {
                    Logger::Log("Type '" + primitive_type->name + "' not found.", _type, LogSeverity::Error);
                } ret null;
            }
        } else if _type->_type == NodeType::TYPE_APPLICATION {
            let type_application: *const TypeApplicationNode = _type as *const TypeApplicationNode;
            let mut types: Vector<*const QualifiedType>;
            let mut i: u64 = 0u64;

            while i < type_application->types.Size() {
                types.PushBack(this.CompileType(type_application->types[i]));
                i += 1u64;
            }

            if type_application->expression->_type == NodeType::PRIMITIVE_TYPE {
                let primitive_type: *const PrimitiveTypeNode = type_application->expression as *const PrimitiveTypeNode;

                if this.scope_manager.Has(primitive_type->name, SymbolKind::Generic) {
                    ret (this.scope_manager.Get(primitive_type->name, SymbolKind::Generic)->pointer as *mut Generic)->Get(types).left.Type();
                } else {
                    if this.scope_manager.Has(primitive_type->name) {
                        Logger::Log("Type '" + primitive_type->name + "' is not generic.", _type, LogSeverity::Error);
                    } else {
                        Logger::Log("Type '" + primitive_type->name + "' not found.", _type, LogSeverity::Error);
                    } ret null;
                }
            } else {
                Logger::Log("Invalid type application.", _type, LogSeverity::Error);
                ret null;
            }
        } else if _type->_type == NodeType::POINTER_TYPE {
            let pointer_type: *const PointerTypeNode = _type as *const PointerTypeNode;
            ret this.type_manager.Pointer(this.CompileType(pointer_type->base_type), pointer_type->mutable);
        } else if _type->_type == NodeType::REFERENCE_TYPE {
            let reference_type: *const ReferenceTypeNode = _type as *const ReferenceTypeNode;
            ret this.type_manager.Reference(this.CompileType(reference_type->base_type), reference_type->mutable);
        } else if _type->_type == NodeType::ARRAY_TYPE {
            let array_type: *const ArrayTypeNode = _type as *const ArrayTypeNode;
            let element_type: *const QualifiedType = this.CompileType(array_type->element_type);

            if array_type->size == null {
                ret this.type_manager.Pointer(element_type, element_type->IsMutable());
            } else {
                let size: QualifiedValue = this.CompileExpression(array_type->size, false);

                if size.Null() {
                    ret null;
                }

                if LLVMGetTypeKind(size.Type().Value()) != LLVMTypeKind::LLVMIntegerTypeKind || LLVMGetIntTypeWidth(size.Type().Value()) != 64u32 || size.Type().IsSigned() {
                    Logger::Log("Array size must be of type 'u64'.", _type, LogSeverity::Error);
                    ret null;
                }

                ret this.type_manager.Array(element_type, LLVMConstIntGetZExtValue(size.Value()), element_type->IsMutable());
            }
        } else if _type->_type == NodeType::FUNCTION_TYPE {
            let function_type: *const FunctionTypeNode = _type as *const FunctionTypeNode;
            let (mut params: Vector<ParameterType>, mut param_types: Vector<LLVMTypeRef>);
            let mut return_type: ReturnType = this.CompileType(function_type->return_type);

            if LLVMGetTypeKind(return_type._type->Value()) == LLVMTypeKind::LLVMStructTypeKind && !return_type._type->IsEnum() {
                let processed_type: *const QualifiedType = this.ProcessType(return_type._type);

                if LLVMGetTypeKind(processed_type->Value()) != LLVMTypeKind::LLVMPointerTypeKind {
                    (return_type.sret, return_type._type) = (return_type._type, processed_type);
                } else {
                    let mut param_type: ParameterType = processed_type;
                    param_type.sret = return_type._type;
                    return_type._type = this.type_manager.Primitive(LLVMVoidTypeInContext(this.context), false);
                    param_types.PushBack(processed_type->Value());
                    params.PushBack(param_type);
                }
            }

            let mut i: u64 = 0u64;

            while i < function_type->parameters.Size() {
                let param: *const ParameterNode = function_type->parameters[i];
                let real_type: &QualifiedType = this.CompileType(param->_type);
                let mut param_type: ParameterType = real_type.IsEnum() ? real_type : this.ProcessType(real_type);

                if real_type != *param_type._type {
                    param_type.byval = real_type;
                }

                param_types.PushBack(param_type._type->Value());
                params.PushBack(param_type);
                i += 1u64;
            }

            ret this.type_manager.Pointer(this.type_manager.Function(LLVMFunctionType(return_type._type->Value(), param_types.Data(), param_types.Size() as u32, function_type->var_arg ? 1i32 : 0i32), params, return_type), false);
        } else {
            Logger::Log("Unknown type '" + _type->_type.ToString() + "'.", _type, LogSeverity::Error);
            ret null;
        }
    }
}

static mut compiler: *mut Compiler = null;
