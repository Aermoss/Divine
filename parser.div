class ExpressionStmtNode : ASTNode {
    pub expression: *const ASTNode;

    ExpressionStmtNode(&mut this, expression: *const ASTNode, row: u64, column: u64, file: String) : ASTNode(ASTNodeType::EXPRESSION_STMT, row, column, file) {
