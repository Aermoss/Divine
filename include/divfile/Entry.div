include "divio", "divstd", "divwin", "divstr", "divpair" : *;

func ReadFile(path: &String) -> String {
    let mut content: String;
    let file: *const FILE = fopen(path.Data(), "r");
    let buffer[256u64]: i8;

    if file == null {
        printf("\x1b[31mFailed to open file: '%s'.\x1b[0m\n", path.Data());
        ret content;
    }

    while fgets(buffer, sizeof(buffer) as i32, file) != null {
        content += buffer;
    }

    fclose(file);
    ret content;
}

func WriteFile(path: &String, content: &String) -> bool {
    let file: *const FILE = fopen(path.Data(), "w");

    if file == null {
        printf("\x1b[31mFailed to open file: '%s'.\x1b[0m\n", path.Data());
        ret false;
    }

    fwrite(content.Data(), 1u64, content.Size() - 1u64, file);
    fclose(file);
    ret true;
}

func GetTemporaryPath() -> String {
    let buffer[256u64]: i8;
    let length: DWORD = GetTempPathA(sizeof(buffer) as DWORD, buffer);

    if length > 0u32 && length < sizeof(buffer) as DWORD {
        ret String(buffer, 0u64, length as u64);
    } else {
        printf("\x1b[31mFailed to get temporary path.\x1b[0m\n");
        ret String();
    }
}

func JoinPath(directory: &String, file: &String) -> String {
    if directory.Empty() {
        ret file;
    }

    if directory[directory.Size() - 2u64] == '/' || directory[directory.Size() - 2u64] == '\\' {
        ret directory + file;
    } else {
        ret directory + '\\' + file;
    }
}

func PathExists(path: &String) -> bool {
    ret GetFileAttributesA(path.Data()) != INVALID_FILE_ATTRIBUTES;
}

func FileExists(path: &String) -> bool {
    let attributes: DWORD = GetFileAttributesA(path.Data());

    if attributes != INVALID_FILE_ATTRIBUTES {
        ret (attributes & FILE_ATTRIBUTE_DIRECTORY) == 0u32;
    } else {
        ret false;
    }
}

func FolderExists(path: &String) -> bool {
    let attributes: DWORD = GetFileAttributesA(path.Data());

    if attributes != INVALID_FILE_ATTRIBUTES {
        ret (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0u32;
    } else {
        ret false;
    }
}

func RemoveFile(path: &String) -> bool {
    ret DeleteFileA(path.Data()) != 0i32;
}

func SplitExtension(path: &String) -> Pair<String, String> {
    let mut i: u64 = path.Size();
    let mut index: u64 = path.Size();

    while i > 0u64 {
        i -= 1u64;

        if path[i] == '/' || path[i] == '\\' {
            break;
        }

        if path[i] == '.' {
            index = i;
            break;
        }
    }

    if index == path.Size() {
        ret Pair<String, String>(path, String());
    }

    let name: String = String(path, 0u64, index);
    let extension: String = String(path, index, path.Size());
    ret Pair<String, String>(name, extension);
}

func SplitPath(path: &String) -> Pair<String, String> {
    let mut i: u64 = path.Size();
    let mut index: u64 = path.Size();

    while i > 0u64 {
        i -= 1u64;

        if path[i] == '/' || path[i] == '\\' {
            index = i;
            break;
        }
    }

    if index == path.Size() {
        ret Pair<String, String>(String(), path); 
    }

    let directory: String = String(path, 0u64, index);
    let file: String = String(path, index + 1u64, path.Size());
    ret Pair<String, String>(directory, file);
}