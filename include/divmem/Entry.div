include "divdef" : *;

extern "C" {
#[if WINDOWS]
    func GetProcessHeap() -> *mut void;

    func HeapAlloc(hHeap: *mut void, dwFlags: u32, dwBytes: u64) -> *mut void;
    func HeapSize(hHeap: *mut void, dwFlags: u32, lpMem: *const void) -> u64;
    func HeapFree(hHeap: *mut void, dwFlags: u32, lpMem: *mut void) -> i32;

    func RtlCopyMemory(Destination: *mut void, Source: *const void, Length: u64);
    func RtlFillMemory(Destination: *mut void, Length: u64, Fill: u8);
#[endif]

    func malloc(size: size_t) -> *mut void #[if DARWIN] ; #[else] {
#[if WINDOWS]
        ret HeapAlloc(GetProcessHeap(), 0u32, size);
#[else]
        let total: i64 = (size + 8u64) as i64;
        let address: i64 = 0i64;

        volatile asm : rax(9i64), rdi(0i64), rsi(total), rdx(3i64), r10(0x22i64), r8(-1i64), r9(0i64) -> {
            syscall
        } -> rax(address) : memory, rcx, r11;

        if address == -1i64 { ret null; }
        let header: *mut i64 = address as *mut i64;
        header[0u64] = size as i64;
        ret (address + 8i64) as *mut void;
#[endif]
    } #[endif]

    func free(ptr: *const void) #[if DARWIN] ; #[else] {
        if ptr == null { ret; }
#[if WINDOWS]
        HeapFree(GetProcessHeap(), 0u32, ptr);
#[else]
        let base: i64 = ptr as i64 - 8i64;
        let header: *const i64 = base as *const i64;
        let size: i64 = header[0u64] + 8i64;

        volatile asm : rax(11i64), rdi(base), rsi(size) -> {
            syscall
        } : memory, rcx, r11, rax;
#[endif]
    } #[endif]

    func memcpy(dst: *mut void, src: *const void, size: size_t) -> *mut void #[if DARWIN] ; #[else] {
        if size == 0u64 || dst == null || src == null { ret dst; }
#[if WINDOWS]
        RtlCopyMemory(dst, src, size);
#[else]
        let _dst: *mut i8 = dst as *mut i8;
        let _src: *const i8 = src as *const i8;
        let _size: i64 = size as i64;

        volatile asm : rdi(_dst), rsi(_src), rcx(_size) -> {
            rep movsb
        } : memory, rdi, rsi, rcx;
#[endif]
        ret dst;
    } #[endif]

    func memset(ptr: *mut void, value: i32, num: size_t) -> *mut void #[if DARWIN] ; #[else] {
        if num == 0u64 || ptr == null { ret ptr; }
#[if WINDOWS]
        RtlFillMemory(ptr, num, value as u8);
#[else]
        let _ptr: *mut i8 = ptr as *mut i8;
        let _value: i8 = value as i8;
        let _num: i64 = num as i64;

        volatile asm : rdi(_ptr), al(_value), rcx(_num) -> {
            rep stosb
        } : memory, rdi, rcx;
#[endif]
        ret ptr;
    } #[endif]

    func calloc(nmemb: size_t, size: size_t) -> *mut void #[if DARWIN] ; #[else] {
        let total: size_t = nmemb * size;
        let ptr: *mut void = malloc(total);
        if ptr == null { ret null; }
        memset(ptr, 0i32, total);
        ret ptr;
    } #[endif]

    func realloc(ptr: *mut void, size: size_t) -> *mut void #[if DARWIN] ; #[else] {
        if ptr == null { ret malloc(size); }
        if size == 0u64 { free(ptr); ret null; }
#[if WINDOWS]
    let old_size: size_t = HeapSize(GetProcessHeap(), 0u32, ptr);
#[else]
    let header: *const i64 = (ptr as i64 - 8i64) as *const i64;
    let old_size: size_t = header[0u64] as size_t;
#[endif]
        if size <= old_size { ret ptr; }
        let new_ptr: *mut void = malloc(size);
        if new_ptr == null { ret null; }
        memcpy(new_ptr, ptr, old_size);
        free(ptr);
        ret new_ptr;
    } #[endif]
}