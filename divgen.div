type time_t = i64;

include "divfile", "divio", "divstr", "divmap", "divvec", "clang-c/Index.div", "lexer.div", "logger.div" : *;

enum TranspileState: i32 {
    None, Declared, Defined
}

class FileState {
    pub path: String,
    pub name: String,
    pub declarations: String,
    pub extern_functions: String,
    pub includes: Map<String, String>,
    pub count: u64 = 0u64
};

class GlobalState {
    pub files: Map<String, *mut FileState>,
    pub transpile_states: Map<String, TranspileState>,
    pub translation_unit: CXTranslationUnit = null,
    pub output_directory: String
};

func EnsureBlankLine(file_state: *mut FileState) {
    let length: u64 = file_state->declarations.Length();

    if length >= 2u64 && file_state->declarations[length - 1u64] == '\n' && file_state->declarations[length - 2u64] != '\n' {
        file_state->declarations += "\n";
    }
}

func GetFileState(state: *mut GlobalState, cursor: CXCursor) -> *mut FileState {
    let location: CXSourceLocation = clang_getCursorLocation(cursor);
    if clang_Location_isInSystemHeader(location) != 0i32 { ret null; }

    let mut file: CXFile = null;
    clang_getFileLocation(location, &mut file, null, null, null);
    if file == null { ret null; }

    let spelling: CXString = clang_getFileName(file);
    let path: String = String(clang_getCString(spelling));
    clang_disposeString(spelling);

    if state->files.Has(path) { ret state->files[path]; }
    let mut file_state: *mut FileState = new FileState();
    file_state->name = SplitExtension(SplitPath(path).right).left;
    (file_state->path, state->files[path]) = (path, file_state);
    ret file_state;
}

func FuncTypeToString(_type: CXType) -> String {
    let mut result: String = "func(";
    let num_args: i32 = clang_getNumArgTypes(_type);
    let mut i: i32 = 0i32;

    while i < num_args {
        result += TypeToString(clang_getArgType(_type, i as u32));

        if i < num_args - 1i32 {
            result += ", ";
        } i += 1i32;
    }

    if clang_isFunctionTypeVariadic(_type) != 0u32 {
        if num_args > 0i32 {
            result += ", ";
        } result += "...";
    }

    result += ")";
    let ret_type: CXType = clang_getResultType(_type);

    if ret_type.kind != CXTypeKind::CXType_Void {
        result += String(" -> ") + TypeToString(ret_type);
    } ret result;
}

func TypeToString(_type: CXType) -> String {
    if _type.kind == CXTypeKind::CXType_Void { ret String("void"); }
    else if _type.kind == CXTypeKind::CXType_Bool { ret String("bool"); }
    else if _type.kind == CXTypeKind::CXType_Char_U || _type.kind == CXTypeKind::CXType_UChar  { ret String("u8"); }
    else if _type.kind == CXTypeKind::CXType_Char_S || _type.kind == CXTypeKind::CXType_SChar  { ret String("i8"); }
    else if _type.kind == CXTypeKind::CXType_UShort { ret String("u16"); }
    else if _type.kind == CXTypeKind::CXType_Short { ret String("i16"); }
    else if _type.kind == CXTypeKind::CXType_UInt { ret String("u32"); }
    else if _type.kind == CXTypeKind::CXType_Int { ret String("i32"); }
    else if _type.kind == CXTypeKind::CXType_ULong || _type.kind == CXTypeKind::CXType_ULongLong { ret String("u64"); }
    else if _type.kind == CXTypeKind::CXType_Long || _type.kind == CXTypeKind::CXType_LongLong  { ret String("i64"); }
    else if _type.kind == CXTypeKind::CXType_Float { ret String("f32"); }
    else if _type.kind == CXTypeKind::CXType_Double { ret String("f64"); }
    else if _type.kind == CXTypeKind::CXType_WChar { ret String("u16"); }
    else if _type.kind == CXTypeKind::CXType_Pointer {
        let pointee: CXType = clang_getPointeeType(_type);

        if pointee.kind == CXTypeKind::CXType_FunctionProto || pointee.kind == CXTypeKind::CXType_FunctionNoProto {
            ret FuncTypeToString(pointee);
        }

        ret String(clang_isConstQualifiedType(pointee) != 0u32 ? "*const " : "*mut ") + TypeToString(pointee);
    } else if _type.kind == CXTypeKind::CXType_Record || _type.kind == CXTypeKind::CXType_Enum || _type.kind == CXTypeKind::CXType_Typedef {
        let spelling: CXString = clang_getTypeSpelling(_type);
        let mut string: String = String(clang_getCString(spelling));
        clang_disposeString(spelling);

        if string.StartsWith("struct ") {
            string = string.SubString(7u64);
        } else if string.StartsWith("enum ") {
            string = string.SubString(5u64);
        } else if string.StartsWith("const ") {
            string = string.SubString(6u64);
        } ret string;
    } else if _type.kind == CXTypeKind::CXType_IncompleteArray {
        ret String("*mut ") + TypeToString(clang_getArrayElementType(_type));
    } else {
        let spelling: CXString = clang_getTypeSpelling(_type);
        let string: String = String(clang_getCString(spelling));
        clang_disposeString(spelling);
        ret String("/* ") + string + " */";
    }
}

func VisitEnumChild(cursor: CXCursor, parent: CXCursor, client_data: CXClientData) -> i32 {
    if cursor.kind != CXCursorKind::CXCursor_EnumConstantDecl {
        ret CXChildVisitResult::CXChildVisit_Continue;
    }

    let file_state: *mut FileState = client_data as *mut FileState;
    let spelling: CXString = clang_getCursorSpelling(cursor);
    let name: String = String(clang_getCString(spelling));
    clang_disposeString(spelling);

    let value: i64 = clang_getEnumConstantDeclValue(cursor);
    file_state->declarations += String("    ") + name + " = " + String(value) + "i32,\n";
    ret CXChildVisitResult::CXChildVisit_Continue;
}

func VisitStructChild(cursor: CXCursor, parent: CXCursor, client_data: CXClientData) -> i32 {
    if cursor.kind != CXCursorKind::CXCursor_FieldDecl {
        ret CXChildVisitResult::CXChildVisit_Continue;
    }

    let file_state: *mut FileState = client_data as *mut FileState;
    let spelling: CXString = clang_getCursorSpelling(cursor);
    let mut name: String = String(clang_getCString(spelling));
    clang_disposeString(spelling);

    if name.Empty() {
        name = String("_") + String(file_state->count as i64);
        file_state->count += 1u64;
    } else if StringToKeyword(name) != TokenType::UNKNOWN {
        name = String("_") + name;
    }

    let _type: CXType = clang_getCursorType(cursor);

    if _type.kind == CXTypeKind::CXType_ConstantArray {
        file_state->declarations += String("    pub ") + name + "[" + String(clang_getArraySize(_type)) + "u64]: " + TypeToString(clang_getArrayElementType(_type)) + ",\n";
    } else {
        file_state->declarations += String("    pub ") + name + ": " + TypeToString(_type) + ",\n";
    }

    ret CXChildVisitResult::CXChildVisit_Continue;
}

func EmitEnum(state: *mut GlobalState, file_state: *mut FileState, cursor: CXCursor, name: &String) {
    EnsureBlankLine(file_state);

    let is_definition: bool = clang_isCursorDefinition(cursor) != 0u32;
    let transpile_state: TranspileState = state->transpile_states.Get(name, TranspileState::None);
    if transpile_state == TranspileState::Defined || (transpile_state == TranspileState::Declared && !is_definition) { ret; }
    state->transpile_states[name] = is_definition ? TranspileState::Defined : TranspileState::Declared;

    let length_before: u64 = file_state->declarations.Length();
    file_state->declarations += String("enum ") + name + ": i32 {\n";
    let length_header: u64 = file_state->declarations.Length();
    clang_visitChildren(cursor, VisitEnumChild, file_state as CXClientData);

    if file_state->declarations.Length() == length_header {
        file_state->declarations = String(file_state->declarations, 0u64, length_before) + "enum " + name + ": i32 {};\n\n";
    } else {
        file_state->declarations += "};\n\n";
    }
}

func EmitStruct(state: *mut GlobalState, file_state: *mut FileState, cursor: CXCursor, name: &String) {
    EnsureBlankLine(file_state);

    let is_definition: bool = clang_isCursorDefinition(cursor) != 0u32;
    let transpile_state: TranspileState = state->transpile_states.Get(name, TranspileState::None);
    if transpile_state == TranspileState::Defined || (transpile_state == TranspileState::Declared && !is_definition) { ret; }
    state->transpile_states[name] = is_definition ? TranspileState::Defined : TranspileState::Declared;

    file_state->count = 0u64;
    let length_before: u64 = file_state->declarations.Length();
    file_state->declarations += String("class ") + name + " {\n";
    let length_header: u64 = file_state->declarations.Length();
    clang_visitChildren(cursor, VisitStructChild, file_state as CXClientData);

    if file_state->declarations.Length() == length_header {
        file_state->declarations = String(file_state->declarations, 0u64, length_before) + "class " + name + " {};\n\n";
    } else {
        file_state->declarations += "};\n\n";
    }
}

func InferMacroType(value: &String) -> String {
    if value.Empty() { ret String(); }
    if value[0u64] == '"' { ret String("*const i8"); }
    if value[0u64] == '\'' { ret String("i8"); }
    let length: u64 = value.Length();

    if !(length >= 2u64 && value[0u64] == '0' && (value[1u64] == 'x' || value[1u64] == 'X')) {
        let mut i: u64 = 0u64;

        while i < length {
            if value[i] == '.' || value[i] == 'e' || value[i] == 'E' {
                if value[length - 1u64] == 'f' || value[length - 1u64] == 'F' {
                    ret String("f32");
                } ret String("f64");
            } i += 1u64;
        }
    }

    if value[length - 1u64] == 'u' || value[length - 1u64] == 'U' {
        ret String("u64");
    } else if value[length - 1u64] == 'l' || value[length - 1u64] == 'L' {
        if length >= 2u64 {
            if value[length - 2u64] == 'u' || value[length - 2u64] == 'U' {
                ret String("u64");
            }
        } ret String("i64");
    } ret String("i32");
}

func StripCSuffix(value: &String, _type: &String) -> String {
    let length: u64 = value.Length();

    if _type == "f32" {
        if length > 0u64 {
            if value[length - 1u64] == 'f' || value[length - 1u64] == 'F' {
                ret String(value, 0u64, length - 1u64);
            }
        } ret value;
    }

    if _type == "*const i8" || _type == "i8" || _type == "f64" {
        ret value;
    }

    let mut end: u64 = length;

    while end > 0u64 {
        if value[end - 1u64] == 'u' || value[end - 1u64] == 'U' || value[end - 1u64] == 'l' || value[end - 1u64] == 'L' {
            end -= 1u64;
        } else {
            break;
        }
    }

    ret String(value, 0u64, end);
}

func TranslateMacro(state: *mut GlobalState, file_state: *mut FileState, cursor: CXCursor) {
    if clang_Cursor_isMacroFunctionLike(cursor) != 0u32 { ret; }
    if clang_Cursor_isMacroBuiltin(cursor) != 0u32 { ret; }

    let name_spelling: CXString = clang_getCursorSpelling(cursor);
    let name: String = String(clang_getCString(name_spelling));
    clang_disposeString(name_spelling);
    if name.Empty() { ret; }

    if state->transpile_states.Has(name) { ret; }
    state->transpile_states[name] = TranspileState::Defined;

    let extent: CXSourceRange = clang_getCursorExtent(cursor);
    let (mut tokens: *mut CXToken, mut num_tokens: u32) = (null, 0u32);
    clang_tokenize(state->translation_unit, extent, &mut tokens, &mut num_tokens);

    if num_tokens != 2u32 || tokens == null {
        if tokens != null {
            clang_disposeTokens(state->translation_unit, tokens, num_tokens);
        } ret;
    }

    if clang_getTokenKind(tokens[1u64]) != CXTokenKind::CXToken_Literal {
        clang_disposeTokens(state->translation_unit, tokens, num_tokens);
        ret;
    }

    let value_spelling: CXString = clang_getTokenSpelling(state->translation_unit, tokens[1u64]);
    let value: String = String(clang_getCString(value_spelling));
    clang_disposeString(value_spelling);
    clang_disposeTokens(state->translation_unit, tokens, num_tokens);

    let _type: String = InferMacroType(value);
    if _type.Empty() { ret; }

    let stripped: String = StripCSuffix(value, _type);

    if _type == "*const i8" || _type == "i8" {
        file_state->declarations += String("const ") + name + ": " + _type + " = " + stripped + ";\n";
    } else {
        file_state->declarations += String("const ") + name + ": " + _type + " = " + stripped + _type + ";\n";
    }
}

extern "C" {
    func CreateDirectoryA(lpPathName: *const i8, lpSecurityAttributes: *mut void) -> i32;
}

func EnsureDirectory(path: &String) {
    if path.Empty() || FolderExists(path) { ret; }
    let directory: String = SplitPath(path).left;
    if !directory.Empty() { EnsureDirectory(directory); }
    CreateDirectoryA(path.Data(), null);
}

func VisitTopLevel(cursor: CXCursor, parent: CXCursor, client_data: CXClientData) -> i32 {
    let location: CXSourceLocation = clang_getCursorLocation(cursor);

    if clang_Location_isInSystemHeader(location) != 0i32 {
        ret CXChildVisitResult::CXChildVisit_Continue;
    }

    let state: *mut GlobalState = client_data as *mut GlobalState;
    let file_state: *mut FileState = GetFileState(state, cursor);

    if file_state == null {
        ret CXChildVisitResult::CXChildVisit_Continue;
    }

    if cursor.kind == CXCursorKind::CXCursor_InclusionDirective {
        let file: CXFile = clang_getIncludedFile(cursor);

        if file != null {
            let spelling: CXString = clang_getFileName(file);
            let path: String = String(clang_getCString(spelling));
            clang_disposeString(spelling);

            if !file_state->includes.Has(path) {
                file_state->includes[path] = SplitPath(SplitPath(path).left).right + "/" + SplitExtension(SplitPath(path).right).left + ".div";
            }
        }
    } else if cursor.kind == CXCursorKind::CXCursor_EnumDecl {
        let spelling: CXString = clang_getCursorSpelling(cursor);
        let name: String = String(clang_getCString(spelling));
        clang_disposeString(spelling);

        if !name.Empty() {
            EmitEnum(state, file_state, cursor, name);
        }
    } else if cursor.kind == CXCursorKind::CXCursor_StructDecl {
        let spelling: CXString = clang_getCursorSpelling(cursor);
        let name: String = String(clang_getCString(spelling));
        clang_disposeString(spelling);

        if !name.Empty() {
            EmitStruct(state, file_state, cursor, name);
        }
    } else if cursor.kind == CXCursorKind::CXCursor_TypedefDecl {
        let spelling: CXString = clang_getCursorSpelling(cursor);
        let name: String = String(clang_getCString(spelling));
        clang_disposeString(spelling);

        let transpile_state: TranspileState = state->transpile_states.Get(name, TranspileState::None);
        if transpile_state == TranspileState::Defined { ret CXChildVisitResult::CXChildVisit_Continue; }
        let underlying: CXType = clang_getTypedefDeclUnderlyingType(cursor);

        if underlying.kind == CXTypeKind::CXType_Record {
            let declaration: CXCursor = clang_getTypeDeclaration(underlying);
            let declaration_spelling: CXString = clang_getCursorSpelling(declaration);
            let declaration_name: String = String(clang_getCString(declaration_spelling));
            clang_disposeString(declaration_spelling);

            if declaration_name.Empty() || declaration_name == name {
                EmitStruct(state, file_state, declaration, name);
                ret CXChildVisitResult::CXChildVisit_Continue;
            }
        } else if underlying.kind == CXTypeKind::CXType_Enum {
            let declaration: CXCursor = clang_getTypeDeclaration(underlying);
            let declaration_spelling: CXString = clang_getCursorSpelling(declaration);
            let declaration_name: String = String(clang_getCString(declaration_spelling));
            clang_disposeString(declaration_spelling);

            if declaration_name.Empty() || declaration_name == name {
                EmitEnum(state, file_state, declaration, name);
                ret CXChildVisitResult::CXChildVisit_Continue;
            }
        }

        if transpile_state != 0i32 {
            ret CXChildVisitResult::CXChildVisit_Continue;
        }

        state->transpile_states[name] = TranspileState::Defined;
        file_state->declarations += String("type ") + name + " = " + TypeToString(underlying) + ";\n";
    } else if cursor.kind == CXCursorKind::CXCursor_MacroDefinition {
        TranslateMacro(state, file_state, cursor);
    } else if cursor.kind == CXCursorKind::CXCursor_FunctionDecl {
        let spelling: CXString = clang_getCursorSpelling(cursor);
        let name: String = String(clang_getCString(spelling));
        clang_disposeString(spelling);

        let transpile_state: TranspileState = state->transpile_states.Get(name, TranspileState::None);
        if transpile_state == TranspileState::Defined { ret CXChildVisitResult::CXChildVisit_Continue; }
        state->transpile_states[name] = TranspileState::Defined;

        let num_args: i32 = clang_Cursor_getNumArguments(cursor);
        let mut declaration: String = String("    func ") + name + "(";
        let mut i: i32 = 0i32;

        while i < num_args {
            let argument: CXCursor = clang_Cursor_getArgument(cursor, i as u32);
            let argument_spelling: CXString = clang_getCursorSpelling(argument);
            let mut argument_name: String = String(clang_getCString(argument_spelling));
            clang_disposeString(argument_spelling);

            if argument_name.Empty() {
                argument_name = String("_p") + String(i as i64);
            } else if StringToKeyword(argument_name) != TokenType::UNKNOWN {
                argument_name = String("_") + argument_name;
            }

            let _type: CXType = clang_getCursorType(argument);

            if _type.kind == CXTypeKind::CXType_ConstantArray {
                declaration += argument_name + "[" + String(clang_getArraySize(_type)) + "u64]: " + TypeToString(clang_getArrayElementType(_type));
            } else {
                declaration += argument_name + ": " + TypeToString(_type);
            }

            if i < num_args - 1i32 {
                declaration += ", ";
            } i += 1i32;
        }

        declaration += ")";
        let ret_type: CXType = clang_getCursorResultType(cursor);

        if ret_type.kind != CXTypeKind::CXType_Void {
            declaration += String(" -> ") + TypeToString(ret_type);
        }

        file_state->extern_functions += declaration + ";\n";
    } ret CXChildVisitResult::CXChildVisit_Continue;
}

func main(argc: i32, argv[]: *const i8) -> i32 {
    let executable: String = SplitPath(String(argv[0u64])).right.Replace("\"", "");

    if argc < 2i32 {
        WriteLine(String("Usage: ") + executable + " <header.h> [-o output_directory]");
        ret 1i32;
    }

    let mut args: Vector<*const i8>;
    args.PushBack("-x");
    args.PushBack("c");

    let input: String = argv[1u64];
    let mut output_directory: String;
    let mut i: i32 = 2i32;

    while i < argc {
        let arg: String = argv[i as u64];

        if arg == "-o" {
            i += 1i32;

            if i < argc {
                output_directory = argv[i as u64];
            } else {
                WriteLine(executable + ": \x1b[31mError:\x1b[0m Missing argument to '-o'.");
                ret 1i32;
            }
        } else {
            args.PushBack(argv[i as u64]);
        } i += 1i32;
    }

    if output_directory.Empty() {
        output_directory = JoinPath(String("include"), SplitPath(SplitPath(input).left).right);
    }

    EnsureDirectory(&output_directory);
    let index: CXIndex = clang_createIndex(0i32, 1i32);

    if index == null {
        WriteLine(executable + ": \x1b[31mError:\x1b[0m Failed to create clang index.");
        ret 1i32;
    }

    let translation_unit: CXTranslationUnit = clang_parseTranslationUnit(index, input.Data(), args.Data(), args.Size() as i32, null, 0u32, (CXTranslationUnit_Flags::CXTranslationUnit_DetailedPreprocessingRecord | CXTranslationUnit_Flags::CXTranslationUnit_SkipFunctionBodies) as u32);

    if translation_unit == null {
        WriteLine(executable + ": \x1b[31mError:\x1b[0m Failed to parse '" + input + "'.");
        clang_disposeIndex(index);
        ret 1i32;
    }

    let mut state: GlobalState;
    state.translation_unit = translation_unit;
    state.output_directory = output_directory;

    let root: CXCursor = clang_getTranslationUnitCursor(translation_unit);
    clang_visitChildren(root, VisitTopLevel, &mut state as CXClientData);
    let files: Vector<*mut FileState> = state.files.Values();
    let mut will_write: Map<String, bool>;
    let mut j: u64 = 0u64;

    while j < files.Size() {
        let file_state: *mut FileState = files[j];
        will_write[file_state->path] = !file_state->declarations.Empty() || !file_state->extern_functions.Empty();
        j += 1u64;
    }

    let mut changed: bool = true;

    while changed {
        changed = false;
        let mut i: u64 = 0u64;

        while i < files.Size() {
            let file_state: *mut FileState = files[i];

            if will_write[file_state->path] {
                i += 1u64;
                continue;
            }

            let include_paths: Vector<String> = file_state->includes.Keys();
            let mut j: u64 = 0u64;

            while j < include_paths.Size() {
                if will_write[include_paths[j]] {
                    (will_write[file_state->path], changed) = (true, true);
                    break;
                } j += 1u64;
            } i += 1u64;
        }
    }

    let mut k: u64 = 0u64;

    while k < files.Size() {
        let file_state: *mut FileState = files[k];

        if !will_write[file_state->path] {
            k += 1u64;
            continue;
        }

        let mut content: String;
        let include_paths: Vector<String> = file_state->includes.Keys();
        let (mut i: u64, mut first_include: bool) = (0u64, true);

        while i < include_paths.Size() {
            let include_path: String = include_paths[i];

            if will_write[include_path] {
                if first_include {
                    content += "include ";
                    first_include = false;
                } else {
                    content += ", ";
                }

                content += String("\"") + file_state->includes[include_path] + "\"";
            } i += 1u64;
        }

        if !first_include { content += " : *;\n\n"; }
        content += file_state->declarations;

        if !file_state->extern_functions.Empty() {
            let length: u64 = content.Length();

            if length >= 2u64 && content[length - 1u64] == '\n' && content[length - 2u64] != '\n' {
                content += "\n";
            }

            content += "extern \"C\" {\n";
            content += file_state->extern_functions;
            content += "}\n";
        }

        let output_path: String = JoinPath(output_directory, file_state->name + ".div");

        if _WriteFile(output_path, content) {
            WriteLine(executable + ": \x1b[32mInfo:\x1b[0m Generated '" + output_path + "'.");
        } k += 1u64;
    }

    clang_disposeTranslationUnit(translation_unit);
    clang_disposeIndex(index);
    ret 0i32;
}