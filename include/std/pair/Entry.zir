class Pair<L, R> {
    pub left: L,
    pub right: R;

    Pair(&mut this, left: L) {
        this.left = left;
    }

    Pair(&mut this, left: L, right: R) {
        (this.left, this.right) = (left, right);
    }

    Pair(&mut this, other: &Pair<L, R>) {
        (this.left, this.right) = (other.left, other.right);
    }

    ~Pair(&this) {}

    pub op=(&mut this, other: &Pair<L, R>) -> &Pair<L, R> {
        (this.left, this.right) = (other.left, other.right);
        ret this;
    }

    pub op==(&this, other: &Pair<L, R>) -> bool {
        ret this.left == other.left && this.right == other.right;
    }

    pub op!=(&this, other: &Pair<L, R>) -> bool {
        ret !this.op==(other);
    }
}