class GLFWvidmode {
    pub width: i32,
    pub height: i32,
    pub redBits: i32,
    pub greenBits: i32,
    pub blueBits: i32,
    pub refreshRate: i32
}

class GLFWgammaramp {
    pub red: *mut u16,
    pub green: *mut u16,
    pub blue: *mut u16,
    pub size: u32
}

class GLFWimage {
    pub width: i32,
    pub height: i32,
    pub pixels: *mut u8
}

class GLFWgamepadstate {
    pub buttons[15]: u8,
    pub axes[6]: f32
}

class GLFWallocator {
    pub allocate: GLFWallocatefun,
    pub reallocate: GLFWreallocatefun,
    pub deallocate: GLFWdeallocatefun,
    pub user: *mut void
}

extern "C" {
    func glfwInit() -> i32;
    func glfwTerminate();
    func glfwInitHint(hint: i32, value: i32);
    func glfwInitAllocator(allocator: *GLFWallocator);

    func glfwGetVersion(major: *mut i32, minor: *mut i32, rev: *mut i32);
    func glfwGetVersionString() -> *i8;
    func glfwGetError(description: *mut *i8) -> i32;
    func glfwSetErrorCallback(callback: GLFWerrorfun) -> GLFWerrorfun;

    func glfwGetPlatform() -> i32;
    func glfwPlatformSupported(platform: i32) -> i32;

    func glfwGetMonitors(count: *mut i32) -> *mut *GLFWcursor;
    func glfwGetPrimaryMonitor() -> *GLFWcursor;
    func glfwGetMonitorPos(monitor: *GLFWcursor, xpos: *mut i32, ypos: *mut i32);
    func glfwGetMonitorWorkarea(monitor: *GLFWcursor, xpos: *mut i32, ypos: *mut i32, width: *mut i32, height: *mut i32);
    func glfwGetMonitorPhysicalSize(monitor: *GLFWcursor, widthMM: *mut i32, heightMM: *mut i32);
    func glfwGetMonitorContentScale(monitor: *GLFWcursor, xscale: *mut f32, yscale: *mut f32);
    func glfwGetMonitorName(monitor: *GLFWcursor) -> *i8;
    func glfwSetMonitorUserPointer(monitor: *GLFWcursor, pointer: *mut void);
    func glfwGetMonitorUserPointer(monitor: *GLFWcursor) -> *mut void;
    func glfwSetMonitorCallback(callback: GLFWmonitorfun) -> GLFWmonitorfun;

    func glfwGetVideoModes(monitor: *GLFWcursor, count: *mut i32) -> *GLFWvidmode;
    func glfwGetVideoMode(monitor: *GLFWcursor) -> *GLFWvidmode;
    func glfwSetGamma(monitor: *GLFWcursor, gamma: f32);
    func glfwGetGammaRamp(monitor: *GLFWcursor) -> *GLFWgammaramp;
    func glfwSetGammaRamp(monitor: *GLFWcursor, ramp: *GLFWgammaramp);

    func glfwDefaultWindowHints();
    func glfwWindowHint(hint: i32, value: i32);
    func glfwWindowHintString(hint: i32, value: *i8);
