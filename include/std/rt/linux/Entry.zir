#[include "std/str", "std/vec", "std/std" : *]

extern "C" {
    func _bootstrap(argc: usize, argv[]: *i8) {
        let mut args: Vector<String>;

        for i in 0..argc {
            args.PushBack(argv[i].ToString());
        }

        Exit(main(args));
    }
}

asm {
    .globl _start

_start:
    xorq %rbp, %rbp
    popq %rdi
    movq %rsp, %rsi
    andq $-16, %rsp
    call _bootstrap
};
