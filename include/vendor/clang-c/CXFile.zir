#[include "vendor/clang-c/CXString.zir" : *]

type CXFile = *mut void;

class CXFileUniqueID {
    pub data[3]: u64,
}

extern "C" {
    fn clang_getFileName(SFile: CXFile) -> CXString;
    fn clang_getFileTime(SFile: CXFile) -> i64;
    fn clang_getFileUniqueID(file: CXFile, outID: *mut CXFileUniqueID) -> i32;
    fn clang_File_isEqual(file1: CXFile, file2: CXFile) -> i32;
    fn clang_File_tryGetRealPathName(file: CXFile) -> CXString;
}
