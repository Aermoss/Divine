#[include "std/str", "src/SemanticTypes.zir" : *]

enum SemanticSymbolKind: i32 {
    Variable, GlobalVariable, Constant, Function, Parameter, Generic, Class, Structure, Variant, Type
}

fn ToString(kind: SemanticSymbolKind) -> String {
    if kind == SemanticSymbolKind::Variable { return "Variable".ToString(); }
    else if kind == SemanticSymbolKind::GlobalVariable { return "GlobalVariable".ToString(); }
    else if kind == SemanticSymbolKind::Constant { return "Constant".ToString(); }
    else if kind == SemanticSymbolKind::Function { return "Function".ToString(); }
    else if kind == SemanticSymbolKind::Parameter { return "Parameter".ToString(); }
    else if kind == SemanticSymbolKind::Generic { return "Generic".ToString(); }
    else if kind == SemanticSymbolKind::Class { return "Class".ToString(); }
    else if kind == SemanticSymbolKind::Structure { return "Structure".ToString(); }
    else if kind == SemanticSymbolKind::Variant { return "Variant".ToString(); }
    else if kind == SemanticSymbolKind::Type { return "Type".ToString(); }
    else { return "Unknown".ToString(); }
}

class SemanticSymbol {
    pub name: String,
    pub kind: SemanticSymbolKind,
    pub value: SemanticValue,
    pub generic: *mut SemanticGeneric = null;

    SemanticSymbol(&mut this, name: &String, kind: SemanticSymbolKind, value: &SemanticValue) {
        (this.name, this.kind, this.value) = (name, kind, value);
    }

    SemanticSymbol(&mut this, name: &String, kind: SemanticSymbolKind, generic: *mut SemanticGeneric) {
        (this.name, this.kind, this.generic) = (name, kind, generic);
    }
}
