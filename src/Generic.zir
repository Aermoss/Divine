#[include "std/str", "std/vec", "std/map", "std/pair",
    "src/Scope.zir", "src/Symbol.zir", "src/HIR.zir" : *]

class Generic {
    cache: Map<String, Pair<*Symbol, *mut Scope>>,

    pub declaration: *ASTDeclaration,
    pub scope: *mut Scope,
    pub _class: *HIRType,

    pub name: String,
    pub type_names: Vector<String>,

    pub current: String,
    pub types: Vector<*HIRType>;

    Generic(&mut this, declaration: *ASTDeclaration) {
        (this.declaration, this.scope, this._class) = (declaration, analyzer->scope_manager.current, analyzer->current_class);

        if declaration->kind == ASTDeclarationKind::Class {
            let _class = declaration as *ASTClassDeclaration;
            (this.name, this.type_names) = (_class->name, _class->types);
        } else if declaration->kind == ASTDeclarationKind::Structure {
            let structure = declaration as *ASTStructureDeclaration;
            (this.name, this.type_names) = (structure->name, structure->types);
        } else {
            let function = declaration as *ASTFunctionDeclaration;
            (this.name, this.type_names) = (function->name, function->types);
        }
    }

    ~Generic(&this) {
        for pair in this.cache {
            delete pair.right.left;
        }
    }

    pub fn Set(&mut this, declaration: *HIRDeclaration) {
        if this.current.Empty() {
            Logger::Log("Generic", "Not in a generic compilation!", LogSeverity::Fatal);
        }

        let mut symbol: *Symbol = null;

        if declaration->kind != HIRDeclarationKind::Function {
            symbol = new Symbol(declaration->_type);
        } else {
            symbol = new Symbol(declaration);
        }

        this.cache[this.current] = Pair<*Symbol, *mut Scope>(symbol, analyzer->scope_manager.current);
        this.current = "";
    }

    pub fn Get(&mut this, types: &Vector<*HIRType>) -> Pair<*Symbol, *mut Scope> {
        if !this.current.Empty() {
            Logger::Log("Generic", "Nested generics are not supported!", LogSeverity::Fatal);
        }

        if types.Size() != this.type_names.Size() {
            Logger::Log("Generic", "Generic type parameter count mismatch.", LogSeverity::Error);
            return Pair<*Symbol, *mut Scope>(null, null);
        }

        let (prev_unsafe, prev_class) = (analyzer->_unsafe, analyzer->current_class);
        let (prev_scope, prev_generic) = (analyzer->scope_manager.current, analyzer->current_generic);
        let prev_function = analyzer->builder.GetCurrentFunction();
        let prev_block = analyzer->builder.GetCurrentBlock();

        analyzer->builder.SetCurrentBlock(null);
        analyzer->builder.SetCurrentFunction(null);
        (analyzer->scope_manager.current, analyzer->current_generic) = (this.scope, this);
        (analyzer->_unsafe, analyzer->current_class) = (false, this._class);
        let (mut name, mut first) = (this.name + '<', true);

        for _type in types {
            if !first {
                name += ", ";
            } else {
                first = false;
            }

            name += _type->ToString();
        } name += '>';

        if this.cache.Has(name) {
            analyzer->builder.SetCurrentBlock(prev_block);
            analyzer->builder.SetCurrentFunction(prev_function);
            (analyzer->scope_manager.current, analyzer->current_generic) = (prev_scope, prev_generic);
            (analyzer->_unsafe, analyzer->current_class) = (prev_unsafe, prev_class);
            return this.cache[name];
        }

        (this.current, this.types) = (name, types);
        analyzer->scope_manager.PushScope(String("generic"), false);

        for i in 0..this.type_names.Size() {
            analyzer->scope_manager.current->Set(this.type_names[i], this.types[i], this.declaration);
        }

        if this.declaration->kind == ASTDeclarationKind::Class {
            analyzer->AnalyzeClassDeclaration(this.declaration as *ASTClassDeclaration, this);
        } else if this.declaration->kind == ASTDeclarationKind::Structure {
            analyzer->AnalyzeStructureDeclaration(this.declaration as *ASTStructureDeclaration, this);
        } else {
            analyzer->AnalyzeFunctionDeclaration(this.declaration as *ASTFunctionDeclaration, this);
        }

        this.types.Clear();
        analyzer->scope_manager.PopScope();
        analyzer->builder.SetCurrentBlock(prev_block);
        analyzer->builder.SetCurrentFunction(prev_function);
        (analyzer->scope_manager.current, analyzer->current_generic) = (prev_scope, prev_generic);
        (analyzer->_unsafe, analyzer->current_class) = (prev_unsafe, prev_class);
        return this.cache[name];
    }
}

#[include "src/SemanticAnalyzer.zir" : *]
