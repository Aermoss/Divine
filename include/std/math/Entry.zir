const M_E: f64 = 2.71828182845904523536;
const M_LOG2E: f64 = 1.44269504088896340736;
const M_LOG10E: f64 = 0.434294481903251827651;
const M_LN2: f64 = 0.693147180559945309417;
const M_LN10: f64 = 2.30258509299404568402;
const M_PI: f64 = 3.14159265358979323846;
const M_PI_2: f64 = 1.57079632679489661923;
const M_PI_4: f64 = 0.785398163397448309616;
const M_1_PI: f64 = 0.318309886183790671538;
const M_2_PI: f64 = 0.636619772367581343076;
const M_2_SQRTPI: f64 = 1.12837916709551257390;
const M_SQRT2: f64 = 1.41421356237309504880;
const M_SQRT1_2: f64 = 0.707106781186547524401;

extern "C" {
    fn acos(arg: f64) -> f64;
    fn acosf(arg: f32) -> f32;

    fn acosh(arg: f64) -> f64;
    fn acoshf(arg: f32) -> f32;

    fn asin(arg: f64) -> f64;
    fn asinf(arg: f32) -> f32;

    fn asinh(arg: f64) -> f64;
    fn asinhf(arg: f32) -> f32;

    fn atan(arg: f64) -> f64;
    fn atanf(arg: f32) -> f32;

    fn atan2(arg1: f64, arg2: f64) -> f64;
    fn atan2f(arg1: f32, arg2: f32) -> f32;

    fn cbrt(arg: f64) -> f64;
    fn cbrtf(arg: f32) -> f32;

    fn ceil(arg: f64) -> f64;
    fn ceilf(arg: f32) -> f32;

    fn copysign(x: f64, y: f64) -> f64;
    fn copysignf(x: f32, y: f32) -> f32;

    fn cos(arg: f64) -> f64;
    fn cosf(arg: f32) -> f32;

    fn cosh(arg: f64) -> f64;
    fn coshf(arg: f32) -> f32;

    fn erf(arg: f64) -> f64;
    fn erff(arg: f32) -> f32;

    fn erfc(arg: f64) -> f64;
    fn erfcf(arg: f32) -> f32;

    fn exp(arg: f64) -> f64;
    fn expf(arg: f32) -> f32;

    fn exp2(arg: f64) -> f64;
    fn exp2f(arg: f32) -> f32;

    fn expm1(arg: f64) -> f64;
    fn expm1f(arg: f32) -> f32;

    fn fabs(arg: f64) -> f64;
    fn fabsf(arg: f32) -> f32;

    fn fdim(x: f64, y: f64) -> f64;
    fn fdimf(x: f32, y: f32) -> f32;

    fn floor(arg: f64) -> f64;
    fn floorf(arg: f32) -> f32;

    fn fma(x: f64, y: f64, z: f64) -> f64;
    fn fmaf(x: f32, y: f32, z: f32) -> f32;

    fn fmax(x: f64, y: f64) -> f64;
    fn fmaxf(x: f32, y: f32) -> f32;

    fn fmin(x: f64, y: f64) -> f64;
    fn fminf(x: f32, y: f32) -> f32;

    fn fmod(x: f64, y: f64) -> f64;
    fn fmodf(x: f32, y: f32) -> f32;

    fn frexp(arg: f64, exp: *mut i32) -> f64;
    fn frexpf(arg: f32, exp: *mut i32) -> f32;

    fn hypot(x: f64, y: f64) -> f64;
    fn hypotf(x: f32, y: f32) -> f32;

    fn ilogb(arg: f64) -> i32;
    fn ilogbf(arg: f32) -> i32;

    fn ldexp(arg: f64, exp: i32) -> f64;
    fn ldexpf(arg: f32, exp: i32) -> f32;

    fn lgamma(arg: f64) -> f64;
    fn lgammaf(arg: f32) -> f32;

    fn log(arg: f64) -> f64;
    fn logf(arg: f32) -> f32;

    fn log10(arg: f64) -> f64;
    fn log10f(arg: f32) -> f32;

    fn log2(arg: f64) -> f64;
    fn log2f(arg: f32) -> f32;

    fn log1p(arg: f64) -> f64;
    fn log1pf(arg: f32) -> f32;

    fn logb(arg: f64) -> f64;
    fn logbf(arg: f32) -> f32;

    fn modf(arg: f64, pint: *mut f64) -> f64;
    fn modff(arg: f32, pint: *mut f32) -> f32;

    fn nan(arg: *mut i8) -> f64;
    fn nanf(arg: *mut i8) -> f32;

    fn nearbyint(arg: f64) -> f64;
    fn nearbyintf(arg: f32) -> f32;

    fn nextafter(x: f64, y: f64) -> f64;
    fn nextafterf(x: f32, y: f32) -> f32;

    fn pow(base: f64, exp: f64) -> f64;
    fn powf(base: f32, exp: f32) -> f32;

    fn remainder(x: f64, y: f64) -> f64;
    fn remainderf(x: f32, y: f32) -> f32;

    fn remquo(x: f64, y: f64, quo: *mut i32) -> f64;
    fn remquof(x: f32, y: f32, quo: *mut i32) -> f32;

    fn rint(arg: f64) -> f64;
    fn rintf(arg: f32) -> f32;

    fn round(arg: f64) -> f64;
    fn roundf(arg: f32) -> f32;

    fn scalbn(arg: f64, exp: i32) -> f64;
    fn scalbnf(arg: f32, exp: i32) -> f32;

    fn sin(arg: f64) -> f64;
    fn sinf(arg: f32) -> f32;

    fn sinh(arg: f64) -> f64;
    fn sinhf(arg: f32) -> f32;

    fn sqrt(arg: f64) -> f64;
    fn sqrtf(arg: f32) -> f32;

    fn tan(arg: f64) -> f64;
    fn tanf(arg: f32) -> f32;

    fn tanh(arg: f64) -> f64;
    fn tanhf(arg: f32) -> f32;

    fn tgamma(arg: f64) -> f64;
    fn tgammaf(arg: f32) -> f32;

    fn trunc(arg: f64) -> f64;
    fn truncf(arg: f32) -> f32;
}