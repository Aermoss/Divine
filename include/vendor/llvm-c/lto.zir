const LTO_API_VERSION: i32 = 30;
type lto_bool_t = u8;

enum lto_symbol_attributes: i32 {
    LTO_SYMBOL_ALIGNMENT_MASK = 31,
    LTO_SYMBOL_PERMISSIONS_MASK = 224,
    LTO_SYMBOL_PERMISSIONS_CODE = 160,
    LTO_SYMBOL_PERMISSIONS_DATA = 192,
    LTO_SYMBOL_PERMISSIONS_RODATA = 128,
    LTO_SYMBOL_DEFINITION_MASK = 1792,
    LTO_SYMBOL_DEFINITION_REGULAR = 256,
    LTO_SYMBOL_DEFINITION_TENTATIVE = 512,
    LTO_SYMBOL_DEFINITION_WEAK = 768,
    LTO_SYMBOL_DEFINITION_UNDEFINED = 1024,
    LTO_SYMBOL_DEFINITION_WEAKUNDEF = 1280,
    LTO_SYMBOL_SCOPE_MASK = 14336,
    LTO_SYMBOL_SCOPE_INTERNAL = 2048,
    LTO_SYMBOL_SCOPE_HIDDEN = 4096,
    LTO_SYMBOL_SCOPE_PROTECTED = 8192,
    LTO_SYMBOL_SCOPE_DEFAULT = 6144,
    LTO_SYMBOL_SCOPE_DEFAULT_CAN_BE_HIDDEN = 10240,
    LTO_SYMBOL_COMDAT = 16384,
    LTO_SYMBOL_ALIAS = 32768
}

enum lto_debug_model: i32 {
    LTO_DEBUG_MODEL_NONE,
    LTO_DEBUG_MODEL_DWARF
}

enum lto_codegen_model: i32 {
    LTO_CODEGEN_PIC_MODEL_STATIC,
    LTO_CODEGEN_PIC_MODEL_DYNAMIC,
    LTO_CODEGEN_PIC_MODEL_DYNAMIC_NO_PIC,
    LTO_CODEGEN_PIC_MODEL_DEFAULT
}

struct LLVMOpaqueLTOModule {}

type lto_module_t = *mut LLVMOpaqueLTOModule;

struct LLVMOpaqueLTOCodeGenerator {}

type lto_code_gen_t = *mut LLVMOpaqueLTOCodeGenerator;

struct LLVMOpaqueThinLTOCodeGenerator {}

type thinlto_code_gen_t = *mut LLVMOpaqueThinLTOCodeGenerator;

enum lto_codegen_diagnostic_severity_t: i32 {
    LTO_DS_ERROR,
    LTO_DS_WARNING,
    LTO_DS_REMARK = 3,
    LTO_DS_NOTE = 2
}

type lto_diagnostic_handler_t = fn(lto_codegen_diagnostic_severity_t, *i8, *mut void);

struct LLVMOpaqueLTOInput {}

type lto_input_t = *mut LLVMOpaqueLTOInput;

struct LTOObjectBuffer {
    pub Buffer: *i8,
    pub Size: usize
}

extern "C" {
    fn lto_get_version() -> *i8;
    fn lto_get_error_message() -> *i8;
    fn lto_module_is_object_file(path: *i8) -> lto_bool_t;
    fn lto_module_is_object_file_for_target(path: *i8, target_triple_prefix: *i8) -> lto_bool_t;
    fn lto_module_has_objc_category(mem: *void, length: usize) -> lto_bool_t;
    fn lto_module_is_object_file_in_memory(mem: *void, length: usize) -> lto_bool_t;
    fn lto_module_is_object_file_in_memory_for_target(mem: *void, length: usize, target_triple_prefix: *i8) -> lto_bool_t;
    fn lto_module_create(path: *i8) -> lto_module_t;
    fn lto_module_create_from_memory(mem: *void, length: usize) -> lto_module_t;
    fn lto_module_create_from_memory_with_path(mem: *void, length: usize, path: *i8) -> lto_module_t;
    fn lto_module_create_in_local_context(mem: *void, length: usize, path: *i8) -> lto_module_t;
    fn lto_module_create_in_codegen_context(mem: *void, length: usize, path: *i8, cg: lto_code_gen_t) -> lto_module_t;
    fn lto_module_create_from_fd(fd: i32, path: *i8, file_size: usize) -> lto_module_t;
    fn lto_module_create_from_fd_at_offset(fd: i32, path: *i8, file_size: usize, map_size: usize, offset: isize) -> lto_module_t;
    fn lto_module_dispose(mod: lto_module_t);
    fn lto_module_get_target_triple(mod: lto_module_t) -> *i8;
    fn lto_module_set_target_triple(mod: lto_module_t, triple: *i8);
    fn lto_module_get_num_symbols(mod: lto_module_t) -> u32;
    fn lto_module_get_symbol_name(mod: lto_module_t, index: u32) -> *i8;
    fn lto_module_get_symbol_attribute(mod: lto_module_t, index: u32) -> lto_symbol_attributes;
    fn lto_module_get_num_asm_undef_symbols(mod: lto_module_t) -> u32;
    fn lto_module_get_asm_undef_symbol_name(mod: lto_module_t, index: u32) -> *i8;
    fn lto_module_get_linkeropts(mod: lto_module_t) -> *i8;
    fn lto_module_get_macho_cputype(mod: lto_module_t, out_cputype: *mut u32, out_cpusubtype: *mut u32) -> lto_bool_t;
    fn lto_module_has_ctor_dtor(mod: lto_module_t) -> lto_bool_t;
    fn lto_codegen_set_diagnostic_handler(_p0: lto_code_gen_t, _p1: lto_diagnostic_handler_t, _p2: *mut void);
    fn lto_codegen_create() -> lto_code_gen_t;
    fn lto_codegen_create_in_local_context() -> lto_code_gen_t;
    fn lto_codegen_dispose(_p0: lto_code_gen_t);
    fn lto_codegen_add_module(cg: lto_code_gen_t, mod: lto_module_t) -> lto_bool_t;
    fn lto_codegen_set_module(cg: lto_code_gen_t, mod: lto_module_t);
    fn lto_codegen_set_debug_model(cg: lto_code_gen_t, _p1: lto_debug_model) -> lto_bool_t;
    fn lto_codegen_set_pic_model(cg: lto_code_gen_t, _p1: lto_codegen_model) -> lto_bool_t;
    fn lto_codegen_set_cpu(cg: lto_code_gen_t, cpu: *i8);
    fn lto_codegen_set_assembler_path(cg: lto_code_gen_t, path: *i8);
    fn lto_codegen_set_assembler_args(cg: lto_code_gen_t, args: *mut *i8, nargs: i32);
    fn lto_codegen_add_must_preserve_symbol(cg: lto_code_gen_t, symbol: *i8);
    fn lto_codegen_write_merged_modules(cg: lto_code_gen_t, path: *i8) -> lto_bool_t;
    fn lto_codegen_compile(cg: lto_code_gen_t, length: *mut usize) -> *void;
    fn lto_codegen_compile_to_file(cg: lto_code_gen_t, name: *mut *i8) -> lto_bool_t;
    fn lto_codegen_optimize(cg: lto_code_gen_t) -> lto_bool_t;
    fn lto_codegen_compile_optimized(cg: lto_code_gen_t, length: *mut usize) -> *void;
    fn lto_api_version() -> u32;
    fn lto_set_debug_options(options: **i8, number: i32);
    fn lto_codegen_debug_options(cg: lto_code_gen_t, _p1: *i8);
    fn lto_codegen_debug_options_array(cg: lto_code_gen_t, _p1: **i8, number: i32);
    fn lto_initialize_disassembler();
    fn lto_codegen_set_should_internalize(cg: lto_code_gen_t, ShouldInternalize: lto_bool_t);
    fn lto_codegen_set_should_embed_uselists(cg: lto_code_gen_t, ShouldEmbedUselists: lto_bool_t);
    fn lto_input_create(buffer: *void, buffer_size: usize, path: *i8) -> lto_input_t;
    fn lto_input_dispose(input: lto_input_t);
    fn lto_input_get_num_dependent_libraries(input: lto_input_t) -> u32;
    fn lto_input_get_dependent_library(input: lto_input_t, index: usize, size: *mut usize) -> *i8;
    fn lto_runtime_lib_symbols_list(size: *mut usize) -> **i8;
    fn thinlto_create_codegen() -> thinlto_code_gen_t;
    fn thinlto_codegen_dispose(cg: thinlto_code_gen_t);
    fn thinlto_codegen_add_module(cg: thinlto_code_gen_t, identifier: *i8, data: *i8, length: i32);
    fn thinlto_codegen_process(cg: thinlto_code_gen_t);
    fn thinlto_module_get_num_objects(cg: thinlto_code_gen_t) -> u32;
    fn thinlto_module_get_object(cg: thinlto_code_gen_t, index: u32) -> LTOObjectBuffer;
    fn thinlto_module_get_num_object_files(cg: thinlto_code_gen_t) -> u32;
    fn thinlto_module_get_object_file(cg: thinlto_code_gen_t, index: u32) -> *i8;
    fn thinlto_codegen_set_pic_model(cg: thinlto_code_gen_t, _p1: lto_codegen_model) -> lto_bool_t;
    fn thinlto_codegen_set_savetemps_dir(cg: thinlto_code_gen_t, save_temps_dir: *i8);
    fn thinlto_set_generated_objects_dir(cg: thinlto_code_gen_t, save_temps_dir: *i8);
    fn thinlto_codegen_set_cpu(cg: thinlto_code_gen_t, cpu: *i8);
    fn thinlto_codegen_disable_codegen(cg: thinlto_code_gen_t, disable: lto_bool_t);
    fn thinlto_codegen_set_codegen_only(cg: thinlto_code_gen_t, codegen_only: lto_bool_t);
    fn thinlto_debug_options(options: **i8, number: i32);
    fn lto_module_is_thinlto(mod: lto_module_t) -> lto_bool_t;
    fn thinlto_codegen_add_must_preserve_symbol(cg: thinlto_code_gen_t, name: *i8, length: i32);
    fn thinlto_codegen_add_cross_referenced_symbol(cg: thinlto_code_gen_t, name: *i8, length: i32);
    fn thinlto_codegen_set_cache_dir(cg: thinlto_code_gen_t, cache_dir: *i8);
    fn thinlto_codegen_set_cache_pruning_interval(cg: thinlto_code_gen_t, interval: i32);
    fn thinlto_codegen_set_final_cache_size_relative_to_available_space(cg: thinlto_code_gen_t, percentage: u32);
    fn thinlto_codegen_set_cache_entry_expiration(cg: thinlto_code_gen_t, expiration: u32);
    fn thinlto_codegen_set_cache_size_bytes(cg: thinlto_code_gen_t, max_size_bytes: u32);
    fn thinlto_codegen_set_cache_size_megabytes(cg: thinlto_code_gen_t, max_size_megabytes: u32);
    fn thinlto_codegen_set_cache_size_files(cg: thinlto_code_gen_t, max_size_files: u32);
}
