}

fn AtomicFetchSub8(target: *mut u8, value: u8) -> u8 {
    let result: u8;

    volatile asm : rdi(target), al(-(value as i8) as u8) -> {
        lock xaddb %al, (%rdi)
    } -> al(result) : memory;

    return result;
}

fn AtomicFetchSub16(target: *mut i16, value: i16) -> i16 {
    let result: i16;

    volatile asm : rdi(target), ax(-value) -> {
        lock xaddw %ax, (%rdi)
    } -> ax(result) : memory;

    return result;
}

fn AtomicFetchSub32(target: *mut u32, value: u32) -> u32 {
    let result: u32;

    volatile asm : rdi(target), eax(-(value as i32) as u32) -> {
        lock xaddl %eax, (%rdi)
    } -> eax(result) : memory;

    return result;
}

fn AtomicFetchSub64(target: *mut u64, value: u64) -> u64 {
    let result: u64;

    volatile asm : rdi(target), rax(-(value as i64) as u64) -> {
        lock xaddq %rax, (%rdi)
    } -> rax(result) : memory;

    return result;
}

fn AtomicFetchAnd8(target: *mut u8, value: u8) -> u8 {
    let mut old = AtomicLoad8(target);

    loop {
        if AtomicCompareExchangeBool8(target, old, old & value) {
            break;
        }

        old = AtomicLoad8(target);
        AtomicPause();
    } return old;
}

fn AtomicFetchAnd16(target: *mut i16, value: i16) -> i16 {
    let mut old = AtomicLoad16(target);

    loop {
        if AtomicCompareExchangeBool16(target, old, old & value) {
