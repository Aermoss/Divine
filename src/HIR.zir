class HIRConstructorExpression : HIRExpression {
    pub _type: *SemanticType,
    pub call: *HIRCallExpression = null;

    HIRConstructorExpression(&mut this, _type: *SemanticType) : HIRExpression(HIRExpressionKind::Construct, _type, HIRExpressionCategory::Place, true) {
        this._type = _type;
    }
