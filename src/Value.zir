#[include "std/str", "vendor/llvm", "src/Types.zir" : *]

class QualifiedValue {
    priv value: LLVMValueRef = null, priv _type: *const QualifiedType = null,
    pub instance: LLVMValueRef = null, pub instance_type: *const QualifiedType = null,
    pub binding: bool = false, pub return: bool = false;

    QualifiedValue(&mut this, value: LLVMValueRef, _type: *const QualifiedType) {
        (this.value, this._type) = (value, _type);
    }

    QualifiedValue(&mut this, value: LLVMValueRef, _type: *const QualifiedType, instance: &QualifiedValue) {
        (this.value, this._type, this.instance, this.instance_type) = (value, _type, instance.value, instance._type);
    }

    QualifiedValue(&mut this, value: LLVMValueRef, _type: *const QualifiedType, return: bool, binding: bool) {
        (this.value, this._type, this.return, this.binding) = (value, _type, return, binding);
    }

    QualifiedValue(&mut this, value: LLVMValueRef, _type: *const QualifiedType, return: bool) {
        (this.value, this._type, this.return) = (value, _type, return);
    }

    pub Null(&this) -> bool {
        ret this.value == null;
    }

    pub Value(&this) -> LLVMValueRef {
        if this.value != null {
            ret this.value;
        } else {
            Logger::Log("QualifiedValue", "Null value!", LogSeverity::Error);
            ret null;
        }
    }

    pub Type(&this) -> &QualifiedType {
        if this._type != null {
            ret this._type;
        } else {
            Logger::Log("QualifiedValue", "Null type!", LogSeverity::Error);
            ret null;
        }
    }

    pub ToString(&this) -> String {
        if this.value != null {
            let mut result: String;
            let string = LLVMPrintValueToString(this.value);
            result += string;
            LLVMDisposeMessage(string);
            ret result;
        } else {
            Logger::Log("QualifiedValue", "Null value!", LogSeverity::Error);
            ret String("");
        }
    }
}
