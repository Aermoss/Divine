include "divggml" : *;

const LLAMA_DEFAULT_SEED: u32 = 0xFFFFFFFFu32;

const LLAMA_TOKEN_NULL: i32 = -1i32;

const LLAMA_FILE_MAGIC_GGLA: u32 = 0x67676c61u32;
const LLAMA_FILE_MAGIC_GGSN: u32 = 0x6767736eu32;
const LLAMA_FILE_MAGIC_GGSQ: u32 = 0x67677371u32;

const LLAMA_SESSION_MAGIC: u32 = LLAMA_FILE_MAGIC_GGSN;
const LLAMA_SESSION_VERSION: i32 = 9i32;

const LLAMA_STATE_SEQ_MAGIC: u32 = LLAMA_FILE_MAGIC_GGSQ;
const LLAMA_STATE_SEQ_VERSION: i32 = 2i32;

class llama_vocab {};
class llama_model {};
class llama_context {};
class _llama_sampler {};
class llama_memory_i {};

type llama_memory_t = *mut llama_memory_i;

type llama_pos = i32;
type llama_token = i32;
type llama_seq_id = i32;

enum _llama_vocab_type : i32 {
    LLAMA_VOCAB_TYPE_NONE = 0i32,
    LLAMA_VOCAB_TYPE_SPM = 1i32,
    LLAMA_VOCAB_TYPE_BPE = 2i32,
    LLAMA_VOCAB_TYPE_WPM = 3i32,
    LLAMA_VOCAB_TYPE_UGM = 4i32,
    LLAMA_VOCAB_TYPE_RWKV = 5i32,
    LLAMA_VOCAB_TYPE_PLAMO2 = 6i32
};

enum llama_rope_type : i32 {
    LLAMA_ROPE_TYPE_NONE = -1i32,
    LLAMA_ROPE_TYPE_NORM = 0i32,
    LLAMA_ROPE_TYPE_NEOX = GGML_ROPE_TYPE_NEOX,
    LLAMA_ROPE_TYPE_MROPE = GGML_ROPE_TYPE_MROPE,
    LLAMA_ROPE_TYPE_IMROPE = GGML_ROPE_TYPE_IMROPE,
    LLAMA_ROPE_TYPE_VISION = GGML_ROPE_TYPE_VISION
};

enum llama_token_type : i32 {
    LLAMA_TOKEN_TYPE_UNDEFINED = 0i32,
    LLAMA_TOKEN_TYPE_NORMAL = 1i32,
    LLAMA_TOKEN_TYPE_UNKNOWN = 2i32,
    LLAMA_TOKEN_TYPE_CONTROL = 3i32,
    LLAMA_TOKEN_TYPE_USER_DEFINED = 4i32,
    LLAMA_TOKEN_TYPE_UNUSED = 5i32,
    LLAMA_TOKEN_TYPE_BYTE = 6i32
};

enum llama_token_attr : i32 {
    LLAMA_TOKEN_ATTR_UNDEFINED = 0i32,
    LLAMA_TOKEN_ATTR_UNKNOWN = 1i32 << 0i32,
    LLAMA_TOKEN_ATTR_UNUSED = 1i32 << 1i32,
    LLAMA_TOKEN_ATTR_NORMAL = 1i32 << 2i32,
    LLAMA_TOKEN_ATTR_CONTROL = 1i32 << 3i32,
    LLAMA_TOKEN_ATTR_USER_DEFINED = 1i32 << 4i32,
    LLAMA_TOKEN_ATTR_BYTE = 1i32 << 5i32,
    LLAMA_TOKEN_ATTR_NORMALIZED = 1i32 << 6i32,
    LLAMA_TOKEN_ATTR_LSTRIP = 1i32 << 7i32,
    LLAMA_TOKEN_ATTR_RSTRIP = 1i32 << 8i32,
    LLAMA_TOKEN_ATTR_SINGLE_WORD = 1i32 << 9i32
};

enum llama_ftype : i32 {
    LLAMA_FTYPE_ALL_F32 = 0i32,
    LLAMA_FTYPE_MOSTLY_F16 = 1i32,
    LLAMA_FTYPE_MOSTLY_Q4_0 = 2i32,
    LLAMA_FTYPE_MOSTLY_Q4_1 = 3i32,
    LLAMA_FTYPE_MOSTLY_Q8_0 = 7i32,
    LLAMA_FTYPE_MOSTLY_Q5_0 = 8i32,
    LLAMA_FTYPE_MOSTLY_Q5_1 = 9i32,
    LLAMA_FTYPE_MOSTLY_Q2_K = 10i32,
    LLAMA_FTYPE_MOSTLY_Q3_K_S = 11i32,
    LLAMA_FTYPE_MOSTLY_Q3_K_M = 12i32,
    LLAMA_FTYPE_MOSTLY_Q3_K_L = 13i32,
    LLAMA_FTYPE_MOSTLY_Q4_K_S = 14i32,
    LLAMA_FTYPE_MOSTLY_Q4_K_M = 15i32,
    LLAMA_FTYPE_MOSTLY_Q5_K_S = 16i32,
    LLAMA_FTYPE_MOSTLY_Q5_K_M = 17i32,
    LLAMA_FTYPE_MOSTLY_Q6_K = 18i32,
    LLAMA_FTYPE_MOSTLY_IQ2_XXS = 19i32,
    LLAMA_FTYPE_MOSTLY_IQ2_XS = 20i32,
    LLAMA_FTYPE_MOSTLY_Q2_K_S = 21i32,
    LLAMA_FTYPE_MOSTLY_IQ3_XS = 22i32,
    LLAMA_FTYPE_MOSTLY_IQ3_XXS = 23i32,
    LLAMA_FTYPE_MOSTLY_IQ1_S = 24i32,
    LLAMA_FTYPE_MOSTLY_IQ4_NL = 25i32,
    LLAMA_FTYPE_MOSTLY_IQ3_S = 26i32,
    LLAMA_FTYPE_MOSTLY_IQ3_M = 27i32,
    LLAMA_FTYPE_MOSTLY_IQ2_S = 28i32,
    LLAMA_FTYPE_MOSTLY_IQ2_M = 29i32,
    LLAMA_FTYPE_MOSTLY_IQ4_XS = 30i32,
    LLAMA_FTYPE_MOSTLY_IQ1_M = 31i32,
    LLAMA_FTYPE_MOSTLY_BF16 = 32i32,
    LLAMA_FTYPE_MOSTLY_TQ1_0 = 36i32,
    LLAMA_FTYPE_MOSTLY_TQ2_0 = 37i32,
    LLAMA_FTYPE_MOSTLY_MXFP4_MOE = 38i32,
    LLAMA_FTYPE_GUESSED = 1024i32
};

enum llama_rope_scaling_type : i32 {
    LLAMA_ROPE_SCALING_TYPE_UNSPECIFIED = -1i32,
    LLAMA_ROPE_SCALING_TYPE_NONE = 0i32,
    LLAMA_ROPE_SCALING_TYPE_LINEAR = 1i32,
    LLAMA_ROPE_SCALING_TYPE_YARN = 2i32,
    LLAMA_ROPE_SCALING_TYPE_LONGROPE = 3i32,
    LLAMA_ROPE_SCALING_TYPE_MAX_VALUE = LLAMA_ROPE_SCALING_TYPE_LONGROPE
};

enum _llama_pooling_type : i32 {
    LLAMA_POOLING_TYPE_UNSPECIFIED = -1i32,
    LLAMA_POOLING_TYPE_NONE = 0i32,
    LLAMA_POOLING_TYPE_MEAN = 1i32,
    LLAMA_POOLING_TYPE_CLS = 2i32,
    LLAMA_POOLING_TYPE_LAST = 3i32,
    LLAMA_POOLING_TYPE_RANK = 4i32
};

enum llama_attention_type : i32 {
    LLAMA_ATTENTION_TYPE_UNSPECIFIED = -1i32,
    LLAMA_ATTENTION_TYPE_CAUSAL = 0i32,
    LLAMA_ATTENTION_TYPE_NON_CAUSAL = 1i32
};

enum llama_flash_attn_type : i32 {
    LLAMA_FLASH_ATTN_TYPE_AUTO = -1i32,
    LLAMA_FLASH_ATTN_TYPE_DISABLED = 0i32,
    LLAMA_FLASH_ATTN_TYPE_ENABLED = 1i32
};

extern "C" {
    func llama_flash_attn_type_name(flash_attn_type: llama_flash_attn_type) -> *const i8;
}

enum llama_split_mode : i32 {
    LLAMA_SPLIT_MODE_NONE = 0i32,
    LLAMA_SPLIT_MODE_LAYER = 1i32,
    LLAMA_SPLIT_MODE_ROW = 2i32
};

class llama_token_data {
    pub id: llama_token,
    pub logit: f32,
    pub p: f32
};

class llama_token_data_array {
    pub data: *mut llama_token_data,
    pub size: u32,
    pub selected: i64,
    pub sorted: bool
};

type llama_progress_callback = func(progress: f32, user_data: *mut void) -> bool;

class llama_batch {
    pub n_tokens: i32,
    pub token: *mut llama_token,
    pub embd: *mut f32,
    pub pos: *mut llama_pos,
    pub n_seq_id: *mut i32,
    pub seq_id: *mut *mut llama_seq_id,
    pub logits: *mut i8
};

enum llama_model_kv_override_type : i32 {
    LLAMA_KV_OVERRIDE_TYPE_INT = 0i32,
    LLAMA_KV_OVERRIDE_TYPE_FLOAT = 1i32,
    LLAMA_KV_OVERRIDE_TYPE_BOOL = 2i32,
    LLAMA_KV_OVERRIDE_TYPE_STR = 3i32
};

enum llama_model_meta_key : i32 {
    LLAMA_MODEL_META_KEY_SAMPLING_SEQUENCE = 0i32,
    LLAMA_MODEL_META_KEY_SAMPLING_TOP_K = 1i32,
    LLAMA_MODEL_META_KEY_SAMPLING_TOP_P = 2i32,
    LLAMA_MODEL_META_KEY_SAMPLING_MIN_P = 3i32,
    LLAMA_MODEL_META_KEY_SAMPLING_XTC_PROBABILITY = 4i32,
    LLAMA_MODEL_META_KEY_SAMPLING_XTC_THRESHOLD = 5i32,
    LLAMA_MODEL_META_KEY_SAMPLING_TEMP = 6i32,
    LLAMA_MODEL_META_KEY_SAMPLING_PENALTY_LAST_N = 7i32,
    LLAMA_MODEL_META_KEY_SAMPLING_PENALTY_REPEAT = 8i32,
    LLAMA_MODEL_META_KEY_SAMPLING_MIROSTAT = 9i32,
    LLAMA_MODEL_META_KEY_SAMPLING_MIROSTAT_TAU = 10i32,
    LLAMA_MODEL_META_KEY_SAMPLING_MIROSTAT_ETA = 11i32
};

class llama_model_kv_override {
    pub tag: llama_model_kv_override_type,
    pub key[128u64]: i8,
    pub val[128u64]: i8
};

class llama_model_tensor_buft_override {
    pub pattern: *const i8,
    pub buft: ggml_backend_buffer_type_t
};

class llama_model_params {
    pub devices: *mut ggml_backend_dev_t,
    pub tensor_buft_overrides: *const llama_model_tensor_buft_override,
    pub n_gpu_layers: i32,
    pub split_mode: llama_split_mode,
    pub main_gpu: i32,
    pub tensor_split: *const f32,
    pub progress_callback: llama_progress_callback,
    pub progress_callback_user_data: *mut void,
    pub kv_overrides: *const llama_model_kv_override,
    pub vocab_only: bool,
    pub use_mmap: bool,
    pub use_mlock: bool,
    pub check_tensors: bool,
    pub use_extra_bufts: bool,
    pub no_host: bool
};

class llama_context_params {
    pub n_ctx: u32,
    pub n_batch: u32,
    pub n_ubatch: u32,
    pub n_seq_max: u32,
    pub n_threads: i32,
    pub n_threads_batch: i32,
    pub rope_scaling_type: llama_rope_scaling_type,
    pub pooling_type: _llama_pooling_type,
    pub attention_type: llama_attention_type,
    pub flash_attn_type: llama_flash_attn_type,
    pub rope_freq_base: f32,
    pub rope_freq_scale: f32,
    pub yarn_ext_factor: f32,
    pub yarn_attn_factor: f32,
    pub yarn_beta_fast: f32,
    pub yarn_beta_slow: f32,
    pub yarn_orig_ctx: u32,
    pub defrag_thold: f32,
    pub cb_eval: ggml_backend_sched_eval_callback,
    pub cb_eval_user_data: *mut void,
    pub type_k: ggml_type,
    pub type_v: ggml_type,
    pub abort_callback: ggml_abort_callback,
    pub abort_callback_data: *mut void,
    pub embeddings: bool,
    pub offload_kqv: bool,
    pub no_perf: bool,
    pub op_offload: bool,
    pub swa_full: bool,
    pub kv_unified: bool
};

class llama_model_quantize_params {
    pub nthread: i32,
    pub ftype: llama_ftype,
    pub output_tensor_type: ggml_type,
    pub token_embedding_type: ggml_type,
    pub allow_requantize: bool,
    pub quantize_output_tensor: bool,
    pub only_copy: bool,
    pub pure: bool,
    pub keep_split: bool,
    pub imatrix: *mut void,
    pub kv_overrides: *mut void,
    pub tensor_types: *mut void,
    pub prune_layers: *mut void
};

class llama_logit_bias {
    pub token: llama_token,
    pub bias: f32
};

class llama_sampler_chain_params {
    pub no_perf: bool
};

class llama_chat_message {
    pub role: *const i8,
    pub content: *const i8
};

class llama_adapter_lora {};

type llama_sampler_context_t = *mut void;

class llama_sampler_i {
    pub name: func(smpl: *const _llama_sampler) -> *const i8,
    pub accept: func(smpl: *mut _llama_sampler, token: llama_token),
    pub apply: func(smpl: *mut _llama_sampler, cur_p: *mut llama_token_data_array),
    pub reset: func(smpl: *mut _llama_sampler),
    pub clone: func(smpl: *const _llama_sampler) -> *mut _llama_sampler,
    pub free: func(smpl: *mut _llama_sampler)
};

class llama_sampler {
    pub iface: *const llama_sampler_i,
    pub ctx: llama_sampler_context_t
};

class llama_perf_context_data {
    pub t_start_ms: f64,
    pub t_load_ms: f64,
    pub t_p_eval_ms: f64,
    pub t_eval_ms: f64,
    pub n_p_eval: i32,
    pub n_eval: i32,
    pub n_reused: i32
};

class llama_perf_sampler_data {
    pub t_sample_ms: f64,
    pub n_sample: i32
};

type llama_opt_param_filter = func(tensor: *const ggml_tensor, userdata: *mut void) -> bool;

class llama_opt_params {
    pub n_ctx_train: u32,
    pub param_filter: llama_opt_param_filter,
    pub param_filter_ud: *mut void,
    pub get_opt_pars: ggml_opt_get_optimizer_params,
    pub get_opt_pars_ud: *mut void,
    pub optimizer_type: ggml_opt_optimizer_type
};

const LLAMA_STATE_SEQ_FLAGS_SWA_ONLY: i32 = 1i32;
const LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY: i32 = 1i32;

type llama_state_seq_flags = u32;

extern "C" {
    func llama_model_default_params() -> llama_model_params;
    func llama_context_default_params() -> llama_context_params;
    func llama_sampler_chain_default_params() -> llama_sampler_chain_params;
    func llama_model_quantize_default_params() -> llama_model_quantize_params;

    func llama_backend_init();
    func llama_backend_free();

    func llama_numa_init(numa: ggml_numa_strategy);

    func llama_attach_threadpool(ctx: *mut llama_context, threadpool: ggml_threadpool_t, threadpool_batch: ggml_threadpool_t);
    func llama_detach_threadpool(ctx: *mut llama_context);

    func llama_model_load_from_file(path_model: *const i8, params: llama_model_params) -> *mut llama_model;
    func llama_model_load_from_splits(paths: *const *const i8, n_paths: u32, params: llama_model_params) -> *mut llama_model;
    func llama_model_save_to_file(model: *const llama_model, path_model: *const i8);
    func llama_model_free(model: *mut llama_model);

    func llama_init_from_model(model: *mut llama_model, params: llama_context_params) -> *mut llama_context;
    func llama_free(ctx: *mut llama_context);

    func llama_time_us() -> i64;

    func llama_max_devices() -> u32;
    func llama_max_parallel_sequences() -> u32;

    func llama_supports_mmap() -> bool;
    func llama_supports_mlock() -> bool;
    func llama_supports_gpu_offload() -> bool;
    func llama_supports_rpc() -> bool;

    func llama_n_ctx(ctx: *const llama_context) -> u32;
    func llama_n_ctx_seq(ctx: *const llama_context) -> u32;
    func llama_n_batch(ctx: *const llama_context) -> u32;
    func llama_n_ubatch(ctx: *const llama_context) -> u32;
    func llama_n_seq_max(ctx: *const llama_context) -> u32;

    func llama_get_model(ctx: *const llama_context) -> *const llama_model;
    func llama_get_memory(ctx: *const llama_context) -> llama_memory_t;
    func llama_pooling_type(ctx: *const llama_context) -> _llama_pooling_type;

    func llama_model_get_vocab(model: *const llama_model) -> *const llama_vocab;
    func llama_model_rope_type(model: *const llama_model) -> llama_rope_type;

    func llama_model_n_ctx_train(model: *const llama_model) -> i32;
    func llama_model_n_embd(model: *const llama_model) -> i32;
    func llama_model_n_embd_inp(model: *const llama_model) -> i32;
    func llama_model_n_layer(model: *const llama_model) -> i32;
    func llama_model_n_head(model: *const llama_model) -> i32;
    func llama_model_n_head_kv(model: *const llama_model) -> i32;
    func llama_model_n_swa(model: *const llama_model) -> i32;

    func llama_model_rope_freq_scale_train(model: *const llama_model) -> f32;
    func llama_model_n_cls_out(model: *const llama_model) -> u32;
    func llama_model_cls_label(model: *const llama_model, i: u32) -> *const i8;

    func llama_vocab_type(vocab: *const llama_vocab) -> _llama_vocab_type;
    func llama_vocab_n_tokens(vocab: *const llama_vocab) -> i32;

    func llama_model_meta_val_str(model: *const llama_model, key: *const i8, buf: *mut i8, buf_size: u32) -> i32;
    func llama_model_meta_count(model: *const llama_model) -> i32;
    func llama_model_meta_key_str(key: llama_model_meta_key) -> *const i8;
    func llama_model_meta_key_by_index(model: *const llama_model, i: i32, buf: *mut i8, buf_size: u32) -> i32;
    func llama_model_meta_val_str_by_index(model: *const llama_model, i: i32, buf: *mut i8, buf_size: u32) -> i32;

    func llama_model_desc(model: *const llama_model, buf: *mut i8, buf_size: u32) -> i32;
    func llama_model_size(model: *const llama_model) -> u64;
    func llama_model_chat_template(model: *const llama_model, name: *const i8) -> *const i8;
    func llama_model_n_params(model: *const llama_model) -> u64;
    func llama_model_has_encoder(model: *const llama_model) -> bool;
    func llama_model_has_decoder(model: *const llama_model) -> bool;
    func llama_model_decoder_start_token(model: *const llama_model) -> llama_token;
    func llama_model_is_recurrent(model: *const llama_model) -> bool;
    func llama_model_is_hybrid(model: *const llama_model) -> bool;
    func llama_model_is_diffusion(model: *const llama_model) -> bool;

    func llama_model_quantize(fname_inp: *const i8, fname_out: *const i8, params: *const llama_model_quantize_params) -> u32;

    func llama_adapter_lora_init(model: *mut llama_model, path_lora: *const i8) -> *mut llama_adapter_lora;
    func llama_adapter_meta_val_str(adapter: *const llama_adapter_lora, key: *const i8, buf: *mut i8, buf_size: u32) -> i32;
    func llama_adapter_meta_count(adapter: *const llama_adapter_lora) -> i32;
    func llama_adapter_meta_key_by_index(adapter: *const llama_adapter_lora, i: i32, buf: *mut i8, buf_size: u32) -> i32;
    func llama_adapter_meta_val_str_by_index(adapter: *const llama_adapter_lora, i: i32, buf: *mut i8, buf_size: u32) -> i32;
    func llama_adapter_lora_free(adapter: *mut llama_adapter_lora);
    func llama_adapter_get_alora_n_invocation_tokens(adapter: *const llama_adapter_lora) -> u64;
    func llama_adapter_get_alora_invocation_tokens(adapter: *const llama_adapter_lora) -> *const llama_token;

    func llama_set_adapter_lora(ctx: *mut llama_context, adapter: *mut llama_adapter_lora, scale: f32) -> i32;
    func llama_rm_adapter_lora(ctx: *mut llama_context, adapter: *mut llama_adapter_lora) -> i32;
    func llama_clear_adapter_lora(ctx: *mut llama_context);
    func llama_apply_adapter_cvec(ctx: *mut llama_context, data: *const f32, len: u32, n_embd: i32, il_start: i32, il_end: i32) -> i32;

    func llama_memory_clear(mem: llama_memory_t, data: bool);
    func llama_memory_seq_rm(mem: llama_memory_t, seq_id: llama_seq_id, p0: llama_pos, p1: llama_pos) -> bool;
    func llama_memory_seq_cp(mem: llama_memory_t, seq_id_src: llama_seq_id, seq_id_dst: llama_seq_id, p0: llama_pos, p1: llama_pos);
    func llama_memory_seq_keep(mem: llama_memory_t, seq_id: llama_seq_id);
    func llama_memory_seq_add(mem: llama_memory_t, seq_id: llama_seq_id, p0: llama_pos, p1: llama_pos, delta: llama_pos);
    func llama_memory_seq_div(mem: llama_memory_t, seq_id: llama_seq_id, p0: llama_pos, p1: llama_pos, d: i32);
    func llama_memory_seq_pos_min(mem: llama_memory_t, seq_id: llama_seq_id) -> llama_pos;
    func llama_memory_seq_pos_max(mem: llama_memory_t, seq_id: llama_seq_id) -> llama_pos;
    func llama_memory_can_shift(mem: llama_memory_t) -> bool;

    func llama_state_get_size(ctx: *mut llama_context) -> u32;
    func llama_state_get_data(ctx: *mut llama_context, dst: *mut u8, size: u32) -> u32;
    func llama_state_set_data(ctx: *mut llama_context, src: *const u8, size: u32) -> u32;
    func llama_state_load_file(ctx: *mut llama_context, path_session: *const i8, tokens_out: *mut llama_token, n_token_capacity: u32, n_token_count_out: *mut u32) -> bool;
    func llama_state_save_file(ctx: *mut llama_context, path_session: *const i8, tokens: *const llama_token, n_token_count: u32) -> bool;

    func llama_state_seq_get_size(ctx: *mut llama_context, seq_id: llama_seq_id) -> u32;
    func llama_state_seq_get_data(ctx: *mut llama_context, dst: *mut u8, size: u32, seq_id: llama_seq_id) -> u32;
    func llama_state_seq_set_data(ctx: *mut llama_context, src: *const u8, size: u32, dest_seq_id: llama_seq_id) -> u32;
    func llama_state_seq_save_file(ctx: *mut llama_context, filepath: *const i8, seq_id: llama_seq_id, tokens: *const llama_token, n_token_count: u32) -> u32;
    func llama_state_seq_load_file(ctx: *mut llama_context, filepath: *const i8, dest_seq_id: llama_seq_id, tokens_out: *mut llama_token, n_token_capacity: u32, n_token_count_out: *mut u32) -> u32;
    func llama_state_seq_get_size_ext(ctx: *mut llama_context, seq_id: llama_seq_id, flags: llama_state_seq_flags) -> u32;
    func llama_state_seq_get_data_ext(ctx: *mut llama_context, dst: *mut u8, size: u32, seq_id: llama_seq_id, flags: llama_state_seq_flags) -> u32;
