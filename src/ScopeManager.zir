#[include "std/str", "std/vec", "src/Scope.zir", "src/Symbol.zir", "src/AST.zir", "src/HIR.zir" : *]

class ScopeManager {
    pub arena: Arena,
    pub current: *mut Scope = null;

    ScopeManager(&mut this) {
        this.PushScope(String("global"), true);
    }

    pub fn PushScope(&mut this, name: &String, global: bool) {
        let scope = this.arena.New<Scope>(this.current, name, global);

        if this.current != null {
            this.current->children.PushBack(scope);
        } this.current = scope;
    }

    pub fn PopScope(&mut this) {
        if this.current == null {
            Logger::Log("ScopeManager", "No scope to pop!", LogSeverity::Fatal);
        }

        if !this.current->global {
            this.current->parent->children.Remove(this.current);
        } this.current = this.current->parent;
    }

    fn LookupScope(&this, scope: *Scope, segment: ASTPathSegment) -> *Scope {
        if scope == null { return null; }
        let mut types = Vector<*HIRType>();

        for _type in segment.types {
            let resolved = analyzer->ResolveType(_type);
            if resolved == null { return null; }
            types.PushBack(resolved);
        }

        if !types.Empty() {
            for symbol in scope->Get(segment.name, SymbolKind::Generic) {
                return symbol->generic->Get(types).right;
            }
        } else {
            for child in scope->children {
                if child->name == segment.name {
                    return child;
                }
            }
        } return null;
    }

    fn LookupSymbol(&this, scope: *Scope, segment: ASTPathSegment) -> Vector<*Symbol> {
        if scope == null { return Vector<*Symbol>(); }
        let mut types = Vector<*HIRType>();

        for _type in segment.types {
            let resolved = analyzer->ResolveType(_type);
            if resolved == null { return Vector<*Symbol>(); }
            types.PushBack(resolved);
        }

        let symbols = Vector<*Symbol>();

        for symbol in scope->Get(segment.name) {
            if !types.Empty() {
                if symbol->kind != SymbolKind::Generic { continue; }
                let result = symbol->generic->Get(types);
                if result.left == null { continue; }
                symbols.PushBack(result.left);
            } else {
                symbols.PushBack(symbol);
            }
        } return symbols;
    }

    pub fn ResolveScope(&this, path: *ASTPath) -> *Scope {
        let mut scope: *Scope = null;

        if path->absolute {
            let mut root = this.current;
            while root->parent != null { root = root->parent; }
            if path->segments.Size() == 1 { return root; }
            scope = this.LookupScope(root, path->segments[0]);
        } else {
            if path->segments.Size() == 1 { return null; }
            let mut cursor = this.current;

            while cursor != null {
                scope = this.LookupScope(cursor, path->segments[0]);
                if scope != null { break; }
                cursor = cursor->parent;
            }
        }

        for i in 1..(path->segments.Size() - 1) {
            if scope == null { break; }
            scope = this.LookupScope(scope, path->segments[i]);
        } return scope;
    }

    pub fn Resolve(&this, path: *ASTPath, test: bool) -> Vector<*Symbol> {
        if path == null || path->segments.Empty() {
            return Vector<*Symbol>();
        }

        if path->segments.Size() == 1 && !path->absolute {
            let mut cursor = this.current;

            while cursor != null {
                let symbols = this.LookupSymbol(cursor, path->segments.Back());
                if !symbols.Empty() { return symbols; }
                cursor = cursor->parent;
            }
        } else {
            let scope = this.ResolveScope(path);

            if scope != null {
                let symbols = this.LookupSymbol(scope, path->segments.Back());
                if !symbols.Empty() { return symbols; }
            }
        }

        if !test {
            Logger::Log("Symbol '" + path->segments.Back().name + "' not found.", path, LogSeverity::Error);
        } return Vector<*Symbol>();
    }

    pub fn ResolveType(&this, path: *ASTPath, test: bool) -> Vector<*Symbol> {
        if path == null || path->segments.Empty() {
            return Vector<*Symbol>();
        }

        if path->segments.Size() == 1 && !path->absolute {
            let mut cursor = this.current;

            while cursor != null {
                let symbols = Vector<*Symbol>();

                for symbol in this.LookupSymbol(cursor, path->segments.Back()) {
                    if symbol->kind == SymbolKind::Type {
                        symbols.PushBack(symbol);
                    }
                }

                if !symbols.Empty() { return symbols; }
                cursor = cursor->parent;
            }
        } else {
            let scope = this.ResolveScope(path);

            if scope != null {
                let symbols = Vector<*Symbol>();

                for symbol in this.LookupSymbol(scope, path->segments.Back()) {
                    if symbol->kind == SymbolKind::Type {
                        symbols.PushBack(symbol);
                    }
                }

                if !symbols.Empty() { return symbols; }
            }
        }

        if !test {
            Logger::Log("Symbol '" + path->segments.Back().name + "' not found.", path, LogSeverity::Error);
        } return Vector<*Symbol>();
    }

    pub fn ResolveCandidates(&this, path: *ASTPath, test: bool) -> Vector<*HIRFunctionDeclaration> {
        let result = Vector<*HIRFunctionDeclaration>();
        if path == null || path->segments.Empty() { return result; }
        let mut symbols = Vector<*Symbol>();

        if path->segments.Size() == 1 && !path->absolute {
            let mut cursor = this.current;

            while cursor != null {
                symbols = this.LookupSymbol(cursor, path->segments.Back());
                if !symbols.Empty() { break; }
                cursor = cursor->parent;
            }
        } else {
            let scope = this.ResolveScope(path);

            if scope != null {
                symbols = this.LookupSymbol(scope, path->segments.Back());
            }
        }

        for symbol in symbols {
            if symbol->kind == SymbolKind::Declaration && symbol->declaration->kind == HIRDeclarationKind::Function {
                result.PushBack(symbol->declaration as *HIRFunctionDeclaration);
            }
        }

        if result.Empty() && !test {
            Logger::Log("Symbol '" + path->segments.Back().name + "' not found.", path, LogSeverity::Error);
        } return result;
    }

    pub fn ResolveCandidates(&this, path: *ASTPath, test: bool) -> Vector<*HIRFunctionDeclaration> {
        let result = Vector<*HIRFunctionDeclaration>();
        if path == null || path->segments.Empty() { return result; }
        let mut symbols = Vector<*Symbol>();

        if path->segments.Size() == 1 && !path->absolute {
            let mut cursor = this.current;

            while cursor != null {
                symbols = this.LookupSymbol(cursor, path->segments.Back());
                if !symbols.Empty() { break; }
                cursor = cursor->parent;
            }
        } else {
            let scope = this.ResolveScope(path);

            if scope != null {
                symbols = this.LookupSymbol(scope, path->segments.Back());
            }
        }

        for symbol in symbols {
            if symbol->kind == SymbolKind::Declaration && symbol->declaration->kind == HIRDeclarationKind::Function {
                result.PushBack(symbol->declaration as *HIRFunctionDeclaration);
            }
        }

        if result.Empty() && !test {
            if !symbols.Empty() {
                Logger::Log("Symbol '" + path->segments.Back().name + "' is not a function.", path, LogSeverity::Error);
            } else {
                Logger::Log("Symbol '" + path->segments.Back().name + "' not found.", path, LogSeverity::Error);
            }
        } return result;
    }

    pub fn ResolveCandidates(&this, name: &String, node: *ASTNode, test: bool) -> Vector<*HIRFunctionDeclaration> {
        let mut symbols = Vector<*Symbol>();
        let mut result = Vector<*HIRFunctionDeclaration>();
        let mut cursor = this.current;

        while cursor != null {
            symbols = cursor->Get(name);
            if !symbols.Empty() { break; }
            cursor = cursor->parent;
        }

        for symbol in symbols {
            if symbol->kind == SymbolKind::Declaration && symbol->declaration->kind == HIRDeclarationKind::Function {
                result.PushBack(symbol->declaration as *HIRFunctionDeclaration);
            }
        }

        if result.Empty() && !test {
            if !symbols.Empty() {
                Logger::Log("Symbol '" + name + "' is not a function.", node, LogSeverity::Error);
            } else {
                Logger::Log("Symbol '" + name + "' not found.", node, LogSeverity::Error);
            }
        } return result;
    }
}

#[include "src/SemanticAnalyzer.zir" : *]
