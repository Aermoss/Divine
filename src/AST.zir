    ASTCase(&mut this, pattern: *ASTNode, body: *ASTNode, guard: *ASTNode, start: Token) : ASTNode(ASTNodeKind::CASE, start) {
        (this.pattern, this.body, this.guard) = (pattern, body, guard);
    }
}

class ASTDefault : ASTNode {
