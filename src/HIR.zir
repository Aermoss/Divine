#[include "std/str", "std/vec", "src/Tokens.zir", "src/Types.zir" : *]

enum HIRExpressionKind: u8 {
    IntegerLiteral, FloatLiteral, BooleanLiteral, CharacterLiteral, StringLiteral, NullLiteral,
    VariableRef, DeclarationRef, Call, Unary, Binary, Ternary, Assignment, Cast, IndexAccess, MemberAccess,
    New, Delete, Construct, Destruct, StructureInitializer, Intrinsic, Deferred, Dereference, AddressOf
}

enum HIRExpressionCategory: u8 {
    Place, Value
}

class HIRExpression {
    pub kind: HIRExpressionKind,
    pub _type: *SemanticType,
    pub category: HIRExpressionCategory = ::HIRExpressionCategory::Value,
    pub mutable: bool = false,
    pub deferred: *Node = null;

    HIRExpression(&mut this, kind: HIRExpressionKind, _type: *SemanticType) {
        (this.kind, this._type) = (kind, _type);
    }

    HIRExpression(&mut this, kind: HIRExpressionKind, _type: *SemanticType, category: HIRExpressionCategory, mutable: bool) {
        (this.kind, this._type, this.category, this.mutable) = (kind, _type, category, mutable);
    }

    HIRExpression(&mut this, kind: HIRExpressionKind, _type: *SemanticType, deferred: *Node) {
        (this.kind, this._type, this.deferred) = (kind, _type, deferred);
    }
}

class HIRIntegerLiteral : HIRExpression {
    pub value: u64;

    HIRIntegerLiteral(&mut this, value: u64, _type: *SemanticType) : HIRExpression(HIRExpressionKind::IntegerLiteral, _type) {
        this.value = value;
    }
}

class HIRFloatLiteral : HIRExpression {
    pub value: f64;

    HIRFloatLiteral(&mut this, value: f64, _type: *SemanticType) : HIRExpression(HIRExpressionKind::FloatLiteral, _type) {
        this.value = value;
    }
}

class HIRBooleanLiteral : HIRExpression {
    pub value: bool;

    HIRBooleanLiteral(&mut this, value: bool, _type: *SemanticType) : HIRExpression(HIRExpressionKind::BooleanLiteral, _type) {
        this.value = value;
    }
}

class HIRCharacterLiteral : HIRExpression {
    pub value: u32;

    HIRCharacterLiteral(&mut this, value: u32, _type: *SemanticType) : HIRExpression(HIRExpressionKind::CharacterLiteral, _type) {
        this.value = value;
    }
}

class HIRStringLiteral : HIRExpression {
    pub value: String;

    HIRStringLiteral(&mut this, value: String, _type: *SemanticType) : HIRExpression(HIRExpressionKind::StringLiteral, _type) {
        this.value = value;
    }
}

class HIRNullLiteral : HIRExpression {
    HIRNullLiteral(&mut this, _type: *SemanticType) : HIRExpression(HIRExpressionKind::NullLiteral, _type) {}
}

class HIRDereference : HIRExpression {
    pub operand: *HIRExpression;

    HIRDereference(&mut this, operand: *HIRExpression) : HIRExpression(HIRExpressionKind::Dereference, operand->_type->Pointee(), HIRExpressionCategory::Place, operand->_type->IsMutable()) {
        this.operand = operand;
    }
}

class HIRAddressOf : HIRExpression {
    pub operand: *HIRExpression;

    HIRAddressOf(&mut this, operand: *HIRExpression, mutable: bool) : HIRExpression(HIRExpressionKind::AddressOf, analyzer->type_manager.Reference(operand->_type, mutable)) {
        this.operand = operand;
    }
}

class HIRVariableRef : HIRExpression {
    pub variable: *HIRVariable;

    HIRVariableRef(&mut this, variable: *HIRVariable) : HIRExpression(HIRExpressionKind::VariableRef, variable->_type, HIRExpressionCategory::Place, variable->mutable) {
        this.variable = variable;
    }
}

class HIRDeclarationRef : HIRExpression {
    pub declaration: *HIRDeclaration;

    HIRDeclarationRef(&mut this, declaration: *HIRDeclaration, mutable: bool) : HIRExpression(HIRExpressionKind::DeclarationRef, declaration->_type, HIRExpressionCategory::Place, mutable) {
        this.declaration = declaration;
    }
}

class HIRCall : HIRExpression {
    pub function: *SemanticType,
    pub arguments: Vector<*HIRExpression>;

    HIRCall(&mut this, function: *SemanticType, arguments: &Vector<*HIRExpression>) : HIRExpression(HIRExpressionKind::Call, function->Return()) {
        (this.function, this.arguments) = (function, arguments);
    }
}

class HIRUnary : HIRExpression {
    pub _operator: TokenType,
    pub operand: *HIRExpression;

    HIRUnary(&mut this, _operator: TokenType, operand: *HIRExpression) : HIRExpression(HIRExpressionKind::Unary, operand->_type) {
        (this._operator, this.operand) = (_operator, operand);
    }
}

class HIRBinary : HIRExpression {
    pub _operator: TokenType,
    pub left: *HIRExpression,
    pub right: *HIRExpression;

    HIRBinary(&mut this, _operator: TokenType, left: *HIRExpression, right: *HIRExpression, _type: *SemanticType) : HIRExpression(HIRExpressionKind::Binary, _type) {
        (this._operator, this.left, this.right) = (_operator, left, right);
    }
}

class HIRAssignment : HIRExpression {
    pub left: *HIRExpression,
    pub right: *HIRExpression;

    HIRAssignment(&mut this, left: *HIRExpression, right: *HIRExpression) : HIRExpression(HIRExpressionKind::Assignment, analyzer->type_manager.Void()) {
        (this.left, this.right) = (left, right);
    }
}

class HIRTernary : HIRExpression {
    pub condition: *HIRExpression,
    pub then: *HIRExpression,
    pub _else: *HIRExpression;

    HIRTernary(&mut this, condition: *HIRExpression, then: *HIRExpression, _else: *HIRExpression, category: HIRExpressionCategory, mutable: bool) : HIRExpression(HIRExpressionKind::Ternary, then->_type, category, mutable) {
        (this.condition, this.then, this._else) = (condition, then, _else);
    }
}

class HIRCast : HIRExpression {
    pub value: *HIRExpression;

    HIRCast(&mut this, value: *HIRExpression, _type: *SemanticType) : HIRExpression(HIRExpressionKind::Cast, _type) {
        this.value = value;
    }
}

class HIRIndexAccess : HIRExpression {
    pub value: *HIRExpression,
    pub index: *HIRExpression;

    HIRIndexAccess(&mut this, value: *HIRExpression, index: *HIRExpression) : HIRExpression(HIRExpressionKind::IndexAccess, value->_type->AsReference()) {
        (this.value, this.index) = (value, index);
    }
}

class HIRMemberAccess : HIRExpression {
    pub instance: *HIRExpression,
    pub index: usize;

    HIRMemberAccess(&mut this, instance: *HIRExpression, _type: *SemanticType, index: usize) : HIRExpression(HIRExpressionKind::MemberAccess, _type, instance->category, instance->mutable) {
        (this.instance, this.index) = (instance, index);
    }
}

class HIRNew : HIRExpression {
    pub _type: *SemanticType,
    pub size: *HIRExpression;

    HIRNew(&mut this, _type: *SemanticType, size: *HIRExpression) : HIRExpression(HIRExpressionKind::New, analyzer->type_manager.Pointer(_type, true)) {
        (this._type, this.size) = (_type, size);
    }
}

class HIRDelete : HIRExpression {
    pub value: *HIRExpression;

    HIRDelete(&mut this, value: *HIRExpression) : HIRExpression(HIRExpressionKind::Delete, analyzer->type_manager.Void()) {
        this.value = value;
    }
}

class HIRStructureInitializer : HIRExpression {
    pub _structure: *HIRStructure,
    pub values: Vector<*HIRExpression>;

    HIRStructureInitializer(&mut this, _structure: *HIRStructure, values: Vector<*HIRExpression>) : HIRExpression(HIRExpressionKind::StructureInitializer, (_structure as *HIRDeclaration)->_type) {
        (this._structure, this.values) = (_structure, values);
    }
}

enum HIRIntrinsicKind: u8 {
    SizeOf, AlignOf
}

class HIRIntrinsic : HIRExpression {
    pub kind: HIRIntrinsicKind,
    pub _type: *SemanticType;

    HIRIntrinsic(&mut this, kind: HIRIntrinsicKind, _type: *SemanticType) : HIRExpression(HIRExpressionKind::Intrinsic, analyzer->type_manager.IntegerPointer(false)) {
        (this.kind, this._type) = (kind, _type);
    }
}

class HIRConstruct : HIRExpression {
    pub _type: *SemanticType,
    pub arguments: Vector<*HIRExpression>;

    HIRConstruct(&mut this, _type: *SemanticType, arguments: Vector<*HIRExpression>) : HIRExpression(HIRExpressionKind::Construct, _type) {
        (this._type, this.arguments) = (_type, arguments);
    }
}

class HIRDestruct : HIRExpression {
    pub target: *HIRExpression;

    HIRDestruct(&mut this, target: *HIRExpression) : HIRExpression(HIRExpressionKind::Destruct, analyzer->type_manager.Void()) {
        this.target = target;
    }
}

class HIRDeferredExpression : HIRExpression {
    HIRDeferredExpression(&mut this, _type: *SemanticType, node: *Node) : HIRExpression(HIRExpressionKind::Deferred, _type, node) {}
}

enum HIRStatementKind: u8 {
    Block, Variable, Expression, Return, Break, Continue, For
}

class HIRStatement {
    pub kind: HIRStatementKind;

    HIRStatement(&mut this, kind: HIRStatementKind) {
        this.kind = kind;
    }
}

class HIRBlock : HIRStatement {
    pub statements: Vector<*HIRStatement>;

    HIRBlock(&mut this) : HIRStatement(HIRStatementKind::Block) {}
}

class HIRVariable : HIRStatement {
    pub name: String,
    pub _type: *SemanticType,
    pub initializer: *HIRExpression,
    pub mutable: bool;

    HIRVariable(&mut this, name: String, _type: *SemanticType, initializer: *HIRExpression, mutable: bool) : HIRStatement(HIRStatementKind::Variable) {
        (this.name, this._type, this.initializer, this.mutable) = (name, _type, initializer, mutable);
    }
}

class HIRExpressionStatement : HIRStatement {
    pub expression: *HIRExpression;

    HIRExpressionStatement(&mut this, expression: *HIRExpression) : HIRStatement(HIRStatementKind::Expression) {
        this.expression = expression;
    }
}

class HIRReturn : HIRStatement {
    pub expression: *HIRExpression;

    HIRReturn(&mut this, expression: *HIRExpression) : HIRStatement(HIRStatementKind::Return) {
        this.expression = expression;
    }
}

class HIRBreak : HIRStatement {
    HIRBreak(&mut this) : HIRStatement(HIRStatementKind::Break) {}
}

class HIRContinue : HIRStatement {
    HIRContinue(&mut this) : HIRStatement(HIRStatementKind::Continue) {}
}

class HIRFor : HIRStatement {
    pub iterator: *HIRVariable,
    pub variable: *HIRVariable,
    pub condition: *HIRExpression,
    pub step: *HIRExpression,
    pub body: *HIRBlock;

    HIRFor(&mut this, iterator: *HIRVariable, variable: *HIRVariable, condition: *HIRExpression, step: *HIRExpression, body: *HIRBlock) : HIRStatement(HIRStatementKind::For) {
        (this.iterator, this.variable, this.condition, this.step, this.body) = (iterator, variable, condition, step, body);
    }
}

enum HIRDeclarationKind: u8 {
    Parameter, Function, Class, Structure, Enumeration, Variant, Constant, Static
}

class HIRDeclaration {
    pub kind: HIRDeclarationKind,
    pub name: String,
    pub _type: *SemanticType;

    HIRDeclaration(&mut this, kind: HIRDeclarationKind, name: String, _type: *SemanticType) {
        (this.kind, this.name, this._type) = (kind, name, _type);
    }
}

class HIRParameter : HIRDeclaration {
    pub mutable: bool;

    HIRParameter(&mut this, name: String, _type: *SemanticType, mutable: bool) : HIRDeclaration(HIRDeclarationKind::Parameter, name, _type) {
        this.mutable = mutable;
    }
}

class HIRFunction : HIRDeclaration {
    pub parameters: Vector<*HIRParameter>,
    pub body: *HIRBlock = null;

    HIRFunction(&mut this, name: String, _type: *SemanticType) : HIRDeclaration(HIRDeclarationKind::Function, name, _type) {}
}

class HIRClass : HIRDeclaration {
    pub fields: Vector<*SemanticType>,
    pub constructor: *HIRFunction = null,
    pub destructor: *HIRFunction = null,
    pub methods: Vector<*HIRFunction>;

    HIRClass(&mut this, name: String, _type: *SemanticType) : HIRDeclaration(HIRDeclarationKind::Class, name, _type) {}
}

class HIRStructure : HIRDeclaration {
    pub fields: Vector<*SemanticType>,
    pub methods: Vector<*HIRFunction>;

    HIRStructure(&mut this, name: String, _type: *SemanticType) : HIRDeclaration(HIRDeclarationKind::Structure, name, _type) {}
}

class HIREnumeration : HIRDeclaration {
    HIREnumeration(&mut this, name: String, _type: *SemanticType) : HIRDeclaration(HIRDeclarationKind::Enumeration, name, _type) {}
}

class HIRVariant : HIRDeclaration {
    pub methods: Vector<*HIRFunction>;

    HIRVariant(&mut this, name: String, _type: *SemanticType) : HIRDeclaration(HIRDeclarationKind::Variant, name, _type) {}
}

class HIRConstant : HIRDeclaration {
    pub initializer: *HIRExpression;

    HIRConstant(&mut this, name: String, _type: *SemanticType, initializer: *HIRExpression) : HIRDeclaration(HIRDeclarationKind::Constant, name, _type) {
        this.initializer = initializer;
    }
}

class HIRStatic : HIRDeclaration {
    pub initializer: *HIRExpression,
    pub mutable: bool;

    HIRStatic(&mut this, name: String, _type: *SemanticType, initializer: *HIRExpression, mutable: bool) : HIRDeclaration(HIRDeclarationKind::Static, name, _type) {
        (this.initializer, this.mutable) = (initializer, mutable);
    }
}

class HIRModule {
    pub declarations: Vector<*HIRDeclaration>;

    HIRModule(&mut this) {}
}

#[include "src/SemanticAnalyzer.zir" : *]
