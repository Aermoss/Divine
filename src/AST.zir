    pub name: String,
    pub _type: *ASTType,
    pub initializer: *ASTExpression;

    ASTConstantDeclaration(&mut this, name: String, _type: *ASTType, initializer: *ASTExpression, start: Token) : ASTDeclaration(ASTDeclarationKind::Constant, start) {
        (this.name, this._type, this.initializer) = (name, _type, initializer);
    }
}

class ASTStaticDeclaration : ASTDeclaration {
    pub name: String,
    pub _type: *ASTType,
    pub mutable: bool,
    pub initializer: *ASTExpression = null,
    pub alignment: *ASTExpression,
    pub zero_initializer: bool = false;

    ASTStaticDeclaration(&mut this, name: String, _type: *ASTType, mutable: bool, alignment: *ASTExpression, start: Token) : ASTDeclaration(ASTDeclarationKind::Static, start) {
        (this.name, this._type, this.mutable, this.alignment) = (name, _type, mutable, alignment);
    }
}

