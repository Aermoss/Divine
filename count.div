include "std/io", "std/file", "std/str", "std/map" : *;

class Stats {
    pub lib_counts: Map<String, u64>,
    pub compiler_counts: Map<String, u64>,
    pub other_counts: Map<String, u64>
}

func GetLineCount(path: &String) -> u64 {
    let content: String = _ReadFile(path);
    if content.Empty() { ret 0u64; }
    let lines: u64 = content.Count('\n');

    if content[content.Length() - 1u64] != '\n' {
        ret lines + 1u64;
    } ret lines;
}

func ProcessDirectory(directory: &String, stats: &mut Stats) {
    let find_data: WIN32_FIND_DATAA;
    let find_handle: *mut void = FindFirstFileA((directory + "\\*").Data(), &find_data);
    if find_handle == INVALID_HANDLE_VALUE { ret; }

    loop {
        let file_name: String = find_data.cFileName;

        if file_name != "." && file_name != ".." {
            let path: String = JoinPath(directory, file_name);

            if (find_data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0u32 {
                ProcessDirectory(path, stats);
            } else if file_name.EndsWith(".div") {
                let lines: u64 = GetLineCount(path);

                if path.Contains("include") {
                    let parts: Vector<String> = path.Split(PATH_SEPERATOR);
                    let mut lib_group: String = "General (include)";
                    let mut k: u64 = 0u64;
                    
                    while k < parts.Size() {
                        if parts[k] == "include" && k + 1u64 < parts.Size() {
                            lib_group = parts[k + 1u64];
                            break;
                        } k += 1u64;
                    }
                    
                    if !stats.lib_counts.Has(lib_group) {
                        stats.lib_counts[lib_group] = lines;
                    } else {
                        stats.lib_counts[lib_group] += lines;
                    }
                } else if file_name == "main.div" || file_name == "logger.div" || file_name == "lexer.div" || file_name == "preprocessor.div" || file_name == "parser.div" || file_name == "compiler.div" || file_name == "start.div" {
                    stats.compiler_counts[file_name] = lines;
                } else {
                    stats.other_counts[file_name] = lines;
                }
            }
        }

        if FindNextFileA(find_handle, &find_data) == 0i32 {
            break;
        }
    }

    FindClose(find_handle);
}

func PrintMap(title: *const i8, mut map: Map<String, u64>) -> u64 {
    let mut total: u64 = 0u64;
    WriteLine("--- " + title.ToString() + " ---");
    let mut i: u64 = 0u64;

    while i < map.Size() {
        let pair: &Pair<String, u64> = map[i];
        WriteLine(pair.left + ": " + String(pair.right as i64) + " lines");
        total += pair.right;
        i += 1u64;
    }
    
    WriteLine("Subtotal: " + String(total as i64) + " lines\n");
    ret total;
}

func main(args: &mut Vector<String>) -> i32 {
    let mut stats: Stats;
    ProcessDirectory(String("."), &mut stats);
    let lib_total: u64 = PrintMap("Library Groups", stats.lib_counts);
    let comp_total: u64 = PrintMap("Compiler Core", stats.compiler_counts);
    let other_total: u64 = PrintMap("Other Files", stats.other_counts);
    let total: u64 = lib_total + comp_total + other_total;
    WriteLine("==========================================");
    WriteLine("TOTAL LINES:  " + String(total as i64) + " lines");
    WriteLine("==========================================");
    ret 0i32;
}