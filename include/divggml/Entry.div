class ggml_backend_buffer_type_i {};
class ggml_backend_device_i {};
class ggml_threadpool_i {};
class ggml_opt_dataset_i {};
class ggml_opt_result_i {};

type ggml_backend_buffer_type_t = *mut ggml_backend_buffer_type_i;
type ggml_backend_dev_t = *mut ggml_backend_device_i;
type ggml_threadpool_t = *mut ggml_threadpool_i;
type ggml_opt_dataset_t = *mut ggml_opt_dataset_i;
type ggml_opt_result_t = *mut ggml_opt_result_i;

enum ggml_type {
    GGML_TYPE_F32 = 0i32,
    GGML_TYPE_F16 = 1i32,
    GGML_TYPE_Q4_0 = 2i32,
    GGML_TYPE_Q4_1 = 3i32,
    GGML_TYPE_Q5_0 = 6i32,
    GGML_TYPE_Q5_1 = 7i32,
    GGML_TYPE_Q8_0 = 8i32,
    GGML_TYPE_Q8_1 = 9i32,
    GGML_TYPE_Q2_K = 10i32,
    GGML_TYPE_Q3_K = 11i32,
    GGML_TYPE_Q4_K = 12i32,
    GGML_TYPE_Q5_K = 13i32,
    GGML_TYPE_Q6_K = 14i32,
    GGML_TYPE_Q8_K = 15i32,
    GGML_TYPE_IQ2_XXS = 16i32,
    GGML_TYPE_IQ2_XS = 17i32,
    GGML_TYPE_IQ3_XXS = 18i32,
    GGML_TYPE_IQ1_S = 19i32,
    GGML_TYPE_IQ4_NL = 20i32,
    GGML_TYPE_IQ3_S = 21i32,
    GGML_TYPE_IQ2_S = 22i32,
    GGML_TYPE_IQ4_XS = 23i32,
    GGML_TYPE_I8 = 24i32,
    GGML_TYPE_I16 = 25i32,
    GGML_TYPE_I32 = 26i32,
    GGML_TYPE_I64 = 27i32,
    GGML_TYPE_F64 = 28i32,
    GGML_TYPE_IQ1_M = 29i32,
    GGML_TYPE_BF16 = 30i32,
    GGML_TYPE_Q4_0_4_4 = 31i32,
    GGML_TYPE_Q4_0_4_8 = 32i32,
    GGML_TYPE_Q4_0_8_8 = 33i32,
    GGML_TYPE_TQ1_0 = 34i32,
    GGML_TYPE_TQ2_0 = 35i32,
    GGML_TYPE_COUNT = 36i32
};

enum ggml_numa_strategy {
    GGML_NUMA_STRATEGY_DISABLED = 0i32,
    GGML_NUMA_STRATEGY_DISTRIBUTE = 1i32,
    GGML_NUMA_STRATEGY_ISOLATE = 2i32,
    GGML_NUMA_STRATEGY_NUMACTL = 3i32,
    GGML_NUMA_STRATEGY_MIRROR = 4i32,
    GGML_NUMA_STRATEGY_COUNT = 5i32
};

enum ggml_log_level {
    GGML_LOG_LEVEL_ERROR = 2i32,
    GGML_LOG_LEVEL_WARN = 3i32,
    GGML_LOG_LEVEL_INFO = 4i32,
    GGML_LOG_LEVEL_DEBUG = 5i32
};

enum ggml_opt_optimizer_type {
    GGML_OPT_ADAM = 0i32,
    GGML_OPT_LBFGS = 1i32
};

class ggml_tensor {
    pub _type: ggml_type,
    pub backend: i32,
    pub buffer: *mut void,
    pub ne[4u64]: i64,
    pub nb[4u64]: u32,
    pub _op: i32,
    pub op_params[16u64]: i32,
    pub flags: i32,
    pub grad: *mut ggml_tensor,
    pub src[10u64]: *mut ggml_tensor,
    pub view_src: *mut ggml_tensor,
    pub view_offs: u32,
    pub data: *mut void,
    pub name[64u64]: i8,
    pub extra: *mut void,
    pub padding[8u64]: i8
};

class ggml_opt_params {
    pub _type: ggml_opt_optimizer_type,
    pub graph_size: u32,
    pub n_threads: i32,
    pub past: i32,
    pub delta: f32,
    pub max_no_improvement: i32,
    pub print_forward_graph: bool,
    pub print_backward_graph: bool,
    pub n_gradient_accumulation: i32,

    pub adam_n_iter: i32,
    pub adam_sched: f32,
    pub adam_decay: f32,
    pub adam_decay_min_ndim: i32,
    pub adam_alpha: f32,
    pub adam_beta1: f32,
    pub adam_beta2: f32,
    pub adam_eps: f32,
    pub adam_eps_f: f32,
    pub adam_eps_g: f32,
    pub adam_gclip: f32,

    pub lbfgs_m: i32,
    pub lbfgs_n_iter: i32,
    pub lbfgs_max_linesearch: i32,
    pub lbfgs_eps: f32,
    pub lbfgs_ftol: f32,
    pub lbfgs_wolfe: f32,
    pub lbfgs_min_step: f32,
    pub lbfgs_max_step: f32,
    pub lbfgs_linesearch: i32
};

type ggml_backend_sched_eval_callback = func(t: *mut ggml_tensor, ask: bool, user_data: *mut void) -> bool;
type ggml_abort_callback = func(user_data: *mut void) -> bool;
type ggml_log_callback = func(level: ggml_log_level, text: *const i8, user_data: *mut void);
type ggml_opt_get_optimizer_params = func(user_data: *mut void) -> ggml_opt_params;
type ggml_opt_epoch_callback = func(data: *mut void, epoch: i32, loss_train: f32, loss_val: f32, time_elapsed: f64);

const GGML_ROPE_TYPE_NEOX: i32 = 2i32;
const GGML_ROPE_TYPE_MROPE: i32 = 4i32;
const GGML_ROPE_TYPE_IMROPE: i32 = 6i32;
const GGML_ROPE_TYPE_VISION: i32 = 24i32;