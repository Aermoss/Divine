include "divio", "divmem", "divvec", "divdef" : *;

extern "C" {
    func strlen(str: *const i8) -> size_t {
        let mut i: u64 = 0u64;

        loop {
            if str[i] == 0i8 {
                ret i;
            } else {
                i += 1u64;
            }
        } ret 0u64;
    }
}

class String {
    priv data: *mut i8 = null,
    priv length: u64 = 0u64
} impl {
    String(this: &mut String) {
        this.Allocate(0u64);
    }

    String(this: &mut String, string: *const i8) {
        let other_length: u64 = strlen(string);

        if string == null {
            this.Allocate(0u64);
            ret;
        }

        this.Allocate(other_length);
        memcpy(this.data, string, other_length);
    }

    String(this: &mut String, other: &String) {
        if other.data == null {
            this.Allocate(0u64);
            ret;
        }

        this.Allocate(other.length);
        memcpy(this.data, other.data, other.length);
    }

    String(this: &mut String, string: *const i8, mut length: u64) {
        let other_length: u64 = strlen(string);

        if string == null || length == 0u64 {
            this.Allocate(0u64);
            ret;
        }

        if length > other_length {
            length = other_length;
        }

        this.Allocate(length);
        memcpy(this.data, string, length);
    }

    String(this: &mut String, other: &String, mut length: u64) {
        if other.data == null || length == 0u64 {
            this.Allocate(0u64);
            ret;
        }

        if length > other.length {
            length = other.length;
        }

        this.Allocate(length);
        memcpy(this.data, other.data, length);
    }

    String(this: &mut String, string: *const i8, start: u64, mut length: u64) {
        let other_length: u64 = strlen(string);

        if string == null || start >= other_length || length == 0u64 {
            this.Allocate(0u64);
            ret;
        }

        if start + length > other_length {
            length = other_length - start;
        }

        this.Allocate(length);
        memcpy(this.data, (string + start), length);
    }

    String(this: &mut String, other: &String, start: u64, mut length: u64) {
        if other.data == null || start >= other.length || length == 0u64 {
            this.Allocate(0u64);
            ret;
        }

        if start + length > other.length {
            length = other.length - start;
        }

        this.Allocate(length);
        memcpy(this.data, (other.data + start), length);
    }

    String(this: &mut String, integer: i64) {
        this.FromInteger(integer, 10i32);
    }

    String(this: &mut String, float: f64) {
        this.FromFloat(float, 6i32);
    }

    ~String(this: &mut String) {
        this.Release();
    }

    pub Data(this: &String) -> *mut i8 { ret this.data; }
    pub Empty(this: &String) -> bool { ret this.length == 0u64; }
    pub Size(this: &String) -> u64 { ret this.length + 1u64; }

    priv Allocate(this: &mut String, length: u64) {
        (this.data, this.length) = (new i8[length + 1u64], length);
        this.data[length] = '\0';
    }

    priv Release(this: &mut String) {
        if this.data != null { del[] this.data; }
        (this.data, this.length) = (null, 0u64);
    }

    priv FromInteger(this: &mut String, value: i64, base: i32) {
        let digits: *const i8 = "0123456789ABCDEF";
        let mut n: i64 = value;
        let mut is_negative: bool = (n < 0i64 && base == 10i32);
        let mut size: u64 = 0u64;
        let mut temp_n: i64 = n;
        
        if temp_n == 0i64 {
            size = 1u64;
        } else {
            if is_negative {
                size += 1u64;
                temp_n = -temp_n;
            }

            while temp_n > 0i64 {
                size += 1u64;
                temp_n = temp_n / (base as i64);
            }
        }

        this.Allocate(size);

        if n == 0i64 {
            this.data[0u64] = 48i8;
        } else {
            let mut i: u64 = size;
            if n < 0i64 { n = -n; }
            
            while n > 0i64 {
                i -= 1u64;
                this.data[i] = digits[(n % (base as i64)) as u64];
                n = n / (base as i64);
            }

            if is_negative {
                this.data[0u64] = 45i8;
            }
        }
    }

    pub ToInteger(this: &String, base: i32) -> i64 {
        let mut result: i64 = 0i64;
        let mut sign: i64 = 1i64;
        let mut i: u64 = 0u64;

        if this.data[0u64] == 45i8 {
            sign = -1i64;
            i = 1u64;
        }

        while this.data[i] != 0i8 {
            let mut value: i64 = 0i64;
            let c: i8 = this.data[i];

            if c >= 48i8 && c <= 57i8 {
                value = (c - 48i8) as i64;
            } else if c >= 65i8 && c <= 70i8 {
                value = (c - 65i8 + 10i8) as i64;
            } else if c >= 97i8 && c <= 102i8 {
                value = (c - 97i8 + 10i8) as i64;
            } else {
                break;
            }

            if value >= (base as i64) { break; }
            result = result * (base as i64) + value;
            i += 1u64;
        } ret result * sign;
    }

    pub ToInteger(this: &String) -> i64 {
        ret this.ToInteger(10i32);
    }

    priv FromFloat(this: &mut String, value: f64, precision: i32) {
        let mut ipart: i64 = value as i64;
        let mut fpart: f64 = value - (ipart as f64);
        if fpart < 0.0f64 { fpart = -fpart; }

        let mut temp_str: String;
        temp_str.FromInteger(ipart, 10i32);
        let mut ipart_len: u64 = 0u64;
        while temp_str.data[ipart_len] != 0i8 { ipart_len += 1u64; }

        let total_size: u64 = ipart_len + 1u64 + (precision as u64);
        this.Allocate(total_size + 1u64);
        let mut i: u64 = 0u64;

        while i < ipart_len {
            this.data[i] = temp_str.data[i];
            i += 1u64;
        }

        this.data[i] = 46i8;
        i += 1u64;

        let mut p: i32 = 0i32;

        while p < precision {
            fpart = fpart * 10.0f64;
            let digit: i32 = fpart as i32;
            this.data[i] = (digit + 48i32) as i8;
            fpart = fpart - (digit as f64);
            i += 1u64;
            p += 1i32;
        }

        this.data[i] = 0i8;
    }

    pub ToFloat(this: &String) -> f64 {
        let mut res: f64 = 0.0f64;
        let mut sign: f64 = 1.0f64;
        let mut i: u64 = 0u64;

        if this.data[0u64] == 45i8 {
            sign = -1.0f64;
            i = 1u64;
        }

        while this.data[i] >= 48i8 && this.data[i] <= 57i8 {
            res = res * 10.0f64 + ((this.data[i] - 48i8) as f64);
            i += 1u64;
        }

        if this.data[i] == 46i8 {
            i += 1u64;
            let mut divisor: f64 = 10.0f64;

            while this.data[i] >= 48i8 && this.data[i] <= 57i8 {
                res = res + ((this.data[i] - 48i8) as f64) / divisor;
                divisor = divisor * 10.0f64;
                i += 1u64;
            }
        } ret res * sign;
    }

    pub Escape(this: &String) -> String {
        let mut result: String;
        let mut i: u64 = 0u64;

        while i < this.length {
            if this.data[i] == '\a' {
                result += "\\a";
            } else if this.data[i] == '\b' {
                result += "\\b";
            } else if this.data[i] == '\f' {
                result += "\\f";
            } else if this.data[i] == '\n' {
                result += "\\n";
            } else if this.data[i] == '\r' {
                result += "\\r";
            } else if this.data[i] == '\t' {
                result += "\\t";
            } else if this.data[i] == '\v' {
                result += "\\v";
            } else {
                result += this.data[i];
            } i += 1u64;
        } ret result;
    }

    pub Replace(this: &String, from: &String, to: &String) -> String {
        ret this.Replace(from.data, to.data, from.length);
    }

    pub Replace(this: &String, from: *const i8, to: &String) -> String {
        ret this.Replace(from, to.data, strlen(from));
    }

    pub Replace(this: &String, from: &String, to: *const i8) -> String {
        ret this.Replace(from.data, to, from.length);
    }

    pub Replace(this: &String, from: *const i8, to: *const i8) -> String {
        ret this.Replace(from, to, strlen(from));
    }

    priv Replace(this: &String, from: *const i8, to: *const i8, length: u64) -> String {
        let mut result: String;
        let mut i: u64 = 0u64;

        if length == 0u64 {
            result += this.data;
            ret result;
        }

        while i < this.length {
            let mut _match: bool = true;
            let mut j: u64 = 0u64;

            while j < length {
                if i + j >= this.length || this.data[i + j] != from[j] {
                    _match = false;
                    break;
                } else {
                    j += 1u64;
                }
            }

            if _match {
                result += to;
                i += length;
            } else {
                result += this.data[i];
                i += 1u64;
            }
        } ret result;
    }

    pub SubString(this: &String, start: u64) -> String {
        if start < this.length {
            ret String(this.data + start);
        } else {
            ret String("");
        }
    }

    pub SubString(this: &String, start: u64, mut length: u64) -> String {
        if start < this.length {
            let mut result: String;
            let mut i: u64 = 0u64;

            if start + length > this.length {
                length = this.length - start;
            }

            while i < length {
                result += this.data[start + i];
                i += 1u64;
            } ret result;
        } else {
            ret String("");
        }
    }

    pub Contains(this: &String, substring: &String) -> bool {
        ret this.Contains(substring.data, substring.length);
    }

    pub Contains(this: &String, substring: *const i8) -> bool {
        ret this.Contains(substring, strlen(substring));
    }

    priv Contains(this: &String, substring: *const i8, length: u64) -> bool {
        ret this.Find(substring, length) != -1i64;
    }

    pub Contains(this: &String, character: i8) -> bool {
        ret this.Find(character) != -1i64;
    }

    pub StartsWith(this: &String, prefix: &String) -> bool {
        ret this.StartsWith(prefix.data, prefix.length);
    }

    pub StartsWith(this: &String, prefix: *const i8) -> bool {
        ret this.StartsWith(prefix, strlen(prefix));
    }

    priv StartsWith(this: &String, prefix: *const i8, length: u64) -> bool {
        if prefix == null { ret false; }
        if length == 0u64 { ret true; }
        if length > this.length { ret false; }
        let mut i: u64 = 0u64;

        while i < length {
            if this.data[i] != prefix[i] {
                ret false;
            } else {
                i += 1u64;
            }
        } ret true;
    }

    pub EndsWith(this: &String, suffix: &String) -> bool {
        ret this.EndsWith(suffix.data, suffix.length);
    }

    pub EndsWith(this: &String, suffix: *const i8) -> bool {
        ret this.EndsWith(suffix, strlen(suffix));
    }

    priv EndsWith(this: &String, suffix: *const i8, length: u64) -> bool {
        if suffix == null { ret false; }
        if length == 0u64 { ret true; }
        if length > this.length { ret false; }
        let start: u64 = this.length - length;
        let mut i: u64 = 0u64;

        while i < length {
            if this.data[start + i] != suffix[i] {
                ret false;
            } else {
                i += 1u64;
            }
        } ret true;
    }

    pub Split(this: &String, delimiter: i8) -> Vector<String> {
        let mut current: String;
        let mut result: Vector<String>;
        let mut i: u64 = 0u64;

        while i < this.length {
            if this.data[i] != delimiter {
                current += this.data[i];
            } else {
                result.PushBack(current);
                current = "";
            } i += 1u64;
        }

        if current.Size() > 1u64 {
            result.PushBack(current);
        } ret result;
    }

    pub Split(this: &String, delimiter: &String) -> Vector<String> {
        ret this.Split(delimiter.data, delimiter.length);
    }

    pub Split(this: &String, delimiter: *const i8) -> Vector<String> {
        ret this.Split(delimiter, strlen(delimiter));
    }

    priv Split(this: &String, delimiter: *const i8, length: u64) -> Vector<String> {
        let mut result: Vector<String>;

        if length == 0u64 {
            result.PushBack(String(this.data));
            ret result;
        }

        if length == 1u64 {
            ret this.Split(delimiter[0u64]);
        }

        let mut current: String;
        let mut i: u64 = 0u64;

        while i < this.length {
            let mut found: bool = true;

            if i + length <= this.length {
                let mut j: u64 = 0u64;

                while j < length {
                    if this.data[i + j] != delimiter[j] {
                        found = false;
                        break;
                    } j += 1u64;
                }
            } else {
                found = false;
            }

            if found {
                result.PushBack(current);
                current = String("");
                i += length;
            } else {
                current += this.data[i];
                i += 1u64;
            }
        }

        if current.Size() > 1u64 {
            result.PushBack(current);
        } ret result;
    }

    pub Count(this: &String, substring: &String) -> u64 {
        ret this.Count(substring.data, substring.length);
    }

    pub Count(this: &String, substring: *const i8) -> u64 {
        ret this.Count(substring, strlen(substring));
    }

    priv Count(this: &String, substring: *const i8, length: u64) -> u64 {
        if substring == null { ret 0u64; }
        if length == 0u64 { ret 0u64; }
        if length > this.length { ret 0u64; }
        let mut count: u64 = 0u64;
        let mut i: u64 = 0u64;

        while i <= this.length - length {
            let mut found: bool = true;
            let mut j: u64 = 0u64;

            while j < length {
                if this.data[i + j] != substring[j] {
                    found = false;
                    break;
                } j += 1u64;
            }

            if found {
                count += 1u64;
                i += length;
            } else {
                i += 1u64;
            }
        } ret count;
    }

    pub Count(this: &String, character: i8) -> u64 {
        let mut count: u64 = 0u64;
        let mut i: u64 = 0u64;

        while i < this.length {
            if this.data[i] == character {
                count += 1u64;
            } i += 1u64;
        } ret count;
    }

    pub Find(this: &String, substring: &String) -> i64 {
        ret this.Find(substring.data, substring.length);
    }

    pub Find(this: &String, substring: *const i8) -> i64 {
        ret this.Find(substring, strlen(substring));
    }

    priv Find(this: &String, substring: *const i8, length: u64) -> i64 {
        if substring == null { ret -1i64; }
        if length == 0u64 { ret 0i64; }
        if length > this.length { ret -1i64; }
        let mut i: u64 = 0u64;

        while i <= this.length - length {
            let mut found: bool = true;
            let mut j: u64 = 0u64;

            while j < length {
                if this.data[i + j] != substring[j] {
                    found = false;
                    break;
                } j += 1u64;
            }

            if found {
                ret i as i64;
            } else {
                i += 1u64;
            }
        } ret -1i64;
    }

    pub Find(this: &String, character: i8) -> i64 {
        let mut i: u64 = 0u64;

        while i < this.length {
            if this.data[i] == character {
                ret i as i64;
            } else {
                i += 1u64;
            }
        } ret -1i64;
    }

    pub Trim(this: &String) -> String {
        let mut start: u64 = 0u64;

        while start < this.length && (this.data[start] == ' ' || this.data[start] == '\t') {
            start += 1u64;
        }

        let mut end: u64 = this.length;

        while end > start && (this.data[end - 1u64] == ' ' || this.data[end - 1u64] == '\t' || this.data[end - 1u64] == '\n' || this.data[end - 1u64] == '\r') {
            end -= 1u64;
        }

        ret this.SubString(start, end - start);
    }

    pub op=(this: &mut String, other: &String) -> &String {
        ret this.op=(other.data);
    }

    pub op=(this: &mut String, string: *const i8) -> &String {
        this.Release();

        if string == null {
            this.Allocate(0u64);
            ret this;
        }

        this.Allocate(strlen(string));
        memcpy(this.data, string, this.length);
        ret this;
    }

    pub op=(this: &mut String, character: i8) -> &String {
        this.Release();
        this.Allocate(1u64);
        this.data[0u64] = character;
        ret this;
    }

    pub op+=(this: &mut String, other: &String) -> &String {
        ret this.op+=(other.data);
    }

    pub op+=(this: &mut String, string: *const i8) -> &String {
        if string == null { ret this; }
        let string_length: u64 = strlen(string);
        let (data: *const i8, length: u64) = (this.data, this.length);
        this.Allocate(length + string_length);

        if data != null {
            memcpy(this.data, data, length);
            del[] data;
        }

        memcpy((this.data + length), string, string_length);
        ret this;
    }

    pub op+=(this: &mut String, character: i8) -> &String {
        let (data: *const i8, length: u64) = (this.data, this.length);
        this.Allocate(length + 1u64);

        if data != null {
            memcpy(this.data, data, length);
            del[] data;
        }

        this.data[length] = character;
        ret this;
    }

    pub op+(this: &String, other: &String) -> String {
        ret this.op+(other.data);
    }

    pub op+(this: &String, string: *const i8) -> String {
        let mut result: String = this.data;
        result += string;
        ret result;
    }

    pub op+(this: &String, character: i8) -> String {
        let mut result: String = this.data;
        result += character;
        ret result;
    }

    pub op*=(this: &mut String, count: u64) -> &String {
        if count <= 0u64 {
            this.Release();
            this.Allocate(0u64);
            ret this;
        } else {
            let temp: String = this.data;
            let mut i: u64 = 0u64;

            while i < count - 1u64 {
                this.op+=(temp.data);
                i += 1u64;
            } ret this;
        }
    }

    pub op*(this: &String, count: u64) -> String {
        let mut result: String = this.data;
        result *= count;
        ret result;
    }

    pub op==(this: &String, other: &String) -> bool {
        ret this.op==(other.data);
    }

    pub op==(this: &String, string: *const i8) -> bool {
        if this.length != strlen(string) { ret false; }
        if this.data == null || string == null { ret false; }
        let mut i: u64 = 0u64;

        while this.data[i] == string[i] {
            if this.data[i] == 0i8 {
                ret true;
            } i += 1u64;
        } ret false;
    }

    pub op==(this: &String, character: i8) -> bool {
        if this.length != 1u64 { ret false; }
        if this.data == null { ret false; }
        ret this.data[0u64] == character;
    }

    pub op!=(this: &String, other: &String) -> bool {
        ret !this.op==(other.data);
    }

    pub op!=(this: &String, string: *const i8) -> bool {
        ret !this.op==(string);
    }

    pub op!=(this: &String, character: i8) -> bool {
        ret !this.op==(character);
    }

    pub op[](this: &String, index: u64) -> &mut i8 {
        ret this.data[index];
    }
};