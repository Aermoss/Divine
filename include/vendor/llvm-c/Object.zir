#[include "vendor/llvm-c/Types.zir" : *]

struct LLVMOpaqueSectionIterator {}

type LLVMSectionIteratorRef = *mut LLVMOpaqueSectionIterator;

struct LLVMOpaqueSymbolIterator {}

type LLVMSymbolIteratorRef = *mut LLVMOpaqueSymbolIterator;

struct LLVMOpaqueRelocationIterator {}

type LLVMRelocationIteratorRef = *mut LLVMOpaqueRelocationIterator;

enum LLVMBinaryType: i32 {
    LLVMBinaryTypeArchive,
    LLVMBinaryTypeMachOUniversalBinary,
    LLVMBinaryTypeCOFFImportFile,
    LLVMBinaryTypeIR,
    LLVMBinaryTypeWinRes,
    LLVMBinaryTypeCOFF,
    LLVMBinaryTypeELF32L,
    LLVMBinaryTypeELF32B,
    LLVMBinaryTypeELF64L,
    LLVMBinaryTypeELF64B,
    LLVMBinaryTypeMachO32L,
    LLVMBinaryTypeMachO32B,
    LLVMBinaryTypeMachO64L,
    LLVMBinaryTypeMachO64B,
    LLVMBinaryTypeWasm,
    LLVMBinaryTypeOffload,
    LLVMBinaryTypeDXcontainer
}

struct LLVMOpaqueObjectFile {}

type LLVMObjectFileRef = *mut LLVMOpaqueObjectFile;

extern "C" {
    fn LLVMCreateBinary(MemBuf: LLVMMemoryBufferRef, Context: LLVMContextRef, ErrorMessage: *mut *mut i8) -> LLVMBinaryRef;
    fn LLVMDisposeBinary(BR: LLVMBinaryRef);
    fn LLVMBinaryCopyMemoryBuffer(BR: LLVMBinaryRef) -> LLVMMemoryBufferRef;
    fn LLVMBinaryGetType(BR: LLVMBinaryRef) -> LLVMBinaryType;
    fn LLVMMachOUniversalBinaryCopyObjectForArch(BR: LLVMBinaryRef, Arch: *i8, ArchLen: usize, ErrorMessage: *mut *mut i8) -> LLVMBinaryRef;
    fn LLVMObjectFileCopySectionIterator(BR: LLVMBinaryRef) -> LLVMSectionIteratorRef;
    fn LLVMObjectFileIsSectionIteratorAtEnd(BR: LLVMBinaryRef, SI: LLVMSectionIteratorRef) -> LLVMBool;
    fn LLVMObjectFileCopySymbolIterator(BR: LLVMBinaryRef) -> LLVMSymbolIteratorRef;
    fn LLVMObjectFileIsSymbolIteratorAtEnd(BR: LLVMBinaryRef, SI: LLVMSymbolIteratorRef) -> LLVMBool;
    fn LLVMDisposeSectionIterator(SI: LLVMSectionIteratorRef);
    fn LLVMMoveToNextSection(SI: LLVMSectionIteratorRef);
    fn LLVMMoveToContainingSection(Sect: LLVMSectionIteratorRef, Sym: LLVMSymbolIteratorRef);
    fn LLVMDisposeSymbolIterator(SI: LLVMSymbolIteratorRef);
    fn LLVMMoveToNextSymbol(SI: LLVMSymbolIteratorRef);
    fn LLVMGetSectionName(SI: LLVMSectionIteratorRef) -> *i8;
    fn LLVMGetSectionSize(SI: LLVMSectionIteratorRef) -> u64;
    fn LLVMGetSectionContents(SI: LLVMSectionIteratorRef) -> *i8;
    fn LLVMGetSectionAddress(SI: LLVMSectionIteratorRef) -> u64;
    fn LLVMGetSectionContainsSymbol(SI: LLVMSectionIteratorRef, Sym: LLVMSymbolIteratorRef) -> LLVMBool;
    fn LLVMGetRelocations(Section: LLVMSectionIteratorRef) -> LLVMRelocationIteratorRef;
    fn LLVMDisposeRelocationIterator(RI: LLVMRelocationIteratorRef);
    fn LLVMIsRelocationIteratorAtEnd(Section: LLVMSectionIteratorRef, RI: LLVMRelocationIteratorRef) -> LLVMBool;
    fn LLVMMoveToNextRelocation(RI: LLVMRelocationIteratorRef);
    fn LLVMGetSymbolName(SI: LLVMSymbolIteratorRef) -> *i8;
    fn LLVMGetSymbolAddress(SI: LLVMSymbolIteratorRef) -> u64;
    fn LLVMGetSymbolSize(SI: LLVMSymbolIteratorRef) -> u64;
    fn LLVMGetRelocationOffset(RI: LLVMRelocationIteratorRef) -> u64;
    fn LLVMGetRelocationSymbol(RI: LLVMRelocationIteratorRef) -> LLVMSymbolIteratorRef;
    fn LLVMGetRelocationType(RI: LLVMRelocationIteratorRef) -> u64;
    fn LLVMGetRelocationTypeName(RI: LLVMRelocationIteratorRef) -> *i8;
    fn LLVMGetRelocationValueString(RI: LLVMRelocationIteratorRef) -> *i8;
    fn LLVMCreateObjectFile(MemBuf: LLVMMemoryBufferRef) -> LLVMObjectFileRef;
    fn LLVMDisposeObjectFile(ObjectFile: LLVMObjectFileRef);
    fn LLVMGetSections(ObjectFile: LLVMObjectFileRef) -> LLVMSectionIteratorRef;
    fn LLVMIsSectionIteratorAtEnd(ObjectFile: LLVMObjectFileRef, SI: LLVMSectionIteratorRef) -> LLVMBool;
    fn LLVMGetSymbols(ObjectFile: LLVMObjectFileRef) -> LLVMSymbolIteratorRef;
    fn LLVMIsSymbolIteratorAtEnd(ObjectFile: LLVMObjectFileRef, SI: LLVMSymbolIteratorRef) -> LLVMBool;
}
