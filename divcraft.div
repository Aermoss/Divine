include "divglad", "divglfw", "divstb", "divpair", "divthrd", "divnoise", "divmath", "divfile", "divstr" : *;

func Lerp(a: f64, b: f64, t: f64) -> f64 {
    let value: f64 = a + (b - a) * t;
    if a < b && value > b { ret b; }
    else if a > b && value < b { ret b; }
    else { ret value; }
}

func ToRadians(degrees: f32) -> f32 {
    ret degrees * ((M_PI as f32) / 180.0f32);
}

func ToDegrees(radians: f32) -> f32 {
    ret radians * (180.0f32 / (M_PI as f32));
}

class Vector2 {
    pub x: f32,
    pub y: f32
} impl {
    Vector2(this: &mut Vector2) {
        (this.x, this.y) = (0.0f32, 0.0f32);
    }

    Vector2(this: &mut Vector2, value: f32) {
        (this.x, this.y) = (value, value);
    }

    Vector2(this: &mut Vector2, x: f32, y: f32) {
        (this.x, this.y) = (x, y);
    }

    pub ToString(this: &Vector2) -> String {
        let string[64u64]: i8;
        sprintf(string, "Vector2(%f, %f)", this.x as f64, this.y as f64);
        ret String(string);
    }

    pub Length(this: &Vector2) -> f32 {
        ret sqrtf(this.x * this.x + this.y * this.y);
    }

    pub Normalize(this: &Vector2) -> Vector2 {
        let length: f32 = this.Length();
        ret Vector2(this.x / length, this.y / length);
    }

    pub Absolute(this: &Vector2) -> Vector2 {
        ret Vector2(fabs(this.x as f64) as f32, fabs(this.y as f64) as f32);
    }

    pub Floor(this: &Vector2) -> Vector2 {
        ret Vector2(floorf(this.x), floorf(this.y));
    }

    pub Ceil(this: &Vector2) -> Vector2 {
        ret Vector2(ceilf(this.x), ceilf(this.y));
    }

    pub Round(this: &Vector2) -> Vector2 {
        ret Vector2(roundf(this.x), roundf(this.y));
    }

    pub op+(this: &Vector2, other: &Vector2) -> Vector2 {
        ret Vector2(this.x + other.x, this.y + other.y);
    }

    pub op+=(this: &mut Vector2, other: &Vector2) -> &Vector2 {
        this.x += other.x;
        this.y += other.y;
        ret this;
    }

    pub op-(this: &Vector2, other: &Vector2) -> Vector2 {
        ret Vector2(this.x - other.x, this.y - other.y);
    }

    pub op-=(this: &mut Vector2, other: &Vector2) -> &Vector2 {
        this.x -= other.x;
        this.y -= other.y;
        ret this;
    }

    pub op*(this: &Vector2, other: &Vector2) -> Vector2 {
        ret Vector2(this.x * other.x, this.y * other.y);
    }

    pub op*=(this: &mut Vector2, other: &Vector2) -> &Vector2 {
        this.x *= other.x;
        this.y *= other.y;
        ret this;
    }

    pub op*(this: &Vector2, scalar: f32) -> Vector2 {
        ret Vector2(this.x * scalar, this.y * scalar);
    }

    pub op*=(this: &mut Vector2, scalar: f32) -> &Vector2 {
        this.x *= scalar;
        this.y *= scalar;
        ret this;
    }

    pub op/(this: &Vector2, other: &Vector2) -> Vector2 {
        ret Vector2(this.x / other.x, this.y / other.y);
    }

    pub op/=(this: &mut Vector2, other: &Vector2) -> &Vector2 {
        this.x /= other.x;
        this.y /= other.y;
        ret this;
    }

    pub op/(this: &Vector2, scalar: f32) -> Vector2 {
        ret Vector2(this.x / scalar, this.y / scalar);
    }

    pub op/=(this: &mut Vector2, scalar: f32) -> &Vector2 {
        this.x /= scalar;
        this.y /= scalar;
        ret this;
    }

    pub op%(this: &Vector2, other: &Vector2) -> Vector2 {
        ret Vector2(this.x % other.x, this.y % other.y);
    }

    pub op%=(this: &mut Vector2, other: &Vector2) -> &Vector2 {
        this.x %= other.x;
        this.y %= other.y;
        ret this;
    }

    pub op%(this: &Vector2, scalar: f32) -> Vector2 {
        ret Vector2(this.x % scalar, this.y % scalar);
    }

    pub op%=(this: &mut Vector2, scalar: f32) -> &Vector2 {
        this.x %= scalar;
        this.y %= scalar;
        ret this;
    }

    pub op==(this: &Vector2, other: &Vector2) -> bool {
        ret this.x == other.x && this.y == other.y;
    }

    pub op!=(this: &Vector2, other: &Vector2) -> bool {
        ret this.x != other.x || this.y != other.y;
    }
};

class Vector3 {
    pub x: f32,
    pub y: f32,
    pub z: f32
} impl {
    Vector3(this: &mut Vector3) {
        (this.x, this.y, this.z) = (0.0f32, 0.0f32, 0.0f32);
    }

    Vector3(this: &mut Vector3, value: f32) {
        (this.x, this.y, this.z) = (value, value, value);
    }

    Vector3(this: &mut Vector3, x: f32, y: f32, z: f32) {
        (this.x, this.y, this.z) = (x, y, z);
    }

    pub ToString(this: &Vector3) -> String {
        let string[64u64]: i8;
        sprintf(string, "Vector3(%f, %f, %f)", this.x as f64, this.y as f64, this.z as f64);
        ret String(string);
    }

    pub Length(this: &Vector3) -> f32 {
        ret sqrtf(this.x * this.x + this.y * this.y + this.z * this.z);
    }

    pub Normalize(this: &Vector3) -> Vector3 {
        let length: f32 = this.Length();
        ret Vector3(this.x / length, this.y / length, this.z / length);
    }

    pub Absolute(this: &Vector3) -> Vector3 {
        ret Vector3(fabs(this.x as f64) as f32, fabs(this.y as f64) as f32, fabs(this.z as f64) as f32);
    }

    pub Floor(this: &Vector3) -> Vector3 {
        ret Vector3(floorf(this.x), floorf(this.y), floorf(this.z));
    }

    pub Ceil(this: &Vector3) -> Vector3 {
        ret Vector3(ceilf(this.x), ceilf(this.y), ceilf(this.z));
    }

    pub Round(this: &Vector3) -> Vector3 {
        ret Vector3(roundf(this.x), roundf(this.y), roundf(this.z));
    }

    pub op+(this: &Vector3, other: &Vector3) -> Vector3 {
        ret Vector3(this.x + other.x, this.y + other.y, this.z + other.z);
