const CLOCKS_PER_SEC: i32 = 1000000;

class tm {
    pub tm_sec: i32,
    pub tm_min: i32,
    pub tm_hour: i32,
    pub tm_mday: i32,
    pub tm_mon: i32,
    pub tm_year: i32,
    pub tm_wday: i32,
    pub tm_yday: i32,
    pub tm_isdst: i32
}

type time_t = i64;
type clock_t = i32;

extern "C" {
    fn time(timer: *mut time_t) -> time_t;
    fn difftime(time1: time_t, time0: time_t) -> f64;
    fn clock() -> clock_t;

    fn gmtime(timer: *time_t) -> *mut tm;
    fn localtime(timer: *time_t) -> *mut tm;
    fn asctime(timeptr: *tm) -> *mut i8;
    fn ctime(timer: *time_t) -> *mut i8;
    fn strftime(s: *mut i8, maxsize: i64, format: *i8, timeptr: *tm) -> i64;
}