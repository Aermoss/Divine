    fn GenerateTernary(&mut this, ternary: *TernaryNode) -> LLVMValueRef {

    }

    fn GenerateTypeApplication(&mut this, node: *TypeApplicationNode) -> LLVMValueRef {

    }

    fn GenerateStructureInitializer(&mut this, node: *StructureInitializerNode) -> LLVMValueRef {

    }
}
