#[include "std/map", "std/arena", "src/HIR.zir", "src/MIR.zir" : *]

class HIRLowerer {
    arena: Arena,
    namespaces: Vector<String>,
    strings: Map<String, *MIRStaticDeclaration>,
    variables: Map<*HIRVariableStatement, *mut MIRValue>,
    declarations: Map<*HIRDeclaration, *mut MIRDeclaration>,
    runtime_functions: Map<String, *MIRFunctionDeclaration>,
    break_blocks: Vector<*mut MIRBlock>,
    continue_blocks: Vector<*mut MIRBlock>,
    current_function: *mut MIRFunctionDeclaration = null,
    current_block: *mut MIRBlock = null,
    module: *mut MIRModule = null;

    HIRLowerer(&mut this) {}

    pub fn Lower(&mut this, module: *HIRModule) -> *MIRModule {
        this.module = this.arena.New<MIRModule>();
        this.LowerModule(module);
        return this.module;
    }

    fn LowerModule(&mut this, module: *HIRModule) {
        for declaration in module->declarations {
            this.LowerDeclarationFirstPass(declaration);
        }

        for declaration in module->declarations {
            this.LowerDeclarationSecondPass(declaration);
        }

        for declaration in module->declarations {
            this.LowerDeclarationThirdPass(declaration);
        }

        for declaration in module->declarations {
            this.LowerDeclarationFourthPass(declaration);
        }
    }

    fn LowerDeclarationFirstPass(&mut this, declaration: *HIRDeclaration) {
        if declaration->kind == HIRDeclarationKind::Class {
            this.LowerClassDeclarationFirstPass(declaration as *HIRClassDeclaration);
        } else if declaration->kind == HIRDeclarationKind::Structure {
            this.LowerStructureDeclarationFirstPass(declaration as *HIRStructureDeclaration);
        }
    }

    fn LowerDeclarationSecondPass(&mut this, declaration: *HIRDeclaration) {
        if declaration->kind == HIRDeclarationKind::Constant {
            this.LowerConstant(declaration as *HIRConstantDeclaration);
        } else if declaration->kind == HIRDeclarationKind::Class {
            this.LowerClassDeclarationSecondPass(declaration as *HIRClassDeclaration);
        } else if declaration->kind == HIRDeclarationKind::Structure {
            this.LowerStructureDeclarationSecondPass(declaration as *HIRStructureDeclaration);
        }
    }

    fn LowerDeclarationThirdPass(&mut this, declaration: *HIRDeclaration) {
        if declaration->kind == HIRDeclarationKind::Static {
            this.LowerStaticDeclaration(declaration as *HIRStaticDeclaration);
        } else if declaration->kind == HIRDeclarationKind::Class {
            this.LowerClassDeclarationThirdPass(declaration as *HIRClassDeclaration);
        } else if declaration->kind == HIRDeclarationKind::Structure {
            this.LowerStructureDeclarationThirdPass(declaration as *HIRStructureDeclaration);
        } else if declaration->kind == HIRDeclarationKind::Function {
            this.LowerFunctionFirstPass(declaration as *HIRFunctionDeclaration);
        }
    }

    fn LowerDeclarationFourthPass(&mut this, declaration: *HIRDeclaration) {
        if declaration->kind == HIRDeclarationKind::Structure {
            this.LowerStructureFourthPass(declaration as *HIRStructureDeclaration);
        } else if declaration->kind == HIRDeclarationKind::Class {
            this.LowerClassFourthPass(declaration as *HIRClassDeclaration);
        } else if declaration->kind == HIRDeclarationKind::Function {
            this.LowerFunctionSecondPass(declaration as *HIRFunctionDeclaration);
        }
    }

    fn LowerConstant(&mut this, constant: *HIRConstantDeclaration) {
        let declaration = constant as *HIRDeclaration;
        let initializer = this.LowerConstantExpression(constant->initializer);
        if initializer == null { return; }

        let lowered = this.arena.New<MIRConstantDeclaration>(declaration->name, declaration->_type, initializer);
        this.module->declarations.PushBack(lowered);
        this.declarations[declaration] = lowered;
    }

    fn LowerLinkage(&this, linkage: HIRDeclarationLinkage) -> MIRDeclarationLinkage {
        if linkage == HIRDeclarationLinkage::Internal {
            return MIRDeclarationLinkage::Internal;
        } else {
            return MIRDeclarationLinkage::External;
        }
    }

    fn LowerStaticDeclaration(&mut this, _static: *HIRStaticDeclaration) {
        let declaration = _static as *HIRDeclaration;
        let mut initializer: *MIRValue = null;

        if _static->initializer != null {
            initializer = this.LowerConstantExpression(_static->initializer);
            if initializer == null { return; }
        }

        let lowered = this.arena.New<MIRStaticDeclaration>(declaration->name, declaration->_type, _static->mutable, initializer, this.LowerLinkage(declaration->linkage));
        this.module->declarations.PushBack(lowered as *MIRLinkableDeclaration);
        this.declarations[declaration] = lowered as *mut MIRLinkableDeclaration;
    }

    fn LowerFunctionFirstPass(&mut this, function: *HIRFunctionDeclaration) {
        let declaration = function as *HIRDeclaration;
        let mut name = declaration->name;

        if declaration->abi == HIRDeclarationABI::Native && !function->no_mangle {
            name = Mangler::MangleFunction(name, declaration->_type, Vector<*SemanticType>(), this.namespaces);
        }

        let lowered = this.arena.New<MIRFunctionDeclaration>(name, declaration->_type, this.LowerLinkage(declaration->linkage));
        this.module->declarations.PushBack(lowered as *MIRLinkableDeclaration);
        this.declarations[declaration] = lowered as *mut MIRLinkableDeclaration;

        for i in 0..function->parameters.Size() {
            let parameter: *HIRParameterDeclaration = function->parameters[i];
            let parameter_declaration = parameter as *HIRDeclaration;
            let lowered_parameter = this.arena.New<MIRParameter>(parameter_declaration->name, i as u32, parameter_declaration->_type);
            lowered->parameters.PushBack(lowered_parameter);
        }
    }

    fn LowerFunctionSecondPass(&mut this, function: *HIRFunctionDeclaration) {
        if function->body == null { return; }
        let declaration = function as *HIRDeclaration;
        let lowered_declaration: *mut MIRDeclaration = this.declarations[declaration];
        this.current_function = (lowered_declaration as *mut MIRLinkableDeclaration) as *mut MIRFunctionDeclaration;
        this.current_block = this.arena.New<MIRBlock>("entry".ToString());
        this.current_function->blocks.PushBack(this.current_block);
        this.LowerBlockStatement(function->body);
    }

    fn LowerClassDeclarationFirstPass(&mut this, _class: *HIRClassDeclaration) {
        let declaration = _class as *HIRDeclaration;
        let lowered = this.arena.New<MIRTypeDeclaration>(declaration->name, declaration->_type);
        this.module->declarations.PushBack(lowered);
        this.declarations[declaration] = lowered;
        lowered->types = _class->fields;
    }

    fn LowerClassDeclarationSecondPass(&mut this, _class: *HIRClassDeclaration) {}

    fn LowerClassDeclarationThirdPass(&mut this, _class: *HIRClassDeclaration) {
        this.namespaces.PushBack((_class as *HIRDeclaration)->name);

        for constructor in _class->constructors {
            this.LowerFunctionFirstPass(constructor);
        }

        if _class->destructor != null {
            this.LowerFunctionFirstPass(_class->destructor);
        }

        for method in _class->methods {
            this.LowerFunctionFirstPass(method);
        }

        this.namespaces.PopBack();
    }

    fn LowerClassFourthPass(&mut this, _class: *HIRClassDeclaration) {
        for constructor in _class->constructors {
            this.LowerFunctionSecondPass(constructor);
        }

        if _class->destructor != null {
            this.LowerFunctionSecondPass(_class->destructor);
        }

        for method in _class->methods {
            this.LowerFunctionSecondPass(method);
        }
    }

    fn LowerStructureDeclarationFirstPass(&mut this, structure: *HIRStructureDeclaration) {
        let declaration = structure as *HIRDeclaration;
        let lowered = this.arena.New<MIRTypeDeclaration>(declaration->name, declaration->_type);
        this.module->declarations.PushBack(lowered);
        this.declarations[declaration] = lowered;
        lowered->types = structure->fields;
    }

    fn LowerStructureDeclarationSecondPass(&mut this, structure: *HIRStructureDeclaration) {}

    fn LowerStructureDeclarationThirdPass(&mut this, structure: *HIRStructureDeclaration) {
        this.namespaces.PushBack((structure as *HIRDeclaration)->name);

        for method in structure->methods {
            this.LowerFunctionFirstPass(method);
        }

        this.namespaces.PopBack();
    }

    fn LowerStructureFourthPass(&mut this, structure: *HIRStructureDeclaration) {
        for method in structure->methods {
            this.LowerFunctionSecondPass(method);
        }
    }

    fn LowerStatement(&mut this, statement: *HIRStatement) {
        if statement->kind == HIRStatementKind::Block {
            this.LowerBlockStatement(statement as *HIRBlockStatement);
        } else if statement->kind == HIRStatementKind::Return {
            this.LowerReturnStatement(statement as *HIRReturnStatement);
        } else if statement->kind == HIRStatementKind::Variable {
            this.LowerVariableStatement(statement as *HIRVariableStatement);
        } else if statement->kind == HIRStatementKind::Expression {
            this.LowerExpression((statement as *HIRExpressionStatement)->expression);
        } else if statement->kind == HIRStatementKind::If {
            this.LowerIfStatement(statement as *HIRIfStatement);
        } else if statement->kind == HIRStatementKind::While {
            this.LowerWhileStatement(statement as *HIRWhileStatement);
        } else if statement->kind == HIRStatementKind::Loop {
            this.LowerLoopStatement(statement as *HIRLoopStatement);
        } else if statement->kind == HIRStatementKind::For {
            this.LowerForStatement(statement as *HIRForStatement);
        } else if statement->kind == HIRStatementKind::Break {
            this.LowerBreakStatement(statement as *HIRBreakStatement);
        } else if statement->kind == HIRStatementKind::Continue {
            this.LowerContinueStatement(statement as *HIRContinueStatement);
        }
    }

    fn LowerBlockStatement(&mut this, block: *HIRBlockStatement) {
        for statement in block->statements {
            if this.current_block->terminator != null { break; }
            this.LowerStatement(statement);
        }
    }

    fn LowerReturnStatement(&mut this, _return: *HIRReturnStatement) {
        let mut value: *MIRValue = null;

        if _return->expression != null {
            value = this.LowerExpression(_return->expression);
            if value == null { return; }
        }

        this.current_block->terminator = this.arena.New<MIRReturnInstruction>(value);
    }

    fn LowerVariableStatement(&mut this, variable: *HIRVariableStatement) {
        let alloca = this.arena.New<MIRAllocaInstruction>(variable->name, variable->_type);
        this.variables[variable] = (alloca as *mut MIRInstruction) as *mut MIRValue;
        this.current_block->instructions.PushBack(alloca);

        if variable->initializer != null {
            let value = this.LowerExpression(variable->initializer);
            if value == null { return; }
            let store = this.arena.New<MIRStoreInstruction>(alloca as *MIRInstruction, value);
            this.current_block->instructions.PushBack(store);
        }
    }

    fn LowerIfStatement(&mut this, _if: *HIRIfStatement) {
        let condition = this.LowerExpression(_if->condition);
        if condition == null { return; }

        let then_block = this.arena.New<MIRBlock>("if.then".ToString());
        let merge_block = this.arena.New<MIRBlock>("if.merge".ToString());

        if _if->else_body == null {
            this.current_block->terminator = this.arena.New<MIRConditionalBranchInstruction>(condition, then_block, merge_block);
        } else {
            let else_block = this.arena.New<MIRBlock>("if.else".ToString());
            this.current_block->terminator = this.arena.New<MIRConditionalBranchInstruction>(condition, then_block, else_block);
            this.current_block = else_block;
            this.current_function->blocks.PushBack(else_block);
            this.LowerBlockStatement(_if->else_body);

            if this.current_block->terminator == null {
                this.current_block->terminator = this.arena.New<MIRBranchInstruction>(merge_block);
            }
        }

        this.current_block = then_block;
        this.current_function->blocks.PushBack(then_block);
        this.LowerBlockStatement(_if->then_body);

        if this.current_block->terminator == null {
            this.current_block->terminator = this.arena.New<MIRBranchInstruction>(merge_block);
        }

        this.current_function->blocks.PushBack(merge_block);
        this.current_block = merge_block;
    }

    fn LowerWhileStatement(&mut this, _while: *HIRWhileStatement) {
        let condition_block = this.arena.New<MIRBlock>("while.cond".ToString());
        let body_block = this.arena.New<MIRBlock>("while.body".ToString());
        let end_block = this.arena.New<MIRBlock>("while.end".ToString());
        this.current_block->terminator = this.arena.New<MIRBranchInstruction>(condition_block);

        this.current_block = condition_block;
        this.current_function->blocks.PushBack(condition_block);
        let condition = this.LowerExpression(_while->condition);
        if condition == null { return; }
        this.current_block->terminator = this.arena.New<MIRConditionalBranchInstruction>(condition, body_block, end_block);

        this.current_block = body_block;
        this.current_function->blocks.PushBack(body_block);
        this.break_blocks.PushBack(end_block);
        this.continue_blocks.PushBack(condition_block);
        this.LowerBlockStatement(_while->while_body);
        this.continue_blocks.PopBack();
        this.break_blocks.PopBack();

        if this.current_block->terminator == null {
            this.current_block->terminator = this.arena.New<MIRBranchInstruction>(condition_block);
        }

        this.current_function->blocks.PushBack(end_block);
        this.current_block = end_block;
    }

    fn LowerLoopStatement(&mut this, _loop: *HIRLoopStatement) {
        let body_block = this.arena.New<MIRBlock>("loop.body".ToString());
        let end_block = this.arena.New<MIRBlock>("loop.end".ToString());
        this.current_block->terminator = this.arena.New<MIRBranchInstruction>(body_block);

        this.current_block = body_block;
        this.current_function->blocks.PushBack(body_block);
        this.break_blocks.PushBack(end_block);
        this.continue_blocks.PushBack(body_block);
        this.LowerBlockStatement(_loop->body);
        this.continue_blocks.PopBack();
        this.break_blocks.PopBack();

        if this.current_block->terminator == null {
            this.current_block->terminator = this.arena.New<MIRBranchInstruction>(body_block);
        }

        this.current_function->blocks.PushBack(end_block);
        this.current_block = end_block;
    }

    fn LowerForStatement(&mut this, _for: *HIRForStatement) {
        this.LowerVariableStatement(_for->iterator);
        let alloca = this.arena.New<MIRAllocaInstruction>(_for->variable->name, _for->variable->_type);
        this.variables[_for->variable] = (alloca as *mut MIRInstruction) as *mut MIRValue;
        this.current_block->instructions.PushBack(alloca);

        let condition_block = this.arena.New<MIRBlock>("for.cond".ToString());
        let body_block = this.arena.New<MIRBlock>("for.body".ToString());
        let step_block = this.arena.New<MIRBlock>("for.step".ToString());
        let end_block = this.arena.New<MIRBlock>("for.end".ToString());
        this.current_block->terminator = this.arena.New<MIRBranchInstruction>(condition_block);

        this.current_block = condition_block;
        this.current_function->blocks.PushBack(condition_block);
        let condition = this.LowerExpression(_for->condition);
        if condition == null { return; }
        this.current_block->terminator = this.arena.New<MIRConditionalBranchInstruction>(condition, body_block, end_block);

        this.current_block = body_block;
        this.current_function->blocks.PushBack(body_block);
        let value = this.LowerExpression(_for->variable->initializer);
        if value == null { return; }
        let store = this.arena.New<MIRStoreInstruction>(alloca as *MIRInstruction, value);
        this.current_block->instructions.PushBack(store);

        this.break_blocks.PushBack(end_block);
        this.continue_blocks.PushBack(step_block);
        this.LowerBlockStatement(_for->body);
        this.continue_blocks.PopBack();
        this.break_blocks.PopBack();

        if this.current_block->terminator == null {
            this.current_block->terminator = this.arena.New<MIRBranchInstruction>(step_block);
        }

        this.current_block = step_block;
        this.current_function->blocks.PushBack(step_block);
        this.LowerExpression(_for->step);

        if this.current_block->terminator == null {
            this.current_block->terminator = this.arena.New<MIRBranchInstruction>(condition_block);
        }

        this.current_function->blocks.PushBack(end_block);
        this.current_block = end_block;
    }

    fn LowerBreakStatement(&mut this, _break: *HIRBreakStatement) {
        if !this.break_blocks.Empty() {
            this.current_block->terminator = this.arena.New<MIRBranchInstruction>(this.break_blocks.Back());
        }
    }

    fn LowerContinueStatement(&mut this, _continue: *HIRContinueStatement) {
        if !this.continue_blocks.Empty() {
            this.current_block->terminator = this.arena.New<MIRBranchInstruction>(this.continue_blocks.Back());
        }
    }

    fn LowerConstantExpression(&mut this, expression: *HIRExpression) -> *MIRValue {
        if expression->kind == HIRExpressionKind::StringLiteral {
            return this.arena.New<MIRConstantString>((expression as *HIRStringLiteral)->value, expression->_type) as *MIRConstant;
        } else {
            return this.LowerExpression(expression);
        }
    }

    fn LowerPlaceExpression(&mut this, expression: *HIRExpression) -> *MIRValue {
        if expression->kind == HIRExpressionKind::VariableReference {
            let variable = (expression as *HIRVariableReference)->variable;

            if this.variables.Has(variable) {
                return this.variables[variable];
            } return null;
        } else if expression->kind == HIRExpressionKind::DeclarationReference {
            let declaration = (expression as *HIRDeclarationReference)->declaration;

            if this.declarations.Has(declaration) {
                return this.arena.New<MIRGlobalRef>(this.declarations[declaration]);
            } return null;
        } else if expression->kind == HIRExpressionKind::Temporary {
            let alloca = this.arena.New<MIRAllocaInstruction>("temporary".ToString(), expression->_type);
            this.current_block->instructions.PushBack(alloca);
            let initializer = this.LowerExpression((expression as *HIRTemporaryExpression)->initializer);
            if initializer == null { return null; }
            this.current_block->instructions.PushBack(this.arena.New<MIRStoreInstruction>(alloca as *MIRInstruction, initializer));
            return alloca as *MIRInstruction;
        } else if expression->kind == HIRExpressionKind::MemberAccess {
            return this.LowerMemberAccessExpression(expression as *HIRMemberAccessExpression);
        } else if expression->kind == HIRExpressionKind::Dereference {
            return this.LowerExpression((expression as *HIRDereferenceExpression)->operand);
        } else {
            return null;
        }
    }

    fn LowerExpression(&mut this, expression: *HIRExpression) -> *MIRValue {
        if expression->kind == HIRExpressionKind::BooleanLiteral {
            return this.arena.New<MIRConstantBoolean>((expression as *HIRBooleanLiteral)->value, expression->_type) as *MIRConstant;
        } else if expression->kind == HIRExpressionKind::CharacterLiteral {
            return this.arena.New<MIRConstantCharacter>((expression as *HIRCharacterLiteral)->value, expression->_type) as *MIRConstant;
        } else if expression->kind == HIRExpressionKind::IntegerLiteral {
            return this.arena.New<MIRConstantInteger>((expression as *HIRIntegerLiteral)->value, expression->_type) as *MIRConstant;
        } else if expression->kind == HIRExpressionKind::FloatLiteral {
            return this.arena.New<MIRConstantFloat>((expression as *HIRFloatLiteral)->value, expression->_type) as *MIRConstant;
        } else if expression->kind == HIRExpressionKind::StringLiteral {
            let value = (expression as *HIRStringLiteral)->value;
            let mut _static: *MIRStaticDeclaration = null;

            if this.strings.Has(value) {
                _static = this.strings[value];
            } else {
                let name = "string." + String::FromInteger(this.strings.Size() as u64);
                let initializer = this.arena.New<MIRConstantString>(value, expression->_type);
                let _type = analyzer->type_manager.Array(analyzer->type_manager.Integer(8, false), value->Length() + 1);
                _static = this.arena.New<MIRStaticDeclaration>(name, _type, false, initializer as *MIRConstant, MIRDeclarationLinkage::Internal);
                this.module->declarations.PushBack(_static as *MIRLinkableDeclaration);
                this.strings[value] = _static;
            }

            return this.arena.New<MIRGlobalRef>(_static as *MIRLinkableDeclaration);
        } else if expression->kind == HIRExpressionKind::NullLiteral {
            return this.arena.New<MIRConstantNull>(expression->_type) as *MIRConstant;
        } else if expression->kind == HIRExpressionKind::Intrinsic {
            return this.LowerIntrinsic(expression as *HIRIntrinsicExpression);
        } else if expression->kind == HIRExpressionKind::Assignment {
            return this.LowerAssignmentExpression(expression as *HIRAssignmentExpression);
        } else if expression->kind == HIRExpressionKind::Call {
            return this.LowerCallExpression(expression as *HIRCallExpression);
        } else if expression->kind == HIRExpressionKind::New {
            return this.LowerNewExpression(expression as *HIRNewExpression);
        } else if expression->kind == HIRExpressionKind::Delete {
            return this.LowerDeleteExpression(expression as *HIRDeleteExpression);
        } else if expression->kind == HIRExpressionKind::Cast {
            return this.LowerCastExpression(expression as *HIRCastExpression);
        } else if expression->kind == HIRExpressionKind::IndexAccess {
            return this.LowerIndexAccessExpression(expression as *HIRIndexAccessExpression);
        } else if expression->kind == HIRExpressionKind::Unary {
            return this.LowerUnaryExpression(expression as *HIRUnaryExpression);
        } else if expression->kind == HIRExpressionKind::Binary {
            return this.LowerBinaryExpression(expression as *HIRBinaryExpression);
        } else if expression->kind == HIRExpressionKind::Ternary {
            return this.LowerTernaryExpression(expression as *HIRTernaryExpression);
        } else if expression->kind == HIRExpressionKind::AddressOf {
            return this.LowerPlaceExpression((expression as *HIRAddressOfExpression)->operand);
        } else {
            let place = this.LowerPlaceExpression(expression);
            if place == null { return null; }
            if place->_type->IsFunction() { return place; }
            let load = this.arena.New<MIRLoadInstruction>("load".ToString(), place);
            this.current_block->instructions.PushBack(load);
            return load as *MIRInstruction;
        }
    }

    fn LowerIntrinsic(&mut this, intrinsic: *HIRIntrinsicExpression) -> *MIRValue {
        let value = intrinsic->kind == HIRIntrinsicKind::SizeOf ? intrinsic->_type->Size() : intrinsic->_type->Alignment();
        return this.arena.New<MIRConstantInteger>(value as u64, (intrinsic as *HIRExpression)->_type) as *MIRConstant;
    }

    fn LowerAssignmentExpression(&mut this, assignment: *HIRAssignmentExpression) -> *MIRValue {
        let place = this.LowerPlaceExpression(assignment->left);
        let value = this.LowerExpression(assignment->right);
        if place == null || value == null { return null; }
        let store = this.arena.New<MIRStoreInstruction>(place as *MIRInstruction, value);
        this.current_block->instructions.PushBack(store);
        return value;
    }

    fn LowerCallExpression(&mut this, call: *HIRCallExpression) -> *MIRValue {
        let callee = this.LowerExpression(call->function);
        if callee == null { return null; }
        let mut arguments = Vector<*MIRValue>();

        for argument in call->arguments {
            let lowered = this.LowerExpression(argument);
            if lowered == null { return null; }
            arguments.PushBack(lowered);
        }

        let lowered = this.arena.New<MIRCallInstruction>("call".ToString(), callee, arguments);
        this.current_block->instructions.PushBack(lowered);
        return lowered as *MIRInstruction;
    }

    fn LowerRuntimeFunction(&mut this, name: String, _type: *SemanticType) -> *MIRFunctionDeclaration {
        for declaration in this.module->declarations {
            if declaration->kind == MIRDeclarationKind::Function && declaration->name == name {
                return (declaration as *MIRLinkableDeclaration) as *MIRFunctionDeclaration;
            }
        }

        if this.runtime_functions.Has(name) {
            return this.runtime_functions[name];
        }

        let parameters = _type->Parameters();
        let function = this.arena.New<MIRFunctionDeclaration>(name, _type, MIRDeclarationLinkage::External);
        this.module->declarations.PushBack(function as *MIRLinkableDeclaration);
        this.runtime_functions[name] = function;

        for i in 0..parameters.Size() {
            let parameter: *SemanticType = parameters[i];
            let lowered_parameter = this.arena.New<MIRParameter>("".ToString(), i as u32, parameter);
            function->parameters.PushBack(lowered_parameter);
        } return function;
    }

    fn LowerNewExpression(&mut this, _new: *HIRNewExpression) -> *MIRValue {
        let mut parameters = Vector<*SemanticType>();
        let size_type = analyzer->type_manager.IntegerPointer(false);
        parameters.PushBack(size_type);
        let malloc = this.LowerRuntimeFunction("malloc".ToString(), analyzer->type_manager.Function(parameters, analyzer->type_manager.Pointer(analyzer->type_manager.Void(), true)));
        let mut allocation_size = (this.arena.New<MIRConstantInteger>(_new->_type->Size() as u64, size_type) as *MIRConstant) as *MIRValue;

        if _new->size != null {
            let size = this.LowerExpression(_new->size);
            if size == null { return null; }
            let total_size = this.arena.New<MIRBinaryInstruction>("new.size".ToString(), MIRBinaryKind::Mul, size, allocation_size, size_type);
            this.current_block->instructions.PushBack(total_size);
            allocation_size = total_size as *MIRInstruction;
        }

        let mut arguments = Vector<*MIRValue>();
        arguments.PushBack(allocation_size);
        let call = this.arena.New<MIRCallInstruction>("new".ToString(), this.arena.New<MIRGlobalRef>(malloc as *MIRLinkableDeclaration), arguments);
        this.current_block->instructions.PushBack(call);
        return call as *MIRInstruction;
    }

    fn LowerDeleteExpression(&mut this, _delete: *HIRDeleteExpression) -> *MIRValue {
        let pointer = this.LowerExpression(_delete->value);
        if pointer == null { return null; }
        let mut parameters = Vector<*SemanticType>();
        parameters.PushBack(analyzer->type_manager.Pointer(analyzer->type_manager.Void(), true));
        let free = this.LowerRuntimeFunction("free".ToString(), analyzer->type_manager.Function(parameters, analyzer->type_manager.Void()));
        let mut arguments = Vector<*MIRValue>();
        arguments.PushBack(pointer);
        let call = this.arena.New<MIRCallInstruction>("delete".ToString(), this.arena.New<MIRGlobalRef>(free as *MIRLinkableDeclaration), arguments);
        this.current_block->instructions.PushBack(call);
        return null;
    }

    fn LowerCastExpression(&mut this, cast: *HIRCastExpression) -> *MIRValue {
        let mut lowered: *MIRInstruction = null;
        let expression = cast as *HIRExpression;
        let target_type = expression->_type;

        let value_type = cast->value->_type;
        let mut value = this.LowerExpression(cast->value);
        if value == null { return null; }

        if value_type->IsBoolean() {
            if target_type->IsInteger() {
                let cast = this.arena.New<MIRCastInstruction>("cast".ToString(), MIRCastKind::ZExt, value, target_type);
                this.current_block->instructions.PushBack(cast);
                return cast as *MIRInstruction;
            }
        } else if value_type->IsCharacter() {
            if target_type->IsInteger() {
                if value_type->Width() < target_type->Width() {
                    let cast = this.arena.New<MIRCastInstruction>("cast".ToString(), MIRCastKind::ZExt, value, target_type);
                    this.current_block->instructions.PushBack(cast);
                    return cast as *MIRInstruction;
                } else if value_type->Width() > target_type->Width() {
                    let cast = this.arena.New<MIRCastInstruction>("cast".ToString(), MIRCastKind::Trunc, value, target_type);
                    this.current_block->instructions.PushBack(cast);
                    return cast as *MIRInstruction;
                }
            }
        } else if value_type->IsInteger() {
            if target_type->IsCharacter() {
                if value_type->Width() == 8 && !value_type->IsSigned() {
                    let cast = this.arena.New<MIRCastInstruction>("cast".ToString(), MIRCastKind::ZExt, value, target_type);
                    this.current_block->instructions.PushBack(cast);
                    return cast as *MIRInstruction;
                }
            }

            if target_type->IsInteger() || target_type->IsEnumeration() {
                if value_type->Width() < target_type->Width() {
                    if value_type->IsSigned() {
                        let cast = this.arena.New<MIRCastInstruction>("cast".ToString(), MIRCastKind::SExt, value, target_type);
                        this.current_block->instructions.PushBack(cast);
                        return cast as *MIRInstruction;
                    } else {
                        let cast = this.arena.New<MIRCastInstruction>("cast".ToString(), MIRCastKind::ZExt, value, target_type);
                        this.current_block->instructions.PushBack(cast);
                        return cast as *MIRInstruction;
                    }
                } else if value_type->Width() > target_type->Width() {
                    let cast = this.arena.New<MIRCastInstruction>("cast".ToString(), MIRCastKind::Trunc, value, target_type);
                    this.current_block->instructions.PushBack(cast);
                    return cast as *MIRInstruction;
                }
            }

            if target_type->IsFloat() {
                if value_type->IsSigned() {
                    let cast = this.arena.New<MIRCastInstruction>("cast".ToString(), MIRCastKind::SIToFP, value, target_type);
                    this.current_block->instructions.PushBack(cast);
                    return cast as *MIRInstruction;
                } else {
                    let cast = this.arena.New<MIRCastInstruction>("cast".ToString(), MIRCastKind::UIToFP, value, target_type);
                    this.current_block->instructions.PushBack(cast);
                    return cast as *MIRInstruction;
                }
            }

            if target_type->IsPointer() {
                let cast = this.arena.New<MIRCastInstruction>("cast".ToString(), MIRCastKind::IntToPtr, value, target_type);
                this.current_block->instructions.PushBack(cast);
                return cast as *MIRInstruction;
            }
        } else if value_type->IsFloat() {
            if target_type->IsInteger() {
                if target_type->IsSigned() {
                    let cast = this.arena.New<MIRCastInstruction>("cast".ToString(), MIRCastKind::FPToSI, value, target_type);
                    this.current_block->instructions.PushBack(cast);
                    return cast as *MIRInstruction;
                } else {
                    let cast = this.arena.New<MIRCastInstruction>("cast".ToString(), MIRCastKind::FPToUI, value, target_type);
                    this.current_block->instructions.PushBack(cast);
                    return cast as *MIRInstruction;
                }
            }

            if target_type->IsFloat() {
                if value_type->Width() < target_type->Width() {
                    let cast = this.arena.New<MIRCastInstruction>("cast".ToString(), MIRCastKind::FPExt, value, target_type);
                    this.current_block->instructions.PushBack(cast);
                    return cast as *MIRInstruction;
                } else if value_type->Width() > target_type->Width() {
                    let cast = this.arena.New<MIRCastInstruction>("cast".ToString(), MIRCastKind::FPTrunc, value, target_type);
                    this.current_block->instructions.PushBack(cast);
                    return cast as *MIRInstruction;
                }
            }
        } else if value_type->IsPointer() {
            if target_type->IsInteger() {
                let cast = this.arena.New<MIRCastInstruction>("cast".ToString(), MIRCastKind::PtrToInt, value, target_type);
                this.current_block->instructions.PushBack(cast);
                return cast as *MIRInstruction;
            }

            if target_type->IsPointer() {
                if value_type->Pointee().IsClass() && target_type->Pointee().IsClass() {
                    let (source_class, target_class) = (value_type->Pointee(), target_type->Pointee());
                    let (source_fields, target_fields) = (source_class->Fields(), target_class->Fields());
                    let (mut related, mut index: u32) = (false, 0);

                    for i in 0..source_fields.Size() {
                        if source_fields[i].left == target_class->name {
                            (related, index) = (true, i as u32);
                            break;
                        }
                    }

                    if !related {
                        for i in 0..target_fields.Size() {
                            if target_fields[i].left == source_class->name {
                                (related, index) = (true, -(i as isize) as u32);
                                break;
                            }
                        }
                    }

                    if index != 0 {
                        let gep = this.arena.New<MIRStructGEPInstruction>("cast.base".ToString(), value, index, target_type);
                        this.current_block->instructions.PushBack(gep);
                        value = gep as *MIRInstruction;
                    } else if !related {
                        return null;
                    }
                }

                let cast = this.arena.New<MIRCastInstruction>("cast".ToString(), MIRCastKind::Bitcast, value, target_type);
                this.current_block->instructions.PushBack(cast);
                return cast as *MIRInstruction;
            }
        } else if value_type->IsEnumeration() {
            if target_type->IsInteger() {
                if value_type->Width() < target_type->Width() {
                    if value_type->IsSigned() {
                        let cast = this.arena.New<MIRCastInstruction>("cast".ToString(), MIRCastKind::SExt, value, target_type);
                        this.current_block->instructions.PushBack(cast);
                        return cast as *MIRInstruction;
                    } else {
                        let cast = this.arena.New<MIRCastInstruction>("cast".ToString(), MIRCastKind::ZExt, value, target_type);
                        this.current_block->instructions.PushBack(cast);
                        return cast as *MIRInstruction;
                    }
                } else if value_type->Width() > target_type->Width() {
                    let cast = this.arena.New<MIRCastInstruction>("cast".ToString(), MIRCastKind::Trunc, value, target_type);
                    this.current_block->instructions.PushBack(cast);
                    return cast as *MIRInstruction;
                }
            }
        } return value;
    }

    fn LowerIndexAccessExpression(&mut this, index_access: *HIRIndexAccessExpression) -> *MIRValue {
        let value = this.LowerExpression(index_access->value);
        let index = this.LowerExpression(index_access->index);
        if value == null || index == null { return null; }
        let gep = this.arena.New<MIRArrayGEPInstruction>("index.access".ToString(), value, index);
        this.current_block->instructions.PushBack(gep);
        return gep as *MIRInstruction;
    }

    fn LowerMemberAccessExpression(&mut this, member_access: *HIRMemberAccessExpression) -> *MIRValue {
        let expression = member_access as *HIRExpression;
        let instance = this.LowerPlaceExpression(member_access->instance);
        if instance == null { return null; }
        let _type = analyzer->type_manager.Pointer(expression->_type, expression->mutable);
        let gep = this.arena.New<MIRStructGEPInstruction>("field.access".ToString(), instance, member_access->index as u32, _type);
        this.current_block->instructions.PushBack(gep);
        return gep as *MIRInstruction;
    }

    fn LowerUnaryExpression(&mut this, unary: *HIRUnaryExpression) -> *MIRValue {
        let mut lowered: *MIRInstruction = null;
        let operand = this.LowerExpression(unary->operand);
        if operand == null { return null; }

        if unary->_operator == TokenType::MINUS {
            if unary->operand->_type->IsFloat() {
                lowered = this.arena.New<MIRUnaryInstruction>("neg".ToString(), MIRUnaryKind::FNeg, operand) as *MIRInstruction;
            } else {
                lowered = this.arena.New<MIRUnaryInstruction>("neg".ToString(), MIRUnaryKind::Neg, operand) as *MIRInstruction;
            }
        } else if unary->_operator == TokenType::NOT {
            lowered = this.arena.New<MIRUnaryInstruction>("not".ToString(), MIRUnaryKind::Not, operand) as *MIRInstruction;
        } else { return null; }

        this.current_block->instructions.PushBack(lowered);
        return lowered;
    }

    fn LowerBinaryExpression(&mut this, binary: *HIRBinaryExpression) -> *MIRValue {
        let mut lowered: *MIRInstruction = null;
        let expression = binary as *HIRExpression;
        let result_type = expression->_type;

        let left_type = binary->left->_type;
        let left = this.LowerExpression(binary->left);
        if left == null { return null; }

        if binary->_operator == TokenType::AND || binary->_operator == TokenType::OR {
            let mut right_block = this.arena.New<MIRBlock>("binary.right".ToString());
            let merge_block = this.arena.New<MIRBlock>("binary.merge".ToString());
            let left_block = this.current_block;

            if binary->_operator == TokenType::AND {
                this.current_block->terminator = this.arena.New<MIRConditionalBranchInstruction>(left, right_block, merge_block);
            } else {
                this.current_block->terminator = this.arena.New<MIRConditionalBranchInstruction>(left, merge_block, right_block);
            }

            this.current_block = right_block;
            this.current_function->blocks.PushBack(right_block);
            let right = this.LowerExpression(binary->right);
            if right == null { return null; }
            this.current_block->terminator = this.arena.New<MIRBranchInstruction>(merge_block);
            right_block = this.current_block;

            this.current_block = merge_block;
            this.current_function->blocks.PushBack(merge_block);
            let phi = this.arena.New<MIRPhiInstruction>("short.circuit".ToString(), result_type);
            phi->AddIncoming(left, left_block);
            phi->AddIncoming(right, right_block);
            this.current_block->instructions.PushBack(phi);
            return phi as *MIRInstruction;
        }

        let right_type = binary->right->_type;
        let right = this.LowerExpression(binary->right);
        if right == null { return null; }

        if left_type->IsInteger() {
            let signed = left_type->IsSigned();

            if binary->_operator == TokenType::PLUS {
                lowered = this.arena.New<MIRBinaryInstruction>("add".ToString(), MIRBinaryKind::Add, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::MINUS {
                lowered = this.arena.New<MIRBinaryInstruction>("sub".ToString(), MIRBinaryKind::Sub, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::MUL {
                lowered = this.arena.New<MIRBinaryInstruction>("mul".ToString(), MIRBinaryKind::Mul, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::DIV {
                lowered = this.arena.New<MIRBinaryInstruction>("div".ToString(), signed ? MIRBinaryKind::SDiv : MIRBinaryKind::UDiv, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::MOD {
                lowered = this.arena.New<MIRBinaryInstruction>("rem".ToString(), signed ? MIRBinaryKind::SRem : MIRBinaryKind::URem, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::EQUAL {
                lowered = this.arena.New<MIRBinaryInstruction>("eq".ToString(), MIRBinaryKind::ICmpEq, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::NOT_EQUAL {
                lowered = this.arena.New<MIRBinaryInstruction>("ne".ToString(), MIRBinaryKind::ICmpNe, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::LESS {
                lowered = this.arena.New<MIRBinaryInstruction>("lt".ToString(), signed ? MIRBinaryKind::ICmpSlt : MIRBinaryKind::ICmpUlt, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::LESS_EQUAL {
                lowered = this.arena.New<MIRBinaryInstruction>("le".ToString(), signed ? MIRBinaryKind::ICmpSle : MIRBinaryKind::ICmpUle, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::GREATER {
                lowered = this.arena.New<MIRBinaryInstruction>("gt".ToString(), signed ? MIRBinaryKind::ICmpSgt : MIRBinaryKind::ICmpUgt, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::GREATER_EQUAL {
                lowered = this.arena.New<MIRBinaryInstruction>("ge".ToString(), signed ? MIRBinaryKind::ICmpSge : MIRBinaryKind::ICmpUge, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::BITWISE_AND {
                lowered = this.arena.New<MIRBinaryInstruction>("and".ToString(), MIRBinaryKind::And, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::BITWISE_OR {
                lowered = this.arena.New<MIRBinaryInstruction>("or".ToString(), MIRBinaryKind::Or, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::BITWISE_XOR {
                lowered = this.arena.New<MIRBinaryInstruction>("xor".ToString(), MIRBinaryKind::Xor, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::LSHIFT {
                lowered = this.arena.New<MIRBinaryInstruction>("shl".ToString(), MIRBinaryKind::Shl, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::RSHIFT {
                lowered = this.arena.New<MIRBinaryInstruction>("shr".ToString(), signed ? MIRBinaryKind::AShr : MIRBinaryKind::LShr, left, right, result_type) as *MIRInstruction;
            } else { return null; }
        } else if left_type->IsFloat() {
            if binary->_operator == TokenType::PLUS {
                lowered = this.arena.New<MIRBinaryInstruction>("add".ToString(), MIRBinaryKind::FAdd, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::MINUS {
                lowered = this.arena.New<MIRBinaryInstruction>("sub".ToString(), MIRBinaryKind::FSub, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::MUL {
                lowered = this.arena.New<MIRBinaryInstruction>("mul".ToString(), MIRBinaryKind::FMul, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::DIV {
                lowered = this.arena.New<MIRBinaryInstruction>("div".ToString(), MIRBinaryKind::FDiv, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::MOD {
                lowered = this.arena.New<MIRBinaryInstruction>("rem".ToString(), MIRBinaryKind::FRem, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::EQUAL {
                lowered = this.arena.New<MIRBinaryInstruction>("eq".ToString(), MIRBinaryKind::FCmpEq, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::NOT_EQUAL {
                lowered = this.arena.New<MIRBinaryInstruction>("ne".ToString(), MIRBinaryKind::FCmpNe, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::LESS {
                lowered = this.arena.New<MIRBinaryInstruction>("lt".ToString(), MIRBinaryKind::FCmpLt, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::LESS_EQUAL {
                lowered = this.arena.New<MIRBinaryInstruction>("le".ToString(), MIRBinaryKind::FCmpLe, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::GREATER {
                lowered = this.arena.New<MIRBinaryInstruction>("gt".ToString(), MIRBinaryKind::FCmpGt, left, right, result_type) as *MIRInstruction;
            } else if binary->_operator == TokenType::GREATER_EQUAL {
                lowered = this.arena.New<MIRBinaryInstruction>("ge".ToString(), MIRBinaryKind::FCmpGe, left, right, result_type) as *MIRInstruction;
            } else { return null; }
        } else if left_type->IsPointer() || right_type->IsPointer() {
            let mut pointer = left_type->IsPointer() ? left : right;
            let mut other = left_type->IsPointer() ? right : left;

            if left_type->IsPointer() && right_type->IsPointer() {
                if binary->_operator == TokenType::EQUAL {
                    lowered = this.arena.New<MIRBinaryInstruction>("eq".ToString(), MIRBinaryKind::ICmpEq, pointer, other, result_type) as *MIRInstruction;
                } else if binary->_operator == TokenType::NOT_EQUAL {
                    lowered = this.arena.New<MIRBinaryInstruction>("ne".ToString(), MIRBinaryKind::ICmpNe, pointer, other, result_type) as *MIRInstruction;
                } else if binary->_operator == TokenType::GREATER {
                    lowered = this.arena.New<MIRBinaryInstruction>("gt".ToString(), MIRBinaryKind::ICmpUgt, pointer, other, result_type) as *MIRInstruction;
                } else if binary->_operator == TokenType::GREATER_EQUAL {
                    lowered = this.arena.New<MIRBinaryInstruction>("ge".ToString(), MIRBinaryKind::ICmpUge, pointer, other, result_type) as *MIRInstruction;
                } else if binary->_operator == TokenType::LESS {
                    lowered = this.arena.New<MIRBinaryInstruction>("lt".ToString(), MIRBinaryKind::ICmpUlt, pointer, other, result_type) as *MIRInstruction;
                } else if binary->_operator == TokenType::LESS_EQUAL {
                    lowered = this.arena.New<MIRBinaryInstruction>("le".ToString(), MIRBinaryKind::ICmpUle, pointer, other, result_type) as *MIRInstruction;
                } else { return null; }
            }

            if binary->_operator == TokenType::PLUS {
                lowered = this.arena.New<MIRArrayGEPInstruction>("ptr.add".ToString(), pointer, other) as *MIRInstruction;
            } else if binary->_operator == TokenType::MINUS && left_type->IsPointer() {
                let neg = this.arena.New<MIRUnaryInstruction>("ptr.neg".ToString(), MIRUnaryKind::Neg, other) as *MIRInstruction;
                this.current_block->instructions.PushBack(neg);
                lowered = this.arena.New<MIRArrayGEPInstruction>("ptr.sub".ToString(), pointer, neg) as *MIRInstruction;
            } else { return null; }
        } else { return null; }

        this.current_block->instructions.PushBack(lowered);
        return lowered;
    }

    fn LowerTernaryExpression(&mut this, ternary: *HIRTernaryExpression) -> *MIRValue {
        let expression = ternary as *HIRExpression;
        let condition = this.LowerExpression(ternary->condition);
        if condition == null { return null; }

        let mut then_block = this.arena.New<MIRBlock>("ternary.then".ToString());
        let mut else_block = this.arena.New<MIRBlock>("ternary.else".ToString());
        let merge_block = this.arena.New<MIRBlock>("ternary.merge".ToString());
        this.current_block->terminator = this.arena.New<MIRConditionalBranchInstruction>(condition, then_block, else_block);

        this.current_block = then_block;
        this.current_function->blocks.PushBack(then_block);
        let then_value = this.LowerExpression(ternary->then);
        if then_value == null { return null; }
        this.current_block->terminator = this.arena.New<MIRBranchInstruction>(merge_block);
        then_block = this.current_block;

        this.current_block = else_block;
        this.current_function->blocks.PushBack(else_block);
        let else_value = this.LowerExpression(ternary->_else);
        if else_value == null { return null; }
        this.current_block->terminator = this.arena.New<MIRBranchInstruction>(merge_block);
        else_block = this.current_block;

        this.current_block = merge_block;
        this.current_function->blocks.PushBack(merge_block);
        let phi = this.arena.New<MIRPhiInstruction>("ternary".ToString(), expression->_type);
        phi->AddIncoming(then_value, then_block);
        phi->AddIncoming(else_value, else_block);
        this.current_block->instructions.PushBack(phi);
        return phi as *MIRInstruction;
    }
}
