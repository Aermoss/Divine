    ASTCall(&mut this, expression: *ASTNode, start: Token) : ASTNode(ASTNodeKind::CALL, start) {
        this.expression = expression;
    }
}

class ASTPackSplat : ASTNode {
    pub expression: *ASTNode;

    ASTPackSplat(&mut this, expression: *ASTNode, start: Token) : ASTNode(ASTNodeKind::PACK_SPLAT, start) {
        this.expression = expression;
    }
}

class ASTMemberAccess : ASTNode {
    pub expression: *ASTNode,
