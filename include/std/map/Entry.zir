#[include "std/vec", "std/pair" : *]

class Map<K, V> {
    vector: Vector<Pair<K, V>>;

    Map(&mut this) {}

    Map(&mut this, other: &Map<K, V>) {
        this.vector = other.vector;
    }

    ~Map(&mut this) {}

    pub fn Data(&this) -> *Pair<K, V> { return this.vector.Data(); }
    pub fn Empty(&this) -> bool { return this.vector.Empty(); }
    pub fn Size(&this) -> usize { return this.vector.Size(); }

    pub fn Clear(&mut this) {
        this.vector.Clear();
    }

    pub fn Swap(&mut this, other: &mut Map<K, V>) {
        this.vector.Swap(other.vector);
    }

    pub fn Keys(&this) -> Vector<K> {
        let mut keys: Vector<K>;

        for pair in this.vector {
            keys.PushBack(pair.left);
        } return keys;
    }

    pub fn Values(&this) -> Vector<V> {
        let mut values: Vector<V>;

        for pair in this.vector {
            values.PushBack(pair.right);
        } return values;
    }

    pub fn Has(&this, key: K) -> bool {
        for pair in this.vector {
            if pair.left == key {
                return true;
            }
        } return false;
    }

    pub fn Get(&this, key: K, default: V) -> V {
        for pair in this.vector {
            if pair.left == key {
                return pair.right;
            }
        } return default;
    }

    pub fn Remove(&mut this, key: K) {
        for i in 0..this.vector.Size() {
            if this.vector[i].left == key {
                this.vector.RemoveAt(i);
                return;
            }
        }
    }

    pub fn Index(&this, key: K) -> isize {
        for i in 0..this.vector.Size() {
            if this.vector[i].left == key {
                return i as isize;
            }
        } return -1;
    }

    pub fn operator=(&mut this, other: &Map<K, V>) -> &mut Map<K, V> {
        this.vector = other.vector;
        return this;
    }

    pub fn operator[](&mut this, key: K) -> &mut V {
        for pair in this.vector {
            if pair.left == key {
                return pair.right;
            }
        }

        this.vector.PushBack(Pair<K, V>(key));
        return this.vector[this.vector.Size() - 1].right;
    }

    pub fn operator[](&this, index: usize) -> &mut Pair<K, V> {
        return this.vector[index];
    }

    pub fn Begin(&this) -> *mut Pair<K, V> {
        return this.vector.Begin();
    }

    pub fn End(&this) -> *mut Pair<K, V> {
        return this.vector.End();
    }
}