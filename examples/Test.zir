#[include "std/io", "std/str", "std/opt", "std/res" : *]

func Divide(a: f64, b: f64) -> Result<f64, String> {
    if b == 0.0f64 {
        ret Result<f64, String>::Err(String("division by zero"));
    }

    ret Result<f64, String>::Ok(a / b);
}

func Find(haystack: *const i8, needle: i8) -> Option<u64> {
    let mut i: u64 = 0u64;

    while haystack[i] != '\0' {
        if haystack[i] == needle {
            ret Option<u64>::Some(i);
        } i += 1u64;
    }

    ret Option<u64>::None;
}

func main(args: &mut Vector<String>) -> i32 {
    let result: Result<f64, String> = Divide(10.0f64, 3.0f64);

    match result {
        Result::Ok(value) => WriteLine("10 / 3 = " + String(value)),
        Result::Err(message) => WriteLine("Error: " + message)
    }

    let error: Result<f64, String> = Divide(1.0f64, 0.0f64);

    match error {
        Result::Ok(value) => WriteLine("Result: " + String(value)),
        Result::Err(message) => WriteLine("Error: " + message + " (expected)")
    }

    let found: Option<u64> = Find("hello", 'l');

    match found {
        Option::Some(index) => WriteLine("Found at index: " + String(index as i64)),
        Option::None => WriteLine("Not found")
    }

    let missing: Option<u64> = Find("hello", 'z');

    if let Option::Some(index) = missing {
        WriteLine("Found at: " + String(index as i64));
    } else {
        WriteLine("Not found (expected)");
    }

    ret 0i32;
}
