#[include "std/str", "std/vec", "std/map", "std/pair", "src/Tokens.zir" : *]

enum ASTNodeType: i32 {
    ROOT, INLINE_ASM, UNSAFE_STMT,

    VARIABLE_DECL, CONSTANT_DECL, STATIC_DECL,
    FUNCTION_DECL, CLASS_DECL, ENUM_DECL, TYPE_DECL,
    EXTERN_BLOCK, IMPL_BLOCK, PARAMETER, FIELD, VARIANT,

    IF_STMT, IF_LET_STMT, MATCH_STMT, CASE_STMT, DEFAULT_STMT,
    WHILE_STMT, WHILE_LET_STMT, FOR_STMT, LOOP_STMT, BLOCK_STMT,
    EXPRESSION_STMT, RETURN_STMT, BREAK_STMT, CONTINUE_STMT,

    UNARY_OP, BINARY_OP, ASSIGNMENT, TERNARY, CALL, CAST, NEW, DELETE,
    LITERAL, IDENTIFIER, SCOPE_RESOLUTION, MEMBER_ACCESS, INDEX_ACCESS,
    RANGE_EXPR, AWAIT_EXPR, INITIALIZER_LIST, STRUCT_INIT, OR_PATTERN,

    PRIMITIVE_TYPE, POINTER_TYPE, REFERENCE_TYPE, ARRAY_TYPE, FUNCTION_TYPE
}

func ToString(_type: ASTNodeType) -> String {
    if _type == ASTNodeType::ROOT { ret "ROOT".ToString(); }
    else if _type == ASTNodeType::INLINE_ASM { ret "INLINE_ASM".ToString(); }
    else if _type == ASTNodeType::UNSAFE_STMT { ret "UNSAFE_STMT".ToString(); }
    else if _type == ASTNodeType::VARIABLE_DECL { ret "VARIABLE_DECL".ToString(); }
    else if _type == ASTNodeType::CONSTANT_DECL { ret "CONSTANT_DECL".ToString(); }
    else if _type == ASTNodeType::STATIC_DECL { ret "STATIC_DECL".ToString(); }
    else if _type == ASTNodeType::FUNCTION_DECL { ret "FUNCTION_DECL".ToString(); }
    else if _type == ASTNodeType::CLASS_DECL { ret "CLASS_DECL".ToString(); }
    else if _type == ASTNodeType::ENUM_DECL { ret "ENUM_DECL".ToString(); }
    else if _type == ASTNodeType::TYPE_DECL { ret "TYPE_DECL".ToString(); }
    else if _type == ASTNodeType::EXTERN_BLOCK { ret "EXTERN_BLOCK".ToString(); }
    else if _type == ASTNodeType::IMPL_BLOCK { ret "IMPL_BLOCK".ToString(); }
    else if _type == ASTNodeType::PARAMETER { ret "PARAMETER".ToString(); }
    else if _type == ASTNodeType::FIELD { ret "FIELD".ToString(); }
    else if _type == ASTNodeType::VARIANT { ret "VARIANT".ToString(); }
    else if _type == ASTNodeType::IF_STMT { ret "IF_STMT".ToString(); }
    else if _type == ASTNodeType::IF_LET_STMT { ret "IF_LET_STMT".ToString(); }
    else if _type == ASTNodeType::MATCH_STMT { ret "MATCH_STMT".ToString(); }
    else if _type == ASTNodeType::CASE_STMT { ret "CASE_STMT".ToString(); }
    else if _type == ASTNodeType::DEFAULT_STMT { ret "DEFAULT_STMT".ToString(); }
    else if _type == ASTNodeType::WHILE_STMT { ret "WHILE_STMT".ToString(); }
    else if _type == ASTNodeType::WHILE_LET_STMT { ret "WHILE_LET_STMT".ToString(); }
    else if _type == ASTNodeType::FOR_STMT { ret "FOR_STMT".ToString(); }
    else if _type == ASTNodeType::LOOP_STMT { ret "LOOP_STMT".ToString(); }
    else if _type == ASTNodeType::BLOCK_STMT { ret "BLOCK_STMT".ToString(); }
    else if _type == ASTNodeType::EXPRESSION_STMT { ret "EXPRESSION_STMT".ToString(); }
    else if _type == ASTNodeType::RETURN_STMT { ret "RETURN_STMT".ToString(); }
    else if _type == ASTNodeType::BREAK_STMT { ret "BREAK_STMT".ToString(); }
    else if _type == ASTNodeType::CONTINUE_STMT { ret "CONTINUE_STMT".ToString(); }
    else if _type == ASTNodeType::UNARY_OP { ret "UNARY_OP".ToString(); }
    else if _type == ASTNodeType::BINARY_OP { ret "BINARY_OP".ToString(); }
    else if _type == ASTNodeType::ASSIGNMENT { ret "ASSIGNMENT".ToString(); }
    else if _type == ASTNodeType::TERNARY { ret "TERNARY".ToString(); }
    else if _type == ASTNodeType::CALL { ret "CALL".ToString(); }
    else if _type == ASTNodeType::CAST { ret "CAST".ToString(); }
    else if _type == ASTNodeType::NEW { ret "NEW".ToString(); }
    else if _type == ASTNodeType::DELETE { ret "DELETE".ToString(); }
    else if _type == ASTNodeType::LITERAL { ret "LITERAL".ToString(); }
    else if _type == ASTNodeType::IDENTIFIER { ret "IDENTIFIER".ToString(); }
    else if _type == ASTNodeType::SCOPE_RESOLUTION { ret "SCOPE_RESOLUTION".ToString(); }
    else if _type == ASTNodeType::MEMBER_ACCESS { ret "MEMBER_ACCESS".ToString(); }
    else if _type == ASTNodeType::INDEX_ACCESS { ret "INDEX_ACCESS".ToString(); }
    else if _type == ASTNodeType::RANGE_EXPR { ret "RANGE_EXPR".ToString(); }
    else if _type == ASTNodeType::AWAIT_EXPR { ret "AWAIT_EXPR".ToString(); }
    else if _type == ASTNodeType::INITIALIZER_LIST { ret "INITIALIZER_LIST".ToString(); }
    else if _type == ASTNodeType::STRUCT_INIT { ret "STRUCT_INIT".ToString(); }
    else if _type == ASTNodeType::OR_PATTERN { ret "OR_PATTERN".ToString(); }
    else if _type == ASTNodeType::PRIMITIVE_TYPE { ret "PRIMITIVE_TYPE".ToString(); }
    else if _type == ASTNodeType::POINTER_TYPE { ret "POINTER_TYPE".ToString(); }
    else if _type == ASTNodeType::REFERENCE_TYPE { ret "REFERENCE_TYPE".ToString(); }
    else if _type == ASTNodeType::ARRAY_TYPE { ret "ARRAY_TYPE".ToString(); }
    else if _type == ASTNodeType::FUNCTION_TYPE { ret "FUNCTION_TYPE".ToString(); }
    else { ret "UNKNOWN".ToString(); }
}

class ASTNode {
    pub node_type: ASTNodeType,
    pub start: Token, pub end: Token;

    ASTNode(&mut this, _type: ASTNodeType, start: Token) {
        (this.node_type, this.start) = (_type, start);
    }
}

class PrimitiveTypeNode : ASTNode {
    pub name: String,
    pub types: Vector<*const ASTNode>,
    pub generic: bool = false;

    PrimitiveTypeNode(&mut this, name: String, start: Token) : ASTNode(ASTNodeType::PRIMITIVE_TYPE, start) {
        this.name = name;
    }
}

class PointerTypeNode : ASTNode {
    pub base_type: *const ASTNode,
    pub mutable: bool;

    PointerTypeNode(&mut this, base_type: *const ASTNode, mutable: bool, start: Token) : ASTNode(ASTNodeType::POINTER_TYPE, start) {
        (this.base_type, this.mutable) = (base_type, mutable);
    }
}

class ReferenceTypeNode : ASTNode {
    pub base_type: *const ASTNode,
    pub mutable: bool;

    ReferenceTypeNode(&mut this, base_type: *const ASTNode, mutable: bool, start: Token) : ASTNode(ASTNodeType::REFERENCE_TYPE, start) {
        (this.base_type, this.mutable) = (base_type, mutable);
    }
}

class ArrayTypeNode : ASTNode {
    pub element_type: *const ASTNode,
    pub size: *const ASTNode;

    ArrayTypeNode(&mut this, element_type: *const ASTNode, size: *const ASTNode, start: Token) : ASTNode(ASTNodeType::ARRAY_TYPE, start) {
        (this.element_type, this.size) = (element_type, size);
    }
}

class LiteralNode : ASTNode {
    pub value: String,
    pub literal_type: TokenType;

    LiteralNode(&mut this, value: String, literal_type: TokenType, start: Token) : ASTNode(ASTNodeType::LITERAL, start) {
        (this.value, this.literal_type) = (value, literal_type);
    }
}

class IdentifierNode : ASTNode {
    pub name: String;

    IdentifierNode(&mut this, name: String, start: Token) : ASTNode(ASTNodeType::IDENTIFIER, start) {
        this.name = name;
    }
}

class ScopeResolutionNode : ASTNode {
    pub scope: *const ASTNode,
    pub identifier: *const IdentifierNode;

    ScopeResolutionNode(&mut this, scope: *const ASTNode, identifier: *const IdentifierNode, start: Token) : ASTNode(ASTNodeType::SCOPE_RESOLUTION, start) {
        (this.scope, this.identifier) = (scope, identifier);
    }
}

class BinaryOpNode : ASTNode {
    pub left: *const ASTNode,
    pub right: *const ASTNode,
    pub operator: TokenType;

    BinaryOpNode(&mut this, left: *const ASTNode, right: *const ASTNode, operator: TokenType, start: Token) : ASTNode(ASTNodeType::BINARY_OP, start) {
        (this.left, this.right, this.operator) = (left, right, operator);
    }
}

class UnaryOpNode : ASTNode {
    pub operand: *const ASTNode,
    pub operator: TokenType,
    pub mutable: bool;

    UnaryOpNode(&mut this, operand: *const ASTNode, operator: TokenType, mutable: bool, start: Token) : ASTNode(ASTNodeType::UNARY_OP, start) {
        (this.operand, this.operator, this.mutable) = (operand, operator, mutable);
    }
}

class TernaryNode : ASTNode {
    pub condition: *const ASTNode,
    pub then_expr: *const ASTNode,
    pub else_expr: *const ASTNode;

    TernaryNode(&mut this, condition: *const ASTNode, then_expr: *const ASTNode, else_expr: *const ASTNode, start: Token) : ASTNode(ASTNodeType::TERNARY, start) {
        (this.condition, this.then_expr, this.else_expr) = (condition, then_expr, else_expr);
    }
}

class CallNode : ASTNode {
    pub expression: *const ASTNode,
    pub arguments: Vector<*const ASTNode>;

    CallNode(&mut this, expression: *const ASTNode, start: Token) : ASTNode(ASTNodeType::CALL, start) {
        this.expression = expression;
    }
}

class MemberAccessNode : ASTNode {
    pub expression: *const ASTNode,
    pub member: String, pub arrow: bool;

    MemberAccessNode(&mut this, expression: *const ASTNode, arrow: bool, start: Token) : ASTNode(ASTNodeType::MEMBER_ACCESS, start) {
        (this.expression, this.arrow) = (expression, arrow);
    }
}

class IndexAccessNode : ASTNode {
    pub expression: *const ASTNode,
    pub index: *const ASTNode;

    IndexAccessNode(&mut this, expression: *const ASTNode, index: *const ASTNode, start: Token) : ASTNode(ASTNodeType::INDEX_ACCESS, start) {
        (this.expression, this.index) = (expression, index);
    }
}

class CastNode : ASTNode {
    pub expression: *const ASTNode,
    pub target_type: *const ASTNode;

    CastNode(&mut this, expression: *const ASTNode, target_type: *const ASTNode, start: Token) : ASTNode(ASTNodeType::CAST, start) {
        (this.expression, this.target_type) = (expression, target_type);
    }
}

class InitializerListNode : ASTNode {
    pub expressions: Vector<*const ASTNode>;

    InitializerListNode(&mut this, start: Token) : ASTNode(ASTNodeType::INITIALIZER_LIST, start) {}
}

class NewNode : ASTNode {
    pub _type: *const ASTNode,
    pub arguments: Vector<*const ASTNode>,
    pub size: *const ASTNode = null;

    NewNode(&mut this, _type: *const ASTNode, start: Token) : ASTNode(ASTNodeType::NEW, start) {
        this._type = _type;
    }
}

class DeleteNode : ASTNode {
    pub expression: *const ASTNode,
    pub array: bool = false;

    DeleteNode(&mut this, start: Token) : ASTNode(ASTNodeType::DELETE, start) {}
}

class ExpressionStmtNode : ASTNode {
    pub expression: *const ASTNode;

    ExpressionStmtNode(&mut this, expression: *const ASTNode, start: Token) : ASTNode(ASTNodeType::EXPRESSION_STMT, start) {
        this.expression = expression;
    }
}

class VariableDeclNode : ASTNode {
    pub name: String, pub _type: *const ASTNode,
    pub initializer: *const ASTNode, pub mutable: bool,
    pub next: *mut VariableDeclNode = null;

    VariableDeclNode(&mut this, name: String, _type: *const ASTNode, initializer: *const ASTNode, mutable: bool, start: Token) : ASTNode(ASTNodeType::VARIABLE_DECL, start) {
        (this.name, this._type, this.initializer, this.mutable) = (name, _type, initializer, mutable);
    }
}

class ConstantDeclNode : ASTNode {
    pub name: String, pub _type: *const ASTNode,
    pub initializer: *const ASTNode;

    ConstantDeclNode(&mut this, name: String, _type: *const ASTNode, initializer: *const ASTNode, start: Token) : ASTNode(ASTNodeType::CONSTANT_DECL, start) {
        (this.name, this._type, this.initializer) = (name, _type, initializer);
    }
}

class StaticDeclNode : ASTNode {
    pub name: String, pub _type: *const ASTNode, pub mutable: bool,
    pub initializer: *const ASTNode = null, pub alignment: *const ASTNode,
    pub zero_initializer: bool = false;

    StaticDeclNode(&mut this, name: String, _type: *const ASTNode, mutable: bool, alignment: *const ASTNode, start: Token) : ASTNode(ASTNodeType::STATIC_DECL, start) {
        (this.name, this._type, this.mutable, this.alignment) = (name, _type, mutable, alignment);
    }
}

class AssignmentNode : ASTNode {
    pub left: *const ASTNode, pub right: *const ASTNode,
    pub operator: TokenType, pub next: *mut AssignmentNode = null;

    AssignmentNode(&mut this, left: *const ASTNode, right: *const ASTNode, operator: TokenType, start: Token) : ASTNode(ASTNodeType::ASSIGNMENT, start) {
        (this.left, this.right, this.operator) = (left, right, operator);
    }
}

class IfStmtNode : ASTNode {
    pub condition: *const ASTNode,
    pub then_stmt: *const ASTNode,
    pub else_stmt: *const ASTNode;

    IfStmtNode(&mut this, condition: *const ASTNode, then_stmt: *const ASTNode, else_stmt: *const ASTNode, start: Token) : ASTNode(ASTNodeType::IF_STMT, start) {
        (this.condition, this.then_stmt, this.else_stmt) = (condition, then_stmt, else_stmt);
    }
}

class WhileStmtNode : ASTNode {
    pub condition: *const ASTNode,
    pub loop_stmt: *const ASTNode,
    pub else_stmt: *const ASTNode;

    WhileStmtNode(&mut this, condition: *const ASTNode, loop_stmt: *const ASTNode, else_stmt: *const ASTNode, start: Token) : ASTNode(ASTNodeType::WHILE_STMT, start) {
        (this.condition, this.loop_stmt, this.else_stmt) = (condition, loop_stmt, else_stmt);
    }
}

class LoopStmtNode : ASTNode {
    pub loop_stmt: *const ASTNode;

    LoopStmtNode(&mut this, loop_stmt: *const ASTNode, start: Token) : ASTNode(ASTNodeType::LOOP_STMT, start) {
        this.loop_stmt = loop_stmt;
    }
}

class ReturnStmtNode : ASTNode {
    pub expression: *const ASTNode;

    ReturnStmtNode(&mut this, expression: *const ASTNode, start: Token) : ASTNode(ASTNodeType::RETURN_STMT, start) {
        this.expression = expression;
    }
}

class BreakStmtNode : ASTNode {
    BreakStmtNode(&mut this, start: Token) : ASTNode(ASTNodeType::BREAK_STMT, start) {}
}

class ContinueStmtNode : ASTNode {
    ContinueStmtNode(&mut this, start: Token) : ASTNode(ASTNodeType::CONTINUE_STMT, start) {}
}

class BlockStmtNode : ASTNode {
    pub statements: Vector<*const ASTNode>;

    BlockStmtNode(&mut this, start: Token) : ASTNode(ASTNodeType::BLOCK_STMT, start) {}
}

class ParameterNode : ASTNode {
    pub name: String,
    pub param_type: *const ASTNode,
    pub mutable: bool = false;

    ParameterNode(&mut this, name: String, param_type: *const ASTNode, mutable: bool, start: Token) : ASTNode(ASTNodeType::PARAMETER, start) {
        (this.name, this.param_type, this.mutable) = (name, param_type, mutable);
    }
}

enum InstanceKind: i32 {
    None, Copy, ConstRef, MutRef
}

class FunctionTypeNode : ASTNode {
    pub parameters: Vector<*const ParameterNode>,
    pub return_type: *const ASTNode, pub var_arg: bool = false,
    pub instance_kind: InstanceKind = InstanceKind::None;

    FunctionTypeNode(&mut this, start: Token) : ASTNode(ASTNodeType::FUNCTION_TYPE, start) {}
}

class FunctionDeclNode : ASTNode {
    pub name: String,
    pub _type: *const FunctionTypeNode,
    pub body: *const BlockStmtNode = null,
    pub generic: bool = false,
    pub types: Vector<String>,
    pub constructors: Vector<*const CallNode>,
    pub is_async: bool = false,
    pub no_mangle: bool;

    FunctionDeclNode(&mut this, name: String, _type: *const FunctionTypeNode, no_mangle: bool, start: Token) : ASTNode(ASTNodeType::FUNCTION_DECL, start) {
        (this.name, this._type, this.no_mangle) = (name, _type, no_mangle);
    }
}

class AwaitExprNode : ASTNode {
    pub expression: *const ASTNode;

    AwaitExprNode(&mut this, expression: *const ASTNode, start: Token) : ASTNode(ASTNodeType::AWAIT_EXPR, start) {
        this.expression = expression;
    }
}

class TypeDeclNode : ASTNode {
    pub name: String,
    pub _type: *const ASTNode;

    TypeDeclNode(&mut this, name: String, _type: *const ASTNode, start: Token) : ASTNode(ASTNodeType::TYPE_DECL, start) {
        (this.name, this._type) = (name, _type);
    }
}

class FieldNode : ASTNode {
    pub name: String,
    pub field_type: *const ASTNode,
    pub initializer: *const ASTNode;

    FieldNode(&mut this, name: String, field_type: *const ASTNode, initializer: *const ASTNode, start: Token) : ASTNode(ASTNodeType::FIELD, start) {
        (this.name, this.field_type, this.initializer) = (name, field_type, initializer);
    }
}

class ClassDeclNode : ASTNode {
    pub name: String, pub parents: Vector<*const ASTNode>,
    pub fields: Vector<Pair<TokenType, *const FieldNode>>,
    pub constructors: Vector<*const FunctionDeclNode>,
    pub destructor: *const FunctionDeclNode = null,
    pub methods: Vector<Pair<TokenType, *const FunctionDeclNode>>,
    pub types: Vector<String>, pub generic: bool = false;

    ClassDeclNode(&mut this, name: String, start: Token) : ASTNode(ASTNodeType::CLASS_DECL, start) {
        this.name = name;
    }
}

class VariantNode : ASTNode {
    pub name: String,
    pub types: Vector<*const ASTNode>,
    pub field_names: Vector<String>,
    pub value: *const ASTNode = null;

    VariantNode(&mut this, name: String, start: Token) : ASTNode(ASTNodeType::VARIANT, start) {
        this.name = name;
    }
}

class EnumDeclNode : ASTNode {
    pub name: String, pub underlying_type: *const ASTNode = null,
    pub variants: Vector<*const VariantNode>, pub variant: bool = false,
    pub methods: Vector<Pair<TokenType, *const FunctionDeclNode>>,
    pub types: Vector<String>, pub generic: bool = false;

    EnumDeclNode(&mut this, name: String, start: Token) : ASTNode(ASTNodeType::ENUM_DECL, start) {
        this.name = name;
    }
}

class CaseStmtNode : ASTNode {
    pub pattern: *const ASTNode,
    pub body: *const ASTNode,
    pub guard: *const ASTNode;

    CaseStmtNode(&mut this, pattern: *const ASTNode, body: *const ASTNode, guard: *const ASTNode, start: Token) : ASTNode(ASTNodeType::CASE_STMT, start) {
        (this.pattern, this.body, this.guard) = (pattern, body, guard);
    }
}

class DefaultStmtNode : ASTNode {
    pub body: *const ASTNode;

    DefaultStmtNode(&mut this, body: *const ASTNode, start: Token) : ASTNode(ASTNodeType::DEFAULT_STMT, start) {
        this.body = body;
    }
}

class MatchStmtNode : ASTNode {
    pub expression: *const ASTNode,
    pub cases: Vector<*const CaseStmtNode>,
    pub default_case: *const DefaultStmtNode;

    MatchStmtNode(&mut this, expression: *const ASTNode, start: Token) : ASTNode(ASTNodeType::MATCH_STMT, start) {
        (this.expression, this.default_case) = (expression, null);
    }
}

class StructInitNode : ASTNode {
    pub expression: *const ASTNode,
    pub field_names: Vector<String>,
    pub field_values: Vector<*const ASTNode>;

    StructInitNode(&mut this, expression: *const ASTNode, start: Token) : ASTNode(ASTNodeType::STRUCT_INIT, start) {
        this.expression = expression;
    }
}

class OrPatternNode : ASTNode {
    pub left: *const ASTNode,
    pub right: *const ASTNode;

    OrPatternNode(&mut this, left: *const ASTNode, right: *const ASTNode, start: Token) : ASTNode(ASTNodeType::OR_PATTERN, start) {
        (this.left, this.right) = (left, right);
    }
}

class IfLetStmtNode : ASTNode {
    pub pattern: *const ASTNode,
    pub expression: *const ASTNode,
    pub then_stmt: *const ASTNode,
    pub else_stmt: *const ASTNode = null;

    IfLetStmtNode(&mut this, pattern: *const ASTNode, expression: *const ASTNode, then_stmt: *const ASTNode, start: Token) : ASTNode(ASTNodeType::IF_LET_STMT, start) {
        (this.pattern, this.expression, this.then_stmt) = (pattern, expression, then_stmt);
    }
}

class WhileLetStmtNode : ASTNode {
    pub pattern: *const ASTNode,
    pub expression: *const ASTNode,
    pub loop_stmt: *const ASTNode;

    WhileLetStmtNode(&mut this, pattern: *const ASTNode, expression: *const ASTNode, loop_stmt: *const ASTNode, start: Token) : ASTNode(ASTNodeType::WHILE_LET_STMT, start) {
        (this.pattern, this.expression, this.loop_stmt) = (pattern, expression, loop_stmt);
    }
}

class RangeExprNode : ASTNode {
    pub start_expr: *const ASTNode,
    pub end_expr: *const ASTNode,
    pub inclusive: bool = false;

    RangeExprNode(&mut this, start_expr: *const ASTNode, end_expr: *const ASTNode, start: Token) : ASTNode(ASTNodeType::RANGE_EXPR, start) {
        (this.start_expr, this.end_expr) = (start_expr, end_expr);
    }
}

class ForStmtNode : ASTNode {
    pub variable: String,
    pub iterable: *const ASTNode,
    pub loop_stmt: *const ASTNode;

    ForStmtNode(&mut this, variable: String, iterable: *const ASTNode, loop_stmt: *const ASTNode, start: Token) : ASTNode(ASTNodeType::FOR_STMT, start) {
        (this.variable, this.iterable, this.loop_stmt) = (variable, iterable, loop_stmt);
    }
}

class ExternBlockNode : ASTNode {
    pub linkage: String,
    pub declarations: Vector<*const ASTNode>;

    ExternBlockNode(&mut this, linkage: String, start: Token) : ASTNode(ASTNodeType::EXTERN_BLOCK, start) {
        this.linkage = linkage;
    }
}

class UnsafeStmtNode : ASTNode {
    pub body: *const BlockStmtNode;

    UnsafeStmtNode(&mut this, body: *const BlockStmtNode, start: Token) : ASTNode(ASTNodeType::UNSAFE_STMT, start) {
        this.body = body;
    }
}

class InlineAsmNode : ASTNode {
    pub _volatile: bool, pub code: String,
    pub inputs: Vector<Pair<String, *const ASTNode>>,
    pub outputs: Vector<Pair<String, *const ASTNode>>,
    pub clobbers: Vector<String>;

    InlineAsmNode(&mut this, _volatile: bool, start: Token) : ASTNode(ASTNodeType::INLINE_ASM, start) {
        this._volatile = _volatile;
    }
}

class RootNode : ASTNode {
    pub declarations: Vector<*const ASTNode>;

    RootNode(&mut this) : ASTNode(ASTNodeType::ROOT, Token(), Token()) {}
}
