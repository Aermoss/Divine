#[include "std/std", "std/io" : *]

enum Result<T, E> {
    Ok(T), Err(E);

    pub fn IsOk(&this) -> bool {
        match this {
            Result::Ok(_) => return true,
            Result::Err(_) => return false
        }
    }

    pub fn IsErr(&this) -> bool {
        match this {
            Result::Ok(_) => return false,
            Result::Err(_) => return true
        }
    }

    pub fn Unwrap(&this) -> T {
        match this {
            Result::Ok(value) => return value,
            Result::Err(_) => {
                WriteLine("Panicked: called Unwrap() on an Err value.");
                Exit(1);
                loop {}
            }
        }
    }

    pub fn UnwrapOr(&this, default: T) -> T {
        match this {
            Result::Ok(value) => return value,
            Result::Err(_) => return default
        }
    }

    pub fn UnwrapErr(&this) -> E {
        match this {
            Result::Ok(_) => {
                WriteLine("Panicked: called UnwrapErr() on an Ok value.");
                Exit(1);
                loop {}
            },
            Result::Err(err) => return err
        }
    }
}
