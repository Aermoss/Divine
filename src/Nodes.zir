#[include "std/str", "std/vec", "std/map", "std/pair", "src/Tokens.zir" : *]

enum NodeType: i32 {
    ROOT, ASSEMBLY, UNSAFE,

    FUNCTION, PARAMETER, CLASS, FIELD, ENUM, VARIANT,
    CONSTANT, STATIC, TYPE_DEFINITION, EXTERN, IMPLEMENT,

    IF, IF_LET, WHILE, WHILE_LET, FOR, LOOP,
    MATCH, CASE, DEFAULT, RETURN, BREAK, CONTINUE,
    VARIABLE, BLOCK, EXPRESSION,

    UNARY_OPERATION, BINARY_OPERATION, ASSIGNMENT, TERNARY, CALL, CAST, NEW, DELETE,
    LITERAL, IDENTIFIER, SCOPE_RESOLUTION, PACK_SPLAT, MEMBER_ACCESS, INDEX_ACCESS,
    RANGE, AWAIT, INITIALIZER_LIST, STRUCT_INIT, OR_PATTERN, TYPE_APPLICATION,

    PRIMITIVE_TYPE, POINTER_TYPE, REFERENCE_TYPE, ARRAY_TYPE, FUNCTION_TYPE
}

func ToString(_type: NodeType) -> String {
    if _type == NodeType::ROOT { ret "ROOT".ToString(); }
    else if _type == NodeType::ASSEMBLY { ret "ASSEMBLY".ToString(); }
    else if _type == NodeType::UNSAFE { ret "UNSAFE".ToString(); }
    else if _type == NodeType::FUNCTION { ret "FUNCTION".ToString(); }
    else if _type == NodeType::PARAMETER { ret "PARAMETER".ToString(); }
    else if _type == NodeType::CLASS { ret "CLASS".ToString(); }
    else if _type == NodeType::FIELD { ret "FIELD".ToString(); }
    else if _type == NodeType::ENUM { ret "ENUM".ToString(); }
    else if _type == NodeType::VARIANT { ret "VARIANT".ToString(); }
    else if _type == NodeType::CONSTANT { ret "CONSTANT".ToString(); }
    else if _type == NodeType::STATIC { ret "STATIC".ToString(); }
    else if _type == NodeType::TYPE_DEFINITION { ret "TYPE_DEFINITION".ToString(); }
    else if _type == NodeType::EXTERN { ret "EXTERN".ToString(); }
    else if _type == NodeType::IMPLEMENT { ret "IMPLEMENT".ToString(); }
    else if _type == NodeType::IF { ret "IF".ToString(); }
    else if _type == NodeType::IF_LET { ret "IF_LET".ToString(); }
    else if _type == NodeType::WHILE { ret "WHILE".ToString(); }
    else if _type == NodeType::WHILE_LET { ret "WHILE_LET".ToString(); }
    else if _type == NodeType::FOR { ret "FOR".ToString(); }
    else if _type == NodeType::LOOP { ret "LOOP".ToString(); }
    else if _type == NodeType::MATCH { ret "MATCH".ToString(); }
    else if _type == NodeType::CASE { ret "CASE".ToString(); }
    else if _type == NodeType::DEFAULT { ret "DEFAULT".ToString(); }
    else if _type == NodeType::RETURN { ret "RETURN".ToString(); }
    else if _type == NodeType::BREAK { ret "BREAK".ToString(); }
    else if _type == NodeType::CONTINUE { ret "CONTINUE".ToString(); }
    else if _type == NodeType::VARIABLE { ret "VARIABLE".ToString(); }
    else if _type == NodeType::BLOCK { ret "BLOCK".ToString(); }
    else if _type == NodeType::EXPRESSION { ret "EXPRESSION".ToString(); }
    else if _type == NodeType::UNARY_OPERATION { ret "UNARY_OPERATION".ToString(); }
    else if _type == NodeType::BINARY_OPERATION { ret "BINARY_OPERATION".ToString(); }
    else if _type == NodeType::ASSIGNMENT { ret "ASSIGNMENT".ToString(); }
    else if _type == NodeType::TERNARY { ret "TERNARY".ToString(); }
    else if _type == NodeType::CALL { ret "CALL".ToString(); }
    else if _type == NodeType::CAST { ret "CAST".ToString(); }
    else if _type == NodeType::NEW { ret "NEW".ToString(); }
    else if _type == NodeType::DELETE { ret "DELETE".ToString(); }
    else if _type == NodeType::LITERAL { ret "LITERAL".ToString(); }
    else if _type == NodeType::IDENTIFIER { ret "IDENTIFIER".ToString(); }
    else if _type == NodeType::SCOPE_RESOLUTION { ret "SCOPE_RESOLUTION".ToString(); }
    else if _type == NodeType::PACK_SPLAT { ret "PACK_SPLAT".ToString(); }
    else if _type == NodeType::MEMBER_ACCESS { ret "MEMBER_ACCESS".ToString(); }
    else if _type == NodeType::INDEX_ACCESS { ret "INDEX_ACCESS".ToString(); }
    else if _type == NodeType::RANGE { ret "RANGE".ToString(); }
    else if _type == NodeType::AWAIT { ret "AWAIT".ToString(); }
    else if _type == NodeType::INITIALIZER_LIST { ret "INITIALIZER_LIST".ToString(); }
    else if _type == NodeType::STRUCT_INIT { ret "STRUCT_INIT".ToString(); }
    else if _type == NodeType::OR_PATTERN { ret "OR_PATTERN".ToString(); }
    else if _type == NodeType::TYPE_APPLICATION { ret "TYPE_APPLICATION".ToString(); }
    else if _type == NodeType::PRIMITIVE_TYPE { ret "PRIMITIVE_TYPE".ToString(); }
    else if _type == NodeType::POINTER_TYPE { ret "POINTER_TYPE".ToString(); }
    else if _type == NodeType::REFERENCE_TYPE { ret "REFERENCE_TYPE".ToString(); }
    else if _type == NodeType::ARRAY_TYPE { ret "ARRAY_TYPE".ToString(); }
    else if _type == NodeType::FUNCTION_TYPE { ret "FUNCTION_TYPE".ToString(); }
    else { ret "UNKNOWN".ToString(); }
}

class Node {
    pub _type: NodeType,
    pub start: Token,
    pub end: Token;

    Node(&mut this, _type: NodeType, start: Token) {
        (this._type, this.start) = (_type, start);
    }
}

class PrimitiveTypeNode : Node {
    pub name: String;

    PrimitiveTypeNode(&mut this, name: String, start: Token) : Node(NodeType::PRIMITIVE_TYPE, start) {
        this.name = name;
    }
}

class PointerTypeNode : Node {
    pub base_type: *const Node,
    pub mutable: bool;

    PointerTypeNode(&mut this, base_type: *const Node, mutable: bool, start: Token) : Node(NodeType::POINTER_TYPE, start) {
        (this.base_type, this.mutable) = (base_type, mutable);
    }
}

class ReferenceTypeNode : Node {
    pub base_type: *const Node,
    pub mutable: bool;

    ReferenceTypeNode(&mut this, base_type: *const Node, mutable: bool, start: Token) : Node(NodeType::REFERENCE_TYPE, start) {
        (this.base_type, this.mutable) = (base_type, mutable);
    }
}

class ArrayTypeNode : Node {
    pub element_type: *const Node,
    pub size: *const Node;

    ArrayTypeNode(&mut this, element_type: *const Node, size: *const Node, start: Token) : Node(NodeType::ARRAY_TYPE, start) {
        (this.element_type, this.size) = (element_type, size);
    }
}

class LiteralNode : Node {
    pub value: String,
    pub _type: TokenType;

    LiteralNode(&mut this, value: String, _type: TokenType, start: Token) : Node(NodeType::LITERAL, start) {
        (this.value, this._type) = (value, _type);
    }
}

class IdentifierNode : Node {
    pub name: String;

    IdentifierNode(&mut this, name: String, start: Token) : Node(NodeType::IDENTIFIER, start) {
        this.name = name;
    }
}

class ScopeResolutionNode : Node {
    pub scope: *const Node,
    pub identifier: *const IdentifierNode;

    ScopeResolutionNode(&mut this, scope: *const Node, identifier: *const IdentifierNode, start: Token) : Node(NodeType::SCOPE_RESOLUTION, start) {
        (this.scope, this.identifier) = (scope, identifier);
    }
}

class BinaryOperationNode : Node {
    pub left: *const Node,
    pub right: *const Node,
    pub operator: TokenType;

    BinaryOperationNode(&mut this, left: *const Node, right: *const Node, operator: TokenType, start: Token) : Node(NodeType::BINARY_OPERATION, start) {
        (this.left, this.right, this.operator) = (left, right, operator);
    }
}

class UnaryOperationNode : Node {
    pub operand: *const Node,
    pub operator: TokenType,
    pub mutable: bool;

    UnaryOperationNode(&mut this, operand: *const Node, operator: TokenType, mutable: bool, start: Token) : Node(NodeType::UNARY_OPERATION, start) {
        (this.operand, this.operator, this.mutable) = (operand, operator, mutable);
    }
}

class TernaryNode : Node {
    pub condition: *const Node,
    pub then: *const Node,
    pub _else: *const Node;

    TernaryNode(&mut this, condition: *const Node, then: *const Node, _else: *const Node, start: Token) : Node(NodeType::TERNARY, start) {
        (this.condition, this.then, this._else) = (condition, then, _else);
    }
}

class CallNode : Node {
    pub expression: *const Node,
    pub arguments: Vector<*const Node>;

    CallNode(&mut this, expression: *const Node, start: Token) : Node(NodeType::CALL, start) {
        this.expression = expression;
    }
}

class PackSplatNode : Node {
    pub expression: *const Node;

    PackSplatNode(&mut this, expression: *const Node, start: Token) : Node(NodeType::PACK_SPLAT, start) {
        this.expression = expression;
    }
}

class MemberAccessNode : Node {
    pub expression: *const Node,
    pub member: String, pub arrow: bool;

    MemberAccessNode(&mut this, expression: *const Node, arrow: bool, start: Token) : Node(NodeType::MEMBER_ACCESS, start) {
        (this.expression, this.arrow) = (expression, arrow);
    }
}

class IndexAccessNode : Node {
    pub expression: *const Node,
    pub index: *const Node;

    IndexAccessNode(&mut this, expression: *const Node, index: *const Node, start: Token) : Node(NodeType::INDEX_ACCESS, start) {
        (this.expression, this.index) = (expression, index);
    }
}

class TypeApplicationNode : Node {
    pub expression: *const Node,
    pub types: Vector<*const Node>;

    TypeApplicationNode(&mut this, expression: *const Node, start: Token) : Node(NodeType::TYPE_APPLICATION, start) {
        this.expression = expression;
    }
}

class CastNode : Node {
    pub expression: *const Node,
    pub target_type: *const Node;

    CastNode(&mut this, expression: *const Node, target_type: *const Node, start: Token) : Node(NodeType::CAST, start) {
        (this.expression, this.target_type) = (expression, target_type);
    }
}

class InitializerListNode : Node {
    pub expressions: Vector<*const Node>;

    InitializerListNode(&mut this, start: Token) : Node(NodeType::INITIALIZER_LIST, start) {}
}

class NewNode : Node {
    pub _type: *const Node,
    pub arguments: Vector<*const Node>,
    pub size: *const Node = null,
    pub initialized: bool = false;

    NewNode(&mut this, _type: *const Node, start: Token) : Node(NodeType::NEW, start) {
        this._type = _type;
    }
}

class DeleteNode : Node {
    pub expression: *const Node,
    pub array: bool = false;

    DeleteNode(&mut this, start: Token) : Node(NodeType::DELETE, start) {}
}

class ExpressionNode : Node {
    pub expression: *const Node;

    ExpressionNode(&mut this, expression: *const Node, start: Token) : Node(NodeType::EXPRESSION, start) {
        this.expression = expression;
    }
}

class VariableNode : Node {
    pub name: String, pub _type: *const Node,
    pub initializer: *const Node, pub mutable: bool,
    pub next: *mut VariableNode = null;

    VariableNode(&mut this, name: String, _type: *const Node, initializer: *const Node, mutable: bool, start: Token) : Node(NodeType::VARIABLE, start) {
        (this.name, this._type, this.initializer, this.mutable) = (name, _type, initializer, mutable);
    }
}

class ConstantNode : Node {
    pub name: String, pub _type: *const Node,
    pub initializer: *const Node;

    ConstantNode(&mut this, name: String, _type: *const Node, initializer: *const Node, start: Token) : Node(NodeType::CONSTANT, start) {
        (this.name, this._type, this.initializer) = (name, _type, initializer);
    }
}

class StaticNode : Node {
    pub name: String, pub _type: *const Node, pub mutable: bool,
    pub initializer: *const Node = null, pub alignment: *const Node,
    pub zero_initializer: bool = false;

    StaticNode(&mut this, name: String, _type: *const Node, mutable: bool, alignment: *const Node, start: Token) : Node(NodeType::STATIC, start) {
        (this.name, this._type, this.mutable, this.alignment) = (name, _type, mutable, alignment);
    }
}

class AssignmentNode : Node {
    pub left: *const Node, pub right: *const Node,
    pub operator: TokenType, pub next: *mut AssignmentNode = null;

    AssignmentNode(&mut this, left: *const Node, right: *const Node, operator: TokenType, start: Token) : Node(NodeType::ASSIGNMENT, start) {
        (this.left, this.right, this.operator) = (left, right, operator);
    }
}

class IfNode : Node {
    pub condition: *const Node,
    pub body: *const Node,
    pub _else: *const Node;

    IfNode(&mut this, condition: *const Node, body: *const Node, _else: *const Node, start: Token) : Node(NodeType::IF, start) {
        (this.condition, this.body, this._else) = (condition, body, _else);
    }
}

class WhileNode : Node {
    pub condition: *const Node,
    pub body: *const Node,
    pub _else: *const Node;

    WhileNode(&mut this, condition: *const Node, body: *const Node, _else: *const Node, start: Token) : Node(NodeType::WHILE, start) {
        (this.condition, this.body, this._else) = (condition, body, _else);
    }
}

class LoopNode : Node {
    pub body: *const Node;

    LoopNode(&mut this, body: *const Node, start: Token) : Node(NodeType::LOOP, start) {
        this.body = body;
    }
}

class ReturnNode : Node {
    pub expression: *const Node;

    ReturnNode(&mut this, expression: *const Node, start: Token) : Node(NodeType::RETURN, start) {
        this.expression = expression;
    }
}

class BreakNode : Node {
    BreakNode(&mut this, start: Token) : Node(NodeType::BREAK, start) {}
}

class ContinueNode : Node {
    ContinueNode(&mut this, start: Token) : Node(NodeType::CONTINUE, start) {}
}

class BlockNode : Node {
    pub statements: Vector<*const Node>;

    BlockNode(&mut this, start: Token) : Node(NodeType::BLOCK, start) {}
}

class ParameterNode : Node {
    pub name: String,
    pub _type: *const Node,
    pub mutable: bool;

    ParameterNode(&mut this, name: String, _type: *const Node, mutable: bool, start: Token) : Node(NodeType::PARAMETER, start) {
        (this.name, this._type, this.mutable) = (name, _type, mutable);
    }
}

enum InstanceKind: i32 {
    None, Copy, ConstRef, MutRef
}

class FunctionTypeNode : Node {
    pub parameters: Vector<*const ParameterNode>,
    pub instance_kind: InstanceKind = InstanceKind::None,
    pub pack_name: String, pub var_arg: bool = false,
    pub return_type: *const Node = null;

    FunctionTypeNode(&mut this, start: Token) : Node(NodeType::FUNCTION_TYPE, start) {}
}

class FunctionNode : Node {
    pub name: String, pub _type: *const FunctionTypeNode,
    pub body: *const BlockNode = null, pub _async: bool = false,
    pub constructors: Vector<*const CallNode>, pub no_mangle: bool,
    pub types: Vector<String>, pub generic: bool = false;

    FunctionNode(&mut this, name: String, _type: *const FunctionTypeNode, no_mangle: bool, start: Token) : Node(NodeType::FUNCTION, start) {
        (this.name, this._type, this.no_mangle) = (name, _type, no_mangle);
    }
}

class AwaitNode : Node {
    pub expression: *const Node;

    AwaitNode(&mut this, expression: *const Node, start: Token) : Node(NodeType::AWAIT, start) {
        this.expression = expression;
    }
}

class TypeDefinitionNode : Node {
    pub name: String,
    pub _type: *const Node;

    TypeDefinitionNode(&mut this, name: String, _type: *const Node, start: Token) : Node(NodeType::TYPE_DEFINITION, start) {
        (this.name, this._type) = (name, _type);
    }
}

class FieldNode : Node {
    pub name: String,
    pub _type: *const Node,
    pub initializer: *const Node;

    FieldNode(&mut this, name: String, _type: *const Node, initializer: *const Node, start: Token) : Node(NodeType::FIELD, start) {
        (this.name, this._type, this.initializer) = (name, _type, initializer);
    }
}

class ClassNode : Node {
    pub name: String, pub parents: Vector<*const Node>,
    pub fields: Vector<Pair<TokenType, *const FieldNode>>,
    pub constructors: Vector<*const FunctionNode>,
    pub destructor: *const FunctionNode = null,
    pub methods: Vector<Pair<TokenType, *const FunctionNode>>,
    pub types: Vector<String>, pub generic: bool = false;

    ClassNode(&mut this, name: String, start: Token) : Node(NodeType::CLASS, start) {
        this.name = name;
    }
}

class VariantNode : Node {
    pub name: String,
    pub types: Vector<*const Node>,
    pub field_names: Vector<String>,
    pub value: *const Node = null;

    VariantNode(&mut this, name: String, start: Token) : Node(NodeType::VARIANT, start) {
        this.name = name;
    }
}

class EnumNode : Node {
    pub name: String, pub underlying_type: *const Node = null,
    pub variants: Vector<*const VariantNode>, pub variant: bool = false,
    pub methods: Vector<Pair<TokenType, *const FunctionNode>>,
    pub types: Vector<String>, pub generic: bool = false;

    EnumNode(&mut this, name: String, start: Token) : Node(NodeType::ENUM, start) {
        this.name = name;
    }
}

class CaseNode : Node {
    pub pattern: *const Node,
    pub body: *const Node,
    pub guard: *const Node;

    CaseNode(&mut this, pattern: *const Node, body: *const Node, guard: *const Node, start: Token) : Node(NodeType::CASE, start) {
        (this.pattern, this.body, this.guard) = (pattern, body, guard);
    }
}

class DefaultNode : Node {
    pub body: *const Node;

    DefaultNode(&mut this, body: *const Node, start: Token) : Node(NodeType::DEFAULT, start) {
        this.body = body;
    }
}

class MatchNode : Node {
    pub expression: *const Node,
    pub cases: Vector<*const CaseNode>,
    pub default: *const DefaultNode;

    MatchNode(&mut this, expression: *const Node, start: Token) : Node(NodeType::MATCH, start) {
        (this.expression, this.default) = (expression, null);
    }
}

class StructInitNode : Node {
    pub expression: *const Node,
    pub field_names: Vector<String>,
    pub field_values: Vector<*const Node>;

    StructInitNode(&mut this, expression: *const Node, start: Token) : Node(NodeType::STRUCT_INIT, start) {
        this.expression = expression;
    }
}

class OrPatternNode : Node {
    pub left: *const Node,
    pub right: *const Node;

    OrPatternNode(&mut this, left: *const Node, right: *const Node, start: Token) : Node(NodeType::OR_PATTERN, start) {
        (this.left, this.right) = (left, right);
    }
}

class IfLetNode : Node {
    pub pattern: *const Node,
    pub expression: *const Node,
    pub body: *const Node,
    pub _else: *const Node = null;

    IfLetNode(&mut this, pattern: *const Node, expression: *const Node, body: *const Node, start: Token) : Node(NodeType::IF_LET, start) {
        (this.pattern, this.expression, this.body) = (pattern, expression, body);
    }
}

class WhileLetNode : Node {
    pub pattern: *const Node,
    pub expression: *const Node,
    pub body: *const Node;

    WhileLetNode(&mut this, pattern: *const Node, expression: *const Node, body: *const Node, start: Token) : Node(NodeType::WHILE_LET, start) {
        (this.pattern, this.expression, this.body) = (pattern, expression, body);
    }
}

class RangeNode : Node {
    pub start: *const Node,
    pub end: *const Node,
    pub inclusive: bool = false;

    RangeNode(&mut this, start: *const Node, end: *const Node, _start: Token) : Node(NodeType::RANGE, _start) {
        (this.start, this.end) = (start, end);
    }
}

class ForNode : Node {
    pub variable: String,
    pub iterable: *const Node,
    pub body: *const Node;

    ForNode(&mut this, variable: String, iterable: *const Node, body: *const Node, start: Token) : Node(NodeType::FOR, start) {
        (this.variable, this.iterable, this.body) = (variable, iterable, body);
    }
}

class ExternNode : Node {
    pub linkage: String,
    pub declarations: Vector<*const Node>;

    ExternNode(&mut this, linkage: String, start: Token) : Node(NodeType::EXTERN, start) {
        this.linkage = linkage;
    }
}

class UnsafeNode : Node {
    pub body: *const BlockNode;

    UnsafeNode(&mut this, body: *const BlockNode, start: Token) : Node(NodeType::UNSAFE, start) {
        this.body = body;
    }
}

class AssemblyNode : Node {
    pub _volatile: bool, pub code: String,
    pub inputs: Vector<Pair<String, *const Node>>,
    pub outputs: Vector<Pair<String, *const Node>>,
    pub clobbers: Vector<String>;

    AssemblyNode(&mut this, _volatile: bool, start: Token) : Node(NodeType::ASSEMBLY, start) {
        this._volatile = _volatile;
    }
}

class RootNode : Node {
    pub declarations: Vector<*const Node>;

    RootNode(&mut this) : Node(NodeType::ROOT, Token(), Token()) {}
}
