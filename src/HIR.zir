#[include "std/str", "std/vec", "src/Tokens.zir", "src/Types.zir" : *]

enum HIRExpressionKind: u8 {
    IntegerLiteral, FloatLiteral, BooleanLiteral, CharacterLiteral, StringLiteral, NullLiteral,
    VariableRef, DeclarationRef, Call, Unary, Binary, Ternary, Assignment, Cast, IndexAccess, MemberAccess,
    New, Delete, Construct, Destruct, StructureInitializer, Intrinsic, Deferred, Dereference, AddressOf, Temporary
}

enum HIRExpressionCategory: u8 {
    Place, Value
}

class HIRExpression {
    pub kind: HIRExpressionKind,
    pub _type: *SemanticType,
    pub category: HIRExpressionCategory = ::HIRExpressionCategory::Value,
    pub mutable: bool = false,
    pub deferred: *Node = null;

    HIRExpression(&mut this, kind: HIRExpressionKind, _type: *SemanticType) {
        (this.kind, this._type) = (kind, _type);
    }

    HIRExpression(&mut this, kind: HIRExpressionKind, _type: *SemanticType, category: HIRExpressionCategory, mutable: bool) {
        (this.kind, this._type, this.category, this.mutable) = (kind, _type, category, mutable);
    }

    HIRExpression(&mut this, kind: HIRExpressionKind, _type: *SemanticType, deferred: *Node) {
        (this.kind, this._type, this.deferred) = (kind, _type, deferred);
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        if this.kind == HIRExpressionKind::IntegerLiteral {
            result += String::FromInteger((this as *HIRIntegerLiteral)->value);
        } else if this.kind == HIRExpressionKind::FloatLiteral {
            result += String::FromFloat((this as *HIRFloatLiteral)->value);
        } else if this.kind == HIRExpressionKind::BooleanLiteral {
            result += (this as *HIRBooleanLiteral)->value ? "true" : "false";
        } else if this.kind == HIRExpressionKind::CharacterLiteral {
            result += '\'' + String((this as *HIRCharacterLiteral)->value as i8).Escape() + '\'';
        } else if this.kind == HIRExpressionKind::StringLiteral {
            result += '"' + (this as *HIRStringLiteral)->value.Escape() + '"';
        } else if this.kind == HIRExpressionKind::NullLiteral {
            result += "null";
        } else if this.kind == HIRExpressionKind::VariableRef {
            result += '%' + (this as *HIRVariableRef)->variable->name;
        } else if this.kind == HIRExpressionKind::DeclarationRef {
            if (this as *HIRDeclarationRef)->declaration->kind == HIRDeclarationKind::Parameter {
                result += '%' + (this as *HIRDeclarationRef)->declaration->name;
            } else if (this as *HIRDeclarationRef)->declaration->kind == HIRDeclarationKind::Function {
                result += "@\"" + (this as *HIRDeclarationRef)->declaration->name + '"';
            } else {
                result += '@' + (this as *HIRDeclarationRef)->declaration->name;
            }
        } else if this.kind == HIRExpressionKind::Call {
            let call = this as *HIRCall;
            result += "call " + call->function->ToString() + '(';

            for i in 0..call->arguments.Size() {
                if i != 0 { result += ", "; }
                result += call->arguments[i]->ToString();
            } result += ')';
        } else if this.kind == HIRExpressionKind::Unary {
            let unary = this as *HIRUnary;
            result += ToUnaryOperatorString(unary->_operator) + '(' + unary->operand->ToString() + ')';
        } else if this.kind == HIRExpressionKind::Binary {
            let binary = this as *HIRBinary;
            result += '(' + binary->left->ToString() + ' ' + ToBinaryOperatorString(binary->_operator) + ' ' + binary->right->ToString() + ')';
        } else if this.kind == HIRExpressionKind::Ternary {
            let ternary = this as *HIRTernary;
            result += '(' + ternary->condition->ToString() + " ? " + ternary->then->ToString() + " : " + ternary->_else->ToString() + ')';
        } else if this.kind == HIRExpressionKind::Assignment {
            let assignment = this as *HIRAssignment;
            result += assignment->left->ToString() + " = " + assignment->right->ToString();
        } else if this.kind == HIRExpressionKind::Cast {
            result += (this as *HIRCast)->value->ToString() + " as " + this._type->ToString();
        } else if this.kind == HIRExpressionKind::IndexAccess {
            let access = this as *HIRIndexAccess;
            result += access->value->ToString() + '[' + access->index->ToString() + ']';
        } else if this.kind == HIRExpressionKind::MemberAccess {
            let access = this as *HIRMemberAccess;
            result += "(member " + access->instance->ToString() + ", " + String::FromInteger(access->index as u64) + ')';
        } else if this.kind == HIRExpressionKind::Dereference {
            result += "*(" + (this as *HIRDereference)->operand->ToString() + ')';
        } else if this.kind == HIRExpressionKind::AddressOf {
            result += "&(" + (this as *HIRAddressOf)->operand->ToString() + ')';
        } else if this.kind == HIRExpressionKind::Temporary {
            result += "(temporary " + (this as *HIRTemporary)->initializer->ToString() + ')';
        } else {
            result += "<invalid expression>";
        } return result;
    }
}

class HIRBooleanLiteral : HIRExpression {
    pub value: bool;

    HIRBooleanLiteral(&mut this, value: bool, _type: *SemanticType) : HIRExpression(HIRExpressionKind::BooleanLiteral, _type) {
        this.value = value;
    }
}

class HIRCharacterLiteral : HIRExpression {
    pub value: u32;

    HIRCharacterLiteral(&mut this, value: u32, _type: *SemanticType) : HIRExpression(HIRExpressionKind::CharacterLiteral, _type) {
        this.value = value;
    }
}

class HIRIntegerLiteral : HIRExpression {
    pub value: u64;

    HIRIntegerLiteral(&mut this, value: u64, _type: *SemanticType) : HIRExpression(HIRExpressionKind::IntegerLiteral, _type) {
        this.value = value;
    }
}

class HIRFloatLiteral : HIRExpression {
    pub value: f64;

    HIRFloatLiteral(&mut this, value: f64, _type: *SemanticType) : HIRExpression(HIRExpressionKind::FloatLiteral, _type) {
        this.value = value;
    }
}

class HIRStringLiteral : HIRExpression {
    pub value: String;

    HIRStringLiteral(&mut this, value: String, _type: *SemanticType) : HIRExpression(HIRExpressionKind::StringLiteral, _type) {
        this.value = value;
    }
}

class HIRNullLiteral : HIRExpression {
    HIRNullLiteral(&mut this, _type: *SemanticType) : HIRExpression(HIRExpressionKind::NullLiteral, _type) {}
}

class HIRDereference : HIRExpression {
    pub operand: *HIRExpression;

    HIRDereference(&mut this, operand: *HIRExpression) : HIRExpression(HIRExpressionKind::Dereference, operand->_type->Pointee(), HIRExpressionCategory::Place, operand->_type->IsMutable()) {
        this.operand = operand;
    }
}

class HIRAddressOf : HIRExpression {
    pub operand: *HIRExpression;

    HIRAddressOf(&mut this, operand: *HIRExpression, mutable: bool) : HIRExpression(HIRExpressionKind::AddressOf, analyzer->type_manager.Reference(operand->_type, mutable)) {
        this.operand = operand;
    }
}

class HIRTemporary : HIRExpression {
    pub initializer: *HIRExpression;

    HIRTemporary(&mut this, initializer: *HIRExpression) : HIRExpression(HIRExpressionKind::Temporary, initializer->_type, HIRExpressionCategory::Place, true) {
        this.initializer = initializer;
    }
}

class HIRVariableRef : HIRExpression {
    pub variable: *HIRVariable;

    HIRVariableRef(&mut this, variable: *HIRVariable) : HIRExpression(HIRExpressionKind::VariableRef, variable->_type, HIRExpressionCategory::Place, variable->mutable) {
        this.variable = variable;
    }
}

class HIRDeclarationRef : HIRExpression {
    pub declaration: *HIRDeclaration;

    HIRDeclarationRef(&mut this, declaration: *HIRDeclaration, mutable: bool) : HIRExpression(HIRExpressionKind::DeclarationRef, declaration->_type, HIRExpressionCategory::Place, mutable) {
        this.declaration = declaration;
    }
}

class HIRCall : HIRExpression {
    pub function: *HIRExpression,
    pub arguments: Vector<*HIRExpression>;

    HIRCall(&mut this, function: *HIRExpression, arguments: &Vector<*HIRExpression>) : HIRExpression(HIRExpressionKind::Call, function->_type->Return()) {
        (this.function, this.arguments) = (function, arguments);
    }
}

