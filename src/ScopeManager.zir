#[include "std/str", "std/vec", "src/Scope.zir", "src/Symbol.zir", "src/Types.zir", "src/Value.zir", "src/Nodes.zir", "src/HIR.zir" : *]

class ScopeManager {
    pub scopes: Vector<*Scope>,
    pub current: *mut Scope = null;

    ScopeManager(&mut this) {
        this.PushScope(String("global"), true);
    }

    ~ScopeManager(&mut this) {
        this.PopScope();
    }

    pub fn PushScope(&mut this, name: &String, global: bool) {
        let scope = new Scope(this.current, name, global);

        if global {
            this.scopes.PushBack(scope);
        }

        if this.current != null {
            this.current->children.PushBack(scope);
        } this.current = scope;
    }

    pub fn PopScope(&mut this) {
        if this.current == null {
            Logger::Log("ScopeManager", "No scope to pop!", LogSeverity::Fatal);
        }

        let temp = this.current;
        this.current = this.current->parent;

        if this.current == null {
            for scope in this.scopes {
                delete scope;
            }
        } else if !temp->global {
            this.current->children.Remove(temp);
            delete temp;
        }
    }

    pub fn Has(&this, name: &String) -> bool {
        let mut scope = this.current;

        while scope != null {
            if scope->Has(name) {
                return true;
            } else {
                scope = scope->parent;
            }
        } return false;
    }

    pub fn Has(&this, name: &String, kind: SymbolKind) -> bool {
        let mut scope = this.current;

        while scope != null {
            if scope->Has(name, kind) {
                return true;
            } else {
                scope = scope->parent;
            }
        } return false;
    }

    pub fn Set(&mut this, name: &String, kind: SymbolKind, value: &SemanticValue, overload: bool, node: *Node) -> *Symbol {
        return this.current->Set(name, kind, value, overload, node);
    }

    pub fn Set(&mut this, name: &String, kind: SymbolKind, _type: *SemanticType, node: *Node) -> *Symbol {
        return this.current->Set(name, kind, _type, node);
    }

    pub fn Set(&mut this, name: &String, declaration: *HIRDeclaration, overload: bool, node: *Node) -> *Symbol {
        return this.current->Set(name, declaration, overload, node);
    }

    pub fn Set(&mut this, name: &String, generic: *mut Generic, node: *Node) -> *Symbol {
        return this.current->Set(name, generic, node);
    }

    pub fn Get(&this, name: &String) -> *Symbol {
        let mut scope = this.current;

        while scope != null {
            if scope->Has(name) {
                return scope->Get(name);
            } else {
                scope = scope->parent;
            }
        } return null;
    }

    pub fn Get(&this, name: &String, kind: SymbolKind) -> *Symbol {
        let mut scope = this.current;

        while scope != null {
            if scope->Has(name, kind) {
                return scope->Get(name, kind);
            } else {
                scope = scope->parent;
            }
        } return null;
    }

    pub fn GetAll(&this, name: &String) -> Vector<*Symbol> {
        let mut result = Vector<*Symbol>();
        let mut scope = this.current;

        while scope != null {
            if scope->Has(name) {
                result += scope->GetAll(name);
            } scope = scope->parent;
        } return result;
    }

    pub fn GetAll(&this, name: &String, kind: SymbolKind) -> Vector<*Symbol> {
        let mut result = Vector<*Symbol>();
        let mut scope = this.current;

        while scope != null {
            if scope->Has(name, kind) {
                result += scope->GetAll(name, kind);
            } scope = scope->parent;
        } return result;
    }

    pub fn Namespaces(&this) -> Vector<String> {
        let mut result = Vector<String>();
        let mut scope = this.current;

        while scope->parent != null {
            if scope->global {
                result.PushBack(scope->name);
            } scope = scope->parent;
        } return result.Reverse();
    }

    pub fn ResolveChild(&this, scope: *Scope, identifier: *IdentifierNode, test: bool) -> *Scope {
        for child in scope->children {
            if child->name == identifier->name {
                return child;
            }
        }

        if !test {
            Logger::Log("Scope '" + identifier->name + "' not found.", identifier, LogSeverity::Error);
        } return null;
    }

    pub fn ResolveChild(&this, scope: *Scope, primitive_type: *PrimitiveTypeNode, test: bool) -> *Scope {
        for child in scope->children {
            if child->name == primitive_type->name {
                return child;
            }
        }

        if !test {
            Logger::Log("Scope '" + primitive_type->name + "' not found.", primitive_type, LogSeverity::Error);
        } return null;
    }

    pub fn ResolveScopeHalf(&this, resolution: *ScopeResolutionNode, test: bool) -> *Scope {
        let mut scope: *Scope = this.current;

        while !scope->global {
            scope = scope->parent;
        }

        if resolution->scope != null {
            if resolution->scope->_type == NodeType::SCOPE_RESOLUTION {
                scope = this.ResolveScopeFull(resolution->scope as *ScopeResolutionNode, test);
            } else if resolution->scope->_type == NodeType::IDENTIFIER {
                scope = this.ResolveChild(scope, resolution->scope as *IdentifierNode, test);
            } else if resolution->scope->_type == NodeType::PRIMITIVE_TYPE {
                scope = this.ResolveChild(scope, resolution->scope as *PrimitiveTypeNode, test);
            } else if resolution->scope->_type == NodeType::TYPE_APPLICATION {
                let type_application = resolution->scope as *TypeApplicationNode;
                let mut types = Vector<*SemanticType>();

                for _type in type_application->types {
                    types.PushBack(analyzer->ResolveType(_type));
                }

                if type_application->expression->_type == NodeType::PRIMITIVE_TYPE {
                    let primitive_type = type_application->expression as *PrimitiveTypeNode;
                    let symbol = this.Resolve(primitive_type->name, primitive_type, test);

                    if symbol != null && symbol->kind == SymbolKind::Generic {
                        scope = symbol->generic->Get(types).right;
                    } else {
                        if !test {
                            if symbol != null {
                                Logger::Log("Type '" + primitive_type->name + "' is not generic.", primitive_type, LogSeverity::Error);
                            } else {
                                Logger::Log("Type '" + primitive_type->name + "' not found.", primitive_type, LogSeverity::Error);
                            }
                        } return null;
                    }
                } else {
                    if !test {
                        Logger::Log("Unknown resolution '" + resolution->scope->_type.ToString() + "'.", resolution->scope, LogSeverity::Error);
                    } return null;
                }
            } else {
                if !test {
                    Logger::Log("Unknown resolution '" + resolution->scope->_type.ToString() + "'.", resolution->scope, LogSeverity::Error);
                } return null;
            }
        } else {
            while scope->parent != null {
                scope = scope->parent;
            }
        } return scope;
    }

    pub fn ResolveScopeFull(&this, resolution: *ScopeResolutionNode, test: bool) -> *Scope {
        return this.ResolveChild(this.ResolveScopeHalf(resolution, test), resolution->identifier, test);
    }

    pub fn Resolve(&this, resolution: *ScopeResolutionNode, test: bool) -> *Symbol {
        let scope = this.ResolveScopeHalf(resolution, test);

        if scope == null {
            return null;
        }

        if scope->Has(resolution->identifier->name) {
            return scope->Get(resolution->identifier->name);
        } else {
            if !test {
                Logger::Log("Symbol '" + resolution->identifier->name + "' not found.", resolution, LogSeverity::Error);
            } return null;
        }
    }

    pub fn Resolve(&this, identifier: *IdentifierNode, test: bool) -> *Symbol {
        if this.Has(identifier->name) {
            return this.Get(identifier->name);
        } else {
            if !test {
                Logger::Log("Symbol '" + identifier->name + "' not found.", identifier, LogSeverity::Error);
            } return null;
        }
    }

    pub fn Resolve(&this, primitive_type: *PrimitiveTypeNode, test: bool) -> *Symbol {
        if this.Has(primitive_type->name) {
            return this.Get(primitive_type->name);
        } else {
            if !test {
                Logger::Log("Symbol '" + primitive_type->name + "' not found.", primitive_type, LogSeverity::Error);
            } return null;
        }
    }

    pub fn Resolve(&this, node: *Node, test: bool) -> *Symbol {
        if node->_type == NodeType::SCOPE_RESOLUTION {
            return this.Resolve(node as *ScopeResolutionNode, test);
        } else if node->_type == NodeType::IDENTIFIER {
            return this.Resolve(node as *IdentifierNode, test);
        } else if node->_type == NodeType::PRIMITIVE_TYPE {
            return this.Resolve(node as *PrimitiveTypeNode, test);
        } else {
            if !test {
                Logger::Log("Unknown resolution '" + node->_type.ToString() + "'.", node, LogSeverity::Error);
            } return null;
        }
    }

    pub fn Resolve(&this, name: &String, node: *Node, test: bool) -> *Symbol {
        if this.Has(name) {
            return this.Get(name);
        } else {
            if !test {
                Logger::Log("Symbol '" + name + "' not found.", node, LogSeverity::Error);
            } return null;
        }
    }

    pub fn ResolveCandidates(&this, resolution: *ScopeResolutionNode, test: bool) -> Vector<*HIRFunction> {
        let result = Vector<*HIRFunction>();
        let scope = this.ResolveScopeHalf(resolution, test);

        if scope->Has(resolution->identifier->name, SymbolKind::Declaration) {
            for symbol in scope->GetAll(resolution->identifier->name, SymbolKind::Declaration) {
                if symbol->declaration->kind == HIRDeclarationKind::Function {
                    result.PushBack(symbol->declaration as *HIRFunction);
                }
            }
        } else if !test {
            Logger::Log("Symbol '" + resolution->identifier->name + "' not found.", resolution, LogSeverity::Error);
        } return result;
    }

    pub fn ResolveCandidates(&this, identifier: *IdentifierNode, test: bool) -> Vector<*HIRFunction> {
        let result = Vector<*HIRFunction>();

        if this.Has(identifier->name, SymbolKind::Declaration) {
            for symbol in this.GetAll(identifier->name, SymbolKind::Declaration) {
                if symbol->declaration->kind == HIRDeclarationKind::Function {
                    result.PushBack(symbol->declaration as *HIRFunction);
                }
            }
        } else if !test {
            Logger::Log("Symbol '" + identifier->name + "' not found.", identifier, LogSeverity::Error);
        } return result;
    }

    pub fn ResolveCandidates(&this, node: *Node, test: bool) -> Vector<*HIRFunction> {
        if node->_type == NodeType::SCOPE_RESOLUTION {
            return this.ResolveCandidates(node as *ScopeResolutionNode, test);
        } else if node->_type == NodeType::IDENTIFIER {
            return this.ResolveCandidates(node as *IdentifierNode, test);
        } else {
            if !test {
                Logger::Log("Unknown resolution '" + node->_type.ToString() + "'.", node, LogSeverity::Error);
            } return Vector<*HIRFunction>();
        }
    }

    pub fn ResolveCandidates(&this, name: &String, node: *Node, test: bool) -> Vector<*HIRFunction> {
        let result = Vector<*HIRFunction>();

        if this.Has(name, SymbolKind::Declaration) {
            for symbol in this.GetAll(name, SymbolKind::Declaration) {
                if symbol->declaration->kind == HIRDeclarationKind::Function {
                    result.PushBack(symbol->declaration as *HIRFunction);
                }
            }
        } else if !test {
            Logger::Log("Symbol '" + name + "' not found.", node, LogSeverity::Error);
        } return result;
    }
}

#[include "src/SemanticAnalyzer.zir" : *]
