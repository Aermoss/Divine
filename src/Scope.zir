#[include "std/str", "std/vec", "src/Symbol.zir", "src/Value.zir" : *]

class Scope {
    pub parent: *mut Scope,
    pub children: Vector<*Scope>,
    pub name: String, pub global: bool,
    pub symbols: Vector<*Symbol>,
    pub instances: Vector<QualifiedValue>;

    Scope(&mut this, parent: *mut Scope, name: &String, global: bool) {
        (this.parent, this.name, this.global) = (parent, name, global);
    }

    ~Scope(&this) {
        for symbol in this.symbols {
            delete symbol;
        }
    }

    pub fn Has(&this, name: &String) -> bool {
        for symbol in this.symbols {
            if symbol->name == name {
                return true;
            }
        } return false;
    }
    
    pub fn Has(&this, name: &String, kind: SymbolKind) -> bool {
        for symbol in this.symbols {
            if symbol->name == name && symbol->kind == kind {
                return true;
            }
        } return false;
    }

    pub fn Set(&mut this, name: &String, kind: SymbolKind, value: &QualifiedValue, overload: bool, node: *Node) -> *Symbol {
        if this.Has(name) && !overload {
            Logger::Log("Symbol '" + name + "' already exists.", node, LogSeverity::Error);
            return null;
        } else {
            let symbol: *Symbol = new Symbol(name, kind, value);
            this.symbols.PushBack(symbol);
            return symbol;
        }
    }

    pub fn Set(&mut this, name: &String, kind: SymbolKind, pointer: *void, overload: bool, node: *Node) -> *Symbol {
        if this.Has(name) && !overload {
            Logger::Log("Symbol '" + name + "' already exists.", node, LogSeverity::Error);
            return null;
        } else {
            let symbol: *Symbol = new Symbol(name, kind, pointer);
            this.symbols.PushBack(symbol);
            return symbol;
        }
    }

    pub fn Get(&this, name: &String) -> *Symbol {
        for symbol in this.symbols {
            if symbol->name == name {
                return symbol;
            }
        } return null;
    }

    pub fn Get(&this, name: &String, kind: SymbolKind) -> *Symbol {
        for symbol in this.symbols {
            if symbol->name == name && symbol->kind == kind {
                return symbol;
            }
        } return null;
    }

    pub fn GetAll(&this, name: &String) -> Vector<*Symbol> {
        let mut result: Vector<*Symbol>;

        for symbol in this.symbols {
            if symbol->name == name {
                result.PushBack(symbol);
            }
        } return result;
    }

    pub fn GetAll(&this, name: &String, kind: SymbolKind) -> Vector<*Symbol> {
        let mut result: Vector<*Symbol>;

        for symbol in this.symbols {
            if symbol->name == name && symbol->kind == kind {
                result.PushBack(symbol);
            }
        } return result;
    }
}
