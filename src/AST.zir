#[include "std/str", "std/vec", "std/map", "std/pair", "src/Tokens.zir" : *]

enum ASTNodeKind: i32 {
    ROOT, ASSEMBLY, UNSAFE,

    Declaration, VARIANT,

    IF, IF_LET, WHILE, WHILE_LET, FOR, LOOP,
    MATCH, CASE, DEFAULT, RETURN, BREAK, CONTINUE,
    VARIABLE, BLOCK, EXPRESSION,

    UNARY, BINARY, TERNARY, ASSIGNMENT, CALL, CAST, NEW, DELETE,
    LITERAL, IDENTIFIER, SCOPE_RESOLUTION, PACK_SPLAT, MEMBER_ACCESS, INDEX_ACCESS,
    RANGE, AWAIT, TUPLE, INITIALIZER_LIST, STRUCTURE_INITIALIZER, OR_PATTERN, TYPE_APPLICATION,

    PRIMITIVE_TYPE, POINTER_TYPE, REFERENCE_TYPE, ARRAY_TYPE, FUNCTION_TYPE
}

fn ToString(kind: ASTNodeKind) -> String {
    if kind == ASTNodeKind::ROOT { return "ROOT".ToString(); }
    else if kind == ASTNodeKind::ASSEMBLY { return "ASSEMBLY".ToString(); }
    else if kind == ASTNodeKind::UNSAFE { return "UNSAFE".ToString(); }
    else if kind == ASTNodeKind::Declaration { return "Declaration".ToString(); }
    else if kind == ASTNodeKind::IF { return "IF".ToString(); }
    else if kind == ASTNodeKind::IF_LET { return "IF_LET".ToString(); }
    else if kind == ASTNodeKind::WHILE { return "WHILE".ToString(); }
    else if kind == ASTNodeKind::WHILE_LET { return "WHILE_LET".ToString(); }
    else if kind == ASTNodeKind::FOR { return "FOR".ToString(); }
    else if kind == ASTNodeKind::LOOP { return "LOOP".ToString(); }
    else if kind == ASTNodeKind::MATCH { return "MATCH".ToString(); }
    else if kind == ASTNodeKind::CASE { return "CASE".ToString(); }
    else if kind == ASTNodeKind::DEFAULT { return "DEFAULT".ToString(); }
    else if kind == ASTNodeKind::RETURN { return "RETURN".ToString(); }
    else if kind == ASTNodeKind::BREAK { return "BREAK".ToString(); }
    else if kind == ASTNodeKind::CONTINUE { return "CONTINUE".ToString(); }
    else if kind == ASTNodeKind::VARIABLE { return "VARIABLE".ToString(); }
    else if kind == ASTNodeKind::BLOCK { return "BLOCK".ToString(); }
    else if kind == ASTNodeKind::EXPRESSION { return "EXPRESSION".ToString(); }
    else if kind == ASTNodeKind::UNARY { return "UNARY".ToString(); }
    else if kind == ASTNodeKind::BINARY { return "BINARY".ToString(); }
    else if kind == ASTNodeKind::TERNARY { return "TERNARY".ToString(); }
    else if kind == ASTNodeKind::ASSIGNMENT { return "ASSIGNMENT".ToString(); }
    else if kind == ASTNodeKind::CALL { return "CALL".ToString(); }
    else if kind == ASTNodeKind::CAST { return "CAST".ToString(); }
    else if kind == ASTNodeKind::NEW { return "NEW".ToString(); }
    else if kind == ASTNodeKind::DELETE { return "DELETE".ToString(); }
    else if kind == ASTNodeKind::LITERAL { return "LITERAL".ToString(); }
    else if kind == ASTNodeKind::IDENTIFIER { return "IDENTIFIER".ToString(); }
    else if kind == ASTNodeKind::SCOPE_RESOLUTION { return "SCOPE_RESOLUTION".ToString(); }
    else if kind == ASTNodeKind::PACK_SPLAT { return "PACK_SPLAT".ToString(); }
    else if kind == ASTNodeKind::MEMBER_ACCESS { return "MEMBER_ACCESS".ToString(); }
    else if kind == ASTNodeKind::INDEX_ACCESS { return "INDEX_ACCESS".ToString(); }
    else if kind == ASTNodeKind::RANGE { return "RANGE".ToString(); }
    else if kind == ASTNodeKind::AWAIT { return "AWAIT".ToString(); }
    else if kind == ASTNodeKind::TUPLE { return "TUPLE".ToString(); }
    else if kind == ASTNodeKind::INITIALIZER_LIST { return "INITIALIZER_LIST".ToString(); }
    else if kind == ASTNodeKind::STRUCTURE_INITIALIZER { return "STRUCTURE_INITIALIZER".ToString(); }
    else if kind == ASTNodeKind::OR_PATTERN { return "OR_PATTERN".ToString(); }
    else if kind == ASTNodeKind::TYPE_APPLICATION { return "TYPE_APPLICATION".ToString(); }
    else if kind == ASTNodeKind::PRIMITIVE_TYPE { return "PRIMITIVE_TYPE".ToString(); }
    else if kind == ASTNodeKind::POINTER_TYPE { return "POINTER_TYPE".ToString(); }
    else if kind == ASTNodeKind::REFERENCE_TYPE { return "REFERENCE_TYPE".ToString(); }
    else if kind == ASTNodeKind::ARRAY_TYPE { return "ARRAY_TYPE".ToString(); }
    else if kind == ASTNodeKind::FUNCTION_TYPE { return "FUNCTION_TYPE".ToString(); }
    else { return "UNKNOWN".ToString(); }
}

class ASTNode {
    pub kind: ASTNodeKind,
    pub start: Token,
    pub end: Token;

    ASTNode(&mut this, kind: ASTNodeKind, start: Token) {
        (this.kind, this.start) = (kind, start);
    }
}

class ASTPrimitiveType : ASTNode {
    pub name: String;

    ASTPrimitiveType(&mut this, name: String, start: Token) : ASTNode(ASTNodeKind::PRIMITIVE_TYPE, start) {
        this.name = name;
    }
}

class ASTPointerType : ASTNode {
    pub base_type: *ASTNode,
    pub mutable: bool;

    ASTPointerType(&mut this, base_type: *ASTNode, mutable: bool, start: Token) : ASTNode(ASTNodeKind::POINTER_TYPE, start) {
        (this.base_type, this.mutable) = (base_type, mutable);
    }
}

class ASTReferenceType : ASTNode {
    pub base_type: *ASTNode,
    pub mutable: bool;

    ASTReferenceType(&mut this, base_type: *ASTNode, mutable: bool, start: Token) : ASTNode(ASTNodeKind::REFERENCE_TYPE, start) {
        (this.base_type, this.mutable) = (base_type, mutable);
    }
}

class ASTArrayType : ASTNode {
    pub element_type: *ASTNode,
    pub size: *ASTNode;

    ASTArrayType(&mut this, element_type: *ASTNode, size: *ASTNode, start: Token) : ASTNode(ASTNodeKind::ARRAY_TYPE, start) {
        (this.element_type, this.size) = (element_type, size);
    }
}

class ASTExpression : ASTNode {
    pub expression: *ASTNode;

    ASTExpression(&mut this, expression: *ASTNode, start: Token) : ASTNode(ASTNodeKind::EXPRESSION, start) {
        this.expression = expression;
    }
}

class ASTLiteral : ASTNode {
    pub value: String,
    pub _type: TokenType;

    ASTLiteral(&mut this, value: String, _type: TokenType, start: Token) : ASTNode(ASTNodeKind::LITERAL, start) {
        (this.value, this._type) = (value, _type);
    }
}

class ASTIdentifier : ASTNode {
    pub name: String;

    ASTIdentifier(&mut this, name: String, start: Token) : ASTNode(ASTNodeKind::IDENTIFIER, start) {
        this.name = name;
    }
}

class ASTScopeResolution : ASTNode {
    pub scope: *ASTNode,
    pub identifier: *ASTIdentifier;

    ASTScopeResolution(&mut this, scope: *ASTNode, identifier: *ASTIdentifier, start: Token) : ASTNode(ASTNodeKind::SCOPE_RESOLUTION, start) {
        (this.scope, this.identifier) = (scope, identifier);
    }
}

class ASTUnary : ASTNode {
    pub operand: *ASTNode,
    pub _operator: TokenType,
    pub mutable: bool;

    ASTUnary(&mut this, operand: *ASTNode, _operator: TokenType, mutable: bool, start: Token) : ASTNode(ASTNodeKind::UNARY, start) {
        (this.operand, this._operator, this.mutable) = (operand, _operator, mutable);
    }
}

class ASTBinary : ASTNode {
    pub left: *ASTNode,
