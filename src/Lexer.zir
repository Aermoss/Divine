include "std/str", "std/vec", "src/Logger.zir", "src/Tokens.zir" : *;

class Lexer {
    priv row: u64, priv column: u64,
    priv text: String, priv file: String,
    priv length: u64, priv index: u64,
    priv preprocessor: bool = false,
    priv assembly: bool = false;

    priv IsDigit(&this, character: i8) -> bool {
        ret character >= '0' && character <= '9';
    }

    priv IsHexDigit(&this, character: i8) -> bool {
        ret (character >= '0' && character <= '9') || (character >= 'a' && character <= 'f') || (character >= 'A' && character <= 'F');
    }

    priv IsBinDigit(&this, character: i8) -> bool {
        ret character == '0' || character == '1';
    }

    priv IsOctDigit(&this, character: i8) -> bool {
        ret character >= '0' && character <= '7';
    }

    priv IsAlpha(&this, character: i8) -> bool {
        ret (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') || character == '_';
    }

    priv IsAlphaNum(&this, character: i8) -> bool {
        ret this.IsAlpha(character) || this.IsDigit(character);
    }

    priv CurrentChar(&this) -> i8 {
        if this.index >= this.length { ret '\0'; }
        ret this.text.Data()[this.index];
    }

    priv PeekChar(&this, offset: u64) -> i8 {
        let peek_index: u64 = this.index + offset;
        if peek_index >= this.length { ret '\0'; }
        ret this.text.Data()[peek_index];
    }

    priv Advance(&mut this, count: u64) {
        let mut i: u64 = 0u64;

        while i < count {
            if this.index < this.length {
                if this.CurrentChar() == '\n' {
                    this.row += 1u64;
                    this.column = 1u64;
                } else {
                    this.column += 1u64;
                } this.index += 1u64;
            } i += 1u64;
        }
    }

    priv SkipWhitespace(&mut this) {
        while this.CurrentChar() == ' ' || this.CurrentChar() == '\t' || this.CurrentChar() == '\r' {
            this.Advance(1u64);
        }
    }

    priv SkipComment(&mut this) -> bool {
        if this.CurrentChar() == '/' {
            if this.PeekChar(1u64) == '/' {
                while this.CurrentChar() != '\n' && this.CurrentChar() != '\0' {
                    this.Advance(1u64);
                } ret true;
            } else if this.PeekChar(1u64) == '*' {
                this.Advance(2u64);

                while this.CurrentChar() != '\0' {
                    if this.CurrentChar() == '*' && this.PeekChar(1u64) == '/' {
                        this.Advance(2u64);
                        break;
                    } this.Advance(1u64);
                } ret true;
            }
        } ret false;
    }

    priv LexString(&mut this) -> Token {
        let mut token: Token;
        (token.row, token.column) = (this.row, this.column);
        let quote_char: i8 = this.CurrentChar();
        token._type = quote_char != '"' ? TokenType::CHAR : TokenType::STRING;
        this.Advance(1u64);

        while this.CurrentChar() != quote_char && this.CurrentChar() != '\n' && this.CurrentChar() != '\0' {
            if this.CurrentChar() == '\\' {
                this.Advance(1u64);

                if this.CurrentChar() != '\0' {
                    let escaped: i8 = this.CurrentChar();

                    if escaped == '\'' {
                        token.value += "'";
                    } else if escaped == '"' {
                        token.value += "\"";
                    } else if escaped == '?' {
                        token.value += "\?";
                    } else if escaped == '\\' {
                        token.value += "\\";
                    } else if escaped == 'a' {
                        token.value += "\a";
                    } else if escaped == 'b' {
                        token.value += "\b";
                    } else if escaped == 'f' {
                        token.value += "\f";
                    } else if escaped == 'n' {
                        token.value += "\n";
                    } else if escaped == 'r' {
                        token.value += "\r";
                    } else if escaped == 't' {
                        token.value += "\t";
                    } else if escaped == 'v' {
                        token.value += "\v";
                    } else if escaped == 'x' {
                        this.Advance(1u64);
                        let mut value: String;

                        while this.IsHexDigit(this.CurrentChar()) {
                            value += this.CurrentChar();
                            this.Advance(1u64);
                        } else {
                            Logger::Log(this.file, token.row, token.column, "Invalid hexadecimal escape sequence.", LogSeverity::Error);
                        }

                        if value.Size() > 3u64 {
                            Logger::Log(this.file, token.row, token.column, "Hexadecimal escape sequence too long.", LogSeverity::Error);
                        }

                        token.value += value.ToInteger(16i64) as i8;
                        this.index -= 1u64;
                    } else {
                        let mut value: String;

                        while this.IsOctDigit(this.CurrentChar()) {
                            value += this.CurrentChar();
                            this.Advance(1u64);
                        } else {
                            Logger::Log(this.file, token.row, token.column, "Invalid octal escape sequence.", LogSeverity::Error);
                        }

                        if value.Size() > 4u64 {
                            Logger::Log(this.file, token.row, token.column, "Octal escape sequence too long.", LogSeverity::Error);
                        }

                        token.value += value.ToInteger(8i64) as i8;
                        this.index -= 1u64;
                    } this.Advance(1u64);
                }
            } else {
                token.value += this.CurrentChar();
                this.Advance(1u64);
            }
        }

        if this.CurrentChar() == quote_char {
            this.Advance(1u64);
        } else {
            Logger::Log(this.file, token.row, token.column, "Unterminated string literal.", LogSeverity::Error);
        } ret token;
    }

    priv LexNumber(&mut this) -> Token {
        let mut token: Token;
        (token.row, token.column) = (this.row, this.column);
        token._type = TokenType::INTEGER;

        if this.CurrentChar() == '0' {
            token.value += this.CurrentChar();
            this.Advance(1u64);

            if this.CurrentChar() == 'x' || this.CurrentChar() == 'X' {
                token.value += this.CurrentChar();
                this.Advance(1u64);

                while this.IsHexDigit(this.CurrentChar()) {
                    token.value += this.CurrentChar();
                    this.Advance(1u64);
                }
            } else if this.CurrentChar() == 'b' || this.CurrentChar() == 'B' {
                token.value += this.CurrentChar();
                this.Advance(1u64);

                while this.IsBinDigit(this.CurrentChar()) {
                    token.value += this.CurrentChar();
                    this.Advance(1u64);
                }
            } else if this.CurrentChar() == 'o' || this.CurrentChar() == 'O' {
                token.value += this.CurrentChar();
                this.Advance(1u64);

                while this.IsOctDigit(this.CurrentChar()) {
                    token.value += this.CurrentChar();
                    this.Advance(1u64);
                }
            } else {
                while this.IsDigit(this.CurrentChar()) {
                    token.value += this.CurrentChar();
                    this.Advance(1u64);
                }
            }
        } else {
            while this.IsDigit(this.CurrentChar()) {
                token.value += this.CurrentChar();
                this.Advance(1u64);
            }
        }

        if this.CurrentChar() == '.' && this.IsDigit(this.PeekChar(1u64)) {
            token._type = TokenType::FLOAT;
            token.value += this.CurrentChar();
            this.Advance(1u64);

            while this.IsDigit(this.CurrentChar()) {
                token.value += this.CurrentChar();
                this.Advance(1u64);
            }
        }

        if this.CurrentChar() == 'e' || this.CurrentChar() == 'E' {
            token._type = TokenType::FLOAT;
            token.value += this.CurrentChar();
            this.Advance(1u64);

            if this.CurrentChar() == '+' || this.CurrentChar() == '-' {
                token.value += this.CurrentChar();
                this.Advance(1u64);
            }

            while this.IsDigit(this.CurrentChar()) {
                token.value += this.CurrentChar();
                this.Advance(1u64);
            }
        }

        if this.CurrentChar() == 'i' || this.CurrentChar() == 'u' {
            token.value += this.CurrentChar();
            this.Advance(1u64);

            while this.IsDigit(this.CurrentChar()) {
                token.value += this.CurrentChar();
                this.Advance(1u64);
            }
        } else if this.CurrentChar() == 'f' {
            token._type = TokenType::FLOAT;
            token.value += this.CurrentChar();
            this.Advance(1u64);

            while this.IsDigit(this.CurrentChar()) {
                token.value += this.CurrentChar();
                this.Advance(1u64);
            }
        } ret token;
    }

    priv LexIdentifier(&mut this) -> Token {
        let mut token: Token;
        (token.row, token.column) = (this.row, this.column);

        loop {
            let byte: u8 = this.CurrentChar() as u8;

            if byte > 0x7Fu8 {
                token.value += byte as i8;
                token.value += this.PeekChar(1u64);

                if (byte & 0xE0u8) == 0xC0u8 {
                    this.Advance(2u64);
                } else {
                    token.value += this.PeekChar(2u64);

                    if (byte & 0xF0u8) == 0xE0u8 {
                        this.Advance(3u64);
                    } else {
                        token.value += this.PeekChar(3u64);
                        this.Advance(4u64);
                    }
                }
            } else {
                if token.value.Size() > 1u64 ? this.IsAlphaNum(byte as i8) : this.IsAlpha(byte as i8) {
                    token.value += byte as i8;
                    this.Advance(1u64);
                } else {
                    break;
                }
            }
        }

        if this.preprocessor {
            token._type = StringToDirective(token.value);
        } else {
            token._type = StringToKeyword(token.value);

            if token._type == TokenType::ASSEMBLY {
                this.assembly = true;
            }
        }

        if token._type == TokenType::UNKNOWN {
            token._type = TokenType::IDENTIFIER;
        } ret token;
    }

    priv LexSymbol(&mut this) -> Token {
        let mut token: Token;
        (token.row, token.column) = (this.row, this.column);
        let current: i8 = this.CurrentChar();
        let next: i8 = this.PeekChar(1u64);
        token.value += current;

        if current == '@' {
            token._type = TokenType::AT;
            this.Advance(1u64);
        } else if current == '#' && next == '[' {
            token.value += next;
            this.preprocessor = true;
            token._type = TokenType::PREPROCESSOR_START;
            this.Advance(2u64);
        } else if current == '+' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::PLUS_ASSIGN;
                this.Advance(2u64);
            } else {
                token._type = TokenType::PLUS;
                this.Advance(1u64);
            }
        } else if current == '-' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::MINUS_ASSIGN;
                this.Advance(2u64);
            } else if next == '>' {
                token.value += next;
                token._type = TokenType::ARROW;
                this.Advance(2u64);
            } else {
                token._type = TokenType::MINUS;
                this.Advance(1u64);
            }
        } else if current == '*' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::MUL_ASSIGN;
                this.Advance(2u64);
            } else {
                token._type = TokenType::MUL;
                this.Advance(1u64);
            }
        } else if current == '/' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::DIV_ASSIGN;
                this.Advance(2u64);
            } else {
                token._type = TokenType::DIV;
                this.Advance(1u64);
            }
        } else if current == '%' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::MOD_ASSIGN;
                this.Advance(2u64);
            } else {
                token._type = TokenType::MOD;
                this.Advance(1u64);
            }
        } else if current == '<' {
            if next == '<' && this.PeekChar(2u64) == '=' {
                token.value += next;
                token.value += this.PeekChar(2u64);
                token._type = TokenType::LSHIFT_ASSIGN;
                this.Advance(3u64);
            } else if next == '=' {
                token.value += next;
                token._type = TokenType::LESS_EQUAL;
                this.Advance(2u64);
            } else {
                token._type = TokenType::LESS;
                this.Advance(1u64);
            }
        } else if current == '>' {
            if next == '>' && this.PeekChar(2u64) == '=' {
                token.value += next;
                token.value += this.PeekChar(2u64);
                token._type = TokenType::RSHIFT_ASSIGN;
                this.Advance(3u64);
            } else if next == '=' {
                token.value += next;
                token._type = TokenType::GREATER_EQUAL;
                this.Advance(2u64);
            } else {
                token._type = TokenType::GREATER;
                this.Advance(1u64);
            }
        } else if current == '&' {
            if next == '&' {
                token.value += next;
                token._type = TokenType::AND;
                this.Advance(2u64);
            } else if next == '=' {
                token.value += next;
                token._type = TokenType::AND_ASSIGN;
                this.Advance(2u64);
            } else {
                token._type = TokenType::BITWISE_AND;
                this.Advance(1u64);
            }
        } else if current == '|' {
            if next == '|' {
                token.value += next;
                token._type = TokenType::OR;
                this.Advance(2u64);
            } else if next == '=' {
                token.value += next;
                token._type = TokenType::OR_ASSIGN;
                this.Advance(2u64);
            } else {
                token._type = TokenType::BITWISE_OR;
                this.Advance(1u64);
            }
        } else if current == '^' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::XOR_ASSIGN;
                this.Advance(2u64);
            } else {
                token._type = TokenType::BITWISE_XOR;
                this.Advance(1u64);
            }
        } else if current == '=' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::EQUAL;
                this.Advance(2u64);
            } else if next == '>' {
                token.value += next;
                token._type = TokenType::FAT_ARROW;
                this.Advance(2u64);
            } else {
                token._type = TokenType::ASSIGN;
                this.Advance(1u64);
            }
        } else if current == '!' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::NOT_EQUAL;
                this.Advance(2u64);
            } else {
                token._type = TokenType::NOT;
                this.Advance(1u64);
            }
        } else if current == '?' {
            token._type = TokenType::QUESTION_MARK;
            this.Advance(1u64);
        } else if current == '~' {
            token._type = TokenType::TILDE;
            this.Advance(1u64);
        } else if current == '.' {
            if next == '.' {
                if this.PeekChar(2u64) == '.' {
                    token.value += this.PeekChar(2u64);
                    token._type = TokenType::THREE_DOT;
                    this.Advance(3u64);
                } else {
                    token.value += next;
                    token._type = TokenType::TWO_DOT;
                    this.Advance(2u64);
                }
            } else {
                token._type = TokenType::DOT;
                this.Advance(1u64);
            }
        } else if current == ',' {
            token._type = TokenType::COMMA;
            this.Advance(1u64);
        } else if current == ':' {
            if next == ':' {
                token.value += next;
                token._type = TokenType::DOUBLE_COLON;
                this.Advance(2u64);
            } else {
                token._type = TokenType::COLON;
                this.Advance(1u64);
            }
        } else if current == ';' {
            if this.assembly {
                Logger::Log(this.file, token.row, token.column, "Expected an assembly block before the semicolon.", LogSeverity::Error);
            }

            token._type = TokenType::SEMICOLON;
            this.Advance(1u64);
        } else if current == '(' {
            token._type = TokenType::LPAREN;
            this.Advance(1u64);
        } else if current == ')' {
            token._type = TokenType::RPAREN;
            this.Advance(1u64);
        } else if current == '[' {
            token._type = TokenType::LBRACKET;
            this.Advance(1u64);
        } else if current == ']' {
            if this.preprocessor {
                this.preprocessor = false;
                token._type = TokenType::PREPROCESSOR_END;
                this.Advance(1u64);
            } else {
                token._type = TokenType::RBRACKET;
                this.Advance(1u64);
            }
        } else if current == '{' {
            token._type = TokenType::LBRACE;
            this.Advance(1u64);
        } else if current == '}' {
            token._type = TokenType::RBRACE;
            this.Advance(1u64);
        } else if current == '\\' {
            token._type = TokenType::BACKSLASH;
            this.Advance(1u64);
        } else {
            Logger::Log(this.file, this.row, this.column, "Invalid symbol '" + current.ToString() + "'.", LogSeverity::Error);
            this.Advance(1u64);
        } ret token;
    }

    priv LexAssembly(&mut this) -> Token {
        let (mut token: Token, mut accumulator: String);
        (token.row, token.column, token._type) = (this.row, this.column, TokenType::ASM_CODE);
        let (mut indent: i32, mut state: bool) = (1i32, true);
        this.Advance(1u64);

        while this.CurrentChar() != '\0' {
            let character: i8 = this.CurrentChar();

            if character == '{' {
                indent += 1i32;
            } else if character == '}' {
                indent -= 1i32;

                if indent == 0i32 {
                    break;
                }
            }

            if character != ' ' && character != '\t' && character != '\n' && character != '\r' {
                if !accumulator.Empty() {
                    token.value += accumulator;
                    accumulator.Clear();
                }

                state = false;
                token.value += character;
            } else if !state {
                state = character == '\n' || character == '\r';
                accumulator += character;
            } this.Advance(1u64);
        }

        if indent > 0i32 {
            Logger::Log(this.file, token.row, token.column, "Unterminated assembly block.", LogSeverity::Error);
        }

        this.Advance(1u64);
        this.assembly = false;
        ret token;
    }

    pub Lex(&mut this, text: String, file: String) -> Vector<Token> {
        (this.index, this.row, this.column) = (0u64, 1u64, 1u64);
        (this.file, this.text, this.length) = (file, text, text.Size());
        let mut tokens: Vector<Token>;

        while this.CurrentChar() != '\0' {
            this.SkipWhitespace();

            if this.CurrentChar() == '\0' {
                break;
            }

            if this.CurrentChar() == '\n' {
                this.Advance(1u64);
                continue;
            }

            if this.SkipComment() {
                continue;
            }

            let character: i8 = this.CurrentChar();

            if character == '"' || character == '\'' {
                tokens.PushBack(this.LexString());
            } else if this.IsDigit(character) || (character == '.' && this.IsDigit(this.PeekChar(1u64))) {
                tokens.PushBack(this.LexNumber());
            } else if this.IsAlpha(character) || (character as u8) > 0x7Fu8 {
                tokens.PushBack(this.LexIdentifier());
            } else {
                if this.assembly && character == '{' {
                    tokens.PushBack(this.LexAssembly());
                } else {
                    tokens.PushBack(this.LexSymbol());
                }
            }
        }

        let mut eof: Token;
        (eof._type, eof.row, eof.column) = (TokenType::EOF, this.row, this.column);
        tokens.PushBack(eof);
        ret tokens;
    }
}
