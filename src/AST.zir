enum ASTStatementKind: u8 {
    Variable, Expression, If, While, Loop, For, Return, Break, Continue, Block, Unsafe, Assembly
}

fn ToString(kind: ASTStatementKind) -> String {
    if kind == ASTStatementKind::Variable { return "Variable".ToString(); }
    else if kind == ASTStatementKind::Expression { return "Expression".ToString(); }
    else if kind == ASTStatementKind::If { return "If".ToString(); }
    else if kind == ASTStatementKind::While { return "While".ToString(); }
    else if kind == ASTStatementKind::Loop { return "Loop".ToString(); }
    else if kind == ASTStatementKind::For { return "For".ToString(); }
    else if kind == ASTStatementKind::Return { return "Return".ToString(); }
    else if kind == ASTStatementKind::Break { return "Break".ToString(); }
    else if kind == ASTStatementKind::Continue { return "Continue".ToString(); }
    else if kind == ASTStatementKind::Block { return "Block".ToString(); }
    else if kind == ASTStatementKind::Unsafe { return "Unsafe".ToString(); }
    else if kind == ASTStatementKind::Assembly { return "Assembly".ToString(); }
    else { return "Unknown".ToString(); }
}

class ASTStatement : ASTNode {
    pub kind: ASTStatementKind;

    ASTStatement(&mut this, kind: ASTStatementKind, start: Token) : ASTNode(ASTNodeKind::Statement, start) {
        this.kind = kind;
