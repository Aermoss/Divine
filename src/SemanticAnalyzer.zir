#[include "std/str", "std/vec", "std/map", "std/pair", "src/Logger.zir", "src/Tokens.zir", "src/Nodes.zir",
    "src/SemanticTypeManager.zir", "src/SemanticTypes.zir", "src/SemanticScopeManager.zir", "src/SemanticScope.zir", "src/SemanticSymbol.zir" : *]

class SemanticAnalyzer {
    type_manager: SemanticTypeManager,
    scope_manager: SemanticScopeManager,
    pub current_class: *SemanticType = null;

    SemanticAnalyzer(&mut this) {
        if analyzer != null {
            Logger::Log("Another instance of 'SemanticAnalyzer' already exists!", LogSeverity::Fatal);
        }

        analyzer = this;
    }

    ~SemanticAnalyzer(&mut this) {
        analyzer = null;
    }

    pub fn Analyze(&mut this, root: *RootNode) {
        for declaration in root->declarations {
            this.AnalyzeDeclaration(declaration);
        }
    }

    fn AnalyzeDeclaration(&mut this, declaration: *Node) {
        if declaration->_type == NodeType::FUNCTION {
            this.AnalyzeFunction(declaration as *FunctionNode);
        } else if declaration->_type == NodeType::CLASS {
            this.AnalyzeClass(declaration as *ClassNode);
        } else if declaration->_type == NodeType::STRUCTURE {
            this.AnalyzeStructure(declaration as *StructureNode);
        } else if declaration->_type == NodeType::ENUMERATION {
            this.AnalyzeEnumeration(declaration as *EnumerationNode);
        }
    }

    fn AnalyzeFunction(&mut this, function: *FunctionNode) {
        if function->body == null { return; }

        for statement in function->body->statements {
            this.AnalyzeStatement(statement);
        }
    }

    fn AnalyzeClass(&mut this, _class: *ClassNode) {
        let _type = this.type_manager.Class(_class->name);
        this.scope_manager.Set(_class->name, SemanticSymbolKind::Class, _type, false, _class);
        this.current_class = _type;

        for constructor in _class->constructors {
            this.AnalyzeFunction(constructor);
        }

        if _class->destructor != null {
            this.AnalyzeFunction(_class->destructor);
        }

        for method in _class->methods {
            this.AnalyzeFunction(method.right);
        }

        this.current_class = null;
    }

    fn AnalyzeStructure(&mut this, structure: *StructureNode) {
        let _type = this.type_manager.Class(structure->name);
        this.scope_manager.Set(structure->name, SemanticSymbolKind::Class, _type, false, structure);

        for method in structure->methods {
            this.AnalyzeFunction(method.right);
        }
    }

    fn AnalyzeEnumeration(&mut this, enumeration: *EnumerationNode) {
        for method in enumeration->methods {
            this.AnalyzeFunction(method.right);
        }
    }

    fn AnalyzeStatement(&mut this, statement: *Node) {
        if statement->_type == NodeType::RETURN {
            this.AnalyzeReturn(statement as *ReturnNode);
        } else if statement->_type == NodeType::EXPRESSION {
            this.AnalyzeExpression((statement as *ExpressionNode)->expression);
        } else if statement->_type == NodeType::IF {
            this.AnalyzeIf(statement as *IfNode);
        } else if statement->_type == NodeType::IF_LET {
            this.AnalyzeIfLet(statement as *IfLetNode);
        } else if statement->_type == NodeType::WHILE {
            this.AnalyzeWhile(statement as *WhileNode);
        } else if statement->_type == NodeType::WHILE_LET {
            this.AnalyzeWhileLet(statement as *WhileLetNode);
        } else if statement->_type == NodeType::FOR {
            this.AnalyzeFor(statement as *ForNode);
        } else if statement->_type == NodeType::LOOP {
            this.AnalyzeLoop(statement as *LoopNode);
        } else if statement->_type == NodeType::MATCH {
            this.AnalyzeMatch(statement as *MatchNode);
        } else if statement->_type == NodeType::UNSAFE {
            this.AnalyzeUnsafe(statement as *UnsafeNode);
        } else if statement->_type == NodeType::BLOCK {
            this.AnalyzeBlock(statement as *BlockNode);
        } else if statement->_type == NodeType::CONTINUE {
            return;
        } else if statement->_type == NodeType::BREAK {
            return;
        } else if statement->_type == NodeType::VARIABLE {
            this.AnalyzeVariable(statement as *VariableNode);
        } else if statement->_type == NodeType::ASSIGNMENT {
            this.AnalyzeAssignment(statement as *AssignmentNode);
        } else if statement->_type == NodeType::ASSEMBLY {
            this.AnalyzeAssembly(statement as *AssemblyNode);
        } else {
            Logger::Log("Unknown statement '" + statement->_type.ToString() + "'.", statement, LogSeverity::Error);
        }
    }

    fn AnalyzeReturn(&mut this, _return: *ReturnNode) {
        if _return->expression != null {
            this.AnalyzeExpression(_return->expression);
        }
    }

    fn AnalyzeIf(&mut this, _if: *IfNode) {
        this.AnalyzeExpression(_if->condition);
        this.AnalyzeBlock(_if->body as *BlockNode);

        if _if->_else != null {
            if _if->_else->_type == NodeType::IF_LET {
                this.AnalyzeIfLet(_if->_else as *IfLetNode);
            } else if _if->_else->_type == NodeType::IF {
                this.AnalyzeIf(_if->_else as *IfNode);
            } else {
                this.AnalyzeBlock(_if->_else as *BlockNode);
            }
        }
    }

    fn AnalyzeIfLet(&mut this, _if_let: *IfLetNode) {
        this.AnalyzeExpression(_if_let->expression);
        this.AnalyzeBlock(_if_let->body as *BlockNode);

        if _if_let->_else != null {
            if _if_let->_else->_type == NodeType::IF_LET {
                this.AnalyzeIfLet(_if_let->_else as *IfLetNode);
            } else if _if_let->_else->_type == NodeType::IF {
                this.AnalyzeIf(_if_let->_else as *IfNode);
            } else {
                this.AnalyzeBlock(_if_let->_else as *BlockNode);
            }
        }
    }

    fn AnalyzeWhile(&mut this, _while: *WhileNode) {
        this.AnalyzeExpression(_while->condition);
        this.AnalyzeBlock(_while->body as *BlockNode);

        if _while->_else != null {
            this.AnalyzeBlock(_while->_else as *BlockNode);
        }
    }

    fn AnalyzeWhileLet(&mut this, _while_let: *WhileLetNode) {
        this.AnalyzeExpression(_while_let->expression);
        this.AnalyzeBlock(_while_let->body as *BlockNode);
    }

    fn AnalyzeFor(&mut this, _for: *ForNode) {
        this.AnalyzeBlock(_for->body as *BlockNode);
    }

    fn AnalyzeLoop(&mut this, _loop: *LoopNode) {
        this.AnalyzeBlock(_loop->body as *BlockNode);
    }

    fn AnalyzeMatch(&mut this, _match: *MatchNode) {
        this.AnalyzeExpression(_match->expression);
    }

    fn AnalyzeUnsafe(&mut this, _unsafe: *UnsafeNode) {
        this.AnalyzeBlock(_unsafe->body);
    }

    fn AnalyzeBlock(&mut this, block: *BlockNode) {
        for statement in block->statements {
            this.AnalyzeStatement(statement);
        }
    }

    fn AnalyzeVariable(&mut this, variable: *VariableNode) {
        if variable->initializer != null {
            this.AnalyzeExpression(variable->initializer);
        }

        if variable->_type != null {
            this.ResolveType(variable->_type);
        }

        if variable->next != null {
            this.AnalyzeVariable(variable->next);
        }
    }

    fn AnalyzeAssignment(&mut this, assignment: *AssignmentNode) {
        this.AnalyzeExpression(assignment->left);
        this.AnalyzeExpression(assignment->right);

        if assignment->next != null {
            this.AnalyzeAssignment(assignment->next);
        }
    }

    fn AnalyzeAssembly(&mut this, assembly: *AssemblyNode) {
        for input in assembly->inputs {
            this.AnalyzeExpression(input.right);
        }

        for output in assembly->outputs {
            this.AnalyzeExpression(output.right);
        }
    }

    fn AnalyzeExpression(&mut this, expression: *Node) {
        if expression->_type == NodeType::LITERAL {
            return;
        } else if expression->_type == NodeType::CALL {
            this.AnalyzeCall(expression as *CallNode);
        } else if expression->_type == NodeType::IDENTIFIER || expression->_type == NodeType::SCOPE_RESOLUTION {
            return;
        } else if expression->_type == NodeType::NEW {
            this.AnalyzeNew(expression as *NewNode);
        } else if expression->_type == NodeType::DELETE {
            this.AnalyzeDelete(expression as *DeleteNode);
        } else if expression->_type == NodeType::CAST {
            this.AnalyzeCast(expression as *CastNode);
        } else if expression->_type == NodeType::INDEX_ACCESS {
            this.AnalyzeIndexAccess(expression as *IndexAccessNode);
        } else if expression->_type == NodeType::MEMBER_ACCESS {
            this.AnalyzeMemberAccess(expression as *MemberAccessNode);
        } else if expression->_type == NodeType::UNARY {
            this.AnalyzeUnary(expression as *UnaryNode);
        } else if expression->_type == NodeType::BINARY {
            this.AnalyzeBinary(expression as *BinaryNode);
        } else if expression->_type == NodeType::TERNARY {
            this.AnalyzeTernary(expression as *TernaryNode);
        } else if expression->_type == NodeType::STRUCTURE_INITIALIZER {
            this.AnalyzeStructureInitializer(expression as *StructureInitializerNode);
        } else if expression->_type == NodeType::TYPE_APPLICATION {
            this.AnalyzeTypeApplication(expression as *TypeApplicationNode);
        } else {
            // Logger::Log("Unknown expression '" + expression->_type.ToString() + "'.", expression, LogSeverity::Error);
        }
    }

    fn AnalyzeCall(&mut this, call: *CallNode) {
        this.AnalyzeExpression(call->expression);

        for argument in call->arguments {
            this.AnalyzeExpression(argument);
        }
    }

    fn AnalyzeNew(&mut this, _new: *NewNode) {
        this.ResolveType(_new->_type);

        if _new->size != null {
            this.AnalyzeExpression(_new->size);
        }

        for argument in _new->arguments {
            this.AnalyzeExpression(argument);
        }
    }

    fn AnalyzeDelete(&mut this, _delete: *DeleteNode) {
        this.AnalyzeExpression(_delete->expression);
    }

    fn AnalyzeCast(&mut this, _cast: *CastNode) {
        this.AnalyzeExpression(_cast->expression);
        this.ResolveType(_cast->target_type);
    }

    fn AnalyzeIndexAccess(&mut this, index_access: *IndexAccessNode) {
        this.AnalyzeExpression(index_access->expression);
        this.AnalyzeExpression(index_access->index);
    }

    fn AnalyzeMemberAccess(&mut this, member_access: *MemberAccessNode) {
        this.AnalyzeExpression(member_access->expression);
    }

    fn AnalyzeUnary(&mut this, unary: *UnaryNode) {
        this.AnalyzeExpression(unary->operand);
    }

    fn AnalyzeBinary(&mut this, binary: *BinaryNode) {
        this.AnalyzeExpression(binary->left);
        this.AnalyzeExpression(binary->right);
    }

    fn AnalyzeTernary(&mut this, ternary: *TernaryNode) {
        this.AnalyzeExpression(ternary->condition);
        this.AnalyzeExpression(ternary->then);
        this.AnalyzeExpression(ternary->_else);
    }

    fn AnalyzeStructureInitializer(&mut this, struct_init: *StructureInitializerNode) {
        this.AnalyzeExpression(struct_init->expression);

        for value in struct_init->field_values {
            this.AnalyzeExpression(value);
        }
    }

    fn AnalyzeTypeApplication(&mut this, type_application: *TypeApplicationNode) {
        this.AnalyzeExpression(type_application->expression);

        for _type in type_application->types {
            this.ResolveType(_type);
        }
    }

    pub fn ResolveType(&mut this, _type: *Node) -> *SemanticType {
        if _type->_type == NodeType::PRIMITIVE_TYPE {
            let primitive_type = _type as *PrimitiveTypeNode;

            if primitive_type->name == "void" {
                return this.type_manager.Void();
            } else if primitive_type->name == "bool" {
                return this.type_manager.Boolean();
            } else if primitive_type->name == "char" {
                return this.type_manager.Character();
            } else if primitive_type->name.StartsWith('i') || primitive_type->name.StartsWith('u') {
                let specifier = primitive_type->name.SubString(1);
                let signed = primitive_type->name[0] != 'u';

                if specifier == "size" {
                    return this.type_manager.IntegerPointer(signed);
                } else {
                    let width = specifier.ToUnsignedInteger() as u32;

                    if width != 8 && width != 16 && width != 32 && width != 64 && width != 128 {
                        Logger::Log("Invalid integer type '" + primitive_type->name + "'.", _type, LogSeverity::Error);
                        return null;
                    }

                    return this.type_manager.Integer(width, signed);
                }
            } else if primitive_type->name.StartsWith('f') {
                let width = primitive_type->name.SubString(1).ToUnsignedInteger() as u32;

                if width != 32 && width != 64 {
                    Logger::Log("Invalid float type '" + primitive_type->name + "'.", _type, LogSeverity::Error);
                    return null;
                }

                return this.type_manager.Float(width);
            } else {
                if this.scope_manager.Has(primitive_type->name, SemanticSymbolKind::Type) {
                    return this.scope_manager.Get(primitive_type->name, SemanticSymbolKind::Type)->_type;
                } else if this.scope_manager.Has(primitive_type->name, SemanticSymbolKind::Class) {
                    return this.scope_manager.Get(primitive_type->name, SemanticSymbolKind::Class)->_type;
                } else if this.scope_manager.Has(primitive_type->name, SemanticSymbolKind::Generic) {
                    Logger::Log("Generic type '" + primitive_type->name + "' requires parameters.", _type, LogSeverity::Error);
                } else {
                    Logger::Log("Type '" + primitive_type->name + "' not found.", _type, LogSeverity::Error);
                } return null;
            }
        } else if _type->_type == NodeType::TYPE_APPLICATION {
            let type_application = _type as *TypeApplicationNode;
            let mut types = Vector<*SemanticType>();

            for type_ in type_application->types {
                let __type = this.ResolveType(type_);
                if __type == null { return null; }
                types.PushBack(__type);
            }

            if type_application->expression->_type == NodeType::PRIMITIVE_TYPE {
                let primitive_type = type_application->expression as *PrimitiveTypeNode;

                if this.scope_manager.Has(primitive_type->name, SemanticSymbolKind::Generic) {
                    return null;
                } else {
                    if this.scope_manager.Has(primitive_type->name) {
                        Logger::Log("Type '" + primitive_type->name + "' is not generic.", _type, LogSeverity::Error);
                    } else {
                        Logger::Log("Type '" + primitive_type->name + "' not found.", _type, LogSeverity::Error);
                    } return null;
                }
            } else {
                Logger::Log("Invalid type application.", _type, LogSeverity::Error);
                return null;
            }
        } else if _type->_type == NodeType::POINTER_TYPE {
            let pointer_type = _type as *PointerTypeNode;
            let base_type = this.ResolveType(pointer_type->base_type);
            if base_type == null { return null; }
            return this.type_manager.Pointer(base_type, pointer_type->mutable);
        } else if _type->_type == NodeType::REFERENCE_TYPE {
            let reference_type = _type as *ReferenceTypeNode;
            let base_type = this.ResolveType(reference_type->base_type);
            if base_type == null { return null; }
            return this.type_manager.Reference(base_type, reference_type->mutable);
        } else if _type->_type == NodeType::ARRAY_TYPE {
            let array_type = _type as *ArrayTypeNode;
            let element_type = this.ResolveType(array_type->element_type);
            if element_type == null { return null; }
            return this.type_manager.Pointer(element_type, true);
        } else if _type->_type == NodeType::FUNCTION_TYPE {
            let function_type = _type as *FunctionTypeNode;
            let return_type = this.ResolveType(function_type->return_type);
            if return_type == null { return null; }
            let mut param_types = Vector<*SemanticType>();

            for parameter in function_type->parameters {
                let param_type = this.ResolveType(parameter->_type);
                if param_type == null { return null; }
                param_types.PushBack(param_type);
            }

            return this.type_manager.Pointer(this.type_manager.Function(param_types, return_type), false);
        } else {
            Logger::Log("Unknown type '" + _type->_type.ToString() + "'.", _type, LogSeverity::Error);
            return null;
        }
    }
}

static mut analyzer: *mut SemanticAnalyzer = null;
