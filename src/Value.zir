#[include "std/str", "vendor/llvm", "src/Types.zir" : *]

const F32_MAX: f64 = 3.40282347e+38;
const F64_MAX: f64 = 1.7976931348623157e+308;

class QualifiedValue {
    value: LLVMValueRef = null, _type: *QualifiedType = null,
    pub instance: LLVMValueRef = null, pub instance_type: *QualifiedType = null,
    lvalue: bool = false, pub _return: bool = false,

    deferred_integer: u64 = 0, deferred_float: f64 = 0.0,
    deferred_negative: bool = false, deferred_bitpattern: bool = false,
    deferred_node: *Node = null;

    QualifiedValue(&mut this, value: LLVMValueRef, _type: *QualifiedType) {
        (this.value, this._type) = (value, _type);
    }

    QualifiedValue(&mut this, value: LLVMValueRef, _type: *QualifiedType, instance: &QualifiedValue) {
        (this.value, this._type, this.instance, this.instance_type) = (value, _type, instance.value, instance._type);
    }

    QualifiedValue(&mut this, value: LLVMValueRef, _type: *QualifiedType, lvalue: bool, _return: bool) {
        (this.value, this._type, this.lvalue, this._return) = (value, _type, lvalue, _return);
    }

    QualifiedValue(&mut this, value: LLVMValueRef, _type: *QualifiedType, lvalue: bool) {
        (this.value, this._type, this.lvalue) = (value, _type, lvalue);
    }

    QualifiedValue(&mut this, _type: *QualifiedType, integer: u64) {
        (this._type, this.deferred_integer) = (_type, integer);
    }

    QualifiedValue(&mut this, _type: *QualifiedType, integer: u64, negative: bool) {
        (this._type, this.deferred_integer, this.deferred_negative) = (_type, integer, negative);
    }

    QualifiedValue(&mut this, _type: *QualifiedType, integer: u64, negative: bool, bitpattern: bool) {
        (this._type, this.deferred_integer, this.deferred_negative, this.deferred_bitpattern) = (_type, integer, negative, bitpattern);
    }

    QualifiedValue(&mut this, _type: *QualifiedType, float: f64) {
        (this._type, this.deferred_float) = (_type, float);
    }

    QualifiedValue(&mut this, _type: *QualifiedType, node: *Node) {
        (this._type, this.deferred_node) = (_type, node);
    }

    pub fn Null(&this) -> bool {
        return this.value == null && this._type == null;
    }

    pub fn Value(&this) -> LLVMValueRef {
        if this.value == null {
            Logger::Log("QualifiedValue", "Null value!", LogSeverity::Fatal);
        } return this.value;
    }

    pub fn Type(&this) -> &QualifiedType {
        if this._type == null {
            Logger::Log("QualifiedValue", "Null type!", LogSeverity::Fatal);
        } return this._type;
    }

    pub fn Materialize(&this, target: &QualifiedType) -> QualifiedValue {
        if this.deferred_node != null {
            return compiler->CompileExpression(this.deferred_node, target, true).Materialize(target);
        }

        if this.Type().IsInteger() && this.Type().IsLiteral() && target.IsPointer() {
            if !(target.IsReference() && target.Pointee().IsInteger()) {
                return this.Materialize(compiler->type_manager.IntegerPointer(false));
            }
        }

        if this.Type().IsInteger() && this.Type().IsLiteral() && target.IsInteger() {
            let mut value = this.deferred_integer;
            let width = target.Width() as u64;
            let mut overflow = false;

            if width < 64 {
                let signed_limit = 1 << (width - 1);
                let unsigned_limit = 1 << width;

                if this.deferred_bitpattern {
                    overflow = value >= unsigned_limit;
                } else if this.deferred_negative {
                    overflow = target.IsSigned() ? value > signed_limit : value >= unsigned_limit;
                } else {
                    overflow = target.IsSigned() ? value >= signed_limit : value >= unsigned_limit;
                }

                if !overflow && this.deferred_negative {
                    value = (!value + 1) & (unsigned_limit - 1);
                }
            } else {
                if !this.deferred_bitpattern && this.deferred_negative && target.IsSigned() {
                    overflow = value > (1 << 63);
                }

                if !overflow && this.deferred_negative {
                    value = !value + 1;
                }
            }

            if overflow {
                Logger::Log("Integer literal '" + (this.deferred_negative ? "-" : "").ToString() + String::FromInteger(this.deferred_integer) + "' overflows target type '" + target.ToString() + "'.", LogSeverity::Error);
                value = 0;
            }

            return QualifiedValue(LLVMConstInt(target.Value(), value, target.IsSigned() ? 1 : 0), target);
        } else if this.Type().IsFloat() && this.Type().IsLiteral() && target.IsFloat() {
            let mut value = this.deferred_float;

            if (value < 0.0 ? -value : value) > (target.Width() == 32 ? F32_MAX : F64_MAX) {
                Logger::Log("Float literal '" + String::FromFloat(value) + "' overflows target type '" + target.ToString() + "'.", LogSeverity::Error);
                value = 0.0;
            }

            return QualifiedValue(LLVMConstReal(target.Value(), value), target);
        } else {
            return this;
        }
    }

    pub fn MaterializeWithFallback(&this, target: &QualifiedType) -> QualifiedValue {
        if this.deferred_node != null {
            return compiler->CompileExpression(this.deferred_node, target, true).MaterializeWithFallback(target);
        }

        let value = this.Materialize(target);

        if value.Type().IsLiteral() {
            return value.Materialize();
        } else {
            return value;
        }
    }

    pub fn Materialize(&this) -> QualifiedValue {
        if this.deferred_node != null {
            return compiler->CompileExpression(this.deferred_node, null, true).Materialize();
        }

        if this.Type().kind == TypeKind::IntegerLiteral {
            return this.Materialize(compiler->type_manager.Integer(32, true));
        } else if this.Type().kind == TypeKind::FloatLiteral {
            return this.Materialize(compiler->type_manager.Float(64));
        } else {
            return this;
        }
    }

    pub fn Load(&this, args...) -> QualifiedValue {
        if LLVMIsAGlobalVariable(this.Value()) != null {
            if LLVMIsGlobalConstant(this.Value()) != 0 && !this.Type().Pointee().HasFields() && !this.Type().Pointee().IsPointer() {
                return QualifiedValue(LLVMGetInitializer(this.Value()), this.Type().Pointee()); // args...
            }
        }

        return QualifiedValue(LLVMBuildLoad2(compiler->builder, this.Type().Pointee().Value(), this.Value(), ""), this.Type().Pointee(), args...);
    }

    pub fn IsLValue(&this) -> bool { return this.lvalue; }
    pub fn IsRValue(&this) -> bool { return !this.lvalue; }

    pub fn ToRValue(&this) -> QualifiedValue {
        if this.IsLValue() {
            if this.Type().Pointee().IsArray() {
                let _type = compiler->type_manager.Pointer(this.Type().Pointee().Element(), this.Type().IsMutable());
                return QualifiedValue(LLVMBuildBitCast(compiler->builder, this.Value(), _type->Value(), ""), _type);
            } else {
                return this.Load();
            }
        } return this;
    }

    pub fn ToRValueType(&this) -> &QualifiedType {
        if this.IsLValue() {
            if this.Type().Pointee().IsArray() {
                return compiler->type_manager.Pointer(this.Type().Pointee().Element(), this.Type().IsMutable());
            } else {
                return this.Type().Pointee();
            }
        } return this.Type();
    }

    pub fn MakeLValue(&this) -> QualifiedValue {
        return QualifiedValue(this.value, this._type, true);
    }

    pub fn MakeCompatible(&this, target: &QualifiedType) -> QualifiedValue {
        if target.IsPointer() && this.Type().IsPointer() {
            if target.Pointee().IsClass() && this.Type().Pointee().IsClass() {
                let fields = this.Type().Pointee().Fields();

                for i in 0..fields.Size() {
                    if fields[i].left == target.Pointee().name {
                        let mut value_ref = this.Value();

                        if i != 0 {
                            value_ref = LLVMBuildStructGEP2(compiler->builder, this.Type().Pointee().Value(), this.Value(), i as u32, "");
                        }

                        return QualifiedValue(LLVMBuildBitCast(compiler->builder, value_ref, target.Value(), ""), target);
                    }
                }
            }
        } return this;
    }

    pub fn ToString(&this) -> String {
        if this.value != null {
            let mut result = String();
            let string = LLVMPrintValueToString(this.value);
            result += string;
            LLVMDisposeMessage(string);
            return result;
        } else {
            Logger::Log("QualifiedValue", "Null value!", LogSeverity::Fatal);
            return String("");
        }
    }
}
