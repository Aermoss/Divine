#[include "std/str", "src/SemanticTypes.zir" : *]

enum SemanticSymbolKind: i32 {
    Variable, GlobalVariable, Constant, Function, Parameter, Generic, Class, Structure, Variant, Type
}

class SemanticSymbol {
    pub name: String,
    pub kind: SemanticSymbolKind,
    pub value: SemanticValue,
    pub function: *HIRFunction = null,
    pub generic: *mut SemanticGeneric = null;

    SemanticSymbol(&mut this, name: &String, kind: SemanticSymbolKind, value: &SemanticValue) {
        (this.name, this.kind, this.value) = (name, kind, value);
    }

    SemanticSymbol(&mut this, name: &String, kind: SemanticSymbolKind, function: *HIRFunction) {
        (this.name, this.kind, this.function) = (name, kind, function);
    }

    SemanticSymbol(&mut this, name: &String, kind: SemanticSymbolKind, generic: *mut SemanticGeneric) {
        (this.name, this.kind, this.generic) = (name, kind, generic);
    }
}
