#[include "std/str" : *]

class Base64 {
    func Encode(string: &String) -> String {
        let mut result: String;
        let table: *const i8 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        let length: u64 = string.Length();
        let mut i: u64 = 0;

        while i < length {
            let b0: u64 = (string[i] as u64) & 0xFF;
            let b1: u64 = (i + 1 < length) ? ((string[i + 1] as u64) & 0xFF) : 0;
            let b2: u64 = (i + 2 < length) ? ((string[i + 2] as u64) & 0xFF) : 0;
            let triple: u64 = (b0 << 16) | (b1 << 8) | b2;
            result += table[(triple >> 18) & 0x3F];
            result += table[(triple >> 12) & 0x3F];

            if i + 1 < length {
                result += table[(triple >> 6) & 0x3F];
            } else {
                result += '=';
            }

            if i + 2 < length {
                result += table[triple & 0x3F];
            } else {
                result += '=';
            } i += 3;
        } ret result;
    }

    priv GetValue(c: i8) -> u64 {
        if c >= 'A' && c <= 'Z' { ret (c - 'A') as u64; }
        else if c >= 'a' && c <= 'z' { ret (c - 'a' + 26) as u64; }
        else if c >= '0' && c <= '9' { ret (c - '0' + 52) as u64; }
        else if c == '+' { ret 62; }
        else if c == '/' { ret 63; }
        else { ret 0; }
    }

    func Decode(string: &String) -> String {
        let mut result: String;
        let length: u64 = string.Length();
        let mut i: u64 = 0;

        while i < length {
            let n0: u64 = Base64::GetValue(string[i]);
            let n1: u64 = (i + 1 < length) ? Base64::GetValue(string[i + 1]) : 0;
            let n2: u64 = (i + 2 < length) ? Base64::GetValue(string[i + 2]) : 0;
            let n3: u64 = (i + 3 < length) ? Base64::GetValue(string[i + 3]) : 0;
            let triple: u64 = (n0 << 18) | (n1 << 12) | (n2 << 6) | n3;
            result += ((triple >> 16) & 0xFF) as i8;

            if i + 2 < length && string[i + 2] != '=' {
                result += ((triple >> 8) & 0xFF) as i8;
            }

            if i + 3 < length && string[i + 3] != '=' {
                result += (triple & 0xFF) as i8;
            } i += 4;
        } ret result;
    }
}