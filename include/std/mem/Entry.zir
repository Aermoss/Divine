extern "C" {
#[if WINDOWS]
    fn GetProcessHeap() -> *mut void;

    fn HeapAlloc(hHeap: *mut void, dwFlags: u32, dwBytes: usize) -> *mut void;
    fn HeapSize(hHeap: *mut void, dwFlags: u32, lpMem: *void) -> usize;
    fn HeapFree(hHeap: *mut void, dwFlags: u32, lpMem: *mut void) -> i32;

    fn RtlCopyMemory(Destination: *mut void, Source: *void, Length: usize);
    fn RtlFillMemory(Destination: *mut void, Length: usize, Fill: u8);
#[endif]

    fn malloc(size: usize) -> *mut void #[if DARWIN] ; #[else] {
#[if WINDOWS]
        return HeapAlloc(GetProcessHeap(), 0, size);
#[else]
        let address = 0;

        volatile asm : rax(9), rdi(0), rsi((size + 8) as i64), rdx(3), r10(0x22), r8(-1), r9(0) -> {
            syscall
        } -> rax(address) : memory, rcx, r11;

        if address == -1 { return null; }
        let header = address as *mut i64;
        header[0] = size as i64;
        return (address + 8) as *mut void;
#[endif]
    } #[endif]

    fn free(ptr: *mut void) #[if DARWIN] ; #[else] {
        if ptr == null { return; }
#[if WINDOWS]
        HeapFree(GetProcessHeap(), 0, ptr);
#[else]
        let base = ptr as i64 - 8;
        let header = base as *i64;
        let size = header[0] + 8;

        volatile asm : rax(11), rdi(base), rsi(size) -> {
            syscall
        } : memory, rcx, r11, rax;
#[endif]
    } #[endif]

    fn memcpy(dst: *mut void, src: *void, size: usize) -> *mut void #[if DARWIN] ; #[else] {
        if size == 0 || dst == null || src == null { return dst; }
#[if WINDOWS]
        RtlCopyMemory(dst, src, size);
#[else]
        volatile asm : rdi(dst as *mut i8), rsi(src as *i8), rcx(size as i64) -> {
            rep movsb
        } : memory, rdi, rsi, rcx;
#[endif]
        return dst;
    } #[endif]

    fn memset(ptr: *mut void, value: i32, num: usize) -> *mut void #[if DARWIN] ; #[else] {
        if num == 0 || ptr == null { return ptr; }
#[if WINDOWS]
        RtlFillMemory(ptr, num, value as u8);
#[else]
        volatile asm : rdi(ptr as *mut i8), al(value as i8), rcx(num as i64) -> {
            rep stosb
        } : memory, rdi, rcx;
#[endif]
        return ptr;
    } #[endif]

    fn calloc(nmemb: usize, size: usize) -> *mut void #[if DARWIN] ; #[else] {
        let total = nmemb * size;
        let ptr = malloc(total);
        if ptr == null { return null; }
        memset(ptr, 0, total);
        return ptr;
    } #[endif]

    fn realloc(ptr: *mut void, size: usize) -> *mut void #[if DARWIN] ; #[else] {
        if ptr == null { return malloc(size); }
        if size == 0 { free(ptr); return null; }
#[if WINDOWS]
    let old_size = HeapSize(GetProcessHeap(), 0, ptr);
#[else]
    let header = (ptr as i64 - 8) as *i64;
    let old_size = header[0] as usize;
#[endif]
        if size <= old_size { return ptr; }
        let new_ptr = malloc(size);
        if new_ptr == null { return null; }
        memcpy(new_ptr, ptr, old_size);
        free(ptr);
        return new_ptr;
    } #[endif]
}