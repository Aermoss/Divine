    fn DrawTextCodepoints(font: Font, codepoints: *i32, codepointCount: i32, position: Vector2, fontSize: f32, spacing: f32, tint: Color);

    fn SetTextLineSpacing(spacing: i32);
    fn MeasureText(text: *i8, fontSize: i32) -> i32;
    fn MeasureTextEx(font: Font, text: *i8, fontSize: f32, spacing: f32) -> Vector2;
    fn GetGlyphIndex(font: Font, codepoint: i32) -> i32;
    fn GetGlyphInfo(font: Font, codepoint: i32) -> GlyphInfo;
    fn GetGlyphAtlasRec(font: Font, codepoint: i32) -> Rectangle;

    fn LoadUTF8(codepoints: *i32, length: i32) -> *i8;
    fn UnloadUTF8(text: *i8);
    fn LoadCodepoints(text: *i8, count: *i32) -> *i32;
    fn UnloadCodepoints(codepoints: *i32);
    fn GetCodepointCount(text: *i8) -> i32;
    fn GetCodepoint(text: *i8, codepointSize: *i32) -> i32;
    fn GetCodepointNext(text: *i8, codepointSize: *i32) -> i32;
    fn GetCodepointPrevious(text: *i8, codepointSize: *i32) -> i32;
    fn CodepointToUTF8(codepoint: i32, utf8Size: *i32) -> *i8;

    fn TextCopy(dst: *i8, src: *i8) -> i32;
    fn TextIsEqual(text1: *i8, text2: *i8) -> bool;
    fn TextLength(text: *i8) -> u32;
    fn TextFormat(text: *i8, ...) -> *i8;
    fn TextSubtext(text: *i8, position: i32, length: i32) -> *i8;
    fn TextReplace(text: *i8, replace: *i8, by: *i8) -> *i8;
    fn TextInsert(text: *i8, insert: *i8, position: i32) -> *i8;
    fn TextJoin(textList: **i8, count: i32, delimiter: *i8) -> *i8;
    fn TextSplit(text: *i8, delimiter: i8, count: *i32) -> **i8;
    fn TextAppend(text: *i8, append: *i8, position: *i32);
    fn TextFindIndex(text: *i8, find: *i8) -> i32;
    fn TextToUpper(text: *i8) -> *i8;
    fn TextToLower(text: *i8) -> *i8;
    fn TextToPascal(text: *i8) -> *i8;
    fn TextToSnake(text: *i8) -> *i8;
    fn TextToCamel(text: *i8) -> *i8;

    fn TextToInteger(text: *i8) -> i32;
    fn TextToFloat(text: *i8) -> f32;

    fn DrawLine3D(startPos: Vector3, endPos: Vector3, color: Color);
    fn DrawPoint3D(position: Vector3, color: Color);
    fn DrawCircle3D(center: Vector3, radius: f32, rotationAxis: Vector3, rotationAngle: f32, color: Color);
    fn DrawTriangle3D(v1: Vector3, v2: Vector3, v3: Vector3, color: Color);
    fn DrawTriangleStrip3D(points: *Vector3, pointCount: i32, color: Color);
    fn DrawCube(position: Vector3, width: f32, height: f32, length: f32, color: Color);
    fn DrawCubeV(position: Vector3, size: Vector3, color: Color);
    fn DrawCubeWires(position: Vector3, width: f32, height: f32, length: f32, color: Color);
    fn DrawCubeWiresV(position: Vector3, size: Vector3, color: Color);
    fn DrawSphere(centerPos: Vector3, radius: f32, color: Color);
    fn DrawSphereEx(centerPos: Vector3, radius: f32, rings: i32, slices: i32, color: Color);
    fn DrawSphereWires(centerPos: Vector3, radius: f32, rings: i32, slices: i32, color: Color);
    fn DrawCylinder(position: Vector3, radiusTop: f32, radiusBottom: f32, height: f32, slices: i32, color: Color);
    fn DrawCylinderEx(startPos: Vector3, endPos: Vector3, startRadius: f32, endRadius: f32, sides: i32, color: Color);
    fn DrawCylinderWires(position: Vector3, radiusTop: f32, radiusBottom: f32, height: f32, slices: i32, color: Color);
    fn DrawCylinderWiresEx(startPos: Vector3, endPos: Vector3, startRadius: f32, endRadius: f32, sides: i32, color: Color);
    fn DrawCapsule(startPos: Vector3, endPos: Vector3, radius: f32, slices: i32, rings: i32, color: Color);
    fn DrawCapsuleWires(startPos: Vector3, endPos: Vector3, radius: f32, slices: i32, rings: i32, color: Color);
    fn DrawPlane(centerPos: Vector3, size: Vector2, color: Color);
    fn DrawRay(ray: Ray, color: Color);
    fn DrawGrid(slices: i32, spacing: f32);

    fn LoadModel(fileName: *i8) -> Model;
    fn LoadModelFromMesh(mesh: Mesh) -> Model;
    fn IsModelValid(model: Model) -> bool;
    fn UnloadModel(model: Model);
    fn GetModelBoundingBox(model: Model) -> BoundingBox;

    fn DrawModel(model: Model, position: Vector3, scale: f32, tint: Color);
    fn DrawModelEx(model: Model, position: Vector3, rotationAxis: Vector3, rotationAngle: f32, scale: Vector3, tint: Color);
    fn DrawModelWires(model: Model, position: Vector3, scale: f32, tint: Color);
    fn DrawModelWiresEx(model: Model, position: Vector3, rotationAxis: Vector3, rotationAngle: f32, scale: Vector3, tint: Color);
    fn DrawModelPoints(model: Model, position: Vector3, scale: f32, tint: Color);
    fn DrawModelPointsEx(model: Model, position: Vector3, rotationAxis: Vector3, rotationAngle: f32, scale: Vector3, tint: Color);
    fn DrawBoundingBox(box: BoundingBox, color: Color);
    fn DrawBillboard(camera: Camera, texture: Texture2D, position: Vector3, scale: f32, tint: Color);
    fn DrawBillboardRec(camera: Camera, texture: Texture2D, source: Rectangle, position: Vector3, size: Vector2, tint: Color);
    fn DrawBillboardPro(camera: Camera, texture: Texture2D, source: Rectangle, position: Vector3, up: Vector3, size: Vector2, origin: Vector2, rotation: f32, tint: Color);

    fn UploadMesh(mesh: *Mesh, dynamic: bool);
    fn UpdateMeshBuffer(mesh: Mesh, index: i32, data: *void, dataSize: i32, offset: i32);
    fn UnloadMesh(mesh: Mesh);
    fn DrawMesh(mesh: Mesh, material: Material, transform: Matrix);
    fn DrawMeshInstanced(mesh: Mesh, material: Material, transforms: *Matrix, instances: i32);
    fn GetMeshBoundingBox(mesh: Mesh) -> BoundingBox;
    fn GenMeshTangents(mesh: *Mesh);
    fn ExportMesh(mesh: Mesh, fileName: *i8) -> bool;
    fn ExportMeshAsCode(mesh: Mesh, fileName: *i8) -> bool;

    fn GenMeshPoly(sides: i32, radius: f32) -> Mesh;
    fn GenMeshPlane(width: f32, length: f32, resX: i32, resZ: i32) -> Mesh;
    fn GenMeshCube(width: f32, height: f32, length: f32) -> Mesh;
    fn GenMeshSphere(radius: f32, rings: i32, slices: i32) -> Mesh;
    fn GenMeshHemiSphere(radius: f32, rings: i32, slices: i32) -> Mesh;
    fn GenMeshCylinder(radius: f32, height: f32, slices: i32) -> Mesh;
    fn GenMeshCone(radius: f32, height: f32, slices: i32) -> Mesh;
    fn GenMeshTorus(radius: f32, size: f32, radSeg: i32, sides: i32) -> Mesh;
    fn GenMeshKnot(radius: f32, size: f32, radSeg: i32, sides: i32) -> Mesh;
    fn GenMeshHeightmap(heightmap: Image, size: Vector3) -> Mesh;
    fn GenMeshCubicmap(cubicmap: Image, cubeSize: Vector3) -> Mesh;

    fn LoadMaterials(fileName: *i8, materialCount: *i32) -> *Material;
    fn LoadMaterialDefault() -> Material;
    fn IsMaterialValid(material: Material) -> bool;
    fn UnloadMaterial(material: Material);
    fn SetMaterialTexture(material: *Material, mapType: i32, texture: Texture2D);
    fn SetModelMeshMaterial(model: *Model, meshId: i32, materialId: i32);

    fn LoadModelAnimations(fileName: *i8, animCount: *i32) -> *ModelAnimation;
    fn UpdateModelAnimation(model: Model, anim: ModelAnimation, frame: i32);
    fn UpdateModelAnimationBones(model: Model, anim: ModelAnimation, frame: i32);
    fn UnloadModelAnimation(anim: ModelAnimation);
    fn UnloadModelAnimations(animations: *ModelAnimation, animCount: i32);
    fn IsModelAnimationValid(model: Model, anim: ModelAnimation) -> bool;

    fn CheckCollisionSpheres(center1: Vector3, radius1: f32, center2: Vector3, radius2: f32) -> bool;
    fn CheckCollisionBoxes(box1: BoundingBox, box2: BoundingBox) -> bool;
    fn CheckCollisionBoxSphere(box: BoundingBox, center: Vector3, radius: f32) -> bool;
    fn GetRayCollisionSphere(ray: Ray, center: Vector3, radius: f32) -> RayCollision;
    fn GetRayCollisionBox(ray: Ray, box: BoundingBox) -> RayCollision;
    fn GetRayCollisionMesh(ray: Ray, mesh: Mesh, transform: Matrix) -> RayCollision;
    fn GetRayCollisionTriangle(ray: Ray, p1: Vector3, p2: Vector3, p3: Vector3) -> RayCollision;
    fn GetRayCollisionQuad(ray: Ray, p1: Vector3, p2: Vector3, p3: Vector3, p4: Vector3) -> RayCollision;
}

type AudioCallback = fn(bufferData: *void, frames: u32);

extern "C" {
    fn InitAudioDevice();
    fn CloseAudioDevice();
    fn IsAudioDeviceReady() -> bool;
    fn SetMasterVolume(volume: f32);
    fn GetMasterVolume() -> f32;

    fn LoadWave(fileName: *i8) -> Wave;
    fn LoadWaveFromMemory(fileType: *i8, fileData: *u8, dataSize: i32) -> Wave;
    fn IsWaveValid(wave: Wave) -> bool;
    fn LoadSound(fileName: *i8) -> Sound;
    fn LoadSoundFromWave(wave: Wave) -> Sound;
    fn LoadSoundAlias(source: Sound) -> Sound;
    fn IsSoundValid(sound: Sound) -> bool;
    fn UpdateSound(sound: Sound, data: *void, sampleCount: i32);
    fn UnloadWave(wave: Wave);
    fn UnloadSound(sound: Sound);
    fn UnloadSoundAlias(alias: Sound);
    fn ExportWave(wave: Wave, fileName: *i8) -> bool;
    fn ExportWaveAsCode(wave: Wave, fileName: *i8) -> bool;

    fn PlaySound(sound: Sound);
    fn StopSound(sound: Sound);
    fn PauseSound(sound: Sound);
    fn ResumeSound(sound: Sound);
    fn IsSoundPlaying(sound: Sound) -> bool;
    fn SetSoundVolume(sound: Sound, volume: f32);
    fn SetSoundPitch(sound: Sound, pitch: f32);
    fn SetSoundPan(sound: Sound, pan: f32);
    fn WaveCopy(wave: Wave) -> Wave;
    fn WaveCrop(wave: Wave, initFrame: i32, finalFrame: i32);
    fn WaveFormat(wave: Wave, sampleRate: i32, sampleSize: i32, channels: i32);
    fn LoadWaveSamples(wave: Wave) -> *f32;
    fn UnloadWaveSamples(samples: *f32);

    fn LoadMusicStream(fileName: *i8) -> Music;
    fn LoadMusicStreamFromMemory(fileType: *i8, data: *u8, dataSize: i32) -> Music;
    fn IsMusicValid(music: Music) -> bool;
    fn UnloadMusicStream(music: Music);
    fn PlayMusicStream(music: Music);
    fn IsMusicStreamPlaying(music: Music) -> bool;
    fn UpdateMusicStream(music: Music);
    fn StopMusicStream(music: Music);
    fn PauseMusicStream(music: Music);
    fn ResumeMusicStream(music: Music);
    fn SeekMusicStream(music: Music, position: f32);
    fn SetMusicVolume(music: Music, volume: f32);
    fn SetMusicPitch(music: Music, pitch: f32);
    fn SetMusicPan(music: Music, pan: f32);
    fn GetMusicTimeLength(music: Music) -> f32;
    fn GetMusicTimePlayed(music: Music) -> f32;

    fn LoadAudioStream(sampleRate: u32, sampleSize: u32, channels: u32) -> AudioStream;
    fn IsAudioStreamValid(stream: AudioStream) -> bool;
    fn UnloadAudioStream(stream: AudioStream);
    fn UpdateAudioStream(stream: AudioStream, data: *void, frameCount: i32);
    fn IsAudioStreamProcessed(stream: AudioStream) -> bool;
    fn PlayAudioStream(stream: AudioStream);
    fn PauseAudioStream(stream: AudioStream);
    fn ResumeAudioStream(stream: AudioStream);
    fn IsAudioStreamPlaying(stream: AudioStream) -> bool;
    fn StopAudioStream(stream: AudioStream);
    fn SetAudioStreamVolume(stream: AudioStream, volume: f32);
    fn SetAudioStreamPitch(stream: AudioStream, pitch: f32);
    fn SetAudioStreamPan(stream: AudioStream, pan: f32);
    fn SetAudioStreamBufferSizeDefault(size: i32);
    fn SetAudioStreamCallback(stream: AudioStream, callback: AudioCallback);

    fn AttachAudioStreamProcessor(stream: AudioStream, processor: AudioCallback);
    fn DetachAudioStreamProcessor(stream: AudioStream, processor: AudioCallback);

    fn AttachAudioMixedProcessor(processor: AudioCallback);
    fn DetachAudioMixedProcessor(processor: AudioCallback);
}