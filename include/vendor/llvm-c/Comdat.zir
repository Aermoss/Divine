#[include "vendor/llvm-c/Types.zir" : *]

enum LLVMComdatSelectionKind: i32 {
    LLVMAnyComdatSelectionKind,
    LLVMExactMatchComdatSelectionKind,
    LLVMLargestComdatSelectionKind,
    LLVMNoDeduplicateComdatSelectionKind,
    LLVMSameSizeComdatSelectionKind
}

extern "C" {
    fn LLVMGetOrInsertComdat(M: LLVMModuleRef, Name: *i8) -> LLVMComdatRef;
    fn LLVMGetComdat(V: LLVMValueRef) -> LLVMComdatRef;
    fn LLVMSetComdat(V: LLVMValueRef, C: LLVMComdatRef);
    fn LLVMGetComdatSelectionKind(C: LLVMComdatRef) -> LLVMComdatSelectionKind;
    fn LLVMSetComdatSelectionKind(C: LLVMComdatRef, Kind: LLVMComdatSelectionKind);
}
