#[include "std/io", "std/str", "std/vec", "src/Types.zir" : *]

class TypeManager {
    types: Vector<*QualifiedType>,
    void_type: *QualifiedType = null,
    bool_type: *QualifiedType = null,
    char_type: *QualifiedType = null,
    integer_literal_type: *QualifiedType = null,
    float_literal_type: *QualifiedType = null,
    signed_types: Map<u32, *QualifiedType>,
    unsigned_types: Map<u32, *QualifiedType>,
    size_types: Map<bool, *QualifiedType>,
    float_types: Map<u32, *QualifiedType>,
    pointer_types: Map<u64, *QualifiedType>,
    reference_types: Map<u64, *QualifiedType>;

    ~TypeManager(&mut this) {
        WriteLine("Disposing " + String::FromInteger(this.types.Size() as u64) + " types (" + String::FromFloat((this.types.Size() * sizeof(QualifiedType)) as f64 / 1024.0 / 1024.0) + " MB)...");

        for _type in this.types {
            del _type;
        }
    }

    pub func Void(&mut this) -> &QualifiedType {
        if this.void_type == null {
            this.void_type = new QualifiedType(TypeKind::Void, LLVMVoidTypeInContext(compiler->context));
            this.types.PushBack(this.void_type);
        } ret this.void_type;
    }

    pub func Boolean(&mut this) -> &QualifiedType {
        if this.bool_type != null {
            ret this.bool_type;
        } else {
            let _type = new QualifiedType(TypeKind::Boolean, LLVMInt1TypeInContext(compiler->context));
            this.types.PushBack(_type);
            (this.bool_type, _type->width) = (_type, 1);
            ret _type;
        }
    }

    pub func Character(&mut this) -> &QualifiedType {
        if this.char_type != null {
            ret this.char_type;
        } else {
            let _type = new QualifiedType(TypeKind::Character, LLVMInt32TypeInContext(compiler->context));
            this.types.PushBack(_type);
            (this.char_type, _type->width) = (_type, 32);
            ret _type;
        }
    }

    pub func Integer(&mut this, width: u32, signed: bool) -> &QualifiedType {
        if signed && this.signed_types.Has(width) {
            ret this.signed_types[width];
        } else if !signed && this.unsigned_types.Has(width) {
            ret this.unsigned_types[width];
        } else {
            let _type = new QualifiedType(TypeKind::Integer, LLVMIntTypeInContext(compiler->context, width));
            this.types.PushBack(_type);
            (_type->width, _type->signed) = (width, signed);

            if signed {
                this.signed_types[width] = _type;
            } else {
                this.unsigned_types[width] = _type;
            } ret _type;
        }
    }

    pub func IntegerPointer(&mut this, signed: bool) -> &QualifiedType {
        if this.size_types.Has(signed) {
            ret this.size_types[signed];
        } else {
            let _type = new QualifiedType(TypeKind::Integer, LLVMIntPtrTypeInContext(compiler->context, compiler->target->layout));
            this.types.PushBack(_type);
            (this.size_types[signed], _type->signed) = (_type, signed);
            ret _type;
        }
    }

    pub func IntegerLiteral(&mut this) -> &QualifiedType {
        if this.integer_literal_type != null {
            ret this.integer_literal_type;
        } else {
            let _type = new QualifiedType(TypeKind::IntegerLiteral, null);
            this.types.PushBack(_type);
            (this.integer_literal_type, _type->width, _type->signed) = (_type, 32, true);
            ret _type;
        }
    }

    pub func Float(&mut this, width: u32) -> &QualifiedType {
        if this.float_types.Has(width) {
            ret this.float_types[width];
        } else {
            let _type = new QualifiedType(TypeKind::Float, width == 64 ? LLVMDoubleTypeInContext(compiler->context) : LLVMFloatTypeInContext(compiler->context));
            this.types.PushBack(_type);
            (this.float_types[width], _type->width) = (_type, width);
            ret _type;
        }
    }

    pub func FloatLiteral(&mut this) -> &QualifiedType {
        if this.float_literal_type != null {
            ret this.float_literal_type;
        } else {
            let _type = new QualifiedType(TypeKind::FloatLiteral, null);
            this.types.PushBack(_type);
            (this.float_literal_type, _type->width) = (_type, 64);
            ret _type;
        }
    }

    pub func Function(&mut this, value: LLVMTypeRef, params: &Vector<ParameterType>, return: &ReturnType) -> *mut QualifiedType {
        let _type = new QualifiedType(TypeKind::Function, value);
        this.types.PushBack(_type);
        (_type->params, _type->return) = (params, return);
        ret _type;
    }

    pub func PackSpecializedFunction(&mut this, value: LLVMTypeRef, params: &Vector<ParameterType>, return: &ReturnType, declaration: *FunctionNode, pack_scope: *mut Scope) -> *mut QualifiedType {
        let _type = new QualifiedType(TypeKind::PackSpecializedFunction, value);
        this.types.PushBack(_type);
        (_type->params, _type->return, _type->name, _type->pack_name, _type->declaration, _type->pack_scope) = (params, return, declaration->name, declaration->_type->pack_name, declaration, pack_scope);
        ret _type;
    }

    pub func Function(&mut this, value: LLVMTypeRef, params: &Vector<ParameterType>, return: &ReturnType, declaration: *FunctionNode, pack_scope: *mut Scope) -> *mut QualifiedType {
        let _type = new QualifiedType(TypeKind::Function, value);
        this.types.PushBack(_type);
        (_type->params, _type->return, _type->name, _type->pack_name, _type->declaration, _type->pack_scope) = (params, return, declaration->name, declaration->_type->pack_name, declaration, pack_scope);
        ret _type;
    }

    pub func Function(&mut this, value: LLVMTypeRef, params: &Vector<ParameterType>, return: &ReturnType, name: &String) -> *mut QualifiedType {
        let _type = new QualifiedType(TypeKind::Function, value);
        this.types.PushBack(_type);
        (_type->params, _type->return, _type->name) = (params, return, name);
        ret _type;
    }

    pub func Class(&mut this, value: LLVMTypeRef, name: &String) -> *mut QualifiedType {
        let _type = new QualifiedType(TypeKind::Class, value);
        this.types.PushBack(_type);
        _type->name = name;
        ret _type;
    }

    pub func Enumeration(&mut this, underlying_type: *QualifiedType, name: &String) -> *QualifiedType {
        let _type = new QualifiedType(TypeKind::Enumeration, underlying_type->Value());
        this.types.PushBack(_type);
        (_type->width, _type->signed, _type->name) = (underlying_type->width, underlying_type->signed, name);
        ret _type;
    }

    pub func Variant(&mut this, value: LLVMTypeRef, name: &String) -> *mut QualifiedType {
        let _type = new QualifiedType(TypeKind::Variant, value);
        this.types.PushBack(_type);
        _type->name = name;
        ret _type;
    }

    pub func Pointer(&mut this, pointee: *QualifiedType, mutable: bool) -> &QualifiedType {
        let key = (pointee as u64) ^ (mutable ? 1 : 0);

        if this.pointer_types.Has(key) {
            ret this.pointer_types[key];
        } else {
            let _type = new QualifiedType(TypeKind::Pointer, LLVMPointerType(pointee->Value(), 0));
            this.types.PushBack(_type);
            (this.pointer_types[key], _type->mutable, _type->pointee) = (_type, mutable, pointee);
            ret _type;
        }
    }

    pub func NullPointer(&mut this) -> &QualifiedType {
        ret this.Pointer(this.Void(), false);
    }

    pub func Reference(&mut this, pointee: *QualifiedType, mutable: bool) -> &QualifiedType {
        let key = (pointee as u64) ^ (mutable ? 1 : 0);

        if this.reference_types.Has(key) {
            ret this.reference_types[key];
        } else {
            let _type = new QualifiedType(TypeKind::Reference, LLVMPointerType(pointee->Value(), 0));
            this.types.PushBack(_type);
            (this.reference_types[key], _type->mutable, _type->pointee) = (_type, mutable, pointee);
            ret _type;
        }
    }

    pub func Array(&mut this, pointee: *QualifiedType, length: usize, mutable: bool) -> &QualifiedType {
        let _type = new QualifiedType(TypeKind::Array, LLVMArrayType2(pointee->Value(), length as u64));
        this.types.PushBack(_type);
        (_type->mutable, _type->length, _type->pointee) = (mutable, length, pointee);
        ret _type;
    }

    pub func Copy(&mut this, _type: *QualifiedType, mutable: bool) -> *QualifiedType {
        if !_type->IsPointer() {
            Logger::Log("TypeManager", "Cannot copy non-pointer type!", LogSeverity::Fatal);
        } else if mutable == _type->IsMutable() {
            ret _type;
        }

        let key = (_type->pointee as u64) ^ (mutable ? 1 : 0);

        if this.pointer_types.Has(key) {
            ret this.pointer_types[key];
        } else {
            let copy = new QualifiedType(TypeKind::Pointer, _type->value);
            this.types.PushBack(copy);
            (this.pointer_types[key], copy->mutable, copy->pointee) = (copy, mutable, _type->pointee);
            ret copy;
        }
    }
}

#[include "src/Compiler.zir" : *]
