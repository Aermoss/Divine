#[include "std/str", "src/Value.zir" : *]

enum SymbolKind: i32 {
    Variable, GlobalVariable, Constant, Function, Parameter, Generic, Variant, Class, Type
}

fn ToString(kind: SymbolKind) -> String {
    if kind == SymbolKind::Variable { return "Variable".ToString(); }
    else if kind == SymbolKind::GlobalVariable { return "GlobalVariable".ToString(); }
    else if kind == SymbolKind::Constant { return "Constant".ToString(); }
    else if kind == SymbolKind::Function { return "Function".ToString(); }
    else if kind == SymbolKind::Parameter { return "Parameter".ToString(); }
    else if kind == SymbolKind::Generic { return "Generic".ToString(); }
    else if kind == SymbolKind::Variant { return "Variant".ToString(); }
    else if kind == SymbolKind::Class { return "Class".ToString(); }
    else if kind == SymbolKind::Type { return "Type".ToString(); }
    else { return "Unknown".ToString(); }
}

class Symbol {
    pub name: String,
    pub kind: SymbolKind,
    pub value: QualifiedValue,
    pub pointer: *void = null;

    Symbol(&mut this, name: String, kind: SymbolKind, value: QualifiedValue) {
        (this.name, this.kind, this.value) = (name, kind, value);
    }

    Symbol(&mut this, name: String, kind: SymbolKind, pointer: *void) {
        (this.name, this.kind, this.pointer) = (name, kind, pointer);
    }
}
