#[include "std/io", "std/str", "std/vec", "src/Types.zir" : *]

class TypeManager {
    priv types: Vector<*const QualifiedType>;

    ~TypeManager(&mut this) {
        WriteLine("Disposing " + String(this.types.Size() as i64) + " types (" + String((this.types.Size() * sizeof(QualifiedType)) as f64 / 1024.0f64 / 1024.0f64) + " MB)...");

        for _type in this.types {
            del _type;
        }
    }

    pub Primitive(&mut this, value: LLVMTypeRef, signed: bool) -> *const QualifiedType {
        let _type: *mut QualifiedType = new QualifiedType(TypeKind::Primitive, value);
        this.types.PushBack(_type);
        _type->signed = signed;
        ret _type;
    }

    pub Function(&mut this, value: LLVMTypeRef, params: &Vector<ParameterType>, return: &ReturnType) -> *mut QualifiedType {
        let _type: *mut QualifiedType = new QualifiedType(TypeKind::Function, value);
        this.types.PushBack(_type);
        (_type->params, _type->return) = (params, return);
        ret _type;
    }

    pub PackSpecializedFunction(&mut this, value: LLVMTypeRef, params: &Vector<ParameterType>, return: &ReturnType, declaration: *const FunctionNode, pack_scope: *mut Scope) -> *mut QualifiedType {
        let _type: *mut QualifiedType = new QualifiedType(TypeKind::PackSpecializedFunction, value);
        this.types.PushBack(_type);
        (_type->params, _type->return, _type->name, _type->pack_name, _type->declaration, _type->pack_scope) = (params, return, declaration->name, declaration->_type->pack_name, declaration, pack_scope);
        ret _type;
    }

    pub Function(&mut this, value: LLVMTypeRef, params: &Vector<ParameterType>, return: &ReturnType, declaration: *const FunctionNode, pack_scope: *mut Scope) -> *mut QualifiedType {
        let _type: *mut QualifiedType = new QualifiedType(TypeKind::Function, value);
        this.types.PushBack(_type);
        (_type->params, _type->return, _type->name, _type->pack_name, _type->declaration, _type->pack_scope) = (params, return, declaration->name, declaration->_type->pack_name, declaration, pack_scope);
        ret _type;
    }

    pub Function(&mut this, value: LLVMTypeRef, params: &Vector<ParameterType>, return: &ReturnType, name: &String) -> *mut QualifiedType {
        let _type: *mut QualifiedType = new QualifiedType(TypeKind::Function, value);
        this.types.PushBack(_type);
        (_type->params, _type->return, _type->name) = (params, return, name);
        ret _type;
    }

    pub Class(&mut this, value: LLVMTypeRef, name: &String) -> *mut QualifiedType {
        let _type: *mut QualifiedType = new QualifiedType(TypeKind::Class, value);
        this.types.PushBack(_type);
        _type->name = name;
        ret _type;
    }

    pub Enum(&mut this, value: LLVMTypeRef, name: &String) -> *mut QualifiedType {
        let _type: *mut QualifiedType = new QualifiedType(TypeKind::Enum, value);
        this.types.PushBack(_type);
        _type->name = name;
        ret _type;
    }

    pub Pointer(&mut this, pointee: *const QualifiedType, mutable: bool) -> *const QualifiedType {
        let _type: *mut QualifiedType = new QualifiedType(TypeKind::Pointer, LLVMPointerType(pointee->Value(), 0u32));
        this.types.PushBack(_type);
        (_type->mutable, _type->pointee) = (mutable, pointee);
        ret _type;
    }

    pub NullPointer(&mut this, value: LLVMTypeRef) -> *const QualifiedType {
        let pointee: *mut QualifiedType = new QualifiedType(TypeKind::Null, value);
        this.types.PushBack(pointee);
        let _type: *mut QualifiedType = new QualifiedType(TypeKind::Pointer, LLVMPointerType(value, 0u32));
        this.types.PushBack(_type);
        (_type->mutable, _type->pointee) = (false, pointee);
        ret _type;
    }

    pub Reference(&mut this, pointee: *const QualifiedType, mutable: bool) -> *const QualifiedType {
        let _type: *mut QualifiedType = new QualifiedType(TypeKind::Reference, LLVMPointerType(pointee->Value(), 0u32));
        this.types.PushBack(_type);
        (_type->mutable, _type->pointee) = (mutable, pointee);
        ret _type;
    }

    pub Array(&mut this, pointee: *const QualifiedType, size: u64, mutable: bool) -> *const QualifiedType {
        let _type: *mut QualifiedType = new QualifiedType(TypeKind::Array, LLVMArrayType2(pointee->Value(), size));
        this.types.PushBack(_type);
        (_type->mutable, _type->size, _type->pointee) = (mutable, size, pointee);
        ret _type;
    }

    pub Copy(&mut this, _type: *mut QualifiedType, mutable: bool) -> *const QualifiedType {
        if mutable != _type->IsMutable() {
            let mut copy: *mut QualifiedType = null;

            if _type->IsPointer() {
                copy = new QualifiedType(_type->kind, _type->value);
                (copy->mutable, copy->pointee) = (_type->mutable, _type->pointee);
            } else {
                Logger::Log("TypeManager", "Cannot copy non-pointer type.", LogSeverity::Error);
                ret null;
            }

            this.types.PushBack(copy);
            ret copy;
        } else {
            ret _type;
        }
    }
}
