#[include "std/str", "std/vec", "std/map", "std/pair", "vendor/llvm-c/Core.zir", "vendor/llvm-c/Analysis.zir",
    "src/Target.zir", "src/Tokens.zir", "src/Nodes.zir", "src/HIR.zir", "src/Logger.zir" : *]

class CodeGenerator {
    module: LLVMModuleRef = null,
    builder: LLVMBuilderRef = null,
    context: LLVMContextRef,
    target: *Target,

    freestanding: bool,
    no_red_zone: bool;

    CodeGenerator(&mut this, target: &Target, freestanding: bool, no_red_zone: bool) {
        (this.freestanding, this.no_red_zone) = (freestanding, no_red_zone);
        (this.context, this.target) = (LLVMContextCreate(), target);
    }

    ~CodeGenerator(&mut this) {
        if this.builder != null {
            LLVMDisposeBuilder(this.builder);
            this.builder = null;
        }

        if this.module != null {
            LLVMDisposeModule(this.module);
            this.module = null;
        }

        LLVMContextDispose(this.context);
    }

    pub fn Generate(&mut this, module: *HIRModule) -> LLVMModuleRef {
        if this.builder != null {
            LLVMDisposeBuilder(this.builder);
            this.builder = null;
        }

        if this.module != null {
            LLVMDisposeModule(this.module);
            this.module = null;
        }

        this.module = LLVMModuleCreateWithNameInContext("zircon", this.context);
        this.builder = LLVMCreateBuilderInContext(this.context);
        LLVMSetModuleDataLayout(this.module, this.target->layout);
        LLVMSetTarget(this.module, this.target->triple.Data());

        if module != null {
            this.GenerateModule(module);
        }

        let mut message: *mut i8 = null;

        if LLVMVerifyModule(this.module, LLVMVerifierFailureAction::LLVMReturnStatusAction, &mut message) != 0 {
            let final_message = message != null ? message : "Unknown reason.";
            Logger::Log("Module verification failed: " + final_message.ToString(), LogSeverity::Error);

            if message != null {
                LLVMDisposeMessage(message);
            } return null;
        }

        if message != null {
            LLVMDisposeMessage(message);
        } return this.module;
    }

    fn GenerateModule(&mut this, module: *HIRModule) {
        for function in module->functions {
            this.GenerateFunction(function);
        }
    }

    fn GenerateFunction(&mut this, function: *HIRFunction) {
        let return_type = this.GenerateType(function->_type->Return());
        if return_type == null { return; }
        let param_types = Vector<LLVMTypeRef>();

        for param in function->_type->Parameters() {
            let _type = this.GenerateType(param);
            if _type == null { return; }
            param_types.PushBack(_type);
        }

        let _type = LLVMFunctionType(return_type, param_types.Data(), param_types.Size() as u32, 0);
        let value = LLVMAddFunction(this.module, function->name.Data(), _type);

        if function->body != null {
            /* let entry = LLVMAppendBasicBlockInContext(this.context, value, "");
            LLVMPositionBuilderAtEnd(this.builder, entry); */
            this.GenerateBlock(function->body);
        }
    }

    fn GenerateStatement(&mut this, statement: *HIRStatement) {
        if statement->kind == HIRStatementKind::Block {
            this.GenerateBlock(statement as *HIRBlock);
        }
    }

    fn GenerateBlock(&mut this, block: *HIRBlock) {
        for statement in block->statements {
            this.GenerateStatement(statement);
        }
    }

    fn GenerateType(&mut this, _type: *SemanticType) -> LLVMTypeRef {
        if _type->IsVoid() {
            return LLVMVoidTypeInContext(this.context);
        } else if _type->IsBoolean() {
            return LLVMInt1TypeInContext(this.context);
        } else if _type->IsCharacter() {
            return LLVMInt32TypeInContext(this.context);
        } else if _type->IsInteger() {
            return LLVMIntTypeInContext(this.context, _type->Width());
        } else if _type->IsFloat() {
            if _type->Width() == 64 {
                return LLVMDoubleTypeInContext(this.context);
            } else {
                return LLVMFloatTypeInContext(this.context);
            }
        } else if _type->IsPointer() {
            let pointee_type = this.GenerateType(_type->pointee);
            if pointee_type == null { return null; }
            return LLVMPointerType(pointee_type, 0);
        } else if _type->IsFunction() {
            let return_type = this.GenerateType(_type->Return());
            if return_type == null { return null; }
            let param_types = Vector<LLVMTypeRef>();

            for param in _type->Parameters() {
                let param_type = this.GenerateType(param);
                if param_type == null { return null; }
                param_types.PushBack(param_type);
            }

            return LLVMFunctionType(return_type, param_types.Data(), param_types.Size() as u32, 0);
        } else {
            return null;
        }
    }
}
