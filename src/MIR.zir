#[include "src/Types.zir" : *]

enum MIRInstructionKind {
    Alloca, Call
}

enum MIRInstructionRepresentation {
    Direct, Indirect
}

class MIRInstruction {
    pub kind: MIRInstructionKind,
    pub representation: MIRInstructionRepresentation;

    MIRInstruction(&mut this, kind: MIRInstructionKind) {
        (this.kind, this.representation) = (kind, MIRInstructionRepresentation::Direct);
    }

    MIRInstruction(&mut this, kind: MIRInstructionKind, representation: MIRInstructionRepresentation) {
        (this.kind, this.representation) = (kind, representation);
    }
}

class MIRAlloca : MIRInstruction {
    pub _type: *SemanticType;

    MIRAlloca(&mut this, _type: *SemanticType) : MIRInstruction(MIRInstructionKind::Alloca) {
        this._type = _type;
    }
}

class MIRBlock {
    pub instructions: Vector<*MIRInstruction>;

    MIRBlock(&mut this) {}
}

enum MIRDeclarationKind: u8 {
    Function, Constant, Static
}

class MIRDeclaration {
    pub kind: MIRDeclarationKind,
    pub name: String;

    MIRDeclaration(&mut this, kind: MIRDeclarationKind, name: String) {
        (this.kind, this.name) = (kind, name);
    }
}

class MIRConstant : MIRDeclaration {
    pub _type: *SemanticType,
    pub initializer: *MIRInstruction;

    MIRConstant(&mut this, name: String, linkage: MIRDeclarationLinkage, _type: *SemanticType, initializer: *MIRInstruction) : MIRDeclaration(MIRDeclarationKind::Constant, name) {
        (this._type, this.initializer) = (_type, initializer);
    }
}

enum MIRDeclarationLinkage: u8 {
    Internal, External
}

class MIRLinkableDeclaration : MIRDeclaration {
    pub linkage: MIRDeclarationLinkage;

    MIRLinkableDeclaration(&mut this, kind: MIRDeclarationKind, name: String, linkage: MIRDeclarationLinkage) : MIRDeclaration(kind, name) {
        this.linkage = linkage;
    }
}

class MIRFunction : MIRLinkableDeclaration {
    pub blocks: Vector<*MIRBlock>;

    MIRFunction(&mut this, name: String, linkage: MIRDeclarationLinkage) : MIRLinkableDeclaration(MIRDeclarationKind::Function, name, linkage) {}
}

class MIRStatic : MIRLinkableDeclaration {
    pub _type: *SemanticType,
    pub mutable: bool,
    pub initializer: *MIRInstruction;

    MIRStatic(&mut this, name: String, linkage: MIRDeclarationLinkage, _type: *SemanticType, mutable: bool, initializer: *MIRInstruction) : MIRLinkableDeclaration(MIRDeclarationKind::Static, name, linkage) {
        (this._type, this.mutable, this.initializer) = (_type, mutable, initializer);
    }
}

class MIRModule {
    pub declarations: Vector<*MIRDeclaration>;

    MIRModule(&mut this) {}
}
