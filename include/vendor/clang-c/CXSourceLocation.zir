#[include "vendor/clang-c/CXFile.zir", "vendor/clang-c/CXString.zir" : *]

struct CXSourceLocation {
    pub ptr_data[2]: *void,
    pub int_data: u32
}

struct CXSourceRange {
    pub ptr_data[2]: *void,
    pub begin_int_data: u32,
    pub end_int_data: u32
}

struct CXSourceRangeList {
    pub count: u32,
    pub ranges: *mut CXSourceRange
}

extern "C" {
    fn clang_getNullLocation() -> CXSourceLocation;
    fn clang_equalLocations(loc1: CXSourceLocation, loc2: CXSourceLocation) -> u32;
    fn clang_isBeforeInTranslationUnit(loc1: CXSourceLocation, loc2: CXSourceLocation) -> u32;
    fn clang_Location_isInSystemHeader(location: CXSourceLocation) -> i32;
    fn clang_Location_isFromMainFile(location: CXSourceLocation) -> i32;
    fn clang_getNullRange() -> CXSourceRange;
    fn clang_getRange(begin: CXSourceLocation, end: CXSourceLocation) -> CXSourceRange;
    fn clang_equalRanges(range1: CXSourceRange, range2: CXSourceRange) -> u32;
    fn clang_Range_isNull(range: CXSourceRange) -> i32;
    fn clang_getExpansionLocation(location: CXSourceLocation, file: *mut CXFile, line: *mut u32, column: *mut u32, offset: *mut u32);
    fn clang_getPresumedLocation(location: CXSourceLocation, filename: *mut CXString, line: *mut u32, column: *mut u32);
    fn clang_getInstantiationLocation(location: CXSourceLocation, file: *mut CXFile, line: *mut u32, column: *mut u32, offset: *mut u32);
    fn clang_getSpellingLocation(location: CXSourceLocation, file: *mut CXFile, line: *mut u32, column: *mut u32, offset: *mut u32);
    fn clang_getFileLocation(location: CXSourceLocation, file: *mut CXFile, line: *mut u32, column: *mut u32, offset: *mut u32);
    fn clang_getRangeStart(range: CXSourceRange) -> CXSourceLocation;
    fn clang_getRangeEnd(range: CXSourceRange) -> CXSourceLocation;
    fn clang_disposeSourceRangeList(ranges: *mut CXSourceRangeList);
}
