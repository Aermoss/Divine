#[include "std/str", "std/vec", "std/file", "src/Lexer.zir", "src/Tokens.zir", "src/Logger.zir" : *]

class Preprocessor {
    pub defines: Vector<String>,
    pub include_paths: Vector<String>,
    priv included_paths: Vector<String>,
    priv conditions: Vector<bool>,
    priv taken: Vector<bool>,
    priv tokens: Vector<Token>,
    priv index: u64;

    priv Current(&this) -> Token {
        if this.index >= this.tokens.Size() {
            ret this.tokens[this.tokens.Size() - 1u64];
        } else {
            ret this.tokens[this.index];
        }
    }

    priv Peek(&this, offset: u64) -> Token {
        let index = this.index + offset;

        if index >= this.tokens.Size() {
            ret this.tokens[this.tokens.Size() - 1u64];
        } else {
            ret this.tokens[index];
        }
    }

    priv Advance(&mut this) -> Token {
        let token = this.Current();

        if this.index < this.tokens.Size() {
            this.index += 1u64;
        } ret token;
    }

    priv Match(&mut this, _type: TokenType) -> bool {
        if this.Current()._type == _type {
            this.Advance();
            ret true;
        } else {
            ret false;
        }
    }

    priv Expect(&mut this, _type: TokenType) -> Token {
        let token = this.Current();

        if token._type != _type {
            Logger::Log("Expected '" + _type.ToString() + "' but got '" + token._type.ToString() + "'.", token, LogSeverity::Error);
        } else {
            this.Advance();
        } ret token;
    }

    pub Condition(&this) -> bool {
        for condition in this.conditions {
            if !condition { ret false; }
        } ret true;
    }

    priv ProcessPrimary(&mut this) -> bool {
        if this.Match(TokenType::TRUE) {
            ret true;
        } else if this.Match(TokenType::FALSE) {
            ret false;
        } else if this.Match(TokenType::LPAREN) {
            let result = this.ProcessExpression();
            this.Expect(TokenType::RPAREN);
            ret result;
        } else {
            let name = this.Expect(TokenType::IDENTIFIER).value;
            ret this.defines.Contains(name);
        }
    }

    priv ProcessNotExpression(&mut this) -> bool {
        if this.Match(TokenType::NOT) {
            ret !this.ProcessNotExpression();
        } ret this.ProcessPrimary();
    }

    priv ProcessAndExpression(&mut this) -> bool {
        let mut result = this.ProcessNotExpression();

        while this.Current()._type == TokenType::AND {
            this.Advance();
            let right = this.ProcessNotExpression();
            result = result && right;
        } ret result;
    }

    priv ProcessOrExpression(&mut this) -> bool {
        let mut result = this.ProcessAndExpression();

        while this.Current()._type == TokenType::OR {
            this.Advance();
            let right = this.ProcessAndExpression();
            result = result || right;
        } ret result;
    }

    priv ProcessExpression(&mut this) -> bool {
        ret this.ProcessOrExpression();
    }

    priv ProcessInclude(&mut this, result: &mut Vector<Token>) {
        loop {
            let token = this.Expect(TokenType::STRING);
            let mut found = false;

            for include_path in this.include_paths {
                let mut path = JoinPath(include_path, token.value);

                if !PathExists(path) {
                    continue;
                }

                if FolderExists(path) {
                    path = JoinPath(path, String("Entry.zir"));

                    if !PathExists(path) {
                        Logger::Log("Module '" + token.value + "' entry point not found.", token, LogSeverity::Error);
                        ret;
                    }
                }

                path = AbsolutePath(path);

                if this.included_paths.Index(path #[if WINDOWS || DARWIN] .ToLower() #[endif]) != -1i64 {
                    found = true;
                    break;
                }

                let taken: Vector<bool>;
                this.taken.Swap(taken);
                let tokens: Vector<Token>;
                this.tokens.Swap(tokens);
                let conditions: Vector<bool>;
                this.conditions.Swap(conditions);
                let index = this.index;

                let mut lexer: Lexer;
                result += this.Process(lexer.Lex(_ReadFile(path), path), path);
                result.PopBack();

                (this.index, found) = (index, true);
                this.conditions.Swap(conditions);
                this.tokens.Swap(tokens);
                this.taken.Swap(taken);
                break;
            }

            if !found {
                Logger::Log("Module '" + token.value + "' not found.", token, LogSeverity::Error);
                ret;
            }

            if !this.Match(TokenType::COMMA) {
                break;
            }
        }

        this.Expect(TokenType::COLON);
        this.Expect(TokenType::MUL);
    }

    pub ProcessDirective(&mut this, result: &mut Vector<Token>) {
        let token = this.Current();

        if this.Match(TokenType::INCLUDE) {
            this.ProcessInclude(result);
        } else if this.Match(TokenType::IF) {
            let active = this.ProcessExpression();
            this.conditions.PushBack(active);
            this.taken.PushBack(active);
        } else if this.Match(TokenType::ELIF) {
            let active = this.ProcessExpression();

            if this.conditions.Empty() {
                Logger::Log("Unexpected 'elif' directive.", token, LogSeverity::Error);
            } else if this.taken[this.taken.Size() - 1u64] {
                this.conditions[this.conditions.Size() - 1u64] = false;
            } else {
                this.conditions[this.conditions.Size() - 1u64] = active;
                this.taken[this.taken.Size() - 1u64] = active;
            }
        } else if this.Match(TokenType::ELSE) {
            if this.conditions.Empty() {
                Logger::Log("Unexpected 'else' directive.", token, LogSeverity::Error);
            } else if this.taken[this.taken.Size() - 1u64] {
                this.conditions[this.conditions.Size() - 1u64] = false;
            } else {
                this.conditions[this.conditions.Size() - 1u64] = true;
                this.taken[this.taken.Size() - 1u64] = true;
            }
        } else if this.Match(TokenType::ENDIF) {
            if !this.conditions.Empty() {
                this.conditions.PopBack();
                this.taken.PopBack();
            } else {
                Logger::Log("Unexpected 'endif' directive.", token, LogSeverity::Error);
            }
        } else if this.Match(TokenType::ERROR) {
            Logger::Log(this.Expect(TokenType::STRING).value, token, LogSeverity::Error);
        } else if this.Match(TokenType::WARNING) {
            Logger::Log(this.Expect(TokenType::STRING).value, token, LogSeverity::Warning);
        } else {
            Logger::Log("Unknown directive: '" + token.value + "'.", token, LogSeverity::Error);
        }
    }

    pub Process(&mut this, tokens: &Vector<Token>, file: &String) -> Vector<Token> {
        (this.tokens, this.index) = (tokens, 0u64);
        this.included_paths.PushBack(AbsolutePath(file) #[if WINDOWS || DARWIN] .ToLower() #[endif]);
        let mut result: Vector<Token>;

        loop {
            let token = this.Current();

            if this.Match(TokenType::PREPROCESSOR_START) {
                this.ProcessDirective(result);
                this.Expect(TokenType::PREPROCESSOR_END);
            } else if token._type != TokenType::EOF {
                if this.Condition() {
                    result.PushBack(token);
                } this.Advance();
            } else {
                if !this.conditions.Empty() {
                    Logger::Log("Expected 'endif' directive.", token, LogSeverity::Error);
                }

                result.PushBack(token);
                break;
            }
        } ret result;
    }
}
