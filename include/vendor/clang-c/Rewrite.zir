#[include "vendor/clang-c/CXString.zir", "vendor/clang-c/Index.zir" : *]

type CXRewriter = *mut void;

extern "C" {
    fn clang_CXRewriter_create(TU: CXTranslationUnit) -> CXRewriter;
    fn clang_CXRewriter_insertTextBefore(Rew: CXRewriter, Loc: CXSourceLocation, Insert: *i8);
    fn clang_CXRewriter_replaceText(Rew: CXRewriter, ToBeReplaced: CXSourceRange, Replacement: *i8);
    fn clang_CXRewriter_removeText(Rew: CXRewriter, ToBeRemoved: CXSourceRange);
    fn clang_CXRewriter_overwriteChangedFiles(Rew: CXRewriter) -> i32;
    fn clang_CXRewriter_writeMainFileToStdOut(Rew: CXRewriter);
    fn clang_CXRewriter_dispose(Rew: CXRewriter);
}
