#[include "std/vec", "std/pair" : *]

class Map<K, V> {
    priv vector: Vector<Pair<K, V>>;

    Map(&mut this) {}

    Map(&mut this, other: &Map<K, V>) {
        this.vector = other.vector;
    }

    ~Map(&mut this) {}

    pub func Data(&this) -> *Pair<K, V> { ret this.vector.Data(); }
    pub func Empty(&this) -> bool { ret this.vector.Empty(); }
    pub func Size(&this) -> usize { ret this.vector.Size(); }

    pub func Clear(&mut this) {
        this.vector.Clear();
    }

    pub func Swap(&mut this, other: &mut Map<K, V>) {
        this.vector.Swap(other.vector);
    }

    pub func Keys(&this) -> Vector<K> {
        let mut keys: Vector<K>;

        for pair in this.vector {
            keys.PushBack(pair.left);
        } ret keys;
    }

    pub func Values(&this) -> Vector<V> {
        let mut values: Vector<V>;

        for pair in this.vector {
            values.PushBack(pair.right);
        } ret values;
    }

    pub func Has(&this, key: K) -> bool {
        for pair in this.vector {
            if pair.left == key {
                ret true;
            }
        } ret false;
    }

    pub func Get(&this, key: K, default: V) -> V {
        for pair in this.vector {
            if pair.left == key {
                ret pair.right;
            }
        } ret default;
    }

    pub func Remove(&mut this, key: K) {
        for i in 0..this.vector.Size() {
            if this.vector[i].left == key {
                this.vector.RemoveAt(i);
                ret;
            }
        }
    }

    pub func Index(&this, key: K) -> isize {
        for i in 0..this.vector.Size() {
            if this.vector[i].left == key {
                ret i as isize;
            }
        } ret -1;
    }

    pub func op=(&mut this, other: &Map<K, V>) -> &mut Map<K, V> {
        this.vector = other.vector;
        ret this;
    }

    pub func op[](&mut this, key: K) -> &mut V {
        for pair in this.vector {
            if pair.left == key {
                ret pair.right;
            }
        }

        this.vector.PushBack(Pair<K, V>(key));
        ret this.vector[this.vector.Size() - 1].right;
    }

    pub func op[](&this, index: usize) -> &mut Pair<K, V> {
        ret this.vector[index];
    }

    pub func Begin(&this) -> *mut Pair<K, V> {
        ret this.vector.Begin();
    }

    pub func End(&this) -> *mut Pair<K, V> {
        ret this.vector.End();
    }
}