#[include "std/math" : *]

static hash[]: u8 = {
    208, 34, 231, 213, 32, 248, 233, 56, 161, 78, 24, 140, 71, 48, 140, 254, 245, 255, 247, 247, 40,
    185, 248, 251, 245, 28, 124, 204, 204, 76, 36, 1, 107, 28, 234, 163, 202, 224, 245, 128, 167, 204,
    9, 92, 217, 54, 239, 174, 173, 102, 193, 189, 190, 121, 100, 108, 167, 44, 43, 77, 180, 204, 8, 81,
    70, 223, 11, 38, 24, 254, 210, 210, 177, 32, 81, 195, 243, 125, 8, 169, 112, 32, 97, 53, 195, 13,
    203, 9, 47, 104, 125, 117, 114, 124, 165, 203, 181, 235, 193, 206, 70, 180, 174, 0, 167, 181, 41,
    164, 30, 116, 127, 198, 245, 146, 87, 224, 149, 206, 57, 4, 192, 210, 65, 210, 129, 240, 178, 105,
    228, 108, 245, 148, 140, 40, 35, 195, 38, 58, 65, 207, 215, 253, 65, 85, 208, 76, 62, 3, 237, 55, 89,
    232, 50, 217, 64, 244, 157, 199, 121, 252, 90, 17, 212, 203, 149, 152, 140, 187, 234, 177, 73, 174,
    193, 100, 192, 143, 97, 53, 145, 135, 19, 103, 13, 90, 135, 151, 199, 91, 239, 247, 33, 39, 145,
    101, 120, 99, 3, 186, 86, 99, 41, 237, 203, 111, 79, 220, 135, 158, 42, 30, 154, 120, 67, 87, 167,
    135, 176, 183, 191, 253, 115, 184, 21, 233, 58, 129, 233, 142, 39, 128, 211, 118, 137, 139, 255,
    114, 20, 218, 113, 154, 27, 127, 246, 250, 1, 8, 198, 250, 209, 92, 222, 173, 21, 88, 102, 219
};

fn Hash(x: i32, y: i32, seed: i32) -> i32 {
    let mut y_index = (y + seed) % 256;

    if y_index < 0 {
        y_index += 256;
    }

    let y_value: u8 = hash[y_index as usize];
    let mut x_index = (y_value as i32 + x) % 256;

    if x_index < 0 {
        x_index += 256;
    }

    let x_value: u8 = hash[x_index as usize];
    return x_value as i32;
}

fn Lerp(x: f64, y: f64, t: f64) -> f64 {
    return x + t * (y - x);
}

fn Smooth(x: f64, y: f64, t: f64) -> f64 {
    return Lerp(x, y, t * t * (3.0 - 2.0 * t));
}

fn Noise(x: f64, y: f64, seed: i32) -> f64 {
    let x_int = floor(x) as i32;
    let y_int = floor(y) as i32;
    let x_frac = x - (x_int as f64);
    let y_frac = y - (y_int as f64);
    let s = Hash(x_int, y_int, seed);
    let t = Hash(x_int + 1, y_int, seed);
    let u = Hash(x_int, y_int + 1, seed);
    let v = Hash(x_int + 1, y_int + 1, seed);
    let low = Smooth(s as f64, t as f64, x_frac);
    let high = Smooth(u as f64, v as f64, x_frac);
    return Smooth(low, high, y_frac);
}

fn Perlin(x: f64, y: f64, freq: f64, depth: i32, seed: i32) -> f64 {
    let mut xa = x * freq;
    let mut ya = y * freq;
    let mut amp = 1.0;
    let mut fin = 0.0;
    let mut div = 0.0;
    let mut i = 0;

    while i < depth {
        div += 256.0 * amp;
        fin += Noise(xa, ya, seed) * amp;
        amp /= 2.0;
        xa *= 2.0;
        ya *= 2.0;
        i += 1;
    } return fin / div;
}