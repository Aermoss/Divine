#[include "std/str", "std/vec", "src/Logger.zir", "src/Token.zir" : *]

class Lexer {
    row: u32, column: u32,
    text: String, file: String,
    length: usize, index: usize,
    preprocessor: bool = false,
    assembly: bool = false;

    fn IsDigit(&this, character: i8) -> bool {
        return character >= '0' && character <= '9';
    }

    fn IsHexDigit(&this, character: i8) -> bool {
        return (character >= '0' && character <= '9') || (character >= 'a' && character <= 'f') || (character >= 'A' && character <= 'F');
    }

    fn IsBinDigit(&this, character: i8) -> bool {
        return character == '0' || character == '1';
    }

    fn IsOctDigit(&this, character: i8) -> bool {
        return character >= '0' && character <= '7';
    }

    fn IsAlpha(&this, character: i8) -> bool {
        return (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') || character == '_';
    }

    fn IsAlphaNum(&this, character: i8) -> bool {
        return this.IsAlpha(character) || this.IsDigit(character);
    }

    fn CurrentChar(&this) -> i8 {
        if this.index >= this.length { return '\0'; }
        return this.text.Data()[this.index];
    }

    fn PeekChar(&this, offset: usize) -> i8 {
        let peek_index = this.index + offset;
        if peek_index >= this.length { return '\0'; }
        return this.text.Data()[peek_index];
    }

    fn Advance(&mut this, count: usize) {
        for _ in 0..count {
            if this.index < this.length {
                if this.CurrentChar() == '\n' {
                    this.row += 1;
                    this.column = 1;
                } else {
                    this.column += 1;
                } this.index += 1;
            }
        }
    }

    fn SkipWhitespace(&mut this) {
        while this.CurrentChar() == ' ' || this.CurrentChar() == '\t' || this.CurrentChar() == '\r' {
            this.Advance(1);
        }
    }

    fn SkipComment(&mut this) -> bool {
        if this.CurrentChar() == '/' {
            if this.PeekChar(1) == '/' {
                while this.CurrentChar() != '\n' && this.CurrentChar() != '\0' {
                    this.Advance(1);
                } return true;
            } else if this.PeekChar(1) == '*' {
                this.Advance(2);

                while this.CurrentChar() != '\0' {
                    if this.CurrentChar() == '*' && this.PeekChar(1) == '/' {
                        this.Advance(2);
                        break;
                    } this.Advance(1);
                } return true;
            }
        } return false;
    }

    fn LexString(&mut this) -> Token {
        let mut token: Token;
        (token.row, token.column, token.file) = (this.row, this.column, this.file);
        let quote_char = this.CurrentChar();
        token._type = quote_char != '"' ? TokenType::CHAR : TokenType::STRING;
        this.Advance(1);

        while this.CurrentChar() != quote_char && this.CurrentChar() != '\n' && this.CurrentChar() != '\0' {
            if this.CurrentChar() == '\\' {
                this.Advance(1);

                if this.CurrentChar() != '\0' {
                    let escaped = this.CurrentChar();

                    if escaped == '\'' {
                        token.value += "'";
                    } else if escaped == '"' {
                        token.value += "\"";
                    } else if escaped == '?' {
                        token.value += "\?";
                    } else if escaped == '\\' {
                        token.value += "\\";
                    } else if escaped == 'a' {
                        token.value += "\a";
                    } else if escaped == 'b' {
                        token.value += "\b";
                    } else if escaped == 'f' {
                        token.value += "\f";
                    } else if escaped == 'n' {
                        token.value += "\n";
                    } else if escaped == 'r' {
                        token.value += "\r";
                    } else if escaped == 't' {
                        token.value += "\t";
                    } else if escaped == 'v' {
                        token.value += "\v";
                    } else if escaped == 'x' {
                        this.Advance(1);
                        let mut value = String();

                        while this.IsHexDigit(this.CurrentChar()) {
                            value += this.CurrentChar();
                            this.Advance(1);
                        } else {
                            Logger::Log("Invalid hexadecimal escape sequence.", token, LogSeverity::Error);
                        }

                        if value.Size() > 3 {
                            Logger::Log("Hexadecimal escape sequence too long.", token, LogSeverity::Error);
                        }

                        token.value += value.ToInteger(16) as i8;
                        this.index -= 1;
                    } else {
                        let mut value = String();

                        while this.IsOctDigit(this.CurrentChar()) {
                            value += this.CurrentChar();
                            this.Advance(1);
                        } else {
                            Logger::Log("Invalid octal escape sequence.", token, LogSeverity::Error);
                        }

                        if value.Size() > 4 {
                            Logger::Log("Octal escape sequence too long.", token, LogSeverity::Error);
                        }

                        token.value += value.ToInteger(8) as i8;
                        this.index -= 1;
                    } this.Advance(1);
                }
            } else {
                token.value += this.CurrentChar();
                this.Advance(1);
            }
        }

        if this.CurrentChar() == quote_char {
            this.Advance(1);
        } else {
            Logger::Log("Unterminated string literal.", token, LogSeverity::Error);
        } return token;
    }

    fn LexNumber(&mut this) -> Token {
        let mut token: Token;
        (token.row, token.column, token.file) = (this.row, this.column, this.file);
        token._type = TokenType::INTEGER;

        if this.CurrentChar() == '-' {
            token.value += this.CurrentChar();
            this.Advance(1);
        }

        if this.CurrentChar() == '0' {
            token.value += this.CurrentChar();
            this.Advance(1);

            if this.CurrentChar() == 'x' || this.CurrentChar() == 'X' {
                token.value += this.CurrentChar();
                this.Advance(1);

                while this.IsHexDigit(this.CurrentChar()) {
                    token.value += this.CurrentChar();
                    this.Advance(1);
                }
            } else if this.CurrentChar() == 'b' || this.CurrentChar() == 'B' {
                token.value += this.CurrentChar();
                this.Advance(1);

                while this.IsBinDigit(this.CurrentChar()) {
                    token.value += this.CurrentChar();
                    this.Advance(1);
                }
            } else if this.CurrentChar() == 'o' || this.CurrentChar() == 'O' {
                token.value += this.CurrentChar();
                this.Advance(1);

                while this.IsOctDigit(this.CurrentChar()) {
                    token.value += this.CurrentChar();
                    this.Advance(1);
                }
            } else {
                while this.IsDigit(this.CurrentChar()) {
                    token.value += this.CurrentChar();
                    this.Advance(1);
                }
            }
        } else {
            while this.IsDigit(this.CurrentChar()) {
                token.value += this.CurrentChar();
                this.Advance(1);
            }
        }

        if this.CurrentChar() == '.' && this.IsDigit(this.PeekChar(1)) {
            token._type = TokenType::FLOAT;
            token.value += this.CurrentChar();
            this.Advance(1);

            while this.IsDigit(this.CurrentChar()) {
                token.value += this.CurrentChar();
                this.Advance(1);
            }
        }

        if this.CurrentChar() == 'e' || this.CurrentChar() == 'E' {
            token._type = TokenType::FLOAT;
            token.value += this.CurrentChar();
            this.Advance(1);

            if this.CurrentChar() == '+' || this.CurrentChar() == '-' {
                token.value += this.CurrentChar();
                this.Advance(1);
            }

            while this.IsDigit(this.CurrentChar()) {
                token.value += this.CurrentChar();
                this.Advance(1);
            }
        }

        if this.CurrentChar() == 'i' || this.CurrentChar() == 'u' {
            token.value += this.CurrentChar();
            this.Advance(1);

            while this.IsAlphaNum(this.CurrentChar()) {
                token.value += this.CurrentChar();
                this.Advance(1);
            }
        } else if this.CurrentChar() == 'f' {
            token._type = TokenType::FLOAT;
            token.value += this.CurrentChar();
            this.Advance(1);

            while this.IsDigit(this.CurrentChar()) {
                token.value += this.CurrentChar();
                this.Advance(1);
            }
        } return token;
    }

    fn LexIdentifier(&mut this) -> Token {
        let mut token: Token;
        (token.row, token.column, token.file) = (this.row, this.column, this.file);

        loop {
            let byte = this.CurrentChar() as u8;

            if byte > 0x7F {
                token.value += byte as i8;
                token.value += this.PeekChar(1);

                if (byte & 0xE0) == 0xC0 {
                    this.Advance(2);
                } else {
                    token.value += this.PeekChar(2);

                    if (byte & 0xF0) == 0xE0 {
                        this.Advance(3);
                    } else {
                        token.value += this.PeekChar(3);
                        this.Advance(4);
                    }
                }
            } else {
                if token.value.Size() > 1 ? this.IsAlphaNum(byte as i8) : this.IsAlpha(byte as i8) {
                    token.value += byte as i8;
                    this.Advance(1);
                } else {
                    break;
                }
            }
        }

        if this.preprocessor {
            token._type = StringToDirective(token.value);
        } else {
            token._type = StringToKeyword(token.value);

            if token._type == TokenType::ASSEMBLY {
                this.assembly = true;
            }
        }

        if token._type == TokenType::UNKNOWN {
            token._type = TokenType::IDENTIFIER;
        } return token;
    }

    fn LexSymbol(&mut this) -> Token {
        let mut token: Token;
        (token.row, token.column, token.file) = (this.row, this.column, this.file);
        let current = this.CurrentChar();
        let next = this.PeekChar(1);
        token.value += current;

        if current == '@' {
            token._type = TokenType::AT;
            this.Advance(1);
        } else if current == '#' && next == '[' {
            token.value += next;
            this.preprocessor = true;
            token._type = TokenType::PREPROCESSOR_START;
            this.Advance(2);
        } else if current == '+' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::PLUS_ASSIGN;
                this.Advance(2);
            } else {
                token._type = TokenType::PLUS;
                this.Advance(1);
            }
        } else if current == '-' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::MINUS_ASSIGN;
                this.Advance(2);
            } else if next == '>' {
                token.value += next;
                token._type = TokenType::ARROW;
                this.Advance(2);
            } else {
                token._type = TokenType::MINUS;
                this.Advance(1);
            }
        } else if current == '*' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::MUL_ASSIGN;
                this.Advance(2);
            } else {
                token._type = TokenType::MUL;
                this.Advance(1);
            }
        } else if current == '/' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::DIV_ASSIGN;
                this.Advance(2);
            } else {
                token._type = TokenType::DIV;
                this.Advance(1);
            }
        } else if current == '%' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::MOD_ASSIGN;
                this.Advance(2);
            } else {
                token._type = TokenType::MOD;
                this.Advance(1);
            }
        } else if current == '<' {
            if next == '<' && this.PeekChar(2) == '=' {
                token.value += next;
                token.value += this.PeekChar(2);
                token._type = TokenType::LSHIFT_ASSIGN;
                this.Advance(3);
            } else if next == '=' {
                token.value += next;
                token._type = TokenType::LESS_EQUAL;
                this.Advance(2);
            } else {
                token._type = TokenType::LESS;
                this.Advance(1);
            }
        } else if current == '>' {
            if next == '>' && this.PeekChar(2) == '=' {
                token.value += next;
                token.value += this.PeekChar(2);
                token._type = TokenType::RSHIFT_ASSIGN;
                this.Advance(3);
            } else if next == '=' {
                token.value += next;
                token._type = TokenType::GREATER_EQUAL;
                this.Advance(2);
            } else {
                token._type = TokenType::GREATER;
                this.Advance(1);
            }
        } else if current == '&' {
            if next == '&' {
                token.value += next;
                token._type = TokenType::AND;
                this.Advance(2);
            } else if next == '=' {
                token.value += next;
                token._type = TokenType::AND_ASSIGN;
                this.Advance(2);
            } else {
                token._type = TokenType::BITWISE_AND;
                this.Advance(1);
            }
        } else if current == '|' {
            if next == '|' {
                token.value += next;
                token._type = TokenType::OR;
                this.Advance(2);
            } else if next == '=' {
                token.value += next;
                token._type = TokenType::OR_ASSIGN;
                this.Advance(2);
            } else {
                token._type = TokenType::BITWISE_OR;
                this.Advance(1);
            }
        } else if current == '^' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::XOR_ASSIGN;
                this.Advance(2);
            } else {
                token._type = TokenType::BITWISE_XOR;
                this.Advance(1);
            }
        } else if current == '=' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::EQUAL;
                this.Advance(2);
            } else if next == '>' {
                token.value += next;
                token._type = TokenType::FAT_ARROW;
                this.Advance(2);
            } else {
                token._type = TokenType::ASSIGN;
                this.Advance(1);
            }
        } else if current == '!' {
            if next == '=' {
                token.value += next;
                token._type = TokenType::NOT_EQUAL;
                this.Advance(2);
            } else {
                token._type = TokenType::NOT;
                this.Advance(1);
            }
        } else if current == '?' {
            token._type = TokenType::QUESTION_MARK;
            this.Advance(1);
        } else if current == '~' {
            token._type = TokenType::TILDE;
            this.Advance(1);
        } else if current == '.' {
            if next == '.' {
                token.value += next;

                if this.PeekChar(2) == '.' {
                    token.value += this.PeekChar(2);
                    token._type = TokenType::THREE_DOT;
                    this.Advance(3);
                } else {
                    token._type = TokenType::TWO_DOT;
                    this.Advance(2);
                }
            } else {
                token._type = TokenType::DOT;
                this.Advance(1);
            }
        } else if current == ',' {
            token._type = TokenType::COMMA;
            this.Advance(1);
        } else if current == ':' {
            if next == ':' {
                token.value += next;
                token._type = TokenType::DOUBLE_COLON;
                this.Advance(2);
            } else {
                token._type = TokenType::COLON;
                this.Advance(1);
            }
        } else if current == ';' {
            if this.assembly {
                Logger::Log("Expected an assembly block before the semicolon.", token, LogSeverity::Error);
            }

            token._type = TokenType::SEMICOLON;
            this.Advance(1);
        } else if current == '(' {
            token._type = TokenType::LPAREN;
            this.Advance(1);
        } else if current == ')' {
            token._type = TokenType::RPAREN;
            this.Advance(1);
        } else if current == '[' {
            token._type = TokenType::LBRACKET;
            this.Advance(1);
        } else if current == ']' {
            if this.preprocessor {
                this.preprocessor = false;
                token._type = TokenType::PREPROCESSOR_END;
                this.Advance(1);
            } else {
                token._type = TokenType::RBRACKET;
                this.Advance(1);
            }
        } else if current == '{' {
            token._type = TokenType::LBRACE;
            this.Advance(1);
        } else if current == '}' {
            token._type = TokenType::RBRACE;
            this.Advance(1);
        } else if current == '\\' {
            token._type = TokenType::BACKSLASH;
            this.Advance(1);
        } else {
            Logger::Log("Invalid symbol '" + current.ToString() + "'.", token, LogSeverity::Error);
            this.Advance(1);
        } return token;
    }

    fn LexAssembly(&mut this) -> Token {
        let mut token: Token;
        (token._type, token.row, token.column, token.file) = (TokenType::ASSEMBLY_CODE, this.row, this.column, this.file);
        let (mut state, mut indent: usize) = (true, 1);
        let mut accumulator = String();
        this.Advance(1);

        while this.CurrentChar() != '\0' {
            let character = this.CurrentChar();

            if character == '{' {
                indent += 1;
            } else if character == '}' {
                indent -= 1;

                if indent == 0 {
                    break;
                }
            }

            if character != ' ' && character != '\t' && character != '\n' && character != '\r' {
                if !accumulator.Empty() {
                    token.value += accumulator;
                    accumulator.Clear();
                }

                state = false;
                token.value += character;
            } else if !state {
                state = character == '\n' || character == '\r';
                accumulator += character;
            } this.Advance(1);
        }

        if indent > 0 {
            Logger::Log("Unterminated assembly block.", token, LogSeverity::Error);
        }

        this.Advance(1);
        this.assembly = false;
        return token;
    }

    pub fn Lex(&mut this, text: &String, file: &String) -> Vector<Token> {
        (this.index, this.row, this.column) = (0, 1, 1);
        (this.file, this.text, this.length) = (file, text, text.Size());
        let mut tokens = Vector<Token>();

        while this.CurrentChar() != '\0' {
            this.SkipWhitespace();

            if this.CurrentChar() == '\0' {
                break;
            }

            if this.CurrentChar() == '\n' {
                this.Advance(1);
                continue;
            }

            if this.SkipComment() {
                continue;
            }

            let character = this.CurrentChar();

            if character == '"' || character == '\'' {
                tokens.PushBack(this.LexString());
            } else if this.IsDigit(character) || (character == '-' && this.IsDigit(this.PeekChar(1))) {
                tokens.PushBack(this.LexNumber());
            } else if this.IsAlpha(character) || (character as u8) > 0x7F {
                tokens.PushBack(this.LexIdentifier());
            } else {
                if this.assembly && character == '{' {
                    tokens.PushBack(this.LexAssembly());
                } else {
                    tokens.PushBack(this.LexSymbol());
                }
            }
        }

        let mut eof: Token;
        (eof._type, eof.row, eof.column, eof.file) = (TokenType::EOF, this.row, this.column, this.file);
        tokens.PushBack(eof);
        return tokens;
    }
}
