    func find_coreGL() {
        let prefixes[]: *const i8 = {
            "OpenGL ES-CM ", "OpenGL ES-CL ", "OpenGL ES ", null
        };

        let mut version: *const i8 = glGetString(GL_VERSION) as *const i8;

        if version == null {
            ret;
        }

        let mut i: i32 = 0i32;

        while prefixes[i] != null {
            let length: size_t = strlen(prefixes[i]);

            if strncmp(version, prefixes[i], length) == 0i32 {
                version = ((version as u64) + length) as *const i8;
                break;
            } else {
                i += 1i32;
            }
        }

        let parts: Vector<String> = version.ToString().Split('.');
        let (mut major: i32, mut minor: i32) = (parts[0u64].ToInteger() as i32, parts[1u64].ToInteger() as i32);
        (max_loaded_major, max_loaded_minor) = (major, minor);
        (GLVersion.major, GLVersion.minor) = (major, minor);

        GLAD_GL_VERSION_1_0 = ((major == 1i32 && minor >= 0i32) || major > 1i32) as i32;
        GLAD_GL_VERSION_1_1 = ((major == 1i32 && minor >= 1i32) || major > 1i32) as i32;
        GLAD_GL_VERSION_1_2 = ((major == 1i32 && minor >= 2i32) || major > 1i32) as i32;
        GLAD_GL_VERSION_1_3 = ((major == 1i32 && minor >= 3i32) || major > 1i32) as i32;
        GLAD_GL_VERSION_1_4 = ((major == 1i32 && minor >= 4i32) || major > 1i32) as i32;
        GLAD_GL_VERSION_1_5 = ((major == 1i32 && minor >= 5i32) || major > 1i32) as i32;
        GLAD_GL_VERSION_2_0 = ((major == 2i32 && minor >= 0i32) || major > 2i32) as i32;
        GLAD_GL_VERSION_2_1 = ((major == 2i32 && minor >= 1i32) || major > 2i32) as i32;
        GLAD_GL_VERSION_3_0 = ((major == 3i32 && minor >= 0i32) || major > 3i32) as i32;
        GLAD_GL_VERSION_3_1 = ((major == 3i32 && minor >= 1i32) || major > 3i32) as i32;
        GLAD_GL_VERSION_3_2 = ((major == 3i32 && minor >= 2i32) || major > 3i32) as i32;
        GLAD_GL_VERSION_3_3 = ((major == 3i32 && minor >= 3i32) || major > 3i32) as i32;
        GLAD_GL_VERSION_4_0 = ((major == 4i32 && minor >= 0i32) || major > 4i32) as i32;
        GLAD_GL_VERSION_4_1 = ((major == 4i32 && minor >= 1i32) || major > 4i32) as i32;
        GLAD_GL_VERSION_4_2 = ((major == 4i32 && minor >= 2i32) || major > 4i32) as i32;
        GLAD_GL_VERSION_4_3 = ((major == 4i32 && minor >= 3i32) || major > 4i32) as i32;
        GLAD_GL_VERSION_4_4 = ((major == 4i32 && minor >= 4i32) || major > 4i32) as i32;
        GLAD_GL_VERSION_4_5 = ((major == 4i32 && minor >= 5i32) || major > 4i32) as i32;
        GLAD_GL_VERSION_4_6 = ((major == 4i32 && minor >= 6i32) || major > 4i32) as i32;

        if GLVersion.major > 4i32 || (GLVersion.major >= 4i32 && GLVersion.minor >= 6i32) {
            (max_loaded_major, max_loaded_minor) = (4i32, 6i32);
        }
    }

    func gladLoadGLLoader(load: GLADloadproc) -> i32 {
        (GLVersion.major, GLVersion.minor) = (0i32, 0i32);
        glGetString = load("glGetString") as PFNGLGETSTRINGPROC;

        if glGetString == null {
            ret 0i32;
        }

        if glGetString(GL_VERSION) == null {
            ret 0i32;
        }

        find_coreGL();
        load_GL_VERSION_1_0(load);
        load_GL_VERSION_1_1(load);
        load_GL_VERSION_1_2(load);
        load_GL_VERSION_1_3(load);
        load_GL_VERSION_1_4(load);
        load_GL_VERSION_1_5(load);
        load_GL_VERSION_2_0(load);
        load_GL_VERSION_2_1(load);
        load_GL_VERSION_3_0(load);
        load_GL_VERSION_3_1(load);
        load_GL_VERSION_3_2(load);
        load_GL_VERSION_3_3(load);
        load_GL_VERSION_4_0(load);
        load_GL_VERSION_4_1(load);
        load_GL_VERSION_4_2(load);
        load_GL_VERSION_4_3(load);
        load_GL_VERSION_4_4(load);
        load_GL_VERSION_4_5(load);
        load_GL_VERSION_4_6(load);

        ret (GLVersion.major != 0i32 || GLVersion.minor != 0i32) as i32;
    }
}

