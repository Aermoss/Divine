#[include "std/str", "std/vec", "std/map", "std/pair",
    "src/Mangler.zir", "src/Scope.zir", "src/Symbol.zir", "src/Value.zir", "src/Types.zir" : *]

class Generic {
    priv cache: Map<String, Pair<QualifiedValue, *mut Scope>>,
    pub node: *const Node, pub scope: *mut Scope,
    pub _class: *const QualifiedType = null,

    pub name: String, pub type_names: Vector<String>,
    pub symbols: Vector<*const Symbol>, pub last_scope: *mut Scope = null,
    pub current: String, pub types: Vector<*const QualifiedType>;

    Generic(&mut this, node: *const Node) {
        (this.node, this.scope, this._class) = (node, compiler->scope_manager.current, compiler->_class);
        compiler->generics.PushBack(this);

        if node->_type == NodeType::CLASS {
            let _class = node as *const ClassNode;
            (this.name, this.type_names) = (_class->name, _class->types);
        } else if node->_type == NodeType::ENUM {
            let _enum = node as *const EnumNode;
            (this.name, this.type_names) = (_enum->name, _enum->types);
        } else {
            let function = node as *const FunctionNode;
            (this.name, this.type_names) = (function->name, function->types);
        }
    }

    pub Set(&mut this, value: QualifiedValue) {
        if this.current.Empty() {
            Logger::Log("Generic", "Not in a generic compilation!", LogSeverity::Fatal);
        }

        this.last_scope = value.Null() ? compiler->scope_manager.current : null;
        this.cache[this.current] = Pair<QualifiedValue, *mut Scope>(value, this.last_scope);
        this.current = "";
    }

    pub Get(&mut this, types: Vector<*const QualifiedType>) -> Pair<QualifiedValue, *mut Scope> {
        if !this.current.Empty() {
            Logger::Log("Generic", "Nested generics are not supported!", LogSeverity::Fatal);
        }

        if types.Size() != this.type_names.Size() {
            Logger::Log("Generic", "Generic type parameter count mismatch.", LogSeverity::Error);
            ret Pair<QualifiedValue, *mut Scope>(QualifiedValue(null, null), null);
        }

        let (prev_mangling, prev_unsafe) = (compiler->mangling, compiler->_unsafe);
        let (prev_scope, prev_generic) = (compiler->scope_manager.current, compiler->generic);
        let (prev_class, prev_function) = (compiler->_class, compiler->function);
        let prev_function_ref = compiler->function_ref;

        (compiler->scope_manager.current, compiler->generic) = (this.scope, this);
        (compiler->_class, compiler->function, compiler->function_ref) = (this._class, null, null);
        (compiler->mangling, compiler->_unsafe) = (true, false);
        let name = Mangler::MangleClass(this.name, types);

        if this.cache.Has(name) {
            compiler->function_ref = prev_function_ref;
            (compiler->_class, compiler->function) = (prev_class, prev_function);
            (compiler->scope_manager.current, compiler->generic) = (prev_scope, prev_generic);
            (compiler->mangling, compiler->_unsafe) = (prev_mangling, prev_unsafe);
            ret this.cache[name];
        } else {
            this.current = name;
            this.types = types;
        }

        compiler->scope_manager.PushScope(String("generic"), false);

        for i in 0u64..this.type_names.Size() {
            compiler->scope_manager.Set(this.type_names[i], SymbolKind::Type, QualifiedValue(null, this.types[i]), false, this.node);
        }

        let mut result: QualifiedValue;

        if this.node->_type == NodeType::CLASS {
            result = QualifiedValue(null, compiler->CompileClass(this.node as *const ClassNode, this));
        } else if this.node->_type == NodeType::ENUM {
            result = QualifiedValue(null, compiler->CompileVariant(this.node as *const EnumNode, this));
        } else {
            result = compiler->CompileFunction(this.node as *const FunctionNode, this);
        }

        this.types.Clear();
        compiler->scope_manager.PopScope();
        compiler->function_ref = prev_function_ref;
        (compiler->_class, compiler->function) = (prev_class, prev_function);
        (compiler->scope_manager.current, compiler->generic) = (prev_scope, prev_generic);
        (compiler->mangling, compiler->_unsafe) = (prev_mangling, prev_unsafe);
        ret Pair<QualifiedValue, *mut Scope>(result, null);
    }
}

#[include "src/Compiler.zir" : *]
