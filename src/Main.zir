#[include "std/io", "std/file", "std/std", "vendor/llvm-c/Core.zir", "vendor/llvm-c/IRReader.zir", "vendor/llvm-c/BitReader.zir", "vendor/llvm-c/BitWriter.zir", "vendor/llvm-c/Transforms/PassBuilder.zir",
    "src/Target.zir", "src/Lexer.zir", "src/Preprocessor.zir", "src/Parser.zir", "src/SemanticAnalyzer.zir", "src/CodeGenerator.zir", "src/Assembler.zir", "src/Logger.zir" : *]

#[if WINDOWS]
const INFINITE: u32 = 0xFFFFFFFF;

class STARTUPINFOA {
    pub cb: u32,
    pub lpReserved: *mut i8,
    pub lpDesktop: *mut i8,
    pub lpTitle: *mut i8,
    pub dwX: u32,
    pub dwY: u32,
    pub dwXSize: u32,
    pub dwYSize: u32,
    pub dwXCountChars: u32,
    pub dwYCountChars: u32,
    pub dwFillAttribute: u32,
    pub dwFlags: u32,
    pub wShowWindow: u16,
    pub cbReserved2: u16,
    pub lpReserved2: *mut u8,
    pub hStdInput: *mut void,
    pub hStdOutput: *mut void,
    pub hStdError: *mut void
}

type LPSTARTUPINFOA = *mut STARTUPINFOA;

class PROCESS_INFORMATION {
    pub hProcess: *mut void,
    pub hThread: *mut void,
    pub dwProcessId: u32,
    pub dwThreadId: u32
}

type LPPROCESS_INFORMATION = *mut PROCESS_INFORMATION;

extern "C" {
    fn QueryPerformanceCounter(lpPerformanceCount: *mut i64) -> i32;
    fn QueryPerformanceFrequency(lpFrequency: *mut i64) -> i32;

    fn CreateProcessA(lpApplicationName: *i8, lpCommandLine: */* mut */ i8, lpProcessAttributes: *mut void, lpThreadAttributes: *mut void, bInheritHandles: i32, dwCreationFlags: u32, lpEnvironment: *mut void, lpCurrentDirectory: *i8, lpStartupInfo: LPSTARTUPINFOA, lpProcessInformation: LPPROCESS_INFORMATION) -> i32;
    fn WaitForSingleObject(hHandle: *mut void, dwMilliseconds: u32) -> u32;
    fn GetExitCodeProcess(hProcess: *mut void, lpExitCode: *mut u32) -> i32;
    fn GetLastError() -> u32;
}

class Timer {
    frequency: i64,
    counter: i64;

    Timer(&mut this) {
        QueryPerformanceFrequency(&mut this.frequency);
    }

    pub fn Get(&mut this) -> f64 {
        QueryPerformanceCounter(&mut this.counter);
        return (this.counter as f64) / (this.frequency as f64);
    }
}

fn Execute(command: *i8) -> u32 {
    let mut startup_info: STARTUPINFOA;
    memset(&mut startup_info, 0, sizeof(startup_info));
    startup_info.cb = sizeof(startup_info) as u32;
    let mut process_info: PROCESS_INFORMATION;

    if CreateProcessA(null, command, null, null, 0, 0, null, null, &mut startup_info, &mut process_info) == 0 {
        WriteLine("\x1b[31mFailed to create process: " + String::FromInteger(GetLastError() as u64) + ".\x1b[0m");
        Exit(1);
    }

    let mut exit_code: u32 = 0;
    WaitForSingleObject(process_info.hProcess, INFINITE);

    if GetExitCodeProcess(process_info.hProcess, &mut exit_code) == 0 {
        WriteLine("\x1b[31mFailed to get process exit code: " + String::FromInteger(GetLastError() as u64) + ".\x1b[0m");
    }

    CloseHandle(process_info.hProcess);
    CloseHandle(process_info.hThread);
    return exit_code;
}
#[else]
class _TimeSpec {
    pub sec: i64,
    pub nsec: i64
}

class _SHArgs {
    pub sh: *i8,
    pub flag: *i8,
    pub cmd: *i8,
    pub end: *i8
}

class _NullEnv {
    pub end: *i8
}

extern "C" {
    fn clock_gettime(clk_id: i32, tp: *mut _TimeSpec) -> i32 #[if DARWIN] ; #[else] {
        let mut result: i64 = 0;

        volatile asm : rax(228), rdi(clk_id as i64), rsi(tp) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        return result as i32;
    } #[endif]

    fn fork() -> i32 #[if DARWIN] ; #[else] {
        let mut result: i64 = 0;

        volatile asm : rax(57) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        return result as i32;
    } #[endif]

    fn execve(path: *i8, argv: **i8, envp: **i8) -> i32 #[if DARWIN] ; #[else] {
        let mut result: i64 = 0;

        volatile asm : rax(59), rdi(path), rsi(argv), rdx(envp) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        return result as i32;
    } #[endif]

    fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32 #[if DARWIN] ; #[else] {
        let mut result: i64 = 0;

        volatile asm : rax(61), rdi(pid as i64), rsi(status), rdx(options as i64) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        return result as i32;
    } #[endif]
}

class Timer {
    dummy: i64;

    pub fn Get(&this) -> f64 {
        let mut ts: _TimeSpec;
        (ts.sec, ts.nsec) = (0, 0);
        clock_gettime(0, &ts);
        return (ts.sec as f64) + (ts.nsec as f64) / 1000000000.0;
    }
}

fn Execute(command: *i8) -> u32 {
    let mut shargs: _SHArgs;
    shargs.sh = "/bin/sh";
    shargs.flag = "-c";
    shargs.cmd = command;
    shargs.end = null;
    let mut nullenv: _NullEnv;
    nullenv.end = null;
    let pid = fork();

    if pid == 0 {
        execve(shargs.sh, &shargs as **i8, &nullenv as **i8);
        Exit(1);
    }

    let mut status: i32 = 0;
    waitpid(pid, &status, 0);
    return ((status >> 8) & 0xFF) as u32;
}
#[endif]

#[if WINDOWS]
fn GetWindowsSDKPath() -> String {
    let mut path = "C:\\Program Files (x86)\\Windows Kits\\10\\Lib".ToString();

    let mut find_data: WIN32_FIND_DATAA;
    let find_handle = FindFirstFileA((path + "\\*").Data(), &mut find_data);

    if find_handle == INVALID_HANDLE_VALUE {
        WriteLine("\x1b[31mFailed to find Windows SDK path.\x1b[0m");
        Exit(1);
    }

    let mut highest_version_string = String();
    let (mut highest_v1: i64, mut highest_v2: i64, mut highest_v3: i64, mut highest_v4: i64) = (0, 0, 0, 0);

    loop {
        if (find_data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0 {
            let file_name = String(find_data.cFileName);

            if file_name != "." && file_name != ".." && file_name != "wdf" {
                let parts = file_name.Split('.');
                let (mut parsed_v1: i64, mut parsed_v2: i64, mut parsed_v3: i64, mut parsed_v4: i64) = (0, 0, 0, 0);

                if parts.Size() == 4 {
                    (parsed_v1, parsed_v2, parsed_v3, parsed_v4) = (parts[0].ToInteger(), parts[1].ToInteger(), parts[2].ToInteger(), parts[3].ToInteger());
                } else {
                    WriteLine("\x1b[31mFailed to parse Windows SDK version.\x1b[0m");
                    Exit(1);
                }

                if parsed_v1 > highest_v1 || (parsed_v1 == highest_v1 && parsed_v2 > highest_v2) || (parsed_v1 == highest_v1 && parsed_v2 == highest_v2 && parsed_v3 > highest_v3) || (parsed_v1 == highest_v1 && parsed_v2 == highest_v2 && parsed_v3 == highest_v3 && parsed_v4 > highest_v4) {
                    (highest_version_string, highest_v1, highest_v2, highest_v3, highest_v4) = (file_name, parsed_v1, parsed_v2, parsed_v3, parsed_v4);
                }
            }
        }

        if FindNextFileA(find_handle, &mut find_data) == 0 {
            break;
        }
    }

    if highest_version_string != "" {
        path += "\\";
        path += highest_version_string;
    } else {
        WriteLine("\x1b[31mFailed to find a valid Windows SDK version.\x1b[0m");
        Exit(1);
    }

    FindClose(find_handle);
    return path;
}

fn GetMSVCPath() -> String {
    let mut path = "C:\\Program Files\\Microsoft Visual Studio".ToString();

    let mut find_data: WIN32_FIND_DATAA;
    let find_handle = FindFirstFileA((path + "\\*").Data(), &mut find_data);

    if find_handle == INVALID_HANDLE_VALUE {
        WriteLine("\x1b[31mFailed to find Visual Studio path.\x1b[0m");
        Exit(1);
    }

    let mut highest_version_string = String();
    let mut highest_version: i64 = 0;

    loop {
        if (find_data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0 {
            let file_name = String(find_data.cFileName);

            if file_name != "." && file_name != ".." {
                let mut parsed_version = file_name.ToInteger();

                if parsed_version == 2017 { parsed_version = 15; }
                else if parsed_version == 2019 { parsed_version = 16; }
                else if parsed_version == 2022 { parsed_version = 17; }

                if parsed_version > highest_version {
                    (highest_version_string, highest_version) = (file_name, parsed_version);
                }
            }
        }

        if FindNextFileA(find_handle, &mut find_data) == 0 {
            break;
        }
    }

    if highest_version_string != "" {
        path += "\\";
        path += highest_version_string;
    } else {
        WriteLine("\x1b[31mFailed to find a valid Visual Studio version.\x1b[0m");
        Exit(1);
    }

    FindClose(find_handle);
    let mut find_data2: WIN32_FIND_DATAA;
    let find_handle2 = FindFirstFileA((path + "\\*").Data(), &mut find_data2);

    if find_handle2 == INVALID_HANDLE_VALUE {
        WriteLine("\x1b[31mFailed to find Visual Studio path.\x1b[0m");
        Exit(1);
    }

    loop {
        if (find_data2.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0 {
            let file_name = String(find_data2.cFileName);

            if file_name != "." && file_name != ".." {
                path += "\\";
                path += file_name;
                path += "\\VC\\Tools\\MSVC";
                break;
            }
        }

        if FindNextFileA(find_handle2, &mut find_data2) == 0 {
            break;
        }
    }

    FindClose(find_handle2);
    let mut find_data3: WIN32_FIND_DATAA;
    let find_handle3 = FindFirstFileA((path + "\\*").Data(), &mut find_data3);

    if find_handle3 == INVALID_HANDLE_VALUE {
        WriteLine("\x1b[31mFailed to find MSVC path.\x1b[0m");
        Exit(1);
    }

    let mut highest_version_string2 = String();
    let (mut highest_v1: i64, mut highest_v2: i64, mut highest_v3: i64, mut highest_v4: i64) = (0, 0, 0, 0);

    loop {
        if (find_data3.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0 {
            let file_name = String(find_data3.cFileName);

            if file_name != "." && file_name != ".." {
                let parts = file_name.Split('.');
                let (mut parsed_v1: i64, mut parsed_v2: i64, mut parsed_v3: i64) = (0, 0, 0);

                if parts.Size() == 3 {
                    (parsed_v1, parsed_v2, parsed_v3) = (parts[0].ToInteger(), parts[1].ToInteger(), parts[2].ToInteger());
                } else {
                    WriteLine("\x1b[31mFailed to parse MSVC version.\x1b[0m");
                    Exit(1);
                }

                if parsed_v1 > highest_v1 || (parsed_v1 == highest_v1 && parsed_v2 > highest_v2) || (parsed_v1 == highest_v1 && parsed_v2 == highest_v2 && parsed_v3 > highest_v3) {
                    (highest_version_string2, highest_v1, highest_v2, highest_v3) = (file_name, parsed_v1, parsed_v2, parsed_v3);
                }
            }
        }

        if FindNextFileA(find_handle3, &mut find_data3) == 0 {
            break;
        }
    }

    if highest_version_string2 != "" {
        path += "\\";
        path += highest_version_string2;
    } else {
        WriteLine("\x1b[31mFailed to find a valid MSVC version.\x1b[0m");
        Exit(1);
    }

    FindClose(find_handle3);
    return path;
}
#[endif]

fn PrintVersion(executable: &String) {
    WriteLine("Unversioned build of " + executable + " (" + LLVMGetDefaultTargetTriple() + ").");
    WriteLine("Copyright (c) 2025-2026 Yusuf Rençber.");
    WriteLine("Licensed under the Apache License, Version 2.0.");
    WriteLine("See the LICENSE file for details.");
}

fn PrintUsage(executable: &String) {
    WriteLine("OVERVIEW: Zircon compiler");
    WriteLine("USAGE: " + executable + " [options] <inputs>");
    WriteLine("OPTIONS:");
    WriteLine("  -o <file>                Write output to <file>");
    WriteLine("  -I <dir>                 Add directory to include search path");
    WriteLine("  -L <dir>                 Add directory to library search path");
    WriteLine("  -l <name>                Link against library <name>");
    WriteLine("  -D <macro>               Define a macro");
    WriteLine("  -O<level>, -O            Optimization level (0, 1, 2, 3) [-O defaults to -O2]");
    WriteLine("  -g                       Enable debug information");
    WriteLine("  -c                       Only run preprocess, compile, and assemble steps");
    WriteLine("  -S                       Only run preprocess and compilation steps");
    WriteLine("  -emit-llvm               Emit LLVM intermediate representation");
    WriteLine("  -emit-bc                 Emit LLVM bitcode");
    WriteLine("  -check, -fsyntax-only    Check code for errors, but do not emit code");
    WriteLine("  -target <triple>         Generate code for the given target");
    WriteLine("  -march <arch>            Architecture to generate code for");
    WriteLine("  -mcmodel <model>         Code model (tiny, small, medium, large, kernel)");
    WriteLine("  -ffreestanding           Assert that the compilation takes place in a freestanding environment");
    WriteLine("  -mno-red-zone            Do not use the red-zone for x86-64 code");
    WriteLine("  -mgeneral-regs-only      Generate code which only uses the general-purpose registers");
    WriteLine("  -r, --run                Run the program after compiling");
    WriteLine("  -v, --verbose            Show commands to run and use verbose output");
    WriteLine("  --version                Display compiler version");
    WriteLine("  -h, --help               Display this help message");
}

fn FatalErrorHandler(reason: *i8) {
    Logger::Log("LLVM", reason, LogSeverity::Fatal);
}

fn Main(args: &mut Vector<String>) -> i32 {
    let executable = SplitPath(args[0]).right;
    let mut logger = Logger(executable);

    if args.Size() < 2 {
        PrintUsage(executable);
        return 1;
    }

    LLVMEnablePrettyStackTrace();
    LLVMInstallFatalErrorHandler(FatalErrorHandler);

    LLVMInitializeAllTargetInfos();
    LLVMInitializeAllTargets();
    LLVMInitializeAllTargetMCs();
    LLVMInitializeAllAsmPrinters();
    LLVMInitializeAllAsmParsers();
    LLVMInitializeAllDisassemblers();

    let (mut input_files, mut output_file) = (Vector<String>(), String());
    let (mut include_paths, mut lib_paths) = (Vector<String>(), Vector<String>());
    let (mut defines, mut libs) = (Vector<String>(), Vector<String>());

    include_paths.PushBack(String("."));
    include_paths.PushBack(String("include"));

    let mut features = String();
    let mut triple = LLVMGetDefaultTargetTriple().ToString();
    let (mut arch, mut code_model) = ("generic".ToString(), "default".ToString());
    let mut opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelNone;
    let (mut emit_object, mut emit_asm, mut emit_llvm, mut emit_bc) = (false, false, false, false);
    let (mut run, mut debug, mut verbose, mut check) = (false, false, false, false);
    let (mut freestanding, mut no_red_zone) = (false, false);
    let mut i: usize = 1;

    while i < args.Size() {
        let arg = args[i];

        if arg == "--help" || arg == "-h" {
            PrintUsage(executable);
            return 0;
        } else if arg == "--version" {
            PrintVersion(executable);
            return 0;
        } else if arg == "-v" || arg == "--verbose" {
            verbose = true;
        } else if arg == "-check" || arg == "-fsyntax-only" {
            check = true;
        } else if arg == "-g" || arg == "--debug" {
            debug = true;
        } else if arg == "-c" {
            emit_object = true;
        } else if arg == "-S" {
            emit_asm = true;
        } else if arg == "-emit-llvm" {
            emit_llvm = true;
        } else if arg == "-emit-bc" {
            emit_bc = true;
        } else if arg == "-ffreestanding" {
            freestanding = true;
        } else if arg == "-mno-red-zone" {
            no_red_zone = true;
        } else if arg == "-mgeneral-regs-only" {
            if !features.Empty() { features += ","; }
            features += "+nofp,+nosimd";

            if triple.Contains("aarch64") || triple.Contains("arm64") {
                features += ",+fixed-x18";
            }
        } else if arg == "-r" || arg == "--run" {
            run = true;
        } else if arg == "-O0" {
            opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelNone;
        } else if arg == "-O1" {
            opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelLess;
        } else if arg == "-O2" || arg == "-O" {
            opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelDefault;
        } else if arg == "-O3" {
            opt_level = LLVMCodeGenOptLevel::LLVMCodeGenLevelAggressive;
        } else if arg == "-o" {
            i += 1;

            if i < args.Size() {
                output_file = args[i];
            } else {
                Logger::Log("Missing argument to '-o'.", LogSeverity::Error);
                return 1;
            }
        } else if arg.StartsWith("-I") {
            let mut path = arg.SubString(2);

            if path.Empty() {
                i += 1;

                if i < args.Size() {
                    path = args[i];
                } else {
                    Logger::Log("Missing argument to '-I'.", LogSeverity::Error);
                    return 1;
                }
            }

            include_paths.PushBack(path);
        } else if arg.StartsWith("-L") {
            let mut path = arg.SubString(2);

            if path.Empty() {
                i += 1;

                if i < args.Size() {
                    path = args[i];
                } else {
                    Logger::Log("Missing argument to '-L'.", LogSeverity::Error);
                    return 1;
                }
            }

            lib_paths.PushBack(path);
        } else if arg.StartsWith("-l") {
            let mut name = arg.SubString(2);

            if name.Empty() {
                i += 1;

                if i < args.Size() {
                    name = args[i];
                } else {
                    Logger::Log("Missing argument to '-l'.", LogSeverity::Error);
                    return 1;
                }
            }

            libs.PushBack(name);
        } else if arg.StartsWith("-D") {
            let mut define = arg.SubString(2);

            if define.Empty() {
                i += 1;

                if i < args.Size() {
                    define = args[i];
                } else {
                    Logger::Log("Missing argument to '-D'.", LogSeverity::Error);
                    return 1;
                }
            }

            defines.PushBack(define);
        } else if arg == "-target" {
            i += 1;

            if i < args.Size() {
                triple = args[i];
            } else {
                Logger::Log("Missing argument to '-target'.", LogSeverity::Error);
                return 1;
            }
        } else if arg == "-march" {
            i += 1;

            if i < args.Size() {
                arch = args[i];
            } else {
                Logger::Log("Missing argument to '-march'.", LogSeverity::Error);
                return 1;
            }
        } else if arg == "-mcmodel" {
            i += 1;

            if i < args.Size() {
                code_model = args[i];
            } else {
                Logger::Log("Missing argument to '-mcmodel'.", LogSeverity::Error);
                return 1;
            }
        } else if arg.StartsWith('-') {
            Logger::Log("Unknown option '" + arg + "'.", LogSeverity::Error);
            return 1;
        } else {
            if FileExists(arg) {
                input_files.PushBack(arg);
            } else {
                Logger::Log("Cannot find '" + arg + "'.", LogSeverity::Error);
                return 1;
            }
        } i += 1;
    }

    if input_files.Empty() {
        Logger::Log("No input files.", LogSeverity::Error);
        return 1;
    }

    if !output_file.Empty() && input_files.Size() > 1 && (emit_object || emit_asm) {
        Logger::Log("Cannot specify '-o' when generating multiple output files.", LogSeverity::Error);
        return 1;
    }

    if triple.Contains("windows") {
        defines.PushBack(String("WINDOWS"));
    } else if triple.Contains("darwin") || triple.Contains("apple") {
        defines.PushBack(String("DARWIN"));
    } else if triple.Contains("linux") {
        defines.PushBack(String("LINUX"));
    }

    if triple.Contains("x86_64") {
        defines.PushBack(String("AMD64"));
    } else if triple.Contains("aarch64") || triple.Contains("arm64") {
        defines.PushBack(String("ARM64"));
    }

    let mut timer = Timer();
    let start = timer.Get();
    let mut objects = Vector<String>();
    let mut temp_files = Vector<String>();
    let temp_path = GetTemporaryPath();
    if temp_path.Empty() { return 1; }
    let mut entry_included = false;
    let mut failed = false;

    for input_file in input_files {
        let parts = SplitExtension(input_file);
        let (name, extension) = (parts.left, parts.right);

        let mut module: LLVMModuleRef = null;
        let target = Target(triple, arch, code_model, features, opt_level);
        let mut assembler = Assembler(target);

        if extension == ".zir" {
            if verbose {
                Logger::Log("Compiling: '" + input_file + "'.", LogSeverity::Info);
            }

            let mut lexer = Lexer();
            let mut preprocessor = Preprocessor();
            preprocessor.include_paths = include_paths;
            preprocessor.defines = defines;

            let mut source = _ReadFile(input_file);

            if !entry_included && !check && !freestanding {
                source += "\n#[include \"std/rt\" : *]\n";
                entry_included = true;
            }

            let tokens = preprocessor.Process(lexer.Lex(source, input_file), input_file);

            let mut parser = Parser();
            let root = parser.Parse(tokens);

            let semantic_analyzer = SemanticAnalyzer();
            let hir_module = semantic_analyzer.Analyze(root);

            let code_generator = CodeGenerator(target, freestanding, no_red_zone);
            module = code_generator.Generate(hir_module);
        } else if extension == ".ll" || extension == ".bc" {
            if verbose {
                Logger::Log("Compiling: '" + input_file + "'.", LogSeverity::Info);
            }

            let mut buffer: LLVMMemoryBufferRef = null;
            let mut message: *mut i8 = null;

            if LLVMCreateMemoryBufferWithContentsOfFile(input_file.Data(), &mut buffer, &mut message) != 0 {
                let final_message: *i8 = message != null ? message : "Unknown reason.";
                Logger::Log(input_file, "Failed to read file: " + final_message.ToString(), LogSeverity::Error);
            }

            if message != null {
                LLVMDisposeMessage(message);
                message = null;
            }

            if buffer != null {
                if extension == ".ll" {
                    if LLVMParseIRInContext(LLVMGetGlobalContext(), buffer, &mut module, &mut message) != 0 {
                        let final_message: *i8 = message != null ? message : "Unknown reason.";
                        Logger::Log(input_file, "Failed to parse LLVM IR: " + final_message.ToString(), LogSeverity::Error);
                    }
                } else {
                    if LLVMParseBitcodeInContext(LLVMGetGlobalContext(), buffer, &mut module, &mut message) != 0 {
                        let final_message: *i8 = message != null ? message : "Unknown reason.";
                        Logger::Log(input_file, "Failed to parse bitcode: " + final_message.ToString(), LogSeverity::Error);
                    }
                }

                if message != null {
                    LLVMDisposeMessage(message);
                    message = null;
                }
            }

            if module != null {
                LLVMSetSourceFileName(module, input_file.Data(), input_file.Length());
                LLVMSetModuleDataLayout(module, target.layout);
                LLVMSetTarget(module, target.triple.Data());

                if LLVMVerifyModule(module, LLVMVerifierFailureAction::LLVMReturnStatusAction, &mut message) != 0 {
                    let final_message: *i8 = message != null ? message : "Unknown reason.";
                    Logger::Log(input_file, "Module verification failed: " + final_message.ToString(), LogSeverity::Error);
                    LLVMDisposeModule(module);
                    module = null;
                }

                if message != null {
                    LLVMDisposeMessage(message);
                }
            }
        } else if extension == ".asm" || extension == ".s" {
            if emit_asm {
                Logger::Log("Skipping input: '" + input_file + "'.", LogSeverity::Warning);
                continue;
            }

            if verbose {
                Logger::Log("Assembling: '" + input_file + "'.", LogSeverity::Info);
            } module = assembler.Assemble(_ReadFile(input_file));
        } else if extension == ".obj" || extension == ".o" {
            if emit_object {
                Logger::Log("Skipping input: '" + input_file + "'.", LogSeverity::Warning);
            } else {
                objects.PushBack(input_file);
            } continue;
        } else {
            Logger::Log(input_file, "Unsupported file extension '" + extension + "'.", LogSeverity::Error);
        }

        failed |= module == null;

        if check || failed {
            if !check {
                Logger::Clear();
            } continue;
        }

        if opt_level != LLVMCodeGenOptLevel::LLVMCodeGenLevelNone && extension == ".zir" {
            let mut passes = String();

            if opt_level == LLVMCodeGenOptLevel::LLVMCodeGenLevelLess {
                passes = "default<O1>";
            } else if opt_level == LLVMCodeGenOptLevel::LLVMCodeGenLevelDefault {
                passes = "default<O2>";
            } else if opt_level == LLVMCodeGenOptLevel::LLVMCodeGenLevelAggressive {
                passes = "default<O3>";
            }

            if passes.Size() > 1 {
                let pass_options = LLVMCreatePassBuilderOptions();
                let error = LLVMRunPasses(module, passes.Data(), target.target_machine, pass_options);
                LLVMDisposePassBuilderOptions(pass_options);

                if error != LLVMErrorSuccess as LLVMErrorRef {
                    let message = LLVMGetErrorMessage(error);
                    Logger::Log(input_file, "Failed to optimize module: " + message.ToString(), LogSeverity::Error);
                    LLVMDisposeErrorMessage(message);
                    return 1;
                }
            }
        }

        if emit_llvm && extension != ".ll" {
            let mut message: *mut i8 = null;

            if LLVMPrintModuleToFile(module, (name + ".ll").Data(), &mut message) != 0 {
                let final_message: *i8 = message != null ? message : "Unknown reason.";
                Logger::Log(input_file, "Failed to emit LLVM IR: " + final_message.ToString(), LogSeverity::Error);
            }

            if message != null {
                LLVMDisposeMessage(message);
            }
        }

        if emit_bc && extension != ".bc" {
            if LLVMWriteBitcodeToFile(module, (name + ".bc").Data()) != 0 {
                Logger::Log(input_file, "Failed to emit LLVM bitcode.", LogSeverity::Error);
            }
        }

        if emit_asm {
            let mut asm_name = name + ".s";
            if !output_file.Empty() { asm_name = output_file; }
            let result = target.Emit(module, asm_name, LLVMCodeGenFileType::LLVMAssemblyFile);

            if !result.Empty() {
                Logger::Log(input_file, "Failed to emit assembly: " + result, LogSeverity::Error);
                return 1;
            } continue;
        }

        let mut object_name = name + (triple.Contains("windows") ? ".obj" : ".o");

        if !emit_object {
            object_name = JoinPath(temp_path, SplitPath(object_name).right);
        } else if !output_file.Empty() {
            object_name = output_file;
        }

        let result = target.Emit(module, object_name, LLVMCodeGenFileType::LLVMObjectFile);

        if !result.Empty() {
            Logger::Log(input_file, "Failed to emit object: " + result, LogSeverity::Error);
            return 1;
        }

        objects.PushBack(object_name);

        if !emit_object {
            temp_files.PushBack(object_name);
        }
    }

    if check || failed || emit_object || emit_asm {
        for temp_file in temp_files {
            RemoveFile(temp_file);
        } return failed ? 1 : 0;
    }

    if output_file.Empty() {
        output_file = SplitExtension(input_files[0]).left;
        if triple.Contains("windows") { output_file += ".exe"; }
    }

#[if WINDOWS]
    let lld_exe = "ld.lld.exe".ToString();
    let lld64_exe = "ld64.lld.exe".ToString();
    let lld_link_exe = "lld-link.exe".ToString();
#[else]
    let lld_exe = "ld.lld".ToString();
    let lld64_exe = "ld64.lld".ToString();
    let lld_link_exe = "lld-link".ToString();
#[endif]
    let mut command = String();

    if triple.Contains("windows") {
#[if WINDOWS]
        let (sdk_path, msvc_path) = (GetWindowsSDKPath(), GetMSVCPath());
        command = "\"" + msvc_path + "\\bin\\Hostx64\\x64\\link.exe\" /NOLOGO /SUBSYSTEM:CONSOLE /NODEFAULTLIB /ENTRY:_start";
        if debug { command += " /DEBUG"; }
        command += " /OUT:" + output_file;

        for object in objects {
            command += " " + object;
        }

        if !freestanding {
            command += " \"/LIBPATH:" + msvc_path + "\\lib\\x64\"";
            command += " \"/LIBPATH:" + sdk_path + "\\um\\x64\"";
            command += " \"/LIBPATH:" + sdk_path + "\\ucrt\\x64\"";

            for lib_path in lib_paths {
                command += " \"/LIBPATH:" + lib_path + "\"";
            }

            command += " user32.lib shell32.lib kernel32.lib";

            for lib in libs {
                command += " " + lib + ".lib";
            }
        }
#[else]
        Logger::Log("Cannot link to windows from another platform.", LogSeverity::Error);
        return 1;
#[endif]
    } else if triple.Contains("darwin") || triple.Contains("apple") {
        Logger::Log("Cannot link to darwin.", LogSeverity::Error);
        return 1;
    } else if triple.Contains("linux") {
        command = lld_exe + " --nostdlib --entry _start";
        if !freestanding { command += " --dynamic-linker /lib64/ld-linux-x86-64.so.2"; }
        command += " -o " + output_file;

        for object in objects {
            command += " " + object;
        }

        for lib_path in lib_paths {
            command += " -L" + lib_path;
        }

        for lib in libs {
            command += " -l" + lib;
        }
    } else {
        Logger::Log("Invalid target: '" + triple + "'.", LogSeverity::Error);
        return 1;
    }

    if verbose {
        Logger::Log("Link: '" + command.Replace("\"", "") + "'.", LogSeverity::Info);
    }

    Execute(command.Data());
    WriteLine("Program compiled in " + String::FromFloat(timer.Get() - start) + " seconds.");

    for temp_file in temp_files {
        RemoveFile(temp_file);
    }

    if run {
#[if !WINDOWS]
        if SplitPath(output_file).left.Empty() { output_file = JoinPath(String("."), output_file); }
#[endif]
        WriteLine("Program finished with exit code: " + String::FromInteger(Execute(output_file.Data()) as u64) + ".");
    } return 0;
}
