#[include "vendor/clang-c/CXString.zir" : *]

type CXCompilationDatabase = *mut void;
type CXCompileCommands = *mut void;
type CXCompileCommand = *mut void;

enum CXCompilationDatabase_Error: i32 {
    CXCompilationDatabase_NoError = 0,
    CXCompilationDatabase_CanNotLoadDatabase = 1
}

extern "C" {
    fn clang_CompilationDatabase_fromDirectory(BuildDir: *i8, ErrorCode: *mut CXCompilationDatabase_Error) -> CXCompilationDatabase;
    fn clang_CompilationDatabase_dispose(_p0: CXCompilationDatabase);
    fn clang_CompilationDatabase_getCompileCommands(_p0: CXCompilationDatabase, CompleteFileName: *i8) -> CXCompileCommands;
    fn clang_CompilationDatabase_getAllCompileCommands(_p0: CXCompilationDatabase) -> CXCompileCommands;
    fn clang_CompileCommands_dispose(_p0: CXCompileCommands);
    fn clang_CompileCommands_getSize(_p0: CXCompileCommands) -> u32;
    fn clang_CompileCommands_getCommand(_p0: CXCompileCommands, I: u32) -> CXCompileCommand;
    fn clang_CompileCommand_getDirectory(_p0: CXCompileCommand) -> CXString;
    fn clang_CompileCommand_getFilename(_p0: CXCompileCommand) -> CXString;
    fn clang_CompileCommand_getNumArgs(_p0: CXCompileCommand) -> u32;
    fn clang_CompileCommand_getArg(_p0: CXCompileCommand, I: u32) -> CXString;
    fn clang_CompileCommand_getNumMappedSources(_p0: CXCompileCommand) -> u32;
    fn clang_CompileCommand_getMappedSourcePath(_p0: CXCompileCommand, I: u32) -> CXString;
    fn clang_CompileCommand_getMappedSourceContent(_p0: CXCompileCommand, I: u32) -> CXString;
}
