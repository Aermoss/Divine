#[include "std/str", "std/vec", "std/map", "std/pair", "std/arena",
    "src/ScopeManager.zir", "src/Scope.zir", "src/Symbol.zir", "src/Generic.zir", "src/TypeManager.zir", "src/Types.zir",
        "src/Tokens.zir", "src/Nodes.zir", "src/HIR.zir", "src/Logger.zir" : *]

class SemanticForward {
    pub _class: *SemanticType,
    pub generic: *Generic = null,
    pub types: Vector<*SemanticType>,
    pub node: *FunctionNode,
    pub function: *mut HIRFunctionDeclaration;

    SemanticForward(&mut this, _class: *SemanticType, node: *FunctionNode, function: *mut HIRFunctionDeclaration) {
        (this._class, this.node, this.function) = (_class, node, function);
    }

    SemanticForward(&mut this, _class: *SemanticType, generic: *Generic, types: &Vector<*SemanticType>, node: *FunctionNode, function: *mut HIRFunctionDeclaration) {
        (this._class, this.generic, this.types, this.node, this.function) = (_class, generic, types, node, function);
    }
}

class SemanticAnalyzer {
    arena: Arena,
    module: *mut HIRModule = null,

    pub type_manager: TypeManager,
    pub scope_manager: ScopeManager,

    forwards: Vector<SemanticForward>,
    class_data: Map<*Node, Pair<*mut HIRClassDeclaration, *mut Scope>>,
    structure_data: Map<*Node, Pair<*mut HIRStructureDeclaration, *mut Scope>>,
    variant_data: Map<*Node, Pair<*mut HIRVariantDeclaration, *mut Scope>>,
    loop_scopes: Vector<*mut Scope>,

    pub abi: HIRDeclarationABI = HIRDeclarationABI::Native,
    pub linkage: HIRDeclarationLinkage = HIRDeclarationLinkage::Internal,
    pub _unsafe: bool = false,

    pub generics: Vector<*Generic>,
    pub current_generic: *mut Generic = null,
    pub current_class: *SemanticType = null,
    pub current_function: *SemanticType = null,
    pub current_block: *mut HIRBlockStatement = null;

    SemanticAnalyzer(&mut this) {
        if analyzer != null {
            Logger::Log("Another instance of 'SemanticAnalyzer' already exists!", LogSeverity::Fatal);
        } analyzer = this;
    }

    ~SemanticAnalyzer(&mut this) {
        analyzer = null;
    }

    pub fn Analyze(&mut this, root: *RootNode) -> *HIRModule {
        this.arena.Clear();
        this.module = this.arena.New<HIRModule>();
        let mut declared = Map<*Node, bool>();

        for declaration in root->declarations {
            declared[declaration] = false;
            declared[declaration] |= this.AnalyzeDeclarationFirstPass(declaration);
        }

        for declaration in root->declarations {
            declared[declaration] |= this.AnalyzeDeclarationSecondPass(declaration);
        }

        for declaration in root->declarations {
            declared[declaration] |= this.AnalyzeDeclarationThirdPass(declaration);

            if !declared[declaration] {
                Logger::Log("Unknown declaration '" + declaration->_type.ToString() + "'.", declaration, LogSeverity::Error);
            }
        }

        this.class_data.Clear();
        this.structure_data.Clear();
        this.variant_data.Clear();
        this.AnalyzeForwardDeclarations();
        this.forwards.Clear();

        for generic in this.generics {
            delete generic;
        }

        this.generics.Clear();
        return this.module;
    }

    fn AnalyzeForwardDeclarations(&mut this) {
        let mut i: usize = 0;

        while i < this.forwards.Size() {
            let forward: SemanticForward = this.forwards[i];
            let mut symbols = Map<String, *Symbol>();
            let prev_scope = this.scope_manager.current;
            this.current_function = (forward.function as *HIRDeclaration)->_type;
            this.current_class = forward._class;

            if forward.generic != null {
                this.scope_manager.current = forward.generic->scope;
                let mut index: usize = 0;

                for _type in forward.types {
                    let name = forward.generic->type_names[index];
                    symbols[name] = this.scope_manager.current->Set(name, _type, forward.node);
                    index += 1;
                }
            }

            let params = this.current_function->Parameters();
            let offset: usize = forward.node->_type->instance_kind != InstanceKind::None ? 1 : 0;
            this.scope_manager.PushScope(forward.node->name, false);

            for j in 0..params.Size() {
                if offset > j {
                    let parameter = this.arena.New<HIRParameterDeclaration>("this".ToString(), params[j], false);
                    this.scope_manager.Set("this".ToString(), parameter, false, forward.node);
                    forward.function->parameters.PushBack(parameter);
                } else {
                    let node: *ParameterNode = forward.node->_type->parameters[j - offset];
                    let parameter = this.arena.New<HIRParameterDeclaration>(node->name, params[j], node->mutable);
                    this.scope_manager.Set(node->name, parameter, false, node);
                    forward.function->parameters.PushBack(parameter);

                    if params[j]->IsClass() {
                        this.scope_manager.RegisterInstance(this.arena.New<HIRDeclarationReference>(parameter, false));
                    }
                }
            }

            for constructor in forward.node->constructors {
                let _class = this.ResolveType(constructor->expression);

                if _class == null {
                    continue;
                }

                if !_class->IsClass() {
                    Logger::Log("Constructor type must be a class.", constructor, LogSeverity::Error);
                    continue;
                }

                let mut values = Vector<*HIRExpression>();

                for argument in constructor->arguments {
                    let value = this.AnalyzeExpression(argument);
                    if value == null { continue; }
                    values.PushBack(value);
                }
            }

            forward.function->body = this.AnalyzeBlock(forward.node->body);
            this.scope_manager.PopScope();

            if forward.generic != null {
                for pair in symbols {
                    this.scope_manager.current->symbols[pair.left].Remove(pair.right);

                    if this.scope_manager.current->symbols[pair.left].Empty() {
                        this.scope_manager.current->symbols.Remove(pair.left);
                    } delete pair.right;
                }

                this.scope_manager.current = prev_scope;
            } i += 1;
        }
    }

    fn AnalyzeDeclarationFirstPass(&mut this, declaration: *Node) -> bool {
        if declaration->_type == NodeType::CLASS {
            let _class = declaration as *ClassNode;
            let pair = this.AnalyzeClassFirstPass(_class, null);

            if !_class->generic && pair.left != null && pair.right != null {
                this.class_data[declaration] = pair;
            }
        } else if declaration->_type == NodeType::STRUCTURE {
            let structure = declaration as *StructureNode;
            let pair = this.AnalyzeStructureFirstPass(structure, null);

            if !structure->generic && pair.left != null && pair.right != null {
                this.structure_data[declaration] = pair;
            }
        } else if declaration->_type == NodeType::ENUMERATION {
            let enumeration = declaration as *EnumerationNode;

            if enumeration->variant {
                let pair = this.AnalyzeVariantFirstPass(enumeration, null);

                if !enumeration->generic && pair.left != null && pair.right != null {
                    this.variant_data[declaration] = pair;
                }
            }
        } else {
            return false;
        } return true;
    }

    fn AnalyzeDeclarationSecondPass(&mut this, declaration: *Node) -> bool {
        if declaration->_type == NodeType::CONSTANT {
            this.AnalyzeConstant(declaration as *ConstantNode);
        } else if declaration->_type == NodeType::CLASS {
            let _class = declaration as *ClassNode;

            if !_class->generic {
                let cache = this.class_data[declaration];
                this.AnalyzeClassSecondPass(cache.left, _class, cache.right);
            }
        } else if declaration->_type == NodeType::STRUCTURE {
            let structure = declaration as *StructureNode;

            if !structure->generic {
                let cache = this.structure_data[declaration];
                this.AnalyzeStructureSecondPass(cache.left, structure, cache.right);
            }
        } else if declaration->_type == NodeType::ENUMERATION {
            let enumeration = declaration as *EnumerationNode;

            if enumeration->variant {
                if !enumeration->generic {
                    let cache = this.variant_data[declaration];
                    this.AnalyzeVariantSecondPass(cache.left, enumeration, cache.right);
                }
            } else {
                this.AnalyzeEnumeration(enumeration);
            }
        } else if declaration->_type == NodeType::TYPE_DEFINITION {
            this.AnalyzeTypeDefinition(declaration as *TypeDefinitionNode);
        } else {
            return false;
        } return true;
    }

    fn AnalyzeTypeDefinition(&mut this, type_definition: *TypeDefinitionNode) {
        this.scope_manager.Set(type_definition->name, this.ResolveType(type_definition->_type), type_definition);
    }

    fn AnalyzeDeclarationThirdPass(&mut this, declaration: *Node) -> bool {
        if declaration->_type == NodeType::STATIC {
            this.AnalyzeStatic(declaration as *StaticNode);
        } else if declaration->_type == NodeType::FUNCTION {
            let function = this.AnalyzeFunction(declaration as *FunctionNode, null);
            if function != null { this.module->declarations.PushBack(function); }
        } else if declaration->_type == NodeType::CLASS {
            let _class = declaration as *ClassNode;

            if !_class->generic {
                let cache = this.class_data[declaration];
                this.AnalyzeClassThirdPass(cache.left, _class, cache.right);
            }
        } else if declaration->_type == NodeType::STRUCTURE {
            let structure = declaration as *StructureNode;

            if !structure->generic {
                let cache = this.structure_data[declaration];
                this.AnalyzeStructureThirdPass(cache.left, structure, cache.right);
            }
        } else if declaration->_type == NodeType::ENUMERATION {
            let enumeration = declaration as *EnumerationNode;

            if enumeration->variant && !enumeration->generic {
                let cache = this.variant_data[declaration];
                this.AnalyzeVariantThirdPass(cache.left, enumeration, cache.right);
            }
        } else if declaration->_type == NodeType::EXTERN {
            this.AnalyzeExtern(declaration as *ExternNode);
        } else if declaration->_type == NodeType::ASSEMBLY {
            this.AnalyzeAssembly(declaration as *AssemblyNode);
        } else {
            return false;
        } return true;
    }

    pub fn Materialize(&mut this, _expression: *HIRExpression, target: &SemanticType) -> *HIRExpression {
        unsafe {
            let expression = _expression as *mut HIRExpression;
        }

        if expression == null {
            return expression;
        } else if expression->deferred != null {
            return this.Materialize(this.AnalyzeExpression(expression->deferred, target), target);
        }

        if expression->_type->IsInteger() && expression->_type->IsLiteral() && target.IsPointer() {
            if !(target.IsReference() && target.Pointee().IsInteger()) {
                expression->_type = this.type_manager.IntegerPointer(false);
            }
        }

        if expression->_type->IsLiteral() {
            if expression->_type->IsInteger() {
                if !target.IsInteger() || target.IsLiteral() {
                    expression->_type = this.type_manager.Integer(32, true);
                } else {
                    expression->_type = target;
                }
            } else if !target.IsFloat() || target.IsLiteral() {
                expression->_type = this.type_manager.Float(64);
            } else {
                expression->_type = target;
            }
        } return expression;
    }

    fn Materialize(&mut this, _expression: *HIRExpression) -> *HIRExpression {
        unsafe {
            let expression = _expression as *mut HIRExpression;
        }

        if expression != null {
            if expression->deferred != null {
                return this.Materialize(this.AnalyzeExpression(expression->deferred, null));
            } else if expression->_type->IsLiteral() {
                expression->_type = expression->_type->IsInteger() ? this.type_manager.Integer(32, true) : this.type_manager.Float(64);
            }
        } return expression;
    }

    fn ImplicitDereference(&mut this, expression: *HIRExpression) -> *HIRExpression {
        if expression != null && expression->_type->IsReference() {
            if expression->kind == HIRExpressionKind::AddressOf {
                return (expression as *HIRAddressOfExpression)->operand;
            }

            return this.arena.New<HIRDereferenceExpression>(expression);
        } return expression;
    }

    fn ImplicitAddressOf(&mut this, expression: *HIRExpression) -> *HIRExpression {
        if expression != null {
            if expression->category != HIRExpressionCategory::Place {
                return this.arena.New<HIRAddressOfExpression>(this.arena.New<HIRTemporaryExpression>(expression), expression->mutable);
            } else {
                if expression->kind == HIRExpressionKind::Dereference {
                    return (expression as *HIRDereferenceExpression)->operand;
                }

                return this.arena.New<HIRAddressOfExpression>(expression, expression->mutable);
            }
        } return expression;
    }

    fn MakeCompatible(&mut this, expression: *HIRExpression, target: &SemanticType) -> *HIRExpression {
        if target.IsPointer() && expression->_type->IsPointer() {
            if target.Pointee().IsClass() && expression->_type->Pointee().IsClass() {
                for field in expression->_type->Pointee().Fields() {
                    if field.left == target.Pointee().name {
                        return this.arena.New<HIRCastExpression>(expression, target);
                    }
                }
            }
        } return expression;
    }

    fn AnalyzeConstant(&mut this, constant: *ConstantNode) {
        let mut initializer: *HIRExpression = null;
        let _type = this.ResolveType(constant->_type);
        if _type == null { return; }

        if constant->initializer != null {
            initializer = this.Materialize(this.AnalyzeExpression(constant->initializer), _type);
        }

        let declaration = this.arena.New<HIRConstantDeclaration>(constant->name, _type, initializer);
        this.scope_manager.Set(constant->name, declaration, false, constant);
        this.module->declarations.PushBack(declaration);
    }

    fn AnalyzeStatic(&mut this, _static: *StaticNode) {
        let mut initializer: *HIRExpression = null;
        let _type = this.ResolveType(_static->_type);
        if _type == null { return; }

        if _static->initializer != null && !_static->zero_initializer {
            initializer = this.Materialize(this.AnalyzeExpression(_static->initializer), _type);
        }

        let mut alignment: *HIRExpression = null;

        if _static->alignment != null {
            alignment = this.Materialize(this.AnalyzeExpression(_static->alignment), this.type_manager.IntegerPointer(false));
            if alignment == null { return; }

            if !alignment->_type->IsIntegerPointer() || alignment->_type->IsSigned() {
                Logger::Log("Static alignment must be of type 'usize'.", _static, LogSeverity::Error);
                return;
            }
        }

        let declaration = this.arena.New<HIRStaticDeclaration>(_static->name, _type, initializer, alignment, _static->mutable, this.linkage);
        this.scope_manager.Set(_static->name, declaration, false, _static);
        this.module->declarations.PushBack(declaration);
    }

    pub fn AnalyzeFunction(&mut this, function: *FunctionNode, generic: *mut Generic) -> *HIRFunctionDeclaration {
        if function->generic && generic == null {
            let _generic = new Generic(function);
            this.scope_manager.Set(function->name, _generic, function);
            return null;
        }

        let return_type = this.ResolveType(function->_type->return_type);
        if return_type == null { return null; }
        let mut param_types = Vector<*SemanticType>();

        if function->_type->instance_kind != InstanceKind::None {
            if this.current_class == null {
                Logger::Log("Instance parameters are only allowed in class, structure, and variant methods.", function, LogSeverity::Error);
                return null;
            }

            if function->_type->instance_kind == InstanceKind::ConstRef {
                param_types.PushBack(this.type_manager.Reference(this.current_class, false));
            } else if function->_type->instance_kind == InstanceKind::MutRef {
                param_types.PushBack(this.type_manager.Reference(this.current_class, true));
            } else {
                param_types.PushBack(this.current_class);
            }
        }

        for parameter in function->_type->parameters {
            let param_type = this.ResolveType(parameter->_type);
            if param_type == null { return null; }
            param_types.PushBack(param_type);
        }

        if this.current_class == null && !function->constructors.Empty() {
            Logger::Log("Constructors can only be declared inside classes.", function, LogSeverity::Error);
            return null;
        }

        let declaration = this.arena.New<HIRFunctionDeclaration>(function->name, this.type_manager.Function(param_types, return_type), function->no_mangle, this.abi);

        if generic != null {
            generic->Set(declaration);
        } else {
            this.scope_manager.Set(function->name, declaration, this.abi == HIRDeclarationABI::Native && !function->no_mangle, function);
        }

        if function->body != null {
            if this.current_generic != null {
                this.forwards.PushBack(SemanticForward(this.current_class, this.current_generic, this.current_generic->types, function, declaration));
            } else {
                this.forwards.PushBack(SemanticForward(this.current_class, function, declaration));
            }
        } return declaration;
    }

    fn AnalyzeClassFirstPass(&mut this, _class: *ClassNode, generic: *mut Generic) -> Pair<*mut HIRClassDeclaration, *mut Scope> {
        if _class->generic && generic == null {
            let _generic = new Generic(_class);
            let symbol = this.scope_manager.Set(_class->name, _generic, _class);
            return Pair<*mut HIRClassDeclaration, *mut Scope>(null, null);
        }

        let _type = this.type_manager.Class(_class->name);
        let declaration = this.arena.New<HIRClassDeclaration>(_class->name, _type);
        this.module->declarations.PushBack(declaration);

        if generic != null {
            this.scope_manager.PushScope(generic->current, true);
            generic->Set(declaration);
        } else {
            this.scope_manager.Set(_class->name, declaration, false, _class);
            this.scope_manager.PushScope(_class->name, true);
        }

        let scope = this.scope_manager.current;
        this.scope_manager.PopScope();
        return Pair<*mut HIRClassDeclaration, *mut Scope>(declaration, scope);
    }

    fn AnalyzeClassSecondPass(&mut this, declaration: *mut HIRClassDeclaration, _class: *ClassNode, scope: *mut Scope) {
        unsafe {
            let _type = (declaration as *HIRDeclaration)->_type as *mut SemanticType;
        }

        let (prev_class, prev_scope) = (this.current_class, this.scope_manager.current);
        (this.current_class, this.scope_manager.current) = (_type, scope);

        for i in 0.._class->parents.Size() {
            let parent_type = this.ResolveType(_class->parents[i]);
            if parent_type == null { continue; }
            _type->fields[parent_type->name] = Field(i, parent_type, null, false);
            declaration->fields.PushBack(parent_type);
        }

        for i in 0.._class->fields.Size() {
            let field = _class->fields[i];
            let field_type = this.ResolveType(field.right->_type);
            if field_type == null { continue; }
            _type->fields[field.right->name] = Field(i, field_type, field.right->initializer, field.left);
            declaration->fields.PushBack(field_type);
        }

        (this.current_class, this.scope_manager.current) = (prev_class, prev_scope);
    }

    fn AnalyzeClassThirdPass(&mut this, declaration: *mut HIRClassDeclaration, _class: *ClassNode, scope: *mut Scope) {
        unsafe {
            let _type = (declaration as *HIRDeclaration)->_type as *mut SemanticType;
        }

        let (prev_class, prev_scope) = (this.current_class, this.scope_manager.current);
        (this.current_class, this.scope_manager.current) = (_type, scope);

        for constructor in _class->constructors {
            let function = this.AnalyzeFunction(constructor, null);

            if function != null {
                _type->methods.PushBack(Method(constructor->name, function, false, true));
                declaration->constructors.PushBack(function);
            }
        }

        if _class->destructor != null {
            let function = this.AnalyzeFunction(_class->destructor, null);

            if function != null {
                _type->methods.PushBack(Method(_class->destructor->name, function, false, true));
                declaration->destructor = function;
            }
        }

        for method in _class->methods {
            let function = this.AnalyzeFunction(method.right, null);
            let _static = method.right->_type->instance_kind == InstanceKind::None;
            if function == null { continue; }

            if !method.right->generic {
                _type->methods.PushBack(Method(method.right->name, function, _static, method.left));
                declaration->methods.PushBack(function);
            }
        }

        (this.current_class, this.scope_manager.current) = (prev_class, prev_scope);
    }

    pub fn AnalyzeClass(&mut this, _class: *ClassNode, generic: *mut Generic) -> *HIRClassDeclaration {
        let cache = this.AnalyzeClassFirstPass(_class, generic);

        if cache.left != null {
            this.AnalyzeClassSecondPass(cache.left, _class, cache.right);
            this.AnalyzeClassThirdPass(cache.left, _class, cache.right);
        } return cache.left;
    }

    fn AnalyzeStructureFirstPass(&mut this, structure: *StructureNode, generic: *mut Generic) -> Pair<*mut HIRStructureDeclaration, *mut Scope> {
        if structure->generic && generic == null {
            let _generic = new Generic(structure);
            this.scope_manager.Set(structure->name, _generic, structure);
            return Pair<*mut HIRStructureDeclaration, *mut Scope>(null, null);
        }

        let _type = this.type_manager.Structure(structure->name);
        let declaration = this.arena.New<HIRStructureDeclaration>(structure->name, _type);
        this.module->declarations.PushBack(declaration);

        if generic != null {
            this.scope_manager.PushScope(generic->current, true);
            generic->Set(declaration);
        } else {
            this.scope_manager.Set(structure->name, declaration, false, structure);
            this.scope_manager.PushScope(structure->name, true);
        }

        let scope = this.scope_manager.current;
        this.scope_manager.PopScope();
        return Pair<*mut HIRStructureDeclaration, *mut Scope>(declaration, scope);
    }

    fn AnalyzeStructureSecondPass(&mut this, declaration: *mut HIRStructureDeclaration, structure: *StructureNode, scope: *mut Scope) {
        unsafe {
            let _type = (declaration as *HIRDeclaration)->_type as *mut SemanticType;
        }

        let (prev_class, prev_scope) = (this.current_class, this.scope_manager.current);
        (this.current_class, this.scope_manager.current) = (_type, scope);

        for i in 0..structure->fields.Size() {
            let field = structure->fields[i];
            let field_type = this.ResolveType(field.right->_type);
            if field_type == null { continue; }
            _type->fields[field.right->name] = Field(i, field_type, field.right->initializer, field.left);
            declaration->fields.PushBack(field_type);
        }

        (this.current_class, this.scope_manager.current) = (prev_class, prev_scope);
    }

    fn AnalyzeStructureThirdPass(&mut this, declaration: *mut HIRStructureDeclaration, structure: *StructureNode, scope: *mut Scope) {
        unsafe {
            let _type = (declaration as *HIRDeclaration)->_type as *mut SemanticType;
        }

        let (prev_class, prev_scope) = (this.current_class, this.scope_manager.current);
        (this.current_class, this.scope_manager.current) = (_type, scope);

        for method in structure->methods {
            let function = this.AnalyzeFunction(method.right, null);
            let _static = method.right->_type->instance_kind == InstanceKind::None;
            if function == null { continue; }

            if !method.right->generic {
                _type->methods.PushBack(Method(method.right->name, function, _static, method.left));
                declaration->methods.PushBack(function);
            }
        }

        (this.current_class, this.scope_manager.current) = (prev_class, prev_scope);
    }

    pub fn AnalyzeStructure(&mut this, structure: *StructureNode, generic: *mut Generic) -> *HIRStructureDeclaration {
        let cache = this.AnalyzeStructureFirstPass(structure, generic);

        if cache.left != null {
            this.AnalyzeStructureSecondPass(cache.left, structure, cache.right);
            this.AnalyzeStructureThirdPass(cache.left, structure, cache.right);
        } return cache.left;
    }

    fn AnalyzeEnumeration(&mut this, enumeration: *EnumerationNode) {
        let underlying_type = this.ResolveType(enumeration->underlying_type);
        if underlying_type == null { return; }

        if !underlying_type->IsInteger() {
            Logger::Log("Expected an integer type.", enumeration, LogSeverity::Error);
            return;
        }

        let _type = this.type_manager.Enumeration(enumeration->name, underlying_type);
        let declaration = this.arena.New<HIREnumerationDeclaration>(enumeration->name, _type);
        this.module->declarations.PushBack(declaration);

        this.scope_manager.Set(enumeration->name, declaration, false, enumeration);
        this.scope_manager.PushScope(enumeration->name, true);

        for variant in enumeration->variants {
            this.scope_manager.Set(variant->name, _type, enumeration);
        }

        this.scope_manager.PopScope();
    }

    fn AnalyzeVariantFirstPass(&mut this, enumeration: *EnumerationNode, generic: *mut Generic) -> Pair<*mut HIRVariantDeclaration, *mut Scope> {
        if enumeration->generic && generic == null {
            let _generic = new Generic(enumeration);
            this.scope_manager.Set(enumeration->name, _generic, enumeration);
            return Pair<*mut HIRVariantDeclaration, *mut Scope>(null, null);
        }

        let _type = this.type_manager.Variant(enumeration->name);
        let declaration = this.arena.New<HIRVariantDeclaration>(enumeration->name, _type);
        this.module->declarations.PushBack(declaration);

        if generic != null {
            this.scope_manager.PushScope(generic->current, true);
            generic->Set(declaration);
        } else {
            this.scope_manager.Set(enumeration->name, declaration, false, enumeration);
            this.scope_manager.PushScope(enumeration->name, true);
        }

        let scope = this.scope_manager.current;
        this.scope_manager.PopScope();
        return Pair<*mut HIRVariantDeclaration, *mut Scope>(declaration, scope);
    }

    fn AnalyzeVariantSecondPass(&mut this, declaration: *mut HIRVariantDeclaration, enumeration: *EnumerationNode, scope: *mut Scope) {
        unsafe {
            let _type = (declaration as *HIRDeclaration)->_type as *mut SemanticType;
        }

        let (prev_class, prev_scope) = (this.current_class, this.scope_manager.current);
        (this.current_class, this.scope_manager.current) = (_type, scope);

        for variant in enumeration->variants {
            let mut types = Vector<*SemanticType>();

            for _type in variant->types {
                types.PushBack(this.ResolveType(_type));
            }

            _type->variants.PushBack(Pair<String, Vector<*SemanticType>>(variant->name, types));
            this.scope_manager.Set(variant->name, _type, variant);
        }

        for variant in enumeration->variants {
            _type->variant_field_names.PushBack(variant->field_names);
        }

        (this.current_class, this.scope_manager.current) = (prev_class, prev_scope);
    }

    fn AnalyzeVariantThirdPass(&mut this, declaration: *mut HIRVariantDeclaration, enumeration: *EnumerationNode, scope: *mut Scope) {
        unsafe {
            let _type = (declaration as *HIRDeclaration)->_type as *mut SemanticType;
        }

        let (prev_class, prev_scope) = (this.current_class, this.scope_manager.current);
        (this.current_class, this.scope_manager.current) = (_type, scope);

        for method in enumeration->methods {
            let function = this.AnalyzeFunction(method.right, null);
            let _static = method.right->_type->instance_kind == InstanceKind::None;
            if function == null { continue; }

            if !method.right->generic {
                _type->methods.PushBack(Method(method.right->name, function, _static, method.left));
                declaration->methods.PushBack(function);
            }
        }

        (this.current_class, this.scope_manager.current) = (prev_class, prev_scope);
    }

    pub fn AnalyzeVariant(&mut this, enumeration: *EnumerationNode, generic: *mut Generic) -> *HIRVariantDeclaration {
        let cache = this.AnalyzeVariantFirstPass(enumeration, generic);

        if cache.left != null {
            this.AnalyzeVariantSecondPass(cache.left, enumeration, cache.right);
            this.AnalyzeVariantThirdPass(cache.left, enumeration, cache.right);
        } return cache.left;
    }

    fn AnalyzeExtern(&mut this, _extern: *ExternNode) {
        if this.abi != HIRDeclarationABI::Native {
            Logger::Log("Already in an extern block.", _extern, LogSeverity::Error);
            return;
        }

        if _extern->linkage != "C" {
            Logger::Log("Unknown linkage '" + _extern->linkage + "'.", _extern, LogSeverity::Error);
            return;
        }

        let (previous_abi, previous_linkage) = (this.abi, this.linkage);
        (this.abi, this.linkage) = (HIRDeclarationABI::C, HIRDeclarationLinkage::External);

        for declaration in _extern->declarations {
            this.AnalyzeDeclarationThirdPass(declaration);
        }

        (this.abi, this.linkage) = (previous_abi, previous_linkage);
    }

    fn AnalyzeAssembly(&mut this, assembly: *AssemblyNode) {
        if this.scope_manager.current->global {
            if !assembly->inputs.Empty() {
                Logger::Log("Cannot set inputs on module inline assembly.", assembly, LogSeverity::Error);
            }

            if !assembly->outputs.Empty() {
                Logger::Log("Cannot set outputs on module inline assembly.", assembly, LogSeverity::Error);
            }

            if !assembly->clobbers.Empty() {
                Logger::Log("Cannot set clobbers on module inline assembly.", assembly, LogSeverity::Error);
            }
        } else if assembly->outputs.Size() > 1 {
            Logger::Log("Multiple outputs are not supported.", assembly, LogSeverity::Error);
        }
    }

    fn AnalyzeStatement(&mut this, statement: *Node) {
        if statement->_type == NodeType::RETURN {
            this.AnalyzeReturn(statement as *ReturnNode);
        } else if statement->_type == NodeType::EXPRESSION {
            let expression = this.AnalyzeExpression((statement as *ExpressionNode)->expression);

            if expression != null {
                this.current_block->statements.PushBack(this.arena.New<HIRExpressionStatement>(expression));
            }
        } else if statement->_type == NodeType::IF {
            this.AnalyzeIf(statement as *IfNode);
        } else if statement->_type == NodeType::IF_LET {
            this.AnalyzeIfLet(statement as *IfLetNode);
        } else if statement->_type == NodeType::WHILE {
            this.AnalyzeWhile(statement as *WhileNode);
        } else if statement->_type == NodeType::WHILE_LET {
            this.AnalyzeWhileLet(statement as *WhileLetNode);
        } else if statement->_type == NodeType::FOR {
            this.AnalyzeFor(statement as *ForNode);
        } else if statement->_type == NodeType::LOOP {
            this.AnalyzeLoop(statement as *LoopNode);
        } else if statement->_type == NodeType::MATCH {
            this.AnalyzeMatch(statement as *MatchNode);
        } else if statement->_type == NodeType::UNSAFE {
            this.AnalyzeUnsafe(statement as *UnsafeNode);
        } else if statement->_type == NodeType::BLOCK {
            this.AnalyzeBlock(statement as *BlockNode);
        } else if statement->_type == NodeType::CONTINUE {
            this.AnalyzeContinue(statement as *ContinueNode);
        } else if statement->_type == NodeType::BREAK {
            this.AnalyzeBreak(statement as *BreakNode);
        } else if statement->_type == NodeType::VARIABLE {
            this.AnalyzeVariable(statement as *VariableNode);
        } else if statement->_type == NodeType::ASSIGNMENT {
            let mut assignment = statement as *AssignmentNode;

            while assignment != null {
                let expression = this.AnalyzeAssignment(assignment);

                if expression != null {
                    this.current_block->statements.PushBack(this.arena.New<HIRExpressionStatement>(expression));
                } assignment = assignment->next;
            }
        } else if statement->_type == NodeType::ASSEMBLY {
            this.AnalyzeAssembly(statement as *AssemblyNode);
        } else {
            Logger::Log("Unknown statement '" + statement->_type.ToString() + "'.", statement, LogSeverity::Error);
        }
    }

    fn AnalyzeReturn(&mut this, _return: *ReturnNode) {
        let mut value: *HIRExpression = null;

        if _return->expression != null {
            let return_type = this.current_function->Return();
            value = this.Materialize(this.AnalyzeExpression(_return->expression), return_type);
            if value == null { return; }
        }

        this.AnalyzeDestructors(null);
        this.current_block->statements.PushBack(this.arena.New<HIRReturnStatement>(value));
    }

    fn AnalyzeIf(&mut this, _if: *IfNode) {
        let condition = this.ImplicitDereference(this.AnalyzeExpression(_if->condition));

        if condition != null && !condition->_type->IsBoolean() {
            Logger::Log("Invalid condition type '" + condition->_type->ToString() + "'.", _if->condition, LogSeverity::Error);
        }

        this.scope_manager.PushScope(String("then"), false);
        let (then_body, mut else_body: *HIRBlockStatement) = (this.AnalyzeBlock(_if->body as *BlockNode), null);
        this.scope_manager.PopScope();

        if _if->_else != null {
            this.scope_manager.PushScope(String("else"), false);

            if _if->_else->_type == NodeType::BLOCK {
                else_body = this.AnalyzeBlock(_if->_else as *BlockNode);
            } else {
                let prev_block = this.current_block;
                let else_block = this.arena.New<HIRBlockStatement>();
                this.current_block = else_block;
                this.AnalyzeStatement(_if->_else);
                this.current_block = prev_block;
                else_body = else_block;
            }

            this.scope_manager.PopScope();
        }

        this.current_block->statements.PushBack(this.arena.New<HIRIfStatement>(condition, then_body, else_body));
    }

    fn AnalyzeIfLet(&mut this, if_let: *IfLetNode) {
        let expression = this.ImplicitDereference(this.AnalyzeExpression(if_let->expression));
        if expression == null { return; }

        this.scope_manager.PushScope(String("then"), false);
        let (then_body, mut else_body: *HIRBlockStatement) = (this.AnalyzeBlock(if_let->body as *BlockNode), null);
        this.scope_manager.PopScope();

        if if_let->_else != null {
            this.scope_manager.PushScope(String("else"), false);

            if if_let->_else->_type == NodeType::BLOCK {
                else_body = this.AnalyzeBlock(if_let->_else as *BlockNode);
            } else {
                let prev_block = this.current_block;
                let else_block = this.arena.New<HIRBlockStatement>();
                this.current_block = else_block;
                this.AnalyzeStatement(if_let->_else);
                this.current_block = prev_block;
                else_body = else_block;
            }

            this.scope_manager.PopScope();
        }
    }

    fn AnalyzeWhile(&mut this, _while: *WhileNode) {
        let condition = this.ImplicitDereference(this.AnalyzeExpression(_while->condition));

        if condition != null && !condition->_type->IsBoolean() {
            Logger::Log("Invalid condition type '" + condition->_type->ToString() + "'.", _while->condition, LogSeverity::Error);
        }

        this.scope_manager.PushScope(String("while"), false);
        this.loop_scopes.PushBack(this.scope_manager.current);
        let (while_body, mut else_body: *HIRBlockStatement) = (this.AnalyzeBlock(_while->body as *BlockNode), null);
        this.loop_scopes.PopBack();
        this.scope_manager.PopScope();

        if _while->_else != null {
            this.scope_manager.PushScope(String("else"), false);
            else_body = this.AnalyzeBlock(_while->_else as *BlockNode);
            this.scope_manager.PopScope();
        }

        this.current_block->statements.PushBack(this.arena.New<HIRWhileStatement>(condition, while_body, else_body));
    }

    fn AnalyzeWhileLet(&mut this, while_let: *WhileLetNode) {
        let expression = this.Materialize(this.AnalyzeExpression(while_let->expression));
        if expression == null { return; }

        this.scope_manager.PushScope(String("while"), false);
        this.loop_scopes.PushBack(this.scope_manager.current);
        this.AnalyzeStatement(while_let->body);
        this.loop_scopes.PopBack();
        this.scope_manager.PopScope();
    }

    fn AnalyzeFor(&mut this, _for: *ForNode) {
        let (mut start: *HIRExpression, mut end: *HIRExpression);
        let (mut is_range, mut inclusive) = (false, false);

        if _for->iterable->_type == NodeType::RANGE {
            let range = _for->iterable as *RangeNode;
            (is_range, inclusive) = (true, range->inclusive);
            start = this.AnalyzeExpression(range->start);
            end = this.AnalyzeExpression(range->end);
            if start == null || end == null { return; }
            start = this.Materialize(start, end->_type);
            end = this.Materialize(end, start->_type);
        } else {
            let iterable = this.ImplicitDereference(this.AnalyzeExpression(_for->iterable));
            if iterable == null { return; }

            let mut values = Vector<*HIRExpression>();
            values.PushBack(this.ImplicitAddressOf(iterable));
            let mut begin_function: *HIRFunctionDeclaration = null;
            let mut end_function: *HIRFunctionDeclaration = null;

            if iterable->_type->HasMethods() {
                let begin_candidates = iterable->_type->GetCandidates("Begin".ToString(), _for, true);
                begin_function = this.ResolveOverload(begin_candidates, values, _for, true);

                let end_candidates = iterable->_type->GetCandidates("End".ToString(), _for, true);
                end_function = this.ResolveOverload(end_candidates, values, _for, true);
            }

            if begin_function == null || end_function == null {
                Logger::Log("For loop iterable must provide 'Begin()' and 'End()' methods.", _for, LogSeverity::Error);
                return;
            }

            start = this.AnalyzeResolvedCall(begin_function, values, _for);
            end = this.AnalyzeResolvedCall(end_function, values, _for);
            if start == null || end == null { return; }
        }

        if start->_type != end->_type {
            Logger::Log("Start and end expressions of a for loop must have the same type.", _for, LogSeverity::Error);
            return;
        }

        let iterator_type = start->_type;

        if is_range && !iterator_type->IsInteger() && !iterator_type->IsFloat() {
            Logger::Log("For loop ranges require an integer or floating point type.", _for, LogSeverity::Error);
            return;
        }

        if !is_range && !iterator_type->IsPointer() && !iterator_type->HasMethods() {
            Logger::Log("For loop requires a pointer iterator or an iterator class.", _for, LogSeverity::Error);
            return;
        }

        let iterator = this.arena.New<HIRVariableStatement>("iterator".ToString(), iterator_type, start, true);
        let iterator_ref = this.arena.New<HIRVariableReference>(iterator);

        let mut variable: *HIRVariableStatement = null;
        let mut condition: *HIRExpression = null;
        let mut step: *HIRExpression = null;

        if is_range {
            let mut one: *HIRExpression = null;

            if iterator_type->IsFloat() {
                one = this.arena.New<HIRFloatLiteral>(1.0f64, iterator_type);
            } else {
                one = this.arena.New<HIRIntegerLiteral>(1u64, iterator_type);
            }

            let _operator = inclusive ? TokenType::LESS_EQUAL : TokenType::LESS;
            condition = this.arena.New<HIRBinaryExpression>(_operator, iterator_ref, end, this.type_manager.Boolean());
            let next = this.arena.New<HIRBinaryExpression>(TokenType::PLUS, iterator_ref, one, iterator_type);
            step = this.arena.New<HIRAssignmentExpression>(iterator_ref, next);
            variable = this.arena.New<HIRVariableStatement>(_for->variable, iterator_type, iterator_ref, false);
        } else if iterator_type->IsPointer() {
            condition = this.arena.New<HIRBinaryExpression>(TokenType::NOT_EQUAL, iterator_ref, end, this.type_manager.Boolean());
            let step_value = this.arena.New<HIRBinaryExpression>(TokenType::PLUS, iterator_ref, this.arena.New<HIRIntegerLiteral>(1u64, this.type_manager.IntegerPointer(false)), iterator_type);
            step = this.arena.New<HIRAssignmentExpression>(iterator_ref, step_value);
            let value = this.arena.New<HIRDereferenceExpression>(iterator_ref);
            variable = this.arena.New<HIRVariableStatement>(_for->variable, iterator_type->Pointee(), value, false);
        } else {
            let mut values = Vector<*HIRExpression>();
            values.PushBack(iterator_ref);
            values.PushBack(end);
            let condition_candidates = iterator_type->GetCandidates("operator!=".ToString(), _for, false);
            condition = this.AnalyzeResolvedCall(condition_candidates, values, _for);
            if condition == null { return; }

            values = Vector<*HIRExpression>();
            values.PushBack(iterator_ref);
            values.PushBack(this.arena.New<HIRIntegerLiteral>(1u64, this.type_manager.IntegerPointer(false)));
            let step_candidates = iterator_type->GetCandidates("operator+=".ToString(), _for, false);
            step = this.AnalyzeResolvedCall(step_candidates, values, _for);
            if step == null { return; }

            values = Vector<*HIRExpression>();
            values.PushBack(iterator_ref);
            let dereference_candidates = iterator_type->GetCandidates("operator*".ToString(), _for, false);
            let value = this.AnalyzeResolvedCall(dereference_candidates, values, _for);
            if value == null { return; }
            variable = this.arena.New<HIRVariableStatement>(_for->variable, value->_type, value, false);
        }

        this.scope_manager.PushScope(String("for"), false);
        this.loop_scopes.PushBack(this.scope_manager.current);
        this.scope_manager.Set(_for->variable, variable, _for);
        let body = this.AnalyzeBlock(_for->body as *BlockNode);
        this.loop_scopes.PopBack();
        this.scope_manager.PopScope();

        this.current_block->statements.PushBack(this.arena.New<HIRForStatement>(iterator, variable, condition, step, body));
    }

    fn AnalyzeLoop(&mut this, _loop: *LoopNode) {
        this.scope_manager.PushScope(String("loop"), false);
        this.loop_scopes.PushBack(this.scope_manager.current);
        let body = this.AnalyzeBlock(_loop->body as *BlockNode);
        this.loop_scopes.PopBack();
        this.scope_manager.PopScope();

        this.current_block->statements.PushBack(this.arena.New<HIRLoopStatement>(body));
    }

    fn AnalyzeDestructors(&mut this, target: *mut Scope) {
        let mut scope = this.scope_manager.current;

        while scope != null && !scope->global {
            for instance in scope->instances.Reverse() {
                let _type = instance->_type;
                let candidates = _type->GetCandidates(("~" + _type->name), null, true);
                if candidates.Empty() { continue; }
                let mut values = Vector<*HIRExpression>();
                values.PushBack(instance);
                let expression = this.arena.New<HIRDestructorExpression>(this.AnalyzeResolvedCall(candidates, values, null) as *HIRCallExpression);
                this.current_block->statements.PushBack(this.arena.New<HIRExpressionStatement>(expression));
            }

            if scope == target { break; }
            scope = scope->parent;
        }
    }

    fn AnalyzeContinue(&mut this, _continue: *ContinueNode) {
        if this.loop_scopes.Empty() {
            Logger::Log("Continue statement outside of loop.", _continue, LogSeverity::Error);
            return;
        }

        this.AnalyzeDestructors(this.loop_scopes.Back());
        this.current_block->statements.PushBack(this.arena.New<HIRContinueStatement>());
    }

    fn AnalyzeBreak(&mut this, _break: *BreakNode) {
        if this.loop_scopes.Empty() {
            Logger::Log("Break statement outside of loop.", _break, LogSeverity::Error);
            return;
        }

        this.AnalyzeDestructors(this.loop_scopes.Back());
        this.current_block->statements.PushBack(this.arena.New<HIRBreakStatement>());
    }

    fn AnalyzeMatch(&mut this, _match: *MatchNode) {
        this.AnalyzeExpression(_match->expression);
    }

    fn AnalyzeUnsafe(&mut this, _unsafe: *UnsafeNode) {
        if this._unsafe {
            Logger::Log("Already in an unsafe statement.", _unsafe, LogSeverity::Error);
            return;
        }

        this._unsafe = true;
        this.AnalyzeBlock(_unsafe->body);
        this._unsafe = false;
    }

    fn AnalyzeBlock(&mut this, block: *BlockNode) -> *HIRBlockStatement {
        let prev_block = this.current_block;
        let statement = this.arena.New<HIRBlockStatement>();
        this.current_block = statement;

        for statement in block->statements {
            this.AnalyzeStatement(statement);
        }

        this.AnalyzeDestructors(this.scope_manager.current);
        this.current_block = prev_block;
        return statement;
    }

    fn AnalyzeVariable(&mut this, variable: *VariableNode) {
        let mut initializer: *HIRExpression = null;
        let mut _type: *SemanticType = null;

        if variable->_type != null {
            _type = this.ResolveType(variable->_type);

            if variable->initializer != null {
                initializer = this.Materialize(this.AnalyzeExpression(variable->initializer), _type);
            }
        } else if variable->initializer != null {
            initializer = this.Materialize(this.AnalyzeExpression(variable->initializer));
            _type = initializer->_type;
        } else {
            Logger::Log("Type annotation required for variable '" + variable->name + "' without initializer.", variable, LogSeverity::Error);
        }

        if _type != null {
            let statement = this.arena.New<HIRVariableStatement>(variable->name, _type, initializer, variable->mutable);
            this.scope_manager.Set(variable->name, statement, variable);
            this.current_block->statements.PushBack(statement);

            if _type->IsClass() {
                this.scope_manager.RegisterInstance(this.arena.New<HIRVariableReference>(statement));
            }
        }

        if variable->next != null {
            this.AnalyzeVariable(variable->next);
        }
    }

    fn AssignmentToBinaryOperator(&this, _operator: TokenType) -> TokenType {
        if _operator == TokenType::PLUS_ASSIGN { return TokenType::PLUS; }
        else if _operator == TokenType::MINUS_ASSIGN { return TokenType::MINUS; }
        else if _operator == TokenType::MUL_ASSIGN { return TokenType::MUL; }
        else if _operator == TokenType::DIV_ASSIGN { return TokenType::DIV; }
        else if _operator == TokenType::MOD_ASSIGN { return TokenType::MOD; }
        else if _operator == TokenType::LSHIFT_ASSIGN { return TokenType::LSHIFT; }
        else if _operator == TokenType::RSHIFT_ASSIGN { return TokenType::RSHIFT; }
        else if _operator == TokenType::AND_ASSIGN { return TokenType::BITWISE_AND; }
        else if _operator == TokenType::OR_ASSIGN { return TokenType::BITWISE_OR; }
        else { return TokenType::BITWISE_XOR; }
    }

    fn AnalyzeAssignment(&mut this, assignment: *AssignmentNode) -> *HIRExpression {
        let _operator = assignment->_operator;
        let left_raw = this.AnalyzeExpression(assignment->left);
        let mut left = this.ImplicitDereference(left_raw);
        if left == null { return null; }

        let right_raw = this.AnalyzeExpression(assignment->right);
        let mut right = this.ImplicitDereference(right_raw);
        if right == null { return null; }

        if left->_type->IsPointer() && (_operator == TokenType::PLUS_ASSIGN || _operator == TokenType::MINUS_ASSIGN) {
            right = this.Materialize(right, this.type_manager.IntegerPointer(false));
        } else {
            right = this.Materialize(right, left->_type);
        }

        if left->_type->HasMethods() {
            let mut values = Vector<*HIRExpression>();
            values.PushBack(this.ImplicitAddressOf(left));
            values.PushBack(right_raw);

            let name = "operator" + _operator.ToAssignmentOperatorString();
            let candidates = left->_type->GetCandidates(name, assignment, true);
            let function = this.ResolveOverload(candidates, values, assignment, true);

            if function != null {
                this.AnalyzeResolvedCall(function, values, assignment);
            } else if left->_type == right->_type {
                if _operator != TokenType::ASSIGN {
                    Logger::Log("Invalid class assignment operation '" + _operator.ToString() + "' for type '" + left->_type->ToString() + "'.", assignment, LogSeverity::Error);
                }
            } else {
                Logger::Log("Incompatible class assignment types. ('" + left->_type->ToString() + "' != '" + right->_type->ToString() + "').", assignment, LogSeverity::Error);
            } return null;
        }

        if left->category != HIRExpressionCategory::Place {
            Logger::Log("Cannot assign to non-place value.", assignment, LogSeverity::Error);
            return null;
        }

        if !left->mutable {
            Logger::Log("Cannot assign to immutable value.", assignment, LogSeverity::Error);
            return null;
        }

        if _operator != TokenType::ASSIGN {
            right = this.AnalyzeResolvedBinary(left, right, this.AssignmentToBinaryOperator(_operator), assignment);
            if right == null { return null; }
        }

        return this.arena.New<HIRAssignmentExpression>(left, right);
    }

    fn IsDeferrableExpression(&mut this, node: *Node) -> *SemanticType {
        if node->_type == NodeType::LITERAL {
            let literal = node as *LiteralNode;

            if literal->_type == TokenType::INTEGER && !literal->value.Contains('u') && !literal->value.Contains('i') {
                return this.type_manager.IntegerLiteral();
            } else if literal->_type == TokenType::FLOAT && !literal->value.Contains('f') {
                return this.type_manager.FloatLiteral();
            } else {
                return null;
            }
        } else if node->_type == NodeType::TERNARY {
            let ternary = node as *TernaryNode;
            let then_type = this.IsDeferrableExpression(ternary->then);
            if then_type == null { return null; }
            let else_type = this.IsDeferrableExpression(ternary->_else);
            if else_type == null { return null; }

            if *then_type == *else_type {
                return then_type;
            } else {
                return null;
            }
        } else if node->_type == NodeType::BINARY {
            let binary = node as *BinaryNode;

            if binary->_operator == TokenType::EQUAL || binary->_operator == TokenType::NOT_EQUAL || binary->_operator == TokenType::GREATER || binary->_operator == TokenType::LESS || binary->_operator == TokenType::GREATER_EQUAL || binary->_operator == TokenType::LESS_EQUAL || binary->_operator == TokenType::AND || binary->_operator == TokenType::OR {
                return null;
            }

            let left_type = this.IsDeferrableExpression(binary->left);
            if left_type == null { return null; }
            let right_type = this.IsDeferrableExpression(binary->right);
            if right_type == null { return null; }

            if *left_type == *right_type {
                return left_type;
            } else {
                return null;
            }
        } else if node->_type == NodeType::UNARY {
            let unary = node as *UnaryNode;

            if unary->_operator == TokenType::MINUS || unary->_operator == TokenType::NOT {
                return this.IsDeferrableExpression(unary->operand);
            } else {
                return null;
            }
        } else {
            return null;
        }
    }

    fn AnalyzeExpression(&mut this, expression: *Node) -> *HIRExpression {
        if expression->_type == NodeType::UNARY || expression->_type == NodeType::BINARY || expression->_type == NodeType::TERNARY {
            let _type = this.IsDeferrableExpression(expression);

            if _type != null {
                return this.arena.New<HIRDeferredExpression>(_type, expression);
            }
        }

        return this.AnalyzeExpression(expression, null);
    }

    pub fn AnalyzeExpression(&mut this, expression: *Node, target: *SemanticType) -> *HIRExpression {
        if expression->_type == NodeType::LITERAL {
            return this.AnalyzeLiteral(expression as *LiteralNode);
        } else if expression->_type == NodeType::CALL {
            return this.AnalyzeCall(expression as *CallNode);
        } else if expression->_type == NodeType::IDENTIFIER || expression->_type == NodeType::SCOPE_RESOLUTION {
            let symbol = this.scope_manager.Resolve(expression, false);

            if symbol == null {
                return null;
            }

            if symbol->kind == SymbolKind::Statement {
                let statement = symbol->statement;

                if statement->kind == HIRStatementKind::Variable {
                    return this.arena.New<HIRVariableReference>(statement as *HIRVariableStatement);
                } else {
                    Logger::Log("Cannot use statement as an expression.", expression, LogSeverity::Error);
                    return null;
                }
            } else if symbol->kind == SymbolKind::Declaration {
                let declaration = symbol->declaration;

                if declaration->kind == HIRDeclarationKind::Constant || declaration->kind == HIRDeclarationKind::Function {
                    return this.arena.New<HIRDeclarationReference>(declaration, false);
                } else if declaration->kind == HIRDeclarationKind::Static {
                    return this.arena.New<HIRDeclarationReference>(declaration, (declaration as *HIRStaticDeclaration)->mutable);
                } else if declaration->kind == HIRDeclarationKind::Parameter {
                    return this.arena.New<HIRDeclarationReference>(declaration, (declaration as *HIRParameterDeclaration)->mutable);
                } else {
                    Logger::Log("Cannot use declaration '" + declaration->name + "' as an expression.", expression, LogSeverity::Error);
                    return null;
                }
            } else {
                Logger::Log("Cannot use a type as an expression.", expression, LogSeverity::Error);
                return null;
            }
        } else if expression->_type == NodeType::NEW {
            return this.AnalyzeNew(expression as *NewNode);
        } else if expression->_type == NodeType::DELETE {
            return this.AnalyzeDelete(expression as *DeleteNode);
        } else if expression->_type == NodeType::CAST {
            return this.AnalyzeCast(expression as *CastNode);
        } else if expression->_type == NodeType::INDEX_ACCESS {
            return this.AnalyzeIndexAccess(expression as *IndexAccessNode);
        } else if expression->_type == NodeType::MEMBER_ACCESS {
            return this.AnalyzeMemberAccess(expression as *MemberAccessNode);
        } else if expression->_type == NodeType::UNARY {
            return this.AnalyzeUnary(expression as *UnaryNode, target);
        } else if expression->_type == NodeType::BINARY {
            return this.AnalyzeBinary(expression as *BinaryNode, target);
        } else if expression->_type == NodeType::TERNARY {
            return this.AnalyzeTernary(expression as *TernaryNode, target);
        } else if expression->_type == NodeType::STRUCTURE_INITIALIZER {
            return this.AnalyzeStructureInitializer(expression as *StructureInitializerNode);
        } else {
            Logger::Log("Unknown expression '" + expression->_type.ToString() + "'.", expression, LogSeverity::Error);
            return null;
        }
    }

    fn AnalyzeLiteral(&mut this, literal: *LiteralNode) -> *HIRExpression {
        if literal->_type == TokenType::INTEGER {
            let (mut value, mut suffix, mut base: u64) = (String(), String(), 10);
            let (mut index, mut signed) = (literal->value.Find('i'), true);

            if index == -1 {
                (index, signed) = (literal->value.Find('u'), false);
            }

            if index != -1 {
                value = literal->value.SubString(0, index as usize);
                suffix = literal->value.SubString(index as usize + 1);
            } else {
                value = literal->value;
            }

            if value.StartsWith("0x") {
                (value, base) = (value.SubString(2), 16);
            } else if value.StartsWith("0o") {
                (value, base) = (value.SubString(2), 8);
            } else if value.StartsWith("0b") {
                (value, base) = (value.SubString(2), 2);
            }

            let mut _type = this.type_manager.IntegerLiteral();

            if !suffix.Empty() {
                if suffix == "size" {
                    _type = this.type_manager.IntegerPointer(signed);
                } else {
                    let width = suffix.ToInteger() as u32;

                    if width == 128 || width == 64 || width == 32 || width == 16 || width == 8 {
                        _type = this.type_manager.Integer(width, signed);
                    } else {
                        Logger::Log("Invalid integer suffix '" + (signed ? 'u' : 'i').ToString() + suffix +  "'.", literal, LogSeverity::Error);
                        return null;
                    }
                }
            }

            return this.arena.New<HIRIntegerLiteral>(value.ToUnsignedInteger(base), _type);
        } else if literal->_type == TokenType::FLOAT {
            let (mut value, mut suffix) = (String(), String());
            let mut index = literal->value.Find('f');

            if index != -1 {
                value = literal->value.SubString(0, index as usize);
                suffix = literal->value.SubString(index as usize + 1);
            } else {
                value = literal->value;
            }

            let mut _type = this.type_manager.FloatLiteral();

            if !suffix.Empty() {
                let width = suffix.ToInteger() as u32;

                if width == 64 || width == 32 {
                    _type = this.type_manager.Float(width);
                } else {
                    Logger::Log("Invalid float suffix 'f" + suffix +  "'.", literal, LogSeverity::Error);
                    return null;
                }
            }

            return this.arena.New<HIRFloatLiteral>(value.ToFloat(), _type);
        } else if literal->_type == TokenType::TRUE || literal->_type == TokenType::FALSE {
            return this.arena.New<HIRBooleanLiteral>(literal->_type == TokenType::TRUE, this.type_manager.Boolean());
        } else if literal->_type == TokenType::CHAR {
            if (literal->value.Size() == 2 && literal->value[1] == '\0') || (literal->value.Size() == 1 && literal->value[0] == '\0') {
                let character: i8 = literal->value[0];
                return this.arena.New<HIRCharacterLiteral>(character as u32, this.type_manager.Integer(8, true));
            } else {
                Logger::Log("Invalid character literal '" + literal->value + "'.", literal, LogSeverity::Error);
                return null;
            }
        } else if literal->_type == TokenType::STRING {
            return this.arena.New<HIRStringLiteral>(literal->value, this.type_manager.Pointer(this.type_manager.Integer(8, true), false));
        } else if literal->_type == TokenType::NULL {
            return this.arena.New<HIRNullLiteral>(this.type_manager.NullPointer());
        } else {
            Logger::Log("Unknown literal type '" + literal->_type.ToString() + "'.", literal, LogSeverity::Error);
            return null;
        }
    }

    fn AnalyzeCall(&mut this, call: *CallNode) -> *HIRExpression {
        if call->expression->_type == NodeType::IDENTIFIER {
            let identifier = call->expression as *IdentifierNode;

            if identifier->name == "sizeof" || identifier->name == "alignof" {
                if call->arguments.Size() != 1 {
                    Logger::Log("Invalid number of arguments for '" + identifier->name + "'.", call, LogSeverity::Error);
                    return null;
                }

                let mut _type: *SemanticType;
                let argument = call->arguments[0];

                if argument->_type == NodeType::IDENTIFIER || argument->_type == NodeType::SCOPE_RESOLUTION {
                    let symbol = this.scope_manager.Resolve(argument, false);
                    if symbol == null { return null; }

                    if symbol->kind == SymbolKind::Statement {
                        let statement = symbol->statement;

                        if statement->kind == HIRStatementKind::Variable {
                            _type = (statement as *HIRVariableStatement)->_type;
                        } else {
                            Logger::Log("Cannot use statement as a type.", call, LogSeverity::Error);
                            return null;
                        }
                    } else if symbol->kind == SymbolKind::Declaration {
                        _type = symbol->declaration->_type;
                    } else {
                        _type = symbol->_type;
                    }
                } else {
                    _type = this.ResolveType(argument);
                }

                return this.arena.New<HIRIntrinsicExpression>(identifier->name == "sizeof" ? HIRIntrinsicKind::SizeOf : HIRIntrinsicKind::AlignOf, _type);
            }
        }

        let mut values = Vector<*HIRExpression>();

        for argument in call->arguments {
            let value = this.AnalyzeExpression(argument);
            if value == null { return null; }
            values.PushBack(value);
        }

        if call->expression->_type == NodeType::MEMBER_ACCESS {
            let member_access = call->expression as *MemberAccessNode;
            let mut instance = this.ImplicitDereference(this.AnalyzeExpression(member_access->expression));
            if instance == null { return null; }

            if member_access->arrow {
                if instance->_type->HasMethods() {
                    let values = Vector<*HIRExpression>();
                    values.PushBack(this.ImplicitAddressOf(instance));

                    let candidates = instance->_type->GetCandidates("operator->".ToString(), member_access, false);
                    if candidates.Empty() { return null; }

                    instance = this.ImplicitDereference(this.AnalyzeResolvedCall(candidates, values, member_access));
                } else if instance->_type->IsPointer() {
                    instance = this.ImplicitDereference(instance);
                } else {
                    Logger::Log("Expected a pointer type for arrow operator.", member_access, LogSeverity::Error);
                    return null;
                }
            }

            if !instance->_type->HasFields() && !instance->_type->HasMethods() {
                if member_access->arrow {
                    Logger::Log("Expected a dot operator.", call, LogSeverity::Error);
                    return null;
                }

                values.Insert(0, this.ImplicitAddressOf(instance));
                let candidates = this.scope_manager.ResolveCandidates(member_access->member, call, false);
                if candidates.Empty() { return null; }
                return this.AnalyzeResolvedCall(candidates, values, call);
            } else {
                let index = instance->_type->HasFields() ? instance->_type->Index(member_access->member) : -1;

                if index != -1 {
                    let field = instance->_type->Fields()[member_access->member];

                    if !field.public && (this.current_class != null && *this.current_class != *instance->_type) {
                        Logger::Log("Field '" + member_access->member + "' is private.", call, LogSeverity::Error);
                        return null;
                    }

                    let target = this.arena.New<HIRMemberAccessExpression>(instance, field._type, index as usize);
                    return this.AnalyzeResolvedCall(target, values, call);
                } else {
                    values.Insert(0, this.ImplicitAddressOf(instance));
                    let candidates = instance->_type->GetCandidates(member_access->member, call, false);
                    if candidates.Empty() { return null; }
                    return this.AnalyzeResolvedCall(candidates, values, call);
                }
            }
        } else if call->expression->_type == NodeType::TYPE_APPLICATION || call->expression->_type == NodeType::PRIMITIVE_TYPE {
            if call->expression->_type == NodeType::TYPE_APPLICATION {
                let type_application = call->expression as *TypeApplicationNode;
                let mut types = Vector<*SemanticType>();

                for _type in type_application->types {
                    types.PushBack(this.ResolveType(_type));
                }

                if type_application->expression->_type == NodeType::PRIMITIVE_TYPE {
                    let primitive_type = type_application->expression as *PrimitiveTypeNode;

                    if this.scope_manager.Has(primitive_type->name, SymbolKind::Generic) {
                        let generic = this.scope_manager.Get(primitive_type->name, SymbolKind::Generic)->generic;

                        if generic->node->_type == NodeType::FUNCTION {
                            let declaration = generic->Get(types).left;

                            if declaration->kind != HIRDeclarationKind::Function {
                                Logger::Log("Generic '" + primitive_type->name + "' is not a function.", call, LogSeverity::Error);
                                return null;
                            }

                            return this.AnalyzeResolvedCall(declaration as *HIRFunctionDeclaration, values, call);
                        }
                    } else {
                        if this.scope_manager.Has(primitive_type->name) {
                            Logger::Log("Function '" + primitive_type->name + "' is not generic.", call, LogSeverity::Error);
                        } else {
                            Logger::Log("Function '" + primitive_type->name + "' not found.", call, LogSeverity::Error);
                        } return null;
                    }
                } else if type_application->expression->_type == NodeType::SCOPE_RESOLUTION {
                    let resolution = type_application->expression as *ScopeResolutionNode;
                    let scope = this.scope_manager.ResolveScopeHalf(resolution, false);
                    if scope == null { return null; }
                    let symbol = scope->Get(resolution->identifier->name, SymbolKind::Generic);
                    if symbol == null { return null; }
                    let declaration = symbol->generic->Get(types).left;

                    if declaration->kind != HIRDeclarationKind::Function {
                        Logger::Log("Generic '" + resolution->identifier->name + "' is not a function.", call, LogSeverity::Error);
                        return null;
                    }

                    return this.AnalyzeResolvedCall(declaration as *HIRFunctionDeclaration, values, call);
                }
            }

            let _class = this.ResolveType(call->expression);
            if _class == null { return null; }

            if !_class->IsClass() {
                Logger::Log("Only class types can be constructed with a call expression.", call, LogSeverity::Error);
                return null;
            }

            let instance = this.arena.New<HIRConstructorExpression>(_class);
            values.Insert(0, this.ImplicitAddressOf(instance));

            let candidates = _class->GetCandidates(_class->name, call, false);
            instance->call = this.AnalyzeResolvedCall(candidates, values, call) as *HIRCallExpression;
            return instance;
        } else {
            let candidates = this.scope_manager.ResolveCandidates(call->expression, true);

            if !candidates.Empty() {
                return this.AnalyzeResolvedCall(candidates, values, call);
            }

            let value = this.AnalyzeExpression(call->expression);

            if value != null {
                return this.AnalyzeResolvedCall(value, values, call);
            } else {
                return null;
            }
        }
    }

    fn ResolveOverload(&mut this, candidates: &Vector<*HIRFunctionDeclaration>, values: &Vector<*HIRExpression>, node: *Node, test: bool) -> *HIRFunctionDeclaration {
        let mut index: usize = 0;
        let mut best: u64 = 0;

        for i in 0..candidates.Size() {
            let function: *HIRFunctionDeclaration = candidates[i];
            let params = (function as *HIRDeclaration)->_type->Parameters();
            if values.Size() != params.Size() { continue; }
            let (mut _match, mut score: u64) = (true, 1);

            for j in 0..params.Size() {
                let param_score = params[j]->ScoreParameter(values[j]->_type);

                if param_score != 0 {
                    score += param_score;
                } else {
                    _match = false;
                    break;
                }
            }

            if _match && score > best {
                (index, best) = (i, score);
            }
        }

        if best != 0 {
            return candidates[index];
        } else {
            if !test {
                let candidate: *HIRFunctionDeclaration = candidates[0];
                Logger::Log("Invalid arguments for: '" + (candidate as *HIRDeclaration)->name + "'.", node, LogSeverity::Error);
            } return null;
        }
    }

    fn AnalyzeResolvedCall(&mut this, candidates: &Vector<*HIRFunctionDeclaration>, values: &Vector<*HIRExpression>, node: *Node) -> *HIRExpression {
        let function = this.ResolveOverload(candidates, values, node, false);
        if function == null { return null; }
        return this.AnalyzeResolvedCall(function, values, node);
    }

    fn AnalyzeResolvedCall(&mut this, function: *HIRFunctionDeclaration, values: &Vector<*HIRExpression>, node: *Node) -> *HIRExpression {
        let expression = this.arena.New<HIRDeclarationReference>(function as *HIRDeclaration, false);
        return this.AnalyzeResolvedCall(expression, values, node);
    }

    fn AnalyzeResolvedCall(&mut this, function: *HIRExpression, values: &Vector<*HIRExpression>, node: *Node) -> *HIRExpression {
        if !function->_type->IsFunction() {
            Logger::Log("Call target is not a function.", node, LogSeverity::Error);
            return null;
        }

        let param_types = function->_type->Parameters();

        for i in 0..param_types.Size() {
            let param_type: *SemanticType = param_types[i];
            let mut value = this.Materialize(values[i], param_type);

            if param_type->IsReference() && param_type->Pointee().IsCompatible(value->_type) {
                value = this.ImplicitAddressOf(value);
            }

            if value->_type->IsReference() && param_type->IsCompatible(value->_type->Pointee()) {
                value = this.ImplicitDereference(value);
            }

            if !param_type->IsCompatible(value->_type) {
                Logger::Log("Incompatible argument types for function '" + function->_type->name + "'. ('" + param_type->ToString() + "' != '" + value->_type->ToString() + "').", node, LogSeverity::Error);
                return null;
            }

            if !param_type->IsMutabilityCompatible(value->_type) && false {
                Logger::Log("Cannot assign immutable pointer to mutable pointer.", node, LogSeverity::Error);
                return null;
            }

            values[i] = this.MakeCompatible(value, param_type);
        }

        return this.arena.New<HIRCallExpression>(function, values);
    }

    fn AnalyzeNew(&mut this, _new: *NewNode) -> *HIRExpression {
        let _type = this.ResolveType(_new->_type);
        let mut size: *HIRExpression = null;

        if _type == null {
            return null;
        }

        if _new->size != null {
            size = this.Materialize(this.AnalyzeExpression(_new->size), this.type_manager.IntegerPointer(false));

            if size == null {
                return null;
            }

            if !size->_type->IsIntegerPointer() || size->_type->IsSigned() {
                Logger::Log("Array size must be of type 'usize'.", _new, LogSeverity::Error);
                return null;
            }
        }

        return this.arena.New<HIRNewExpression>(_type, size);
    }

    fn AnalyzeDelete(&mut this, _delete: *DeleteNode) -> *HIRExpression {
        let pointer = this.AnalyzeExpression(_delete->expression);

        if pointer == null {
            return null;
        }

        if !pointer->_type->IsPointer() {
            Logger::Log("Delete value must be a pointer.", _delete, LogSeverity::Error);
            return null;
        }

        return this.arena.New<HIRDeleteExpression>(pointer);
    }

    fn LiteralNeedsExplicitType(&mut this, expression: *Node, target: *SemanticType) -> bool {
        let _type = this.IsDeferrableExpression(expression);

        if _type == null {
            return false;
        } else if _type->IsInteger() {
            return target->IsInteger() && !target->IsSame(this.type_manager.Integer(32, true));
        } else if _type->IsFloat() {
            return target->IsFloat() && !target->IsSame(this.type_manager.Float(64));
        } else {
            return false;
        }
    }

    fn AnalyzeCast(&mut this, cast: *CastNode) -> *HIRExpression {
        let mut target = this.ResolveType(cast->target_type);
        if target == null { return null; }

        let value = this.Materialize(this.AnalyzeExpression(cast->expression), target);
        if value == null { return null; }

        if *value->_type == *target && this.LiteralNeedsExplicitType(cast->expression, target) {
            return value;
        }

        return this.AnalyzeResolvedCast(value, target, cast);
    }

    fn AnalyzeResolvedCast(&mut this, mut value: *HIRExpression, target: &SemanticType, node: *Node) -> *HIRExpression {
        if !target.IsPointer() {
            value = this.ImplicitDereference(value);
        }

        let (mut state, mut failed) = (false, false);
        let (mut left: *SemanticType, mut right) = (target, value->_type);

        while left->IsPointer() && right->IsPointer() {
            if left->IsMutable() != right->IsMutable() {
                if left->IsMutable() && !right->IsNullPointer() {
                    failed = true;
                } state = true;
            }

            (left, right) = (left->Pointee(), right->Pointee());
        }

        if *value->_type == target {
            if !state {
                Logger::Log("Redundant cast. ('" + value->_type->ToString() + "' to '" + target.ToString() + "')", node, LogSeverity::Warning);
            } else {
                if !failed || this._unsafe {
                    return this.arena.New<HIRCastExpression>(value, target);
                } else {
                    Logger::Log("Cannot cast immutable pointer to mutable pointer.", node, LogSeverity::Error);
                    return null;
                }
            }
        }

        if value->_type->IsBoolean() {
            if target.IsInteger() {
                return this.arena.New<HIRCastExpression>(value, target);
            }
        } else if value->_type->IsCharacter() {
            if target.IsInteger() {
                return this.arena.New<HIRCastExpression>(value, target);
            }
        } else if value->_type->IsInteger() {
            if target.IsPointer() || target.IsInteger() || target.IsFloat() || target.IsEnumeration() {
                return this.arena.New<HIRCastExpression>(value, target);
            } else if target.IsCharacter() {
                if value->_type->Width() == 8 && !value->_type->IsSigned() {
                    return this.arena.New<HIRCastExpression>(value, target);
                }
            }
        } else if value->_type->IsFloat() {
            if target.IsInteger() || target.IsFloat() {
                return this.arena.New<HIRCastExpression>(value, target);
            }
        } else if value->_type->IsPointer() {
            if target.IsInteger() {
                return this.arena.New<HIRCastExpression>(value, target);
            }
        } else if value->_type->IsEnumeration() {
            if target.IsInteger() {
                return this.arena.New<HIRCastExpression>(value, target);
            }
        }

        if value->_type->IsPointer() && target.IsPointer() {
            if value->_type->Pointee().IsClass() && target.Pointee().IsClass() {
                let mut related = false;

                for field in value->_type->Pointee().Fields() {
                    if field.left == target.Pointee().name {
                        related = true;
                        break;
                    }
                }

                if !related {
                    for field in target.Pointee().Fields() {
                        if field.left == value->_type->Pointee().name {
                            related = true;
                            break;
                        }
                    }
                }

                if !related {
                    Logger::Log("Cannot cast class '" + value->_type->Pointee().name + "' to unrelated class '" + target.Pointee().name + "'.", node, LogSeverity::Error);
                    return null;
                }
            }

            return this.arena.New<HIRCastExpression>(value, target);
        } else {
            Logger::Log("Cannot cast '" + value->_type->ToString() + "' to '" + target.ToString() + "'.", node, LogSeverity::Error);
            return null;
        }
    }

    fn AnalyzeIndexAccess(&mut this, index_access: *IndexAccessNode) -> *HIRExpression {
        let value = this.ImplicitDereference(this.AnalyzeExpression(index_access->expression));

        if value == null {
            return null;
        }

        let index = this.Materialize(this.ImplicitDereference(this.AnalyzeExpression(index_access->index)), this.type_manager.IntegerPointer(false));

        if index == null {
            return null;
        }

        if value->_type->HasMethods() {
            let mut values = Vector<*HIRExpression>();
            values.PushBack(this.ImplicitAddressOf(value));
            values.PushBack(index);

            let candidates = value->_type->GetCandidates("operator[]".ToString(), index_access, false);
            if candidates.Empty() { return null; }

            return this.AnalyzeResolvedCall(candidates, values, index_access);
        }

        if !value->_type->IsPointer() {
            Logger::Log("Indexed value must be a pointer.", index_access, LogSeverity::Error);
            return null;
        }

        if !index->_type->IsIntegerPointer() || index->_type->IsSigned() {
            Logger::Log("Index must be of type 'usize'.", index_access, LogSeverity::Error);
            return null;
        }

        return this.arena.New<HIRIndexAccessExpression>(value, index);
    }

    fn AnalyzeMemberAccess(&mut this, member_access: *MemberAccessNode) -> *HIRExpression {
        let mut instance = this.ImplicitDereference(this.AnalyzeExpression(member_access->expression));

        if instance == null {
            return null;
        }

        if member_access->arrow {
            if instance->_type->HasMethods() {
                let values = Vector<*HIRExpression>();
                values.PushBack(this.ImplicitAddressOf(instance));

                let candidates = instance->_type->GetCandidates("operator->".ToString(), member_access, false);
                if candidates.Empty() { return null; }

                instance = this.ImplicitDereference(this.AnalyzeResolvedCall(candidates, values, member_access));
            } else if instance->_type->IsPointer() {
                instance = this.ImplicitDereference(instance);
            } else {
                Logger::Log("Expected a pointer type for arrow operator.", member_access, LogSeverity::Error);
                return null;
            }
        }

        if !instance->_type->HasFields() {
            Logger::Log("Cannot access field '" + member_access->member + "' of type '" + instance->_type->ToString() + "'.", member_access, LogSeverity::Error);
            return null;
        }

        let index = instance->_type->Index(member_access->member);

        if index != -1 {
            let field = instance->_type->Fields()[index as usize].right;

            if !field.public && (this.current_class != null && *this.current_class != *instance->_type) {
                Logger::Log("Field '" + member_access->member + "' is private.", member_access, LogSeverity::Error);
                return null;
            }

            return this.arena.New<HIRMemberAccessExpression>(instance, field._type, index as usize);
        } else {
            Logger::Log("Field '" + member_access->member + "' not found in type '" + instance->_type->ToString() + "'.", member_access, LogSeverity::Error);
            return null;
        }
    }

    fn AnalyzeUnary(&mut this, unary: *UnaryNode, target: *SemanticType) -> *HIRExpression {
        let raw = this.AnalyzeExpression(unary->operand);
        let mut value = this.ImplicitDereference(raw);
        if value == null { return null; }

        let mut values = Vector<*HIRExpression>();
        values.PushBack(this.ImplicitAddressOf(value));

        let name = "operator" + unary->_operator.ToUnaryOperatorString();
        let candidates = this.scope_manager.ResolveCandidates(name, unary, true);
        let function = this.ResolveOverload(candidates, values, unary, true);

        if function != null {
            return this.AnalyzeResolvedCall(function, values, unary);
        }

        if value->_type->HasMethods() {
            let candidates = value->_type->GetCandidates(name, unary, true);
            let function = this.ResolveOverload(candidates, values, unary, true);

            if function != null {
                return this.AnalyzeResolvedCall(function, values, unary);
            }
        }

        if unary->_operator == TokenType::BITWISE_AND {
            if raw->category != HIRExpressionCategory::Place {
                Logger::Log("Cannot take reference to non-place value.", unary, LogSeverity::Error);
                return null;
            }

            if unary->mutable && !raw->mutable {
                Logger::Log("Cannot take mutable reference to immutable value.", unary, LogSeverity::Error);
                return null;
            }

            return this.arena.New<HIRAddressOfExpression>(raw, unary->mutable);
        } else if unary->_operator == TokenType::MUL {
            if !raw->_type->IsPointer() {
                Logger::Log("Cannot dereference non-pointer type '" + raw->_type->ToString() + "'.", unary, LogSeverity::Error);
                return null;
            }

            return this.arena.New<HIRDereferenceExpression>(raw);
        } else {
            let mut operand_target: *SemanticType = null;

            if target != null {
                if unary->_operator == TokenType::MINUS {
                    if target->IsFloat() || (target->IsInteger() && target->IsSigned()) {
                        operand_target = target;
                    }
                } else if unary->_operator == TokenType::TILDE || unary->_operator == TokenType::NOT {
                    operand_target = target;
                }
            }

            if operand_target != null {
                value = this.Materialize(value, operand_target);
            } else {
                value = this.Materialize(value);
            }

            if unary->_operator == TokenType::MINUS {
                if value->_type->IsInteger() || value->_type->IsFloat() {
                    if value->_type->IsInteger() && !value->_type->IsSigned() {
                        Logger::Log("Cannot negate unsigned type '" + value->_type->ToString() + "'.", unary, LogSeverity::Error);
                        return null;
                    }

                    return this.arena.New<HIRUnaryExpression>(unary->_operator, value);
                } else {
                    Logger::Log("Cannot negate type '" + value->_type->ToString() + "'.", unary, LogSeverity::Error);
                    return null;
                }
            } else if unary->_operator == TokenType::NOT {
                if value->_type->IsInteger() || value->_type->IsBoolean() {
                    return this.arena.New<HIRUnaryExpression>(unary->_operator, value);
                } else {
                    Logger::Log("Cannot invert type '" + value->_type->ToString() + "'.", unary, LogSeverity::Error);
                    return null;
                }
            } else {
                Logger::Log("Invalid unary operation '" + unary->_operator.ToString() + "'.", unary, LogSeverity::Error);
                return null;
            }
        }
    }

    fn AnalyzeBinary(&mut this, binary: *BinaryNode, target: *SemanticType) -> *HIRExpression {
        let mut operand_target: *SemanticType = null;

        if target != null && binary->_operator != TokenType::EQUAL && binary->_operator != TokenType::NOT_EQUAL && binary->_operator != TokenType::GREATER && binary->_operator != TokenType::LESS && binary->_operator != TokenType::GREATER_EQUAL && binary->_operator != TokenType::LESS_EQUAL && binary->_operator != TokenType::AND && binary->_operator != TokenType::OR {
            if target->IsInteger() || target->IsFloat() || target->IsBoolean() {
                operand_target = target;
            }
        }

        let mut left = this.AnalyzeExpression(binary->left);
        if left == null { return null; }

        if operand_target != null {
            left = this.Materialize(left, operand_target);
        }

        if binary->_operator == TokenType::AND || binary->_operator == TokenType::OR {
            if !left->_type->IsBoolean() {
                Logger::Log("Invalid type '" + left->_type->ToString() + "' for binary operation '" + binary->_operator.ToString() + "'.", binary, LogSeverity::Error);
                return null;
            }

            this.scope_manager.PushScope(String("short circuit"), false);
            let right = this.AnalyzeExpression(binary->right);
            this.scope_manager.PopScope();

            if right == null {
                return null;
            }

            if !right->_type->IsBoolean() {
                Logger::Log("Invalid type '" + right->_type->ToString() + "' for binary operation '" + binary->_operator.ToString() + "'.", binary, LogSeverity::Error);
                return null;
            }

            return this.arena.New<HIRBinaryExpression>(binary->_operator, left, right, left->_type);
        }

        let mut right = this.AnalyzeExpression(binary->right);
        if right == null { return null; }

        if operand_target != null {
            right = this.Materialize(right, operand_target);
        }

        return this.AnalyzeResolvedBinary(left, right, binary->_operator, binary);
    }

    fn AnalyzeResolvedBinary(&mut this, mut left: *HIRExpression, mut right: *HIRExpression, _operator: TokenType, node: *Node) -> *HIRExpression {
        let (left_raw, right_raw) = (left, right);
        (left, right) = (this.ImplicitDereference(left), this.ImplicitDereference(right));

        let mut values = Vector<*HIRExpression>();
        values.PushBack(left);
        values.PushBack(right);

        let name = "operator" + _operator.ToBinaryOperatorString();
        let candidates = this.scope_manager.ResolveCandidates(name, node, true);
        let function = this.ResolveOverload(candidates, values, node, true);

        if function != null {
            return this.AnalyzeResolvedCall(function, values, node);
        } else if left->_type->HasFields() || right->_type->HasFields() {
            let instance = left->_type->HasFields() ? left : right;
            let value = left->_type->HasFields() ? right_raw : left_raw;

            let mut values = Vector<*HIRExpression>();
            values.PushBack(this.ImplicitAddressOf(instance));
            values.PushBack(value);

            if instance->_type->HasMethods() {
                let candidates = instance->_type->GetCandidates(name, node, true);
                let function = this.ResolveOverload(candidates, values, node, true);

                if function != null {
                    return this.AnalyzeResolvedCall(function, values, node);
                }
            }

            if *left->_type == *right->_type {
                if _operator != TokenType::EQUAL && _operator != TokenType::NOT_EQUAL {
                    Logger::Log("Invalid binary operation '" + _operator.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                    return null;
                }

                return this.arena.New<HIRBinaryExpression>(_operator, left, right, this.type_manager.Boolean());
            } else {
                Logger::Log("Incompatible binary operation types. ('" + left->_type->ToString() + "' != '" + right->_type->ToString() + "').", node, LogSeverity::Error);
                return null;
            }
        }

        if left->_type->IsPointer() && right->_type->IsInteger() && right->_type->IsLiteral() {
            right = this.Materialize(right, this.type_manager.IntegerPointer(false));
        } else if right->_type->IsPointer() && left->_type->IsInteger() && left->_type->IsLiteral() {
            left = this.Materialize(left, this.type_manager.IntegerPointer(false));
        } else {
            (left, right) = (this.Materialize(left, right->_type), this.Materialize(right, left->_type));
        }

        if left->_type->IsBoolean() && right->_type->IsBoolean() {
            if _operator == TokenType::EQUAL || _operator == TokenType::NOT_EQUAL {
                return this.arena.New<HIRBinaryExpression>(_operator, left, right, this.type_manager.Boolean());
            } else if _operator == TokenType::AND || _operator == TokenType::BITWISE_AND || _operator == TokenType::OR || _operator == TokenType::BITWISE_OR || _operator == TokenType::BITWISE_XOR {
                return this.arena.New<HIRBinaryExpression>(_operator, left, right, left->_type);
            } else {
                Logger::Log("Invalid binary operation '" + _operator.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                return null;
            }
        } else if left->_type->IsCharacter() && right->_type->IsCharacter() {
            if _operator == TokenType::EQUAL || _operator == TokenType::NOT_EQUAL || _operator == TokenType::GREATER || _operator == TokenType::GREATER_EQUAL || _operator == TokenType::LESS || _operator == TokenType::LESS_EQUAL {
                return this.arena.New<HIRBinaryExpression>(_operator, left, right, this.type_manager.Boolean());
            } else {
                Logger::Log("Invalid binary operation '" + _operator.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                return null;
            }
        } else if left->_type->IsInteger() && right->_type->IsInteger() {
            if *left->_type != *right->_type {
                Logger::Log("Incompatible binary operation types. ('" + left->_type->ToString() + "' != '" + right->_type->ToString() + "').", node, LogSeverity::Error);
                return null;
            }

            if _operator == TokenType::PLUS || _operator == TokenType::MINUS || _operator == TokenType::MUL || _operator == TokenType::DIV || _operator == TokenType::MOD {
                return this.arena.New<HIRBinaryExpression>(_operator, left, right, left->_type);
            } else if _operator == TokenType::EQUAL || _operator == TokenType::NOT_EQUAL || _operator == TokenType::GREATER || _operator == TokenType::GREATER_EQUAL || _operator == TokenType::LESS || _operator == TokenType::LESS_EQUAL {
                return this.arena.New<HIRBinaryExpression>(_operator, left, right, this.type_manager.Boolean());
            } else if _operator == TokenType::BITWISE_AND || _operator == TokenType::BITWISE_OR || _operator == TokenType::BITWISE_XOR || _operator == TokenType::LSHIFT || _operator == TokenType::RSHIFT {
                return this.arena.New<HIRBinaryExpression>(_operator, left, right, left->_type);
            } else {
                Logger::Log("Invalid binary operation '" + _operator.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                return null;
            }
        } else if left->_type->IsFloat() && right->_type->IsFloat() {
            if *left->_type != *right->_type {
                Logger::Log("Incompatible binary operation types. ('" + left->_type->ToString() + "' != '" + right->_type->ToString() + "').", node, LogSeverity::Error);
                return null;
            }

            if _operator == TokenType::PLUS || _operator == TokenType::MINUS || _operator == TokenType::MUL || _operator == TokenType::DIV || _operator == TokenType::MOD {
                return this.arena.New<HIRBinaryExpression>(_operator, left, right, left->_type);
            } else if _operator == TokenType::EQUAL || _operator == TokenType::NOT_EQUAL || _operator == TokenType::GREATER || _operator == TokenType::GREATER_EQUAL || _operator == TokenType::LESS || _operator == TokenType::LESS_EQUAL {
                return this.arena.New<HIRBinaryExpression>(_operator, left, right, this.type_manager.Boolean());
            } else {
                Logger::Log("Invalid binary operation '" + _operator.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                return null;
            }
        } else if left->_type->IsPointer() && right->_type->IsPointer() {
            if *left->_type != *right->_type && !(left->_type->IsNullPointer() || right->_type->IsNullPointer()) {
                Logger::Log("Incompatible binary operation types. ('" + left->_type->ToString() + "' != '" + right->_type->ToString() + "').", node, LogSeverity::Error);
                return null;
            }

            if _operator == TokenType::MINUS {
                return this.arena.New<HIRBinaryExpression>(_operator, left, right, this.type_manager.IntegerPointer(false));
            } else if _operator == TokenType::EQUAL || _operator == TokenType::NOT_EQUAL || _operator == TokenType::GREATER || _operator == TokenType::GREATER_EQUAL || _operator == TokenType::LESS || _operator == TokenType::LESS_EQUAL {
                return this.arena.New<HIRBinaryExpression>(_operator, left, right, this.type_manager.Boolean());
            } else {
                Logger::Log("Invalid pointer binary operation '" + _operator.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                return null;
            }
        } else if (left->_type->IsPointer() && right->_type->IsInteger()) || (left->_type->IsInteger() && right->_type->IsPointer()) {
            let pointer = left->_type->IsPointer() ? left : right;
            let index = left->_type->IsPointer() ? right : left;

            if !index->_type->IsIntegerPointer() {
                Logger::Log("Pointer arithmetic requires an operand of pointer-sized type.", node, LogSeverity::Error);
                return null;
            }

            if _operator == TokenType::PLUS {
                return this.arena.New<HIRBinaryExpression>(_operator, left, right, pointer->_type);
            } else if _operator == TokenType::MINUS {
                if left->_type->IsInteger() {
                    Logger::Log("Cannot subtract a pointer from an integer.", node, LogSeverity::Error);
                    return null;
                }

                return this.arena.New<HIRBinaryExpression>(_operator, left, right, pointer->_type);
            } else {
                Logger::Log("Invalid pointer binary operation '" + _operator.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                return null;
            }
        } else if left->_type->IsEnumeration() && right->_type->IsEnumeration() {
            if *left->_type != *right->_type {
                Logger::Log("Incompatible binary operation types. ('" + left->_type->ToString() + "' != '" + right->_type->ToString() + "').", node, LogSeverity::Error);
                return null;
            }

            if _operator == TokenType::BITWISE_AND || _operator == TokenType::BITWISE_OR || _operator == TokenType::BITWISE_XOR {
                return this.arena.New<HIRBinaryExpression>(_operator, left, right, left->_type);
            } else if _operator == TokenType::EQUAL || _operator == TokenType::NOT_EQUAL || _operator == TokenType::GREATER || _operator == TokenType::GREATER_EQUAL || _operator == TokenType::LESS || _operator == TokenType::LESS_EQUAL {
                return this.arena.New<HIRBinaryExpression>(_operator, left, right, this.type_manager.Boolean());
            } else {
                Logger::Log("Invalid binary operation '" + _operator.ToString() + "' for type '" + left->_type->ToString() + "'.", node, LogSeverity::Error);
                return null;
            }
        } else {
            Logger::Log("Invalid type '" + left->_type->ToString() + "' for binary operation '" + _operator.ToString() + "'.", node, LogSeverity::Error);
            return null;
        }
    }

    fn AnalyzeTernary(&mut this, ternary: *TernaryNode, target: *SemanticType) -> *HIRExpression {
        let condition = this.ImplicitDereference(this.AnalyzeExpression(ternary->condition));

        if condition != null && !condition->_type->IsBoolean() {
            Logger::Log("Invalid condition type '" + condition->_type->ToString() + "'.", ternary->condition, LogSeverity::Error);
        }

        let mut then_value = this.AnalyzeExpression(ternary->then);
        if then_value == null { return null; }

        let mut else_value = this.AnalyzeExpression(ternary->_else);
        if else_value == null { return null; }

        this.Materialize(then_value, target != null ? target : else_value->_type);
        this.Materialize(else_value, target != null ? target : then_value->_type);

        let mutable = then_value->mutable && else_value->mutable ? true : false;
        let category = (then_value->category == HIRExpressionCategory::Place && else_value->category == HIRExpressionCategory::Place)
            ? HIRExpressionCategory::Place : HIRExpressionCategory::Value;
        return this.arena.New<HIRTernaryExpression>(condition, then_value, else_value, category, mutable);
    }

    fn AnalyzeStructureInitializer(&mut this, node: *StructureInitializerNode) -> *HIRExpression {
        let symbol = this.scope_manager.Resolve(node->expression, false);
        if symbol == null { return null; }

        if symbol->kind != SymbolKind::Declaration || symbol->declaration->kind != HIRDeclarationKind::Structure {
            Logger::Log("Cannot initialize non-structure type.", node, LogSeverity::Error);
            return null;
        }

        let structure = symbol->declaration as *HIRStructureDeclaration;
        let mut values = Vector<*HIRExpression>();

        for field_value in node->field_values {
            let value = this.AnalyzeExpression(field_value);
            if value == null { return null; }
            values.PushBack(value);
        }

        return this.arena.New<HIRStructureLiteral>(structure, values);
    }

    pub fn ResolveType(&mut this, _type: *Node) -> *SemanticType {
        if _type->_type == NodeType::PRIMITIVE_TYPE {
            let primitive_type = _type as *PrimitiveTypeNode;

            if primitive_type->name == "void" {
                return this.type_manager.Void();
            } else if primitive_type->name == "bool" {
                return this.type_manager.Boolean();
            } else if primitive_type->name == "char" {
                return this.type_manager.Character();
            } else if primitive_type->name.StartsWith('i') || primitive_type->name.StartsWith('u') {
                let specifier = primitive_type->name.SubString(1);
                let signed = primitive_type->name[0] != 'u';

                if specifier == "size" {
                    return this.type_manager.IntegerPointer(signed);
                } else {
                    let width = specifier.ToUnsignedInteger() as u32;

                    if width != 8 && width != 16 && width != 32 && width != 64 && width != 128 {
                        Logger::Log("Invalid integer type '" + primitive_type->name + "'.", _type, LogSeverity::Error);
                        return null;
                    }

                    return this.type_manager.Integer(width, signed);
                }
            } else if primitive_type->name.StartsWith('f') {
                let width = primitive_type->name.SubString(1).ToUnsignedInteger() as u32;

                if width != 32 && width != 64 {
                    Logger::Log("Invalid float type '" + primitive_type->name + "'.", _type, LogSeverity::Error);
                    return null;
                }

                return this.type_manager.Float(width);
            } else {
                if this.scope_manager.Has(primitive_type->name, SymbolKind::Type) {
                    return this.scope_manager.Get(primitive_type->name, SymbolKind::Type)->_type;
                } else if this.scope_manager.Has(primitive_type->name, SymbolKind::Declaration) {
                    for symbol in this.scope_manager.GetAll(primitive_type->name, SymbolKind::Declaration) {
                        let declaration = symbol->declaration;

                        if declaration->kind == HIRDeclarationKind::Class || declaration->kind == HIRDeclarationKind::Structure || declaration->kind == HIRDeclarationKind::Variant {
                            return declaration->_type;
                        }
                    }
                } else if this.scope_manager.Has(primitive_type->name, SymbolKind::Generic) {
                    Logger::Log("Generic type '" + primitive_type->name + "' requires parameters.", _type, LogSeverity::Error);
                    return null;
                }

                Logger::Log("Type '" + primitive_type->name + "' not found.", _type, LogSeverity::Error);
                return null;
            }
        } else if _type->_type == NodeType::TYPE_APPLICATION {
            let type_application = _type as *TypeApplicationNode;
            let mut types = Vector<*SemanticType>();

            for type_ in type_application->types {
                let resolved = this.ResolveType(type_);
                if resolved == null { return null; }
                types.PushBack(resolved);
            }

            if type_application->expression->_type == NodeType::PRIMITIVE_TYPE {
                let primitive_type = type_application->expression as *PrimitiveTypeNode;

                if this.scope_manager.Has(primitive_type->name, SymbolKind::Generic) {
                    let declaration = this.scope_manager.Get(primitive_type->name, SymbolKind::Generic)->generic->Get(types).left;

                    if declaration->kind == HIRDeclarationKind::Class || declaration->kind == HIRDeclarationKind::Structure || declaration->kind == HIRDeclarationKind::Variant {
                        return declaration->_type;
                    } else {
                        Logger::Log("Generic '" + primitive_type->name + "' is not a type.", _type, LogSeverity::Error);
                        return null;
                    }
                } else {
                    if this.scope_manager.Has(primitive_type->name) {
                        Logger::Log("Type '" + primitive_type->name + "' is not a generic.", _type, LogSeverity::Error);
                    } else {
                        Logger::Log("Type '" + primitive_type->name + "' not found.", _type, LogSeverity::Error);
                    } return null;
                }
            } else {
                Logger::Log("Invalid type application.", _type, LogSeverity::Error);
                return null;
            }
        } else if _type->_type == NodeType::POINTER_TYPE {
            let pointer_type = _type as *PointerTypeNode;
            let base_type = this.ResolveType(pointer_type->base_type);
            if base_type == null { return null; }
            return this.type_manager.Pointer(base_type, pointer_type->mutable);
        } else if _type->_type == NodeType::REFERENCE_TYPE {
            let reference_type = _type as *ReferenceTypeNode;
            let base_type = this.ResolveType(reference_type->base_type);
            if base_type == null { return null; }
            return this.type_manager.Reference(base_type, reference_type->mutable);
        } else if _type->_type == NodeType::ARRAY_TYPE {
            let array_type = _type as *ArrayTypeNode;
            let element_type = this.ResolveType(array_type->element_type);
            if element_type == null { return null; }
            return this.type_manager.Pointer(element_type, true);
        } else if _type->_type == NodeType::FUNCTION_TYPE {
            let function_type = _type as *FunctionTypeNode;
            let return_type = this.ResolveType(function_type->return_type);
            if return_type == null { return null; }
            let mut param_types = Vector<*SemanticType>();

            for parameter in function_type->parameters {
                let param_type = this.ResolveType(parameter->_type);
                if param_type == null { return null; }
                param_types.PushBack(param_type);
            }

            return this.type_manager.Function(param_types, return_type);
        } else {
            Logger::Log("Unknown type '" + _type->_type.ToString() + "'.", _type, LogSeverity::Error);
            return null;
        }
    }
}

static mut analyzer: *mut SemanticAnalyzer = null;
