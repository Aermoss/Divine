#[include "std/mem" : *]

class Vector<T> {
    priv data: *mut T = null,
    priv capacity: u64 = 0u64,
    priv size: u64 = 0u64;

    Vector(&mut this) {}

    Vector(&mut this, other: &Vector<T>) {
        if other.data == null { ret; }
        this.Allocate(other.capacity);

        for i in 0u64..other.size {
            this.data[i] = other.data[i];
        } this.size = other.size;
    }

    ~Vector(&mut this) {
        this.Release();
    }

    pub Data(&this) -> *const T { ret this.data; }
    pub Front(&this) -> &mut T { ret this.data[0u64]; }
    pub Back(&this) -> &mut T { ret this.data[this.size - 1u64]; }
    pub Empty(&this) -> bool { ret this.size == 0u64; }
    pub Size(&this) -> u64 { ret this.size; }

    priv Allocate(&mut this, capacity: u64) {
        (this.data, this.capacity) = (new T[capacity], capacity);
    }

    priv Release(&mut this) {
        if this.data != null { del[] this.data; }
        (this.data, this.capacity, this.size) = (null, 0u64, 0u64);
    }

    pub Clear(&mut this) {
        this.Release();
    }

    pub Reserve(&mut this, capacity: u64) {
        if capacity > this.capacity {
            let temp: *const T = this.data;
            this.Allocate(capacity);

            if temp != null {
                for i in 0u64..this.size {
                    this.data[i] = temp[i];
                } del[] temp;
            }
        }
    }

    pub Resize(&mut this, size: u64) {
        if size > this.size {
            this.Reserve(size);
        } this.size = size;
    }

    pub Shrink(&mut this) {
        if this.size < this.capacity {
            let temp: *const T = this.data;
            let size: u64 = this.size;
            this.Allocate(size);

            if temp != null {
                for i in 0u64..size {
                    this.data[i] = temp[i];
                } del[] temp;
            } this.size = size;
        }
    }

    pub Swap(&mut this, other: &mut Vector<T>) {
        let (data: *mut T, capacity: u64, size: u64) = (this.data, this.capacity, this.size);
        (this.data, this.capacity, this.size) = (other.data, other.capacity, other.size);
        (other.data, other.capacity, other.size) = (data, capacity, size);
    }

    pub Reverse(&mut this) -> &mut Vector<T> {
        if this.size > 1u64 {
            for i in 0u64..(this.size / 2u64) {
                let temp: T = this.data[i];
                let j: u64 = this.size - 1u64 - i;
                this.data[i] = this.data[j];
                this.data[j] = temp;
            }
        } ret this;
    }

    pub PushBack(&mut this, value: T) {
        if this.capacity < this.size + 1u64 {
            this.Reserve(this.capacity != 0u64 ? this.capacity * 2u64 : 1u64);
        }

        this.data[this.size] = value;
        this.size += 1u64;
    }

    pub PopBack(&mut this) -> T {
        this.size -= 1u64;
        ret this.data[this.size];
    }

    pub Insert(&mut this, index: u64, value: T) {
        if this.capacity < this.size + 1u64 {
            this.Reserve(this.capacity != 0u64 ? this.capacity * 2u64 : 1u64);
        }

        for offset in 0u64..(this.size - index) {
            let i: u64 = this.size - offset;
            this.data[i] = this.data[i - 1u64];
        }

        this.data[index] = value;
        this.size += 1u64;
    }

    pub RemoveAt(&mut this, index: u64) -> T {
        let temp: T = this.data[index];

        for i in (index + 1u64)..this.size {
            this.data[i - 1u64] = this.data[i];
        }

        this.size -= 1u64;
        ret temp;
    }

    pub Remove(&mut this, value: T) {
        let mut write_index: u64 = 0u64;

        for read_index in 0u64..this.size {
            if this.data[read_index] != value {
                if read_index != write_index {
                    this.data[write_index] = this.data[read_index];
                } write_index += 1u64;
            }
        } this.size = write_index;
    }

    pub Contains(&this, value: T) -> bool {
        for i in 0u64..this.size {
            if this.data[i] == value {
                ret true;
            }
        } ret false;
    }

    pub Index(&this, value: T) -> i64 {
        for i in 0u64..this.size {
            if this.data[i] == value {
                ret i as i64;
            }
        } ret -1i64;
    }

    pub op+(&this, other: &Vector<T>) -> Vector<T> {
        let mut result: Vector<T>;
        result.Resize(this.size + other.size);

        for i in 0u64..this.size {
            result.data[i] = this.data[i];
        }

        for i in 0u64..other.size {
            result.data[this.size + i] = other.data[i];
        } ret result;
    }

    pub op+=(&mut this, other: &Vector<T>) -> &mut Vector<T> {
        let old_size: u64 = this.size;
        this.Resize(this.size + other.size);

        for i in 0u64..other.size {
            this.data[old_size + i] = other.data[i];
        } ret this;
    }

    pub op=(&mut this, other: &Vector<T>) -> &mut Vector<T> {
        this.Release();
        if other.data == null { ret this; }
        this.Allocate(other.capacity);

        for i in 0u64..other.size {
            this.data[i] = other.data[i];
        }

        this.size = other.size;
        ret this;
    }

    pub op[](&this, index: u64) -> &mut T {
        ret this.data[index];
    }

    pub Begin(&this) -> *mut T {
        ret this.data;
    }

    pub End(&this) -> *mut T {
        ret this.data + this.size;
    }
}