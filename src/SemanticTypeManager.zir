#[include "std/io", "std/str", "std/vec", "src/SemanticTypes.zir" : *]

class SemanticTypeManager {
    types: Vector<*SemanticType>,
    void_type: *SemanticType = null,
    bool_type: *SemanticType = null,
    char_type: *SemanticType = null,
    integer_literal_type: *SemanticType = null,
    float_literal_type: *SemanticType = null,
    signed_types: Map<u32, *SemanticType>,
    unsigned_types: Map<u32, *SemanticType>,
    size_types: Map<bool, *SemanticType>,
    float_types: Map<u32, *SemanticType>,
    pointer_types: Map<u64, *SemanticType>,
    reference_types: Map<u64, *SemanticType>;

    ~SemanticTypeManager(&mut this) {
        WriteLine("Disposing " + String::FromInteger(this.types.Size() as u64) + " types (" + String::FromFloat((this.types.Size() * sizeof(SemanticType)) as f64 / 1024.0 / 1024.0) + " MB)...");

        for _type in this.types {
            delete _type;
        }
    }

    pub fn Void(&mut this) -> *SemanticType {
        if this.void_type == null {
            this.void_type = new SemanticType(SemanticTypeKind::Void);
            this.types.PushBack(this.void_type);
        } return this.void_type;
    }

    pub fn Boolean(&mut this) -> *SemanticType {
        if this.bool_type != null {
            return this.bool_type;
        } else {
            let _type = new SemanticType(SemanticTypeKind::Boolean);
            this.types.PushBack(_type);
            (this.bool_type, _type->width) = (_type, 1);
            return _type;
        }
    }

    pub fn Character(&mut this) -> *SemanticType {
        if this.char_type != null {
            return this.char_type;
        } else {
            let _type = new SemanticType(SemanticTypeKind::Character);
            this.types.PushBack(_type);
            (this.char_type, _type->width) = (_type, 32);
            return _type;
        }
    }

    pub fn Integer(&mut this, width: u32, signed: bool) -> *SemanticType {
        if signed && this.signed_types.Has(width) {
            return this.signed_types[width];
        } else if !signed && this.unsigned_types.Has(width) {
            return this.unsigned_types[width];
        } else {
            let _type = new SemanticType(SemanticTypeKind::Integer);
            this.types.PushBack(_type);
            (_type->width, _type->signed) = (width, signed);

            if signed {
                this.signed_types[width] = _type;
            } else {
                this.unsigned_types[width] = _type;
            } return _type;
        }
    }

    pub fn IntegerPointer(&mut this, signed: bool) -> *SemanticType {
        if this.size_types.Has(signed) {
            return this.size_types[signed];
        } else {
            let _type = new SemanticType(SemanticTypeKind::Integer);
            this.types.PushBack(_type);
            (this.size_types[signed], _type->signed) = (_type, signed);
            return _type;
        }
    }

    pub fn IntegerLiteral(&mut this) -> *SemanticType {
        if this.integer_literal_type != null {
            return this.integer_literal_type;
        } else {
            let _type = new SemanticType(SemanticTypeKind::IntegerLiteral);
            this.types.PushBack(_type);
            (this.integer_literal_type, _type->width, _type->signed) = (_type, 32, true);
            return _type;
        }
    }

    pub fn Float(&mut this, width: u32) -> *SemanticType {
        if this.float_types.Has(width) {
            return this.float_types[width];
        } else {
            let _type = new SemanticType(SemanticTypeKind::Float);
            this.types.PushBack(_type);
            (this.float_types[width], _type->width) = (_type, width);
            return _type;
        }
    }

    pub fn FloatLiteral(&mut this) -> *SemanticType {
        if this.float_literal_type != null {
            return this.float_literal_type;
        } else {
            let _type = new SemanticType(SemanticTypeKind::FloatLiteral);
            this.types.PushBack(_type);
            (this.float_literal_type, _type->width) = (_type, 64);
            return _type;
        }
    }

    pub fn Function(&mut this, params: &Vector<*SemanticType>, _return: *SemanticType) -> *mut SemanticType {
        let _type = new SemanticType(SemanticTypeKind::Function);
        this.types.PushBack(_type);
        (_type->params, _type->_return) = (params, _return);
        return _type;
    }

    pub fn Function(&mut this, params: &Vector<*SemanticType>, _return: *SemanticType, name: &String) -> *mut SemanticType {
        let _type = new SemanticType(SemanticTypeKind::Function);
        this.types.PushBack(_type);
        (_type->params, _type->_return, _type->name) = (params, _return, name);
        return _type;
    }

    pub fn Class(&mut this, name: &String) -> *mut SemanticType {
        let _type = new SemanticType(SemanticTypeKind::Class);
        this.types.PushBack(_type);
        _type->name = name;
        return _type;
    }

    pub fn Structure(&mut this, name: &String) -> *mut SemanticType {
        let _type = new SemanticType(SemanticTypeKind::Structure);
        this.types.PushBack(_type);
        _type->name = name;
        return _type;
    }

    pub fn Enumeration(&mut this, name: &String, underlying_type: *SemanticType) -> *SemanticType {
        let _type = new SemanticType(SemanticTypeKind::Enumeration);
        this.types.PushBack(_type);
        (_type->width, _type->signed, _type->name) = (underlying_type->width, underlying_type->signed, name);
        return _type;
    }

    pub fn Variant(&mut this, name: &String) -> *mut SemanticType {
        let _type = new SemanticType(SemanticTypeKind::Variant);
        this.types.PushBack(_type);
        _type->name = name;
        return _type;
    }

    pub fn Pointer(&mut this, pointee: *SemanticType, mutable: bool) -> *SemanticType {
        let key = (pointee as u64) ^ (mutable ? 1 : 0);

        if this.pointer_types.Has(key) {
            return this.pointer_types[key];
        } else {
            let _type = new SemanticType(SemanticTypeKind::Pointer);
            this.types.PushBack(_type);
            (this.pointer_types[key], _type->mutable, _type->pointee) = (_type, mutable, pointee);
            return _type;
        }
    }

    pub fn NullPointer(&mut this) -> *SemanticType {
        return this.Pointer(this.Void(), false);
    }

    pub fn Reference(&mut this, pointee: *SemanticType, mutable: bool) -> *SemanticType {
        let key = (pointee as u64) ^ (mutable ? 1 : 0);

        if this.reference_types.Has(key) {
            return this.reference_types[key];
        } else {
            let _type = new SemanticType(SemanticTypeKind::Reference);
            this.types.PushBack(_type);
            (this.reference_types[key], _type->mutable, _type->pointee) = (_type, mutable, pointee);
            return _type;
        }
    }

    pub fn Array(&mut this, pointee: *SemanticType, length: usize, mutable: bool) -> *SemanticType {
        let _type = new SemanticType(SemanticTypeKind::Array);
        this.types.PushBack(_type);
        (_type->mutable, _type->length, _type->pointee) = (mutable, length, pointee);
        return _type;
    }
}
