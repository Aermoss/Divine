class GLFWmonitor {}
class GLFWwindow {}
class GLFWcursor {}

type GLFWglproc = func();

type GLFWallocatefun = func(size: u32, user: *mut void) -> *mut void;
type GLFWreallocatefun = func(block: *mut void, size: u32, user: *mut void) -> *mut void;
type GLFWdeallocatefun = func(block: *mut void, user: *mut void);

type GLFWerrorfun = func(error_code: i32, description: *i8);
type GLFWwindowposfun = func(window: *GLFWwindow, xpos: i32, ypos: i32);
type GLFWwindowsizefun = func(window: *GLFWwindow, width: i32, height: i32);
type GLFWwindowclosefun = func(window: *GLFWwindow);
type GLFWwindowrefreshfun = func(window: *GLFWwindow);
type GLFWwindowfocusfun = func(window: *GLFWwindow, focused: i32);
type GLFWwindowiconifyfun = func(window: *GLFWwindow, iconified: i32);
type GLFWwindowmaximizefun = func(window: *GLFWwindow, maximized: i32);
type GLFWframebuffersizefun = func(window: *GLFWwindow, width: i32, height: i32);
type GLFWwindowcontentscalefun = func(window: *GLFWwindow, xscale: f32, yscale: f32);
type GLFWmousebuttonfun = func(window: *GLFWwindow, button: i32, action: i32, mods: i32);
type GLFWcursorposfun = func(window: *GLFWwindow, xpos: f64, ypos: f64);
type GLFWcursorenterfun = func(window: *GLFWwindow, entered: i32);
type GLFWscrollfun = func(window: *GLFWwindow, xoffset: f64, yoffset: f64);
type GLFWkeyfun = func(window: *GLFWwindow, key: i32, scancode: i32, action: i32, mods: i32);
type GLFWcharfun = func(window: *GLFWwindow, codepoint: u32);
type GLFWcharmodsfun = func(window: *GLFWwindow, codepoint: u32, mods: i32);
type GLFWdropfun = func(window: *GLFWwindow, path_count: i32, paths: **i8);
type GLFWmonitorfun = func(monitor: *GLFWcursor, event: i32);
type GLFWjoystickfun = func(jid: i32, event: i32);

