#[include "std/str", "std/vec", "std/map", "std/pair", "vendor/llvm-c/Core.zir", "vendor/llvm-c/Analysis.zir",
    "src/Target.zir", "src/Tokens.zir", "src/Nodes.zir", "src/Logger.zir" : *]

class CodeGenerator {
    module: LLVMModuleRef = null,
    builder: LLVMBuilderRef = null,
    context: LLVMContextRef,
    target: *Target,

    freestanding: bool,
    no_red_zone: bool;

    CodeGenerator(&mut this, target: &Target, freestanding: bool, no_red_zone: bool) {
        (this.freestanding, this.no_red_zone) = (freestanding, no_red_zone);
        (this.context, this.target) = (LLVMContextCreate(), target);
    }

    ~CodeGenerator(&mut this) {
        if this.builder != null {
            LLVMDisposeBuilder(this.builder);
            this.builder = null;
        }

        if this.module != null {
            LLVMDisposeModule(this.module);
            this.module = null;
        }

        LLVMContextDispose(this.context);
    }

    pub fn Generate(&mut this, root: *RootNode, file_name: &String) -> LLVMModuleRef {
        if this.builder != null {
            LLVMDisposeBuilder(this.builder);
            this.builder = null;
        }

        if this.module != null {
            LLVMDisposeModule(this.module);
            this.module = null;
        }

        this.module = LLVMModuleCreateWithNameInContext("zircon", this.context);
        this.builder = LLVMCreateBuilderInContext(this.context);
        LLVMSetSourceFileName(this.module, file_name.Data(), file_name.Length());
        LLVMSetModuleDataLayout(this.module, this.target->layout);
        LLVMSetTarget(this.module, this.target->triple.Data());
        let mut message: *mut i8 = null;

        if LLVMVerifyModule(this.module, LLVMVerifierFailureAction::LLVMReturnStatusAction, &mut message) != 0 {
            let final_message = message != null ? message : "Unknown reason.";
            Logger::Log(file_name, "Module verification failed: " + final_message.ToString(), LogSeverity::Error);

            if message != null {
                LLVMDisposeMessage(message);
            } return null;
        }

        if message != null {
            LLVMDisposeMessage(message);
        } return this.module;
    }

    fn GenerateConstant(&mut this, constant: *ConstantNode) {

    }

    fn GenerateStatic(&mut this, _static: *StaticNode) {

    }

    fn GenerateFunction(&mut this, function: *FunctionNode) {

    }

    fn GenerateClass(&mut this, _class: *ClassNode) {

    }

    fn GenerateStructure(&mut this, structure: *StructureNode) {

    }

    fn GenerateEnumeration(&mut this, enumeration: *EnumerationNode) {

    }

    fn GenerateVariant(&mut this, enumeration: *EnumerationNode) {

    }

    fn GenerateAssembly(&mut this, assembly: *AssemblyNode) {

    }

    fn GenerateStatement(&mut this, statement: *Node) {
        if statement->_type == NodeType::RETURN {
            this.GenerateReturn(statement as *ReturnNode);
        } else if statement->_type == NodeType::EXPRESSION {
            this.GenerateExpression((statement as *ExpressionNode)->expression);
        } else if statement->_type == NodeType::IF {
            this.GenerateIf(statement as *IfNode);
        } else if statement->_type == NodeType::IF_LET {
            this.GenerateIfLet(statement as *IfLetNode);
        } else if statement->_type == NodeType::WHILE {
            this.GenerateWhile(statement as *WhileNode);
        } else if statement->_type == NodeType::WHILE_LET {
            this.GenerateWhileLet(statement as *WhileLetNode);
        } else if statement->_type == NodeType::FOR {
            this.GenerateFor(statement as *ForNode);
        } else if statement->_type == NodeType::LOOP {
            this.GenerateLoop(statement as *LoopNode);
        } else if statement->_type == NodeType::MATCH {
            this.GenerateMatch(statement as *MatchNode);
        } else if statement->_type == NodeType::UNSAFE {
            this.GenerateUnsafe(statement as *UnsafeNode);
        } else if statement->_type == NodeType::BLOCK {
            this.GenerateBlock(statement as *BlockNode);
        } else if statement->_type == NodeType::CONTINUE {
            this.GenerateContinue(statement as *ContinueNode);
        } else if statement->_type == NodeType::BREAK {
            this.GenerateBreak(statement as *BreakNode);
        } else if statement->_type == NodeType::VARIABLE {
            this.GenerateVariable(statement as *VariableNode);
        } else if statement->_type == NodeType::ASSIGNMENT {
            this.GenerateAssignment(statement as *AssignmentNode);
        } else if statement->_type == NodeType::ASSEMBLY {
            this.GenerateAssembly(statement as *AssemblyNode);
        } else {
            Logger::Log("Unknown statement '" + statement->_type.ToString() + "'.", statement, LogSeverity::Error);
        }
    }

    fn GenerateReturn(&mut this, _return: *ReturnNode) {

    }

    fn GenerateIf(&mut this, _if: *IfNode) {

    }

    fn GenerateIfLet(&mut this, if_let: *IfLetNode) {

    }

    fn GenerateWhile(&mut this, _while: *WhileNode) {

    }

    fn GenerateWhileLet(&mut this, while_let: *WhileLetNode) {

    }

    fn GenerateFor(&mut this, _for: *ForNode) {

    }

    fn GenerateLoop(&mut this, _loop: *LoopNode) {

    }

    fn GenerateContinue(&this, _continue: *ContinueNode) {

    }

    fn GenerateBreak(&this, _break: *BreakNode) {

    }

    fn GenerateMatch(&mut this, _match: *MatchNode) {

    }

    fn GenerateUnsafe(&mut this, _unsafe: *UnsafeNode) {

    }

    fn GenerateBlock(&mut this, block: *BlockNode) {

    }

    fn GenerateVariable(&mut this, variable: *VariableNode) {

    }

    fn GenerateAssignment(&mut this, assignment: *AssignmentNode) {

    }

    fn GenerateExpression(&mut this, expression: *Node) -> LLVMValueRef {

    }

    fn GenerateLiteral(&mut this, literal: *LiteralNode) -> LLVMValueRef {

    }

    fn GenerateCall(&mut this, call: *CallNode) -> LLVMValueRef {

    }

    fn GenerateNew(&mut this, _new: *NewNode) -> LLVMValueRef {

    }

    fn GenerateDelete(&mut this, _delete: *DeleteNode) -> LLVMValueRef {

    }

    fn GenerateCast(&mut this, cast: *CastNode) -> LLVMValueRef {

    }

    fn GenerateIndexAccess(&mut this, index_access: *IndexAccessNode) -> LLVMValueRef {

    }

    fn GenerateMemberAccess(&mut this, member_access: *MemberAccessNode) -> LLVMValueRef {

