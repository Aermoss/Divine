include "divray" : *;

class GuiStyleProp {
    pub controlId: u16,
    pub propertyId: u16,
    pub propertyValue: i32
}

enum GuiState: i32 {
    STATE_NORMAL = 0i32,
    STATE_FOCUSED,
    STATE_PRESSED,
    STATE_DISABLED
}

enum GuiTextAlignment: i32 {
    TEXT_ALIGN_LEFT = 0i32,
    TEXT_ALIGN_CENTER,
    TEXT_ALIGN_RIGHT
}

enum GuiTextAlignmentVertical: i32 {
    TEXT_ALIGN_TOP = 0i32,
    TEXT_ALIGN_MIDDLE,
    TEXT_ALIGN_BOTTOM
}

enum GuiTextWrapMode: i32 {
    TEXT_WRAP_NONE = 0i32,
    TEXT_WRAP_CHAR,
    TEXT_WRAP_WORD
}

enum GuiControl: i32 {
    DEFAULT = 0i32,
    LABEL,
    BUTTON,
    TOGGLE,
    SLIDER,
    PROGRESSBAR,
    CHECKBOX,
    COMBOBOX,
    DROPDOWNBOX,
    TEXTBOX,
    VALUEBOX,
    CONTROL11,
    LISTVIEW,
    COLORPICKER,
    SCROLLBAR,
    STATUSBAR
}

enum GuiControlProperty: i32 {
    BORDER_COLOR_NORMAL = 0i32,
    BASE_COLOR_NORMAL,
    TEXT_COLOR_NORMAL,
    BORDER_COLOR_FOCUSED,
    BASE_COLOR_FOCUSED,
    TEXT_COLOR_FOCUSED,
    BORDER_COLOR_PRESSED,
    BASE_COLOR_PRESSED,
    TEXT_COLOR_PRESSED,
    BORDER_COLOR_DISABLED,
    BASE_COLOR_DISABLED,
    TEXT_COLOR_DISABLED,
    BORDER_WIDTH = 12i32,
    TEXT_PADDING = 13i32,
    TEXT_ALIGNMENT = 14i32
}

enum GuiDefaultProperty: i32 {
    TEXT_SIZE = 16i32,
    TEXT_SPACING,
    LINE_COLOR,
    BACKGROUND_COLOR,
    TEXT_LINE_SPACING,
    TEXT_ALIGNMENT_VERTICAL,
    TEXT_WRAP_MODE
}

enum GuiToggleProperty: i32 {
    GROUP_PADDING = 16i32
}

enum GuiSliderProperty: i32 {
    SLIDER_WIDTH = 16i32,
    SLIDER_PADDING
}

enum GuiProgressBarProperty: i32{
    PROGRESS_PADDING = 16i32
}

enum GuiScrollBarProperty: i32 {
    ARROWS_SIZE = 16i32,
    ARROWS_VISIBLE,
    SCROLL_SLIDER_PADDING,
    SCROLL_SLIDER_SIZE,
    SCROLL_PADDING,
    SCROLL_SPEED
}

enum GuiCheckBoxProperty: i32 {
    CHECK_PADDING = 16i32
}

enum GuiComboBoxProperty: i32 {
    COMBO_BUTTON_WIDTH = 16i32,
    COMBO_BUTTON_SPACING
}

enum GuiDropdownBoxProperty: i32 {
    ARROW_PADDING = 16i32,
    DROPDOWN_ITEMS_SPACING,
    DROPDOWN_ARROW_HIDDEN,
    DROPDOWN_ROLL_UP
}

enum GuiTextBoxProperty: i32 {
    TEXT_READONLY = 16i32
}

enum GuiValueBoxProperty: i32 {
    SPINNER_BUTTON_WIDTH = 16i32,
    SPINNER_BUTTON_SPACING
}

enum GuiListViewProperty: i32 {
    LIST_ITEMS_HEIGHT = 16i32,
    LIST_ITEMS_SPACING,
    SCROLLBAR_WIDTH,
    SCROLLBAR_SIDE,
    LIST_ITEMS_BORDER_NORMAL,
    LIST_ITEMS_BORDER_WIDTH
}

enum GuiColorPickerProperty: i32 {
    COLOR_SELECTOR_SIZE = 16i32,
    HUEBAR_WIDTH,
    HUEBAR_PADDING,
    HUEBAR_SELECTOR_HEIGHT,
    HUEBAR_SELECTOR_OVERFLOW
}

const SCROLLBAR_LEFT_SIDE: i32 = 0i32;
const SCROLLBAR_RIGHT_SIDE: i32 = 1i32;

extern "C" {
    func GuiEnable();
    func GuiDisable();
    func GuiLock();
    func GuiUnlock();
    func GuiIsLocked() -> bool;
    func GuiSetAlpha(alpha: f32);
    func GuiSetState(state: i32);
    func GuiGetState() -> i32;

    func GuiSetFont(font: Font);
    func GuiGetFont() -> Font;

    func GuiSetStyle(control: i32, property: i32, value: i32);
    func GuiGetStyle(control: i32, property: i32) -> i32;

    func GuiLoadStyle(fileName: *const i8);
    func GuiLoadStyleDefault();

    func GuiEnableTooltip();
    func GuiDisableTooltip();
    func GuiSetTooltip(tooltip: *const i8);

    func GuiIconText(iconId: i32, text: *const i8) -> *const i8;
    func GuiSetIconScale(scale: i32);
    func GuiGetIcons() -> *mut u32;
    func GuiLoadIcons(fileName: *const i8, loadIconsName: bool) -> *mut *const i8;
    func GuiDrawIcon(iconId: i32, posX: i32, posY: i32, pixelSize: i32, color: Color);

    func GuiGetTextWidth(text: *const i8) -> i32;

    func GuiWindowBox(bounds: Rectangle, title: *const i8) -> i32;
    func GuiGroupBox(bounds: Rectangle, text: *const i8) -> i32;
    func GuiLine(bounds: Rectangle, text: *const i8) -> i32;
    func GuiPanel(bounds: Rectangle, text: *const i8) -> i32;
    func GuiTabBar(bounds: Rectangle, text: *const i8, count: i32, active: *mut i32) -> i32;
    func GuiScrollPanel(bounds: Rectangle, text: *const i8, content: Rectangle, scroll: *mut Vector2, view: *mut Rectangle) -> i32;

    func GuiLabel(bounds: Rectangle, text: *const i8) -> i32;
    func GuiButton(bounds: Rectangle, text: *const i8) -> i32;
    func GuiLabelButton(bounds: Rectangle, text: *const i8) -> i32;
    func GuiToggle(bounds: Rectangle, text: *const i8, active: *mut bool) -> i32;
    func GuiToggleGroup(bounds: Rectangle, text: *const i8, active: *mut i32) -> i32;
    func GuiToggleSlider(bounds: Rectangle, text: *const i8, active: *mut i32) -> i32;
    func GuiCheckBox(bounds: Rectangle, text: *const i8, checked: *mut bool) -> i32;
    func GuiComboBox(bounds: Rectangle, text: *const i8, active: *mut i32) -> i32;

    func GuiDropdownBox(bounds: Rectangle, text: *const i8, active: *mut i32, editMode: bool) -> i32;
    func GuiSpinner(bounds: Rectangle, text: *const i8, value: *mut i32, minValue: i32, maxValue: i32, editMode: bool) -> i32;
    func GuiValueBox(bounds: Rectangle, text: *const i8, value: *mut i32, minValue: i32, maxValue: i32, editMode: bool) -> i32;
    func GuiValueBoxFloat(bounds: Rectangle, text: *const i8, textValue: *mut i8, value: *mut f32, editMode: bool) -> i32;
    func GuiTextBox(bounds: Rectangle, text: *mut i8, textSize: i32, editMode: bool) -> i32;

    func GuiSlider(bounds: Rectangle, textLeft: *const i8, textRight: *const i8, value: *mut f32, minValue: f32, maxValue: f32) -> i32;
    func GuiSliderBar(bounds: Rectangle, textLeft: *const i8, textRight: *const i8, value: *mut f32, minValue: f32, maxValue: f32) -> i32;
    func GuiProgressBar(bounds: Rectangle, textLeft: *const i8, textRight: *const i8, value: *mut f32, minValue: f32, maxValue: f32) -> i32;
    func GuiStatusBar(bounds: Rectangle, text: *const i8) -> i32;
    func GuiDummyRec(bounds: Rectangle, text: *const i8) -> i32;
    func GuiGrid(bounds: Rectangle, text: *const i8, spacing: f32, subdivs: i32, mouseCell: *mut Vector2) -> i32;

    func GuiListView(bounds: Rectangle, text: *const i8, scrollIndex: *mut i32, active: *mut i32) -> i32;
    func GuiListViewEx(bounds: Rectangle, text: *const *const i8, count: i32, scrollIndex: *mut i32, active: *mut i32, focus: *mut i32) -> i32;
    func GuiMessageBox(bounds: Rectangle, title: *const i8, message: *const i8, buttons: *const i8) -> i32;
    func GuiTextInputBox(bounds: Rectangle, title: *const i8, message: *const i8, buttons: *const i8, text: *mut i8, textMaxSize: i32, secretViewActive: *mut bool) -> i32;
    func GuiColorPicker(bounds: Rectangle, text: *const i8, color: *mut Color) -> i32;
    func GuiColorPanel(bounds: Rectangle, text: *const i8, color: *mut Color) -> i32;
    func GuiColorBarAlpha(bounds: Rectangle, text: *const i8, alpha: *mut f32) -> i32;
    func GuiColorBarHue(bounds: Rectangle, text: *const i8, value: *mut f32) -> i32;
    func GuiColorPickerHSV(bounds: Rectangle, text: *const i8, colorHsv: *mut Vector3) -> i32;
    func GuiColorPanelHSV(bounds: Rectangle, text: *const i8, colorHsv: *mut Vector3) -> i32;
}

