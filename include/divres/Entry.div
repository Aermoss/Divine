include "divstd", "divio" : *;

enum Result<T, E> {
    Ok(T), Err(E);

    pub IsOk(&this) -> bool {
        match this {
            Result::Ok(_) => ret true,
            Result::Err(_) => ret false
        }
    }

    pub IsErr(&this) -> bool {
        match this {
            Result::Ok(_) => ret false,
            Result::Err(_) => ret true
        }
    }

    pub Unwrap(&this) -> T {
        match this {
            Result::Ok(value) => ret value,
            Result::Err(_) => {
                WriteLine("Panicked: called Unwrap() on an Err value.");
                Exit(1i32);
                loop {}
            }
        }
    }

    pub UnwrapOr(&this, default: T) -> T {
        match this {
            Result::Ok(value) => ret value,
            Result::Err(_) => ret default
        }
    }

    pub UnwrapErr(&this) -> E {
        match this {
            Result::Ok(_) => {
                WriteLine("Panicked: called UnwrapErr() on an Ok value.");
                Exit(1i32);
                loop {}
            },
            Result::Err(err) => ret err
        }
    }
}
