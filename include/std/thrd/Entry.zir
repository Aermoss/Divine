const thrd_success: i32 = 0i32;
const thrd_busy: i32 = 1i32;
const thrd_error: i32 = 2i32;
const thrd_nomem: i32 = 3i32;
const thrd_timedout: i32 = 4i32;

const mtx_plain: i32 = 0i32;
const mtx_timed: i32 = 1i32;
const mtx_recursive: i32 = 2i32;

class timespec {
    pub tv_sec: i64,
    pub tv_nsec: i32
}

class thrd_t {
    pub _Handle: *mut void,
    pub _Tid: u32
}

class mtx_t {
    pub _Type: u64,
    pub _Ptr: *mut void,
    pub _Cv: *mut void,
    pub _Owner: u32,
    pub _Cnt: u32
}

class cnd_t {
    pub _Ptr: *mut void
}

class tss_t {
    pub _Idx: u32
}

class once_flag {
    pub _Opaque: *mut void
}

type thrd_start_t = func(*mut void);
type tss_dtor_t = func(*mut void);

extern "C" {
    func thrd_create(thr: *mut thrd_t, func_ptr: thrd_start_t, arg: *mut void) -> i32;
    func thrd_current() -> thrd_t;
    func thrd_detach(thr: thrd_t) -> i32;
    func thrd_equal(thr0: thrd_t, thr1: thrd_t) -> i32;
    func thrd_exit(res: i32) -> void;
    func thrd_join(thr: thrd_t, res: *mut i32) -> i32;
#[if WINDOWS]
    func Sleep(dwMilliseconds: u32) -> void;
#[else]
    func thrd_sleep(duration: *const timespec, remaining: *mut timespec) -> i32;
#[endif]
    func thrd_yield() -> void;

    func mtx_init(mutex: *mut mtx_t, type_: i32) -> i32;
    func mtx_lock(mutex: *mut mtx_t) -> i32;
    func mtx_timedlock(mutex: *mut mtx_t, time_point: *const timespec) -> i32;
    func mtx_trylock(mutex: *mut mtx_t) -> i32;
    func mtx_unlock(mutex: *mut mtx_t) -> i32;
    func mtx_destroy(mutex: *mut mtx_t) -> void;

    func cnd_init(cond: *mut cnd_t) -> i32;
    func cnd_signal(cond: *mut cnd_t) -> i32;
    func cnd_broadcast(cond: *mut cnd_t) -> i32;
    func cnd_wait(cond: *mut cnd_t, mutex: *mut mtx_t) -> i32;
    func cnd_timedwait(cond: *mut cnd_t, mutex: *mut mtx_t, time_point: *const timespec) -> i32;
    func cnd_destroy(cond: *mut cnd_t) -> void;

    func tss_create(key: *mut tss_t, dtor: tss_dtor_t) -> i32;
    func tss_get(key: tss_t) -> *mut void;
    func tss_set(key: tss_t, val: *mut void) -> i32;
    func tss_delete(key: tss_t) -> void;

    func call_once(flag: *mut once_flag, func_ptr: *mut void) -> void;
}

class Thread {
    priv thread: thrd_t,
    priv joined: bool = false;

    Thread(&mut this, func_ptr: thrd_start_t, arg: *mut void) {
        thrd_create(&this.thread, func_ptr, arg);
    }

    ~Thread(&mut this) {
        if !this.joined {
            this.Detach();
        }
    }

    pub Join(&mut this) -> i32 {
        if !this.joined {
            let mut res: i32 = 0i32;
            let status: i32 = thrd_join(this.thread, &res);
            this.joined = true;
            ret res;
        } ret 0i32;
    }

    pub Detach(&mut this) {
        if !this.joined {
            thrd_detach(this.thread);
            this.joined = true;
        }
    }

    pub GetId(&this) -> u32 {
        ret this.thread._Tid;
    }

    pub Sleep(&this, seconds: i64, nanoseconds: i32) {
#[if WINDOWS]
        Sleep((seconds * 1000i64 + (nanoseconds / 1000000i32) as i64) as u32);
#[else]
        let mut ts: timespec;
        (ts.tv_sec, ts.tv_nsec) = (seconds, nanoseconds);
        thrd_sleep(&ts, null);
#[endif]
    }

    pub Yield() {
        thrd_yield();
    }
}

class Mutex {
    priv mutex: mtx_t;

    Mutex(&mut this) {
        mtx_init(&this.mutex, mtx_plain);
    }

    Mutex(&mut this, _type: i32) {
        mtx_init(&this.mutex, _type);
    }

    ~Mutex(&mut this) {
        mtx_destroy(&this.mutex);
    }

    pub Lock(&mut this) {
        mtx_lock(&this.mutex);
    }

    pub Unlock(&mut this) {
        mtx_unlock(&this.mutex);
    }

    pub TryLock(&mut this) -> bool {
        ret mtx_trylock(&this.mutex) == thrd_success;
    }

    pub Handle(&mut this) -> *mut mtx_t {
        ret &this.mutex;
    }
}

class ScopedLock {
    priv mutex: *mut Mutex;

    ScopedLock(&mut this, mutex: *mut Mutex) {
        this.mutex = mutex;
        this.mutex->Lock();
    }

    ~ScopedLock(&mut this) {
        this.mutex->Unlock();
    }
}

class ConditionVariable {
    priv condition: cnd_t;

    ConditionVariable(&mut this) {
        cnd_init(&this.condition);
    }

    ~ConditionVariable(&mut this) {
        cnd_destroy(&this.condition);
    }

    pub Signal(&mut this) {
        cnd_signal(&this.condition);
    }

    pub Broadcast(&mut this) {
        cnd_broadcast(&this.condition);
    }

    pub Wait(&mut this, mtx: *mut Mutex) {
        cnd_wait(&this.condition, mtx->Handle());
    }
}