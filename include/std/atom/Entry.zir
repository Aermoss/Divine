func AtomicExchange8(target: *mut u8, value: u8) -> u8 {
    let result: u8;

    volatile asm : rdi(target), sil(value) -> {
        lock xchgb %sil, (%rdi)
    } -> sil(result) : memory;

    ret result;
}

func AtomicExchange16(target: *mut i16, value: i16) -> i16 {
    let result: i16;

    volatile asm : rdi(target), si(value) -> {
        lock xchgw %si, (%rdi)
    } -> si(result) : memory;

    ret result;
}

func AtomicExchange32(target: *mut u32, value: u32) -> u32 {
    let result: u32;

    volatile asm : rdi(target), esi(value) -> {
        lock xchgl %esi, (%rdi)
    } -> esi(result) : memory;

    ret result;
}

func AtomicExchange64(target: *mut u64, value: u64) -> u64 {
    let result: u64;

    volatile asm : rdi(target), rsi(value) -> {
        lock xchgq %rsi, (%rdi)
    } -> rsi(result) : memory;

    ret result;
}

func AtomicCompareExchange8(target: *mut u8, expected: u8, desired: u8) -> u8 {
    let result: u8;

    volatile asm : rdi(target), al(expected), sil(desired) -> {
        lock cmpxchgb %sil, (%rdi)
    } -> al(result) : memory;

    ret result;
}

func AtomicCompareExchange16(target: *mut i16, expected: i16, desired: i16) -> i16 {
    let result: i16;

    volatile asm : rdi(target), ax(expected), si(desired) -> {
        lock cmpxchgw %si, (%rdi)
    } -> ax(result) : memory;

    ret result;
}

func AtomicCompareExchange32(target: *mut u32, expected: u32, desired: u32) -> u32 {
    let result: u32;

    volatile asm : rdi(target), eax(expected), esi(desired) -> {
        lock cmpxchgl %esi, (%rdi)
    } -> eax(result) : memory;

    ret result;
}

func AtomicCompareExchange64(target: *mut u64, expected: u64, desired: u64) -> u64 {
    let result: u64;

    volatile asm : rdi(target), rax(expected), rsi(desired) -> {
        lock cmpxchgq %rsi, (%rdi)
    } -> rax(result) : memory;

    ret result;
}

func AtomicCompareExchangeBool8(target: *mut u8, expected: u8, desired: u8) -> bool {
    let result: u8;

    volatile asm : rdi(target), al(expected), sil(desired) -> {
        lock cmpxchgb %sil, (%rdi)
        sete %al
    } -> al(result) : memory;

    ret result != 0u8;
}

func AtomicCompareExchangeBool16(target: *mut i16, expected: i16, desired: i16) -> bool {
    let result: u8;

    volatile asm : rdi(target), ax(expected), si(desired) -> {
        lock cmpxchgw %si, (%rdi)
        sete %al
    } -> al(result) : memory;

    ret result != 0u8;
}

func AtomicCompareExchangeBool32(target: *mut u32, expected: u32, desired: u32) -> bool {
    let result: u8;

    volatile asm : rdi(target), eax(expected), esi(desired) -> {
        lock cmpxchgl %esi, (%rdi)
        sete %al
    } -> al(result) : memory;

    ret result != 0u8;
}

func AtomicCompareExchangeBool64(target: *mut u64, expected: u64, desired: u64) -> bool {
    let result: u8;

    volatile asm : rdi(target), rax(expected), rsi(desired) -> {
        lock cmpxchgq %rsi, (%rdi)
        sete %al
    } -> al(result) : memory;

    ret result != 0u8;
}

func AtomicLoad8(target: *const u8) -> u8 {
    let result: u8;

    volatile asm : rdi(target) -> {
        movb (%rdi), %al
        lfence
    } -> al(result) : memory;

    ret result;
}

func AtomicLoad16(target: *const i16) -> i16 {
    let result: i16;

    volatile asm : rdi(target) -> {
        movw (%rdi), %ax
        lfence
    } -> ax(result) : memory;

    ret result;
}

func AtomicLoad32(target: *const u32) -> u32 {
    let result: u32;

    volatile asm : rdi(target) -> {
        movl (%rdi), %eax
        lfence
    } -> eax(result) : memory;

    ret result;
}

func AtomicLoad64(target: *const u64) -> u64 {
    let result: u64;

    volatile asm : rdi(target) -> {
        movq (%rdi), %rax
        lfence
    } -> rax(result) : memory;

    ret result;
}

func AtomicFetchAdd8(target: *mut u8, value: u8) -> u8 {
    let result: u8;

    volatile asm : rdi(target), al(value) -> {
        lock xaddb %al, (%rdi)
    } -> al(result) : memory;

    ret result;
}

func AtomicFetchAdd16(target: *mut i16, value: i16) -> i16 {
    let result: i16;

    volatile asm : rdi(target), ax(value) -> {
        lock xaddw %ax, (%rdi)
    } -> ax(result) : memory;

    ret result;
}

func AtomicFetchAdd32(target: *mut u32, value: u32) -> u32 {
    let result: u32;

    volatile asm : rdi(target), eax(value) -> {
        lock xaddl %eax, (%rdi)
    } -> eax(result) : memory;

    ret result;
}

func AtomicFetchAdd64(target: *mut u64, value: u64) -> u64 {
    let result: u64;

    volatile asm : rdi(target), rax(value) -> {
        lock xaddq %rax, (%rdi)
    } -> rax(result) : memory;

    ret result;
}

func AtomicFetchSub8(target: *mut u8, value: u8) -> u8 {
    let result: u8;

    volatile asm : rdi(target), al(-(value as i8) as u8) -> {
        lock xaddb %al, (%rdi)
    } -> al(result) : memory;

    ret result;
}

func AtomicFetchSub16(target: *mut i16, value: i16) -> i16 {
    let result: i16;

    volatile asm : rdi(target), ax(-value) -> {
        lock xaddw %ax, (%rdi)
    } -> ax(result) : memory;

    ret result;
}

func AtomicFetchSub32(target: *mut u32, value: u32) -> u32 {
    let result: u32;

    volatile asm : rdi(target), eax(-(value as i32) as u32) -> {
        lock xaddl %eax, (%rdi)
    } -> eax(result) : memory;

    ret result;
}

func AtomicFetchSub64(target: *mut u64, value: u64) -> u64 {
    let result: u64;

    volatile asm : rdi(target), rax(-(value as i64) as u64) -> {
        lock xaddq %rax, (%rdi)
    } -> rax(result) : memory;

    ret result;
}

func AtomicFetchAnd8(target: *mut u8, value: u8) -> u8 {
    let mut old: u8 = AtomicLoad8(target);

    loop {
        if AtomicCompareExchangeBool8(target, old, old & value) {
            break;
        }

        old = AtomicLoad8(target);
        AtomicPause();
    } ret old;
}

func AtomicFetchAnd16(target: *mut i16, value: i16) -> i16 {
    let mut old: i16 = AtomicLoad16(target);

    loop {
        if AtomicCompareExchangeBool16(target, old, old & value) {
