#[include "vendor/clang-c/CXFile.zir", "vendor/clang-c/CXString.zir" : *]

class CXSourceLocation {
    pub ptr_data[2u64]: *const void,
    pub int_data: u32,
}

class CXSourceRange {
    pub ptr_data[2u64]: *const void,
    pub begin_int_data: u32,
    pub end_int_data: u32,
}

class CXSourceRangeList {
    pub count: u32,
    pub ranges: *mut CXSourceRange,
}

extern "C" {
    func clang_getNullLocation() -> CXSourceLocation;
    func clang_equalLocations(loc1: CXSourceLocation, loc2: CXSourceLocation) -> u32;
    func clang_isBeforeInTranslationUnit(loc1: CXSourceLocation, loc2: CXSourceLocation) -> u32;
    func clang_Location_isInSystemHeader(location: CXSourceLocation) -> i32;
    func clang_Location_isFromMainFile(location: CXSourceLocation) -> i32;
    func clang_getNullRange() -> CXSourceRange;
    func clang_getRange(begin: CXSourceLocation, end: CXSourceLocation) -> CXSourceRange;
    func clang_equalRanges(range1: CXSourceRange, range2: CXSourceRange) -> u32;
    func clang_Range_isNull(range: CXSourceRange) -> i32;
    func clang_getExpansionLocation(location: CXSourceLocation, file: *mut CXFile, line: *mut u32, column: *mut u32, offset: *mut u32);
    func clang_getPresumedLocation(location: CXSourceLocation, filename: *mut CXString, line: *mut u32, column: *mut u32);
    func clang_getInstantiationLocation(location: CXSourceLocation, file: *mut CXFile, line: *mut u32, column: *mut u32, offset: *mut u32);
    func clang_getSpellingLocation(location: CXSourceLocation, file: *mut CXFile, line: *mut u32, column: *mut u32, offset: *mut u32);
    func clang_getFileLocation(location: CXSourceLocation, file: *mut CXFile, line: *mut u32, column: *mut u32, offset: *mut u32);
    func clang_getRangeStart(range: CXSourceRange) -> CXSourceLocation;
    func clang_getRangeEnd(range: CXSourceRange) -> CXSourceLocation;
    func clang_disposeSourceRangeList(ranges: *mut CXSourceRangeList);
}
