const LLVMErrorSuccess: i32 = 0;

struct LLVMOpaqueError {}

type LLVMErrorRef = *mut LLVMOpaqueError;
type LLVMErrorTypeId = *void;

extern "C" {
    fn LLVMGetErrorTypeId(Err: LLVMErrorRef) -> LLVMErrorTypeId;
    fn LLVMConsumeError(Err: LLVMErrorRef);
    fn LLVMCantFail(Err: LLVMErrorRef);
    fn LLVMGetErrorMessage(Err: LLVMErrorRef) -> *mut i8;
    fn LLVMDisposeErrorMessage(ErrMsg: *mut i8);
    fn LLVMGetStringErrorTypeId() -> LLVMErrorTypeId;
    fn LLVMCreateStringError(ErrMsg: *i8) -> LLVMErrorRef;
}
