#[include "std/str", "std/vec", "src/Scope.zir", "src/Symbol.zir", "src/Types.zir", "src/AST.zir", "src/HIR.zir" : *]

enum LookupStatus: u8 {
    NotFound, Found, Invalid
}

class LookupResult {
    pub symbols: Vector<*Symbol>,
    pub scope: *Scope,
    pub status: LookupStatus;

    LookupResult(&mut this, symbols: Vector<*Symbol>, scope: *Scope, status: LookupStatus) {
        (this.symbols, this.scope, this.status) = (symbols, scope, status);
    }
}

class ScopeManager {
    pub scopes: Vector<*Scope>,
    pub current: *mut Scope = null;

    ScopeManager(&mut this) {
        this.PushScope(String("global"), true);
    }

    ~ScopeManager(&mut this) {
        this.PopScope();
    }

    pub fn PushScope(&mut this, name: &String, global: bool) {
        let scope = new Scope(this.current, name, global);

        if global {
            this.scopes.PushBack(scope);
        }

        if this.current != null {
            this.current->children.PushBack(scope);
        } this.current = scope;
    }

    pub fn PopScope(&mut this) {
        if this.current == null {
            Logger::Log("ScopeManager", "No scope to pop!", LogSeverity::Fatal);
        }

        let temp = this.current;
        this.current = this.current->parent;

        if this.current == null {
            for scope in this.scopes {
                delete scope;
            }
        } else if !temp->global {
            this.current->children.Remove(temp);
            delete temp;
        }
    }

    pub fn Has(&this, name: &String) -> bool {
        let mut scope = this.current;

        while scope != null {
            if scope->Has(name) {
                return true;
            } else {
                scope = scope->parent;
            }
        } return false;
    }

    pub fn Has(&this, name: &String, kind: SymbolKind) -> bool {
        let mut scope = this.current;

        while scope != null {
            if scope->Has(name, kind) {
                return true;
            } else {
                scope = scope->parent;
            }
        } return false;
    }

    pub fn Set(&mut this, name: &String, _type: *SemanticType, node: *ASTNode) -> *Symbol {
        return this.current->Set(name, _type, node);
    }

    pub fn Set(&mut this, name: &String, statement: *HIRStatement, node: *ASTNode) -> *Symbol {
        return this.current->Set(name, statement, node);
    }

    pub fn Set(&mut this, name: &String, declaration: *HIRDeclaration, overload: bool, node: *ASTNode) -> *Symbol {
        return this.current->Set(name, declaration, overload, node);
    }

    pub fn Set(&mut this, name: &String, generic: *mut Generic, node: *ASTNode) -> *Symbol {
        return this.current->Set(name, generic, node);
    }

    pub fn RegisterInstance(&mut this, instance: *HIRExpression) {
        if this.current->global {
            Logger::Log("ScopeManager", "Cannot register instance in global scope!", LogSeverity::Fatal);
        }

        this.current->instances.PushBack(instance);
    }

    pub fn Get(&this, name: &String) -> *Symbol {
        let mut scope = this.current;

        while scope != null {
            if scope->Has(name) {
                return scope->Get(name);
            } else {
                scope = scope->parent;
            }
        } return null;
    }

    pub fn Get(&this, name: &String, kind: SymbolKind) -> *Symbol {
        let mut scope = this.current;

        while scope != null {
            if scope->Has(name, kind) {
                return scope->Get(name, kind);
            } else {
                scope = scope->parent;
            }
        } return null;
    }

    pub fn GetAll(&this, name: &String) -> Vector<*Symbol> {
        let mut result = Vector<*Symbol>();
        let mut scope = this.current;

        while scope != null {
            if scope->Has(name) {
                result += scope->GetAll(name);
            } scope = scope->parent;
        } return result;
    }

    pub fn GetAll(&this, name: &String, kind: SymbolKind) -> Vector<*Symbol> {
        let mut result = Vector<*Symbol>();
        let mut scope = this.current;

        while scope != null {
            if scope->Has(name, kind) {
                result += scope->GetAll(name, kind);
            } scope = scope->parent;
        } return result;
    }

    fn LookupInScope(&this, scope: *Scope, segment: ASTPathSegment, path: *ASTPath, scope_required: bool, test: bool) -> LookupResult {
        if scope == null {
            return LookupResult(Vector<*Symbol>(), null, LookupStatus::Invalid);
        }

        let mut child: *Scope = null;

        for candidate in scope->children {
            if candidate->name == segment.name {
                child = candidate;
                break;
            }
        }

        let symbols = Vector<*Symbol>();

        for symbol in scope->GetAll(segment.name) {
            if symbol->kind == SymbolKind::Generic {
                if segment.types.Empty() { continue; }
                let mut types = Vector<*SemanticType>();

                for _type in segment.types {
                    let resolved = analyzer->ResolveType(_type);

                    if resolved == null {
                        return LookupResult(Vector<*Symbol>(), null, LookupStatus::Invalid);
                    } types.PushBack(resolved);
                }

                let result = symbol->generic->Get(types);

                if scope_required {
                    if result.right != null {
                        return LookupResult(symbols, result.right, LookupStatus::Found);
                    } return LookupResult(Vector<*Symbol>(), null, LookupStatus::Invalid);
                }

                symbols.PushBack(result.left);
            } else {
                symbols.PushBack(symbol);
            }

            if !scope_required {
                if !segment.types.Empty() {
                    return LookupResult(Vector<*Symbol>(), null, LookupStatus::Invalid);
                } return LookupResult(symbols, null, LookupStatus::Found);
            }
        }

        if child != null {
            if !segment.types.Empty() {
                return LookupResult(Vector<*Symbol>(), null, LookupStatus::Invalid);
            } return LookupResult(Vector<*Symbol>(), child, LookupStatus::Found);
        } return LookupResult(Vector<*Symbol>(), null, LookupStatus::NotFound);
    }

    pub fn Resolve(&this, path: *ASTPath, test: bool) -> *Symbol {
        if path == null || path->segments.Empty() {
            if !test && path != null {
                Logger::Log("Cannot resolve an empty path.", path, LogSeverity::Error);
            } return null;
        }

        let mut step: LookupResult;

        if path->absolute {
            let mut scope = this.current;

            while scope != null && scope->parent != null {
                scope = scope->parent;
            }

            step = this.LookupInScope(scope, path->segments[0], path, path->segments.Size() > 1, test);
        } else {
            let mut scope = this.current;
            let mut found = false;

            while scope != null {
                step = this.LookupInScope(scope, path->segments[0], path, path->segments.Size() > 1, true);

                if step.status == LookupStatus::Found {
                    found = true;
                    break;
                }

                scope = scope->parent;
            }

            if !found {
                if !test {
                    Logger::Log("Symbol '" + path->segments[0].name + "' not found.", path, LogSeverity::Error);
                } return null;
            }
        }

        if step.status == LookupStatus::NotFound {
            if !test {
                Logger::Log("Symbol '" + path->segments[0].name + "' not found.", path, LogSeverity::Error);
            } return null;
        }

        if step.status == LookupStatus::Invalid {
            if !test {
                Logger::Log("Invalid path segment '" + path->segments[0].name + "'.", path, LogSeverity::Error);
            } return null;
        }

        for i in 1..path->segments.Size() {
            if step.scope == null {
                if !test {
                    Logger::Log("'" + path->segments[i - 1].name + "' is not a scope.", path, LogSeverity::Error);
                } return null;
            }

            step = this.LookupInScope(step.scope, path->segments[i], path, i + 1 < path->segments.Size(), test);

            if step.status == LookupStatus::NotFound {
                if !test {
                    Logger::Log("Symbol '" + path->segments[i].name + "' not found.", path, LogSeverity::Error);
                } return null;
            }

            if step.status == LookupStatus::Invalid {
                if !test {
                    Logger::Log("Invalid path segment '" + path->segments[i].name + "'.", path, LogSeverity::Error);
                } return null;
            }
        }

        if !step.symbols.Empty() {
            return step.symbols[0];
        } else {
            if !test {
                Logger::Log("Path does not resolve to a symbol.", path, LogSeverity::Error);
            } return null;
        }
    }

    pub fn ResolveCandidates(&this, path: *ASTPath, test: bool) -> Vector<*HIRFunctionDeclaration> {
        let result = Vector<*HIRFunctionDeclaration>();

        if path == null || path->segments.Empty() {
            if !test && path != null {
                Logger::Log("Cannot resolve an empty path.", path, LogSeverity::Error);
            } return result;
        }

        let last = path->segments.Size() - 1;
        let mut scope: *Scope = null;
        let mut step: LookupResult;

        if last == 0 {
            scope = this.current;

            if path->absolute {
                while scope != null && scope->parent != null {
                    scope = scope->parent;
                }
            } else {
                while scope != null {
                    step = this.LookupInScope(scope, path->segments[0], path, false, true);
                    if step.status == LookupStatus::Found { break; }
                    scope = scope->parent;
                }
            }

            if scope == null {
                if !test {
                    Logger::Log("Symbol '" + path->segments[0].name + "' not found.", path, LogSeverity::Error);
                } return result;
            }

            step = this.LookupInScope(scope, path->segments[0], path, false, test);
        } else {
            if path->absolute {
                scope = this.current;

                while scope != null && scope->parent != null {
                    scope = scope->parent;
                }

                step = this.LookupInScope(scope, path->segments[0], path, true, test);
            } else {
                let mut search = this.current;
                let mut found = false;

                while search != null {
                    step = this.LookupInScope(search, path->segments[0], path, true, true);

                    if step.status == LookupStatus::Found {
                        found = true;
                        break;
                    }

                    search = search->parent;
                }

                if !found {
                    if !test {
                        Logger::Log("Symbol '" + path->segments[0].name + "' not found.", path, LogSeverity::Error);
                    } return result;
                }
            }

            if step.status == LookupStatus::NotFound {
                if !test {
                    Logger::Log("Symbol '" + path->segments[0].name + "' not found.", path, LogSeverity::Error);
                } return result;
            }

            if step.status == LookupStatus::Invalid {
                if !test {
                    Logger::Log("Invalid path segment '" + path->segments[0].name + "'.", path, LogSeverity::Error);
                } return result;
            }

            if step.scope == null {
                if !test {
                    Logger::Log("'" + path->segments[0].name + "' is not a scope.", path, LogSeverity::Error);
                } return result;
            }

            scope = step.scope;

            for i in 1..last {
                step = this.LookupInScope(scope, path->segments[i], path, true, test);

                if step.status == LookupStatus::NotFound {
                    if !test {
                        Logger::Log("Symbol '" + path->segments[i].name + "' not found.", path, LogSeverity::Error);
                    } return result;
                }

                if step.status == LookupStatus::Invalid {
                    if !test {
                        Logger::Log("Invalid path segment '" + path->segments[i].name + "'.", path, LogSeverity::Error);
                    } return result;
                }

                if step.scope == null {
                    if !test {
                        Logger::Log("'" + path->segments[i].name + "' is not a scope.", path, LogSeverity::Error);
                    } return result;
                }

                scope = step.scope;
            }

            step = this.LookupInScope(scope, path->segments[last], path, false, test);
        }

        if step.status == LookupStatus::NotFound {
            if !test {
                Logger::Log("Symbol '" + path->segments[last].name + "' not found.", path, LogSeverity::Error);
            } return result;
        }

        if step.status == LookupStatus::Invalid {
            if !test {
                Logger::Log("Invalid path segment '" + path->segments[last].name + "'.", path, LogSeverity::Error);
            } return result;
        }

        for symbol in step.symbols {
            if symbol->kind == SymbolKind::Declaration && symbol->declaration->kind == HIRDeclarationKind::Function {
                result.PushBack(symbol->declaration as *HIRFunctionDeclaration);
            }
        } return result;
    }

    pub fn ResolveCandidates(&this, name: &String, node: *ASTNode, test: bool) -> Vector<*HIRFunctionDeclaration> {
        let result = Vector<*HIRFunctionDeclaration>();
        let mut scope = this.current;

        while scope != null {
            if scope->Has(name) {
                if scope->Has(name, SymbolKind::Declaration) {
                    for symbol in scope->GetAll(name, SymbolKind::Declaration) {
                        if symbol->declaration->kind == HIRDeclarationKind::Function {
                            result.PushBack(symbol->declaration as *HIRFunctionDeclaration);
                        }
                    }
                } else if !test {
                    Logger::Log("Symbol '" + name + "' is not a function.", node, LogSeverity::Error);
                } return result;
            }

            scope = scope->parent;
        }

        if !test {
            Logger::Log("Symbol '" + name + "' not found.", node, LogSeverity::Error);
        } return result;
    }
}

#[include "src/SemanticAnalyzer.zir" : *]
