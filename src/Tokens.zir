#[include "std/str" : *]

enum TokenType: i32 {
    UNKNOWN, EOF,

    IDENTIFIER, INTEGER, FLOAT, STRING, CHAR, TRUE, FALSE, NULL, ZERO,

    NEW, DELETE, ASYNC, AWAIT, AS, THIS, OPERATOR,
    IF, ELSE, FOR, IN, WHILE, LOOP, MATCH, RETURN, BREAK, CONTINUE,
    FUNCTION, CLASS, STRUCTURE, ENUMERATION, TYPE, EXTERN, LET, MUT, CONST, STATIC,
    PUBLIC, ASSEMBLY, ASSEMBLY_CODE, VOLATILE, UNSAFE,

    ASSIGN, PLUS_ASSIGN, MINUS_ASSIGN, MUL_ASSIGN, DIV_ASSIGN, MOD_ASSIGN,
    LSHIFT_ASSIGN, RSHIFT_ASSIGN, AND_ASSIGN, OR_ASSIGN, XOR_ASSIGN,

    PLUS, MINUS, MUL, DIV, MOD, AND, OR, NOT,
    BITWISE_AND, BITWISE_OR, BITWISE_XOR, LSHIFT, RSHIFT, TILDE,
    EQUAL, NOT_EQUAL, GREATER, LESS, GREATER_EQUAL, LESS_EQUAL,

    LPAREN, RPAREN, LBRACE, RBRACE, LBRACKET, RBRACKET,
    DOT, TWO_DOT, THREE_DOT, COMMA, COLON, DOUBLE_COLON, SEMICOLON,
    AT, QUESTION_MARK, BACKSLASH, ARROW, FAT_ARROW,

    PREPROCESSOR_START, PREPROCESSOR_END,
    ELIF, ENDIF, INCLUDE, ERROR, WARNING
}

fn ToString(_type: TokenType) -> String {
    if _type == TokenType::EOF { return "EOF".ToString(); }
    else if _type == TokenType::IDENTIFIER { return "IDENTIFIER".ToString(); }
    else if _type == TokenType::INTEGER { return "INTEGER".ToString(); }
    else if _type == TokenType::FLOAT { return "FLOAT".ToString(); }
    else if _type == TokenType::STRING { return "STRING".ToString(); }
    else if _type == TokenType::CHAR { return "CHAR".ToString(); }
    else if _type == TokenType::TRUE { return "TRUE".ToString(); }
    else if _type == TokenType::FALSE { return "FALSE".ToString(); }
    else if _type == TokenType::NULL { return "NULL".ToString(); }
    else if _type == TokenType::ZERO { return "ZERO".ToString(); }
    else if _type == TokenType::NEW { return "NEW".ToString(); }
    else if _type == TokenType::DELETE { return "DELETE".ToString(); }
    else if _type == TokenType::ASYNC { return "ASYNC".ToString(); }
    else if _type == TokenType::AWAIT { return "AWAIT".ToString(); }
    else if _type == TokenType::AS { return "AS".ToString(); }
    else if _type == TokenType::THIS { return "THIS".ToString(); }
    else if _type == TokenType::OPERATOR { return "OPERATOR".ToString(); }
    else if _type == TokenType::IF { return "IF".ToString(); }
    else if _type == TokenType::ELSE { return "ELSE".ToString(); }
    else if _type == TokenType::FOR { return "FOR".ToString(); }
    else if _type == TokenType::IN { return "IN".ToString(); }
    else if _type == TokenType::WHILE { return "WHILE".ToString(); }
    else if _type == TokenType::LOOP { return "LOOP".ToString(); }
    else if _type == TokenType::MATCH { return "MATCH".ToString(); }
    else if _type == TokenType::RETURN { return "RETURN".ToString(); }
    else if _type == TokenType::BREAK { return "BREAK".ToString(); }
    else if _type == TokenType::CONTINUE { return "CONTINUE".ToString(); }
    else if _type == TokenType::FUNCTION { return "FUNCTION".ToString(); }
    else if _type == TokenType::CLASS { return "CLASS".ToString(); }
    else if _type == TokenType::STRUCTURE { return "STRUCTURE".ToString(); }
    else if _type == TokenType::ENUMERATION { return "ENUMERATION".ToString(); }
    else if _type == TokenType::TYPE { return "TYPE".ToString(); }
    else if _type == TokenType::EXTERN { return "EXTERN".ToString(); }
    else if _type == TokenType::LET { return "LET".ToString(); }
    else if _type == TokenType::MUT { return "MUT".ToString(); }
    else if _type == TokenType::CONST { return "CONST".ToString(); }
    else if _type == TokenType::STATIC { return "STATIC".ToString(); }
    else if _type == TokenType::PUBLIC { return "PUBLIC".ToString(); }
    else if _type == TokenType::ASSEMBLY { return "ASSEMBLY".ToString(); }
    else if _type == TokenType::ASSEMBLY_CODE { return "ASSEMBLY_CODE".ToString(); }
    else if _type == TokenType::VOLATILE { return "VOLATILE".ToString(); }
    else if _type == TokenType::UNSAFE { return "UNSAFE".ToString(); }
    else if _type == TokenType::ASSIGN { return "ASSIGN".ToString(); }
    else if _type == TokenType::PLUS_ASSIGN { return "PLUS_ASSIGN".ToString(); }
    else if _type == TokenType::MINUS_ASSIGN { return "MINUS_ASSIGN".ToString(); }
    else if _type == TokenType::MUL_ASSIGN { return "MUL_ASSIGN".ToString(); }
    else if _type == TokenType::DIV_ASSIGN { return "DIV_ASSIGN".ToString(); }
    else if _type == TokenType::MOD_ASSIGN { return "MOD_ASSIGN".ToString(); }
    else if _type == TokenType::LSHIFT_ASSIGN { return "LSHIFT_ASSIGN".ToString(); }
    else if _type == TokenType::RSHIFT_ASSIGN { return "RSHIFT_ASSIGN".ToString(); }
    else if _type == TokenType::AND_ASSIGN { return "AND_ASSIGN".ToString(); }
    else if _type == TokenType::OR_ASSIGN { return "OR_ASSIGN".ToString(); }
    else if _type == TokenType::XOR_ASSIGN { return "XOR_ASSIGN".ToString(); }
    else if _type == TokenType::PLUS { return "PLUS".ToString(); }
    else if _type == TokenType::MINUS { return "MINUS".ToString(); }
    else if _type == TokenType::MUL { return "MUL".ToString(); }
    else if _type == TokenType::DIV { return "DIV".ToString(); }
    else if _type == TokenType::MOD { return "MOD".ToString(); }
    else if _type == TokenType::AND { return "AND".ToString(); }
    else if _type == TokenType::OR { return "OR".ToString(); }
    else if _type == TokenType::NOT { return "NOT".ToString(); }
    else if _type == TokenType::BITWISE_AND { return "BITWISE_AND".ToString(); }
    else if _type == TokenType::BITWISE_OR { return "BITWISE_OR".ToString(); }
    else if _type == TokenType::BITWISE_XOR { return "BITWISE_XOR".ToString(); }
    else if _type == TokenType::LSHIFT { return "LSHIFT".ToString(); }
    else if _type == TokenType::RSHIFT { return "RSHIFT".ToString(); }
    else if _type == TokenType::TILDE { return "TILDE".ToString(); }
    else if _type == TokenType::EQUAL { return "EQUAL".ToString(); }
    else if _type == TokenType::NOT_EQUAL { return "NOT_EQUAL".ToString(); }
    else if _type == TokenType::GREATER { return "GREATER".ToString(); }
    else if _type == TokenType::LESS { return "LESS".ToString(); }
    else if _type == TokenType::GREATER_EQUAL { return "GREATER_EQUAL".ToString(); }
    else if _type == TokenType::LESS_EQUAL { return "LESS_EQUAL".ToString(); }
    else if _type == TokenType::LPAREN { return "LPAREN".ToString(); }
    else if _type == TokenType::RPAREN { return "RPAREN".ToString(); }
    else if _type == TokenType::LBRACE { return "LBRACE".ToString(); }
    else if _type == TokenType::RBRACE { return "RBRACE".ToString(); }
    else if _type == TokenType::LBRACKET { return "LBRACKET".ToString(); }
    else if _type == TokenType::RBRACKET { return "RBRACKET".ToString(); }
    else if _type == TokenType::DOT { return "DOT".ToString(); }
    else if _type == TokenType::TWO_DOT { return "TWO_DOT".ToString(); }
    else if _type == TokenType::THREE_DOT { return "THREE_DOT".ToString(); }
    else if _type == TokenType::COMMA { return "COMMA".ToString(); }
    else if _type == TokenType::COLON { return "COLON".ToString(); }
    else if _type == TokenType::DOUBLE_COLON { return "DOUBLE_COLON".ToString(); }
    else if _type == TokenType::SEMICOLON { return "SEMICOLON".ToString(); }
    else if _type == TokenType::AT { return "AT".ToString(); }
    else if _type == TokenType::QUESTION_MARK { return "QUESTION_MARK".ToString(); }
    else if _type == TokenType::BACKSLASH { return "BACKSLASH".ToString(); }
    else if _type == TokenType::ARROW { return "ARROW".ToString(); }
    else if _type == TokenType::FAT_ARROW { return "FAT_ARROW".ToString(); }
    else if _type == TokenType::PREPROCESSOR_START { return "PREPROCESSOR_START".ToString(); }
    else if _type == TokenType::PREPROCESSOR_END { return "PREPROCESSOR_END".ToString(); }
    else if _type == TokenType::ELIF { return "ELIF".ToString(); }
    else if _type == TokenType::ENDIF { return "ENDIF".ToString(); }
    else if _type == TokenType::INCLUDE { return "INCLUDE".ToString(); }
    else if _type == TokenType::ERROR { return "ERROR".ToString(); }
    else if _type == TokenType::WARNING { return "WARNING".ToString(); }
    else { return "UNKNOWN".ToString(); }
}

fn ToAssignmentOperatorString(_operator: TokenType) -> String {
    if _operator == TokenType::ASSIGN { return "=".ToString(); }
    else if _operator == TokenType::PLUS_ASSIGN { return "+=".ToString(); }
    else if _operator == TokenType::MINUS_ASSIGN { return "-=".ToString(); }
    else if _operator == TokenType::MUL_ASSIGN { return "*=".ToString(); }
    else if _operator == TokenType::DIV_ASSIGN { return "/=".ToString(); }
    else if _operator == TokenType::MOD_ASSIGN { return "%=".ToString(); }
    else if _operator == TokenType::LSHIFT_ASSIGN { return "<<=".ToString(); }
    else if _operator == TokenType::RSHIFT_ASSIGN { return ">>=".ToString(); }
    else if _operator == TokenType::AND_ASSIGN { return "&=".ToString(); }
    else if _operator == TokenType::OR_ASSIGN { return "|=".ToString(); }
    else if _operator == TokenType::XOR_ASSIGN { return "^=".ToString(); }
    else { return "unknown".ToString(); }
}

fn ToBinaryOperatorString(_operator: TokenType) -> String {
    if _operator == TokenType::PLUS { return "+".ToString(); }
    else if _operator == TokenType::MINUS { return "-".ToString(); }
    else if _operator == TokenType::MUL { return "*".ToString(); }
    else if _operator == TokenType::DIV { return "/".ToString(); }
    else if _operator == TokenType::MOD { return "%".ToString(); }
    else if _operator == TokenType::EQUAL { return "==".ToString(); }
    else if _operator == TokenType::NOT_EQUAL { return "!=".ToString(); }
    else if _operator == TokenType::GREATER { return ">".ToString(); }
    else if _operator == TokenType::LESS { return "<".ToString(); }
    else if _operator == TokenType::GREATER_EQUAL { return ">=".ToString(); }
    else if _operator == TokenType::LESS_EQUAL { return "<=".ToString(); }
    else if _operator == TokenType::AND { return "&&".ToString(); }
    else if _operator == TokenType::OR { return "||".ToString(); }
    else if _operator == TokenType::BITWISE_AND { return "&".ToString(); }
    else if _operator == TokenType::BITWISE_OR { return "|".ToString(); }
    else if _operator == TokenType::BITWISE_XOR { return "^".ToString(); }
    else if _operator == TokenType::LSHIFT { return "<<".ToString(); }
    else if _operator == TokenType::RSHIFT { return ">>".ToString(); }
    else { return "unknown".ToString(); }
}

fn ToUnaryOperatorString(_operator: TokenType) -> String {
    if _operator == TokenType::MINUS { return "-".ToString(); }
    else if _operator == TokenType::MUL { return "*".ToString(); }
    else if _operator == TokenType::NOT { return "!".ToString(); }
    else if _operator == TokenType::BITWISE_AND { return "&".ToString(); }
    else { return "unknown".ToString(); }
}

fn StringToKeyword(string: String) -> TokenType {
    if string == "true" { return TokenType::TRUE; }
    else if string == "false" { return TokenType::FALSE; }
    else if string == "null" { return TokenType::NULL; }
    else if string == "zero" { return TokenType::ZERO; }
    else if string == "new" { return TokenType::NEW; }
    else if string == "delete" { return TokenType::DELETE; }
    else if string == "async" { return TokenType::ASYNC; }
    else if string == "await" { return TokenType::AWAIT; }
    else if string == "as" { return TokenType::AS; }
    else if string == "this" { return TokenType::THIS; }
    else if string == "if" { return TokenType::IF; }
    else if string == "else" { return TokenType::ELSE; }
    else if string == "for" { return TokenType::FOR; }
    else if string == "in" { return TokenType::IN; }
    else if string == "while" { return TokenType::WHILE; }
    else if string == "loop" { return TokenType::LOOP; }
    else if string == "match" { return TokenType::MATCH; }
    else if string == "return" { return TokenType::RETURN; }
    else if string == "break" { return TokenType::BREAK; }
    else if string == "continue" { return TokenType::CONTINUE; }
    else if string == "fn" { return TokenType::FUNCTION; }
    else if string == "class" { return TokenType::CLASS; }
    else if string == "struct" { return TokenType::STRUCTURE; }
    else if string == "enum" { return TokenType::ENUMERATION; }
    else if string == "type" { return TokenType::TYPE; }
    else if string == "extern" { return TokenType::EXTERN; }
    else if string == "let" { return TokenType::LET; }
    else if string == "mut" { return TokenType::MUT; }
    else if string == "const" { return TokenType::CONST; }
    else if string == "static" { return TokenType::STATIC; }
    else if string == "pub" { return TokenType::PUBLIC; }
    else if string == "operator" { return TokenType::OPERATOR; }
    else if string == "asm" { return TokenType::ASSEMBLY; }
    else if string == "volatile" { return TokenType::VOLATILE; }
    else if string == "unsafe" { return TokenType::UNSAFE; }
    else { return TokenType::UNKNOWN; }
}

fn StringToDirective(string: String) -> TokenType {
    if string == "true" { return TokenType::TRUE; }
    else if string == "false" { return TokenType::FALSE; }
    else if string == "if" { return TokenType::IF; }
    else if string == "elif" { return TokenType::ELIF; }
    else if string == "else" { return TokenType::ELSE; }
    else if string == "endif" { return TokenType::ENDIF; }
    else if string == "include" { return TokenType::INCLUDE; }
    else if string == "error" { return TokenType::ERROR; }
    else if string == "warning" { return TokenType::WARNING; }
    else { return TokenType::UNKNOWN; }
}

class Token {
    pub _type: TokenType,
    pub value: String,
    pub row: u32,
    pub column: u32,
    pub file: String
}
