#[include "std/str", "std/vec", "src/Scope.zir", "src/Symbol.zir", "src/Value.zir", "src/Types.zir", "src/Nodes.zir" : *]

class ScopeManager {
    pub builder: LLVMBuilderRef = null,
    pub scopes: Vector<*Scope>,
    pub current: *mut Scope = null;

    ScopeManager(&mut this) {
        this.PushScope(String("global"), true);
    }

    ~ScopeManager(&mut this) {
        this.PopScope();
    }

    pub func PushScope(&mut this, name: String, global: bool) {
        let scope = new Scope(this.current, name, global);

        if global {
            this.scopes.PushBack(scope);
        }

        if this.current != null {
            this.current->children.PushBack(scope);
        } this.current = scope;
    }

    pub func PopScope(&mut this) {
        if this.current == null {
            Logger::Log("ScopeManager", "No scope to pop!", LogSeverity::Fatal);
        }

        let temp = this.current;
        this.current = this.current->parent;

        if this.current == null {
            for scope in this.scopes {
                del scope;
            }
        } else if !temp->global {
            for instance in temp->instances {
                if LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder)) == null {
                    compiler->CompileDestructor(instance.Type().Pointee(), instance, null);
                }
            }

            this.current->children.Remove(temp);
            del temp;
        }
    }

    pub func RegisterInstance(&mut this, instance: QualifiedValue) {
        if this.current->global {
            Logger::Log("ScopeManager", "Cannot register instance in global scope!", LogSeverity::Fatal);
        }

        this.current->instances.PushBack(instance);
    }

    pub func InvokeDestructors(&this, exception: QualifiedValue) {
        let mut scope = this.current;

        while !scope->global {
            for instance in scope->instances {
                if instance != exception {
                    compiler->CompileDestructor(instance.Type().Pointee(), instance, null);
                }
            } scope = scope->parent;
        }
    }

    pub func InvokeDestructors(&this) {
        let mut scope = this.current;

        while !scope->global {
            for instance in scope->instances {
                compiler->CompileDestructor(instance.Type().Pointee(), instance, null);
            } scope = scope->parent;
        }
    }

    pub func InvokeDestructorsUntil(&this, target: *Scope) {
        let mut scope = this.current;

        loop {
            for instance in scope->instances {
                compiler->CompileDestructor(instance.Type().Pointee(), instance, null);
            }

            if scope != target {
                scope = scope->parent;
            } else {
                break;
            }
        }
    }

    pub func Has(&this, name: String) -> bool {
        let mut scope = this.current;

        while scope != null {
            if scope->Has(name) {
                ret true;
            } else {
                scope = scope->parent;
            }
        } ret false;
    }

    pub func Has(&this, name: String, kind: SymbolKind) -> bool {
        let mut scope = this.current;

        while scope != null {
            if scope->Has(name, kind) {
                ret true;
            } else {
                scope = scope->parent;
            }
        } ret false;
    }

    pub func Set(&mut this, name: String, kind: SymbolKind, value: QualifiedValue, overload: bool, node: *Node) -> *Symbol {
        ret this.current->Set(name, kind, value, overload, node);
    }

    pub func Set(&mut this, name: String, kind: SymbolKind, pointer: *void, overload: bool, node: *Node) -> *Symbol {
        ret this.current->Set(name, kind, pointer, overload, node);
    }

    pub func Get(&this, name: String) -> *Symbol {
        let mut scope = this.current;

        while scope != null {
            if scope->Has(name) {
                ret scope->Get(name);
            } else {
                scope = scope->parent;
            }
        } ret null;
    }

    pub func Get(&this, name: String, kind: SymbolKind) -> *Symbol {
        let mut scope = this.current;

        while scope != null {
            if scope->Has(name, kind) {
                ret scope->Get(name, kind);
            } else {
                scope = scope->parent;
            }
        } ret null;
    }

    pub func GetAll(&this, name: String) -> Vector<*Symbol> {
        let mut result: Vector<*Symbol>;
        let mut scope = this.current;

        while scope != null {
            if scope->Has(name) {
                result += scope->GetAll(name);
            } scope = scope->parent;
        } ret result;
    }

    pub func GetAll(&this, name: String, kind: SymbolKind) -> Vector<*Symbol> {
        let mut result: Vector<*Symbol>;
        let mut scope = this.current;

        while scope != null {
            if scope->Has(name, kind) {
                result += scope->GetAll(name, kind);
            } scope = scope->parent;
        } ret result;
    }

    pub func Namespaces(&this) -> Vector<String> {
        let mut result: Vector<String>;
        let mut scope = this.current;

        while scope->parent != null {
            if scope->global {
                result.PushBack(scope->name);
            } scope = scope->parent;
        } ret result.Reverse();
    }

    pub func ResolveChild(&this, scope: *Scope, identifier: *IdentifierNode, test: bool) -> *Scope {
        for child in scope->children {
            if child->name == identifier->name {
                ret child;
            }
        }

        if !test {
            Logger::Log("Scope '" + identifier->name + "' not found.", identifier, LogSeverity::Error);
        } ret null;
    }

    pub func ResolveChild(&this, scope: *Scope, primitive_type: *PrimitiveTypeNode, test: bool) -> *Scope {
        for child in scope->children {
            if child->name == primitive_type->name {
                ret child;
            }
        }

        if !test {
            Logger::Log("Scope '" + primitive_type->name + "' not found.", primitive_type, LogSeverity::Error);
        } ret null;
    }

    pub func ResolveScopeHalf(&this, resolution: *ScopeResolutionNode, test: bool) -> *Scope {
        let mut scope: *Scope = this.current;

        while !scope->global {
            scope = scope->parent;
        }

        if resolution->scope != null {
            if resolution->scope->_type == NodeType::SCOPE_RESOLUTION {
                scope = this.ResolveScopeFull(resolution->scope as *ScopeResolutionNode, test);
            } else if resolution->scope->_type == NodeType::PRIMITIVE_TYPE {
                scope = this.ResolveChild(scope, resolution->scope as *PrimitiveTypeNode, test);
            } else if resolution->scope->_type == NodeType::IDENTIFIER {
                scope = this.ResolveChild(scope, resolution->scope as *IdentifierNode, test);
            } else if resolution->scope->_type == NodeType::TYPE_APPLICATION {
                let type_application = resolution->scope as *TypeApplicationNode;
                let mut types: Vector<*QualifiedType>;

                for _type in type_application->types {
                    types.PushBack(compiler->CompileType(_type));
                }

                if type_application->expression->_type == NodeType::PRIMITIVE_TYPE {
                    let primitive_type = type_application->expression as *PrimitiveTypeNode;
                    let symbol = this.Resolve(primitive_type->name, primitive_type, test);

                    if symbol != null && symbol->kind == SymbolKind::Generic {
                        scope = (symbol->pointer as *mut Generic)->Get(types).right;
                    } else {
                        if !test {
                            if symbol != null {
                                Logger::Log("Type '" + primitive_type->name + "' is not generic.", primitive_type, LogSeverity::Error);
                            } else {
                                Logger::Log("Type '" + primitive_type->name + "' not found.", primitive_type, LogSeverity::Error);
                            }
                        } ret null;
                    }
                } else {
                    if !test {
                        Logger::Log("Unknown resolution '" + resolution->scope->_type.ToString() + "'.", resolution->scope, LogSeverity::Error);
                    } ret null;
                }
            } else {
                if !test {
                    Logger::Log("Unknown resolution '" + resolution->scope->_type.ToString() + "'.", resolution->scope, LogSeverity::Error);
                } ret null;
            }
        } else {
            while scope->parent != null {
                scope = scope->parent;
            }
        } ret scope;
    }

    pub func ResolveScopeFull(&this, resolution: *ScopeResolutionNode, test: bool) -> *Scope {
        ret this.ResolveChild(this.ResolveScopeHalf(resolution, test), resolution->identifier, test);
    }

    pub func Resolve(&this, resolution: *ScopeResolutionNode, test: bool) -> *Symbol {
        let scope = this.ResolveScopeHalf(resolution, test);

        if scope == null {
            ret null;
        }

        if scope->Has(resolution->identifier->name) {
            ret scope->Get(resolution->identifier->name);
        } else {
            if !test {
                Logger::Log("Symbol '" + resolution->identifier->name + "' not found.", resolution, LogSeverity::Error);
            } ret null;
        }
    }

    pub func Resolve(&this, identifier: *IdentifierNode, test: bool) -> *Symbol {
        if this.Has(identifier->name) {
            ret this.Get(identifier->name);
        } else {
            if !test {
                Logger::Log("Symbol '" + identifier->name + "' not found.", identifier, LogSeverity::Error);
            } ret null;
        }
    }

    pub func Resolve(&this, node: *Node, test: bool) -> *Symbol {
        if node->_type == NodeType::SCOPE_RESOLUTION {
            ret this.Resolve(node as *ScopeResolutionNode, test);
        } else if node->_type == NodeType::IDENTIFIER {
            ret this.Resolve(node as *IdentifierNode, test);
        } else {
            if !test {
                Logger::Log("Unknown resolution '" + node->_type.ToString() + "'.", node, LogSeverity::Error);
            } ret null;
        }
    }

    pub func Resolve(&this, name: &String, node: *Node, test: bool) -> *Symbol {
        if this.Has(name) {
            ret this.Get(name);
        } else {
            if !test {
                Logger::Log("Symbol '" + name + "' not found.", node, LogSeverity::Error);
            } ret null;
        }
    }

    pub func Resolve(&this, symbols: &Vector<*Symbol>, params: &Vector<*QualifiedType>, node: *Node, test: bool) -> *Symbol {
        let mut index: usize = 0;
        let mut best: u64 = 0;

        for i in 0..symbols.Size() {
            let (mut _match, mut score: u64) = (true, 1);
            let _params = symbols[i]->value.Type().Pointee().Parameters();
            let mut offset: usize = 0;

            if _params.Size() != 0 {
                offset = _params[0].sret != null ? 1 : 0;
            }

            let has_pack = symbols[i]->value.Type().Pointee().pack_name != "";

            if (!has_pack && params.Size() != _params.Size() - offset) || (has_pack && params.Size() < _params.Size() - offset) {
                continue;
            }

            for j in 0..(_params.Size() - offset) {
                let param_type = _params[j + offset];
                let _type = param_type.byval != null ? param_type.byval : param_type._type;
                let param_score = _type->ScoreParameter(*params[j]);

                if param_score != 0 {
                    score += param_score;
                } else {
                    _match = false;
                    break;
                }
            }

            if _match && score > best {
                (index, best) = (i, score);
            }
        }

        if best != 0 {
            ret symbols[index];
        } else {
            if !test {
                Logger::Log("Invalid arguments for: '" + symbols[0]->name + "'.", node, LogSeverity::Error);
            } ret null;
        }
    }

    pub func Resolve(&this, resolution: *ScopeResolutionNode, params: &Vector<*QualifiedType>, test: bool) -> *Symbol {
        let scope = this.ResolveScopeHalf(resolution, test);

        if scope->Has(resolution->identifier->name, SymbolKind::Function) {
            ret this.Resolve(scope->GetAll(resolution->identifier->name, SymbolKind::Function), params, resolution, test);
        } else {
            if !test {
                Logger::Log("Symbol '" + resolution->identifier->name + "' not found.", resolution, LogSeverity::Error);
            } ret null;
        }
    }

    pub func Resolve(&this, identifier: *IdentifierNode, params: &Vector<*QualifiedType>, test: bool) -> *Symbol {
        if this.Has(identifier->name, SymbolKind::Function) {
            ret this.Resolve(this.GetAll(identifier->name, SymbolKind::Function), params, identifier, test);
        } else {
            if !test {
                Logger::Log("Symbol '" + identifier->name + "' not found.", identifier, LogSeverity::Error);
            } ret null;
        }
    }

    pub func Resolve(&this, node: *Node, params: &Vector<*QualifiedType>, test: bool) -> *Symbol {
        if node->_type == NodeType::SCOPE_RESOLUTION {
            ret this.Resolve(node as *ScopeResolutionNode, params, test);
        } else if node->_type == NodeType::IDENTIFIER {
            ret this.Resolve(node as *IdentifierNode, params, test);
        } else {
            if !test {
                Logger::Log("Unknown resolution '" + node->_type.ToString() + "'.", node, LogSeverity::Error);
            } ret null;
        }
    }

    pub func Resolve(&this, name: &String, params: &Vector<*QualifiedType>, node: *Node, test: bool) -> *Symbol {
        if this.Has(name, SymbolKind::Function) {
            ret this.Resolve(this.GetAll(name, SymbolKind::Function), params, node, test);
        } else {
            if !test {
                Logger::Log("Symbol '" + name + "' not found.", node, LogSeverity::Error);
            } ret null;
        }
    }
}

#[include "src/Compiler.zir" : *]
