#[include "std/str", "std/vec", "src/Tokens.zir", "src/Types.zir" : *]

enum HIRTypeKind: u8 {
    Void, Boolean, Character,
    Integer, Float, Pointer, Reference, Array,
    Function, Class, Structure, Enumeration
}

class HIRType {
    pub kind: HIRTypeKind;

    HIRType(&mut this, kind: HIRTypeKind) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        if this.kind == HIRTypeKind::Void {
            return (this as *HIRVoidType)->ToString();
        } else if this.kind == HIRTypeKind::Boolean {
            return (this as *HIRBooleanType)->ToString();
        } else if this.kind == HIRTypeKind::Character {
            return (this as *HIRCharacterType)->ToString();
        } else if this.kind == HIRTypeKind::Integer {
            return (this as *HIRIntegerType)->ToString();
        } else if this.kind == HIRTypeKind::Float {
            return (this as *HIRFloatType)->ToString();
        } else if this.kind == HIRTypeKind::Pointer {
            return (this as *HIRPointerType)->ToString();
        } else if this.kind == HIRTypeKind::Reference {
            return (this as *HIRReferenceType)->ToString();
        } else if this.kind == HIRTypeKind::Array {
            return (this as *HIRArrayType)->ToString();
        } else if this.kind == HIRTypeKind::Function {
            return (this as *HIRFunctionType)->ToString();
        } else if this.kind == HIRTypeKind::Class {
            return (this as *HIRClassType)->ToString();
        } else if this.kind == HIRTypeKind::Structure {
            return (this as *HIRStructureType)->ToString();
        } else if this.kind == HIRTypeKind::Enumeration {
            return (this as *HIREnumerationType)->ToString();
        } else {
            return "<invalid type>".ToString();
        }
    }
}

class HIRVoidType : HIRType {
    HIRVoidType(&mut this) : HIRType(HIRTypeKind::Void) {}

    pub fn ToString(&this) -> String {
        return "void".ToString();
    }
}

class HIRBooleanType : HIRType {
    HIRBooleanType(&mut this) : HIRType(HIRTypeKind::Boolean) {}

    pub fn ToString(&this) -> String {
        return "bool".ToString();
    }
}

class HIRCharacterType : HIRType {
    HIRCharacterType(&mut this) : HIRType(HIRTypeKind::Character) {}

    pub fn ToString(&this) -> String {
        return "char".ToString();
    }
}

class HIRIntegerType : HIRType {
    pub width: u32,
    pub signed: bool,
    pub literal: bool,
    pub native: bool;

    HIRIntegerType(&mut this, width: u32, signed: bool, literal: bool, native: bool) : HIRType(HIRTypeKind::Integer) {
        (this.width, this.signed, this.literal, this.native) = (width, signed, literal, native);
    }

    pub fn ToString(&this) -> String {
        if !this.literal {
            if !this.native {
                return (this.signed ? 'i' : 'u') + String::FromInteger(this.width as u64);
            } else {
                return (this.signed ? "isize" : "usize").ToString();
            }
        } else {
            return "<integer literal>".ToString();
        }
    }
}

class HIRFloatType : HIRType {
    pub width: u32,
    pub literal: bool;

    HIRFloatType(&mut this, width: u32, literal: bool) : HIRType(HIRTypeKind::Float) {
        (this.width, this.literal) = (width, literal);
    }

    pub fn ToString(&this) -> String {
        if !this.literal {
            return 'f' + String::FromInteger(this.width as u64);
        } else {
            return "<float literal>".ToString();
        }
    }
}

class HIRPointerType : HIRType {
    pub pointee: *HIRType,
    pub mutable: bool;

    HIRPointerType(&mut this, pointee: *HIRType, mutable: bool) : HIRType(HIRTypeKind::Pointer) {
        (this.pointee, this.mutable) = (pointee, mutable);
    }

    pub fn ToString(&this) -> String {
        return (this.mutable ? "*mut " : "*") + this.pointee->ToString();
    }
}

class HIRReferenceType : HIRType {
    pub referent: *HIRType,
    pub mutable: bool;

    HIRReferenceType(&mut this, referent: *HIRType, mutable: bool) : HIRType(HIRTypeKind::Reference) {
        (this.referent, this.mutable) = (referent, mutable);
    }

    pub fn ToString(&this) -> String {
        return (this.mutable ? "&mut " : "&") + this.referent->ToString();
    }
}

class HIRArrayType : HIRType {
    pub element: *HIRType,
    pub length: usize;

    HIRArrayType(&mut this, element: *HIRType, length: usize) : HIRType(HIRTypeKind::Array) {
        (this.element, this.length) = (element, length);
    }

    pub fn ToString(&this) -> String {
        return '[' + this.element->ToString() + "; " + String::FromInteger(this.length as u64) + ']';
    }
}

class HIRFunctionType : HIRType {
    pub parameters: Vector<*HIRType>,
    pub _return: *HIRType;

    HIRFunctionType(&mut this, parameters: Vector<*HIRType>, _return: *HIRType) : HIRType(HIRTypeKind::Function) {
        (this.parameters, this._return) = (parameters, _return);
    }

    pub fn ToString(&this) -> String {
        let mut result = "fn(".ToString();

        for i in 0..this.parameters.Size() {
            if i != 0 { result += ", "; }
            let parameter: *HIRType = this.parameters[i];
            result += parameter->ToString();
        } result += ')';

        if this._return->kind != HIRTypeKind::Void {
            result += " -> " + this._return->ToString();
        } return result;
    }
}

class HIRClassType : HIRType {
    pub name: String;

    HIRClassType(&mut this, name: String) : HIRType(HIRTypeKind::Class) {
        this.name = name;
    }

    pub fn ToString(&this) -> String {
        return this.name;
    }
}

class HIRStructureType : HIRType {
    pub name: String;

    HIRStructureType(&mut this, name: String) : HIRType(HIRTypeKind::Structure) {
        this.name = name;
    }

    pub fn ToString(&this) -> String {
        return this.name;
    }
}

class HIREnumerationType : HIRType {
    pub name: String,
    pub underyling: *HIRType;

    HIREnumerationType(&mut this, name: String, underyling: *HIRType) : HIRType(HIRTypeKind::Enumeration) {
        (this.name, this.underyling) = (name, underyling);
    }

    pub fn ToString(&this) -> String {
        return this.name;
    }
}

enum HIRExpressionKind: u8 {
    Literal, VariableReference, DeclarationReference,
    Dereference, AddressOf, Assignment, Unary, Binary, Ternary,
    Call, Cast, IndexAccess, MemberAccess,
    New, Delete, Constructor, Destructor,
    Intrinsic, Deferred
}

enum HIRExpressionCategory: u8 {
    Place, Value
}

class HIRExpression {
    pub kind: HIRExpressionKind,
    pub _type: *SemanticType,
    pub category: HIRExpressionCategory = ::HIRExpressionCategory::Value,
    pub mutable: bool = false;

    HIRExpression(&mut this, kind: HIRExpressionKind, _type: *SemanticType) {
        (this.kind, this._type) = (kind, _type);
    }

    HIRExpression(&mut this, kind: HIRExpressionKind, _type: *SemanticType, category: HIRExpressionCategory, mutable: bool) {
        (this.kind, this._type, this.category, this.mutable) = (kind, _type, category, mutable);
    }

    pub fn ToString(&this) -> String {
        if this.kind == HIRExpressionKind::Literal {
            return (this as *HIRLiteral)->ToString();
        } else if this.kind == HIRExpressionKind::VariableReference {
            return (this as *HIRVariableReference)->ToString();
        } else if this.kind == HIRExpressionKind::DeclarationReference {
            return (this as *HIRDeclarationReference)->ToString();
        } else if this.kind == HIRExpressionKind::Dereference {
            return (this as *HIRDereferenceExpression)->ToString();
        } else if this.kind == HIRExpressionKind::AddressOf {
            return (this as *HIRAddressOfExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Assignment {
            return (this as *HIRAssignmentExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Unary {
            return (this as *HIRUnaryExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Binary {
            return (this as *HIRBinaryExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Ternary {
            return (this as *HIRTernaryExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Call {
            return (this as *HIRCallExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Cast {
            return (this as *HIRCastExpression)->ToString();
        } else if this.kind == HIRExpressionKind::IndexAccess {
            return (this as *HIRIndexAccessExpression)->ToString();
        } else if this.kind == HIRExpressionKind::MemberAccess {
            return (this as *HIRMemberAccessExpression)->ToString();
        } else if this.kind == HIRExpressionKind::New {
            return (this as *HIRNewExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Delete {
            return (this as *HIRDeleteExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Constructor {
            return (this as *HIRConstructorExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Destructor {
            return (this as *HIRDestructorExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Intrinsic {
            return (this as *HIRIntrinsicExpression)->ToString();
        } else if this.kind == HIRExpressionKind::Deferred {
            return (this as *HIRDeferredExpression)->ToString();
        } else {
            return "<invalid expression>".ToString();
        }
    }
}

enum HIRLiteralKind: u8 {
    Boolean, Character, Integer, Float, String, Array, Structure, Null
}

class HIRLiteral : HIRExpression {
    pub kind: HIRLiteralKind;

    HIRLiteral(&mut this, kind: HIRLiteralKind, _type: *SemanticType) : HIRExpression(HIRExpressionKind::Literal, _type) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        if this.kind == HIRLiteralKind::Boolean {
            return (this as *HIRBooleanLiteral)->ToString();
        } else if this.kind == HIRLiteralKind::Character {
            return (this as *HIRCharacterLiteral)->ToString();
        } else if this.kind == HIRLiteralKind::Integer {
            return (this as *HIRIntegerLiteral)->ToString();
        } else if this.kind == HIRLiteralKind::Float {
            return (this as *HIRFloatLiteral)->ToString();
        } else if this.kind == HIRLiteralKind::String {
            return (this as *HIRStringLiteral)->ToString();
        } else if this.kind == HIRLiteralKind::Array {
            return (this as *HIRArrayLiteral)->ToString();
        } else if this.kind == HIRLiteralKind::Structure {
            return (this as *HIRStructureLiteral)->ToString();
        } else if this.kind == HIRLiteralKind::Null {
            return (this as *HIRNullLiteral)->ToString();
        } else {
            return "<invalid literal>".ToString();
        }
    }
}

class HIRBooleanLiteral : HIRLiteral {
    pub value: bool;

    HIRBooleanLiteral(&mut this, value: bool, _type: *SemanticType) : HIRLiteral(HIRLiteralKind::Boolean, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return (this.value ? "true" : "false").ToString();
    }
}

class HIRCharacterLiteral : HIRLiteral {
    pub value: u32;

    HIRCharacterLiteral(&mut this, value: u32, _type: *SemanticType) : HIRLiteral(HIRLiteralKind::Character, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return '\'' + String(this.value as i8).Escape() + '\'';
    }
}

class HIRIntegerLiteral : HIRLiteral {
    pub value: u64;

    HIRIntegerLiteral(&mut this, value: u64, _type: *SemanticType) : HIRLiteral(HIRLiteralKind::Integer, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return String::FromInteger(this.value);
    }
}

class HIRFloatLiteral : HIRLiteral {
    pub value: f64;

    HIRFloatLiteral(&mut this, value: f64, _type: *SemanticType) : HIRLiteral(HIRLiteralKind::Float, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return String::FromFloat(this.value);
    }
}

class HIRStringLiteral : HIRLiteral {
    pub value: String;

    HIRStringLiteral(&mut this, value: String, _type: *SemanticType) : HIRLiteral(HIRLiteralKind::String, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return '"' + this.value.Escape() + '"';
    }
}

class HIRArrayLiteral : HIRLiteral {
    pub elements: Vector<*HIRExpression>;

    HIRArrayLiteral(&mut this, elements: Vector<*HIRExpression>, _type: *SemanticType) : HIRLiteral(HIRLiteralKind::Array, _type) {
        this.elements = elements;
    }

    pub fn ToString(&this) -> String {
        let mut result = '['.ToString();

        for i in 0..this.elements.Size() {
            if i > 0 { result += ", "; }
            let element: *HIRExpression = this.elements[i];
            result += element->ToString();
        } return result + ']';
    }
}

class HIRStructureLiteral : HIRLiteral {
    pub fields: Vector<*HIRExpression>;

    HIRStructureLiteral(&mut this, fields: Vector<*HIRExpression>, _type: *SemanticType) : HIRLiteral(HIRLiteralKind::Structure, _type) {
        this.fields = fields;
    }

    pub fn ToString(&this) -> String {
        let mut result = '{'.ToString();

        for i in 0..this.fields.Size() {
            if i > 0 { result += ", "; }
            let field: *HIRExpression = this.fields[i];
            result += field->ToString();
        } return result + '}';
    }
}

class HIRNullLiteral : HIRLiteral {
    HIRNullLiteral(&mut this, _type: *SemanticType) : HIRLiteral(HIRLiteralKind::Null, _type) {}

    pub fn ToString(&this) -> String {
        return "null".ToString();
    }
}

class HIRVariableReference : HIRExpression {
    pub variable: *HIRVariableStatement;

    HIRVariableReference(&mut this, variable: *HIRVariableStatement) : HIRExpression(HIRExpressionKind::VariableReference, variable->_type, HIRExpressionCategory::Place, variable->mutable) {
        this.variable = variable;
    }

    pub fn ToString(&this) -> String {
        return '%' + this.variable->name;
    }
}

class HIRDeclarationReference : HIRExpression {
    pub declaration: *HIRDeclaration;

    HIRDeclarationReference(&mut this, declaration: *HIRDeclaration, mutable: bool) : HIRExpression(HIRExpressionKind::DeclarationReference, declaration->_type, HIRExpressionCategory::Place, mutable) {
        this.declaration = declaration;
    }

    pub fn ToString(&this) -> String {
        if this.declaration->kind == HIRDeclarationKind::Parameter {
            return '%' + this.declaration->name;
        } else if this.declaration->kind == HIRDeclarationKind::Function {
            return "@\"" + this.declaration->name + '"';
        } else {
            return '@' + this.declaration->name;
        }
    }
}

class HIRDereferenceExpression : HIRExpression {
    pub operand: *HIRExpression;

    HIRDereferenceExpression(&mut this, operand: *HIRExpression) : HIRExpression(HIRExpressionKind::Dereference, operand->_type->Pointee(), HIRExpressionCategory::Place, operand->_type->IsMutable()) {
        this.operand = operand;
    }

    pub fn ToString(&this) -> String {
        return '*' + this.operand->ToString();
    }
}

class HIRAddressOfExpression : HIRExpression {
    pub operand: *HIRExpression;

    HIRAddressOfExpression(&mut this, operand: *HIRExpression, mutable: bool) : HIRExpression(HIRExpressionKind::AddressOf, analyzer->type_manager.Reference(operand->_type, mutable)) {
        this.operand = operand;
    }

    pub fn ToString(&this) -> String {
        if (this as *HIRExpression)->_type->IsMutable() {
            return "&mut " + this.operand->ToString();
        } else {
            return '&' + this.operand->ToString();
        }
    }
}

class HIRAssignmentExpression : HIRExpression {
    pub left: *HIRExpression,
    pub right: *HIRExpression;

    HIRAssignmentExpression(&mut this, left: *HIRExpression, right: *HIRExpression) : HIRExpression(HIRExpressionKind::Assignment, analyzer->type_manager.Void()) {
        (this.left, this.right) = (left, right);
    }

    pub fn ToString(&this) -> String {
        return this.left->ToString() + " = " + this.right->ToString();
    }
}

class HIRUnaryExpression : HIRExpression {
    pub _operator: TokenType,
    pub operand: *HIRExpression;

    HIRUnaryExpression(&mut this, _operator: TokenType, operand: *HIRExpression) : HIRExpression(HIRExpressionKind::Unary, operand->_type) {
        (this._operator, this.operand) = (_operator, operand);
    }

    pub fn ToString(&this) -> String {
        return ToUnaryOperatorString(this._operator) + this.operand->ToString();
    }
}

class HIRBinaryExpression : HIRExpression {
    pub _operator: TokenType,
    pub left: *HIRExpression,
    pub right: *HIRExpression;

    HIRBinaryExpression(&mut this, _operator: TokenType, left: *HIRExpression, right: *HIRExpression, _type: *SemanticType) : HIRExpression(HIRExpressionKind::Binary, _type) {
        (this._operator, this.left, this.right) = (_operator, left, right);
    }

    pub fn ToString(&this) -> String {
        return this.left->ToString() + ' ' + ToBinaryOperatorString(this._operator) + ' ' + this.right->ToString();
    }
}

class HIRTernaryExpression : HIRExpression {
    pub condition: *HIRExpression,
    pub then_value: *HIRExpression,
    pub else_value: *HIRExpression;

    HIRTernaryExpression(&mut this, condition: *HIRExpression, then_value: *HIRExpression, else_value: *HIRExpression, category: HIRExpressionCategory, mutable: bool) : HIRExpression(HIRExpressionKind::Ternary, then_value->_type, category, mutable) {
        (this.condition, this.then_value, this.else_value) = (condition, then_value, else_value);
    }

    pub fn ToString(&this) -> String {
        return this.condition->ToString() + " ? " + this.then_value->ToString() + " : " + this.else_value->ToString();
    }
}

class HIRCallExpression : HIRExpression {
    pub callee: *HIRExpression,
    pub arguments: Vector<*HIRExpression>;

    HIRCallExpression(&mut this, callee: *HIRExpression, arguments: Vector<*HIRExpression>) : HIRExpression(HIRExpressionKind::Call, callee->_type->Return()) {
        (this.callee, this.arguments) = (callee, arguments);
    }

    pub fn ToString(&this) -> String {
        let mut result = "call " + this.callee->ToString() + '(';

        for i in 0..this.arguments.Size() {
            if i != 0 { result += ", "; }
            let argument: *HIRExpression = this.arguments[i];
            result += argument->ToString();
        } return result + ')';
    }
}

class HIRCastExpression : HIRExpression {
    pub value: *HIRExpression;

    HIRCastExpression(&mut this, value: *HIRExpression, _type: *SemanticType) : HIRExpression(HIRExpressionKind::Cast, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return this.value->ToString() + " as " + (this as *HIRExpression)->_type->ToString();
    }
}

class HIRIndexAccessExpression : HIRExpression {
    pub value: *HIRExpression,
    pub index: *HIRExpression;

    HIRIndexAccessExpression(&mut this, value: *HIRExpression, index: *HIRExpression) : HIRExpression(HIRExpressionKind::IndexAccess, value->_type->AsReference()) {
        (this.value, this.index) = (value, index);
    }

    pub fn ToString(&this) -> String {
        return this.value->ToString() + '[' + this.index->ToString() + ']';
    }
}

class HIRMemberAccessExpression : HIRExpression {
    pub instance: *HIRExpression,
    pub index: usize;

    HIRMemberAccessExpression(&mut this, instance: *HIRExpression, _type: *SemanticType, index: usize) : HIRExpression(HIRExpressionKind::MemberAccess, _type, instance->category, instance->mutable) {
        (this.instance, this.index) = (instance, index);
    }

    pub fn ToString(&this) -> String {
        return this.instance->ToString() + '.' + String::FromInteger(this.index as u64); 
    }
}

class HIRNewExpression : HIRExpression {
    pub _type: *SemanticType,
    pub size: *HIRExpression;

    HIRNewExpression(&mut this, _type: *SemanticType, size: *HIRExpression) : HIRExpression(HIRExpressionKind::New, analyzer->type_manager.Pointer(_type, true)) {
        (this._type, this.size) = (_type, size);
    }

    pub fn ToString(&this) -> String {
        let mut result = "new " + this._type->ToString();

        if this.size != null {
            result += '[' + this.size->ToString() + ']';
        } return result;
    }
}

class HIRDeleteExpression : HIRExpression {
    pub value: *HIRExpression,
    pub array: bool;

    HIRDeleteExpression(&mut this, value: *HIRExpression, array: bool) : HIRExpression(HIRExpressionKind::Delete, analyzer->type_manager.Void()) {
        (this.value, this.array) = (value, array);
    }

    pub fn ToString(&this) -> String {
        return "delete " + this.value->ToString();
    }
}

class HIRConstructorExpression : HIRExpression {
    pub callee: *HIRExpression,
    pub arguments: Vector<*HIRExpression>;

    HIRConstructorExpression(&mut this, callee: *HIRExpression, arguments: Vector<*HIRExpression>, _type: *SemanticType) : HIRExpression(HIRExpressionKind::Constructor, _type) {
        (this.callee, this.arguments) = (callee, arguments);
    }

    pub fn ToString(&this) -> String {
        let mut result = "constructor " + this.callee->ToString() + '(';

        for i in 0..this.arguments.Size() {
            if i != 0 { result += ", "; }
            let argument: *HIRExpression = this.arguments[i];
            result += argument->ToString();
        } return result + ')';
    }
}

class HIRDestructorExpression : HIRExpression {
    pub instance: *HIRExpression,
    pub callee: *HIRExpression;

    HIRDestructorExpression(&mut this, instance: *HIRExpression, callee: *HIRExpression) : HIRExpression(HIRExpressionKind::Destructor, analyzer->type_manager.Void()) {
        (this.instance, this.callee) = (instance, callee);
    }

    pub fn ToString(&this) -> String {
        return "destructor " + this.callee->ToString() + '(' + this.instance->ToString() + ')';
    }
}

enum HIRIntrinsicKind: u8 {
    SizeOf, AlignOf
}

fn ToString(kind: HIRIntrinsicKind) -> String {
    if kind == HIRIntrinsicKind::SizeOf { return "sizeof".ToString(); }
    else if kind == HIRIntrinsicKind::AlignOf { return "alignof".ToString(); }
    else { return "<invalid intrinsic>".ToString(); }
}

class HIRIntrinsicExpression : HIRExpression {
    pub kind: HIRIntrinsicKind,
    pub _type: *SemanticType;

    HIRIntrinsicExpression(&mut this, kind: HIRIntrinsicKind, _type: *SemanticType) : HIRExpression(HIRExpressionKind::Intrinsic, analyzer->type_manager.IntegerPointer(false)) {
        (this.kind, this._type) = (kind, _type);
    }

    pub fn ToString(&this) -> String {
        return ToString(this.kind) + '(' + this._type->ToString() + ')';
    }
}

class HIRDeferredExpression : HIRExpression {
    pub expression: *ASTExpression;

    HIRDeferredExpression(&mut this, expression: *ASTExpression, _type: *SemanticType) : HIRExpression(HIRExpressionKind::Deferred, _type) {
        this.expression = expression;
    }

    pub fn ToString(&this) -> String {
        return "<deferred expression>".ToString();
    }
}

enum HIRStatementKind: u8 {
    Block, Variable, Expression, Return, Break, Continue, If, While, Loop, For
}

class HIRStatement {
    pub kind: HIRStatementKind;

    HIRStatement(&mut this, kind: HIRStatementKind) {
        this.kind = kind;
    }

    pub fn ToString(&this, indent: usize) -> String {
        if this.kind == HIRStatementKind::Block {
            return (this as *HIRBlockStatement)->ToString(indent);
        } else if this.kind == HIRStatementKind::Variable {
            return (' ' * indent * 4) + (this as *HIRVariableStatement)->ToString();
        } else if this.kind == HIRStatementKind::Expression {
            return (' ' * indent * 4) + (this as *HIRExpressionStatement)->ToString();
        } else if this.kind == HIRStatementKind::Return {
            return (' ' * indent * 4) + (this as *HIRReturnStatement)->ToString();
        } else if this.kind == HIRStatementKind::Break {
            return (' ' * indent * 4) + (this as *HIRBreakStatement)->ToString();
        } else if this.kind == HIRStatementKind::Continue {
            return (' ' * indent * 4) + (this as *HIRContinueStatement)->ToString();
        } else if this.kind == HIRStatementKind::If {
            return (' ' * indent * 4) + (this as *HIRIfStatement)->ToString(indent);
        } else if this.kind == HIRStatementKind::While {
            return (' ' * indent * 4) + (this as *HIRWhileStatement)->ToString(indent);
        } else if this.kind == HIRStatementKind::Loop {
            return (' ' * indent * 4) + (this as *HIRLoopStatement)->ToString(indent);
        } else if this.kind == HIRStatementKind::For {
            return (' ' * indent * 4) + (this as *HIRForStatement)->ToString(indent);
        } else {
            return (' ' * indent * 4) + "<invalid statement>".ToString();
        }
    }
}

class HIRBlockStatement : HIRStatement {
    pub statements: Vector<*HIRStatement>;

    HIRBlockStatement(&mut this) : HIRStatement(HIRStatementKind::Block) {}

    pub fn ToString(&this, indent: usize) -> String {
        let mut result = '{'.ToString();

        if !this.statements.Empty() {
            result += '\n';

            for i in 0..this.statements.Size() {
                result += this.statements[i]->ToString(indent + 1) + '\n';
            } result += (' ' * indent * 4) + '}';
        } else {
            result += '}';
        } return result;
    }
}

class HIRVariableStatement : HIRStatement {
    pub name: String,
    pub _type: *SemanticType,
    pub initializer: *HIRExpression,
    pub mutable: bool;

    HIRVariableStatement(&mut this, name: String, _type: *SemanticType, initializer: *HIRExpression, mutable: bool) : HIRStatement(HIRStatementKind::Variable) {
        (this.name, this._type, this.initializer, this.mutable) = (name, _type, initializer, mutable);
    }

    pub fn ToString(&this) -> String {
        let mut result = "let %" + this.name + ": " + this._type->ToString();

        if this.initializer != null {
            result += " = " + this.initializer->ToString();
        } return result;
    }
}

class HIRExpressionStatement : HIRStatement {
    pub expression: *HIRExpression;

    HIRExpressionStatement(&mut this, expression: *HIRExpression) : HIRStatement(HIRStatementKind::Expression) {
        this.expression = expression;
    }

    pub fn ToString(&this) -> String {
        return this.expression->ToString();
    }
}

class HIRReturnStatement : HIRStatement {
    pub expression: *HIRExpression;

    HIRReturnStatement(&mut this, expression: *HIRExpression) : HIRStatement(HIRStatementKind::Return) {
        this.expression = expression;
    }

    pub fn ToString(&this) -> String {
        let mut result = "return".ToString();

        if this.expression != null {
            result += ' ' + this.expression->ToString();
        } return result;
    }
}

class HIRBreakStatement : HIRStatement {
    HIRBreakStatement(&mut this) : HIRStatement(HIRStatementKind::Break) {}

    pub fn ToString(&this) -> String {
        return "break".ToString();
    }
}

class HIRContinueStatement : HIRStatement {
    HIRContinueStatement(&mut this) : HIRStatement(HIRStatementKind::Continue) {}

    pub fn ToString(&this) -> String {
        return "continue".ToString();
    }
}

class HIRIfStatement : HIRStatement {
    pub condition: *HIRExpression,
    pub then_body: *HIRBlockStatement,
    pub else_body: *HIRBlockStatement;

    HIRIfStatement(&mut this, condition: *HIRExpression, then_body: *HIRBlockStatement, else_body: *HIRBlockStatement) : HIRStatement(HIRStatementKind::If) {
        (this.condition, this.then_body, this.else_body) = (condition, then_body, else_body);
    }

    pub fn ToString(&this, indent: usize) -> String {
        let mut result = "if " + this.condition->ToString() + ' ' + this.then_body->ToString(indent);

        if this.else_body != null {
            result += " else " + this.else_body->ToString(indent);
        } return result;
    }
}

class HIRWhileStatement : HIRStatement {
    pub condition: *HIRExpression,
    pub while_body: *HIRBlockStatement,
    pub else_body: *HIRBlockStatement;

    HIRWhileStatement(&mut this, condition: *HIRExpression, while_body: *HIRBlockStatement, else_body: *HIRBlockStatement) : HIRStatement(HIRStatementKind::While) {
        (this.condition, this.while_body, this.else_body) = (condition, while_body, else_body);
    }

    pub fn ToString(&this, indent: usize) -> String {
        return "while " + this.condition->ToString() + ' ' + this.while_body->ToString(indent);
    }
}

class HIRLoopStatement : HIRStatement {
    pub body: *HIRBlockStatement;

    HIRLoopStatement(&mut this, body: *HIRBlockStatement) : HIRStatement(HIRStatementKind::Loop) {
        this.body = body;
    }

    pub fn ToString(&this, indent: usize) -> String {
        return "loop " + this.body->ToString(indent);
    }
}

class HIRForStatement : HIRStatement {
    pub iterator: *HIRVariableStatement,
    pub variable: *HIRVariableStatement,
    pub condition: *HIRExpression,
    pub step: *HIRExpression,
    pub body: *HIRBlockStatement;

    HIRForStatement(&mut this, iterator: *HIRVariableStatement, variable: *HIRVariableStatement, condition: *HIRExpression, step: *HIRExpression, body: *HIRBlockStatement) : HIRStatement(HIRStatementKind::For) {
        (this.iterator, this.variable, this.condition, this.step, this.body) = (iterator, variable, condition, step, body);
    }

    pub fn ToString(&this, indent: usize) -> String {
        return "for " + this.iterator->ToString() + ", " + this.condition->ToString() + ", " + this.step->ToString() + ' ' + this.body->ToString(indent);
    }
}

enum HIRDeclarationKind: u8 {
    Parameter, Function, Field, Class, Structure, Member, Enumeration, Constant, Static
}

enum HIRDeclarationABI: u8 {
    Native, C
}

enum HIRDeclarationLinkage: u8 {
    Private, Internal, External
}

class HIRDeclaration {
    pub kind: HIRDeclarationKind,
    pub abi: HIRDeclarationABI = ::HIRDeclarationABI::Native,
    pub linkage: HIRDeclarationLinkage = ::HIRDeclarationLinkage::External,
    pub name: String,
    pub _type: *SemanticType;

    HIRDeclaration(&mut this, kind: HIRDeclarationKind, name: String, _type: *SemanticType) {
        (this.kind, this.name, this._type) = (kind, name, _type);
    }

    HIRDeclaration(&mut this, kind: HIRDeclarationKind, abi: HIRDeclarationABI, name: String, _type: *SemanticType) {
        (this.kind, this.abi, this.name, this._type) = (kind, abi, name, _type);
    }

    HIRDeclaration(&mut this, kind: HIRDeclarationKind, linkage: HIRDeclarationLinkage, name: String, _type: *SemanticType) {
        (this.kind, this.linkage, this.name, this._type) = (kind, linkage, name, _type);
    }

    pub fn ToString(&this) -> String {
        if this->kind == HIRDeclarationKind::Parameter {
            return (this as *HIRParameterDeclaration)->ToString();
        } else if this->kind == HIRDeclarationKind::Function {
            return (this as *HIRFunctionDeclaration)->ToString(0);
        } else if this->kind == HIRDeclarationKind::Field {
            return (this as *HIRFieldDeclaration)->ToString();
        } else if this->kind == HIRDeclarationKind::Class {
            return (this as *HIRClassDeclaration)->ToString();
        } else if this->kind == HIRDeclarationKind::Structure {
            return (this as *HIRStructureDeclaration)->ToString();
        } else if this->kind == HIRDeclarationKind::Member {
            return (this as *HIRMemberDeclaration)->ToString();
        } else if this->kind == HIRDeclarationKind::Enumeration {
            return (this as *HIREnumerationDeclaration)->ToString();
        } else if this->kind == HIRDeclarationKind::Constant {
            return (this as *HIRConstantDeclaration)->ToString();
        } else if this->kind == HIRDeclarationKind::Static {
            return (this as *HIRStaticDeclaration)->ToString();
        } else {
            return "<invalid declaration>".ToString();
        }
    }
}

class HIRParameterDeclaration : HIRDeclaration {
    pub mutable: bool;

    HIRParameterDeclaration(&mut this, name: String, _type: *SemanticType, mutable: bool) : HIRDeclaration(HIRDeclarationKind::Parameter, name, _type) {
        this.mutable = mutable;
    }

    pub fn ToString(&this) -> String {
        let declaration = this as *HIRDeclaration;
        return '%' + declaration->name + ": " + declaration->_type->ToString();
    }
}

class HIRFunctionDeclaration : HIRDeclaration {
    pub no_mangle: bool,
    pub parameters: Vector<*HIRParameterDeclaration>,
    pub _return: *SemanticType,
    pub body: *HIRBlockStatement = null;

    HIRFunctionDeclaration(&mut this, name: String, parameters: Vector<*HIRParameterDeclaration>, _return: *SemanticType, _type: *SemanticType, no_mangle: bool, abi: HIRDeclarationABI) : HIRDeclaration(HIRDeclarationKind::Function, abi, name, _type) {
        (this.parameters, this._return, this.no_mangle) = (parameters, _return, no_mangle);
    }

    pub fn ToString(&this, indent: usize) -> String {
        let declaration = this as *HIRDeclaration;
        let mut result = "fn @\"" + declaration->name + "\"(";

        for i in 0..this.parameters.Size() {
            if i != 0 { result += ", "; }
            let parameter: *HIRParameterDeclaration = this.parameters[i];
            result += parameter->ToString();
        } result += ')';

        if !declaration->_type->Return().IsVoid() {
            result += " -> " + declaration->_type->Return().ToString();
        }

        if this.body != null {
            result += ' ' + this.body->ToString(indent);
        } return result;
    }
}

class HIRFieldDeclaration : HIRDeclaration {
    pub initializer: *ASTExpression,
    pub public: bool;

    HIRFieldDeclaration(&mut this, name: String, _type: *SemanticType, initializer: *ASTExpression, public: bool) : HIRDeclaration(HIRDeclarationKind::Field, name, _type) {
        (this.initializer, this.public) = (initializer, public);
    }

    pub fn ToString(&this) -> String {
        let declaration = this as *HIRDeclaration;
        let mut result = '%' + declaration->name + ": " + declaration->_type->ToString();

        if this.initializer != null {
            result += " = " + this.initializer->ToString();
        } return result;
    }
}

class HIRClassDeclaration : HIRDeclaration {
    pub fields: Vector<*HIRFieldDeclaration>,
    pub constructors: Vector<*HIRFunctionDeclaration>,
    pub destructor: *HIRFunctionDeclaration = null,
    pub methods: Vector<*HIRFunctionDeclaration>;

    HIRClassDeclaration(&mut this, name: String, _type: *SemanticType) : HIRDeclaration(HIRDeclarationKind::Class, name, _type) {}

    pub fn ToString(&this) -> String {
        let mut result = "class %" + (this as *HIRDeclaration)->name + " {";

        if !this.fields.Empty() {
            result += '\n';

            for i in 0..this.fields.Size() {
                if i != 0 { result += ",\n"; }
                let field: *HIRFieldDeclaration = this.fields[i];
                result += "    " + field->ToString();
            }

            if !this.constructors.Empty() || this.destructor != null || !this.methods.Empty() {
                result += ';';
            } result += '\n';
        }

        for constructor in this.constructors {
            result += "\n    " + constructor->ToString(1) + '\n';
        }

        if this.destructor != null {
            result += "\n    " + this.destructor->ToString(1) + '\n';
        }

        for method in this.methods {
            result += "\n    " + method->ToString(1) + '\n';
        } return result + '}';
    }
}

class HIRStructureDeclaration : HIRDeclaration {
    pub fields: Vector<*HIRFieldDeclaration>,
    pub methods: Vector<*HIRFunctionDeclaration>;

    HIRStructureDeclaration(&mut this, name: String, _type: *SemanticType) : HIRDeclaration(HIRDeclarationKind::Structure, name, _type) {}

    pub fn ToString(&this) -> String {
        let mut result = "struct %" + (this as *HIRDeclaration)->name + " {";

        if !this.fields.Empty() {
            result += '\n';

            for i in 0..this.fields.Size() {
                if i != 0 { result += ",\n"; }
                let field: *HIRFieldDeclaration = this.fields[i];
                result += "    " + field->ToString();
            }

            if !this.methods.Empty() {
                result += ';';
            } result += '\n';
        }

        for method in this.methods {
            result += "\n    " + method->ToString(1) + '\n';
        } return result + '}';
    }
}

class HIRMemberDeclaration : HIRDeclaration {
    pub value: *HIRExpression;

    HIRMemberDeclaration(&mut this, name: String, value: *HIRExpression, _type: *SemanticType) : HIRDeclaration(HIRDeclarationKind::Member, name, _type) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        let mut result = '%' + (this as *HIRDeclaration)->name;

        if this.value != null {
            result += " = " + this.value->ToString();
        } return result;
    }
}

class HIREnumerationDeclaration : HIRDeclaration {
    pub members: Vector<*HIRMemberDeclaration>;

    HIREnumerationDeclaration(&mut this, name: String, _type: *SemanticType) : HIRDeclaration(HIRDeclarationKind::Enumeration, name, _type) {}

    pub fn ToString(&this) -> String {
        let declaration = this as *HIRDeclaration;
        let underlying = analyzer->type_manager->Integer(declaration->_type->width, declaration->_type->signed);
        let mut result = "enum %" + declaration->name + ": " + underlying->ToString() + " {";

        if !this.members.Empty() {
            result += '\n';

            for i in 0..this.members.Size() {
                if i != 0 { result += ",\n"; }
                let member: *HIRMemberDeclaration = this.members[i];
                result += "    " + member->ToString();
            } result += '\n';
        } return result + '}';
    }
}

class HIRConstantDeclaration : HIRDeclaration {
    pub initializer: *HIRExpression;

    HIRConstantDeclaration(&mut this, name: String, _type: *SemanticType, initializer: *HIRExpression) : HIRDeclaration(HIRDeclarationKind::Constant, name, _type) {
        this.initializer = initializer;
    }

    pub fn ToString(&this) -> String {
        let declaration = this as *HIRDeclaration;
        return "const @" + declaration->name + ": " + declaration->_type->ToString() + " = " + this.initializer->ToString();
    }
}

class HIRStaticDeclaration : HIRDeclaration {
    pub initializer: *HIRExpression,
    pub alignment: *HIRExpression,
    pub mutable: bool;

    HIRStaticDeclaration(&mut this, name: String, _type: *SemanticType, initializer: *HIRExpression, alignment: *HIRExpression, mutable: bool, linkage: HIRDeclarationLinkage) : HIRDeclaration(HIRDeclarationKind::Static, linkage, name, _type) {
        (this.initializer, this.alignment, this.mutable) = (initializer, alignment, mutable);
    }

    pub fn ToString(&this) -> String {
        let declaration = this as *HIRDeclaration;
        let mut result = "static @" + declaration->name + ": " + declaration->_type->ToString();

        if this.initializer != null {
            result += " = " + this.initializer->ToString();
        } return result;
    }
}

class HIRModule {
    pub declarations: Vector<*HIRDeclaration>;

    HIRModule(&mut this) {}

    pub fn ToString(&this) -> String {
        let mut result = String();
        let mut previous: *HIRDeclaration = null;

        for declaration in this.declarations {
            if previous != null {
                result += '\n';

                if previous->kind != declaration->kind || (declaration->kind == HIRDeclarationKind::Class || declaration->kind == HIRDeclarationKind::Structure || declaration->kind == HIRDeclarationKind::Enumeration) {
                    result += '\n';
                } else if declaration->kind == HIRDeclarationKind::Function {
                    let current = declaration as *HIRFunctionDeclaration;
                    let previous = previous as *HIRFunctionDeclaration;

                    if current->body != null || previous->body != null {
                        result += '\n';
                    }
                }
            }

            result += declaration->ToString();
            previous = declaration;
        } return result;
    }
}

class HIRContext {
    pub arena: Arena;

    HIRContext(&mut this) {}

    pub fn VoidType(&mut this) -> *HIRType {
        return this.arena.New<HIRVoidType>();
    }

    pub fn BooleanType(&mut this) -> *HIRType {
        return this.arena.New<HIRBooleanType>();
    }

    pub fn CharacterType(&mut this) -> *HIRType {
        return this.arena.New<HIRCharacterType>();
    }

    pub fn IntegerType(&mut this, width: u32, signed: bool, literal: bool, native: bool) -> *HIRType {
        return this.arena.New<HIRIntegerType>(width, signed, literal, native);
    }

    pub fn FloatType(&mut this, width: u32, literal: bool) -> *HIRType {
        return this.arena.New<HIRFloatType>(width, literal);
    }

    pub fn PointerType(&mut this, pointee: *HIRType, mutable: bool) -> *HIRType {
        return this.arena.New<HIRPointerType>(pointee, mutable);
    }

    pub fn ReferenceType(&mut this, referent: *HIRType, mutable: bool) -> *HIRType {
        return this.arena.New<HIRReferenceType>(referent, mutable);
    }

    pub fn ArrayType(&mut this, element: *HIRType, length: usize) -> *HIRType {
        return this.arena.New<HIRArrayType>(element, length);
    }

    pub fn FunctionType(&mut this, parameters: Vector<*HIRType>, _return: *HIRType) -> *HIRType {
        return this.arena.New<HIRFunctionType>(parameters, _return);
    }

    pub fn ClassType(&mut this, name: String) -> *HIRType {
        return this.arena.New<HIRClassType>(name);
    }

    pub fn StructureType(&mut this, name: String) -> *HIRType {
        return this.arena.New<HIRStructureType>(name);
    }

    pub fn EnumerationType(&mut this, name: String, underlying: *HIRType) -> *HIRType {
        return this.arena.New<HIREnumerationType>(name, underlying);
    }
}

class HIRBuilder {
    context: *mut HIRContext,
    module: *mut HIRModule,
    function: *mut HIRFunctionDeclaration = null,
    block: *mut HIRBlockStatement = null;

    HIRBuilder(&mut this, context: *mut HIRContext, module: *mut HIRModule) {
        (this.context, this.module) = (context, module);
    }

    pub fn BooleanLiteral(&mut this, value: bool, _type: *SemanticType) -> *mut HIRBooleanLiteral {
        return this.context->arena.New<HIRBooleanLiteral>(value, _type);
    }

    pub fn CharacterLiteral(&mut this, value: u32, _type: *SemanticType) -> *mut HIRCharacterLiteral {
        return this.context->arena.New<HIRCharacterLiteral>(value, _type);
    }

    pub fn IntegerLiteral(&mut this, value: u64, _type: *SemanticType) -> *mut HIRIntegerLiteral {
        return this.context->arena.New<HIRIntegerLiteral>(value, _type);
    }

    pub fn FloatLiteral(&mut this, value: f64, _type: *SemanticType) -> *mut HIRFloatLiteral {
        return this.context->arena.New<HIRFloatLiteral>(value, _type);
    }

    pub fn StringLiteral(&mut this, value: String, _type: *SemanticType) -> *mut HIRStringLiteral {
        return this.context->arena.New<HIRStringLiteral>(value, _type);
    }

    pub fn ArrayLiteral(&mut this, elements: Vector<*HIRExpression>, _type: *SemanticType) -> *mut HIRArrayLiteral {
        return this.context->arena.New<HIRArrayLiteral>(elements, _type);
    }

    pub fn StructureLiteral(&mut this, fields: Vector<*HIRExpression>, _type: *SemanticType) -> *mut HIRStructureLiteral {
        return this.context->arena.New<HIRStructureLiteral>(fields, _type);
    }

    pub fn NullLiteral(&mut this, _type: *SemanticType) -> *mut HIRNullLiteral {
        return this.context->arena.New<HIRNullLiteral>(_type);
    }

    pub fn ReferenceVariable(&mut this, variable: *HIRVariableStatement) -> *mut HIRVariableReference {
        return this.context->arena.New<HIRVariableReference>(variable);
    }

    pub fn ReferenceDeclaration(&mut this, declaration: *HIRDeclaration, mutable: bool) -> *mut HIRDeclarationReference {
        return this.context->arena.New<HIRDeclarationReference>(declaration, mutable);
    }

    pub fn Dereference(&mut this, operand: *HIRExpression) -> *mut HIRDereferenceExpression {
        return this.context->arena.New<HIRDereferenceExpression>(operand);
    }

    pub fn AddressOf(&mut this, operand: *HIRExpression, mutable: bool) -> *mut HIRAddressOfExpression {
        return this.context->arena.New<HIRAddressOfExpression>(operand, mutable);
    }

    pub fn Assignment(&mut this, left: *HIRExpression, right: *HIRExpression) -> *mut HIRAssignmentExpression {
        return this.context->arena.New<HIRAssignmentExpression>(left, right);
    }

    pub fn Unary(&mut this, _operator: TokenType, operand: *HIRExpression) -> *mut HIRUnaryExpression {
        return this.context->arena.New<HIRUnaryExpression>(_operator, operand);
    }

    pub fn Binary(&mut this, _operator: TokenType, left: *HIRExpression, right: *HIRExpression, _type: *SemanticType) -> *mut HIRBinaryExpression {
        return this.context->arena.New<HIRBinaryExpression>(_operator, left, right, _type);
    }

    pub fn Ternary(&mut this, condition: *HIRExpression, then_value: *HIRExpression, else_value: *HIRExpression, category: HIRExpressionCategory, mutable: bool) -> *mut HIRTernaryExpression {
        return this.context->arena.New<HIRTernaryExpression>(condition, then_value, else_value, category, mutable);
    }

    pub fn Call(&mut this, callee: *HIRExpression, arguments: Vector<*HIRExpression>) -> *mut HIRCallExpression {
        return this.context->arena.New<HIRCallExpression>(callee, arguments);
    }

    pub fn Cast(&mut this, value: *HIRExpression, _type: *SemanticType) -> *mut HIRCastExpression {
        return this.context->arena.New<HIRCastExpression>(value, _type);
    }

    pub fn IndexAccess(&mut this, value: *HIRExpression, index: *HIRExpression) -> *mut HIRIndexAccessExpression {
        return this.context->arena.New<HIRIndexAccessExpression>(value, index);
    }

    pub fn MemberAccess(&mut this, instance: *HIRExpression, _type: *SemanticType, index: usize) -> *mut HIRMemberAccessExpression {
        return this.context->arena.New<HIRMemberAccessExpression>(instance, _type, index);
    }

    pub fn New(&mut this, _type: *SemanticType, size: *HIRExpression) -> *mut HIRNewExpression {
        return this.context->arena.New<HIRNewExpression>(_type, size);
    }

    pub fn Delete(&mut this, value: *HIRExpression, array: bool) -> *mut HIRDeleteExpression {
        return this.context->arena.New<HIRDeleteExpression>(value, array);
    }

    pub fn Constructor(&mut this, callee: *HIRExpression, arguments: Vector<*HIRExpression>, _type: *SemanticType) -> *mut HIRConstructorExpression {
        return this.context->arena.New<HIRConstructorExpression>(callee, arguments, _type);
    }

    pub fn Destructor(&mut this, instance: *HIRExpression, callee: *HIRExpression) -> *mut HIRDestructorExpression {
        return this.context->arena.New<HIRDestructorExpression>(instance, callee);
    }

    pub fn Intrinsic(&mut this, kind: HIRIntrinsicKind, _type: *SemanticType) -> *mut HIRIntrinsicExpression {
        return this.context->arena.New<HIRIntrinsicExpression>(kind, _type);
    }

    pub fn Deferred(&mut this, expression: *ASTExpression, _type: *SemanticType) -> *mut HIRDeferredExpression {
        return this.context->arena.New<HIRDeferredExpression>(expression, _type);
    }

    pub fn BuildBlockStatement(&mut this) -> *mut HIRBlockStatement {
        return this.context->arena.New<HIRBlockStatement>();
    }

    pub fn SetCurrentBlock(&mut this, block: *mut HIRBlockStatement) {
        this.block = block;
    }

    pub fn GetCurrentBlock(&this) -> *mut HIRBlockStatement {
        return this.block;
    }

    pub fn BuildVariableStatement(&mut this, name: String, _type: *SemanticType, initializer: *HIRExpression, mutable: bool) -> *mut HIRVariableStatement {
        let variable = this.context->arena.New<HIRVariableStatement>(name, _type, initializer, mutable);
        this.block->statements.PushBack(variable);
        return variable;
    }

    pub fn BuildExpressionStatement(&mut this, expression: *HIRExpression) -> *mut HIRExpressionStatement {
        let statement = this.context->arena.New<HIRExpressionStatement>(expression);
        this.block->statements.PushBack(statement);
        return statement;
    }

    pub fn BuildReturnStatement(&mut this, value: *HIRExpression) -> *mut HIRReturnStatement {
        let _return = this.context->arena.New<HIRReturnStatement>(value);
        this.block->statements.PushBack(_return);
        return _return;
    }

    pub fn BuildBreakStatement(&mut this) -> *mut HIRBreakStatement {
        let _break = this.context->arena.New<HIRBreakStatement>();
        this.block->statements.PushBack(_break);
        return _break;
    }

    pub fn BuildContinueStatement(&mut this) -> *mut HIRContinueStatement {
        let _continue = this.context->arena.New<HIRContinueStatement>();
        this.block->statements.PushBack(_continue);
        return _continue;
    }

    pub fn BuildIfStatement(&mut this, condition: *HIRExpression, then_body: *HIRBlockStatement, else_body: *HIRBlockStatement) -> *mut HIRIfStatement {
        let statement = this.context->arena.New<HIRIfStatement>(condition, then_body, else_body);
        this.block->statements.PushBack(statement);
        return statement;
    }

    pub fn BuildWhileStatement(&mut this, condition: *HIRExpression, while_body: *HIRBlockStatement, else_body: *HIRBlockStatement) -> *mut HIRWhileStatement {
        let statement = this.context->arena.New<HIRWhileStatement>(condition, while_body, else_body);
        this.block->statements.PushBack(statement);
        return statement;
    }

    pub fn BuildLoopStatement(&mut this, body: *HIRBlockStatement) -> *mut HIRLoopStatement {
        let statement = this.context->arena.New<HIRLoopStatement>(body);
        this.block->statements.PushBack(statement);
        return statement;
    }

    pub fn BuildForStatement(&mut this, iterator: *HIRVariableStatement, variable: *HIRVariableStatement, condition: *HIRExpression, step: *HIRExpression, body: *HIRBlockStatement) -> *mut HIRForStatement {
        let statement = this.context->arena.New<HIRForStatement>(iterator, variable, condition, step, body);
        this.block->statements.PushBack(statement);
        return statement;
    }

    pub fn BuildParameterDeclaration(&mut this, name: String, _type: *SemanticType, mutable: bool) -> *mut HIRParameterDeclaration {
        return this.context->arena.New<HIRParameterDeclaration>(name, _type, mutable);
    }

    pub fn BuildFunctionDeclaration(&mut this, name: String, parameters: Vector<*HIRParameterDeclaration>, _return: *SemanticType, _type: *SemanticType, no_mangle: bool, abi: HIRDeclarationABI) -> *mut HIRFunctionDeclaration {
        return this.context->arena.New<HIRFunctionDeclaration>(name, parameters, _return, _type, no_mangle, abi);
    }

    pub fn SetCurrentFunction(&mut this, function: *mut HIRFunctionDeclaration) {
        this.function = function;
    }

    pub fn GetCurrentFunction(&this) -> *mut HIRFunctionDeclaration {
        return this.function;
    }

    pub fn BuildFieldDeclaration(&mut this, name: String, _type: *SemanticType, initializer: *ASTExpression, public: bool) -> *mut HIRFieldDeclaration {
        return this.context->arena.New<HIRFieldDeclaration>(name, _type, initializer, public);
    }

    pub fn BuildClassDeclaration(&mut this, name: String, _type: *SemanticType) -> *mut HIRClassDeclaration {
        let declaration = this.context->arena.New<HIRClassDeclaration>(name, _type);
        this.module->declarations.PushBack(declaration);
        return declaration;
    }

    pub fn BuildStructureDeclaration(&mut this, name: String, _type: *SemanticType) -> *mut HIRStructureDeclaration {
        let declaration = this.context->arena.New<HIRStructureDeclaration>(name, _type);
        this.module->declarations.PushBack(declaration);
        return declaration;
    }

    pub fn BuildMemberDeclaration(&mut this, name: String, value: *HIRExpression, _type: *SemanticType) -> *mut HIRMemberDeclaration {
        return this.context->arena.New<HIRMemberDeclaration>(name, value, _type);
    }

    pub fn BuildEnumerationDeclaration(&mut this, name: String, _type: *SemanticType) -> *mut HIREnumerationDeclaration {
        let declaration = this.context->arena.New<HIREnumerationDeclaration>(name, _type);
        this.module->declarations.PushBack(declaration);
        return declaration;
    }

    pub fn BuildConstantDeclaration(&mut this, name: String, _type: *SemanticType, initializer: *HIRExpression) -> *mut HIRConstantDeclaration {
        let declaration = this.context->arena.New<HIRConstantDeclaration>(name, _type, initializer);
        this.module->declarations.PushBack(declaration);
        return declaration;
    }

    pub fn BuildStaticDeclaration(&mut this, name: String, _type: *SemanticType, initializer: *HIRExpression, alignment: *HIRExpression, mutable: bool, linkage: HIRDeclarationLinkage) -> *mut HIRStaticDeclaration {
        let declaration = this.context->arena.New<HIRStaticDeclaration>(name, _type, initializer, alignment, mutable, linkage);
        this.module->declarations.PushBack(declaration);
        return declaration;
    }
}

#[include "src/SemanticAnalyzer.zir" : *]
