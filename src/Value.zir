#[include "std/str", "vendor/llvm", "src/Types.zir" : *]

const F32_MAX: f64 = 3.40282347e+38;
const F64_MAX: f64 = 1.7976931348623157e+308;

class QualifiedValue {
    priv value: LLVMValueRef = null, priv _type: *const QualifiedType = null,
    pub instance: LLVMValueRef = null, pub instance_type: *const QualifiedType = null,
    priv lvalue: bool = false, pub return: bool = false,
    priv deferred_integer: u64 = 0, priv deferred_float: f64 = 0.0,
    pub deferred_node: *const Node = null;

    QualifiedValue(&mut this, value: LLVMValueRef, _type: *const QualifiedType) {
        (this.value, this._type) = (value, _type);
    }

    QualifiedValue(&mut this, value: LLVMValueRef, _type: *const QualifiedType, instance: &QualifiedValue) {
        (this.value, this._type, this.instance, this.instance_type) = (value, _type, instance.value, instance._type);
    }

    QualifiedValue(&mut this, value: LLVMValueRef, _type: *const QualifiedType, lvalue: bool, return: bool) {
        (this.value, this._type, this.lvalue, this.return) = (value, _type, lvalue, return);
    }

    QualifiedValue(&mut this, value: LLVMValueRef, _type: *const QualifiedType, lvalue: bool) {
        (this.value, this._type, this.lvalue) = (value, _type, lvalue);
    }

    QualifiedValue(&mut this, _type: *const QualifiedType, deferred_integer: u64) {
        (this._type, this.deferred_integer) = (_type, deferred_integer);
    }

    QualifiedValue(&mut this, _type: *const QualifiedType, deferred_float: f64) {
        (this._type, this.deferred_float) = (_type, deferred_float);
    }

    QualifiedValue(&mut this, _type: *const QualifiedType, deferred_node: *const Node) {
        (this._type, this.deferred_node) = (_type, deferred_node);
    }

    pub Null(&this) -> bool {
        ret this.value == null && this._type == null;
    }

    pub Value(&this) -> LLVMValueRef {
        if this.value == null {
            Logger::Log("QualifiedValue", "Null value!", LogSeverity::Fatal);
        } ret this.value;
    }

    pub Type(&this) -> &QualifiedType {
        if this._type == null {
            Logger::Log("QualifiedValue", "Null type!", LogSeverity::Fatal);
        } ret this._type;
    }

    pub Materialize(&this, target: &QualifiedType) -> QualifiedValue {
        if this.deferred_node != null {
            ret compiler->CompileExpression(this.deferred_node, target, true).Materialize(target);
        }

        if this.Type().IsInteger() && this.Type().IsLiteral() && target.IsPointer() {
            if !(target.IsReference() && target.Pointee().IsInteger()) {
                ret this.Materialize(compiler->type_manager.IntegerPointer(false));
            }
        }

        if this.Type().IsInteger() && this.Type().IsLiteral() && target.IsInteger() {
            let mut value = this.deferred_integer;
            let size = LLVMPointerSize(compiler->target->layout) as usize * 8;
            let width = target.width == 0 ? size : target.width as usize;

            if width < size {
                if value as usize >= (target.IsSigned() ? 1 << (width - 1) : 1 << width) {
                    Logger::Log("Integer literal '" + String(value) + "' overflows target type '" + target.ToString() + "'.", LogSeverity::Error);
                    value = 0;
                }
            }

            ret QualifiedValue(LLVMConstInt(target.Value(), value, target.IsSigned() ? 1 : 0), target);
        } else if this.Type().IsFloat() && this.Type().IsLiteral() && target.IsFloat() {
            let mut value = this.deferred_float;

            if (value < 0.0 ? -value : value) > (target.width == 32 ? F32_MAX : F64_MAX) {
                Logger::Log("Float literal '" + String(value) + "' overflows target type '" + target.ToString() + "'.", LogSeverity::Error);
                value = 0.0;
            }

            ret QualifiedValue(LLVMConstReal(target.Value(), value), target);
        } else {
            ret this;
        }
    }

    pub MaterializeWithFallback(&this, target: &QualifiedType) -> QualifiedValue {
        if this.deferred_node != null {
            ret compiler->CompileExpression(this.deferred_node, target, true).MaterializeWithFallback(target);
        }

        let value = this.Materialize(target);

        if value.Type().IsLiteral() {
            ret value.Materialize();
        } else {
            ret value;
        }
    }

    pub Materialize(&this) -> QualifiedValue {
        if this.deferred_node != null {
            ret compiler->CompileExpression(this.deferred_node, null, true).Materialize();
        }

        if this.Type().kind == TypeKind::IntegerLiteral {
            let (mut width: u32, mut signed) = (32, true);

            if this.deferred_integer >= (1 << 31) {
                width = 64;

                if this.deferred_integer > (1 << 63) - 1 {
                    signed = false;
                }
            }

            ret this.Materialize(compiler->type_manager.Integer(width, signed));
        } else if this.Type().kind == TypeKind::FloatLiteral {
            ret this.Materialize(compiler->type_manager.Float(64));
        } else {
            ret this;
        }
    }

    pub Load(&this, args...) -> QualifiedValue {
        if LLVMIsAGlobalVariable(this.Value()) != null {
            if LLVMIsGlobalConstant(this.Value()) != 0 && !this.Type().Pointee().IsClass() && !this.Type().Pointee().IsPointer() {
                ret QualifiedValue(LLVMGetInitializer(this.Value()), this.Type().Pointee()); // args...
            }
        }

        ret QualifiedValue(LLVMBuildLoad2(compiler->builder, this.Type().Pointee().Value(), this.Value(), ""), this.Type().Pointee(), args...);
    }

    pub IsLValue(&this) -> bool { ret this.lvalue; }
    pub IsRValue(&this) -> bool { ret !this.lvalue; }

    pub ToRValue(&this) -> QualifiedValue {
        if this.IsLValue() {
            if this.Type().Pointee().IsArray() {
                let _type = compiler->type_manager.Pointer(this.Type().Pointee().Element(), this.Type().IsMutable());
                ret QualifiedValue(LLVMBuildBitCast(compiler->builder, this.Value(), _type.Value(), ""), _type);
            } else {
                ret this.Load();
            }
        } ret this;
    }

    pub ToRValueType(&this) -> &QualifiedType {
        if this.IsLValue() {
            if this.Type().Pointee().IsArray() {
                ret compiler->type_manager.Pointer(this.Type().Pointee().Element(), this.Type().IsMutable());
            } else {
                ret this.Type().Pointee();
            }
        } ret this.Type();
    }

    pub MakeLValue(&this) -> QualifiedValue {
        ret QualifiedValue(this.value, this._type, true);
    }

    pub MakeCompatible(&this, target: &QualifiedType) -> QualifiedValue {
        if target.IsPointer() && this.Type().IsPointer() {
            if target.Pointee().IsClass() && this.Type().Pointee().IsClass() {
                let fields = this.Type().Pointee().Fields();

                for i in 0..fields.Size() {
                    if fields[i].left == target.Pointee().name {
                        let mut value_ref = this.Value();

                        if i != 0 {
                            value_ref = LLVMBuildStructGEP2(compiler->builder, this.Type().Pointee().Value(), this.Value(), i as u32, "");
                        }

                        ret QualifiedValue(LLVMBuildBitCast(compiler->builder, value_ref, target.Value(), ""), target);
                    }
                }
            }
        } ret this;
    }

    pub ToString(&this) -> String {
        if this.value != null {
            let mut result: String;
            let string = LLVMPrintValueToString(this.value);
            result += string;
            LLVMDisposeMessage(string);
            ret result;
        } else {
            Logger::Log("QualifiedValue", "Null value!", LogSeverity::Fatal);
            ret String("");
        }
    }
}
