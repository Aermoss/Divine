        ret this.x != other.x || this.y != other.y || this.z != other.z || this.w != other.w;
    }
};

class Matrix4 {
    pub values[16u64]: f32
} impl {
    Matrix4(this: &mut Matrix4) {
        let mut i: u64 = 0u64; 

        while i < 16u64 {
            this.values[i] = 0.0f32;
            i += 1u64;
        }
    }

    Matrix4(this: &mut Matrix4, value: f32) {
        let mut i: u64 = 0u64; 

        while i < 16u64 {
            this.values[i] = 0.0f32;
            i += 1u64;
        }

        this.values[0u64 + 0u64 * 4u64] = value;
        this.values[1u64 + 1u64 * 4u64] = value;
        this.values[2u64 + 2u64 * 4u64] = value;
        this.values[3u64 + 3u64 * 4u64] = value;
    }

    pub op*(this: &Matrix4, other: &Matrix4) -> Matrix4 {
        let mut result: Matrix4;
        let mut col: u64 = 0u64;

        while col < 4u64 {
            let mut row: u64 = 0u64;

            while row < 4u64 {
                let mut sum: f32 = 0.0f32;
                let mut i: u64 = 0u64;

                while i < 4u64 {
                    sum += this.values[row + i * 4u64] * other.values[i + col * 4u64];
                    i += 1u64;
                }

                result.values[row + col * 4u64] = sum;
                row += 1u64;
            } col += 1u64;
        } ret result;
    }

    pub op*=(this: &mut Matrix4, other: &Matrix4) -> &Matrix4 {
        let result: Matrix4 = this * other;
        let mut i: u64 = 0u64;

        while i < 16u64 {
            this.values[i] = result.values[i];
            i += 1u64;
        } ret this;
    }
};

func Orthographic(left: f32, right: f32, bottom: f32, top: f32, near: f32, far: f32) -> Matrix4 {
    let mut result: Matrix4 = { 1.0f32 };
    result.values[0u64 + 0u64 * 4u64] = 2.0f32 / (right - left);
    result.values[1u64 + 1u64 * 4u64] = 2.0f32 / (top - bottom);
    result.values[2u64 + 2u64 * 4u64] = -2.0f32 / (far - near);
    result.values[0u64 + 3u64 * 4u64] = -(right + left) / (right - left);
    result.values[1u64 + 3u64 * 4u64] = -(top + bottom) / (top - bottom);
    result.values[2u64 + 3u64 * 4u64] = -(far + near) / (far - near);
    ret result;
}

func Perspective(fov: f32, aspect: f32, near: f32, far: f32) -> Matrix4 {
    let mut result: Matrix4 = { 0.0f32 };
    result.values[0u64 + 0u64 * 4u64] = 1.0f32 / (aspect * tanf(fov / 2.0f32));
    result.values[1u64 + 1u64 * 4u64] = 1.0f32 / tanf(fov / 2.0f32);
    result.values[2u64 + 2u64 * 4u64] = -(far + near) / (far - near);
    result.values[2u64 + 3u64 * 4u64] = -(2.0f32 * far * near) / (far - near);
    result.values[3u64 + 2u64 * 4u64] = -1.0f32;
    ret result;
}

func Translate(translation: Vector3) -> Matrix4 {
    let mut result: Matrix4 = { 1.0f32 };
    result.values[0u64 + 3u64 * 4u64] = translation.x;
    result.values[1u64 + 3u64 * 4u64] = translation.y;
    result.values[2u64 + 3u64 * 4u64] = translation.z;
    ret result;
}

func Rotate(angle: f32, mut axis: Vector3) -> Matrix4 {
    let mut result: Matrix4 = { 1.0f32 };
    let (c: f32, s: f32, t: f32) = (cosf(angle), sinf(angle), 1.0f32 - cosf(angle));
    axis /= sqrtf(axis.x * axis.x + axis.y * axis.y + axis.z * axis.z);
    result.values[0u64 + 0u64 * 4u64] = axis.x * axis.x * t + c;
    result.values[1u64 + 0u64 * 4u64] = axis.x * axis.y * t + axis.z * s;
    result.values[2u64 + 0u64 * 4u64] = axis.x * axis.z * t - axis.y * s;
    result.values[0u64 + 1u64 * 4u64] = axis.y * axis.x * t - axis.z * s;
    result.values[1u64 + 1u64 * 4u64] = axis.y * axis.y * t + c;
    result.values[2u64 + 1u64 * 4u64] = axis.y * axis.z * t + axis.x * s;
    result.values[0u64 + 2u64 * 4u64] = axis.z * axis.x * t + axis.y * s;
    result.values[1u64 + 2u64 * 4u64] = axis.z * axis.y * t - axis.x * s;
    result.values[2u64 + 2u64 * 4u64] = axis.z * axis.z * t + c;
    ret result;
}

func Scale(scale: Vector3) -> Matrix4 {
    let mut result: Matrix4 = { 1.0f32 };
    result.values[0u64 + 0u64 * 4u64] = scale.x;
    result.values[1u64 + 1u64 * 4u64] = scale.y;
    result.values[2u64 + 2u64 * 4u64] = scale.z;
    ret result;
}

func Dot(a: &Vector3, b: &Vector3) -> f32 {
    ret a.x * b.x + a.y * b.y + a.z * b.z;
}

func Cross(a: &Vector3, b: &Vector3) -> Vector3 {
    ret Vector3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x);
}

func LookAt(eye: &Vector3, target: &Vector3, up: &Vector3) -> Matrix4 {
    let mut result: Matrix4 = { 1.0f32 };
    let f: Vector3 = (eye - target).Normalize(); 
    let r: Vector3 = Cross(up, f).Normalize();
    let u: Vector3 = Cross(f, r);
    result.values[0u64 + 0u64 * 4u64] = r.x;
    result.values[1u64 + 0u64 * 4u64] = u.x;
    result.values[2u64 + 0u64 * 4u64] = f.x;
    result.values[0u64 + 1u64 * 4u64] = r.y;
    result.values[1u64 + 1u64 * 4u64] = u.y;
    result.values[2u64 + 1u64 * 4u64] = f.y;
    result.values[0u64 + 2u64 * 4u64] = r.z;
    result.values[1u64 + 2u64 * 4u64] = u.z;
    result.values[2u64 + 2u64 * 4u64] = f.z;
    result.values[0u64 + 3u64 * 4u64] = -Dot(r, eye);
    result.values[1u64 + 3u64 * 4u64] = -Dot(u, eye);
    result.values[2u64 + 3u64 * 4u64] = -Dot(f, eye);
    ret result;
}

class Logger {} impl {
    pub Info(message: *const i8) {
        printf("Divcraft: \x1b[32mInfo:\x1b[0m %s\n", message);
    }

    pub Warning(message: *const i8) {
        printf("Divcraft: \x1b[35mWarning:\x1b[0m %s\n", message);
    }

    pub Error(message: *const i8) {
        printf("Divcraft: \x1b[31mError:\x1b[0m %s\n", message);
        exit(1i32);
    }
};

class Shader {
    pub id: u32,
    pub vertex_path: String,
    pub fragment_path: String
} impl {
    Shader(this: &mut Shader, vertex_path: *const i8, fragment_path: *const i8) {
        (this.vertex_path, this.fragment_path) = (vertex_path, fragment_path);
        this.FromPath(this.vertex_path.Data(), this.fragment_path.Data());
    }

    ~Shader(this: &mut Shader) {
        if this.id != 0u32 {
            glDeleteProgram(this.id);
        }
    }

    priv FromSource(this: &mut Shader, vertex_source: *const i8, fragment_source: *const i8) {
        let vertex_shader: u32 = glCreateShader(GL_VERTEX_SHADER);
        glShaderSource(vertex_shader, 1i32, &vertex_source, null);
        glCompileShader(vertex_shader);

        let vertex_status: i32;
        glGetShaderiv(vertex_shader, GL_COMPILE_STATUS, &vertex_status);

        if vertex_status == 0i32 {
            let mut length: i32;
            glGetShaderiv(vertex_shader, GL_INFO_LOG_LENGTH, &length);
            let mut buffer: *mut i8 = malloc((length + 1i32) as u64) as *mut i8;
            glGetShaderInfoLog(vertex_shader, length, null, buffer);
            Logger::Error((String("Vertex shader compilation error: ") + buffer).Data());
            free(buffer as *mut void);
            glDeleteShader(vertex_shader);
            ret;
        }

        let fragment_shader: u32 = glCreateShader(GL_FRAGMENT_SHADER);
        glShaderSource(fragment_shader, 1i32, &fragment_source, null);
        glCompileShader(fragment_shader);

        let fragment_status: i32;
        glGetShaderiv(fragment_shader, GL_COMPILE_STATUS, &fragment_status);

        if fragment_status == 0i32 {
            let mut length: i32;
            glGetShaderiv(fragment_shader, GL_INFO_LOG_LENGTH, &length);
            let mut buffer: *mut i8 = malloc((length + 1i32) as u64) as *mut i8;
            glGetShaderInfoLog(fragment_shader, length, null, buffer);
            Logger::Error((String("Fragment shader compilation error: ") + buffer).Data());
            free(buffer as *mut void);
            glDeleteShader(fragment_shader);
            glDeleteShader(vertex_shader);
            ret;
        }

        this.id = glCreateProgram();
        glAttachShader(this.id, vertex_shader);
        glAttachShader(this.id, fragment_shader);
        glLinkProgram(this.id);
        glDetachShader(this.id, fragment_shader);
        glDetachShader(this.id, vertex_shader);
        glDeleteShader(fragment_shader);
        glDeleteShader(vertex_shader);

        let link_status: i32;
        glGetProgramiv(this.id, GL_LINK_STATUS, &link_status);

        if link_status == 0i32 {
            let mut length: i32;
            glGetProgramiv(this.id, GL_INFO_LOG_LENGTH, &length);
            let mut buffer: *mut i8 = malloc((length + 1i32) as u64) as *mut i8;
            glGetProgramInfoLog(this.id, length, null, buffer);
            Logger::Error((String("Program linking error: ") + buffer).Data());
            free(buffer as *mut void);
            glDeleteProgram(this.id);
            ret;
        }
    }

    priv FromPath(this: &mut Shader, vertex_path: *const i8, fragment_path: *const i8) {
        let vertex_source: *const i8 = ReadFile(vertex_path).Data();
        let fragment_source: *const i8 = ReadFile(fragment_path).Data();
        this.FromSource(vertex_source, fragment_source);
    }

    pub Reload(this: &mut Shader) {
        if this.id != 0u32 { glDeleteProgram(this.id); }
        this.FromPath(this.vertex_path.Data(), this.fragment_path.Data());
        Logger::Info("Shader reloaded successfully.");
    }

    pub GetUniformLocation(this: &Shader, name: *const i8) -> i32 {
        ret glGetUniformLocation(this.id, name);
    }

    pub Bind(this: &Shader) {
        glUseProgram(this.id);
    }

    pub Unbind(this: &Shader) {
        glUseProgram(0u32);
    }
};

class TextureManager {
    pub width: i32, pub height: i32, pub depth: i32,
    pub textures: Vector<String>, pub id: u32
} impl {
    TextureManager(this: &mut TextureManager, width: i32, height: i32, depth: i32) {
        (this.width, this.height, this.depth) = (width, height, depth);

        glCreateTextures(GL_TEXTURE_2D_ARRAY, 1i32, &this.id);
        glTextureStorage3D(this.id, 1i32, GL_RGBA8, this.width, this.height, this.depth);
        glTextureParameteri(this.id, GL_TEXTURE_MIN_FILTER, GL_NEAREST as i32);
        glTextureParameteri(this.id, GL_TEXTURE_MAG_FILTER, GL_NEAREST as i32);
        stbi_set_flip_vertically_on_load(1i32);
    }

    ~TextureManager(this: &mut TextureManager) {
        glDeleteTextures(1i32, &this.id);
    }

    pub GenerateMipmaps(this: &TextureManager) {
        glGenerateTextureMipmap(this.id);
    }

    pub AddTexture(this: &mut TextureManager, texture: String) {
        if !this.textures.Contains(texture) {
            this.textures.PushBack(texture);
            let (width: i32, height: i32, channels: i32) = (0i32, 0i32, 0i32);
            let path: String = String("textures\\") + texture + ".png";
            let data: *mut u8 = stbi_load(path.Data(), &width, &height, &channels, 0i32);

            if data != null {
                Logger::Info((String("Texture '") + path + "' loaded successfully, id: " + String(this.textures.Size() as i32 - 1i32) + ".").Data());
                glTextureSubImage3D(this.id, 0i32, 0i32, 0i32, this.textures.Size() as i32 - 1i32, this.width, this.height, 1i32, GL_RGBA, GL_UNSIGNED_BYTE, data);
                stbi_image_free(data);
            } else {
                Logger::Error((String("Failed to load texture: '") + path + "'.").Data());
            }
        }
    }

    func Bind(this: &TextureManager, binding: u32) {
        glBindTextureUnit(binding, this.id);
    }

    func Unbind(this: &TextureManager, binding: u32) {
        glBindTextureUnit(binding, 0u32);
    }
};

const SUBCHUNK_WIDTH: u64 = 16u64;
const SUBCHUNK_HEIGHT: u64 = 16u64;
const SUBCHUNK_DEPTH: u64 = 16u64;

class Subchunk {
    pub position: Vector3, pub world_position: Vector3,
    pub vertices: Vector<f32>, pub indices: Vector<u32>, pub offset: u32,
    pub blocks[SUBCHUNK_WIDTH * SUBCHUNK_HEIGHT * SUBCHUNK_DEPTH]: u8,
    pub lights[SUBCHUNK_WIDTH * SUBCHUNK_HEIGHT * SUBCHUNK_DEPTH]: u8,
    pub parent: *mut void
} impl {
    Subchunk(this: &mut Subchunk, parent: *mut void, position: Vector3) {
        (this.parent, this.position) = (parent, position);
        this.world_position = this.position * Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32);
        let mut i: u64 = 0u64;

        while i < SUBCHUNK_WIDTH * SUBCHUNK_HEIGHT * SUBCHUNK_DEPTH {
            (this.blocks[i], this.lights[i]) = (0u8, 0u8);
            i += 1u64;
        }
    }

    ~Subchunk(this: &mut Subchunk) {}

    priv IndexFromPosition(this: &Subchunk, position: &Vector3) -> u64 {
        ret (position.x as u64) + (position.y as u64) * SUBCHUNK_WIDTH + (position.z as u64) * SUBCHUNK_WIDTH * SUBCHUNK_HEIGHT;
    }

    pub GetBlockLight(this: &Subchunk, position: &Vector3) -> u8 {
        ret this.lights[this.IndexFromPosition(position)] & 0x0Fu8;
    }

    pub SetBlockLight(this: &mut Subchunk, position: &Vector3, value: u8) {
        let index: u64 = this.IndexFromPosition(position);
        this.lights[index] = (this.lights[index] & 0xF0u8) | (value & 0x0Fu8);
    }

    pub GetSkylight(this: &Subchunk, position: &Vector3) -> u8 {
        ret (this.lights[this.IndexFromPosition(position)] >> 4u8) & 0x0Fu8;
    }

    pub SetSkylight(this: &mut Subchunk, position: &Vector3, value: u8) {
        let index: u64 = this.IndexFromPosition(position);
        this.lights[index] = (this.lights[index] & 0x0Fu8) | ((value & 0x0Fu8) << 4u8);
    }

    pub GetRawLight(this: &Subchunk, position: &Vector3) -> u8 {
        ret this.lights[this.IndexFromPosition(position)];
    }

    pub Smooth(this: &Subchunk, mut a: f32, mut b: f32, mut c: f32, mut d: f32) -> f32 {
        if a != 0.0f32 || b != 0.0f32 || c != 0.0f32 || d != 0.0f32 {
            let l: f32 = fminf(a, fminf(b, fminf(c, d)));
            (a, b, c, d) = (fmaxf(a, l), fmaxf(b, l), fmaxf(c, l), fmaxf(d, l));
        } ret (a + b + c + d) / 4.0f32;
    }

    priv AmbientOcclusion(this: &Subchunk, s1: f32, s2: f32, c: f32) -> f32 {
        if s1 != 0.0f32 && s2 != 0.0f32 {
            ret 0.25f32;
        } else {
            ret 1.0f32 - (s1 + s2 + c) / 4.0f32;
        }
    }

    priv GetFaceAmbientOcclusion(this: &Subchunk, s1: f32, s2: f32, s3: f32, s4: f32, s5: f32, s6: f32, s7: f32, s8: f32) -> Vector<f32> {
        let mut result: Vector<f32>;
        result.PushBack(this.AmbientOcclusion(s2, s4, s1));
        result.PushBack(this.AmbientOcclusion(s4, s7, s6));
        result.PushBack(this.AmbientOcclusion(s5, s7, s8));
        result.PushBack(this.AmbientOcclusion(s2, s5, s3));
        ret result;
    }

    priv GetSmoothFaceLight(this: &Subchunk, light: f32, light1: f32, light2: f32, light3: f32, light4: f32, light5: f32, light6: f32, light7: f32, light8: f32) -> Vector<f32> {
        let mut result: Vector<f32>;
        result.PushBack(this.Smooth(light, light2, light4, light1));
        result.PushBack(this.Smooth(light, light4, light7, light6));
        result.PushBack(this.Smooth(light, light5, light7, light8));
        result.PushBack(this.Smooth(light, light2, light5, light3));
        ret result;
    }

    priv GetNeighbourVoxels(this: &Subchunk, direction: &Vector3, index: u64) -> Vector<Vector3> {
        let mut result: Vector<Vector3>;

        if index == 0u64 {
            result.PushBack(direction + Vector3(0.0f32,  1.0f32,  1.0f32));
            result.PushBack(direction + Vector3(0.0f32,  1.0f32,  0.0f32));
            result.PushBack(direction + Vector3(0.0f32,  1.0f32, -1.0f32));
            result.PushBack(direction + Vector3(0.0f32,  0.0f32,  1.0f32));
            result.PushBack(direction + Vector3(0.0f32,  0.0f32, -1.0f32));
            result.PushBack(direction + Vector3(0.0f32, -1.0f32,  1.0f32));
            result.PushBack(direction + Vector3(0.0f32, -1.0f32,  0.0f32));
            result.PushBack(direction + Vector3(0.0f32, -1.0f32, -1.0f32));
        } else if index == 1u64 {
            result.PushBack(direction + Vector3(0.0f32,  1.0f32, -1.0f32));
            result.PushBack(direction + Vector3(0.0f32,  1.0f32,  0.0f32));
            result.PushBack(direction + Vector3(0.0f32,  1.0f32,  1.0f32));
            result.PushBack(direction + Vector3(0.0f32,  0.0f32, -1.0f32));
            result.PushBack(direction + Vector3(0.0f32,  0.0f32,  1.0f32));
            result.PushBack(direction + Vector3(0.0f32, -1.0f32, -1.0f32));
            result.PushBack(direction + Vector3(0.0f32, -1.0f32,  0.0f32));
            result.PushBack(direction + Vector3(0.0f32, -1.0f32,  1.0f32));
        } else if index == 2u64 {
            result.PushBack(direction + Vector3( 1.0f32, 0.0f32,  1.0f32));
            result.PushBack(direction + Vector3( 0.0f32, 0.0f32,  1.0f32));
            result.PushBack(direction + Vector3(-1.0f32, 0.0f32,  1.0f32));
            result.PushBack(direction + Vector3( 1.0f32, 0.0f32,  0.0f32));
            result.PushBack(direction + Vector3(-1.0f32, 0.0f32,  0.0f32));
            result.PushBack(direction + Vector3( 1.0f32, 0.0f32, -1.0f32));
            result.PushBack(direction + Vector3( 0.0f32, 0.0f32, -1.0f32));
            result.PushBack(direction + Vector3(-1.0f32, 0.0f32, -1.0f32));
        } else if index == 3u64 {
            result.PushBack(direction + Vector3(-1.0f32, 0.0f32,  1.0f32));
            result.PushBack(direction + Vector3( 0.0f32, 0.0f32,  1.0f32));
            result.PushBack(direction + Vector3( 1.0f32, 0.0f32,  1.0f32));
            result.PushBack(direction + Vector3(-1.0f32, 0.0f32,  0.0f32));
            result.PushBack(direction + Vector3( 1.0f32, 0.0f32,  0.0f32));
            result.PushBack(direction + Vector3(-1.0f32, 0.0f32, -1.0f32));
            result.PushBack(direction + Vector3( 0.0f32, 0.0f32, -1.0f32));
            result.PushBack(direction + Vector3( 1.0f32, 0.0f32, -1.0f32));
        }  else if index == 4u64 {
            result.PushBack(direction + Vector3(-1.0f32,  1.0f32, 0.0f32));
            result.PushBack(direction + Vector3( 0.0f32,  1.0f32, 0.0f32));
            result.PushBack(direction + Vector3( 1.0f32,  1.0f32, 0.0f32));
            result.PushBack(direction + Vector3(-1.0f32,  0.0f32, 0.0f32));
            result.PushBack(direction + Vector3( 1.0f32,  0.0f32, 0.0f32));
            result.PushBack(direction + Vector3(-1.0f32, -1.0f32, 0.0f32));
            result.PushBack(direction + Vector3( 0.0f32, -1.0f32, 0.0f32));
            result.PushBack(direction + Vector3( 1.0f32, -1.0f32, 0.0f32));
        } else {
            result.PushBack(direction + Vector3( 1.0f32,  1.0f32, 0.0f32));
            result.PushBack(direction + Vector3( 0.0f32,  1.0f32, 0.0f32));
            result.PushBack(direction + Vector3(-1.0f32,  1.0f32, 0.0f32));
            result.PushBack(direction + Vector3( 1.0f32,  0.0f32, 0.0f32));
            result.PushBack(direction + Vector3(-1.0f32,  0.0f32, 0.0f32));
            result.PushBack(direction + Vector3( 1.0f32, -1.0f32, 0.0f32));
            result.PushBack(direction + Vector3( 0.0f32, -1.0f32, 0.0f32));
            result.PushBack(direction + Vector3(-1.0f32, -1.0f32, 0.0f32));
        } ret result;
    }

    pub GetLight(this: &Subchunk, number: u8, index: u64, position: &Vector3, direction: &Vector3) -> Vector<f32> {
        let world: *mut World = (this.parent as *mut Chunk)->parent as *mut World;
        let mut light_source: bool = false;
        let mut i: u64 = 0u64;

        while i < world->light_blocks.Size() {
            if world->light_blocks[i] == number {
                light_source = true;
                break;
            } i += 1u64;
        } i = 0u64;

        if light_source {
            let mut result: Vector<f32>;
            result.PushBack(world->GetLight(position) as f32);
            result.PushBack(world->GetLight(position) as f32);
            result.PushBack(world->GetLight(position) as f32);
            result.PushBack(world->GetLight(position) as f32);
            ret result;
        } else {
            let mut positions: Vector<Vector3>;
            positions.PushBack(direction);
            positions += this.GetNeighbourVoxels(direction, index);
            let mut lights: Vector<f32>;

            while i < positions.Size() {
                lights.PushBack(world->GetLight(positions[i]) as f32);
                i += 1u64;
            }

            ret this.GetSmoothFaceLight(lights[0u64], lights[1u64], lights[2u64], lights[3u64], lights[4u64], lights[5u64], lights[6u64], lights[7u64], lights[8u64]);
        }
    }

    pub GetSkylight(this: &Subchunk, number: u8, index: u64, position: &Vector3, direction: &Vector3) -> Vector<f32> {
        let world: *mut World = (this.parent as *mut Chunk)->parent as *mut World;
        let mut light_source: bool = false;
        let mut i: u64 = 0u64;

        while i < world->light_blocks.Size() {
            if world->light_blocks[i] == number {
                light_source = true;
                break;
            } i += 1u64;
        } i = 0u64;

        if light_source {
            let mut result: Vector<f32>;
            result.PushBack(world->GetSkylight(position) as f32);
            result.PushBack(world->GetSkylight(position) as f32);
            result.PushBack(world->GetSkylight(position) as f32);
            result.PushBack(world->GetSkylight(position) as f32);
            ret result;
        } else {
            let mut positions: Vector<Vector3>;
            positions.PushBack(direction);
            positions += this.GetNeighbourVoxels(direction, index);
            let mut lights: Vector<f32>;

            while i < positions.Size() {
                lights.PushBack(world->GetSkylight(positions[i]) as f32);
                i += 1u64;
            }

            ret this.GetSmoothFaceLight(lights[0u64], lights[1u64], lights[2u64], lights[3u64], lights[4u64], lights[5u64], lights[6u64], lights[7u64], lights[8u64]);
        }
    }

    pub GetShading(this: &Subchunk, number: u8, index: u64, direction: &Vector3) -> Vector<f32> {
        let mut result: Vector<f32>;
        let mut i: u64 = 0u64;
        
        while i < 4u64 {
            result.PushBack(shadings[index * 4u64 + i]);
            i += 1u64;
        } i = 0u64;

        let world: *mut World = (this.parent as *mut Chunk)->parent as *mut World;
        let mut light_source: bool = false;

        while i < world->light_blocks.Size() {
            if world->light_blocks[i] == number {
                light_source = true;
                break;
            } i += 1u64;
        } i = 0u64;

        if light_source {
            ret result;
        } else {
            let positions: Vector<Vector3> = this.GetNeighbourVoxels(direction, index);
            let mut lights: Vector<f32>;

            while i < positions.Size() {
                lights.PushBack(this.GetBlockFast(positions[i]) != 0u8 ? 1.0f32 : 0.0f32);
                i += 1u64;
            } i = 0u64;

            let faceAmbientOcclusion: Vector<f32> = this.GetFaceAmbientOcclusion(lights[0u64], lights[1u64], lights[2u64], lights[3u64], lights[4u64], lights[5u64], lights[6u64], lights[7u64]);

            while i < 4u64 {
                result[i] = result[i] * faceAmbientOcclusion[i];
                i += 1u64;
            } ret result;
        }
    }

    pub SetBlock(this: &mut Subchunk, position: &Vector3, block: u8) {
        if position.x >= 0.0f32 && position.x < SUBCHUNK_WIDTH as f32 && position.y >= 0.0f32 && position.y < SUBCHUNK_HEIGHT as f32 && position.z >= 0.0f32 && position.z < SUBCHUNK_DEPTH as f32 {
            this.blocks[this.IndexFromPosition(position)] = block;
        } else {
            Logger::Error("Trying to set block out of bounds.");
        }
    }

    pub GetBlock(this: &Subchunk, position: &Vector3) -> u8 {
        if position.x >= 0.0f32 && position.x < SUBCHUNK_WIDTH as f32 && position.y >= 0.0f32 && position.y < SUBCHUNK_HEIGHT as f32 && position.z >= 0.0f32 && position.z < SUBCHUNK_DEPTH as f32 {
            ret this.blocks[this.IndexFromPosition(position)];
        } else {
            Logger::Error("Trying to get block out of bounds.");
            ret 0u8;
        }
    }

    priv GetBlockFast(this: &Subchunk, position: &Vector3) -> u8 {
        let (x: i32, y: i32, z: i32) = (floorf(position.x) as i32, floorf(position.y) as i32, floorf(position.z) as i32);

        if y < 0i32 || y >= (CHUNK_HEIGHT as i32) {
            ret 0u8;
        }

        let mut chunk: *mut Chunk = this.parent as *mut Chunk;

        if x < (chunk->world_position.x as i32) {
            chunk = chunk->west_neighbor;
        } else if x >= (chunk->world_position.x as i32) + (SUBCHUNK_WIDTH as i32) {
            chunk = chunk->east_neighbor;
        }

        if chunk == null {
            ret 0u8;
        }

        if z < (chunk->world_position.z as i32) {
            chunk = chunk->north_neighbor;
        } else if z >= (chunk->world_position.z as i32) + (SUBCHUNK_DEPTH as i32) {
            chunk = chunk->south_neighbor;
        }

        if chunk == null {
            ret 0u8;
        }

        ret chunk->subchunks[(y >> 4i32) as u64]->blocks[(x & 15i32) as u64 + (y & 15i32) as u64 * SUBCHUNK_WIDTH + (z & 15i32) as u64 * SUBCHUNK_WIDTH * SUBCHUNK_HEIGHT];
    }

    pub Update(this: &mut Subchunk) {
        this.offset = 0u32;
        this.vertices.Clear();
        this.indices.Clear();

        let neighbor_offsets[]: Vector3 = {
            Vector3( 1.0f32,  0.0f32,  0.0f32),
            Vector3(-1.0f32,  0.0f32,  0.0f32),
            Vector3( 0.0f32,  1.0f32,  0.0f32),
            Vector3( 0.0f32, -1.0f32,  0.0f32),
            Vector3( 0.0f32,  0.0f32,  1.0f32),
            Vector3( 0.0f32,  0.0f32, -1.0f32)
        };

        let chunk: *mut Chunk = this.parent as *mut Chunk;
        let world: *mut World = chunk->parent as *mut World;
        let mut x: u64 = 0u64;

        while x < SUBCHUNK_WIDTH {
            let mut y: u64 = 0u64;

            while y < SUBCHUNK_HEIGHT {
                let mut z: u64 = 0u64;

                while z < SUBCHUNK_DEPTH {
                    let position: Vector3 = Vector3(x as f32, y as f32, z as f32);
                    let block: u8 = this.blocks[x + y * SUBCHUNK_WIDTH + z * SUBCHUNK_WIDTH * SUBCHUNK_HEIGHT];
                    let block_type: *mut BlockType = world->block_types[block as u64 - 1u64];

                    if block != 0u8 {
                        let mut i: u64 = 0u64;

                        while i < 6u64 {
                            let neighbor_position: Vector3 = position + this.world_position + neighbor_offsets[i];
                            let neighbor_block: u8 = this.GetBlockFast(neighbor_position);

                            if neighbor_block == 0u8 {
                                let shadings: Vector<f32> = this.GetShading(block, i, position + this.world_position + neighbor_offsets[i]);
                                let lights: Vector<f32> = this.GetLight(block, i, position + this.world_position, position + this.world_position + neighbor_offsets[i]);
                                let skylights: Vector<f32> = this.GetSkylight(block, i, position + this.world_position, position + this.world_position + neighbor_offsets[i]);
                                let mut j: u64 = 0u64;

                                while j < 4u64 {
                                    this.vertices.PushBack(vertices[i * 12u64 + j * 3u64 + 0u64] + this.world_position.x + x as f32);
                                    this.vertices.PushBack(vertices[i * 12u64 + j * 3u64 + 1u64] + this.world_position.y + y as f32);
                                    this.vertices.PushBack(vertices[i * 12u64 + j * 3u64 + 2u64] + this.world_position.z + z as f32);

                                    this.vertices.PushBack(tex_coords[i * 12u64 + j * 3u64 + 0u64]);
                                    this.vertices.PushBack(tex_coords[i * 12u64 + j * 3u64 + 1u64]);
                                    this.vertices.PushBack(block_type->textures[i]);

                                    this.vertices.PushBack(shadings[j]);
                                    this.vertices.PushBack(lights[j]);
                                    this.vertices.PushBack(skylights[j]);
                                    j += 1u64;
                                }

                                this.indices.PushBack(0u32 + this.offset);
                                this.indices.PushBack(1u32 + this.offset);
                                this.indices.PushBack(2u32 + this.offset);
                                this.indices.PushBack(0u32 + this.offset);
                                this.indices.PushBack(2u32 + this.offset);
                                this.indices.PushBack(3u32 + this.offset);
                                this.offset += 4u32;
                            } i += 1u64;
                        }
                    } z += 1u64;
                } y += 1u64;
            } x += 1u64;
        }
    }
};

const CHUNK_WIDTH: u64 = 16u64;
const CHUNK_HEIGHT: u64 = 256u64;
const CHUNK_DEPTH: u64 = 16u64;

class Chunk {
    pub parent: *mut void, pub position: Vector3, pub world_position: Vector3,
    priv vertex_array: u32 = 0u32, priv vertex_buffer: u32 = 0u32, priv index_buffer: u32 = 0u32,
    priv vertices: Vector<f32>, priv indices: Vector<u32>, pub index_count: i32, pub offset: u32,
    pub subchunks[CHUNK_HEIGHT / SUBCHUNK_HEIGHT]: *mut Subchunk, pub busy: bool = false,
    pub north_neighbor: *mut Chunk = null, pub south_neighbor: *mut Chunk = null,
    pub east_neighbor: *mut Chunk = null, pub west_neighbor: *mut Chunk = null
} impl {
    Chunk(this: &mut Chunk, parent: *mut void, position: Vector3) {
        (this.parent, this.position) = (parent, position);
        this.world_position = this.position * Vector3(CHUNK_WIDTH as f32, CHUNK_HEIGHT as f32, CHUNK_DEPTH as f32);
        let mut i: u64 = 0u64;

        while i < CHUNK_HEIGHT / SUBCHUNK_HEIGHT {
            this.subchunks[i] = new Subchunk(this, Vector3(position.x, position.y + i as f32, position.z));
            i += 1u64;
        }
    }

    ~Chunk(this: &mut Chunk) {
        if this.index_buffer != 0u32 {
            glDeleteBuffers(1i32, &this.index_buffer);
        }

        if this.vertex_buffer != 0u32 {
            glDeleteBuffers(1i32, &this.vertex_buffer);
        }

        if this.vertex_array != 0u32 {
            glDeleteVertexArrays(1i32, &this.vertex_array);
        }

        let mut i: u64 = 0u64;

        while i < CHUNK_HEIGHT / SUBCHUNK_HEIGHT {
            del this.subchunks[i];
            i += 1u64;
        }
    }

    pub Update(this: &mut Chunk) {
        let mut i: u64 = 0u64;

        while i < CHUNK_HEIGHT / SUBCHUNK_HEIGHT {
            this.subchunks[i]->Update();
            i += 1u64;
        }
    }

    pub Upload(this: &mut Chunk) {
        this.offset = 0u32;
        this.vertices.Clear();
        this.indices.Clear();
        let mut i: u64 = 0u64;

        while i < CHUNK_HEIGHT / SUBCHUNK_HEIGHT {
            let subchunk: *mut Subchunk = this.subchunks[i];
            this.vertices += subchunk->vertices;
            let mut j: u64 = 0u64;

            while j < subchunk->indices.Size() {
                this.indices.PushBack(subchunk->indices[j] + this.offset);
                j += 1u64;
            }

            this.offset += subchunk->offset;
            i += 1u64;
        }

        if this.vertex_array == 0u32 {
            glCreateVertexArrays(1i32, &this.vertex_array);
        }

        if this.vertex_buffer == 0u32 {
            glCreateBuffers(1i32, &this.vertex_buffer);
        }

        if this.index_buffer == 0u32 {
            glCreateBuffers(1i32, &this.index_buffer);
        }

        glNamedBufferData(this.vertex_buffer, this.vertices.Size() as i64 * 4i64, this.vertices.Data(), GL_STATIC_DRAW);
        glNamedBufferData(this.index_buffer, this.indices.Size() as i64 * 4i64, this.indices.Data(), GL_STATIC_DRAW);

        glVertexArrayVertexBuffer(this.vertex_array, 0u32, this.vertex_buffer, 0i64, 9i32 * 4i32);

        glVertexArrayAttribFormat(this.vertex_array, 0u32, 3i32, GL_FLOAT, GL_FALSE, 0u32 * 4u32);
        glVertexArrayAttribFormat(this.vertex_array, 1u32, 3i32, GL_FLOAT, GL_FALSE, 3u32 * 4u32);
        glVertexArrayAttribFormat(this.vertex_array, 2u32, 1i32, GL_FLOAT, GL_FALSE, 6u32 * 4u32);
        glVertexArrayAttribFormat(this.vertex_array, 3u32, 1i32, GL_FLOAT, GL_FALSE, 7u32 * 4u32);
        glVertexArrayAttribFormat(this.vertex_array, 4u32, 1i32, GL_FLOAT, GL_FALSE, 8u32 * 4u32);

        glVertexArrayAttribBinding(this.vertex_array, 0u32, 0u32);
        glVertexArrayAttribBinding(this.vertex_array, 1u32, 0u32);
        glVertexArrayAttribBinding(this.vertex_array, 2u32, 0u32);
        glVertexArrayAttribBinding(this.vertex_array, 3u32, 0u32);
        glVertexArrayAttribBinding(this.vertex_array, 4u32, 0u32);

        glEnableVertexArrayAttrib(this.vertex_array, 0u32);
        glEnableVertexArrayAttrib(this.vertex_array, 1u32);
        glEnableVertexArrayAttrib(this.vertex_array, 2u32);
        glEnableVertexArrayAttrib(this.vertex_array, 3u32);
        glEnableVertexArrayAttrib(this.vertex_array, 4u32);

        glVertexArrayElementBuffer(this.vertex_array, this.index_buffer);
        this.index_count = this.indices.Size() as i32;
    }

    pub Render(this: &Chunk) {
        if this.vertex_array != 0u32 && this.vertex_buffer != 0u32 && this.index_buffer != 0u32 {
            glBindVertexArray(this.vertex_array);
            glDrawElements(GL_TRIANGLES, this.index_count, GL_UNSIGNED_INT, null);
        }
    }
};

static vertices[]: f32 = {
     0.5f32,  0.5f32,  0.5f32,  0.5f32, -0.5f32,  0.5f32,  0.5f32, -0.5f32, -0.5f32,  0.5f32,  0.5f32, -0.5f32,
    -0.5f32,  0.5f32, -0.5f32, -0.5f32, -0.5f32, -0.5f32, -0.5f32, -0.5f32,  0.5f32, -0.5f32,  0.5f32,  0.5f32,
     0.5f32,  0.5f32,  0.5f32,  0.5f32,  0.5f32, -0.5f32, -0.5f32,  0.5f32, -0.5f32, -0.5f32,  0.5f32,  0.5f32,
    -0.5f32, -0.5f32,  0.5f32, -0.5f32, -0.5f32, -0.5f32,  0.5f32, -0.5f32, -0.5f32,  0.5f32, -0.5f32,  0.5f32,
    -0.5f32,  0.5f32,  0.5f32, -0.5f32, -0.5f32,  0.5f32,  0.5f32, -0.5f32,  0.5f32,  0.5f32,  0.5f32,  0.5f32,
     0.5f32,  0.5f32, -0.5f32,  0.5f32, -0.5f32, -0.5f32, -0.5f32, -0.5f32, -0.5f32, -0.5f32,  0.5f32, -0.5f32
};

static tex_coords[]: f32 = {
    0.0f32, 1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 1.0f32, 0.0f32, 0.0f32, 1.0f32, 1.0f32, 0.0f32,
    0.0f32, 1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 1.0f32, 0.0f32, 0.0f32, 1.0f32, 1.0f32, 0.0f32,
    0.0f32, 1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 1.0f32, 0.0f32, 0.0f32, 1.0f32, 1.0f32, 0.0f32,
    0.0f32, 1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 1.0f32, 0.0f32, 0.0f32, 1.0f32, 1.0f32, 0.0f32,
    0.0f32, 1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 1.0f32, 0.0f32, 0.0f32, 1.0f32, 1.0f32, 0.0f32,
    0.0f32, 1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 1.0f32, 0.0f32, 0.0f32, 1.0f32, 1.0f32, 0.0f32
};

static shadings[]: f32 = {
    0.6f32, 0.6f32, 0.6f32, 0.6f32,
    0.6f32, 0.6f32, 0.6f32, 0.6f32,
    1.0f32, 1.0f32, 1.0f32, 1.0f32,
    0.4f32, 0.4f32, 0.4f32, 0.4f32,
    0.8f32, 0.8f32, 0.8f32, 0.8f32,
    0.8f32, 0.8f32, 0.8f32, 0.8f32
};

class BlockType {
    pub textures: Vector<f32>
} impl {
    BlockType(this: &mut BlockType, textures: *const f32) {
        let mut i: u64 = 0u64;

        while i < 6u64 {
            this.textures.PushBack(textures[i]);
            i += 1u64;
        }
    }

    ~BlockType(this: &mut BlockType) {}
};

class RaycastResult {
    pub hit: bool,
    pub position: Vector3,
    pub normal: Vector3
} impl {
    RaycastResult(this: &mut RaycastResult, hit: bool, position: &Vector3, normal: &Vector3) {
        (this.hit, this.position, this.normal) = (hit, position, normal);
    }
};

const RENDER_DISTANCE: i64 = 8i64;
const RENDER_DISTANCE_SQ: i64 = RENDER_DISTANCE * RENDER_DISTANCE;
const UNLOAD_DISTANCE: i64 = RENDER_DISTANCE + 2i64;
const UNLOAD_DISTANCE_SQ: i64 = UNLOAD_DISTANCE * UNLOAD_DISTANCE;
const HASH_SIZE: u64 = 1024u64;

class World {
    priv chunk_update_queue: Vector<*mut Chunk>,
    priv chunk_upload_queue: Vector<*mut Chunk>,
    priv chunk_delete_queue: Vector<*mut Chunk>,
    priv buckets[HASH_SIZE]: *mut Vector<*mut Chunk>,
    priv current_chunk: Vector3, priv last_chunk: Vector3,
    pub block_types: Vector<*mut BlockType>,
    pub light_blocks: Vector<u8>,
    priv light_increase_queue: Vector<Pair<Vector3, u8>>,
    priv light_decrease_queue: Vector<Pair<Vector3, u8>>,
    priv skylight_increase_queue: Vector<Pair<Vector3, u8>>,
    priv skylight_decrease_queue: Vector<Pair<Vector3, u8>>,
    priv threads: Vector<thrd_t>,
    pub chunk_mutex: mtx_t,
    priv chunk_update_mutex: mtx_t,
    priv chunk_upload_mutex: mtx_t,
    priv chunk_delete_mutex: mtx_t,
    priv current_chunk_mutex: mtx_t,
    pub running: bool = true
} impl {
    World(this: &mut World) {
        this.current_chunk = Vector3(0.0f32, -1.0f32, 0.0f32);
        this.last_chunk = Vector3(0.0f32, -1.0f32, 0.0f32);
        let mut i: u64 = 0u64;

        while i < HASH_SIZE {
            this.buckets[i] = new Vector<*mut Chunk>();
            i += 1u64;
        }

        if mtx_init(&this.chunk_mutex, mtx_plain) != thrd_success {
            Logger::Error("Failed to initialize chunk mutex.");
        }

        if mtx_init(&this.chunk_update_mutex, mtx_plain) != thrd_success {
            Logger::Error("Failed to initialize chunk update mutex.");
        }

        if mtx_init(&this.chunk_upload_mutex, mtx_plain) != thrd_success {
            Logger::Error("Failed to initialize chunk upload mutex.");
        }

        if mtx_init(&this.chunk_delete_mutex, mtx_plain) != thrd_success {
            Logger::Error("Failed to initialize chunk delete mutex.");
        }

        if mtx_init(&this.current_chunk_mutex, mtx_plain) != thrd_success {
            Logger::Error("Failed to initialize current chunk mutex.");
        }

        let generator_thread: thrd_t;
        thrd_create(&generator_thread, this.GeneratorThread, this as *mut void);
        this.threads.PushBack(generator_thread);
        let mut j: u64 = 0u64;

        while j < 2u64 {
            let mesher_thread: thrd_t;
            thrd_create(&mesher_thread, this.MesherThread, this as *mut void);
            this.threads.PushBack(mesher_thread);
            j += 1u64;
        }

        let grass_textures[]: f32 = { 1.0f32, 1.0f32, 2.0f32, 3.0f32, 1.0f32, 1.0f32 };
        this.block_types.PushBack(new BlockType(grass_textures));

        let dirt_textures[]: f32 = { 3.0f32, 3.0f32, 3.0f32, 3.0f32, 3.0f32, 3.0f32 };
        this.block_types.PushBack(new BlockType(dirt_textures));

        let cobblestone_textures[]: f32 = { 4.0f32, 4.0f32, 4.0f32, 4.0f32, 4.0f32, 4.0f32 };
        this.block_types.PushBack(new BlockType(cobblestone_textures));

        let stone_textures[]: f32 = { 5.0f32, 5.0f32, 5.0f32, 5.0f32, 5.0f32, 5.0f32 };
        this.block_types.PushBack(new BlockType(stone_textures));

        let spruce_planks_textures[]: f32 = { 6.0f32, 6.0f32, 6.0f32, 6.0f32, 6.0f32, 6.0f32 };
        this.block_types.PushBack(new BlockType(spruce_planks_textures));

        let oak_log_textures[]: f32 = { 7.0f32, 7.0f32, 7.0f32, 7.0f32, 7.0f32, 7.0f32 };
        this.block_types.PushBack(new BlockType(oak_log_textures));
    }

    ~World(this: &mut World) {
        let mut i: u64 = 0u64;

        while i < this.threads.Size() {
            let mut result: i32;
            thrd_join(this.threads[i], &result);
            i += 1u64;
        } i = 0u64;

        mtx_destroy(&this.current_chunk_mutex);
        mtx_destroy(&this.chunk_delete_mutex);
        mtx_destroy(&this.chunk_upload_mutex);
        mtx_destroy(&this.chunk_update_mutex);
        mtx_destroy(&this.chunk_mutex);

        while i < this.block_types.Size() {
            del this.block_types[i];
            i += 1u64;
        } i = 0u64;

        while i < HASH_SIZE {
            let mut j: u64 = 0u64;

            while j < this.buckets[i]->Size() {
                del this.buckets[i]->Data()[j];
                j += 1u64;
            }

            del this.buckets[i];
            i += 1u64;
        }
    }

    priv GetHash(this: &World, x: i32, z: i32) -> u64 {
        let h1: u64 = (x as u64) * 73856093u64;
        let h2: u64 = (z as u64) * 19349663u64;
        ret (h1 ^ h2) % HASH_SIZE;
    }

    pub AddChunk(this: &mut World, chunk: *mut Chunk) {
        let hash: u64 = this.GetHash(chunk->position.x as i32, chunk->position.z as i32);
        mtx_lock(&this.chunk_mutex);
        this.buckets[hash]->PushBack(chunk);
        mtx_unlock(&this.chunk_mutex);
    }

    pub RemoveChunk(this: &mut World, chunk: *mut Chunk) {
        let hash: u64 = this.GetHash(chunk->position.x as i32, chunk->position.z as i32);
        let mut i: u64 = 0u64;
        mtx_lock(&this.chunk_mutex);
        
        while i < this.buckets[hash]->Size() {
            if this.buckets[hash]->Data()[i] == chunk {
                this.buckets[hash]->Pop(i);
                break;
            } i += 1u64;
        }

        mtx_unlock(&this.chunk_mutex);
    }

    pub GetChunk(this: &World, position: &Vector3) -> *mut Chunk {
        if position.y != 0.0f32 { ret null; }
        let hash: u64 = this.GetHash(position.x as i32, position.z as i32);
        mtx_lock(&this.chunk_mutex);
        let mut i: u64 = 0u64;

        while i < this.buckets[hash]->Size() {
            let chunk: *mut Chunk = this.buckets[hash]->Data()[i];

            if chunk->position.x == position.x && chunk->position.z == position.z {
                mtx_unlock(&this.chunk_mutex);
                ret chunk;
            } i += 1u64;
        }

        mtx_unlock(&this.chunk_mutex);
        ret null;
    }

    pub GetRawLight(this: &World, position: &Vector3) -> u8 {
        let chunk_position: Vector3 = (position / Vector3(CHUNK_WIDTH as f32, CHUNK_HEIGHT as f32, CHUNK_DEPTH as f32)).Floor();
        let chunk: *mut Chunk = this.GetChunk(chunk_position);

        if chunk != null {
            let subchunk_position: Vector3 = (position / Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32)).Floor();
            ret chunk->subchunks[subchunk_position.y as u64]->GetRawLight(position - (subchunk_position * Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32)));
        } else {
            ret 15u8 << 4u8;
        }
    }

    pub GetLight(this: &World, position: &Vector3) -> u8 {
        let chunk_position: Vector3 = (position / Vector3(CHUNK_WIDTH as f32, CHUNK_HEIGHT as f32, CHUNK_DEPTH as f32)).Floor();
        let chunk: *mut Chunk = this.GetChunk(chunk_position);

        if chunk != null {
            let subchunk_position: Vector3 = (position / Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32)).Floor();
            ret chunk->subchunks[subchunk_position.y as u64]->GetBlockLight(position - (subchunk_position * Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32)));
        } else {
            ret 0u8;
        }
    }

    pub GetSkylight(this: &World, position: &Vector3) -> u8 {
        let chunk_position: Vector3 = (position / Vector3(CHUNK_WIDTH as f32, CHUNK_HEIGHT as f32, CHUNK_DEPTH as f32)).Floor();
        let chunk: *mut Chunk = this.GetChunk(chunk_position);

        if chunk != null {
            let subchunk_position: Vector3 = (position / Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32)).Floor();
            ret chunk->subchunks[subchunk_position.y as u64]->GetSkylight(position - (subchunk_position * Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32)));
        } else {
            ret 15u8;
        }
    }

    pub SetBlock(this: &mut World, position: &Vector3, block: u8) {
        let chunk_position: Vector3 = (position / Vector3(CHUNK_WIDTH as f32, CHUNK_HEIGHT as f32, CHUNK_DEPTH as f32)).Floor();
        let chunk: *mut Chunk = this.GetChunk(chunk_position);

        if chunk != null {
            let subchunk_position: Vector3 = (position / Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32)).Floor();
            chunk->subchunks[subchunk_position.y as u64]->SetBlock(position - (subchunk_position * Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32)), block);
            this.UpdateAtPosition(position);
            this.DecreaseLight(position);
            this.DecreaseSkylight(position, true);
        }
    }

    pub GetBlock(this: &World, position: &Vector3) -> u8 {
        let chunk_position: Vector3 = (position / Vector3(CHUNK_WIDTH as f32, CHUNK_HEIGHT as f32, CHUNK_DEPTH as f32)).Floor();
        let chunk: *mut Chunk = this.GetChunk(chunk_position);

        if chunk != null {
            let subchunk_position: Vector3 = (position / Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32)).Floor();
            ret chunk->subchunks[subchunk_position.y as u64]->GetBlock(position - (subchunk_position * Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32)));
        } else {
            ret 0u8;
        }
    }

    pub GenerateChunk(this: &mut World, position: Vector3) -> *mut Chunk {
        let chunk: *mut Chunk = new Chunk(this, position);
        let mut x: u64 = 0u64;

        while x < CHUNK_WIDTH {
            let mut z: u64 = 0u64;

            while z < CHUNK_DEPTH {
                let height: f32 = floorf(16.0f32 + 96.0f32 * Perlin((chunk->world_position.x + x as f32) as f64, (chunk->world_position.z + z as f32) as f64, 0.025f64, 4i32, 2006i32) as f32);
                let mut y: u64 = 0u64;

                while y < height as u64 {
                    chunk->subchunks[y / SUBCHUNK_HEIGHT]->blocks[x + (y % SUBCHUNK_HEIGHT) * SUBCHUNK_WIDTH + z * SUBCHUNK_WIDTH * SUBCHUNK_HEIGHT] = (y as f32) < height ? ((y as f32) == height - 1.0f32 ? 1u8 : ((y as f32) < height - 3.0f32 ? 4u8 : 2u8)) : 0u8;
                    y += 1u64;
                } z += 1u64;
            } x += 1u64;
        }

        this.AddChunk(chunk);
        ret chunk;
    }

    pub GeneratorThread(this: &mut World) {
        let neighbor_offsets[]: Vector3 = {
            Vector3( 1.0f32, 0.0f32,  0.0f32),
            Vector3(-1.0f32, 0.0f32,  0.0f32),
            Vector3( 0.0f32, 0.0f32, -1.0f32),
            Vector3( 0.0f32, 0.0f32,  1.0f32)
        };

        while this.running {
            let mut chunk_update_queue: Vector<*mut Chunk>;
            mtx_lock(&this.current_chunk_mutex);
            let current_chunk: Vector3 = this.current_chunk;
            mtx_unlock(&this.current_chunk_mutex);

            if current_chunk.y == 0.0f32 {
                let mut i: u64 = 0u64;

                while i < HASH_SIZE {
                    let mut j: u64 = 0u64;
                    mtx_lock(&this.chunk_mutex);

                    while j < this.buckets[i]->Size() {
                        let chunk: *mut Chunk = this.buckets[i]->Data()[j];
                        let dist_x: f32 = chunk->position.x - current_chunk.x;
                        let dist_z: f32 = chunk->position.z - current_chunk.z;
                        let dist_sq: f32 = dist_x * dist_x + dist_z * dist_z;

                        if dist_sq > UNLOAD_DISTANCE_SQ as f32 {
                            let mut busy: bool = chunk->busy;

                            if chunk->east_neighbor != null {
                                busy |= chunk->east_neighbor->busy;
                            }

                            if chunk->west_neighbor != null {
                                busy |= chunk->west_neighbor->busy;
                            }

                            if chunk->north_neighbor != null {
                                busy |= chunk->north_neighbor->busy;
                            }

                            if chunk->south_neighbor != null {
                                busy |= chunk->south_neighbor->busy;
                            }

                            if !busy {
                                let mut k: u64 = 0u64;
                                mtx_lock(&this.chunk_update_mutex);

                                while k < this.chunk_update_queue.Size() {
                                    if this.chunk_update_queue[k] == chunk {
                                        this.chunk_update_queue.Pop(k);
                                        break;
                                    } k += 1u64;
                                }

                                if chunk->east_neighbor != null { chunk->east_neighbor->west_neighbor = null; }
                                if chunk->west_neighbor != null { chunk->west_neighbor->east_neighbor = null; }
                                if chunk->north_neighbor != null { chunk->north_neighbor->south_neighbor = null; }
                                if chunk->south_neighbor != null { chunk->south_neighbor->north_neighbor = null; }
                                mtx_unlock(&this.chunk_update_mutex);
                                this.buckets[i]->Pop(j);
                                mtx_lock(&this.chunk_delete_mutex);
                                this.chunk_delete_queue.PushBack(chunk);
                                mtx_unlock(&this.chunk_delete_mutex);
                                continue;
                            }
                        } j += 1u64;
                    }

                    mtx_unlock(&this.chunk_mutex);
                    i += 1u64;
                }

                let mut x: i64 = -RENDER_DISTANCE;

                while x < RENDER_DISTANCE + 1i64 {
                    let mut z: i64 = -RENDER_DISTANCE;

                    while z < RENDER_DISTANCE + 1i64 {
                        if (x * x + z * z) > RENDER_DISTANCE_SQ {
                            z += 1i64;
                            continue;
                        }

                        let position: Vector3 = { current_chunk.x + x as f32, 0.0f32, current_chunk.z + z as f32 };

                        if this.GetChunk(position) == null {
                            let chunk: *mut Chunk = this.GenerateChunk(position);
                            this.InitializeSkylight(chunk);
                            chunk_update_queue.PushBack(chunk);
                            let mut i: u64 = 0u64;

                            while i < 4u64 {
                                let neighbor_chunk: *mut Chunk = this.GetChunk(position + neighbor_offsets[i]);

                                if neighbor_chunk != null {
                                    if i == 0u64 {
                                        neighbor_chunk->west_neighbor = chunk;
                                        chunk->east_neighbor = neighbor_chunk;
                                    } else if i == 1u64 {
                                        neighbor_chunk->east_neighbor = chunk;
                                        chunk->west_neighbor = neighbor_chunk;
                                    } else if i == 2u64 {
                                        neighbor_chunk->south_neighbor = chunk;
                                        chunk->north_neighbor = neighbor_chunk;
                                    } else {
                                        neighbor_chunk->north_neighbor = chunk;
                                        chunk->south_neighbor = neighbor_chunk;
                                    }

                                    let mut j: u64 = 0u64;
                                    let mut found: bool = false;

                                    while j < chunk_update_queue.Size() {
                                        if chunk_update_queue[j] == neighbor_chunk {
                                            found = true;
                                            break;
                                        } j += 1u64;
                                    } j = 0u64;

                                    if !found {
                                        mtx_lock(&this.chunk_update_mutex);

                                        while j < this.chunk_update_queue.Size() {
                                            if this.chunk_update_queue[j] == neighbor_chunk {
                                                found = true;
                                                break;
                                            } j += 1u64;
                                        }

                                        mtx_unlock(&this.chunk_update_mutex);
                                    }

                                    if !found {
                                        chunk_update_queue.PushBack(neighbor_chunk);
                                    }
                                } i += 1u64;
                            }
                        } z += 1i64;
                    } x += 1i64;
                }

                mtx_lock(&this.chunk_update_mutex);
                this.chunk_update_queue += chunk_update_queue;
                mtx_unlock(&this.chunk_update_mutex);
                this.last_chunk = current_chunk;
            }
        }
    }

    pub MesherThread(this: &mut World) {
        let mut avg_gen_speed: f64 = 0.0f64;

        while this.running {
            let gen_start: f64 = glfwGetTime();
            let mut gen_count: u64 = 0u64;

            while this.running {
                mtx_lock(&this.chunk_update_mutex);

                if this.chunk_update_queue.Size() == 0u64 {
                    mtx_unlock(&this.chunk_update_mutex);
                    break;
                }

                mtx_lock(&this.current_chunk_mutex);
                let current_chunk: Vector3 = this.current_chunk;
                mtx_unlock(&this.current_chunk_mutex);

                let mut best_index: u64 = 0u64;
                let mut min_dist_sq: f32 = 1.0f32 / 0.0f32;
                let mut i: u64 = 0u64;

                while i < this.chunk_update_queue.Size() {
                    let chunk: *mut Chunk = this.chunk_update_queue[i];
                    let dist_x: f32 = chunk->position.x - current_chunk.x;
                    let dist_z: f32 = chunk->position.z - current_chunk.z;
                    let dist_sq: f32 = dist_x * dist_x + dist_z * dist_z;

                    if dist_sq < min_dist_sq {
                        min_dist_sq = dist_sq;
                        best_index = i;
                    } i += 1u64;
                }

                let chunk: *mut Chunk = this.chunk_update_queue.Pop(best_index);
                chunk->busy = true;
                mtx_unlock(&this.chunk_update_mutex);
                chunk->Update();
                mtx_lock(&this.chunk_upload_mutex);
                this.chunk_upload_queue.PushBack(chunk);
                mtx_unlock(&this.chunk_upload_mutex);
                gen_count += 1u64;
            }

            if gen_count != 0u64 {
                let gen_speed: f64 = 1.0f64 / ((glfwGetTime() - gen_start) / gen_count as f64);

                if avg_gen_speed == 0.0f64 {
                    avg_gen_speed = gen_speed;
                } else {
                    avg_gen_speed += gen_speed;
                    avg_gen_speed /= 2.0f64;
                }

                Logger::Info((String("Chunk generation speed: ") + String(gen_speed) + " chunks/sec, avg: " + String(avg_gen_speed) + " chunks/sec.").Data());
            }
        }
    }

    priv InitializeSkylight(this: &mut World, chunk: *mut Chunk) {
        let mut height: u64 = 0u64;
        let mut x: u64 = 0u64;

        while x < CHUNK_WIDTH {
            let mut z: u64 = 0u64;

            while z < CHUNK_DEPTH {
                let mut y: u64 = CHUNK_HEIGHT - 1u64;

                while (y as i64) > -1i64 {
                    if chunk->subchunks[y / SUBCHUNK_HEIGHT]->GetBlock(Vector3(x as f32, (y % SUBCHUNK_HEIGHT) as f32, z as f32)) != 0u8 {
                        break;
                    } y -= 1u64;
                }

                if y > height {
                    height = y;
                } z += 1u64;
            } x += 1u64;
        } x = 0u64;

        while x < CHUNK_WIDTH {
            let mut z: u64 = 0u64;

            while z < CHUNK_DEPTH {
                let mut y: u64 = CHUNK_HEIGHT - 1u64;

                while y > height {
                    chunk->subchunks[y / SUBCHUNK_HEIGHT]->SetSkylight(Vector3(x as f32, (y % SUBCHUNK_HEIGHT) as f32, z as f32), 15u8);
                    y -= 1u64;
                }

                let position: Vector3 = { chunk->world_position.x + x as f32, y as f32, chunk->world_position.z + z as f32 };
                this.skylight_increase_queue.PushBack(Pair<Vector3, u8>(position, 15u8));
                z += 1u64;
            } x += 1u64;
        }

        this.PropagateSkylightIncrease(false);
    }

    priv PropagateSkylightIncrease(this: &mut World, light_update: bool) {
        let neighbor_offsets[]: Vector3 = {
            Vector3(1.0f32, 0.0f32, 0.0f32), Vector3(-1.0f32,  0.0f32,  0.0f32),
            Vector3(0.0f32, 1.0f32, 0.0f32), Vector3( 0.0f32, -1.0f32,  0.0f32),
            Vector3(0.0f32, 0.0f32, 1.0f32), Vector3( 0.0f32,  0.0f32, -1.0f32)
        };

        while this.skylight_increase_queue.Size() != 0u64 {
            let values: Pair<Vector3, u8> = this.skylight_increase_queue.Pop(0u64);
            let mut i: u64 = 0u64;

            while i < 6u64 {
                let neighbour_position: Vector3 = values.left + neighbor_offsets[i];

                if neighbour_position.y < 0.0f32 || neighbour_position.y >= CHUNK_HEIGHT as f32 {
                    i += 1u64;
                    continue;
                }

                let chunk_position: Vector3 = (neighbour_position / Vector3(CHUNK_WIDTH as f32, CHUNK_HEIGHT as f32, CHUNK_DEPTH as f32)).Floor();
                let chunk: *mut Chunk = this.GetChunk(chunk_position);

                if chunk != null {
                    let subchunk_position: Vector3 = (neighbour_position / Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32)).Floor();
                    let local_position: Vector3 = neighbour_position - (subchunk_position * Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32));
                    let subchunk: *mut Subchunk = chunk->subchunks[subchunk_position.y as u64];

                    if subchunk->GetBlock(local_position) == 0u8 {
                        let current_skylight: u8 = subchunk->GetSkylight(local_position);
                        
                        if current_skylight < values.right {
                            if light_update {
                                this.UpdateAtPosition(neighbour_position);
                            }

                            if neighbor_offsets[i].y == -1.0f32 {
                                subchunk->SetSkylight(local_position, values.right);
                                this.skylight_increase_queue.PushBack(Pair<Vector3, u8>(neighbour_position, values.right));
                            } else if current_skylight + 2u8 <= values.right {
                                subchunk->SetSkylight(local_position, values.right - 1u8);
                                this.skylight_increase_queue.PushBack(Pair<Vector3, u8>(neighbour_position, values.right - 1u8));
                            }
                        }
                    }
                } i += 1u64;
            }
        }
    }

    pub DecreaseSkylight(this: &mut World, position: &Vector3, light_update: bool) {
        let chunk_position: Vector3 = (position / Vector3(CHUNK_WIDTH as f32, CHUNK_HEIGHT as f32, CHUNK_DEPTH as f32)).Floor();
        let chunk: *mut Chunk = this.GetChunk(chunk_position);

        if chunk != null {
            let subchunk_position: Vector3 = (position / Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32)).Floor();
            let local_position: Vector3 = position - (subchunk_position * Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32));
            let old_light: u8 = chunk->subchunks[subchunk_position.y as u64]->GetSkylight(local_position);
            chunk->subchunks[subchunk_position.y as u64]->SetSkylight(local_position, 0u8);
            this.skylight_decrease_queue.PushBack(Pair<Vector3, u8>(position, old_light));
            this.PropagateSkylightDecrease(light_update);
            this.PropagateSkylightIncrease(light_update);
        }
    }

    priv PropagateSkylightDecrease(this: &mut World, light_update: bool) {
        let neighbor_offsets[]: Vector3 = {
            Vector3(1.0f32, 0.0f32, 0.0f32), Vector3(-1.0f32,  0.0f32,  0.0f32),
            Vector3(0.0f32, 1.0f32, 0.0f32), Vector3( 0.0f32, -1.0f32,  0.0f32),
            Vector3(0.0f32, 0.0f32, 1.0f32), Vector3( 0.0f32,  0.0f32, -1.0f32)
        };

        while this.skylight_decrease_queue.Size() != 0u64 {
            let values: Pair<Vector3, u8> = this.skylight_decrease_queue.Pop(0u64);
            let mut i: u64 = 0u64;

            while i < 6u64 {
                let neighbour_position: Vector3 = values.left + neighbor_offsets[i];

                if neighbour_position.y < 0.0f32 || neighbour_position.y >= CHUNK_HEIGHT as f32 {
                    i += 1u64;
                    continue;
                }

                let chunk_position: Vector3 = (neighbour_position / Vector3(CHUNK_WIDTH as f32, CHUNK_HEIGHT as f32, CHUNK_DEPTH as f32)).Floor();
                let chunk: *mut Chunk = this.GetChunk(chunk_position);

                if chunk != null {
                    let subchunk_position: Vector3 = (neighbour_position / Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32)).Floor();
                    let local_position: Vector3 = neighbour_position - (subchunk_position * Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32));
                    let subchunk: *mut Subchunk = chunk->subchunks[subchunk_position.y as u64];

                    if subchunk->GetBlock(local_position) == 0u8 {
                        let neighbour_level: u8 = subchunk->GetSkylight(local_position);

                        if neighbour_level != 0u8 {
                            if neighbor_offsets[i].y == -1.0f32 || neighbour_level < values.right {
                                subchunk->SetSkylight(local_position, 0u8);

                                if light_update {
                                    this.UpdateAtPosition(neighbour_position);
                                }

                                this.skylight_decrease_queue.PushBack(Pair<Vector3, u8>(neighbour_position, neighbour_level));
                            } else if neighbour_level >= values.right {
                                this.skylight_increase_queue.PushBack(Pair<Vector3, u8>(neighbour_position, neighbour_level));
                            }
                        }
                    }
                } i += 1u64;
            }
        }
    }

    pub IncreaseLight(this: &mut World, position: &Vector3, newlight: u8, light_update: bool) {
        let chunk_position: Vector3 = (position / Vector3(CHUNK_WIDTH as f32, CHUNK_HEIGHT as f32, CHUNK_DEPTH as f32)).Floor();
        let chunk: *mut Chunk = this.GetChunk(chunk_position);

        if chunk != null {
            let subchunk_position: Vector3 = (position / Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32)).Floor();
            let local_position: Vector3 = position - (subchunk_position * Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32));
            chunk->subchunks[subchunk_position.y as u64]->SetBlockLight(local_position, newlight);
            this.light_increase_queue.PushBack(Pair<Vector3, u8>(position, newlight));
            this.PropagateIncrease(light_update);
        }
    }

    priv PropagateIncrease(this: &mut World, light_update: bool) {
        let neighbor_offsets[]: Vector3 = {
            Vector3(1.0f32, 0.0f32, 0.0f32), Vector3(-1.0f32,  0.0f32,  0.0f32),
            Vector3(0.0f32, 1.0f32, 0.0f32), Vector3( 0.0f32, -1.0f32,  0.0f32),
            Vector3(0.0f32, 0.0f32, 1.0f32), Vector3( 0.0f32,  0.0f32, -1.0f32)
        };

        while this.light_increase_queue.Size() != 0u64 {
            let values: Pair<Vector3, u8> = this.light_increase_queue.Pop(0u64);
            let mut i: u64 = 0u64;

            while i < 6u64 {
                let neighbour_position: Vector3 = values.left + neighbor_offsets[i];

                if neighbour_position.y < 0.0f32 || neighbour_position.y >= CHUNK_HEIGHT as f32 {
                    i += 1u64;
                    continue;
                }

                let chunk_position: Vector3 = (neighbour_position / Vector3(CHUNK_WIDTH as f32, CHUNK_HEIGHT as f32, CHUNK_DEPTH as f32)).Floor();
                let chunk: *mut Chunk = this.GetChunk(chunk_position);

                if chunk != null {
                    let subchunk_position: Vector3 = (neighbour_position / Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32)).Floor();
                    let local_position: Vector3 = neighbour_position - (subchunk_position * Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32));
                    let subchunk: *mut Subchunk = chunk->subchunks[subchunk_position.y as u64];

                    if subchunk->GetBlock(local_position) == 0u8 && subchunk->GetBlockLight(local_position) + 2u8 <= values.right {
                        subchunk->SetBlockLight(local_position, values.right - 1u8);
                        this.light_increase_queue.PushBack(Pair<Vector3, u8>(neighbour_position, values.right - 1u8));

                        if light_update {
                            this.UpdateAtPosition(neighbour_position);
                        }
                    }
                } i += 1u64;
            }
        }
    }

    pub DecreaseLight(this: &mut World, position: &Vector3) {
        let chunk_position: Vector3 = (position / Vector3(CHUNK_WIDTH as f32, CHUNK_HEIGHT as f32, CHUNK_DEPTH as f32)).Floor();
        let chunk: *mut Chunk = this.GetChunk(chunk_position);

        if chunk != null {
            let subchunk_position: Vector3 = (position / Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32)).Floor();
            let local_position: Vector3 = position - (subchunk_position * Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32));
            let old_light: u8 = chunk->subchunks[subchunk_position.y as u64]->GetBlockLight(local_position);
            chunk->subchunks[subchunk_position.y as u64]->SetBlockLight(local_position, 0u8);
            this.light_decrease_queue.PushBack(Pair<Vector3, u8>(position, old_light));
            this.PropagateDecrease(true);
            this.PropagateIncrease(true);
        }
    }

    priv PropagateDecrease(this: &mut World, light_update: bool) {
        let neighbor_offsets[]: Vector3 = {
            Vector3(1.0f32, 0.0f32, 0.0f32), Vector3(-1.0f32,  0.0f32,  0.0f32),
            Vector3(0.0f32, 1.0f32, 0.0f32), Vector3( 0.0f32, -1.0f32,  0.0f32),
            Vector3(0.0f32, 0.0f32, 1.0f32), Vector3( 0.0f32,  0.0f32, -1.0f32)
        };

        while this.light_decrease_queue.Size() != 0u64 {
            let values: Pair<Vector3, u8> = this.light_decrease_queue.Pop(0u64);
            let mut i: u64 = 0u64;

            while i < 6u64 {
                let neighbour_position: Vector3 = values.left + neighbor_offsets[i];

                if neighbour_position.y < 0.0f32 || neighbour_position.y >= CHUNK_HEIGHT as f32 {
                    i += 1u64;
                    continue;
                }

                let chunk_position: Vector3 = (neighbour_position / Vector3(CHUNK_WIDTH as f32, CHUNK_HEIGHT as f32, CHUNK_DEPTH as f32)).Floor();
                let chunk: *mut Chunk = this.GetChunk(chunk_position);

                if chunk != null {
                    let subchunk_position: Vector3 = (neighbour_position / Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32)).Floor();
                    let local_position: Vector3 = neighbour_position - (subchunk_position * Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32));
                    let subchunk: *mut Subchunk = chunk->subchunks[subchunk_position.y as u64];
                    let block: u8 = subchunk->GetBlock(local_position);
                    let mut light_source: bool = false;
                    let mut j: u64 = 0u64;

                    while j < this.light_blocks.Size() {
                        if this.light_blocks[j] == block {
                            light_source = true;
                            break;
                        } j += 1u64;
                    }

                    if light_source {
                        this.light_increase_queue.PushBack(Pair<Vector3, u8>(neighbour_position, 15u8));
                    } else if block == 0u8 {
                        let neighbour_level: u8 = subchunk->GetBlockLight(local_position);

                        if neighbour_level != 0u8 {
                            if neighbour_level < values.right {
                                subchunk->SetBlockLight(local_position, 0u8);

                                if light_update {
                                    this.UpdateAtPosition(neighbour_position);
                                }

                                this.light_decrease_queue.PushBack(Pair<Vector3, u8>(neighbour_position, neighbour_level));
                            } else if neighbour_level >= values.right {
                                this.light_increase_queue.PushBack(Pair<Vector3, u8>(neighbour_position, neighbour_level));
                            }
                        }
                    }
                } i += 1u64;
            }
        }
    }

    priv QueueChunkUpload(this: &mut World, chunk: *mut Chunk) {
        let mut found: bool = false;
        mtx_lock(&this.chunk_upload_mutex);
        let mut i: u64 = 0u64;

        while i < this.chunk_upload_queue.Size() {
            if this.chunk_upload_queue[i] == chunk { 
                found = true; 
                break; 
            } i += 1u64;
        }

        if !found { 
            this.chunk_upload_queue.PushBack(chunk); 
        }

        mtx_unlock(&this.chunk_upload_mutex);
    }

    priv UpdateAtPosition(this: &mut World, position: Vector3) {
        let chunk_position: Vector3 = (position / Vector3(CHUNK_WIDTH as f32, CHUNK_HEIGHT as f32, CHUNK_DEPTH as f32)).Floor();
        let chunk: *mut Chunk = this.GetChunk(chunk_position);

        if chunk != null {
            let subchunk_position: Vector3 = (position / Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32)).Floor();
            let local_position: Vector3 = position - (subchunk_position * Vector3(SUBCHUNK_WIDTH as f32, SUBCHUNK_HEIGHT as f32, SUBCHUNK_DEPTH as f32));
            chunk->subchunks[subchunk_position.y as u64]->Update();
            this.QueueChunkUpload(chunk);

            if local_position.x == (SUBCHUNK_WIDTH as f32) - 1.0f32 {
                if chunk->east_neighbor != null {
                    chunk->east_neighbor->subchunks[subchunk_position.y as u64]->Update();
                    this.QueueChunkUpload(chunk->east_neighbor);
                }
            } else if local_position.x == 0.0f32 {
                if chunk->west_neighbor != null {
                    chunk->west_neighbor->subchunks[subchunk_position.y as u64]->Update();
                    this.QueueChunkUpload(chunk->west_neighbor);
                }
            }

            if local_position.y == (SUBCHUNK_HEIGHT as f32) - 1.0f32 {
                chunk->subchunks[(subchunk_position.y as u64) + 1u64]->Update();
                this.QueueChunkUpload(chunk);
            } else if local_position.y == 0.0f32 {
                chunk->subchunks[(subchunk_position.y as u64) - 1u64]->Update();
                this.QueueChunkUpload(chunk);
            }

            if local_position.z == (SUBCHUNK_DEPTH as f32) - 1.0f32 {
                if chunk->south_neighbor != null {
                    chunk->south_neighbor->subchunks[subchunk_position.y as u64]->Update();
                    this.QueueChunkUpload(chunk->south_neighbor);
                }
            } else if local_position.z == 0.0f32 {
                if chunk->north_neighbor != null {
                    chunk->north_neighbor->subchunks[subchunk_position.y as u64]->Update();
                    this.QueueChunkUpload(chunk->north_neighbor);
                }
            }
        }
    }

    pub Raycast(this: &World, origin: Vector3, direction: Vector3, max_distance: f32) -> RaycastResult {
        let mut position: Vector3 = origin + Vector3(0.5f32, 0.5f32, 0.5f32);

        let step_x: f32 = direction.x > 0.0f32 ? 1.0f32 : (direction.x < 0.0f32 ? -1.0f32 : 0.0f32);
        let step_y: f32 = direction.y > 0.0f32 ? 1.0f32 : (direction.y < 0.0f32 ? -1.0f32 : 0.0f32);
        let step_z: f32 = direction.z > 0.0f32 ? 1.0f32 : (direction.z < 0.0f32 ? -1.0f32 : 0.0f32);

        let delta_x: f32 = direction.x != 0.0f32 ? fabs(1.0f64 / direction.x as f64) as f32 : 1.0f32 / 0.0f32;
        let delta_y: f32 = direction.y != 0.0f32 ? fabs(1.0f64 / direction.y as f64) as f32 : 1.0f32 / 0.0f32;
        let delta_z: f32 = direction.z != 0.0f32 ? fabs(1.0f64 / direction.z as f64) as f32 : 1.0f32 / 0.0f32;

        let mut max_x: f32 = direction.x > 0.0f32 ? (floorf(position.x) + 1.0f32 - position.x) * delta_x : (position.x - floorf(position.x)) * delta_x;
        let mut max_y: f32 = direction.y > 0.0f32 ? (floorf(position.y) + 1.0f32 - position.y) * delta_y : (position.y - floorf(position.y)) * delta_y;
        let mut max_z: f32 = direction.z > 0.0f32 ? (floorf(position.z) + 1.0f32 - position.z) * delta_z : (position.z - floorf(position.z)) * delta_z;

        let mut normal: Vector3;
        let mut distance: f32 = 0.0f32;

        while distance < max_distance {
            if this.GetBlock(position) != 0u8 {
                ret RaycastResult(true, position.Floor(), normal);
            }

            if max_x < max_y {
                if max_x < max_z {
                    distance = max_x;
                    max_x += delta_x;
                    position.x += step_x;
                    normal = Vector3(-step_x, 0.0f32, 0.0f32);
                } else {
                    distance = max_z;
                    max_z += delta_z;
                    position.z += step_z;
                    normal = Vector3(0.0f32, 0.0f32, -step_z);
                }
            } else {
                if max_y < max_z {
                    distance = max_y;
                    max_y += delta_y;
                    position.y += step_y;
                    normal = Vector3(0.0f32, -step_y, 0.0f32);
                } else {
                    distance = max_z;
                    max_z += delta_z;
                    position.z += step_z;
                    normal = Vector3(0.0f32, 0.0f32, -step_z);
                }
            }
        }

        ret RaycastResult(false, Vector3(0.0f32, 0.0f32, 0.0f32), Vector3(0.0f32, 0.0f32, 0.0f32));
    }

    pub Update(this: &mut World, delta_time: f64, _player: *mut void) {
        let player: *mut Player = _player as *mut Player;
        mtx_lock(&this.current_chunk_mutex);
        this.current_chunk = (player->translation / Vector3(CHUNK_WIDTH as f32, CHUNK_HEIGHT as f32, CHUNK_DEPTH as f32)).Floor();
        this.current_chunk.y = 0.0f32;
        mtx_unlock(&this.current_chunk_mutex);

        while true {
            mtx_lock(&this.chunk_upload_mutex);

            if this.chunk_upload_queue.Size() == 0u64 {
                mtx_unlock(&this.chunk_upload_mutex);
                break;
            }

            let chunk: *mut Chunk = this.chunk_upload_queue.Pop(0u64);
            mtx_unlock(&this.chunk_upload_mutex);
            chunk->Upload();
            chunk->busy = false;
        }

        while true {
            mtx_lock(&this.chunk_delete_mutex);

            if this.chunk_delete_queue.Size() == 0u64 {
                mtx_unlock(&this.chunk_delete_mutex);
                break;
            }

            let chunk: *mut Chunk = this.chunk_delete_queue.Pop(0u64);
            mtx_unlock(&this.chunk_delete_mutex);
            del chunk;
        }
    }

    pub Render(this: &World) {
        mtx_lock(&this.chunk_mutex);
        let mut i: u64 = 0u64;

        while i < HASH_SIZE {
            let mut j: u64 = 0u64;

            while j < this.buckets[i]->Size() {
                this.buckets[i]->Data()[j]->Render();
                j += 1u64;
            } i += 1u64;
        }

        mtx_unlock(&this.chunk_mutex);
    }
};

class Collider {
    pub min: Vector3, pub max: Vector3
} impl {
    Collider(this: &mut Collider, min: Vector3, max: Vector3) {
        (this.min, this.max) = (min, max);
    }

    ~Collider(this: &mut Collider) {}

    pub Collide(this: &Collider, other: &Collider) -> bool {
        ret this.min.x < other.max.x && this.max.x > other.min.x && this.min.y < other.max.y && this.max.y > other.min.y && this.min.z < other.max.z && this.max.z > other.min.z;
    }

    pub Collide(this: &Collider, other: &Collider, velocity: Vector3) -> Pair<f32, Vector3> {
        let xEntry: f32 = velocity.x != 0.0f32 ? (velocity.x > 0.0f32 ? other.min.x - this.max.x : other.max.x - this.min.x) / velocity.x : (this.min.x < other.max.x && this.max.x > other.min.x ? -1.0f32 / 0.0f32 : 1.0f32 / 0.0f32);
        let xExit: f32 = velocity.x != 0.0f32 ? (velocity.x > 0.0f32 ? other.max.x - this.min.x : other.min.x - this.max.x) / velocity.x : (this.min.x < other.max.x && this.max.x > other.min.x ? 1.0f32 / 0.0f32 : -1.0f32 / 0.0f32);

        let yEntry: f32 = velocity.y != 0.0f32 ? (velocity.y > 0.0f32 ? other.min.y - this.max.y : other.max.y - this.min.y) / velocity.y : (this.min.y < other.max.y && this.max.y > other.min.y ? -1.0f32 / 0.0f32 : 1.0f32 / 0.0f32);
        let yExit: f32 = velocity.y != 0.0f32 ? (velocity.y > 0.0f32 ? other.max.y - this.min.y : other.min.y - this.max.y) / velocity.y : (this.min.y < other.max.y && this.max.y > other.min.y ? 1.0f32 / 0.0f32 : -1.0f32 / 0.0f32);

        let zEntry: f32 = velocity.z != 0.0f32 ? (velocity.z > 0.0f32 ? other.min.z - this.max.z : other.max.z - this.min.z) / velocity.z : (this.min.z < other.max.z && this.max.z > other.min.z ? -1.0f32 / 0.0f32 : 1.0f32 / 0.0f32);
        let zExit: f32 = velocity.z != 0.0f32 ? (velocity.z > 0.0f32 ? other.max.z - this.min.z : other.min.z - this.max.z) / velocity.z : (this.min.z < other.max.z && this.max.z > other.min.z ? 1.0f32 / 0.0f32 : -1.0f32 / 0.0f32);

        if xEntry < 0.0f32 && yEntry < 0.0f32 && zEntry < 0.0f32 {
            ret Pair<f32, Vector3>(0.0f32, Vector3(0.0f32, 0.0f32, 0.0f32));
        }

        if xEntry > 1.0f32 || yEntry > 1.0f32 || zEntry > 1.0f32 {
            ret Pair<f32, Vector3>(0.0f32, Vector3(0.0f32, 0.0f32, 0.0f32));
        }

        let entry: f32 = fmaxf(fmaxf(xEntry, yEntry), zEntry);
        let exit: f32 = fminf(fminf(xExit, yExit), zExit);

        if entry > exit {
            ret Pair<f32, Vector3>(0.0f32, Vector3(0.0f32, 0.0f32, 0.0f32));
        } else {
            let mut normal: Vector3 = Vector3(0.0f32, 0.0f32, 0.0f32);

            if entry == yEntry {
                normal.y = velocity.y > 0.0f32 ? -1.0f32 : 1.0f32;
            } else if entry == xEntry {
                normal.x = velocity.x > 0.0f32 ? -1.0f32 : 1.0f32;
            } else {
                normal.z = velocity.z > 0.0f32 ? -1.0f32 : 1.0f32;
            }

            ret Pair<f32, Vector3>(entry, normal);
        }
    }

    pub op+(this: &Collider, position: Vector3) -> Collider {
        ret Collider(this.min + position, this.max + position);
    }
};

const WALKING_SPEED: f32 = 4.317f32;
const SPRINTING_SPEED: f32 = 5.612f32;
const CROUCHING_SPEED: f32 = 1.295f32;

const FIXED_DELTA_TIME: f64 = 1.0f64 / 240.0f64;

class Player {
    pub yaw: f64, pub pitch: f64,
    priv width: f64, priv height: f64,
    pub translation: Vector3,
    priv velocity: Vector3,
    priv acceleration: Vector3,
    pub front: Vector3,
    pub eye_level: f32 = 1.6f32,
    priv collider: Collider,
    pub flying: bool = false,
    priv grounded: bool = false,
    priv world: *mut World,
    priv last_jump: f64 = 0.0f64,
    priv last_walk: f64 = 0.0f64,
    priv jump_state: bool = true,
    priv walk_state: bool = true,
    priv left_click_state: bool = true,
    priv right_click_state: bool = true,
    priv selected_block: u8 = 3u8,
    pub flight_multiplier: f32 = 2.0f32,
    priv target_speed: f32 = WALKING_SPEED,
    priv speed: f32 = WALKING_SPEED,
    priv target_fov: f32 = 90.0f32,
    pub fov: f32 = 90.0f32,
    priv no_clip_state: bool = true,
    priv no_clip: bool = false,
    priv accumulator: f64 = 0.0f64,
    priv mouse_skip: bool = false
} impl {
    Player(this: &mut Player, world: *mut World) {
        (this.yaw, this.pitch) = (0.0f64, 0.0f64);
        (this.width, this.height) = (0.6f64, 1.8f64);
        this.translation = Vector3(0.0f32, 128.0f32, 0.0f32);
        this.world = world;
    }

    ~Player(this: &mut Player) {}

    pub UpdateCollider(this: &mut Player) {
        this.collider.min.x = this.translation.x - (this.width / 2.0f64) as f32;
        this.collider.min.y = this.translation.y;
        this.collider.min.z = this.translation.z - (this.width / 2.0f64) as f32;

        this.collider.max.x = this.translation.x + (this.width / 2.0f64) as f32;
        this.collider.max.y = this.translation.y + this.height as f32;
        this.collider.max.z = this.translation.z + (this.width / 2.0f64) as f32;
    }

    pub Update(this: &mut Player, window: *mut GLFWwindow, delta_time: f64) {
        this.accumulator += delta_time;

        while this.accumulator >= FIXED_DELTA_TIME {
            this.FixedUpdate(window, FIXED_DELTA_TIME);
            this.accumulator -= FIXED_DELTA_TIME;
        }
    }

    priv FixedUpdate(this: &mut Player, window: *mut GLFWwindow, delta_time: f64) {
        this.UpdateCollider();

        if glfwGetKey(window, GLFW_KEY_LEFT_ALT) < GLFW_PRESS && glfwGetWindowAttrib(window, GLFW_FOCUSED) != 0i32 {
            let (mut width: i32, mut height: i32);
            glfwGetWindowSize(window, &width, &height);

            if !this.mouse_skip {
                let (mut x: f64, mut y: f64);
                glfwGetCursorPos(window, &x, &y);
                let sensitivity: f64 = 100.0f64;

                this.yaw += sensitivity * (x - (width as f64) / 2.0f64) / (width as f64);
                this.pitch -= sensitivity * (y - (height as f64) / 2.0f64) / (height as f64);

                if this.pitch > 89.9f64 {
                    this.pitch = 89.9f64;
                }

                if this.pitch < -89.9f64 {
                    this.pitch = -89.9f64;
                }

                if glfwGetMouseButton(window, GLFW_MOUSE_BUTTON_LEFT) >= GLFW_PRESS {
                    if this.left_click_state {
                        let eye_translation: Vector3 = this.translation + Vector3(0.0f32, this.eye_level, 0.0f32);
                        let ray: RaycastResult = this.world->Raycast(eye_translation, this.front.Normalize(), 3.0f32);

                        if ray.hit {
                            this.world->SetBlock(ray.position, 0u8);
                        } this.left_click_state = false;
                    }
                } else {
                    this.left_click_state = true;
                }

                if glfwGetMouseButton(window, GLFW_MOUSE_BUTTON_RIGHT) >= GLFW_PRESS {
                    if this.right_click_state {
                        let eye_translation: Vector3 = this.translation + Vector3(0.0f32, this.eye_level, 0.0f32);
                        let ray: RaycastResult = this.world->Raycast(eye_translation, this.front.Normalize(), 3.0f32);

                        if ray.hit {
                            let collider: Collider = Collider(Vector3(-0.5f32, -0.5f32, -0.5f32), Vector3(0.5f32, 0.5f32, 0.5f32));

                            if !this.collider.Collide(collider + ray.position + ray.normal) {
                                this.world->SetBlock(ray.position + ray.normal, this.selected_block);
                            }
                        } this.right_click_state = false;
                    }
                } else {
                    this.right_click_state = true;
                }
            } else {
                this.mouse_skip = false;
            }

            glfwSetCursorPos(window, (width as f64) / 2.0f64, (height as f64) / 2.0f64);
            glfwSetInputMode(window, GLFW_CURSOR, GLFW_CURSOR_HIDDEN);
        } else {
            glfwSetInputMode(window, GLFW_CURSOR, GLFW_CURSOR_NORMAL);
            this.mouse_skip = true;
        }

        let current: f64 = glfwGetTime();

        if glfwGetKey(window, GLFW_KEY_SPACE) >= GLFW_PRESS {
            if this.jump_state {
                if current < this.last_jump + 0.25f64 {
                    this.flying = !this.flying;
                }

                this.last_jump = current;
                this.jump_state = false;
            }
        } else {
            this.jump_state = true;
        }

        if glfwGetKey(window, GLFW_KEY_W) >= GLFW_PRESS {
            if this.walk_state {
                if current < this.last_walk + 0.25f64 {
                    this.target_speed = SPRINTING_SPEED;
                }

                this.last_walk = current;
                this.walk_state = false;
            }
        } else {
            this.walk_state = true;
        }

        let speed: f32 = sqrtf(powf(this.velocity.x, 2.0f32) + powf(this.velocity.z, 2.0f32));

        if ((glfwGetKey(window, GLFW_KEY_LEFT_CONTROL) >= GLFW_PRESS && speed > WALKING_SPEED / 3.0f32) || this.target_speed == SPRINTING_SPEED) && glfwGetKey(window, GLFW_KEY_W) >= GLFW_PRESS && glfwGetKey(window, GLFW_KEY_S) < GLFW_PRESS {
            this.target_speed = SPRINTING_SPEED;
        } else {
            this.target_speed = WALKING_SPEED;
        }

        if delta_time * 20.0f64 > 1.0f64 {
            this.speed = this.target_speed;
        } else {
            this.speed += (this.target_speed - this.speed) * (delta_time as f32) * 20.0f32;
        }

        let multiplier: f32 = this.speed * (this.flying ? this.flight_multiplier : 1.0f32);
        this.front.x = cosf(ToRadians(this.yaw as f32)) * cosf(ToRadians(this.pitch as f32));
        this.front.y = sinf(ToRadians(this.pitch as f32));
        this.front.z = sinf(ToRadians(this.yaw as f32)) * cosf(ToRadians(this.pitch as f32));

        if glfwGetKey(window, GLFW_KEY_W) >= GLFW_PRESS {
            this.acceleration += Vector3(cosf(ToRadians(this.yaw as f32)), 0.0f32, sinf(ToRadians(this.yaw as f32))) * multiplier;
        }

        if glfwGetKey(window, GLFW_KEY_S) >= GLFW_PRESS {
            this.acceleration -= Vector3(cosf(ToRadians(this.yaw as f32)), 0.0f32, sinf(ToRadians(this.yaw as f32))) * multiplier;
        }

        if glfwGetKey(window, GLFW_KEY_A) >= GLFW_PRESS {
            this.acceleration -= Cross(this.front, Vector3(0.0f32, 1.0f32, 0.0f32)).Normalize() * multiplier;
        }

        if glfwGetKey(window, GLFW_KEY_D) >= GLFW_PRESS {
            this.acceleration += Cross(this.front, Vector3(0.0f32, 1.0f32, 0.0f32)).Normalize() * multiplier;
        }

        if this.flying {
            if glfwGetKey(window, GLFW_KEY_SPACE) >= GLFW_PRESS {
                this.acceleration += Vector3(0.0f32, 1.0f32, 0.0f32) * multiplier;
            }

            if glfwGetKey(window, GLFW_KEY_LEFT_SHIFT) >= GLFW_PRESS {
                this.acceleration -= Vector3(0.0f32, 1.0f32, 0.0f32) * multiplier;
            }
        } else {
            if glfwGetKey(window, GLFW_KEY_SPACE) >= GLFW_PRESS && this.grounded {
                this.velocity.y += sqrtf(2.0f32 * 1.25f32 * 32.0f32);
            }
        }

        let mut friction: Vector3;

        if this.flying {
            friction = Vector3(5.0f32, 5.0f32, 5.0f32);
        } else if this.grounded {
            friction = Vector3(20.0f32, 20.0f32, 20.0f32);
        } else if this.velocity.y > 0.0f32 {
            friction = Vector3(1.8f32, 0.0f32, 1.8f32);
        } else {
            friction = Vector3(1.8f32, 0.4f32, 1.8f32);
        }

        this.grounded = false;
        this.velocity += this.acceleration * friction * (delta_time as f32);
        this.acceleration = Vector3(0.0f32, 0.0f32, 0.0f32);
        let mut _: u64 = 0u64;

        if glfwGetKey(window, GLFW_KEY_TAB) >= GLFW_PRESS {
            if this.no_clip_state {
                this.no_clip = !this.no_clip;
                this.no_clip_state = false;
            }
        } else {
            this.no_clip_state = true;
        }

        while _ < (this.no_clip ? 0u64 : 3u64) {
            let adjusted_velocity: Vector3 = this.velocity * (delta_time as f32);

            let step_x: i64 = adjusted_velocity.x > 0.0f32 ? 1i64 : -1i64;
            let step_y: i64 = adjusted_velocity.y > 0.0f32 ? 1i64 : -1i64;
            let step_z: i64 = adjusted_velocity.z > 0.0f32 ? 1i64 : -1i64;

            let steps_xz: i64 = (this.width / 2.0f64) as i64;
            let steps_y: i64 = this.height as i64;

            let mut entry: f32 = 1.0f32 / 0.0f32;
            let mut normal: Vector3 = Vector3(0.0f32, 0.0f32, 0.0f32);
            let mut i: i64 = (this.translation.x as i64) - step_x * (steps_xz + 1i64);

            while i != (this.translation.x + adjusted_velocity.x) as i64 + step_x * (steps_xz + 2i64) {
                let mut j: i64 = (this.translation.y as i64) - step_y * (steps_y + 2i64);

                while j != (this.translation.y + adjusted_velocity.y) as i64 + step_y * (steps_y + 3i64) {
                    let mut k: i64 = (this.translation.z as i64) - step_z * (steps_xz + 1i64);

                    while k != (this.translation.z + adjusted_velocity.z) as i64 + step_z * (steps_xz + 2i64) {
                        let position: Vector3 = Vector3(i as f32, j as f32, k as f32);
                        let number: u8 = this.world->GetBlock(position);

                        if number != 0u8 {
                            let collider: Collider = Collider(Vector3(-0.5f32, -0.5f32, -0.5f32), Vector3(0.5f32, 0.5f32, 0.5f32));
                            let result: Pair<f32, Vector3> = this.collider.Collide(collider + position, adjusted_velocity);
                            
                            if result.right.x != 0.0f32 || result.right.y != 0.0f32 || result.right.z != 0.0f32 {
                                if entry > result.left {
                                    entry = result.left;
                                    normal = result.right;
                                }
                            }
                        } k += step_z;
                    } j += step_y;
                } i += step_x;
            } i = 0i64;

            entry -= 0.001f32;

            if normal.x != 0.0f32 {
                this.velocity.x = 0.0f32;
                this.translation.x += adjusted_velocity.x * entry;

                if speed < WALKING_SPEED / 3.0f32 && this.target_speed == SPRINTING_SPEED {
                    this.target_speed = WALKING_SPEED;
                }
            }

            if normal.y != 0.0f32 {
                this.velocity.y = 0.0f32;
                this.translation.y += adjusted_velocity.y * entry;
            }

            if normal.z != 0.0f32 {
                this.velocity.z = 0.0f32;
                this.translation.z += adjusted_velocity.z * entry;

                if speed < WALKING_SPEED / 3.0f32 && this.target_speed == SPRINTING_SPEED {
                    this.target_speed = WALKING_SPEED;
                }
            }

            if normal.y == 1.0f32 {
                this.grounded = true;
                this.flying = false;
            } _ += 1u64;
        }

        this.translation += this.velocity * (delta_time as f32);
        let mut gravity: Vector3;

        if this.flying {
            gravity = Vector3(0.0f32, 0.0f32, 0.0f32);
        } else {
            gravity = Vector3(0.0f32, -32.0f32, 0.0f32);
        }

        this.velocity += gravity * (delta_time as f32);

        if fabs((this.velocity.x * friction.x) as f64 * delta_time) > fabs(this.velocity.x as f64) {
            this.velocity.x -= this.velocity.x;
        } else {
            this.velocity.x -= this.velocity.x * friction.x * (delta_time as f32);
        }

        if fabs((this.velocity.y * friction.y) as f64 * delta_time) > fabs(this.velocity.y as f64) {
            this.velocity.y -= this.velocity.y;
        } else {
            this.velocity.y -= this.velocity.y * friction.y * (delta_time as f32);
        }

        if fabs((this.velocity.z * friction.z) as f64 * delta_time) > fabs(this.velocity.z as f64) {
            this.velocity.z -= this.velocity.z;
        } else {
            this.velocity.z -= this.velocity.z * friction.z * (delta_time as f32);
        }

        if glfwGetKey(window, GLFW_KEY_C) < GLFW_PRESS {
            this.target_fov = 90.0f32 + (this.flying ? 15.0f32 : 0.0f32) + (this.target_speed == SPRINTING_SPEED ? 25.0f32 : 0.0f32);
        } else {
            this.target_fov = 30.0f32;
        }

        this.fov = Lerp(this.fov as f64, this.target_fov as f64, delta_time * 8.0f64) as f32;
    }
};

func UpdateViewport(window: *mut GLFWwindow, width: i32, height: i32) {
    Logger::Info((String("Viewport updated, width: ") + String(width) + ", height: " + String(height) + ".").Data());
    glViewport(0i32, 0i32, width, height);
}

func ScrollCallback(window: *mut GLFWwindow, x_offset: f64, y_offset: f64) {
    let player: *mut Player = glfwGetWindowUserPointer(window) as *mut Player;

    if player->flying {
        player->flight_multiplier = fmaxf(2.0f32, fminf(10.0f32, player->flight_multiplier + y_offset as f32));
    }
}

func main(argc: i32, argv[]: *const i8) -> i32 {
    glfwInit();
    let window: *mut GLFWwindow = glfwCreateWindow(1600i32, 900i32, "Divcraft", null, null);
    glfwSetFramebufferSizeCallback(window, UpdateViewport);
    glfwMakeContextCurrent(window);
    // glfwSwapInterval(1i32);

    let darkMode: i32 = 1i32;
    DwmSetWindowAttribute(glfwGetWin32Window(window), DWMWINDOWATTRIBUTE::DWMWA_USE_IMMERSIVE_DARK_MODE, &darkMode, sizeof(darkMode) as u32);

    gladLoadGLLoader(glfwGetProcAddress);
    Logger::Info((String("OpenGL version: ") + (glGetString(GL_VERSION) as *const i8) + ".").Data());

    let mut world: World;
    let mut player: Player = { &world };

    glfwSetWindowUserPointer(window, &player as *mut void);
    glfwSetScrollCallback(window, ScrollCallback);

    let mut shader: Shader = Shader("default.vert", "default.frag");
    let mut texture_manager: TextureManager = TextureManager(16i32, 16i32, 256i32);
    texture_manager.AddTexture(String("grass_block_side_overlay"));
    texture_manager.AddTexture(String("grass_block_side"));
    texture_manager.AddTexture(String("grass_block_top"));
    texture_manager.AddTexture(String("dirt"));
    texture_manager.AddTexture(String("cobblestone"));
    texture_manager.AddTexture(String("stone"));
    texture_manager.AddTexture(String("spruce_planks"));
    texture_manager.AddTexture(String("oak_log"));
    texture_manager.AddTexture(String("oak_log_top"));
    texture_manager.GenerateMipmaps();

    let mut reload_state: bool = true;
    let mut last_time: f64 = glfwGetTime();
    let mut sun_angle: f64 = M_PI_4;
    glEnable(GL_DEPTH_TEST);

    let day_tint: Vector3 = { 0.4f32, 0.6f32, 1.0f32 };
    let sunset_tint: Vector3 = { 0.7f32, 0.4f32, 0.35f32 };
    let night_tint: Vector3 = { 0.05f32, 0.05f32, 0.15f32 };

    while glfwWindowShouldClose(window) == 0i32 {
        glfwPollEvents();

        let current_time: f64 = glfwGetTime();
        let delta_time: f64 = current_time - last_time;
        last_time = current_time;

        player.Update(window, delta_time);
        world.Update(delta_time, &player as *mut void);
        sun_angle += delta_time * 0.01f64;

        if glfwGetWindowAttrib(window, GLFW_ICONIFIED) == 0i32 {
            let (mut width: i32, mut height: i32);
            glfwGetWindowSize(window, &width, &height);

            // let mut view: Matrix4 = { 1.0f32 };
            // view *= Rotate(ToRadians(player.yaw as f32) + M_PI_2 as f32, Vector3(0.0f32, 1.0f32, 0.0f32));
            // view *= Rotate(ToRadians(-player.pitch as f32), Vector3(cosf(ToRadians(player.yaw as f32) + M_PI_2 as f32), 0.0f32, sinf(ToRadians(player.yaw as f32) + M_PI_2 as f32)));
            // view *= Translate(Vector3(-player.translation.x, -player.translation.y - player.eye_level, -player.translation.z));
            let eye_translation: Vector3 = player.translation + Vector3(0.0f32, player.eye_level, 0.0f32);
            let view: Matrix4 = LookAt(eye_translation, eye_translation + player.front.Normalize(), Vector3(0.0f32, 1.0f32, 0.0f32));
            let projection: Matrix4 = Perspective(ToRadians(player.fov), (width as f32) / (height as f32), 0.1f32, 1000.0f32);

            if glfwGetKey(window, GLFW_KEY_R) >= GLFW_PRESS {
                if reload_state {
                    shader.Reload();
                    reload_state = false;
                }
            } else {
                reload_state = true;
            }

            let mut skylight: Vector3;
            let sun_height: f32 = sinf(sun_angle as f32);

            if sun_height > 0.2f32 {
                let t: f64 = ((sun_height - 0.2f32) / 0.8f32) as f64;
                skylight.x = Lerp(sunset_tint.x as f64, day_tint.x as f64, t) as f32;
                skylight.y = Lerp(sunset_tint.y as f64, day_tint.y as f64, t) as f32;
                skylight.z = Lerp(sunset_tint.z as f64, day_tint.z as f64, t) as f32;
            } else if sun_height > -0.2f32 {
                let t: f64 = ((sun_height + 0.2f32) / 0.4f32) as f64;
                skylight.x = Lerp(night_tint.x as f64, sunset_tint.x as f64, t) as f32;
                skylight.y = Lerp(night_tint.y as f64, sunset_tint.y as f64, t) as f32;
                skylight.z = Lerp(night_tint.z as f64, sunset_tint.z as f64, t) as f32;
            } else {
                skylight = night_tint;
            }

            glClearColor(skylight.x, skylight.y, skylight.z, 1.0f32);
            glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
            shader.Bind();
            glUniformMatrix4fv(shader.GetUniformLocation("view"), 1i32, 0u8, &view.values[0u64]);
            glUniformMatrix4fv(shader.GetUniformLocation("projection"), 1i32, 0u8, &projection.values[0u64]);
            glUniform3f(shader.GetUniformLocation("viewPosition"), eye_translation.x, eye_translation.y, eye_translation.z);
            glUniform3f(shader.GetUniformLocation("fogColor"), skylight.x, skylight.y, skylight.z);
            glUniform1f(shader.GetUniformLocation("fogStart"), (RENDER_DISTANCE as f32) * 16.0f32 - 48.0f32);
            glUniform1f(shader.GetUniformLocation("fogEnd"), (RENDER_DISTANCE as f32) * 16.0f32 - 16.0f32);
            glUniform1f(shader.GetUniformLocation("sunHeight"), sun_height);
            glUniform1i(shader.GetUniformLocation("albedoMap"), 0i32);
            texture_manager.Bind(0u32);
            world.Render();
            texture_manager.Unbind(0u32);
            shader.Unbind();
            glfwSwapBuffers(window);
        }

        let error: u32 = glGetError();

        if error != 0u32 {
            Logger::Warning((String("OpenGL error code: ") + String(error as i32) + ".").Data());
        }
    }

    world.running = false;
    glfwDestroyWindow(window);
    glfwTerminate();
    ret 0i32;
}