#[include "std/io", "std/std", "std/str", "std/pair" : *]

#[if WINDOWS]
const PATH_SEPERATOR: i8 = '\\';
const MAX_PATH: usize = 260usize;

class FILETIME {
    pub dwLowDateTime: u32,
    pub dwHighDateTime: u32
}

type LPFILETIME = *mut FILETIME;

class WIN32_FIND_DATAA {
    pub dwFileAttributes: u32,
    pub ftCreationTime: FILETIME,
    pub ftLastAccessTime: FILETIME,
    pub ftLastWriteTime: FILETIME,
    pub nFileSizeHigh: u32,
    pub nFileSizeLow: u32,
    pub dwReserved0: u32,
    pub dwReserved1: u32,
    pub cFileName[MAX_PATH]: i8,
    pub cAlternateFileName[14usize]: i8,
    pub dwFileType: u32,
    pub dwCreatorType: u32,
    pub wFinderFlags: u16
}

type LPWIN32_FIND_DATAA = *mut WIN32_FIND_DATAA;

extern "C" {
    func GetFileAttributesA(lpFileName: *const i8) -> u32;

    func FindFirstFileA(lpFileName: *const i8, lpFindFileData: LPWIN32_FIND_DATAA) -> *mut void;
    func FindNextFileA(hFindFile: *mut void, lpFindFileData: LPWIN32_FIND_DATAA) -> i32;
    func FindClose(hFindFile: *mut void) -> i32;

    func GetTempPathA(nBufferLength: u32, lpBuffer: *mut i8) -> u32;
    func GetFullPathNameA(lpFileName: *const i8, nBufferLength: u32, lpBuffer: *mut i8, lpFilePart: *mut *mut i8) -> u32;

    func CreateFileA(lpFileName: *const i8, dwDesiredAccess: u32, dwShareMode: u32, lpSecurityAttributes: *mut void, dwCreationDisposition: u32, dwFlagsAndAttributes: u32, hTemplateFile: *mut void) -> *mut void;
    func DeleteFileA(lpFileName: *const i8) -> i32;

    func GetFileSize(hFile: *mut void, lpFileSizeHigh: *mut u32) -> u32;
    func CloseHandle(hObject: *mut void) -> i32;
}

const GENERIC_READ: u32 = 0x80000000u32;
const FILE_SHARE_READ: u32 = 0x00000001u32;
const OPEN_EXISTING: u32 = 0x00000003u32;

const GENERIC_WRITE: u32 = 0x40000000u32;
const FILE_SHARE_NONE: u32 = 0x00000000u32;
const CREATE_ALWAYS: u32 = 0x00000002u32;

const FILE_ATTRIBUTE_NORMAL: u32 = 0x00000080u32;
const FILE_ATTRIBUTE_DIRECTORY: u32 = 0x00000010u32;
const INVALID_FILE_ATTRIBUTES: u32 = 0xFFFFFFFFu32;

const INVALID_HANDLE_VALUE: *mut void = -1isize as *mut void;

func _ReadFile(path: &String) -> String {
    let mut content: String;
    let handle = CreateFileA(path.Data(), GENERIC_READ, FILE_SHARE_READ, null, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, null);

    if handle == INVALID_HANDLE_VALUE {
        WriteLine("\x1b[31mFailed to open file for reading: '" + path + "'.\x1b[0m");
        ret content;
    }

    let size = GetFileSize(handle, null);

    if size > 0u32 {
        let string = new i8[size as usize + 1usize];
        let mut bytesRead = 0u32;

        if ReadFile(handle, string, size, &mut bytesRead, null) != 0i32 {
            string[size as usize] = 0i8;
            content = string;
        }
    }

    CloseHandle(handle);
    ret content;
}

func _WriteFile(path: &String, content: &String) -> bool {
    let handle = CreateFileA(path.Data(), GENERIC_WRITE, FILE_SHARE_NONE, null, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, null);

    if handle == INVALID_HANDLE_VALUE {
        WriteLine("\x1b[31mFailed to open file for writing: '" + path + "'.\x1b[0m");
        ret false;
    }

    let mut written = 0u32;
    let success = WriteFile(handle, content.Data(), content.Length() as u32, &mut written, null);
    CloseHandle(handle);
    ret success != 0i32;
}

func GetTemporaryPath() -> String {
    let mut buffer[256usize]: i8;
    let length = GetTempPathA(sizeof(buffer) as u32, buffer);

    if length > 0u32 && length < sizeof(buffer) as u32 {
        ret String(buffer, 0usize, length as usize);
    } else {
        WriteLine("\x1b[31mFailed to get temporary path.\x1b[0m");
        ret String();
    }
}

func AbsolutePath(path: &String) -> String {
    let mut buffer[MAX_PATH]: i8;
    let mut filePart: *mut i8 = null;
    let length = GetFullPathNameA(path.Data(), MAX_PATH as u32, buffer, &mut filePart);

    if length > 0u32 && length < MAX_PATH as u32 {
        ret String(buffer, 0usize, length as usize);
    } ret path;
}

func PathExists(path: &String) -> bool {
    ret GetFileAttributesA(path.Data()) != INVALID_FILE_ATTRIBUTES;
}

func FileExists(path: &String) -> bool {
    let attributes = GetFileAttributesA(path.Data());

    if attributes != INVALID_FILE_ATTRIBUTES {
        ret (attributes & FILE_ATTRIBUTE_DIRECTORY) == 0u32;
    } else {
        ret false;
    }
}

func FolderExists(path: &String) -> bool {
    let attributes = GetFileAttributesA(path.Data());

    if attributes != INVALID_FILE_ATTRIBUTES {
        ret (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0u32;
    } else {
        ret false;
    }
}

func RemoveFile(path: &String) -> bool {
    ret DeleteFileA(path.Data()) != 0i32;
}
#[else]
const PATH_SEPERATOR: i8 = '/';
const PATH_MAX: usize = 4096usize;

const O_RDONLY: i32 = 0i32;
const O_WRONLY: i32 = 1i32;

#[if DARWIN]
const O_CREAT: i32 = 512i32;
const O_TRUNC: i32 = 1024i32;
#[else]
const O_CREAT: i32 = 64i32;
const O_TRUNC: i32 = 512i32;
#[endif]

const S_IRUSR: u32 = 256u32;
const S_IWUSR: u32 = 128u32;
const S_IRGRP: u32 = 32u32;
const S_IWGRP: u32 = 16u32;

const S_IFMT: u32 = 0xF000u32;
const S_IFDIR: u32 = 0x4000u32;
const S_IFREG: u32 = 0x8000u32;

const SEEK_SET: i32 = 0i32;
const SEEK_END: i32 = 2i32;
const F_OK: i32 = 0i32;

class _stat {
#[if DARWIN]
    pub st_dev: i32,
    pub st_mode: u16,
    pub st_nlink: u16,
    pub st_ino: u64,
    pub st_uid: u32,
    pub st_gid: u32,
    pub st_rdev: i32,
    pub pad0: i32,
    pub st_atime_sec: i64,
    pub st_atime_nsec: i64,
    pub st_mtime_sec: i64,
    pub st_mtime_nsec: i64,
    pub st_ctime_sec: i64,
    pub st_ctime_nsec: i64,
    pub st_btime_sec: i64,
    pub st_btime_nsec: i64,
    pub st_size: i64,
    pub st_blocks: i64,
    pub st_blksize: i32,
    pub st_flags: u32,
    pub st_gen: u32,
    pub st_lspare: i32,
    pub st_qspare0: i64,
    pub st_qspare1: i64
#[else]
    pub st_dev: u64,
    pub st_ino: u64,
    pub st_nlink: u64,
    pub st_mode: u32,
    pub st_uid: u32,
    pub st_gid: u32,
    pub pad0: u32,
    pub st_rdev: u64,
    pub st_size: i64,
    pub rest[88usize]: i8
#[endif]
}

extern "C" {
    func open(pathname: *const i8, flags: i32, mode: u32) -> i32 #[if DARWIN] ; #[else] {
        let mut result = 0i64;

        volatile asm : rax(2i64), rdi(pathname), rsi(flags as i64), rdx(mode as i64) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        ret result as i32;
    } #[endif]

    func read(fd: i32, buf: *mut i8, count: usize) -> isize #[if DARWIN] ; #[else] {
        let mut result: i64 = 0i64;

        volatile asm : rax(0i64), rdi(fd as i64), rsi(buf), rdx(count as i64) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        ret result /* as isize */;
    } #[endif]

    func close(fd: i32) #[if DARWIN] ; #[else] {
        volatile asm : rax(3i64), rdi(fd as i64) -> {
            syscall
        } : memory, rcx, r11, rax;
    } #[endif]

    func lseek(fd: i32, offset: i64, whence: i32) -> i64 #[if DARWIN] ; #[else] {
        let mut result = 0i64;

        volatile asm : rax(8i64), rdi(fd as i64), rsi(offset), rdx(whence as i64) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        ret result;
    } #[endif]

    func stat(pathname: *const i8, statbuf: *mut _stat) -> i32 #[if DARWIN] ; #[else] {
        let mut result = 0i64;

        volatile asm : rax(4i64), rdi(pathname), rsi(statbuf) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        ret result as i32;
    } #[endif]

    func unlink(pathname: *const i8) -> i32 #[if DARWIN] ; #[else] {
        let mut result = 0i64;

        volatile asm : rax(87i64), rdi(pathname) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        ret result as i32;
    } #[endif]

    func access(pathname: *const i8, mode: i32) -> i32 #[if DARWIN] ; #[else] {
        let mut result = 0i64;

        volatile asm : rax(21i64), rdi(pathname), rsi(mode as i64) -> {
            syscall
        } -> rax(result) : memory, rcx, r11;

        ret result as i32;
    } #[endif]

    func realpath(path: *const i8, resolved_path: *mut i8) -> *mut i8;
}

func _ReadFile(path: &String) -> String {
    let mut content: String;
    let fd = open(path.Data(), O_RDONLY, 0u32);

    if fd < 0i32 {
        WriteLine("\x1b[31mFailed to open file for reading: '" + path + "'.\x1b[0m");
        ret content;
    }

    let size = lseek(fd, 0i64, SEEK_END);

    if size > 0i64 {
        lseek(fd, 0i64, SEEK_SET);
        let buffer = new i8[size as usize + 1usize];
        let bytes_read = read(fd, buffer, size as usize);

        if bytes_read > 0isize {
            buffer[bytes_read as usize] = 0i8;
            content = buffer;
        }

        del[] buffer;
    }

    close(fd);
    ret content;
}

func _WriteFile(path: &String, content: &String) -> bool {
    let mode = S_IRUSR | S_IWUSR | S_IRGRP | S_IWGRP;
    let fd = open(path.Data(), O_WRONLY | O_CREAT | O_TRUNC, mode);

    if fd < 0i32 {
        WriteLine("\x1b[31mFailed to open file for writing: '" + path + "'.\x1b[0m");
        ret false;
    }

    write(fd, content.Data(), content.Length());
    close(fd);
    ret true;
}

func GetTemporaryPath() -> String {
    ret String("/tmp/");
}

func AbsolutePath(path: &String) -> String {
    let buffer[PATH_MAX]: i8;
    let result = realpath(path.Data(), buffer);

    if result != null {
        ret String(buffer);
    } ret path;
}

func PathExists(path: &String) -> bool {
    ret access(path.Data(), F_OK) == 0i32;
}

func FileExists(path: &String) -> bool {
    let mut st: _stat;

    if stat(path.Data(), &mut st) != 0i32 {
        ret false;
    }

#[if DARWIN]
    ret (st.st_mode as u32 & S_IFMT) == S_IFREG;
#[else]
    ret (st.st_mode & S_IFMT) == S_IFREG;
#[endif]
}

func FolderExists(path: &String) -> bool {
    let mut st: _stat;

    if stat(path.Data(), &mut st) != 0i32 {
        ret false;
    }

#[if DARWIN]
    ret (st.st_mode as u32 & S_IFMT) == S_IFDIR;
#[else]
    ret (st.st_mode & S_IFMT) == S_IFDIR;
#[endif]
}

func RemoveFile(path: &String) -> bool {
    ret unlink(path.Data()) == 0i32;
}
#[endif]

func JoinPath(directory: &String, file: &String) -> String {
    if directory.Empty() {
        ret file;
    }

    if directory[directory.Length() - 1usize] == '\\' || directory[directory.Length() - 1usize] == '/' {
        ret directory + file;
    } else {
        ret directory + PATH_SEPERATOR + file;
    }
}

func SplitExtension(path: &String) -> Pair<String, String> {
    let mut i = path.Length();
    let mut index = path.Length();

    while i > 0usize {
        i -= 1usize;

        if path[i] == '\\' || path[i] == '/' {
            break;
        }

        if path[i] == '.' {
            index = i;
            break;
        }
    }

    if index == path.Length() {
        ret Pair<String, String>(path, String());
    }

    let name = String(path, 0usize, index);
    let extension = String(path, index, path.Length());
    ret Pair<String, String>(name, extension);
}

func SplitPath(path: &String) -> Pair<String, String> {
    let mut i = path.Length();
    let mut index = path.Length();

    while i > 0usize {
        i -= 1usize;

        if path[i] == '\\' || path[i] == '/' {
            index = i;
            break;
        }
    }

    if index == path.Length() {
        ret Pair<String, String>(String(), path);
    }

    let directory = String(path, 0usize, index);
    let file = String(path, index + 1usize, path.Length());
    ret Pair<String, String>(directory, file);
}