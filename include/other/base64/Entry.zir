#[include "std/str" : *]

class Base64 {
    func Encode(string: &String) -> String {
        let mut result: String;
        let table: *const i8 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        let length: u64 = string.Length();
        let mut i: u64 = 0u64;

        while i < length {
            let b0: u64 = ((string[i] + 0i8) as u64) & 0xFFu64;
            let b1: u64 = (i + 1u64 < length) ? (((string[i + 1u64] + 0i8) as u64) & 0xFFu64) : 0u64;
            let b2: u64 = (i + 2u64 < length) ? (((string[i + 2u64] + 0i8) as u64) & 0xFFu64) : 0u64;
            let triple: u64 = (b0 << 16u64) | (b1 << 8u64) | b2;
            result += table[(triple >> 18u64) & 0x3Fu64];
            result += table[(triple >> 12u64) & 0x3Fu64];

            if i + 1u64 < length {
                result += table[(triple >> 6u64) & 0x3Fu64];
            } else {
                result += '=';
            }

            if i + 2u64 < length {
                result += table[triple & 0x3Fu64];
            } else {
                result += '=';
            } i += 3u64;
        } ret result;
    }

    priv GetValue(c: i8) -> u64 {
        if c >= 'A' && c <= 'Z' { ret (c - 'A') as u64; }
        else if c >= 'a' && c <= 'z' { ret (c - 'a' + 26i8) as u64; }
        else if c >= '0' && c <= '9' { ret (c - '0' + 52i8) as u64; }
        else if c == '+' { ret 62u64; }
        else if c == '/' { ret 63u64; }
        else { ret 0u64; }
    }

    func Decode(string: &String) -> String {
        let mut result: String;
        let length: u64 = string.Length();
        let mut i: u64 = 0u64;

        while i < length {
            let n0: u64 = Base64::GetValue(string[i]);
            let n1: u64 = (i + 1u64 < length) ? Base64::GetValue(string[i + 1u64]) : 0u64;
            let n2: u64 = (i + 2u64 < length) ? Base64::GetValue(string[i + 2u64]) : 0u64;
            let n3: u64 = (i + 3u64 < length) ? Base64::GetValue(string[i + 3u64]) : 0u64;
            let triple: u64 = (n0 << 18u64) | (n1 << 12u64) | (n2 << 6u64) | n3;
            result += ((triple >> 16u64) & 0xFFu64) as i8;

            if i + 2u64 < length && string[i + 2u64] != '=' {
                result += ((triple >> 8u64) & 0xFFu64) as i8;
            }

            if i + 3u64 < length && string[i + 3u64] != '=' {
                result += (triple & 0xFFu64) as i8;
            } i += 4u64;
        } ret result;
    }
}