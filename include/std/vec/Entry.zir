#[include "std/mem" : *]

class Vector<T> {
    data: *mut T = null,
    capacity: usize = 0,
    size: usize = 0;

    Vector(&mut this) {}

    Vector(&mut this, other: &Vector<T>) {
        if other.data == null { return; }
        this.Allocate(other.capacity);

        for i in 0..other.size {
            this.data[i] = other.data[i];
        } this.size = other.size;
    }

    ~Vector(&mut this) {
        this.Release();
    }

    pub fn Data(&this) -> *mut T { return this.data; }
    pub fn Front(&this) -> &mut T { return this.data[0]; }
    pub fn Back(&this) -> &mut T { return this.data[this.size - 1]; }
    pub fn Empty(&this) -> bool { return this.size == 0; }
    pub fn Size(&this) -> usize { return this.size; }

    fn Allocate(&mut this, capacity: usize) {
        (this.data, this.capacity) = (new T[capacity], capacity);
    }

    fn Release(&mut this) {
        if this.data != null { delete[] this.data; }
        (this.data, this.capacity, this.size) = (null, 0, 0);
    }

    pub fn Clear(&mut this) {
        this.Release();
    }

    pub fn Reserve(&mut this, capacity: usize) {
        if capacity > this.capacity {
            let temp = this.data;
            this.Allocate(capacity);

            if temp != null {
                for i in 0..this.size {
                    this.data[i] = temp[i];
                } delete[] temp;
            }
        }
    }

    pub fn Resize(&mut this, size: usize) {
        if size > this.size {
            this.Reserve(size);
        } this.size = size;
    }

    pub fn Shrink(&mut this) {
        if this.size < this.capacity {
            let temp = this.data;
            let size = this.size;
            this.Allocate(size);

            if temp != null {
                for i in 0..size {
                    this.data[i] = temp[i];
                } delete[] temp;
            } this.size = size;
        }
    }

    pub fn Swap(&mut this, other: &mut Vector<T>) {
        let (data, capacity, size) = (this.data, this.capacity, this.size);
        (this.data, this.capacity, this.size) = (other.data, other.capacity, other.size);
        (other.data, other.capacity, other.size) = (data, capacity, size);
    }

    pub fn Reverse(&mut this) -> &mut Vector<T> {
        if this.size > 1 {
            for i in 0..(this.size / 2) {
                let temp: T = this.data[i];
                let j = this.size - 1 - i;
                this.data[i] = this.data[j];
                this.data[j] = temp;
            }
        } return this;
    }

    pub fn PushBack(&mut this, value: T) {
        if this.capacity < this.size + 1 {
            this.Reserve(this.capacity != 0 ? this.capacity * 2 : 1);
        }

        this.data[this.size] = value;
        this.size += 1;
    }

    pub fn PopBack(&mut this) -> T {
        this.size -= 1;
        return this.data[this.size];
    }

    pub fn Insert(&mut this, index: usize, value: T) {
        if this.capacity < this.size + 1 {
            this.Reserve(this.capacity != 0 ? this.capacity * 2 : 1);
        }

        for offset in 0..(this.size - index) {
            let i = this.size - offset;
            this.data[i] = this.data[i - 1];
        }

        this.data[index] = value;
        this.size += 1;
    }

    pub fn RemoveAt(&mut this, index: usize) -> T {
        let temp: T = this.data[index];

        for i in (index + 1)..this.size {
            this.data[i - 1] = this.data[i];
        }

        this.size -= 1;
        return temp;
    }

    pub fn Remove(&mut this, value: T) {
        let mut write_index: usize = 0;

        for read_index in 0..this.size {
            if this.data[read_index] != value {
                if read_index != write_index {
                    this.data[write_index] = this.data[read_index];
                } write_index += 1;
            }
        } this.size = write_index;
    }

    pub fn Contains(&this, value: T) -> bool {
        for i in 0..this.size {
            if this.data[i] == value {
                return true;
            }
        } return false;
    }

    pub fn Index(&this, value: T) -> isize {
        for i in 0..this.size {
            if this.data[i] == value {
                return i as isize;
            }
        } return -1;
    }

    pub fn operator+(&this, other: &Vector<T>) -> Vector<T> {
        let mut result = Vector<T>();
        result.Resize(this.size + other.size);

        for i in 0..this.size {
            result.data[i] = this.data[i];
        }

        for i in 0..other.size {
            result.data[this.size + i] = other.data[i];
        } return result;
    }

    pub fn operator+=(&mut this, other: &Vector<T>) -> &mut Vector<T> {
        let old_size = this.size;
        this.Resize(this.size + other.size);

        for i in 0..other.size {
            this.data[old_size + i] = other.data[i];
        } return this;
    }

    pub fn operator=(&mut this, other: &Vector<T>) -> &mut Vector<T> {
        this.Release();
        if other.data == null { return this; }
        this.Allocate(other.capacity);

        for i in 0..other.size {
            this.data[i] = other.data[i];
        }

        this.size = other.size;
        return this;
    }

    pub fn operator[](&this, index: usize) -> &mut T {
        return this.data[index];
    }

    pub fn Begin(&this) -> *mut T {
        return this.data;
    }

    pub fn End(&this) -> *mut T {
        return this.data + this.size;
    }
}