#[include "vendor/llvm/Types.zir" : *]

enum LLVMByteOrdering: i32 {
    LLVMBigEndian, LLVMLittleEndian
}

type LLVMTargetDataRef = *void;
type LLVMTargetLibraryInfoRef = *void;

extern "C" {
    fn LLVMInitializeAArch64TargetInfo();
    fn LLVMInitializeARMTargetInfo();
    fn LLVMInitializeX86TargetInfo();
    fn LLVMInitializeBPFTargetInfo();
    fn LLVMInitializeWebAssemblyTargetInfo();
    fn LLVMInitializeRISCVTargetInfo();
    fn LLVMInitializeNVPTXTargetInfo();
#[if ZODIAC]
    fn LLVMInitializeZodiacTargetInfo();
#[endif]

    fn LLVMInitializeAArch64Target();
    fn LLVMInitializeARMTarget();
    fn LLVMInitializeX86Target();
    fn LLVMInitializeBPFTarget();
    fn LLVMInitializeWebAssemblyTarget();
    fn LLVMInitializeRISCVTarget();
    fn LLVMInitializeNVPTXTarget();
#[if ZODIAC]
    fn LLVMInitializeZodiacTarget();
#[endif]

    fn LLVMInitializeAArch64TargetMC();
    fn LLVMInitializeARMTargetMC();
    fn LLVMInitializeX86TargetMC();
    fn LLVMInitializeBPFTargetMC();
    fn LLVMInitializeWebAssemblyTargetMC();
    fn LLVMInitializeRISCVTargetMC();
    fn LLVMInitializeNVPTXTargetMC();
#[if ZODIAC]
    fn LLVMInitializeZodiacTargetMC();
#[endif]

    fn LLVMInitializeAArch64AsmPrinter();
    fn LLVMInitializeARMAsmPrinter();
    fn LLVMInitializeX86AsmPrinter();
    fn LLVMInitializeBPFAsmPrinter();
    fn LLVMInitializeWebAssemblyAsmPrinter();
    fn LLVMInitializeRISCVAsmPrinter();
    fn LLVMInitializeNVPTXAsmPrinter();
#[if ZODIAC]
    fn LLVMInitializeZodiacAsmPrinter();
#[endif]

    fn LLVMInitializeAArch64AsmParser();
    fn LLVMInitializeARMAsmParser();
    fn LLVMInitializeX86AsmParser();
    fn LLVMInitializeBPFAsmParser();
    fn LLVMInitializeWebAssemblyAsmParser();
    fn LLVMInitializeRISCVAsmParser();
#[if ZODIAC]
    fn LLVMInitializeZodiacAsmParser();
#[endif]

    fn LLVMInitializeAArch64Disassembler();
    fn LLVMInitializeARMDisassembler();
    fn LLVMInitializeX86Disassembler();
    fn LLVMInitializeBPFDisassembler();
    fn LLVMInitializeWebAssemblyDisassembler();
    fn LLVMInitializeRISCVDisassembler();
#[if ZODIAC]
    fn LLVMInitializeZodiacDisassembler();
#[endif]

    fn LLVMInitializeAllTargetInfos() {
        LLVMInitializeAArch64TargetInfo();
        LLVMInitializeARMTargetInfo();
        LLVMInitializeX86TargetInfo();
        LLVMInitializeBPFTargetInfo();
        LLVMInitializeWebAssemblyTargetInfo();
        LLVMInitializeRISCVTargetInfo();
        LLVMInitializeNVPTXTargetInfo();
#[if ZODIAC]
        LLVMInitializeZodiacTargetInfo();
#[endif]
    }

    fn LLVMInitializeAllTargets() {
        LLVMInitializeAArch64Target();
        LLVMInitializeARMTarget();
        LLVMInitializeX86Target();
        LLVMInitializeBPFTarget();
        LLVMInitializeWebAssemblyTarget();
        LLVMInitializeRISCVTarget();
        LLVMInitializeNVPTXTarget();
#[if ZODIAC]
        LLVMInitializeZodiacTarget();
#[endif]
    }

    fn LLVMInitializeAllTargetMCs() {
        LLVMInitializeAArch64TargetMC();
        LLVMInitializeARMTargetMC();
        LLVMInitializeX86TargetMC();
        LLVMInitializeBPFTargetMC();
        LLVMInitializeWebAssemblyTargetMC();
        LLVMInitializeRISCVTargetMC();
        LLVMInitializeNVPTXTargetMC();
#[if ZODIAC]
        LLVMInitializeZodiacTargetMC();
#[endif]
    }

    fn LLVMInitializeAllAsmPrinters() {
        LLVMInitializeAArch64AsmPrinter();
        LLVMInitializeARMAsmPrinter();
        LLVMInitializeX86AsmPrinter();
        LLVMInitializeBPFAsmPrinter();
        LLVMInitializeWebAssemblyAsmPrinter();
        LLVMInitializeRISCVAsmPrinter();
        LLVMInitializeNVPTXAsmPrinter();
#[if ZODIAC]
        LLVMInitializeZodiacAsmPrinter();
#[endif]
    }

    fn LLVMInitializeAllAsmParsers() {
        LLVMInitializeAArch64AsmParser();
        LLVMInitializeARMAsmParser();
        LLVMInitializeX86AsmParser();
        LLVMInitializeBPFAsmParser();
        LLVMInitializeWebAssemblyAsmParser();
        LLVMInitializeRISCVAsmParser();
#[if ZODIAC]
        LLVMInitializeZodiacAsmParser();
#[endif]
    }

    fn LLVMInitializeAllDisassemblers() {
        LLVMInitializeAArch64Disassembler();
        LLVMInitializeARMDisassembler();
        LLVMInitializeX86Disassembler();
        LLVMInitializeBPFDisassembler();
        LLVMInitializeWebAssemblyDisassembler();
        LLVMInitializeRISCVDisassembler();
#[if ZODIAC]
        LLVMInitializeZodiacDisassembler();
#[endif]
    }

    fn LLVMInitializeNativeTarget() -> LLVMBool {
        LLVMInitializeX86TargetInfo();
        LLVMInitializeX86Target();
        LLVMInitializeX86TargetMC();
        return 0;
    }

    fn LLVMInitializeNativeAsmParser() -> LLVMBool {
        LLVMInitializeX86AsmParser();
        return 0;
    }

    fn LLVMInitializeNativeAsmPrinter() -> LLVMBool {
        LLVMInitializeX86AsmPrinter();
        return 0;
    }

    fn LLVMInitializeNativeDisassembler() -> LLVMBool {
        LLVMInitializeX86Disassembler();
        return 0;
    }

    fn LLVMGetModuleDataLayout(M: LLVMModuleRef) -> LLVMTargetDataRef;
    fn LLVMSetModuleDataLayout(M: LLVMModuleRef, DL: LLVMTargetDataRef);

    fn LLVMCreateTargetData(StringRep: *i8) -> LLVMTargetDataRef;
    fn LLVMDisposeTargetData(TD: LLVMTargetDataRef);

    fn LLVMAddTargetLibraryInfo(TLI: LLVMTargetLibraryInfoRef, PM: LLVMPassManagerRef);

    fn LLVMCopyStringRepOfTargetData(TD: LLVMTargetDataRef) -> *i8;

    fn LLVMByteOrder(TD: LLVMTargetDataRef) -> LLVMByteOrdering;

    fn LLVMPointerSize(TD: LLVMTargetDataRef) -> u32;
    fn LLVMPointerSizeForAS(TD: LLVMTargetDataRef, AS: u32) -> u32;

    fn LLVMIntPtrType(TD: LLVMTargetDataRef) -> LLVMTypeRef;
    fn LLVMIntPtrTypeForAS(TD: LLVMTargetDataRef, AS: u32) -> LLVMTypeRef;

    fn LLVMIntPtrTypeInContext(C: LLVMContextRef, TD: LLVMTargetDataRef) -> LLVMTypeRef;
    fn LLVMIntPtrTypeForASInContext(C: LLVMContextRef, TD: LLVMTargetDataRef, AS: u32) -> LLVMTypeRef;

    fn LLVMSizeOfTypeInBits(TD: LLVMTargetDataRef, Ty: LLVMTypeRef) -> u64;
    fn LLVMStoreSizeOfType(TD: LLVMTargetDataRef, Ty: LLVMTypeRef) -> u64;
    fn LLVMABISizeOfType(TD: LLVMTargetDataRef, Ty: LLVMTypeRef) -> u64;

    fn LLVMABIAlignmentOfType(TD: LLVMTargetDataRef, Ty: LLVMTypeRef) -> u32;
    fn LLVMCallFrameAlignmentOfType(TD: LLVMTargetDataRef, Ty: LLVMTypeRef) -> u32;
    fn LLVMPreferredAlignmentOfType(TD: LLVMTargetDataRef, Ty: LLVMTypeRef) -> u32;
    fn LLVMPreferredAlignmentOfGlobal(TD: LLVMTargetDataRef, GlobalVar: LLVMValueRef) -> u32;

    fn LLVMElementAtOffset(TD: LLVMTargetDataRef, StructTy: LLVMTypeRef, Offset: u64) -> u32;
    fn LLVMOffsetOfElement(TD: LLVMTargetDataRef, StructTy: LLVMTypeRef, Element: u32) -> u64;
}