#[include "std/mem" : *]

const ARENA_DEFAULT_ALIGNMENT: usize = 16;
const ARENA_DEFAULT_CHUNK_SIZE: usize = 1048576;

class ArenaChunk {
    pub next: *mut ArenaChunk = null,
    pub data: *mut i8, pub capacity: usize,
    pub used: usize = 0;

    ArenaChunk(&mut this, capacity: usize) {
        (this.data, this.capacity) = (malloc(capacity) as *mut i8, capacity);
    }

    ~ArenaChunk(&mut this) {
        if this.data != null {
            free(this.data);
            this.data = null;
        }
    }
}

class ArenaDestructor {
    pub next: *mut ArenaDestructor = null,
    pub destructor: fn(*mut void),
    pub instance: *mut void;

    ArenaDestructor(&mut this, instance: *mut void, destructor: fn(*mut void)) {
        (this.instance, this.destructor) = (instance, destructor);
    }
}

class Arena {
    head: *mut ArenaChunk = null,
    tail: *mut ArenaChunk = null,
    destructor: *mut ArenaDestructor = null;

    Arena(&mut this) {
        let chunk = new ArenaChunk(ARENA_DEFAULT_CHUNK_SIZE);

        if chunk != null {
            if chunk->data != null {
                (this.head, this.tail) = (chunk, chunk);
            } else {
                delete chunk;
            }
        }
    }

    ~Arena(&mut this) {
        this.Reset();
    }

    pub fn Allocate(&mut this, size: usize) -> *mut void {
        return this.AllocateAligned(size, ARENA_DEFAULT_ALIGNMENT);
    }

    pub fn AllocateAligned(&mut this, size: usize, align: usize) -> *mut void {
        if size == 0 {
            return null;
        }

        loop {
            if this.tail == null {
                if !this.GrowChain(size + align) {
                    return null;
                }
            }

            let pointer = this.tail->data as usize + this.tail->used;
            let aligned = (pointer + align - 1) & !(align - 1);
            let offset = aligned - (this.tail->data as usize);

            if (offset + size) <= this.tail->capacity {
                this.tail->used = offset + size;
                return aligned as *mut void;
            }

            if this.tail->next != null {
                this.tail = this.tail->next;
            } else {
                if !this.GrowChain(size + align) {
                    return null;
                }
            }
        } return null;
    }

    pub fn New<T>(&mut this, args...) -> *mut T {
        let size = (sizeof(T) + ARENA_DEFAULT_ALIGNMENT - 1) & !(ARENA_DEFAULT_ALIGNMENT - 1);
        let destructor_size = (sizeof(ArenaDestructor) + ARENA_DEFAULT_ALIGNMENT - 1) & !(ARENA_DEFAULT_ALIGNMENT - 1);
        let pointer = this.Allocate(size + destructor_size) as *mut i8;
        if pointer == null { return null; }
        let destructor = (pointer + size) as *mut ArenaDestructor;
        construct(pointer as *mut T, args...);
        construct(destructor, pointer, InvokeDestructor<T>);
        destructor->next = this.destructor;
        this.destructor = destructor;
        return pointer as *mut T;
    }

    pub fn Reset(&mut this) {
        this.InvokeDestructors();
        this.FreeChunks();
    }

    pub fn Clear(&mut this) {
        this.InvokeDestructors();
        this.RewindCursors();
    }

    pub fn TotalUsed(&this) -> usize {
        let mut total: usize = 0;
        let mut current = this.head;

        while current != null {
            total += current->used;
            current = current->next;
        } return total;
    }

    pub fn TotalCapacity(&this) -> usize {
        let mut total: usize = 0;
        let mut current = this.head;

        while current != null {
            total += current->capacity;
            current = current->next;
        } return total;
    }

    pub fn ChunkCount(&this) -> usize {
        let mut count: usize = 0;
        let mut current = this.head;

        while current != null {
            current = current->next;
            count += 1;
        } return count;
    }

    fn GrowChain(&mut this, min_bytes: usize) -> bool {
        let chunk = new ArenaChunk(min_bytes > ARENA_DEFAULT_CHUNK_SIZE ? min_bytes : ARENA_DEFAULT_CHUNK_SIZE);

        if chunk == null {
            return false;
        }

        if chunk->data == null {
            delete chunk;
            return false;
        }

        if this.head == null {
            (this.head, this.tail) = (chunk, chunk);
        } else {
            this.tail->next = chunk;
            this.tail = chunk;
        } return true;
    }

    fn InvokeDestructors(&mut this) {
        let mut current = this.destructor;
        this.destructor = null;

        while current != null {
            if current->instance != null && current->destructor != null {
                current->destructor(current->instance);
            } current = current->next;
        }
    }

    fn FreeChunks(&mut this) {
        let mut current = this.head;

        while current != null {
            let next = current->next;
            delete current;
            current = next;
        }

        (this.head, this.tail) = (null, null);
    }

    fn RewindCursors(&mut this) {
        let mut current = this.head;

        while current != null {
            current->used = 0;
            current = current->next;
        }

        this.tail = this.head;
    }
}

fn InvokeDestructor<T>(instance: *mut void) {
    destruct(instance as *mut T);
}
