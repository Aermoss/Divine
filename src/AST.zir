    ASTFunctionDeclaration(&mut this, name: String, _type: *ASTFunctionType, no_mangle: bool, start: Token) : ASTDeclaration(ASTDeclarationKind::Function, start) {
        (this.name, this._type, this.no_mangle) = (name, _type, no_mangle);
    }
}

