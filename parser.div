    pub else_expr: *const ASTNode;

    TernaryNode(&mut this, condition: *const ASTNode, then_expr: *const ASTNode, else_expr: *const ASTNode, row: u64, column: u64, file: String) : ASTNode(ASTNodeType::TERNARY, row, column, file) {
        (this.condition, this.then_expr, this.else_expr) = (condition, then_expr, else_expr);
    }
}

class CallNode : ASTNode {
