include "divio", "divvec", "divstr" : *;

func main(args: Vector<String>) -> i32 {
    let mut x: i32 = 42i32;
    let ptr_mut: *mut i32 = &mut x;
    let ptr_const: *const i32 = &x;

    // Test 1: Recursive mutability gain (SHOULD FAIL)
    let p1: *const *const i32 = &ptr_const;
    // let p2: *const *mut i32 = p1 as *const *mut i32; // Gain mutability at level 2

    // Test 2: Recursive mutability bypass with unsafe (SHOULD WORK)
    unsafe {
        let p3: *const *mut i32 = p1 as *const *mut i32;
        WriteLine("Unsafe recursive cast worked");
    }

    // Test 3: Safe recursive mutability loss (SHOULD WORK)
    let p4: *mut *mut i32 = &mut ptr_mut;
    let p5: *const *const i32 = p4 as *const *const i32;
    WriteLine("Safe recursive cast worked");

    ret 0i32;
}
