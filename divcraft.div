    pub op+=(this: &mut Vector3, other: &Vector3) -> &Vector3 {
        this.x += other.x;
        this.y += other.y;
        this.z += other.z;
        ret this;
    }

    pub op-(this: &Vector3, other: &Vector3) -> Vector3 {
        ret Vector3(this.x - other.x, this.y - other.y, this.z - other.z);
    }

    pub op-=(this: &mut Vector3, other: &Vector3) -> &Vector3 {
        this.x -= other.x;
        this.y -= other.y;
        this.z -= other.z;
        ret this;
    }

    pub op*(this: &Vector3, other: &Vector3) -> Vector3 {
        ret Vector3(this.x * other.x, this.y * other.y, this.z * other.z);
    }

    pub op*=(this: &mut Vector3, other: &Vector3) -> &Vector3 {
        this.x *= other.x;
        this.y *= other.y;
        this.z *= other.z;
        ret this;
    }

    pub op*(this: &Vector3, scalar: f32) -> Vector3 {
        ret Vector3(this.x * scalar, this.y * scalar, this.z * scalar);
    }

    pub op*=(this: &mut Vector3, scalar: f32) -> &Vector3 {
        this.x *= scalar;
        this.y *= scalar;
        this.z *= scalar;
        ret this;
    }

    pub op/(this: &Vector3, other: &Vector3) -> Vector3 {
        ret Vector3(this.x / other.x, this.y / other.y, this.z / other.z);
    }

    pub op/=(this: &mut Vector3, other: &Vector3) -> &Vector3 {
        this.x /= other.x;
        this.y /= other.y;
        this.z /= other.z;
        ret this;
    }

    pub op/(this: &Vector3, scalar: f32) -> Vector3 {
        ret Vector3(this.x / scalar, this.y / scalar, this.z / scalar);
    }

    pub op/=(this: &mut Vector3, scalar: f32) -> &Vector3 {
        this.x /= scalar;
        this.y /= scalar;
        this.z /= scalar;
        ret this;
    }

    pub op%(this: &Vector3, other: &Vector3) -> Vector3 {
        ret Vector3(this.x % other.x, this.y % other.y, this.z % other.z);
    }

    pub op%=(this: &mut Vector3, other: &Vector3) -> &Vector3 {
        this.x %= other.x;
        this.y %= other.y;
        this.z %= other.z;
        ret this;
    }

    pub op%(this: &Vector3, scalar: f32) -> Vector3 {
        ret Vector3(this.x % scalar, this.y % scalar, this.z % scalar);
    }

    pub op%=(this: &mut Vector3, scalar: f32) -> &Vector3 {
        this.x %= scalar;
        this.y %= scalar;
        this.z %= scalar;
        ret this;
    }

    pub op==(this: &Vector3, other: &Vector3) -> bool {
        ret this.x == other.x && this.y == other.y && this.z == other.z;
    }

    pub op!=(this: &Vector3, other: &Vector3) -> bool {
        ret this.x != other.x || this.y != other.y || this.z != other.z;
    }
};

class Vector4 {
