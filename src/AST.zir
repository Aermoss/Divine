#[include "std/str", "std/vec", "std/map", "std/pair", "src/Tokens.zir" : *]

enum ASTNodeKind: i32 {
    ROOT, ASSEMBLY, UNSAFE,

    Declaration, VARIANT,

    Statement, CASE, DEFAULT,

    UNARY, BINARY, TERNARY, ASSIGNMENT, CALL, INTRINSIC, CONSTRUCTOR, CAST, NEW, DELETE,
    LITERAL, IDENTIFIER, SCOPE_RESOLUTION, PACK_SPLAT, MEMBER_ACCESS, INDEX_ACCESS,
    RANGE, AWAIT, TUPLE, INITIALIZER_LIST, STRUCTURE_INITIALIZER, OR_PATTERN, TYPE_APPLICATION,

    Type
}

fn ToString(kind: ASTNodeKind) -> String {
    if kind == ASTNodeKind::ROOT { return "ROOT".ToString(); }
    else if kind == ASTNodeKind::ASSEMBLY { return "ASSEMBLY".ToString(); }
    else if kind == ASTNodeKind::UNSAFE { return "UNSAFE".ToString(); }
    else if kind == ASTNodeKind::Declaration { return "Declaration".ToString(); }
    else if kind == ASTNodeKind::Statement { return "Statement".ToString(); }
    else if kind == ASTNodeKind::CASE { return "CASE".ToString(); }
    else if kind == ASTNodeKind::DEFAULT { return "DEFAULT".ToString(); }
    else if kind == ASTNodeKind::UNARY { return "UNARY".ToString(); }
    else if kind == ASTNodeKind::BINARY { return "BINARY".ToString(); }
    else if kind == ASTNodeKind::TERNARY { return "TERNARY".ToString(); }
    else if kind == ASTNodeKind::ASSIGNMENT { return "ASSIGNMENT".ToString(); }
    else if kind == ASTNodeKind::CALL { return "CALL".ToString(); }
    else if kind == ASTNodeKind::INTRINSIC { return "INTRINSIC".ToString(); }
    else if kind == ASTNodeKind::CONSTRUCTOR { return "CONSTRUCTOR".ToString(); }
    else if kind == ASTNodeKind::CAST { return "CAST".ToString(); }
    else if kind == ASTNodeKind::NEW { return "NEW".ToString(); }
    else if kind == ASTNodeKind::DELETE { return "DELETE".ToString(); }
    else if kind == ASTNodeKind::LITERAL { return "LITERAL".ToString(); }
    else if kind == ASTNodeKind::IDENTIFIER { return "IDENTIFIER".ToString(); }
    else if kind == ASTNodeKind::SCOPE_RESOLUTION { return "SCOPE_RESOLUTION".ToString(); }
    else if kind == ASTNodeKind::PACK_SPLAT { return "PACK_SPLAT".ToString(); }
    else if kind == ASTNodeKind::MEMBER_ACCESS { return "MEMBER_ACCESS".ToString(); }
    else if kind == ASTNodeKind::INDEX_ACCESS { return "INDEX_ACCESS".ToString(); }
    else if kind == ASTNodeKind::RANGE { return "RANGE".ToString(); }
    else if kind == ASTNodeKind::AWAIT { return "AWAIT".ToString(); }
    else if kind == ASTNodeKind::TUPLE { return "TUPLE".ToString(); }
    else if kind == ASTNodeKind::INITIALIZER_LIST { return "INITIALIZER_LIST".ToString(); }
    else if kind == ASTNodeKind::STRUCTURE_INITIALIZER { return "STRUCTURE_INITIALIZER".ToString(); }
    else if kind == ASTNodeKind::OR_PATTERN { return "OR_PATTERN".ToString(); }
    else if kind == ASTNodeKind::TYPE_APPLICATION { return "TYPE_APPLICATION".ToString(); }
    else if kind == ASTNodeKind::Type { return "Type".ToString(); }
    else { return "UNKNOWN".ToString(); }
}

class ASTNode {
    pub kind: ASTNodeKind,
    pub start: Token,
    pub end: Token;

    ASTNode(&mut this, kind: ASTNodeKind, start: Token) {
        (this.kind, this.start) = (kind, start);
    }
}

class ASTPathSegment {
    pub name: String,
    pub types: Vector<*ASTType>;

    ASTPathSegment(&mut this, name: String) {
        this.name = name;
    }
}

enum ASTTypeKind: u8 {
    Primitive, Pointer, Reference, Array, Function, Generic, Path
}

fn ToString(kind: ASTTypeKind) -> String {
    if kind == ASTTypeKind::Primitive { return "Primitive".ToString(); }
    else if kind == ASTTypeKind::Pointer { return "Pointer".ToString(); }
    else if kind == ASTTypeKind::Reference { return "Reference".ToString(); }
    else if kind == ASTTypeKind::Array { return "Array".ToString(); }
    else if kind == ASTTypeKind::Function { return "Function".ToString(); }
    else if kind == ASTTypeKind::Generic { return "Generic".ToString(); }
    else if kind == ASTTypeKind::Path { return "Path".ToString(); }
    else { return "Unknown".ToString(); }
}

class ASTType : ASTNode {
    pub kind: ASTTypeKind;

    ASTType(&mut this, kind: ASTTypeKind, start: Token) : ASTNode(ASTNodeKind::Type, start) {
        this.kind = kind;
    }
}

class ASTPrimitiveType : ASTType {
    pub name: String;

    ASTPrimitiveType(&mut this, name: String, start: Token) : ASTType(ASTTypeKind::Primitive, start) {
        this.name = name;
    }
}

class ASTPointerType : ASTType {
    pub base_type: *ASTType,
    pub mutable: bool;

    ASTPointerType(&mut this, base_type: *ASTType, mutable: bool, start: Token) : ASTType(ASTTypeKind::Pointer, start) {
        (this.base_type, this.mutable) = (base_type, mutable);
    }
}

class ASTReferenceType : ASTType {
    pub base_type: *ASTType,
    pub mutable: bool;

    ASTReferenceType(&mut this, base_type: *ASTType, mutable: bool, start: Token) : ASTType(ASTTypeKind::Reference, start) {
        (this.base_type, this.mutable) = (base_type, mutable);
    }
}

class ASTArrayType : ASTType {
    pub element_type: *ASTType,
    pub size: *ASTNode;

    ASTArrayType(&mut this, element_type: *ASTType, size: *ASTNode, start: Token) : ASTType(ASTTypeKind::Array, start) {
        (this.element_type, this.size) = (element_type, size);
    }
}

enum ASTInstanceKind: i32 {
    None, Copy, ConstRef, MutRef
}

class ASTFunctionType : ASTType {
    pub parameters: Vector<*ASTParameterDeclaration>,
    pub instance_kind: ASTInstanceKind = ::ASTInstanceKind::None,
    pub pack_name: String, pub var_arg: bool = false,
    pub return_type: *ASTType = null;

    ASTFunctionType(&mut this, start: Token) : ASTType(ASTTypeKind::Function, start) {}
}

class ASTGenericType : ASTType {
    pub _type: *ASTType,
    pub types: Vector<*ASTType>;

    ASTGenericType(&mut this, _type: *ASTType, start: Token) : ASTType(ASTTypeKind::Generic, start) {
        this._type = _type;
    }
}

class ASTPathType : ASTType {
    pub segments: Vector<ASTPathSegment>;

    ASTPathType(&mut this, start: Token) : ASTType(ASTTypeKind::Path, start) {}
}

class ASTLiteral : ASTNode {
    pub value: String,
    pub _type: TokenType;

    ASTLiteral(&mut this, value: String, _type: TokenType, start: Token) : ASTNode(ASTNodeKind::LITERAL, start) {
        (this.value, this._type) = (value, _type);
    }
}

class ASTIdentifier : ASTNode {
    pub name: String;

    ASTIdentifier(&mut this, name: String, start: Token) : ASTNode(ASTNodeKind::IDENTIFIER, start) {
        this.name = name;
    }
}

class ASTScopeResolution : ASTNode {
    pub scope: *ASTNode,
    pub identifier: *ASTIdentifier;

    ASTScopeResolution(&mut this, scope: *ASTNode, identifier: *ASTIdentifier, start: Token) : ASTNode(ASTNodeKind::SCOPE_RESOLUTION, start) {
        (this.scope, this.identifier) = (scope, identifier);
    }
}

class ASTUnary : ASTNode {
    pub operand: *ASTNode,
    pub _operator: TokenType,
    pub mutable: bool;

    ASTUnary(&mut this, operand: *ASTNode, _operator: TokenType, mutable: bool, start: Token) : ASTNode(ASTNodeKind::UNARY, start) {
        (this.operand, this._operator, this.mutable) = (operand, _operator, mutable);
    }
}

class ASTBinary : ASTNode {
    pub left: *ASTNode,
    pub right: *ASTNode,
    pub _operator: TokenType;

    ASTBinary(&mut this, left: *ASTNode, right: *ASTNode, _operator: TokenType, start: Token) : ASTNode(ASTNodeKind::BINARY, start) {
        (this.left, this.right, this._operator) = (left, right, _operator);
    }
}

class ASTTernary : ASTNode {
    pub condition: *ASTNode,
    pub then: *ASTNode,
    pub _else: *ASTNode;

    ASTTernary(&mut this, condition: *ASTNode, then: *ASTNode, _else: *ASTNode, start: Token) : ASTNode(ASTNodeKind::TERNARY, start) {
        (this.condition, this.then, this._else) = (condition, then, _else);
    }
}

class ASTCall : ASTNode {
    pub expression: *ASTNode,
    pub arguments: Vector<*ASTNode>;

    ASTCall(&mut this, expression: *ASTNode, start: Token) : ASTNode(ASTNodeKind::CALL, start) {
        this.expression = expression;
    }
}

enum ASTIntrinsicKind: u8 {
    SizeOf, AlignOf
}

fn ToString(kind: ASTIntrinsicKind) -> String {
    if kind == ASTIntrinsicKind::SizeOf { return "sizeof".ToString(); }
    else { return "alignof".ToString(); }
}

class ASTIntrinsic : ASTNode {
    pub kind: ASTIntrinsicKind,
    pub arguments: Vector<*ASTNode>;

    ASTIntrinsic(&mut this, kind: ASTIntrinsicKind, start: Token) : ASTNode(ASTNodeKind::INTRINSIC, start) {
        this.kind = kind;
    }
}

class ASTConstructor : ASTNode {
    pub _type: *ASTType,
    pub arguments: Vector<*ASTNode>;

    ASTConstructor(&mut this, _type: *ASTType, start: Token) : ASTNode(ASTNodeKind::CONSTRUCTOR, start) {
        this._type = _type;
    }
}

class ASTPackSplat : ASTNode {
    pub expression: *ASTNode;

    ASTPackSplat(&mut this, expression: *ASTNode, start: Token) : ASTNode(ASTNodeKind::PACK_SPLAT, start) {
        this.expression = expression;
    }
}

class ASTMemberAccess : ASTNode {
    pub expression: *ASTNode,
    pub member: String, pub arrow: bool;

    ASTMemberAccess(&mut this, expression: *ASTNode, arrow: bool, start: Token) : ASTNode(ASTNodeKind::MEMBER_ACCESS, start) {
        (this.expression, this.arrow) = (expression, arrow);
    }
}

class ASTIndexAccess : ASTNode {
    pub expression: *ASTNode,
    pub index: *ASTNode;

    ASTIndexAccess(&mut this, expression: *ASTNode, index: *ASTNode, start: Token) : ASTNode(ASTNodeKind::INDEX_ACCESS, start) {
        (this.expression, this.index) = (expression, index);
    }
}

class ASTTypeApplication : ASTNode {
    pub expression: *ASTNode,
    pub types: Vector<*ASTType>;

    ASTTypeApplication(&mut this, expression: *ASTNode, start: Token) : ASTNode(ASTNodeKind::TYPE_APPLICATION, start) {
        this.expression = expression;
    }
}

class ASTCast : ASTNode {
    pub expression: *ASTNode,
    pub target_type: *ASTType;

    ASTCast(&mut this, expression: *ASTNode, target_type: *ASTType, start: Token) : ASTNode(ASTNodeKind::CAST, start) {
        (this.expression, this.target_type) = (expression, target_type);
    }
}

class ASTInitializerList : ASTNode {
    pub expressions: Vector<*ASTNode>;

    ASTInitializerList(&mut this, start: Token) : ASTNode(ASTNodeKind::INITIALIZER_LIST, start) {}
}

class ASTNew : ASTNode {
    pub _type: *ASTType,
    pub arguments: Vector<*ASTNode>,
    pub size: *ASTNode = null,
    pub initialized: bool = false;

    ASTNew(&mut this, _type: *ASTType, start: Token) : ASTNode(ASTNodeKind::NEW, start) {
        this._type = _type;
    }
}

class ASTDelete : ASTNode {
    pub expression: *ASTNode,
    pub array: bool = false;

    ASTDelete(&mut this, start: Token) : ASTNode(ASTNodeKind::DELETE, start) {}
}

class ASTAssignment : ASTNode {
    pub left: *ASTNode, pub right: *ASTNode,
    pub _operator: TokenType, pub next: *mut ASTAssignment = null;

    ASTAssignment(&mut this, left: *ASTNode, right: *ASTNode, _operator: TokenType, start: Token) : ASTNode(ASTNodeKind::ASSIGNMENT, start) {
        (this.left, this.right, this._operator) = (left, right, _operator);
    }
}

class ASTAwait : ASTNode {
    pub expression: *ASTNode;

    ASTAwait(&mut this, expression: *ASTNode, start: Token) : ASTNode(ASTNodeKind::AWAIT, start) {
        this.expression = expression;
    }
}

class ASTTuple : ASTNode {
    pub values: Vector<*ASTNode>;

    ASTTuple(&mut this, start: Token) : ASTNode(ASTNodeKind::TUPLE, start) {}
}

class ASTRange : ASTNode {
    pub start: *ASTNode,
    pub end: *ASTNode,
    pub inclusive: bool = false;

    ASTRange(&mut this, start: *ASTNode, end: *ASTNode, _start: Token) : ASTNode(ASTNodeKind::RANGE, _start) {
        (this.start, this.end) = (start, end);
    }
}

class ASTCase : ASTNode {
    pub pattern: *ASTNode,
    pub body: *ASTNode,
    pub guard: *ASTNode;

    ASTCase(&mut this, pattern: *ASTNode, body: *ASTNode, guard: *ASTNode, start: Token) : ASTNode(ASTNodeKind::CASE, start) {
        (this.pattern, this.body, this.guard) = (pattern, body, guard);
    }
}

class ASTDefault : ASTNode {
    pub body: *ASTNode;

    ASTDefault(&mut this, body: *ASTNode, start: Token) : ASTNode(ASTNodeKind::DEFAULT, start) {
        this.body = body;
    }
}

class ASTOrPattern : ASTNode {
    pub left: *ASTNode,
    pub right: *ASTNode;

    ASTOrPattern(&mut this, left: *ASTNode, right: *ASTNode, start: Token) : ASTNode(ASTNodeKind::OR_PATTERN, start) {
        (this.left, this.right) = (left, right);
    }
}

class ASTStructureInitializer : ASTNode {
    pub expression: *ASTNode,
    pub field_names: Vector<String>,
    pub field_values: Vector<*ASTNode>;

    ASTStructureInitializer(&mut this, expression: *ASTNode, start: Token) : ASTNode(ASTNodeKind::STRUCTURE_INITIALIZER, start) {
        this.expression = expression;
    }
}

enum ASTStatementKind: u8 {
    Variable, Expression, If, IfLet, While, WhileLet, Loop, For, Match, Return, Break, Continue, Block, Unsafe, Assembly
}

fn ToString(kind: ASTStatementKind) -> String {
    if kind == ASTStatementKind::Variable { return "Variable".ToString(); }
    else if kind == ASTStatementKind::Expression { return "Expression".ToString(); }
    else if kind == ASTStatementKind::If { return "If".ToString(); }
    else if kind == ASTStatementKind::IfLet { return "IfLet".ToString(); }
    else if kind == ASTStatementKind::While { return "While".ToString(); }
    else if kind == ASTStatementKind::WhileLet { return "WhileLet".ToString(); }
    else if kind == ASTStatementKind::Loop { return "Loop".ToString(); }
    else if kind == ASTStatementKind::For { return "For".ToString(); }
    else if kind == ASTStatementKind::Match { return "Match".ToString(); }
    else if kind == ASTStatementKind::Return { return "Return".ToString(); }
    else if kind == ASTStatementKind::Break { return "Break".ToString(); }
    else if kind == ASTStatementKind::Continue { return "Continue".ToString(); }
    else if kind == ASTStatementKind::Block { return "Block".ToString(); }
    else if kind == ASTStatementKind::Unsafe { return "Unsafe".ToString(); }
    else if kind == ASTStatementKind::Assembly { return "Assembly".ToString(); }
    else { return "Unknown".ToString(); }
}

class ASTStatement : ASTNode {
    pub kind: ASTStatementKind;

    ASTStatement(&mut this, kind: ASTStatementKind, start: Token) : ASTNode(ASTNodeKind::Statement, start) {
        this.kind = kind;
    }
}

class ASTVariableStatement : ASTStatement {
    pub name: String, pub _type: *ASTType,
    pub initializer: *ASTNode, pub mutable: bool,
    pub next: *mut ASTVariableStatement = null;

    ASTVariableStatement(&mut this, name: String, _type: *ASTType, initializer: *ASTNode, mutable: bool, start: Token) : ASTStatement(ASTStatementKind::Variable, start) {
        (this.name, this._type, this.initializer, this.mutable) = (name, _type, initializer, mutable);
    }
}

class ASTExpressionStatement : ASTStatement {
    pub expression: *ASTNode;

    ASTExpressionStatement(&mut this, expression: *ASTNode, start: Token) : ASTStatement(ASTStatementKind::Expression, start) {
        this.expression = expression;
    }
}

class ASTIfStatement : ASTStatement {
    pub condition: *ASTNode,
    pub body: *ASTBlockStatement,
    pub _else: *ASTStatement;

    ASTIfStatement(&mut this, condition: *ASTNode, body: *ASTBlockStatement, _else: *ASTBlockStatement, start: Token) : ASTStatement(ASTStatementKind::If, start) {
        (this.condition, this.body, this._else) = (condition, body, _else);
    }
}

class ASTIfLetStatement : ASTStatement {
    pub pattern: *ASTNode,
    pub expression: *ASTNode,
    pub body: *ASTBlockStatement,
    pub _else: *ASTStatement = null;

    ASTIfLetStatement(&mut this, pattern: *ASTNode, expression: *ASTNode, body: *ASTBlockStatement, start: Token) : ASTStatement(ASTStatementKind::IfLet, start) {
        (this.pattern, this.expression, this.body) = (pattern, expression, body);
    }
}

class ASTWhileStatement : ASTStatement {
    pub condition: *ASTNode,
    pub body: *ASTBlockStatement,
    pub _else: *ASTBlockStatement;

    ASTWhileStatement(&mut this, condition: *ASTNode, body: *ASTBlockStatement, _else: *ASTBlockStatement, start: Token) : ASTStatement(ASTStatementKind::While, start) {
        (this.condition, this.body, this._else) = (condition, body, _else);
    }
}

class ASTWhileLetStatement : ASTStatement {
    pub pattern: *ASTNode,
    pub expression: *ASTNode,
    pub body: *ASTBlockStatement;

    ASTWhileLetStatement(&mut this, pattern: *ASTNode, expression: *ASTNode, body: *ASTBlockStatement, start: Token) : ASTStatement(ASTStatementKind::WhileLet, start) {
        (this.pattern, this.expression, this.body) = (pattern, expression, body);
    }
}

class ASTLoopStatement : ASTStatement {
    pub body: *ASTBlockStatement;

    ASTLoopStatement(&mut this, body: *ASTBlockStatement, start: Token) : ASTStatement(ASTStatementKind::Loop, start) {
        this.body = body;
    }
}

class ASTForStatement : ASTStatement {
    pub variable: String,
    pub iterable: *ASTNode,
    pub body: *ASTBlockStatement;

    ASTForStatement(&mut this, variable: String, iterable: *ASTNode, body: *ASTBlockStatement, start: Token) : ASTStatement(ASTStatementKind::For, start) {
        (this.variable, this.iterable, this.body) = (variable, iterable, body);
    }
}

class ASTMatchStatement : ASTStatement {
    pub expression: *ASTNode,
    pub cases: Vector<*ASTCase>,
    pub default: *ASTDefault;

    ASTMatchStatement(&mut this, expression: *ASTNode, start: Token) : ASTStatement(ASTStatementKind::Match, start) {
        (this.expression, this.default) = (expression, null);
    }
}

class ASTReturnStatement : ASTStatement {
    pub expression: *ASTNode;

    ASTReturnStatement(&mut this, expression: *ASTNode, start: Token) : ASTStatement(ASTStatementKind::Return, start) {
        this.expression = expression;
    }
}

class ASTBreakStatement : ASTStatement {
    ASTBreakStatement(&mut this, start: Token) : ASTStatement(ASTStatementKind::Break, start) {}
}

class ASTContinueStatement : ASTStatement {
    ASTContinueStatement(&mut this, start: Token) : ASTStatement(ASTStatementKind::Continue, start) {}
}

class ASTBlockStatement : ASTStatement {
    pub statements: Vector<*ASTStatement>;

    ASTBlockStatement(&mut this, start: Token) : ASTStatement(ASTStatementKind::Block, start) {}
}

class ASTUnsafeStatement : ASTStatement {
    pub body: *ASTBlockStatement;

    ASTUnsafeStatement(&mut this, body: *ASTBlockStatement, start: Token) : ASTStatement(ASTStatementKind::Unsafe, start) {
        this.body = body;
    }
}

class ASTAssemblyStatement : ASTStatement {
    pub _volatile: bool, pub code: String,
    pub inputs: Vector<Pair<String, *ASTNode>>,
    pub outputs: Vector<Pair<String, *ASTNode>>,
    pub clobbers: Vector<String>;

    ASTAssemblyStatement(&mut this, _volatile: bool, start: Token) : ASTStatement(ASTStatementKind::Assembly, start) {
        this._volatile = _volatile;
    }
}

enum ASTDeclarationKind: u8 {
    Function, Parameter, Class, Structure, Field, Enumeration, Variant, Constant, Static, Type, Extern, Assembly
}

fn ToString(kind: ASTDeclarationKind) -> String {
    if kind == ASTDeclarationKind::Function { return "Function".ToString(); }
    else if kind == ASTDeclarationKind::Parameter { return "Parameter".ToString(); }
    else if kind == ASTDeclarationKind::Class { return "Class".ToString(); }
    else if kind == ASTDeclarationKind::Structure { return "Structure".ToString(); }
    else if kind == ASTDeclarationKind::Field { return "Field".ToString(); }
    else if kind == ASTDeclarationKind::Enumeration { return "Enumeration".ToString(); }
    else if kind == ASTDeclarationKind::Variant { return "Variant".ToString(); }
    else if kind == ASTDeclarationKind::Constant { return "Constant".ToString(); }
    else if kind == ASTDeclarationKind::Static { return "Static".ToString(); }
    else if kind == ASTDeclarationKind::Type { return "Type".ToString(); }
    else if kind == ASTDeclarationKind::Extern { return "Extern".ToString(); }
    else if kind == ASTDeclarationKind::Assembly { return "Assembly".ToString(); }
    else { return "Unknown".ToString(); }
}

class ASTDeclaration : ASTNode {
    pub kind: ASTDeclarationKind;

    ASTDeclaration(&mut this, kind: ASTDeclarationKind, start: Token) : ASTNode(ASTNodeKind::Declaration, start) {
        this.kind = kind;
    }
}

class ASTConstantDeclaration : ASTDeclaration {
    pub name: String,
    pub _type: *ASTType,
    pub initializer: *ASTNode;

    ASTConstantDeclaration(&mut this, name: String, _type: *ASTType, initializer: *ASTNode, start: Token) : ASTDeclaration(ASTDeclarationKind::Constant, start) {
        (this.name, this._type, this.initializer) = (name, _type, initializer);
    }
}

class ASTStaticDeclaration : ASTDeclaration {
    pub name: String,
    pub _type: *ASTType,
    pub mutable: bool,
    pub initializer: *ASTNode = null,
    pub alignment: *ASTNode,
    pub zero_initializer: bool = false;

    ASTStaticDeclaration(&mut this, name: String, _type: *ASTType, mutable: bool, alignment: *ASTNode, start: Token) : ASTDeclaration(ASTDeclarationKind::Static, start) {
        (this.name, this._type, this.mutable, this.alignment) = (name, _type, mutable, alignment);
    }
}

class ASTTypeDeclaration : ASTDeclaration {
    pub name: String,
    pub _type: *ASTType;

    ASTTypeDeclaration(&mut this, name: String, _type: *ASTType, start: Token) : ASTDeclaration(ASTDeclarationKind::Type, start) {
        (this.name, this._type) = (name, _type);
    }
}

class ASTParameterDeclaration : ASTDeclaration {
    pub name: String,
    pub _type: *ASTType,
    pub mutable: bool;

    ASTParameterDeclaration(&mut this, name: String, _type: *ASTType, mutable: bool, start: Token) : ASTDeclaration(ASTDeclarationKind::Parameter, start) {
        (this.name, this._type, this.mutable) = (name, _type, mutable);
    }
}

class ASTFunctionDeclaration : ASTDeclaration {
    pub name: String, pub _type: *ASTFunctionType,
    pub body: *ASTBlockStatement = null, pub _async: bool = false,
    pub constructors: Vector<*ASTConstructor>, pub no_mangle: bool,
    pub types: Vector<String>, pub generic: bool = false;

    ASTFunctionDeclaration(&mut this, name: String, _type: *ASTFunctionType, no_mangle: bool, start: Token) : ASTDeclaration(ASTDeclarationKind::Function, start) {
        (this.name, this._type, this.no_mangle) = (name, _type, no_mangle);
    }
}

class ASTFieldDeclaration : ASTDeclaration {
    pub name: String,
    pub _type: *ASTType,
    pub initializer: *ASTNode;

    ASTFieldDeclaration(&mut this, name: String, _type: *ASTType, initializer: *ASTNode, start: Token) : ASTDeclaration(ASTDeclarationKind::Field, start) {
        (this.name, this._type, this.initializer) = (name, _type, initializer);
    }
}

class ASTClassDeclaration : ASTDeclaration {
    pub name: String, pub parents: Vector<*ASTType>,
    pub fields: Vector<Pair<bool, *ASTFieldDeclaration>>,
    pub constructors: Vector<*ASTFunctionDeclaration>,
    pub destructor: *ASTFunctionDeclaration = null,
    pub methods: Vector<Pair<bool, *ASTFunctionDeclaration>>,
    pub types: Vector<String>, pub generic: bool = false;

    ASTClassDeclaration(&mut this, name: String, start: Token) : ASTDeclaration(ASTDeclarationKind::Class, start) {
        this.name = name;
    }
}

class ASTStructureDeclaration : ASTDeclaration {
    pub name: String,
    pub fields: Vector<Pair<bool, *ASTFieldDeclaration>>,
    pub methods: Vector<Pair<bool, *ASTFunctionDeclaration>>,
    pub types: Vector<String>,
    pub generic: bool = false;

    ASTStructureDeclaration(&mut this, name: String, start: Token) : ASTDeclaration(ASTDeclarationKind::Structure, start) {
        this.name = name;
    }
}

class ASTVariantDeclaration : ASTNode {
    pub name: String,
    pub types: Vector<*ASTType>,
    pub field_names: Vector<String>,
    pub value: *ASTNode = null;

    ASTVariantDeclaration(&mut this, name: String, start: Token) : ASTNode(ASTNodeKind::VARIANT, start) {
        this.name = name;
    }
}

class ASTEnumerationDeclaration : ASTDeclaration {
    pub name: String, pub underlying_type: *ASTType = null,
    pub variants: Vector<*ASTVariantDeclaration>, pub variant: bool = false,
    pub methods: Vector<Pair<bool, *ASTFunctionDeclaration>>,
    pub types: Vector<String>, pub generic: bool = false;

    ASTEnumerationDeclaration(&mut this, name: String, start: Token) : ASTDeclaration(ASTDeclarationKind::Enumeration, start) {
        this.name = name;
    }
}

class ASTExternDeclaration : ASTDeclaration {
    pub linkage: String,
    pub declarations: Vector<*ASTDeclaration>;

    ASTExternDeclaration(&mut this, linkage: String, start: Token) : ASTDeclaration(ASTDeclarationKind::Extern, start) {
        this.linkage = linkage;
    }
}

class ASTAssemblyDeclaration : ASTDeclaration {
    pub code: String;

    ASTAssemblyDeclaration(&mut this, code: String, start: Token) : ASTDeclaration(ASTDeclarationKind::Assembly, start) {
        this.code = code;
    }
}

class ASTModule {
    pub declarations: Vector<*ASTDeclaration>;

    ASTModule(&mut this) {}
}
