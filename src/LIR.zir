#[include "std/str", "std/vec" : *]

enum LIROperandKind: u8 {
    Register, Immediate, Memory, Block, Symbol
}

class LIROperand {
    pub kind: LIROperandKind;

    LIROperand(&mut this, kind: LIROperandKind) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        if this.kind == LIROperandKind::Register {
            return (this as *LIRRegisterOperand)->ToString();
        } else if this.kind == LIROperandKind::Immediate {
            return (this as *LIRImmediateOperand)->ToString();
        } else if this.kind == LIROperandKind::Memory {
            return (this as *LIRMemoryOperand)->ToString();
        } else if this.kind == LIROperandKind::Block {
            return (this as *LIRBlockOperand)->ToString();
        } else if this.kind == LIROperandKind::Symbol {
            return (this as *LIRSymbolOperand)->ToString();
        } else {
            return "<invalid operand>".ToString();
        }
    }
}

enum LIRRegisterKind: u8 {
    Virtual, Physical
}

class LIRRegisterOperand : LIROperand {
    pub kind: LIRRegisterKind;

    LIRRegisterOperand(&mut this, kind: LIRRegisterKind) : LIROperand(LIROperandKind::Register) {
        this.kind = kind;
    }

    pub fn ToString(&this) -> String {
        if this.kind == LIRRegisterKind::Virtual {
            return (this as *LIRVirtualRegister)->ToString();
        } else if this.kind == LIRRegisterKind::Physical {
            return (this as *LIRPhysicalRegister)->ToString();
        } else {
            return "<invalid register>".ToString();
        }
    }
}

class LIRVirtualRegister : LIRRegisterOperand {
    pub index: u32;

    LIRVirtualRegister(&mut this, index: u32) : LIRRegisterOperand(LIRRegisterKind::Virtual) {
        this.index = index;
    }

    pub fn ToString(&this) -> String {
        return 'v' + String::FromInteger(this.index as u64);
    }
}

class LIRPhysicalRegister : LIRRegisterOperand {
    pub index: u8;

    LIRPhysicalRegister(&mut this, index: u8) : LIRRegisterOperand(LIRRegisterKind::Physical) {
        this.index = index;
    }

    pub fn ToString(&this) -> String {
        return 'x' + String::FromInteger(this.index as u64);
    }
}

class LIRImmediateOperand : LIROperand {
    pub value: i64;

    LIRImmediateOperand(&mut this, value: i64) : LIROperand(LIROperandKind::Immediate) {
        this.value = value;
    }

    pub fn ToString(&this) -> String {
        return String::FromInteger(this.value);
    }
}

class LIRMemoryOperand : LIROperand {
    pub base: *LIROperand,
    pub offset: i32;

    LIRMemoryOperand(&mut this, base: *LIROperand, offset: i32) : LIROperand(LIROperandKind::Memory) {
        (this.base, this.offset) = (base, offset);
    }

    pub fn ToString(&this) -> String {
        return String::FromInteger(this.offset as i64) + '(' + this.base->ToString() + ')';
    }
}

class LIRBlockOperand : LIROperand {
    pub block: *LIRBlock;

    LIRBlockOperand(&mut this, block: *LIRBlock) : LIROperand(LIROperandKind::Block) {
        this.block = block;
    }

    pub fn ToString(&this) -> String {
        return this.block->name;
    }
}

class LIRSymbolOperand : LIROperand {
    pub name: String;

    LIRSymbolOperand(&mut this, name: String) : LIROperand(LIROperandKind::Symbol) {
        this.name = name;
    }

    pub fn ToString(&this) -> String {
        return this.name;
    }
}

enum LIROpcode: u16 {
    Nop,
    Lb, Lbu, Lh, Lhu, Lw, Lui, Auipc, Sb, Sh, Sw,
    B, Br, Bl, Blr, Beq, Bne, Blt, Bltu, Bge, Bgeu,
    Slt, Slti, Sltu, Sltiu,
    Add, Addi, Sub, Subi,
    Mul, Mulh, Mulhsu, Mulhu, Div, Divu, Rem, Remu,
    And, Andi, Or, Ori, Xor, Xori,
    Sll, Slli, Srl, Srli, Sra, Srai,
    Hlt
}

fn ToString(opcode: LIROpcode) -> String {
    if opcode == LIROpcode::Nop { return "nop".ToString(); }
    else if opcode == LIROpcode::Lb { return "lb".ToString(); }
    else if opcode == LIROpcode::Lbu { return "lbu".ToString(); }
    else if opcode == LIROpcode::Lh { return "lh".ToString(); }
    else if opcode == LIROpcode::Lhu { return "lhu".ToString(); }
    else if opcode == LIROpcode::Lw { return "lw".ToString(); }
    else if opcode == LIROpcode::Lui { return "lui".ToString(); }
    else if opcode == LIROpcode::Auipc { return "auipc".ToString(); }
    else if opcode == LIROpcode::Sb { return "sb".ToString(); }
    else if opcode == LIROpcode::Sh { return "sh".ToString(); }
    else if opcode == LIROpcode::Sw { return "sw".ToString(); }
    else if opcode == LIROpcode::B { return "b".ToString(); }
    else if opcode == LIROpcode::Br { return "br".ToString(); }
    else if opcode == LIROpcode::Bl { return "bl".ToString(); }
    else if opcode == LIROpcode::Blr { return "blr".ToString(); }
    else if opcode == LIROpcode::Beq { return "beq".ToString(); }
    else if opcode == LIROpcode::Bne { return "bne".ToString(); }
    else if opcode == LIROpcode::Blt { return "blt".ToString(); }
    else if opcode == LIROpcode::Bltu { return "bltu".ToString(); }
    else if opcode == LIROpcode::Bge { return "bge".ToString(); }
    else if opcode == LIROpcode::Bgeu { return "bgeu".ToString(); }
    else if opcode == LIROpcode::Slt { return "slt".ToString(); }
    else if opcode == LIROpcode::Slti { return "slti".ToString(); }
    else if opcode == LIROpcode::Sltu { return "sltu".ToString(); }
    else if opcode == LIROpcode::Sltiu { return "sltiu".ToString(); }
    else if opcode == LIROpcode::Add { return "add".ToString(); }
    else if opcode == LIROpcode::Addi { return "addi".ToString(); }
    else if opcode == LIROpcode::Sub { return "sub".ToString(); }
    else if opcode == LIROpcode::Subi { return "subi".ToString(); }
    else if opcode == LIROpcode::Mul { return "mul".ToString(); }
    else if opcode == LIROpcode::Mulh { return "mulh".ToString(); }
    else if opcode == LIROpcode::Mulhsu { return "mulhsu".ToString(); }
    else if opcode == LIROpcode::Mulhu { return "mulhu".ToString(); }
    else if opcode == LIROpcode::Div { return "div".ToString(); }
    else if opcode == LIROpcode::Divu { return "divu".ToString(); }
    else if opcode == LIROpcode::Rem { return "rem".ToString(); }
    else if opcode == LIROpcode::Remu { return "remu".ToString(); }
    else if opcode == LIROpcode::And { return "and".ToString(); }
    else if opcode == LIROpcode::Andi { return "andi".ToString(); }
    else if opcode == LIROpcode::Or { return "or".ToString(); }
    else if opcode == LIROpcode::Ori { return "ori".ToString(); }
    else if opcode == LIROpcode::Xor { return "xor".ToString(); }
    else if opcode == LIROpcode::Xori { return "xori".ToString(); }
    else if opcode == LIROpcode::Sll { return "sll".ToString(); }
    else if opcode == LIROpcode::Slli { return "slli".ToString(); }
    else if opcode == LIROpcode::Srl { return "srl".ToString(); }
    else if opcode == LIROpcode::Srli { return "srli".ToString(); }
    else if opcode == LIROpcode::Sra { return "sra".ToString(); }
    else if opcode == LIROpcode::Srai { return "srai".ToString(); }
    else if opcode == LIROpcode::Hlt { return "hlt".ToString(); }
    else { return "<invalid instruction>".ToString(); }
}

class LIRInstruction {
    pub opcode: LIROpcode,
    pub defines: Vector<*LIROperand>,
    pub uses: Vector<*LIROperand>;

    LIRInstruction(&mut this, opcode: LIROpcode, defines: Vector<*LIROperand>, uses: Vector<*LIROperand>) {
        (this.opcode, this.defines, this.uses) = (opcode, defines, uses);
    }

    pub fn ToString(&this) -> String {
        let mut result = String();

        if !this.defines.Empty() {
            for i in 0..this.defines.Size() {
                if i > 0 { result += ", "; }
                let operand: *LIROperand = this.defines[i];
                result += operand->ToString();
            } result += " = ";
        }

        result += this.opcode.ToString();

        if !this.uses.Empty() {
            result += ' ';

            for i in 0..this.uses.Size() {
                if i > 0 { result += ", "; }
                let operand: *LIROperand = this.uses[i];
                result += operand->ToString();
            }
        } return result;
    }
}

class LIRBlock {
    pub name: String,
    pub instructions: Vector<*LIRInstruction>,
    pub predecessors: Vector<*LIRBlock>,
    pub successors: Vector<*LIRBlock>;

    LIRBlock(&mut this, name: String) {
        this.name = name;
    }
}

class LIRFunction {
    pub name: String,
    pub blocks: Vector<*LIRBlock>;

    LIRFunction(&mut this, name: String) {
        this.name = name;
    }
}

class LIRModule {
    pub functions: Vector<*LIRFunction>;

    LIRModule(&mut this) {}
}
