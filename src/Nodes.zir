#[include "std/str", "std/vec", "std/map", "std/pair", "src/Tokens.zir" : *]

enum NodeType: i32 {
    ROOT, ASSEMBLY, UNSAFE,

    FUNCTION, PARAMETER, CLASS, STRUCTURE, FIELD, ENUMERATION, VARIANT,
    CONSTANT, STATIC, TYPE_DEFINITION, EXTERN,

    IF, IF_LET, WHILE, WHILE_LET, FOR, LOOP,
    MATCH, CASE, DEFAULT, RETURN, BREAK, CONTINUE,
    VARIABLE, BLOCK, EXPRESSION,

    UNARY, BINARY, TERNARY, ASSIGNMENT, CALL, CAST, NEW, DELETE,
    LITERAL, IDENTIFIER, SCOPE_RESOLUTION, PACK_SPLAT, MEMBER_ACCESS, INDEX_ACCESS,
    RANGE, AWAIT, TUPLE, INITIALIZER_LIST, STRUCTURE_INITIALIZER, OR_PATTERN, TYPE_APPLICATION,

    PRIMITIVE_TYPE, POINTER_TYPE, REFERENCE_TYPE, ARRAY_TYPE, FUNCTION_TYPE
}

fn ToString(_type: NodeType) -> String {
    if _type == NodeType::ROOT { return "ROOT".ToString(); }
    else if _type == NodeType::ASSEMBLY { return "ASSEMBLY".ToString(); }
    else if _type == NodeType::UNSAFE { return "UNSAFE".ToString(); }
    else if _type == NodeType::FUNCTION { return "FUNCTION".ToString(); }
    else if _type == NodeType::PARAMETER { return "PARAMETER".ToString(); }
    else if _type == NodeType::CLASS { return "CLASS".ToString(); }
    else if _type == NodeType::STRUCTURE { return "STRUCTURE".ToString(); }
    else if _type == NodeType::FIELD { return "FIELD".ToString(); }
    else if _type == NodeType::ENUMERATION { return "ENUMERATION".ToString(); }
    else if _type == NodeType::VARIANT { return "VARIANT".ToString(); }
    else if _type == NodeType::CONSTANT { return "CONSTANT".ToString(); }
    else if _type == NodeType::STATIC { return "STATIC".ToString(); }
    else if _type == NodeType::TYPE_DEFINITION { return "TYPE_DEFINITION".ToString(); }
    else if _type == NodeType::EXTERN { return "EXTERN".ToString(); }
    else if _type == NodeType::IF { return "IF".ToString(); }
    else if _type == NodeType::IF_LET { return "IF_LET".ToString(); }
    else if _type == NodeType::WHILE { return "WHILE".ToString(); }
    else if _type == NodeType::WHILE_LET { return "WHILE_LET".ToString(); }
    else if _type == NodeType::FOR { return "FOR".ToString(); }
    else if _type == NodeType::LOOP { return "LOOP".ToString(); }
    else if _type == NodeType::MATCH { return "MATCH".ToString(); }
    else if _type == NodeType::CASE { return "CASE".ToString(); }
    else if _type == NodeType::DEFAULT { return "DEFAULT".ToString(); }
    else if _type == NodeType::RETURN { return "RETURN".ToString(); }
    else if _type == NodeType::BREAK { return "BREAK".ToString(); }
    else if _type == NodeType::CONTINUE { return "CONTINUE".ToString(); }
    else if _type == NodeType::VARIABLE { return "VARIABLE".ToString(); }
    else if _type == NodeType::BLOCK { return "BLOCK".ToString(); }
    else if _type == NodeType::EXPRESSION { return "EXPRESSION".ToString(); }
    else if _type == NodeType::UNARY { return "UNARY".ToString(); }
    else if _type == NodeType::BINARY { return "BINARY".ToString(); }
    else if _type == NodeType::TERNARY { return "TERNARY".ToString(); }
    else if _type == NodeType::ASSIGNMENT { return "ASSIGNMENT".ToString(); }
    else if _type == NodeType::CALL { return "CALL".ToString(); }
    else if _type == NodeType::CAST { return "CAST".ToString(); }
    else if _type == NodeType::NEW { return "NEW".ToString(); }
    else if _type == NodeType::DELETE { return "DELETE".ToString(); }
    else if _type == NodeType::LITERAL { return "LITERAL".ToString(); }
    else if _type == NodeType::IDENTIFIER { return "IDENTIFIER".ToString(); }
    else if _type == NodeType::SCOPE_RESOLUTION { return "SCOPE_RESOLUTION".ToString(); }
    else if _type == NodeType::PACK_SPLAT { return "PACK_SPLAT".ToString(); }
    else if _type == NodeType::MEMBER_ACCESS { return "MEMBER_ACCESS".ToString(); }
    else if _type == NodeType::INDEX_ACCESS { return "INDEX_ACCESS".ToString(); }
    else if _type == NodeType::RANGE { return "RANGE".ToString(); }
    else if _type == NodeType::AWAIT { return "AWAIT".ToString(); }
    else if _type == NodeType::TUPLE { return "TUPLE".ToString(); }
    else if _type == NodeType::INITIALIZER_LIST { return "INITIALIZER_LIST".ToString(); }
    else if _type == NodeType::STRUCTURE_INITIALIZER { return "STRUCTURE_INITIALIZER".ToString(); }
    else if _type == NodeType::OR_PATTERN { return "OR_PATTERN".ToString(); }
    else if _type == NodeType::TYPE_APPLICATION { return "TYPE_APPLICATION".ToString(); }
    else if _type == NodeType::PRIMITIVE_TYPE { return "PRIMITIVE_TYPE".ToString(); }
    else if _type == NodeType::POINTER_TYPE { return "POINTER_TYPE".ToString(); }
    else if _type == NodeType::REFERENCE_TYPE { return "REFERENCE_TYPE".ToString(); }
    else if _type == NodeType::ARRAY_TYPE { return "ARRAY_TYPE".ToString(); }
    else if _type == NodeType::FUNCTION_TYPE { return "FUNCTION_TYPE".ToString(); }
    else { return "UNKNOWN".ToString(); }
}

class Node {
    pub _type: NodeType,
    pub start: Token,
    pub end: Token;

    Node(&mut this, _type: NodeType, start: Token) {
        (this._type, this.start) = (_type, start);
    }
}

class PrimitiveTypeNode : Node {
    pub name: String;

    PrimitiveTypeNode(&mut this, name: String, start: Token) : Node(NodeType::PRIMITIVE_TYPE, start) {
        this.name = name;
    }
}

class PointerTypeNode : Node {
    pub base_type: *Node,
    pub mutable: bool;

    PointerTypeNode(&mut this, base_type: *Node, mutable: bool, start: Token) : Node(NodeType::POINTER_TYPE, start) {
        (this.base_type, this.mutable) = (base_type, mutable);
    }
}

class ReferenceTypeNode : Node {
    pub base_type: *Node,
    pub mutable: bool;

    ReferenceTypeNode(&mut this, base_type: *Node, mutable: bool, start: Token) : Node(NodeType::REFERENCE_TYPE, start) {
        (this.base_type, this.mutable) = (base_type, mutable);
    }
}

class ArrayTypeNode : Node {
    pub element_type: *Node,
    pub size: *Node;

    ArrayTypeNode(&mut this, element_type: *Node, size: *Node, start: Token) : Node(NodeType::ARRAY_TYPE, start) {
        (this.element_type, this.size) = (element_type, size);
    }
}

class LiteralNode : Node {
    pub value: String,
    pub _type: TokenType;

    LiteralNode(&mut this, value: String, _type: TokenType, start: Token) : Node(NodeType::LITERAL, start) {
        (this.value, this._type) = (value, _type);
    }
}

class IdentifierNode : Node {
    pub name: String;

    IdentifierNode(&mut this, name: String, start: Token) : Node(NodeType::IDENTIFIER, start) {
        this.name = name;
    }
}

class ScopeResolutionNode : Node {
    pub scope: *Node,
    pub identifier: *IdentifierNode;

    ScopeResolutionNode(&mut this, scope: *Node, identifier: *IdentifierNode, start: Token) : Node(NodeType::SCOPE_RESOLUTION, start) {
        (this.scope, this.identifier) = (scope, identifier);
    }
}

class UnaryNode : Node {
    pub operand: *Node,
    pub _operator: TokenType,
    pub mutable: bool;

    UnaryNode(&mut this, operand: *Node, _operator: TokenType, mutable: bool, start: Token) : Node(NodeType::UNARY, start) {
        (this.operand, this._operator, this.mutable) = (operand, _operator, mutable);
    }
}

class BinaryNode : Node {
    pub left: *Node,
    pub right: *Node,
    pub _operator: TokenType;

    BinaryNode(&mut this, left: *Node, right: *Node, _operator: TokenType, start: Token) : Node(NodeType::BINARY, start) {
        (this.left, this.right, this._operator) = (left, right, _operator);
    }
}

class TernaryNode : Node {
    pub condition: *Node,
    pub then: *Node,
    pub _else: *Node;

    TernaryNode(&mut this, condition: *Node, then: *Node, _else: *Node, start: Token) : Node(NodeType::TERNARY, start) {
        (this.condition, this.then, this._else) = (condition, then, _else);
    }
}

class CallNode : Node {
    pub expression: *Node,
    pub arguments: Vector<*Node>;

    CallNode(&mut this, expression: *Node, start: Token) : Node(NodeType::CALL, start) {
        this.expression = expression;
    }
}

class PackSplatNode : Node {
    pub expression: *Node;

    PackSplatNode(&mut this, expression: *Node, start: Token) : Node(NodeType::PACK_SPLAT, start) {
        this.expression = expression;
    }
}

class MemberAccessNode : Node {
    pub expression: *Node,
    pub member: String, pub arrow: bool;

    MemberAccessNode(&mut this, expression: *Node, arrow: bool, start: Token) : Node(NodeType::MEMBER_ACCESS, start) {
        (this.expression, this.arrow) = (expression, arrow);
    }
}

class IndexAccessNode : Node {
    pub expression: *Node,
    pub index: *Node;

    IndexAccessNode(&mut this, expression: *Node, index: *Node, start: Token) : Node(NodeType::INDEX_ACCESS, start) {
        (this.expression, this.index) = (expression, index);
    }
}

class TypeApplicationNode : Node {
    pub expression: *Node,
    pub types: Vector<*Node>;

    TypeApplicationNode(&mut this, expression: *Node, start: Token) : Node(NodeType::TYPE_APPLICATION, start) {
        this.expression = expression;
    }
}

class CastNode : Node {
    pub expression: *Node,
    pub target_type: *Node;

    CastNode(&mut this, expression: *Node, target_type: *Node, start: Token) : Node(NodeType::CAST, start) {
        (this.expression, this.target_type) = (expression, target_type);
    }
}

class InitializerListNode : Node {
    pub expressions: Vector<*Node>;

    InitializerListNode(&mut this, start: Token) : Node(NodeType::INITIALIZER_LIST, start) {}
}

class NewNode : Node {
    pub _type: *Node,
    pub arguments: Vector<*Node>,
    pub size: *Node = null,
    pub initialized: bool = false;

    NewNode(&mut this, _type: *Node, start: Token) : Node(NodeType::NEW, start) {
        this._type = _type;
    }
}

class DeleteNode : Node {
    pub expression: *Node,
    pub array: bool = false;

    DeleteNode(&mut this, start: Token) : Node(NodeType::DELETE, start) {}
}

class ExpressionNode : Node {
    pub expression: *Node;

    ExpressionNode(&mut this, expression: *Node, start: Token) : Node(NodeType::EXPRESSION, start) {
        this.expression = expression;
    }
}

class VariableNode : Node {
    pub name: String, pub _type: *Node,
    pub initializer: *Node, pub mutable: bool,
    pub next: *mut VariableNode = null;

    VariableNode(&mut this, name: String, _type: *Node, initializer: *Node, mutable: bool, start: Token) : Node(NodeType::VARIABLE, start) {
        (this.name, this._type, this.initializer, this.mutable) = (name, _type, initializer, mutable);
    }
}

class ConstantNode : Node {
    pub name: String, pub _type: *Node,
    pub initializer: *Node;

    ConstantNode(&mut this, name: String, _type: *Node, initializer: *Node, start: Token) : Node(NodeType::CONSTANT, start) {
        (this.name, this._type, this.initializer) = (name, _type, initializer);
    }
}

class StaticNode : Node {
    pub name: String, pub _type: *Node, pub mutable: bool,
    pub initializer: *Node = null, pub alignment: *Node,
    pub zero_initializer: bool = false;

    StaticNode(&mut this, name: String, _type: *Node, mutable: bool, alignment: *Node, start: Token) : Node(NodeType::STATIC, start) {
        (this.name, this._type, this.mutable, this.alignment) = (name, _type, mutable, alignment);
    }
}

class AssignmentNode : Node {
    pub left: *Node, pub right: *Node,
    pub _operator: TokenType, pub next: *mut AssignmentNode = null;

    AssignmentNode(&mut this, left: *Node, right: *Node, _operator: TokenType, start: Token) : Node(NodeType::ASSIGNMENT, start) {
        (this.left, this.right, this._operator) = (left, right, _operator);
    }
}

class IfNode : Node {
    pub condition: *Node,
    pub body: *Node,
    pub _else: *Node;

    IfNode(&mut this, condition: *Node, body: *Node, _else: *Node, start: Token) : Node(NodeType::IF, start) {
        (this.condition, this.body, this._else) = (condition, body, _else);
    }
}

class WhileNode : Node {
    pub condition: *Node,
    pub body: *Node,
    pub _else: *Node;

    WhileNode(&mut this, condition: *Node, body: *Node, _else: *Node, start: Token) : Node(NodeType::WHILE, start) {
        (this.condition, this.body, this._else) = (condition, body, _else);
    }
}

class LoopNode : Node {
    pub body: *Node;

    LoopNode(&mut this, body: *Node, start: Token) : Node(NodeType::LOOP, start) {
        this.body = body;
    }
}

class ReturnNode : Node {
    pub expression: *Node;

    ReturnNode(&mut this, expression: *Node, start: Token) : Node(NodeType::RETURN, start) {
        this.expression = expression;
    }
}

class BreakNode : Node {
    BreakNode(&mut this, start: Token) : Node(NodeType::BREAK, start) {}
}

class ContinueNode : Node {
    ContinueNode(&mut this, start: Token) : Node(NodeType::CONTINUE, start) {}
}

class BlockNode : Node {
    pub statements: Vector<*Node>;

    BlockNode(&mut this, start: Token) : Node(NodeType::BLOCK, start) {}
}

class ParameterNode : Node {
    pub name: String,
    pub _type: *Node,
    pub mutable: bool;

    ParameterNode(&mut this, name: String, _type: *Node, mutable: bool, start: Token) : Node(NodeType::PARAMETER, start) {
        (this.name, this._type, this.mutable) = (name, _type, mutable);
    }
}

enum InstanceKind: i32 {
    None, Copy, ConstRef, MutRef
}

class FunctionTypeNode : Node {
    pub parameters: Vector<*ParameterNode>,
    pub instance_kind: InstanceKind = ::InstanceKind::None,
    pub pack_name: String, pub var_arg: bool = false,
    pub return_type: *Node = null;

    FunctionTypeNode(&mut this, start: Token) : Node(NodeType::FUNCTION_TYPE, start) {}
}

class FunctionNode : Node {
    pub name: String, pub _type: *FunctionTypeNode,
    pub body: *BlockNode = null, pub _async: bool = false,
    pub constructors: Vector<*CallNode>, pub no_mangle: bool,
    pub types: Vector<String>, pub generic: bool = false;

    FunctionNode(&mut this, name: String, _type: *FunctionTypeNode, no_mangle: bool, start: Token) : Node(NodeType::FUNCTION, start) {
        (this.name, this._type, this.no_mangle) = (name, _type, no_mangle);
    }
}

class AwaitNode : Node {
    pub expression: *Node;

    AwaitNode(&mut this, expression: *Node, start: Token) : Node(NodeType::AWAIT, start) {
        this.expression = expression;
    }
}

class TupleNode : Node {
    pub values: Vector<*Node>;

    TupleNode(&mut this, start: Token) : Node(NodeType::TUPLE, start) {}
}

class TypeDeclarationNode : Node {
    pub name: String,
    pub _type: *Node;

    TypeDeclarationNode(&mut this, name: String, _type: *Node, start: Token) : Node(NodeType::TYPE_DEFINITION, start) {
        (this.name, this._type) = (name, _type);
    }
}

class ClassNode : Node {
    pub name: String, pub parents: Vector<*Node>,
    pub fields: Vector<Pair<bool, *FieldNode>>,
    pub constructors: Vector<*FunctionNode>,
    pub destructor: *FunctionNode = null,
    pub methods: Vector<Pair<bool, *FunctionNode>>,
    pub types: Vector<String>, pub generic: bool = false;

    ClassNode(&mut this, name: String, start: Token) : Node(NodeType::CLASS, start) {
        this.name = name;
    }
}

class StructureNode : Node {
    pub name: String,
    pub fields: Vector<Pair<bool, *FieldNode>>,
    pub methods: Vector<Pair<bool, *FunctionNode>>,
    pub types: Vector<String>,
    pub generic: bool = false;

    StructureNode(&mut this, name: String, start: Token) : Node(NodeType::STRUCTURE, start) {
        this.name = name;
    }
}

class FieldNode : Node {
    pub name: String,
    pub _type: *Node,
    pub initializer: *Node;

    FieldNode(&mut this, name: String, _type: *Node, initializer: *Node, start: Token) : Node(NodeType::FIELD, start) {
        (this.name, this._type, this.initializer) = (name, _type, initializer);
    }
}

class VariantNode : Node {
    pub name: String,
    pub types: Vector<*Node>,
    pub field_names: Vector<String>,
    pub value: *Node = null;

    VariantNode(&mut this, name: String, start: Token) : Node(NodeType::VARIANT, start) {
        this.name = name;
    }
}

class EnumerationNode : Node {
    pub name: String, pub underlying_type: *Node = null,
    pub variants: Vector<*VariantNode>, pub variant: bool = false,
    pub methods: Vector<Pair<bool, *FunctionNode>>,
    pub types: Vector<String>, pub generic: bool = false;

    EnumerationNode(&mut this, name: String, start: Token) : Node(NodeType::ENUMERATION, start) {
        this.name = name;
    }
}

class CaseNode : Node {
    pub pattern: *Node,
    pub body: *Node,
    pub guard: *Node;

    CaseNode(&mut this, pattern: *Node, body: *Node, guard: *Node, start: Token) : Node(NodeType::CASE, start) {
        (this.pattern, this.body, this.guard) = (pattern, body, guard);
    }
}

class DefaultNode : Node {
    pub body: *Node;

    DefaultNode(&mut this, body: *Node, start: Token) : Node(NodeType::DEFAULT, start) {
        this.body = body;
    }
}

class MatchNode : Node {
    pub expression: *Node,
    pub cases: Vector<*CaseNode>,
    pub default: *DefaultNode;

    MatchNode(&mut this, expression: *Node, start: Token) : Node(NodeType::MATCH, start) {
        (this.expression, this.default) = (expression, null);
    }
}

class StructureInitializerNode : Node {
    pub expression: *Node,
    pub field_names: Vector<String>,
    pub field_values: Vector<*Node>;

    StructureInitializerNode(&mut this, expression: *Node, start: Token) : Node(NodeType::STRUCTURE_INITIALIZER, start) {
        this.expression = expression;
    }
}

class OrPatternNode : Node {
    pub left: *Node,
    pub right: *Node;

    OrPatternNode(&mut this, left: *Node, right: *Node, start: Token) : Node(NodeType::OR_PATTERN, start) {
        (this.left, this.right) = (left, right);
    }
}

class IfLetNode : Node {
    pub pattern: *Node,
    pub expression: *Node,
    pub body: *Node,
    pub _else: *Node = null;

    IfLetNode(&mut this, pattern: *Node, expression: *Node, body: *Node, start: Token) : Node(NodeType::IF_LET, start) {
        (this.pattern, this.expression, this.body) = (pattern, expression, body);
    }
}

class WhileLetNode : Node {
    pub pattern: *Node,
    pub expression: *Node,
    pub body: *Node;

    WhileLetNode(&mut this, pattern: *Node, expression: *Node, body: *Node, start: Token) : Node(NodeType::WHILE_LET, start) {
        (this.pattern, this.expression, this.body) = (pattern, expression, body);
    }
}

class RangeNode : Node {
    pub start: *Node,
    pub end: *Node,
    pub inclusive: bool = false;

    RangeNode(&mut this, start: *Node, end: *Node, _start: Token) : Node(NodeType::RANGE, _start) {
        (this.start, this.end) = (start, end);
    }
}

class ForNode : Node {
    pub variable: String,
    pub iterable: *Node,
    pub body: *Node;

    ForNode(&mut this, variable: String, iterable: *Node, body: *Node, start: Token) : Node(NodeType::FOR, start) {
        (this.variable, this.iterable, this.body) = (variable, iterable, body);
    }
}

class ExternNode : Node {
    pub linkage: String,
    pub declarations: Vector<*Node>;

    ExternNode(&mut this, linkage: String, start: Token) : Node(NodeType::EXTERN, start) {
        this.linkage = linkage;
    }
}

class UnsafeNode : Node {
    pub body: *BlockNode;

    UnsafeNode(&mut this, body: *BlockNode, start: Token) : Node(NodeType::UNSAFE, start) {
        this.body = body;
    }
}

class AssemblyNode : Node {
    pub _volatile: bool, pub code: String,
    pub inputs: Vector<Pair<String, *Node>>,
    pub outputs: Vector<Pair<String, *Node>>,
    pub clobbers: Vector<String>;

    AssemblyNode(&mut this, _volatile: bool, start: Token) : Node(NodeType::ASSEMBLY, start) {
        this._volatile = _volatile;
    }
}

class RootNode : Node {
    pub declarations: Vector<*Node>;

    RootNode(&mut this) : Node(NodeType::ROOT, Token()) {}
}
