#[include "std/str", "std/vec", "std/map", "std/pair", "vendor/llvm-c/Core.zir", "vendor/llvm-c/Analysis.zir",
    "src/Target.zir", "src/Mangler.zir", "src/Tokens.zir", "src/Nodes.zir", "src/HIR.zir", "src/Logger.zir" : *]

class CodeGenerator {
    module: LLVMModuleRef = null,
    builder: LLVMBuilderRef = null,
    context: LLVMContextRef,
    target: *Target,

    namespaces: Vector<String>,
    structures: Map<*SemanticType, LLVMTypeRef>,
    variables: Map<*HIRVariable, LLVMValueRef>,
    declarations: Map<*HIRDeclaration, LLVMValueRef>,
    functions: Map<*HIRFunction, LLVMValueRef>,
    break_blocks: Vector<LLVMBasicBlockRef>,
    continue_blocks: Vector<LLVMBasicBlockRef>,

    freestanding: bool,
    no_red_zone: bool;

    CodeGenerator(&mut this, target: &Target, freestanding: bool, no_red_zone: bool) {
        (this.freestanding, this.no_red_zone) = (freestanding, no_red_zone);
        (this.context, this.target) = (LLVMContextCreate(), target);
    }

    ~CodeGenerator(&mut this) {
        if this.builder != null {
            LLVMDisposeBuilder(this.builder);
            this.builder = null;
        }

        if this.module != null {
            LLVMDisposeModule(this.module);
            this.module = null;
        }

        LLVMContextDispose(this.context);
    }

    pub fn Generate(&mut this, module: *HIRModule) -> LLVMModuleRef {
        if this.builder != null {
            LLVMDisposeBuilder(this.builder);
            this.builder = null;
        }

        if this.module != null {
            LLVMDisposeModule(this.module);
            this.module = null;
        }

        this.module = LLVMModuleCreateWithNameInContext("zircon", this.context);
        this.builder = LLVMCreateBuilderInContext(this.context);
        LLVMSetModuleDataLayout(this.module, this.target->layout);
        LLVMSetTarget(this.module, this.target->triple.Data());

        if module != null {
            this.GenerateModule(module);
        }

        let mut message: *mut i8 = null;

        if LLVMVerifyModule(this.module, LLVMVerifierFailureAction::LLVMReturnStatusAction, &mut message) != 0 {
            let final_message = message != null ? message : "Unknown reason.";
            Logger::Log("Module verification failed: " + final_message.ToString(), LogSeverity::Error);

            if message != null {
                LLVMDisposeMessage(message);
            } return null;
        }

        if message != null {
            LLVMDisposeMessage(message);
        } return this.module;
    }

    fn GenerateModule(&mut this, module: *HIRModule) {
        for declaration in module->declarations {
            this.GenerateDeclarationFirstPass(declaration);
        }

        for declaration in module->declarations {
            this.GenerateDeclarationSecondPass(declaration);
        }

        for declaration in module->declarations {
            this.GenerateDeclarationThirdPass(declaration);
        }
    }

    fn GenerateDeclarationFirstPass(&mut this, declaration: *HIRDeclaration) {
        if declaration->kind == HIRDeclarationKind::Class {
            this.GenerateClassFirstPass(declaration as *HIRClass);
        } else if declaration->kind == HIRDeclarationKind::Structure {
            this.GenerateStructureFirstPass(declaration as *HIRStructure);
        }
    }

    fn GenerateDeclarationSecondPass(&mut this, declaration: *HIRDeclaration) {
        if declaration->kind == HIRDeclarationKind::Class {
            this.GenerateClassSecondPass(declaration as *HIRClass);
        } else if declaration->kind == HIRDeclarationKind::Structure {
            this.GenerateStructureSecondPass(declaration as *HIRStructure);
        }
    }

    fn GenerateDeclarationThirdPass(&mut this, declaration: *HIRDeclaration) {
        if declaration->kind == HIRDeclarationKind::Function {
            this.GenerateFunction(declaration as *HIRFunction);
        }
    }

    fn GenerateFunction(&mut this, function: *HIRFunction) {
        let return_type = this.GenerateType((function as *HIRDeclaration)->_type->Return());
        if return_type == null { return; }
        let param_types = Vector<LLVMTypeRef>();

        for param in (function as *HIRDeclaration)->_type->Parameters() {
            let _type = this.GenerateType(param);
            if _type == null { return; }
            param_types.PushBack(_type);
        }

        let _type = LLVMFunctionType(return_type, param_types.Data(), param_types.Size() as u32, 0);
        let name = Mangler::MangleFunction((function as *HIRDeclaration)->name, (function as *HIRDeclaration)->_type, Vector<*SemanticType>(), this.namespaces);
        let value = LLVMAddFunction(this.module, name.Data(), _type);
        this.functions[function] = value;

        if function->body != null {
            let entry = LLVMAppendBasicBlockInContext(this.context, value, "entry");
            LLVMPositionBuilderAtEnd(this.builder, entry);
            this.declarations.Clear();
            this.variables.Clear();

            for i in 0..function->parameters.Size() {
                let parameter: *HIRParameter = function->parameters[i];
                let parameter_type = this.GenerateType((parameter as *HIRDeclaration)->_type);
                let storage = LLVMBuildAlloca(this.builder, parameter_type, (parameter as *HIRDeclaration)->name.Data());
                LLVMBuildStore(this.builder, LLVMGetParam(value, i as u32), storage);
                this.declarations[(parameter as *HIRDeclaration)] = storage;
            }

            this.GenerateBlock(function->body);
            let mut block = LLVMGetFirstBasicBlock(value);

            while block != null {
                if LLVMGetBasicBlockTerminator(block) == null {
                    LLVMPositionBuilderAtEnd(this.builder, block);

                    if (function as *HIRDeclaration)->_type->Return()->IsVoid() {
                        LLVMBuildRetVoid(this.builder);
                    } else {
                        LLVMBuildRet(this.builder, LLVMConstNull(return_type));
                    }
                }

                block = LLVMGetNextBasicBlock(block);
            }
        }
    }

    fn GenerateClassFirstPass(&mut this, _class: *HIRClass) {
        let declaration = _class as *HIRDeclaration;
        this.structures[declaration->_type] = LLVMStructCreateNamed(this.context, declaration->name.Data());
    }

    fn GenerateClassSecondPass(&mut this, _class: *HIRClass) {
        let declaration = _class as *HIRDeclaration;
        let field_types = Vector<LLVMTypeRef>();

        for field in _class->fields {
            let field_type = this.GenerateType(field);
            if field_type == null { continue; }
            field_types.PushBack(field_type);
        }

        if !field_types.Empty() {
            LLVMStructSetBody(this.structures[declaration->_type], field_types.Data(), field_types.Size() as u32, 0);
        }
    }

    fn GenerateStructureFirstPass(&mut this, structure: *HIRStructure) {
        let declaration = structure as *HIRDeclaration;
        this.structures[declaration->_type] = LLVMStructCreateNamed(this.context, declaration->name.Data());
    }

    fn GenerateStructureSecondPass(&mut this, structure: *HIRStructure) {
        let declaration = structure as *HIRDeclaration;
        let field_types = Vector<LLVMTypeRef>();

        for field in structure->fields {
            let field_type = this.GenerateType(field);
            if field_type == null { continue; }
            field_types.PushBack(field_type);
        }

        if !field_types.Empty() {
            LLVMStructSetBody(this.structures[declaration->_type], field_types.Data(), field_types.Size() as u32, 0);
        }
    }

    fn GenerateStatement(&mut this, statement: *HIRStatement) {
        if statement->kind == HIRStatementKind::Block {
            this.GenerateBlock(statement as *HIRBlock);
        } else if statement->kind == HIRStatementKind::Return {
            this.GenerateReturn(statement as *HIRReturn);
        } else if statement->kind == HIRStatementKind::Variable {
            this.GenerateVariable(statement as *HIRVariable);
        } else if statement->kind == HIRStatementKind::Expression {
            this.GenerateExpression((statement as *HIRExpressionStatement)->expression);
        } else if statement->kind == HIRStatementKind::If {
            this.GenerateIf(statement as *HIRIf);
        } else if statement->kind == HIRStatementKind::While {
            this.GenerateWhile(statement as *HIRWhile);
        } else if statement->kind == HIRStatementKind::Break {
            if !this.break_blocks.Empty() {
                LLVMBuildBr(this.builder, this.break_blocks.Back());
            }
        } else if statement->kind == HIRStatementKind::Continue {
            if !this.continue_blocks.Empty() {
                LLVMBuildBr(this.builder, this.continue_blocks.Back());
            }
        }
    }

    fn GenerateBlock(&mut this, block: *HIRBlock) {
        for statement in block->statements {
            let current = LLVMGetInsertBlock(this.builder);
            if current != null && LLVMGetBasicBlockTerminator(current) != null { break; }
            this.GenerateStatement(statement);
        }
    }

    fn GenerateReturn(&mut this, _return: *HIRReturn) {
        if _return->expression == null {
            LLVMBuildRetVoid(this.builder);
        } else {
            let value = this.GenerateExpression(_return->expression);

            if value != null {
                LLVMBuildRet(this.builder, value);
            }
        }
    }

    fn GenerateVariable(&mut this, variable: *HIRVariable) {
        let _type = this.GenerateType(variable->_type);
        if _type == null { return; }
        let storage = LLVMBuildAlloca(this.builder, _type, variable->name.Data());
        this.variables[variable] = storage;

        if variable->initializer != null {
            let value = this.GenerateExpression(variable->initializer);

            if value != null {
                LLVMBuildStore(this.builder, value, storage);
            }
        }
    }

    fn GeneratePlace(&mut this, expression: *HIRExpression) -> LLVMValueRef {
        if expression->kind == HIRExpressionKind::VariableRef {
            let variable = (expression as *HIRVariableRef)->variable;
            if !this.variables.Has(variable) { return null; }
            return this.variables[variable];
        } else if expression->kind == HIRExpressionKind::DeclarationRef {
            let declaration = (expression as *HIRDeclarationRef)->declaration;
            if !this.declarations.Has(declaration) { return null; }
            return this.declarations[declaration];
        } else if expression->kind == HIRExpressionKind::Dereference {
            return this.GenerateExpression((expression as *HIRDereference)->operand);
        } else {
            return null;
        }
    }

    fn GenerateIf(&mut this, _if: *HIRIf) {
        let (mut then_terminated, mut else_terminated) = (false, false);
        let condition = this.GenerateExpression(_if->condition);

        if condition == null {
            LLVMBuildUnreachable(this.builder);
            return;
        }

        let function = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
        let then_block = LLVMAppendBasicBlockInContext(this.context, function, "if.then");
        let merge_block = LLVMAppendBasicBlockInContext(this.context, function, "if.merge");

        if _if->else_body == null {
            LLVMBuildCondBr(this.builder, condition, then_block, merge_block);
        } else {
            let else_block = LLVMAppendBasicBlockInContext(this.context, function, "if.else");
            LLVMBuildCondBr(this.builder, condition, then_block, else_block);
            LLVMPositionBuilderAtEnd(this.builder, else_block);
            this.GenerateBlock(_if->else_body);
            let current = LLVMGetInsertBlock(this.builder);

            if current != null && LLVMGetBasicBlockTerminator(current) == null {
                LLVMBuildBr(this.builder, merge_block);
            } else {
                else_terminated = true;
            }
        }

        LLVMPositionBuilderAtEnd(this.builder, then_block);
        this.GenerateBlock(_if->then_body);
        let current = LLVMGetInsertBlock(this.builder);

        if current != null && LLVMGetBasicBlockTerminator(current) == null {
            LLVMBuildBr(this.builder, merge_block);
        } else {
            then_terminated = true;
        }

        LLVMPositionBuilderAtEnd(this.builder, merge_block);

        if _if->else_body != null && then_terminated && else_terminated {
            LLVMBuildUnreachable(this.builder);
        }
    }

    fn GenerateWhile(&mut this, _while: *HIRWhile) {
        let condition = this.GenerateExpression(_while->condition);

        if condition == null {
            LLVMBuildUnreachable(this.builder);
            return;
        }

        let function = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
        let condition_block = LLVMAppendBasicBlockInContext(this.context, function, "while.cond");
        let body_block = LLVMAppendBasicBlockInContext(this.context, function, "while.body");
        let end_block = LLVMAppendBasicBlockInContext(this.context, function, "while.end");

        LLVMBuildBr(this.builder, condition_block);
        LLVMPositionBuilderAtEnd(this.builder, condition_block);
        LLVMBuildCondBr(this.builder, condition, body_block, end_block);

        LLVMPositionBuilderAtEnd(this.builder, body_block);
        this.break_blocks.PushBack(end_block);
        this.continue_blocks.PushBack(condition_block);
        this.GenerateBlock(_while->while_body);
        this.continue_blocks.PopBack();
        this.break_blocks.PopBack();

        if LLVMGetBasicBlockTerminator(body_block) == null {
            LLVMBuildBr(this.builder, condition_block);
        }

        LLVMPositionBuilderAtEnd(this.builder, end_block);
    }

    fn GenerateExpression(&mut this, expression: *HIRExpression) -> LLVMValueRef {
        if expression->kind == HIRExpressionKind::VariableRef {
            let storage = this.GeneratePlace(expression);
            if storage == null { return null; }
            return LLVMBuildLoad2(this.builder, this.GenerateType(expression->_type), storage, "load");
        } else if expression->kind == HIRExpressionKind::DeclarationRef {
            let declaration = (expression as *HIRDeclarationRef)->declaration;

            if declaration->kind == HIRDeclarationKind::Function {
                if !this.functions.Has(declaration as *HIRFunction) { return null; }
                return this.functions[declaration as *HIRFunction];
            }

            let storage = this.GeneratePlace(expression);
            if storage == null { return null; }
            return LLVMBuildLoad2(this.builder, this.GenerateType(expression->_type), storage, "load");
        } else if expression->kind == HIRExpressionKind::AddressOf {
            return this.GeneratePlace((expression as *HIRAddressOf)->operand);
        } else if expression->kind == HIRExpressionKind::Dereference {
            let pointer = this.GenerateExpression((expression as *HIRDereference)->operand);
            if pointer == null { return null; }
            return LLVMBuildLoad2(this.builder, this.GenerateType(expression->_type), pointer, "deref");
        } else if expression->kind == HIRExpressionKind::Assignment {
            let assignment = expression as *HIRAssignment;
            let storage = this.GeneratePlace(assignment->left);
            let value = this.GenerateExpression(assignment->right);

            if storage != null && value != null {
                LLVMBuildStore(this.builder, value, storage);
            } return null;
        } else if expression->kind == HIRExpressionKind::IntegerLiteral {
            return LLVMConstInt(this.GenerateType(expression->_type), (expression as *HIRIntegerLiteral)->value, expression->_type->IsSigned() ? 1 : 0);
        } else if expression->kind == HIRExpressionKind::FloatLiteral {
            return LLVMConstReal(this.GenerateType(expression->_type), (expression as *HIRFloatLiteral)->value);
        } else if expression->kind == HIRExpressionKind::BooleanLiteral {
            return LLVMConstInt(this.GenerateType(expression->_type), (expression as *HIRBooleanLiteral)->value ? 1 : 0, 0);
        } else if expression->kind == HIRExpressionKind::CharacterLiteral {
            return LLVMConstInt(this.GenerateType(expression->_type), (expression as *HIRCharacterLiteral)->value as u64, 0);
        } else if expression->kind == HIRExpressionKind::NullLiteral {
            return LLVMConstNull(this.GenerateType(expression->_type));
        } else if expression->kind == HIRExpressionKind::Unary {
            return this.GenerateUnary(expression as *HIRUnary);
        } else if expression->kind == HIRExpressionKind::Binary {
            return this.GenerateBinary(expression as *HIRBinary);
        } else if expression->kind == HIRExpressionKind::Ternary {
            return this.GenerateTernary(expression as *HIRTernary);
        } else { return null; }
    }

    fn GenerateUnary(&mut this, unary: *HIRUnary) -> LLVMValueRef {
        let operand = this.GenerateExpression(unary->operand);
        if operand == null { return null; }

        if unary->_operator == TokenType::MINUS {
            if unary->operand->_type->IsFloat() {
                return LLVMBuildFNeg(this.builder, operand, "neg");
            } else {
                return LLVMBuildNeg(this.builder, operand, "neg");
            }
        } else if unary->_operator == TokenType::NOT {
            return LLVMBuildNot(this.builder, operand, "not");
        } else { return null; }
    }

    fn GenerateBinary(&mut this, binary: *HIRBinary) -> LLVMValueRef {
        let left = this.GenerateExpression(binary->left);
        let right = this.GenerateExpression(binary->right);
        if left == null || right == null { return null; }

        if binary->left->_type->IsFloat() {
            if binary->_operator == TokenType::PLUS {
                return LLVMBuildFAdd(this.builder, left, right, "add");
            } else if binary->_operator == TokenType::MINUS {
                return LLVMBuildFSub(this.builder, left, right, "sub");
            } else if binary->_operator == TokenType::MUL {
                return LLVMBuildFMul(this.builder, left, right, "mul");
            } else if binary->_operator == TokenType::DIV {
                return LLVMBuildFDiv(this.builder, left, right, "div");
            } else if binary->_operator == TokenType::MOD {
                return LLVMBuildFRem(this.builder, left, right, "mod");
            } else if binary->_operator == TokenType::EQUAL {
                return LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOEQ, left, right, "eq");
            } else if binary->_operator == TokenType::NOT_EQUAL {
                return LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealONE, left, right, "ne");
            } else if binary->_operator == TokenType::LESS {
                return LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOLT, left, right, "lt");
            } else if binary->_operator == TokenType::LESS_EQUAL {
                return LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOLE, left, right, "le");
            } else if binary->_operator == TokenType::GREATER {
                return LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOGT, left, right, "gt");
            } else if binary->_operator == TokenType::GREATER_EQUAL {
                return LLVMBuildFCmp(this.builder, LLVMRealPredicate::LLVMRealOGE, left, right, "ge");
            } else { return null; }
        } else {
            let signed = binary->left->_type->IsSigned();

            if binary->_operator == TokenType::PLUS {
                return LLVMBuildAdd(this.builder, left, right, "add");
            } else if binary->_operator == TokenType::MINUS {
                return LLVMBuildSub(this.builder, left, right, "sub");
            } else if binary->_operator == TokenType::MUL {
                return LLVMBuildMul(this.builder, left, right, "mul");
            } else if binary->_operator == TokenType::DIV {
                return signed ? LLVMBuildSDiv(this.builder, left, right, "div") : LLVMBuildUDiv(this.builder, left, right, "div");
            } else if binary->_operator == TokenType::MOD {
                return signed ? LLVMBuildSRem(this.builder, left, right, "rem") : LLVMBuildURem(this.builder, left, right, "rem");
            } else if binary->_operator == TokenType::EQUAL {
                return LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntEQ, left, right, "eq");
            } else if binary->_operator == TokenType::NOT_EQUAL {
                return LLVMBuildICmp(this.builder, LLVMIntPredicate::LLVMIntNE, left, right, "ne");
            } else if binary->_operator == TokenType::LESS {
                return LLVMBuildICmp(this.builder, signed ? LLVMIntPredicate::LLVMIntSLT : LLVMIntPredicate::LLVMIntULT, left, right, "lt");
            } else if binary->_operator == TokenType::LESS_EQUAL {
                return LLVMBuildICmp(this.builder, signed ? LLVMIntPredicate::LLVMIntSLE : LLVMIntPredicate::LLVMIntULE, left, right, "le");
            } else if binary->_operator == TokenType::GREATER {
                return LLVMBuildICmp(this.builder, signed ? LLVMIntPredicate::LLVMIntSGT : LLVMIntPredicate::LLVMIntUGT, left, right, "gt");
            } else if binary->_operator == TokenType::GREATER_EQUAL {
                return LLVMBuildICmp(this.builder, signed ? LLVMIntPredicate::LLVMIntSGE : LLVMIntPredicate::LLVMIntUGE, left, right, "ge");
            } else if binary->_operator == TokenType::BITWISE_AND || binary->_operator == TokenType::AND {
                return LLVMBuildAnd(this.builder, left, right, "and");
            } else if binary->_operator == TokenType::BITWISE_OR || binary->_operator == TokenType::OR {
                return LLVMBuildOr(this.builder, left, right, "or");
            } else if binary->_operator == TokenType::BITWISE_XOR {
                return LLVMBuildXor(this.builder, left, right, "xor");
            } else if binary->_operator == TokenType::LSHIFT {
                return LLVMBuildShl(this.builder, left, right, "shl");
            } else if binary->_operator == TokenType::RSHIFT {
                return signed ? LLVMBuildAShr(this.builder, left, right, "shr") : LLVMBuildLShr(this.builder, left, right, "shr");
            } else { return null; }
        }
    }

    fn GenerateTernary(&mut this, ternary: *HIRTernary) -> LLVMValueRef {
        let condition = this.GenerateExpression(ternary->condition);
        if condition == null { return null; }

        let function = LLVMGetBasicBlockParent(LLVMGetInsertBlock(this.builder));
        let then_block = LLVMAppendBasicBlockInContext(this.context, function, "ternary.then");
        let else_block = LLVMAppendBasicBlockInContext(this.context, function, "ternary.else");
        let merge_block = LLVMAppendBasicBlockInContext(this.context, function, "ternary.merge");
        LLVMBuildCondBr(this.builder, condition, then_block, else_block);

        LLVMPositionBuilderAtEnd(this.builder, then_block);
        let then_value = this.GenerateExpression(ternary->then);
        if then_value == null { return null; }
        LLVMBuildBr(this.builder, merge_block);

        LLVMPositionBuilderAtEnd(this.builder, else_block);
        let else_value = this.GenerateExpression(ternary->_else);
        if else_value == null { return null; }
        LLVMBuildBr(this.builder, merge_block);

        LLVMPositionBuilderAtEnd(this.builder, merge_block);
        let phi = LLVMBuildPhi(this.builder, this.GenerateType((ternary as *HIRExpression)->_type), "ternary.phi");
        let mut incoming_blocks[]: LLVMBasicBlockRef = { then_block, else_block };
        let mut incoming_values[]: LLVMValueRef = { then_value, else_value };
        LLVMAddIncoming(phi, incoming_values, incoming_blocks, 2);
        return phi;
    }

    fn GenerateType(&mut this, _type: *SemanticType) -> LLVMTypeRef {
        if this.structures.Has(_type) {
            return this.structures[_type];
        } else if _type->IsVoid() {
            return LLVMVoidTypeInContext(this.context);
        } else if _type->IsBoolean() {
            return LLVMInt1TypeInContext(this.context);
        } else if _type->IsCharacter() {
            return LLVMInt32TypeInContext(this.context);
        } else if _type->IsInteger() {
            let mut width = _type->Width();
            if width == 0 { width = LLVMPointerSize(this.target->layout) * 8; }
            return LLVMIntTypeInContext(this.context, width);
        } else if _type->IsFloat() {
            if _type->Width() == 64 {
                return LLVMDoubleTypeInContext(this.context);
            } else {
                return LLVMFloatTypeInContext(this.context);
            }
        } else if _type->IsPointer() {
            let pointee_type = this.GenerateType(_type->pointee);
            if pointee_type == null { return null; }
            return LLVMPointerType(pointee_type, 0);
        } else if _type->IsFunction() {
            let return_type = this.GenerateType(_type->Return());
            if return_type == null { return null; }
            let param_types = Vector<LLVMTypeRef>();

            for param in _type->Parameters() {
                let param_type = this.GenerateType(param);
                if param_type == null { return null; }
                param_types.PushBack(param_type);
            }

            return LLVMFunctionType(return_type, param_types.Data(), param_types.Size() as u32, 0);
        } else {
            return null;
        }
    }
}
